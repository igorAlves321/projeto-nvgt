// Função utilitária de distância
double get_distance(int x1, int y1, int x2, int y2) {
    int dx = x2 - x1;
    int dy = y2 - y1;
    return sqrt(double(dx * dx + dy * dy));
}

// Função get_damage - calcula dano com base na distância
int get_damage(int base_damage, int distance, int max_range = 20) {
    if(distance <= 0) return base_damage;
    if(distance >= max_range) return 0;
    
    // Dano diminui linearmente com a distância
    double damage_ratio = 1.0 - (double(distance) / double(max_range));
    return int(base_damage * damage_ratio);
}

// Array global de mapas do servidor
map@[] server_maps;

// Classe principal de mapa
class map {
	// ============================================================================
	// PROPRIEDADES BÁSICAS
	// ============================================================================
	int paused;           // Mapa pausado quando sem jogadores
	string name;          // Nome do mapa (sem extensão .map)
	int max_x;            // Limite máximo X
	int max_y;            // Limite máximo Y
	int mapindex;         // Índice deste mapa no array server_maps[]
	string[] mapdata;     // Dados brutos do arquivo .map (cada linha)
	
	// ============================================================================
	// JOGADORES NO MAPA
	// ============================================================================
	dictionary mapplayers_db;   // DB de jogadores: charname → index
	int[] mapplayers;           // Array de índices dos jogadores neste mapa
	
	// ============================================================================
	// OBJETOS DE COMBATE
	// ============================================================================
	bullet@[] bullets;          // Balas/projéteis ativos
	boladefogo@[] boladefogos;  // Bolas de fogo (molotov/magia)
	plasmabomb@[] plasmabombs;  // Bombas de plasma
	mina@[] mines;              // Minas terrestres
	
	// ============================================================================
	// VEGETAÇÃO E RECURSOS
	// ============================================================================
	arbol@[] arbols;            // Árvores ativas
	arbol_data@[] arbols_data;  // Árvores cortadas aguardando respawn
	
	// ============================================================================
	// CONSTRUÇÕES DESTRUTÍVEIS
	// ============================================================================
	wall@[] walls;              // Paredes ativas
	wall_data@[] walls_data;    // Paredes destruídas aguardando respawn
	
	// ============================================================================
	// ENTIDADES (NPCs E MONSTROS)
	// ============================================================================
	npc@[] npcs;                // NPCs ativos
	npc_data@[] npcs_data;      // NPCs mortos aguardando respawn
	monstruo@[] monstruos;      // Monstros ativos
	monstruo_data@[] monstruos_data; // Monstros mortos aguardando respawn
	
	// ============================================================================
	// ZONAS E PLATAFORMAS
	// ============================================================================
	portal@[] portals;          // Portais de teletransporte
	platform@[] platforms;      // Plataformas/pisos
	safezone@[] safezones;      // Zonas seguras (sem PvP)
	zone@[] zones;              // Zonas nomeadas
	death@[] deaths;            // Zonas de morte
	extract@[] extracts;        // Zonas de extração
	game_disabled@[] disableds; // Zonas com jogo desabilitado

	// ============================================================================
	// OBJETOS INTERATIVOS
	// ============================================================================
	obj@[] objs;                // Objetos coletáveis ativos
	obj_data@[] objs_data;      // Objetos coletados aguardando respawn
	banheiro@[] banheiros;      // Banheiros
	pia@[] pias;                // Pias (lavar-se)
	jaula@[] jaulas;            // Jaulas
	cachorromascota@[] cachorromascotas; // Cachorros de mascota
	
	// ============================================================================
	// VEÍCULOS E AMBIENTE
	// ============================================================================
	// vehicle@[] vehicles;        // Veículos // TODO: Classe não convertida ainda
	earthquake@[] earthquakes;  // Terremotos
	// msound@[] msounds;          // Sons móveis (3D) // TODO: Classe não convertida ainda
	
	// ============================================================================
	// SISTEMAS DE JOGO
	// ============================================================================
	// game_disabled@[] disableds; // Zonas onde jogos são desativados // TODO: Classe não convertida ainda
	dictionary desactivados;    // Itens desativados neste mapa
	
	// ============================================================================
	// CONSTRUTOR
	// ============================================================================
	map(string mapfile) {
		this.name = mapfile.replace(".map", "");
		init_map(mapfile);
	}
	
	// ============================================================================
	// INICIALIZAÇÃO DO MAPA
	// ============================================================================
	void init_map(string mapname) {
		// Abrir e ler arquivo do mapa
		file map_file;
		if (!map_file.open("maps/" + mapname, "r")) {
			alert("Erro", "Não foi possível abrir o arquivo de mapa: maps/" + mapname);
			return;
		}
		
		string content = map_file.read();
		map_file.close();
		
		// Separar em linhas
		string[] lines = content.split("\r\n");
		
		// Processar cada linha do mapa
		for (uint x = 0; x < lines.length(); x++) {
			mapdata.insert_last(lines[x]);
			string[] parsed = lines[x].split(":");
			
			// Limites do mapa
			if (parsed[0] == "maxx") {
				max_x = parse_int(parsed[1]);
				continue;
			}
			if (parsed[0] == "maxy") {
				max_y = parse_int(parsed[1]);
				continue;
			}
			
			// Itens desativados
			if (parsed[0] == "dv") {
				desactivados.set(parsed[1], parsed[1]);
				continue;
			}
			
			// Plataformas (p = platform)
			if (parsed[0] == "p" && parsed.length() == 5) {
				platform p1(parsed[0], parse_int(parsed[1]), parse_int(parsed[2]), 
				           parse_int(parsed[3]), parse_int(parsed[3]), parsed[4]);
				platforms.insert_last(p1);
				continue;
			}
			
			// Escadas (sc = staircase)
			if (parsed[0] == "sc" && parsed.length() == 6) {
				platform p1(parsed[0], parse_int(parsed[1]), parse_int(parsed[2]), 
				           parse_int(parsed[3]), parse_int(parsed[4]), parsed[5]);
				platforms.insert_last(p1);
				continue;
			}
			
			// Paredes (w = wall)
			if (parsed[0] == "w" && parsed.length() == 5) {
				platform p1(parsed[0], parse_int(parsed[1]), parse_int(parsed[1]), 
				           parse_int(parsed[2]), parse_int(parsed[3]), parsed[4]);
				platforms.insert_last(p1);
				continue;
			}
			
			// Zonas (z = zone)
			if (parsed[0] == "z" && parsed.length() == 6) {
				zone z1(parse_int(parsed[1]), parse_int(parsed[2]), 
				       parse_int(parsed[3]), parse_int(parsed[4]), parsed[5]);
				zones.insert_last(z1);
				continue;
			}
			
			// Zonas seguras (sz = safezone)
			if (parsed[0] == "sz") {
				safezone sz1(parse_int(parsed[1]), parse_int(parsed[2]), 
				            parse_int(parsed[3]), parse_int(parsed[4]));
				safezones.insert_last(sz1);
				continue;
			}
			
			// Zonas de extração (ex = extract)
			if (parsed[0] == "ex" && parsed.length() == 11) {
				extract e(parse_int(parsed[1]), parse_int(parsed[2]), 
				         parse_int(parsed[3]), parse_int(parsed[4]), 
				         parse_int(parsed[5]), parse_int(parsed[6]), 
				         parse_int(parsed[7]), parsed[8], parsed[9], parsed[10]);
				extracts.insert_last(e);
				continue;
			}
			
			// NPCs
			if (parsed[0] == "npc" && parsed.length() > 25) {
				npc b(parse_int(parsed[1]), parse_int(parsed[2]), 
				     parse_int(parsed[3]), parse_int(parsed[4]), 
				     parse_int(parsed[5]), parse_int(parsed[6]), 
				     parse_int(parsed[7]), parse_int(parsed[8]), 
				     parse_int(parsed[9]), parse_int(parsed[10]), 
				     parse_int(parsed[11]), parsed[12], parsed[13], 
				     parsed[14], parsed[15], parsed[16], parsed[17], 
				     parse_int(parsed[18]), parse_int(parsed[19]), 
				     parse_int(parsed[20]), this.name, parsed[21], 
				     parse_int(parsed[22]), parse_int(parsed[23]), 
				     parsed[24], parse_int(parsed[25]));
				npcs.insert_last(b);
				continue;
			}
			
			// Monstros
			if (parsed[0] == "monstruo" && parsed.length() == 3) {
				monstruo mn(parse_int(parsed[1]), parse_int(parsed[2]), this.name);
				monstruos.insert_last(mn);
			}
			
			// Banheiros (rt = restroom/toilet)
			if (parsed[0] == "rt" && parsed.length() > 2) {
				banheiro b(parse_int(parsed[1]), parse_int(parsed[2]));
				banheiros.insert_last(b);
				continue;
			}
			
			// Pias (lv = lavabo)
			if (parsed[0] == "lv" && parsed.length() > 2) {
				pia b(parse_int(parsed[1]), parse_int(parsed[2]), this.name);
				pias.insert_last(b);
				continue;
			}
			
			// Árvores
			if (parsed[0] == "arbol" && parsed.length() > 8) {
				arbol a(parse_int(parsed[1]), parse_int(parsed[2]), 
				       parse_int(parsed[3]), parse_int(parsed[4]), 
				       parse_int(parsed[5]), parse_int(parsed[6]), 
				       parsed[7], parsed[8], this.name);
				arbols.insert_last(a);
				continue;
			}
			
			// Paredes destrutíveis
			if (parsed[0] == "wall" && parsed.length() > 9) {
				wall w(parse_int(parsed[1]), parse_int(parsed[2]), 
				      parse_int(parsed[3]), parse_int(parsed[4]), 
				      parse_int(parsed[5]), parse_int(parsed[6]), 
				      parsed[7], parsed[8], parsed[9], parsed[10], this.name);
				walls.insert_last(w);
				continue;
			}
			
			// Zonas de morte
			if (parsed[0] == "death" && parsed.length() > 10) {
				death d(parse_int(parsed[1]), parse_int(parsed[2]), 
				       parse_int(parsed[3]), parse_int(parsed[4]), 
				       parse_int(parsed[5]), parse_int(parsed[6]), 
				       parse_int(parsed[7]), parsed[8], parsed[9], 
				       parse_int(parsed[10]), parse_int(parsed[11]));
				deaths.insert_last(d);
				continue;
			}
			
			// Zonas de jogo desativado
			if (parsed[0] == "disable_game" && parsed.length() > 4) {
				game_disabled g(parse_int(parsed[1]), parse_int(parsed[2]), 
				               parse_int(parsed[3]), parse_int(parsed[4]));
				disableds.insert_last(g);
				continue;
			}
			
			// Items/Objetos coletáveis
			if (parsed[0] == "item" && parsed.length() > 8) {
				spawn_obj(parsed[1], parse_int(parsed[2]), 
				         parse_int(parsed[3]), parse_int(parsed[4]), 
				         parse_int(parsed[5]), parsed[6], parsed[7], 
				         parse_int(parsed[8]));
				continue;
			}
		}
	}
	
	// ============================================================================
	// ATUALIZAÇÃO DE JOGADORES NO MAPA
	// ============================================================================
	void update_players_on_map(bool normal = true) {
		int value;
		string[] mapplayers_keys;
		
		if (!mapplayers_db.is_empty()) {
			mapplayers_keys = mapplayers_db.get_keys();
		}
		
		if (mapplayers.length() > 0) {
			mapplayers.resize(0);
		}
		
		if (normal) {
			// Atualizar índices dos jogadores existentes no DB
			for (uint i = 0; i < mapplayers_keys.length(); i++) {
				mapplayers_db.set(mapplayers_keys[i], get_player_index_from(mapplayers_keys[i]));
				mapplayers_db.get(mapplayers_keys[i], value);
				mapplayers.insert_last(value);
			}
			return;
		}
		else {
			// Reconstruir DB do zero baseado no array de jogadores
			mapplayers_db.delete_all();
			for (uint i = 0; i < players.length(); i++) {
				if (players[i].mapindex == this.mapindex) {
					mapplayers_db.set(players[i].charname, i);
					mapplayers.insert_last(i);
				}
			}
		}
	}
	
	// ============================================================================
	// LOOP PRINCIPAL DO MAPA
	// ============================================================================
	void maploop() {
		// Pausar mapa se não houver jogadores
		if (mapplayers.length() == 0 && paused == 0) {
			paused = 1;
		}
		
		// Executar loops de cada sistema
		if (arbols.length() > 0) {
			arbolLoop();
		}
		if (arbols_data.length() > 0) {
			arboldataloop();
		}
		if (walls.length() > 0) {
			wallLoop();
		}
		if (walls_data.length() > 0) {
			walldataloop();
		}
		if (deaths.length() > 0) {
			deathloop();
		}
		if (bullets.length() > 0) {
			bulletloop();
		}
		if (boladefogos.length() > 0) {
			boladefogoloop();
		}
		if (earthquakes.length() > 0) {
			earthquakeloop();
		}
		if (mines.length() > 0) {
			mineloop();
		}
		if (objs.length() > 0) {
			objloop();
		}
		if (objs_data.length() > 0) {
			objs_dataloop();
		}
		if (npcs.length() > 0 && pvp) {
			npcLoop();
		}
		if (npcs_data.length() > 0) {
			npcDataLoop();
		}
		if (monstruos.length() > 0 && pvp) {
			monstruoloop();
		}
		if (monstruos_data.length() > 0) {
			monstruo_dataloop();
		}
		if (plasmabombs.length() > 0) {
			plasmabomb_loop();
		}
		if (pias.length() > 0) {
			pialoop();
		}
		if (portals.length() > 0) {
			portal_loop();
		}
	}
	
	// ============================================================================
	// MANIPULAÇÃO DE DADOS DO MAPA
	// ============================================================================
	void remove_line(string line) {
		for (uint i = 0; i < mapdata.length(); i++) {
			if (mapdata[i] == line) {
				mapdata.remove_at(i);
				return;
			}
		}
	}
	
	void add_line(string line) {
		mapdata.insert_last(line);
	}
	
	void replace_line(string line, string replace) {
		for (uint i = 0; i < mapdata.length(); i++) {
			if (mapdata[i].find(line) > -1) {
				mapdata[i] = mapdata[i].replace(line, replace);
				return;
			}
		}
	}
	
	// ============================================================================
	// SONS MÓVEIS
	// ============================================================================
	void update_moving_sound(int id, int x, int y) {
		for (uint i = 0; i < msounds.length(); i++) {
			if (msounds[i].id == id) {
				msounds[i].updateme(x, y);
			}
			for (uint j = 0; j < mapplayers.length(); j++) {
				send_reliable(players[mapplayers[j]].peer_id, "um " + id + " " + x + " " + y + " " + this.name, 0);
			}
		}
	}
	
	// Sobrecarga com string (converter para int)
	void update_moving_sound(string id_str, int x, int y) {
		int id = string_to_number(id_str);
		update_moving_sound(id, x, y);
	}
	
	void destroy_moving_sound(int id) {
		for (uint i = 0; i < msounds.length(); i++) {
			if (msounds[i].id == id) {
				send_reliable(0, "destroymsound " + id, 0);
				@msounds[i] = null;
				msounds.remove_at(i);
			}
		}
	}
	
	// Sobrecarga com string
	void destroy_moving_sound(string id_str) {
		int id = string_to_number(id_str);
		destroy_moving_sound(id);
	}
	
	// ============================================================================
	// MÉTODOS DE LOOP - A IMPLEMENTAR NAS PRÓXIMAS FASES
	// ============================================================================
	
	// ============================================================================
	// FASE 2: LOOPS DE OBJETOS COLETÁVEIS - ✅ IMPLEMENTADO
	// ============================================================================
	
	void spawn_obj(string coors_x, int y, int time_out, int disable_respawn, double amount, string itemname, string sound_get, int time_respawn = 0) {
		string[] data = coors_x.split(",");
		if (data.length() == 1) {
			obj o(parse_int(data[0]), y, time_out, disable_respawn, amount, itemname, this.name, sound_get, time_respawn);
			objs.insert_last(o);
		}
		else if (data.length() > 1) {
			obj o(random(parse_int(data[0]), parse_int(data[1])), y, time_out, disable_respawn, amount, itemname, this.name, sound_get, time_respawn);
			objs.insert_last(o);
		}
	}
	
	void objloop() {
		for (uint x = 0; x < objs.length(); x++) {
			// Objeto foi coletado e não faz respawn
			if (objs[x].taked && !objs[x].disable_respawn) {
				obj_data od(objs[x].x, objs[x].y, objs[x].time_out, objs[x].disable_respawn, 
				           objs[x].amount, objs[x].itemname, objs[x].map, 
				           objs[x].sound_get, objs[x].time_respawn);
				objs_data.insert_last(od);
				objs.remove_at(x);
				break;
			}
			else {
				// Objeto foi coletado e faz respawn imediato
				if (objs[x].taked) {
					objs.remove_at(x);
					break;
				}
			}
			
			// Sistema de gravidade para objetos (caem se não houver chão)
			if (objs[x].y > 0 && get_tile_at(objs[x].x, objs[x].y) == "" && 
			    objs[x].tfall.elapsed >= 90) {
				objs[x].tfall.restart();
				objs[x].y--;
				objs[x].tile = get_tile_at(objs[x].x, objs[x].y);
			}
			
			// Som de objeto caindo no chão
			if (objs[x].tile.length() > 0) {
				send_packet(0, "play3 " + objs[x].tile + "land.ogg " + objs[x].x + " " + objs[x].y + " 120", true);
				objs[x].tile.resize(0);
			}
			
			// Timeout do objeto
			if (objs[x].ttime_out.elapsed >= objs[x].time_out) {
				objs[x].taked = true;
			}
		}
	}
	
	void objs_dataloop() {
		for (uint x = 0; x < objs_data.length(); x++) {
			// Respawn de objeto após tempo
			if (!objs_data[x].disable_respawn &&
			    objs_data[x].trespawn.elapsed >= objs_data[x].time_respawn) {
				spawn_obj(objs_data[x].x_data, objs_data[x].y, objs_data[x].time_out,
				         (objs_data[x].disable_respawn ? 1 : 0), double(objs_data[x].amount),
				         objs_data[x].itemname, objs_data[x].sound_get,
				         objs_data[x].time_respawn);
				objs_data.remove_at(x);
			}
		}
	}
	
	// ============================================================================
	// FASE 3: LOOP DE MORTE - ✅ IMPLEMENTADO
	// ============================================================================
	
	void deathloop() {
		for (uint i = 0; i < mapplayers.length(); i++) {
			// Jogador está em zona de morte ativa
			if (players[mapplayers[i]].ndeath == 1 && 
			    players[mapplayers[i]].tdeath.elapsed >= players[mapplayers[i]].death_time) {
				players[mapplayers[i]].tdeath.restart();
				
				// Jogador não está assistindo (watching)
				if (players[mapplayers[i]].watching == 0) {
					// Verificar se precisa de item e se jogador tem
					bool can_die = false;
					if (this.deaths[players[mapplayers[i]].death_index].require_item == 1) {
						if (players[mapplayers[i]].inv_item_number(this.deaths[players[mapplayers[i]].death_index].item) < 
						    this.deaths[players[mapplayers[i]].death_index].item_cantity) {
							can_die = true;
						}
					}
					else {
						can_die = true;
					}
					
					if (can_die) {
						// Morte progressiva (dano contínuo)
						if (players[mapplayers[i]].progressive_death == 1) {
							players[mapplayers[i]].health -= players[mapplayers[i]].death_life;
							players[mapplayers[i]].lasthit = players[mapplayers[i]].death_reason;
						}
						// Morte instantânea
						else if (players[mapplayers[i]].progressive_death == 0) {
							players[mapplayers[i]].health = -1;
							players[mapplayers[i]].lasthit = players[mapplayers[i]].death_reason;
						}
					}
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 4: LOOPS DE ÁRVORES - ✅ IMPLEMENTADO
	// ============================================================================
	
	void arbolLoop() {
		for (uint i = 0; i < arbols.length(); i++) {
			// Árvore foi destruída (vida <= 0)
			if (arbols[i].vida <= 0) {
				// TODO: Atualizar arquivo do mapa com replace_line (timer não pode ser concatenado como string)
				// replace_line(...);
				update2(this.name);

				// Som de árvore caindo
				send_packet(5, "play_npc arbolcayendo.ogg", arbols[i].x, arbols[i].miny);

				// Dropar itens se habilitado
				if (arbols[i].enableitems) {
					for (uint x = 0; x < arbols[i].items.length(); x++) {
						string[] items_cantity = arbols[i].items[x].split(".");
						if (items_cantity.length() > 1) {
							spawn_obj(arbols[i].x, arbols[i].miny, 60000, 1,
							         parse_int(items_cantity[1]), items_cantity[0],
							         "get" + items_cantity[0]);
						}
					}
				}
				
				// Criar arbol_data para respawn
				// ✅ Converter timer.elapsed para int (milissegundos)
				int trespawn_ms = int(arbols[i].trespawn.elapsed / 1000);
				arbol_data ad(arbols[i].x, arbols[i].miny, arbols[i].maxy, arbols[i].vida_inicial,
				             trespawn_ms, arbols[i].enableitems, arbols[i].items, arbols[i].name);
				@arbols[i] = null;
				arbols.remove_at(i);
				arbols_data.insert_last(ad);
				break;
			}
		}
	}
	
	void arboldataloop() {
		bool have_tree = false;
		for (uint i = 0; i < arbols_data.length(); i++) {
			// Verificar se já existe árvore nesta posição
			for (uint x = 0; x < arbols.length(); x++) {
				if (arbols[x].x == arbols_data[i].x) {
					have_tree = true;
					break;
				}
			}
			
			// Tempo de respawn atingido
			if (arbols_data[i].respawn.elapsed >= arbols_data[i].trespawn) {
				arbols_data[i].respawn.restart();
				
				// Spawnar árvore se não existe outra no local
				if (have_tree == false) {
					arbol a(arbols_data[i].x, arbols_data[i].miny, arbols_data[i].maxy, 
					       arbols_data[i].vida, arbols_data[i].trespawn, arbols_data[i].enableitems, 
					       arbols_data[i].items, arbols_data[i].name, this.name);
					
					// Atualizar arquivo do mapa (restaurar coordenadas)
					// ✅ Serializar timer usando .elapsed (em milissegundos)
					int64 trespawn_elapsed = arbols_data[i].respawn.elapsed / 1000; // Converter de microssegundos para ms
					replace_line("arbol:" + arbols_data[i].x + ":-1:-1:" + arbols_data[i].vida + ":" +
					            trespawn_elapsed + ":" + arbols_data[i].enableitems + ":" +
					            join(arbols_data[i].items, ".") + ":" + arbols_data[i].name,
					            "arbol:" + arbols_data[i].x + ":" + arbols_data[i].miny + ":" +
					            arbols_data[i].maxy + ":" + arbols_data[i].vida + ":" +
					            trespawn_elapsed + ":" + arbols_data[i].enableitems + ":" +
					            join(arbols_data[i].items, ".") + ":" + arbols_data[i].name);
					update2(this.name);
					
					@arbols_data[i] = null;
					arbols_data.remove_at(i);
					arbols.insert_last(a);
					break;
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 5: LOOPS DE PAREDES - ✅ IMPLEMENTADO
	// ============================================================================
	
	void wallLoop() {
		for (uint i = 0; i < walls.length(); i++) {
			// Parede foi destruída (vida <= 0)
			if (walls[i].vida <= 0) {
				// Atualizar arquivo do mapa (marcar como destruída com -1)
				// ✅ Serializar timer usando .elapsed (em milissegundos)
				int64 trespawn_elapsed = walls[i].trespawn.elapsed / 1000; // Converter de microssegundos para ms
				replace_line("wall:" + walls[i].x + ":" + walls[i].miny + ":" + walls[i].maxy + ":" +
				            walls[i].vida_inicial + ":" + trespawn_elapsed + ":" +
				            walls[i].enableitems + ":" + join(walls[i].items, ".") + ":" + walls[i].name + ":" +
				            walls[i].sound_wall + ":" + walls[i].sound_fall,
				            "wall:" + walls[i].x + ":-1:-1:" + walls[i].vida_inicial + ":" +
				            trespawn_elapsed + ":" + walls[i].enableitems + ":" +
				            join(walls[i].items, ".") + ":" + walls[i].name + ":" +
				            walls[i].sound_wall + ":" + walls[i].sound_fall);
				update2(this.name);
				
				// Som de parede caindo
				send_packet(5, "play_npc " + walls[i].sound_fall + ".ogg", walls[i].x, walls[i].miny);
				
				// Dropar itens se habilitado
				if (walls[i].enableitems) {
					// items já é string[] em wall, não precisa split
					string[] items_wall = walls[i].items;
					for (uint x = 0; x < items_wall.length(); x++) {
						string[] items_cantity = items_wall[x].split(".");
						spawn_obj(walls[i].x, walls[i].miny, 30000, 1, 
						         parse_int(items_cantity[1]), items_cantity[0], 
						         "get" + items_cantity[0]);
					}
				}
				
				// Criar wall_data para respawn
				// ✅ Converter timer.elapsed para int (milissegundos)
				int trespawn_ms = int(walls[i].trespawn.elapsed / 1000);
				wall_data wd(walls[i].x, walls[i].miny, walls[i].maxy, walls[i].vida_inicial,
				            trespawn_ms, walls[i].enableitems, walls[i].items,
				            walls[i].name, walls[i].sound_wall, walls[i].sound_fall);
				@walls[i] = null;
				walls.remove_at(i);
				walls_data.insert_last(wd);
				break;
			}
		}
	}
	
	void walldataloop() {
		bool have_wall = false;
		for (uint i = 0; i < walls_data.length(); i++) {
			// Tempo de respawn atingido
			if (walls_data[i].respawn_timer.elapsed >= walls_data[i].trespawn) {
				walls_data[i].respawn_timer.restart();
				walls_data[i].respawn_timer.pause();
				
				// Verificar se já existe parede nesta posição
				for (uint x = 0; x < walls.length(); x++) {
					if (walls[x].x == walls_data[i].x) {
						have_wall = true;
						break;
					}
				}
				
				// Spawnar parede se não existe outra no local
				if (have_wall == false) {
					wall w(walls_data[i].x, walls_data[i].miny, walls_data[i].maxy,
					      walls_data[i].vida, walls_data[i].trespawn, walls_data[i].enableitems,
					      walls_data[i].items, walls_data[i].name, walls_data[i].sound_wall,
					      walls_data[i].sound_fall, this.name);
					
				// Atualizar arquivo do mapa (restaurar coordenadas)
				// ✅ Usar trespawn diretamente (já está em milissegundos)
				replace_line("wall:" + walls_data[i].x + ":-1:-1:" + walls_data[i].vida + ":" +
				            walls_data[i].trespawn + ":" + walls_data[i].enableitems + ":" +
				            join(walls_data[i].items, ".") + ":" + walls_data[i].name + ":" +
				            walls_data[i].sound_wall + ":" + walls_data[i].sound_fall,
				            "wall:" + walls_data[i].x + ":" + walls_data[i].miny + ":" +
				            walls_data[i].maxy + ":" + walls_data[i].vida + ":" +
				            walls_data[i].trespawn + ":" + walls_data[i].enableitems + ":" +
				            join(walls_data[i].items, ".") + ":" + walls_data[i].name + ":" +
				            walls_data[i].sound_wall + ":" + walls_data[i].sound_fall);
				update2(this.name);					@walls_data[i] = null;
					walls_data.remove_at(i);
					walls.insert_last(w);
					break;
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 6: LOOPS DE BOLAS DE FOGO - ✅ IMPLEMENTADO
	// ============================================================================
	
	void boladefogoloop() {
		for (uint i = 0; i < boladefogos.length(); i++) {
			// Remover bola de fogo após 5 segundos
			if (boladefogos[i].tremover.elapsed >= 5000) {
				destroy_moving_sound(boladefogos[i].s);
				@boladefogos[i] = null;
				boladefogos.remove_at(i);
				break;
			}
			
			// Verificar colisão com paredes
			if (this.get_tile_at(boladefogos[i].x, boladefogos[i].y).find("wall") > -1) {
				destroy_moving_sound(boladefogos[i].s);
				send_packet(5, "play_npc boobytraphit1.ogg", boladefogos[i].x, boladefogos[i].y);
				@boladefogos[i] = null;
				boladefogos.remove_at(i);
				break;
			}
			
			// Movimento da bola de fogo (60ms por tile)
			if (boladefogos[i].tandar.elapsed >= 60) {
				boladefogos[i].tandar.restart();
				
				// Mover baseado na direção (usando constantes BGT)
				// Right=3, Left=2, Back=1, Forward=0
				if (boladefogos[i].lado == 3) { // Right
					boladefogos[i].x++;
					update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
				}
				else if (boladefogos[i].lado == 2) { // Left
					boladefogos[i].x--;
					update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
				}
				else if (boladefogos[i].lado == 1) { // Back
					boladefogos[i].y--;
					update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
				}
				else if (boladefogos[i].lado == 0) { // Forward
					boladefogos[i].y++;
					update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
				}
				
				// Verificar colisão com jogadores
				for (uint j = 0; j < mapplayers.length(); j++) {
					if (players[mapplayers[j]].x == boladefogos[i].x && 
					    boladefogos[i].y == players[mapplayers[j]].y && 
					    players[mapplayers[j]].watching == 0 && 
					    players[mapplayers[j]].pacifico == 0 && 
					    players[mapplayers[j]].afk == false && 
					    !emequipe(boladefogos[i].nome, players[mapplayers[j]].charname)) {
						
						// Aplicar dano
						players[mapplayers[j]].health -= 2000;
						players[mapplayers[j]].lasthit = "boladefogo_" + boladefogos[i].nome;
						send_packet(0, "inithurt " + players[mapplayers[j]].voice, 
						           players[mapplayers[j]].x, players[mapplayers[j]].y);
						destroy_moving_sound(boladefogos[i].s);
						send_packet(5, "play_npc molotovatinge.ogg", players[mapplayers[j]].x, players[j].y);
						
						// Se jogador sobreviveu, aplicar fogo contínuo
						if (players[mapplayers[j]].health > 0) 
							players[mapplayers[j]].spawn_playerfire(boladefogos[i].nome);
						
						@boladefogos[i] = null;
						boladefogos.remove_at(i);
						break;
					}
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 7: LOOPS DE BALAS - ✅ IMPLEMENTADO
	// ============================================================================
	
	void bulletloop() {
		for (uint i = 0; i < bullets.length(); i++) {
			// Mover bala baseado na direção e verificar colisão
			// Left=2, Right=3, Forward=0, Back=1 (constantes BGT)
			switch (bullets[i].facing) {
				case 2: // Left
					bullets[i].x -= 1;
					bullets[i].distance += 1;
					bulletcheck(i);
					break;
				case 3: // Right
					bullets[i].x += 1;
					bullets[i].distance += 1;
					bulletcheck(i);
					break;
				case 0: // Forward
					bullets[i].y += 1;
					bullets[i].distance += 1;
					bulletcheck(i);
					break;
				case 1: // Back
					bullets[i].y -= 1;
					bullets[i].distance += 1;
					bulletcheck(i);
					break;
				default:
					bullets.remove_at(i);
			}
		}
	}
	
	void bulletcheck(int b) {
		// Verificar se bala ainda existe (pode ter sido removida em loop anterior)
		if (b >= int(bullets.length())) return;
		
		// Verificar safezone
		bool safezone = get_safezone_at(bullets[b].x, bullets[b].y);
		int j = get_player_index_from(bullets[b].owner);
		
		// Remover bala se: está em safezone, alcançou range máximo, dono não existe, ou dono está pacífico
		if (safezone || bullets[b].distance >= bullets[b].range || j < 0 || players[j].pacifico == 1) {
			bullets.remove_at(b);
			return;
		}
		
		int dano = bullets[b].damage;
		int amount = bullets[b].damage;
		
		// ========================================================================
		// COLISÃO COM ÁRVORES
		// ========================================================================
		for (uint bu = 0; bu < arbols.length(); bu++) {
			if (bullets[b].x == arbols[bu].x) {
				if (bullets[b].y == arbols[bu].miny) {
					arbols[bu].vida -= dano;
					// Som de impacto na árvore
					// TODO: Corrigir acesso a weapons - verificar se weapons é array de objetos weapon
					//send_packet(5, "play_wall " + weapons[bullets[b].weapon - 1].sounds_impact[random(0, weapons[bullets[b].weapon - 1].sounds_impact.length() - 1)] + ".ogg",
					//           bullets[b].x, bullets[b].y);
					bullets.remove_at(b);
					return;
				}
			}
		}
		
		// ========================================================================
		// COLISÃO COM PORTAIS
		// ========================================================================
		for (uint bu = 0; bu < portals.length(); bu++) {
			if (bullets[b].x == portals[bu].x && bullets[b].y == portals[bu].y) {
				portals[bu].health -= dano;
				send_packet(5, "play_wall " + portals[bu].sounds_impact[random(0, portals[bu].sounds_impact.length() - 1)], 
				           portals[bu].x, portals[bu].y);
				bullets.remove_at(b);
				return;
			}
		}
		
		// ========================================================================
		// COLISÃO COM PAREDES DESTRUTÍVEIS
		// ========================================================================
		for (uint bu = 0; bu < walls.length(); bu++) {
			if (bullets[b].x == walls[bu].x) {
				if (bullets[b].y == walls[bu].miny) {
					walls[bu].vida -= dano;
					// TODO: Corrigir acesso a weapons
					//send_packet(5, "play_wall " + weapons[bullets[b].weapon - 1].sounds_impact[random(0, weapons[bullets[b].weapon - 1].sounds_impact.length() - 1)] + ".ogg",
					//           bullets[b].x, bullets[b].y);
					bullets.remove_at(b);
					return;
				}
			}
		}
		
		// ========================================================================
		// COLISÃO COM NPCs
		// ========================================================================
		for (uint bu = 0; bu < npcs.length(); bu++) {
			if (bullets[b].x == npcs[bu].x && bullets[b].y == npcs[bu].y) {
				// Som de impacto no NPC
				if (npcs[bu].impactosbala != "default") {
					send_packet(5, "play_body " + npcs[bu].impactos[random(0, npcs[bu].impactos.length() - 1)] + ".ogg", 
					           bullets[b].x, bullets[b].y);
				}
				else {
					// TODO: Corrigir acesso a weapons
					//send_packet(5, "play_body " + weapons[bullets[b].weapon - 1].sounds_impact_on_corpse[random(0, weapons[bullets[b].weapon - 1].sounds_impact_on_corpse.length() - 1)] + ".ogg",
					//           bullets[b].x, bullets[b].y);
				}
				
				if (bu > npcs.length()) return;
				
				// Aplicar dano
				if (npcs[bu].danoquerecibira == 0) {
					npcs[bu].vida -= dano;
				}
				else {
					npcs[bu].vida -= npcs[bu].danoquerecibira;
				}
				npcs[bu].asesino = bullets[b].owner;
				bullets.remove_at(b);
				return;
			}
		}
		
		// ========================================================================
		// COLISÃO COM MONSTROS
		// ========================================================================
		for (uint bu = 0; bu < monstruos.length(); bu++) {
			if (bullets[b].x == monstruos[bu].x && bullets[b].y == monstruos[bu].y) {
				monstruos[bu].golpeado = bullets[b].owner;
				monstruos[bu].vida -= dano;
				bullets.remove_at(b);
				return;
			}
		}
		
		// ========================================================================
		// COLISÃO COM JOGADORES (PvP)
		// ========================================================================
		dano = amount;
		j = get_player_index_from(bullets[b].owner);
		
		for (uint i = 0; i < mapplayers.length(); i++) {
			// Condições para hit: mesma posição, não é o próprio jogador, não está invisível, não está AFK, não está pacífico
			if (bullets[b].x == players[mapplayers[i]].x && 
			    bullets[b].y == players[mapplayers[i]].y && 
			    players[mapplayers[i]].invs == 0 && 
			    !players[mapplayers[i]].afk && 
			    players[mapplayers[i]].pacifico == 0 && 
			    int(mapplayers[i]) != j) {
				
				// Verificar friendly fire (equipe)
				for (uint bunda = 0; bunda < players[j].nomesequipe.length(); bunda++) {
					if (players[j].nomesequipe[bunda] == players[mapplayers[i]].charname) {
						return; // Não atirar em membros da equipe
					}
				}
				
				// Sistema de miss/hit aleatório (1-6)
				int pozic = random(1, 6);
				
				// Miss (pozic == 2) - bala errou
				if (pozic == 2) {
					send_packet(5, "play_wall ba.ogg", bullets[b].x, bullets[b].y);
					bullets.remove_at(b);
					return;
				}
				
				// Hit confirmado - aplicar dano
				if (!players[mapplayers[i]].crouched &&
				    players[mapplayers[i]].watching == 0 &&
				    !players[mapplayers[i]].in_portal) {
					
					// Sistema de degradação de roupas
					int c_i = -1;
					if (players[mapplayers[i]].clothing_indexs.length() > 0) {
						c_i = random(0, players[mapplayers[i]].clothing_indexs.length() - 1);
					}
					
					players[mapplayers[i]].lasthit = bullets[b].owner;
					
					// Degradar roupa se houver
					if (c_i > -1 && has_clothe(c_i, mapplayers[i]) &&
					    clothes[players[mapplayers[i]].clothing_indexs[c_i]].enable_degradation) {
						players[mapplayers[i]].manage_degradation(
							clothes[players[mapplayers[i]].clothing_indexs[c_i]].name, 
							clothes[players[mapplayers[i]].clothing_indexs[c_i]].degradation
						);
					}
					
					// Aplicar proteção de roupa ao dano
					if (players[mapplayers[i]].clothing_protection > 0) {
						double new_amount = amount * players[mapplayers[i]].clothing_protection;
						double new_damage = amount - new_amount;
						players[mapplayers[i]].health -= new_damage;
					}
					else {
						players[mapplayers[i]].health -= amount;
					}
					
					// Som de impacto no corpo
					// TODO: Corrigir acesso a weapons
					//send_packet(5, "play_body " + weapons[bullets[b].weapon - 1].sounds_impact_on_corpse[random(0, weapons[bullets[b].weapon - 1].sounds_impact_on_corpse.length() - 1)] + ".ogg",
					//           bullets[b].x, bullets[b].y);
					
					bullets.remove_at(b);
					return;
				}
			}
		}
		
		// ========================================================================
		// COLISÃO COM PAREDES DO MAPA
		// ========================================================================
		if (is_wall(bullets[b].x, bullets[b].y)) {
			// TODO: Corrigir acesso a weapons
			//send_packet(5, "play_wall " + weapons[bullets[b].weapon - 1].sounds_impact[random(0, weapons[bullets[b].weapon - 1].sounds_impact.length() - 1)] + ".ogg",
			//           bullets[b].x, bullets[b].y, 20, true);
			bullets.remove_at(b);
			return;
		}
	}
	
	// ============================================================================
	// FASE 8: LOOP DE TERREMOTOS - ✅ IMPLEMENTADO
	// ============================================================================
	
	void earthquakeloop() {
		for (uint i = 0; i < earthquakes.length(); i++) {
			// Dano periódico a cada 5 segundos enquanto terremoto está ativo
			if (earthquakes[i].active && earthquakes[i].damagetimer.elapsed >= 5000) {
				earthquakes[i].damagetimer.restart();
				
				// Aplicar dano a todos os jogadores no mapa (exceto quem está watching)
				for (uint j = 0; j < mapplayers.length(); j++) {
					if (players[mapplayers[j]].health > 0 && players[mapplayers[j]].watching == 0) {
						// Dano aleatório entre 30000-40000
						players[mapplayers[j]].health -= random(30000, 40000);
						players[mapplayers[j]].lasthit = "terremoto_ " + earthquakes[i].owner;
						
						// Som de dor do jogador
						send_packet(0, "inithurt " + players[mapplayers[j]].voice, 
						           players[mapplayers[j]].x, players[mapplayers[j]].y);
					}
				}
			}
			
			// Terremoto termina após duração especificada
			if (earthquakes[i].t.elapsed >= earthquakes[i].duration && earthquakes[i].active) {
				send_packet(0, "msg2 ;parece que el terremoto ha terminado.;", false);
				earthquakes[i].active = false;
			}
			
			// Remover terremoto quando inativo
			if (!earthquakes[i].active) {
				destroy_moving_sound(earthquakes[i].earthquake_sound);
				@earthquakes[i] = null;
				earthquakes.remove_at(i);
			}
		}
	}
	
	// ============================================================================
	// FASE 9: LOOP DE MINAS - ✅ IMPLEMENTADO
	// ============================================================================
	
	void mineloop() {
		for (uint i = 0; i < mines.length(); i++) {
			if (mines[i].active) {
				int distance;
				
				// Som de explosão
				send_packet(0, "impact " + mines[i].sound_explosion, mines[i].x, mines[i].y);
				
				// Dano em jogadores dentro do raio
				for (uint j = 0; j < mapplayers.length(); j++) {
					distance = get_distance(mines[i].x, players[mapplayers[j]].x, 
					                       mines[i].y, players[mapplayers[j]].y);
					
					// Só aplica dano se: não pacífico, não AFK, não newbie, sem antimina, não em portal
					if (players[mapplayers[j]].pacifico == 0 && 
					    !players[mapplayers[j]].afk && 
					    !players[mapplayers[j]].newbie && 
					    players[mapplayers[j]].antimina == 0 && 
					    !players[mapplayers[j]].in_portal) {
						
						send_packet(0, "inithurt " + players[mapplayers[j]].voice, 
						           players[mapplayers[j]].x, players[mapplayers[j]].y);
						players[mapplayers[j]].lasthit = mines[i].owner + "'s mina";
						players[mapplayers[j]].health -= mines[i].get_damage(distance);
					}
				}
				
				// Dano em árvores
				for (uint j = 0; j < arbols.length(); j++) {
					distance = get_distance(mines[i].x, arbols[j].x, 
					                       mines[i].y, arbols[j].miny);
					arbols[j].vida -= mines[i].get_damage(distance);
				}
				
				// Dano em NPCs (se enablebombs estiver ativo)
				for (uint j = 0; j < npcs.length(); j++) {
					if (npcs[j].enablebombs) {
						distance = get_distance(mines[i].x, npcs[j].x, 
						                       mines[i].y, npcs[j].y);
						npcs[j].asesino = mines[i].owner;
						npcs[j].vida -= mines[i].get_damage(distance);
					}
				}
				
				// Dano em portais
				for (uint j = 0; j < portals.length(); j++) {
					distance = get_distance(mines[i].x, portals[j].x, 
					                       mines[i].y, portals[j].y);
					portals[j].health -= mines[i].get_damage(distance);
				}
				
				// Dano em paredes destrutíveis
				for (uint j = 0; j < walls.length(); j++) {
					distance = get_distance(mines[i].x, walls[j].x, 
					                       mines[i].y, walls[j].miny);
					walls[j].vida -= mines[i].get_damage(distance);
				}
				
				// Remover mina após explosão
				mines.remove_at(i);
				break;
			}
		}
	}
	
	// ============================================================================
	// FASE 10: LOOPS DE NPCs - ✅ IMPLEMENTADO
	// ============================================================================
	
	void npcLoop() {
		for (uint i = 0; i < npcs.length(); i++) {
			// Inicializar mapindex se necessário
			if (npcs[i].mapindex == -1) {
				npcs[i].mapindex = get_map_index_from(this.name);
			}
			
			// Morte do NPC
			if (npcs[i].vida <= 0) {
				npcs[i].die();
				@npcs[i] = null;
				npcs.remove_at(i);
				break;
			}
			
			// Sons nervosos periódicos
			if (npcs[i].ttiempodelossonidos.elapsed >= npcs[i].tiempodelossonidos) {
				npcs[i].ttiempodelossonidos.restart();
				send_packet(5, "play_npc " + npcs[i].sonidosnervioso[random(0, npcs[i].sonidosnervioso.length() - 1)] + ".ogg", 
				           npcs[i].x, npcs[i].y);
			}
			
			// Verificar se jogador alvo ainda existe no mapa
			if (npcs[i].p_index > -1) {
				bool exists = npcs[i].exists_player_in_my_map();
				if (!exists) npcs[i].p_index = -1;
			}
			
			// Selecionar novo jogador para atacar se não tem alvo
			if (npcs[i].p_index == -1) {
				npcs[i].p_index = npcs[i].select_player_to_attack();
			}
			
			// Atualizar jogador alvo (verificar se ficou pacífico ou AFK)
			if (npcs[i].update_player.elapsed >= 50) {
				npcs[i].update_player.restart();
				if (mapplayers.length() > 1) {
					if (npcs[i].p_index > -1 && 
					    (players[npcs[i].p_index].pacifico == 1 || players[npcs[i].p_index].afk)) {
						npcs[i].p_index = npcs[i].change_player(npcs[i].p_index);
					}
				}
			}
			
			// Movimento do NPC em direção ao jogador
			if (npcs[i].ttiempoparacaminar.elapsed >= npcs[i].tiempoparacaminar && npcs[i].p_index > -1) {
				npcs[i].ttiempoparacaminar.restart();
				npcs[i].move();
			}
			
			// Sistema de ataque
			if (npcs[i].ttiempoparaatacar.elapsed >= npcs[i].tiempoparaatacar) {
				npcs[i].ttiempoparaatacar.restart();
				
				// Condições para atacar:
				// - Tem jogador alvo
				// - Está dentro da distância de ataque
				// - Jogador não está AFK, watching ou pacífico
				if (npcs[i].p_index > -1) {
					int distance = get_distance(npcs[i].x, players[npcs[i].p_index].x, 
					                           npcs[i].y, players[npcs[i].p_index].y);
					
					if (distance > -1 && 
					    distance <= npcs[i].distanciaataques && 
					    !players[npcs[i].p_index].afk && 
					    players[npcs[i].p_index].watching == 0 && 
					    players[npcs[i].p_index].pacifico == 0) {
						npcs[i].attack();
					}
				}
			}
		}
	}
	
