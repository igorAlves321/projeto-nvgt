// server_map.nvgt - Sistema de Mapas do EVM Server (convertido de map.bgt)
// Conversão: BGT → NVGT
// Status: EM CONVERSÃO - FASE 1/13

// Includes necessários
// TODO: Converter estes arquivos para NVGT quando necessário
#include "placeholder_classes.nvgt"  // Classes temporárias para compilação
#include "map_elements.nvgt"         //  Task 1.3.1: Elementos de mapa completos
#include "mine/mina.nvgt"
#include "portals.nvgt"
// #include "vehicles.nvgt"
