// server_map.nvgt - Sistema de Mapas do EVM Server (convertido de map.bgt)
// Conversão: BGT → NVGT
// Status: lógica principal de mapas portada para NVGT; módulos auxiliares ficam em includes separados.

// Includes necessários
#include "map_legacy_data.nvgt"  // Classes legadas de dados usadas pelo mapa
#include "map_elements.nvgt"         //  Task 1.3.1: Elementos de mapa completos
#include "mine/mina.nvgt"
#include "portals.nvgt"
// vehicles.nvgt é incluído pelo server.nvgt para evitar duplicação de símbolos.
#include "platforms.nvgt"
#include "safezones.nvgt"
#include "zones.nvgt"
#include "boladefogo.nvgt"
#include "plasmabomb.nvgt"
#include "map_global_helpers.nvgt"

// Classe principal de mapa
class map {
	// ============================================================================
	// PROPRIEDADES BÁSICAS
	// ============================================================================
	int paused;           // Mapa pausado quando sem jogadores
	string name;          // Nome do mapa (sem extensão .map)
	int max_x;            // Limite máximo X
	int max_y;            // Limite máximo Y
	int mapindex;         // Índice deste mapa no array server_maps[]
	string[] mapdata;     // Dados brutos do arquivo .map (cada linha)
	
	// ============================================================================
	// JOGADORES NO MAPA
	// ============================================================================
	dictionary mapplayers_db;   // DB de jogadores: charname → index
	int[] mapplayers;           // Array de índices dos jogadores neste mapa
	
	// ============================================================================
	// OBJETOS DE COMBATE
	// ============================================================================
	bullet@[] bullets;          // Balas/projéteis ativos
	boladefogo@[] boladefogos;  // Bolas de fogo (molotov/magia)
	plasmabomb@[] plasmabombs;  // Bombas de plasma
	mina@[] mines;              // Minas terrestres
	
	// ============================================================================
	// VEGETAÇÃO E RECURSOS
	// ============================================================================
	arbol@[] arbols;            // Árvores ativas
	arbol_data@[] arbols_data;  // Árvores cortadas aguardando respawn
	
	// ============================================================================
	// CONSTRUÇÕES DESTRUTÍVEIS
	// ============================================================================
	wall@[] walls;              // Paredes ativas
	wall_data@[] walls_data;    // Paredes destruídas aguardando respawn
	
	// ============================================================================
	// ENTIDADES (NPCs E MONSTROS)
	// ============================================================================
	npc@[] npcs;                // NPCs ativos
	npc_data@[] npcs_data;      // NPCs mortos aguardando respawn
	monstruo@[] monstruos;      // Monstros ativos
	monstruo_data@[] monstruos_data; // Monstros mortos aguardando respawn
	
	// ============================================================================
	// ZONAS E PLATAFORMAS
	// ============================================================================
	portal@[] portals;          // Portais de teletransporte
	platform@[] platforms;      // Plataformas/pisos
	safezone@[] safezones;      // Zonas seguras (sem PvP)
	zone@[] zones;              // Zonas nomeadas
	death@[] deaths;            // Zonas de morte
	extract@[] extracts;        // Zonas de extração
	game_disabled@[] disableds; // Zonas com jogo desabilitado

	// ============================================================================
	// OBJETOS INTERATIVOS
	// ============================================================================
	obj@[] objs;                // Objetos coletáveis ativos
	obj_data@[] objs_data;      // Objetos coletados aguardando respawn
	banheiro@[] banheiros;      // Banheiros
	pia@[] pias;                // Pias (lavar-se)
	jaula@[] jaulas;            // Jaulas
	cachorromascota@[] cachorromascotas; // Cachorros de mascota
	
	// ============================================================================
	// VEÍCULOS E AMBIENTE
	// ============================================================================
	// vehicle@[] vehicles;        // Sistema convertido em vehicles.nvgt; manter fora do mapa até integrar ciclo de vida.
	earthquake@[] earthquakes;  // Terremotos
	// msound@[] msounds;          // Sistema global convertido em moving_sound/msound.nvgt.
	
	// ============================================================================
	// SISTEMAS DE JOGO
	// ============================================================================
	dictionary desactivados;    // Itens desativados neste mapa

	// ============================================================================
	//  NOVOS ELEMENTOS DE MAPA (Task 1.3.1)
	// ============================================================================
	door@[] doors;                      // Portas interativas
	sound_source@[] sound_sources;      // Fontes sonoras ambientes
	sound_stream@[] sound_streams;      // Streams de música de fundo
	texto@[] textos;                    // Objetos de texto
	dialog@[] dialogs;                  // Diálogos pop-up
	quicksand@[] quicksands;            // Areias movediças
	travel_point@[] travel_points;      // Pontos de viagem/teleporte
	custom_portal@[] custom_portals;    // Portais customizados (ptm)
	pickup_point@[] pickup_points;      // Pontos de pickup com items (pm)
	timed_portal@[] timed_portals;      // Portais com tempo (cpm)
	freeze_zone@[] freeze_zones;        // Zonas de congelamento
	reverb_zone@[] reverb_zones;        // Zonas de reverb
	description@[] descriptions;        // Descrições de áreas

	// Configurações adicionais do mapa
	string map_name_display = "";       // Nome de exibição do mapa (map:)
	string background_music_url = "";   // URL de música de fundo (url:)
	string ceiling_sound = "";          // Som de teto/chuva (teto:)
	int player_spawn_x = 0;             // Spawn X do jogador (x:)
	int player_spawn_y = 0;             // Spawn Y do jogador (y:)
	bool is_safe_map = false;           // Se o mapa inteiro é safezone (safemap)
	string[] disabled_weapons;          // Armas desabilitadas (darmas)
	
	// ============================================================================
	// CONSTRUTOR
	// ============================================================================
	map(string mapfile) {
		string file_name = get_map_filename(mapfile);
		this.name = file_name.replace(".map", "");
		init_map(file_name);
	}
	
	// ============================================================================
	// INICIALIZAÇÃO DO MAPA
	// ============================================================================
	void init_map(string mapname) {
		// Abrir e ler arquivo do mapa
		file map_file;
		string map_path = resolve_map_path(mapname);
		if (!map_file.open(map_path, "r")) {
			alert("Erro", "Não foi possível abrir o arquivo de mapa: " + map_path);
			return;
		}
		
		string content = map_file.read();
		map_file.close();
		
		// Separar em linhas
		string[] lines = content.split("\r\n");
		
		// Processar cada linha do mapa
		for (uint x = 0; x < lines.length(); x++) {
			mapdata.insert_last(lines[x]);
			string[] parsed = lines[x].split(":");
			
			// Limites do mapa
			if (parsed[0] == "maxx") {
				max_x = parse_int(parsed[1]);
				continue;
			}
			if (parsed[0] == "maxy") {
				max_y = parse_int(parsed[1]);
				continue;
			}
			
			// Itens desativados
			if (parsed[0] == "dv") {
				desactivados.set(parsed[1], parsed[1]);
				continue;
			}
			
			// Plataformas (p = platform) - suporta alias "platform"
			if ((parsed[0] == "p" || parsed[0] == "platform") && parsed.length() >= 5) {
				platform p1(parsed[0], parse_int(parsed[1]), parse_int(parsed[2]), 
				           parse_int(parsed[3]), parse_int(parsed[3]), parsed[4]);
				platforms.insert_last(p1);
				continue;
			}
			
			// Escadas (sc = staircase) - suporta alias "staircase"
			if ((parsed[0] == "sc" || parsed[0] == "staircase") && parsed.length() >= 6) {
				platform p1(parsed[0], parse_int(parsed[1]), parse_int(parsed[2]), 
				           parse_int(parsed[3]), parse_int(parsed[4]), parsed[5]);
				platforms.insert_last(p1);
				continue;
			}
			
			// Paredes (w = wall) - suporta aliases "wall" e "pwall"
			if ((parsed[0] == "w" || parsed[0] == "wall" || parsed[0] == "pwall") && parsed.length() >= 5) {
				platform p1(parsed[0], parse_int(parsed[1]), parse_int(parsed[1]), 
				           parse_int(parsed[2]), parse_int(parsed[3]), parsed[4]);
				platforms.insert_last(p1);
				continue;
			}
			
			// Zonas (z = zone) - suporta alias "zone"
			if ((parsed[0] == "z" || parsed[0] == "zone") && parsed.length() >= 6) {
				zone z1(parse_int(parsed[1]), parse_int(parsed[2]), 
				       parse_int(parsed[3]), parse_int(parsed[4]), parsed[5]);
				zones.insert_last(z1);
				continue;
			}
			
			// Zonas seguras (sz = safezone)
			if (parsed[0] == "sz") {
				safezone sz1(parse_int(parsed[1]), parse_int(parsed[2]), 
				            parse_int(parsed[3]), parse_int(parsed[4]));
				safezones.insert_last(sz1);
				continue;
			}
			
			// Zonas de extração (ex = extract)
			if (parsed[0] == "ex" && parsed.length() == 11) {
				extract e(parse_int(parsed[1]), parse_int(parsed[2]), 
				         parse_int(parsed[3]), parse_int(parsed[4]), 
				         parse_int(parsed[5]), parse_int(parsed[6]), 
				         parse_int(parsed[7]), parsed[8], parsed[9], parsed[10]);
				extracts.insert_last(e);
				continue;
			}
			
			// NPCs
			if (parsed[0] == "npc" && parsed.length() > 25) {
				npc b(parse_int(parsed[1]), parse_int(parsed[2]), 
				     parse_int(parsed[3]), parse_int(parsed[4]), 
				     parse_int(parsed[5]), parse_int(parsed[6]), 
				     parse_int(parsed[7]), parse_int(parsed[8]), 
				     parse_int(parsed[9]), parse_int(parsed[10]), 
				     parse_int(parsed[11]), parsed[12], parsed[13], 
				     parsed[14], parsed[15], parsed[16], parsed[17], 
				     parse_int(parsed[18]), (parse_int(parsed[19]) != 0), 
				     (parse_int(parsed[20]) != 0), this.name, parsed[21], 
				     parse_int(parsed[22]), parse_int(parsed[23]), 
				     parsed[24], parse_int(parsed[25]));
				npcs.insert_last(b);
				// Sistema global (npc.nvgt): instancia ativa para IA/combate.
				npcs_global.insert_last(b);
				continue;
			}
			
			// Monstros (compat BGT e formato novo)
			// BGT: monstruo:x:y
			// NVGT: monstruo:x:y:tipo
			if (parsed[0] == "monstruo" && parsed.length() >= 3) {
				int mx = parse_int(parsed[1]);
				int my = parse_int(parsed[2]);
				string mtipo = "zumbi";
				if (parsed.length() >= 4 && parsed[3].trim_whitespace() != "") {
					mtipo = parsed[3].trim_whitespace().lower();
				}
				spawn_monstruo(mx, my, this.name, mtipo);
				continue;
			}
			
			// Banheiros (rt = restroom/toilet)
			if (parsed[0] == "rt" && parsed.length() > 2) {
				banheiro b(parse_int(parsed[1]), parse_int(parsed[2]));
				banheiros.insert_last(b);
				continue;
			}
			
			// Pias (lv = lavabo)
			if (parsed[0] == "lv" && parsed.length() > 2) {
				pia b(parse_int(parsed[1]), parse_int(parsed[2]), this.name);
				pias.insert_last(b);
				continue;
			}
			
			// Árvores
			if (parsed[0] == "arbol" && parsed.length() > 8) {
				arbol a(parse_int(parsed[1]), parse_int(parsed[2]), 
				       parse_int(parsed[3]), parse_int(parsed[4]), 
				       parse_int(parsed[5]), parse_int(parsed[6]), 
				       parsed[7], parsed[8], this.name);
				arbols.insert_last(a);
				continue;
			}
			
			// Paredes destrutíveis
			if (parsed[0] == "wall" && parsed.length() > 9) {
				wall w(parse_int(parsed[1]), parse_int(parsed[2]), 
				      parse_int(parsed[3]), parse_int(parsed[4]), 
				      parse_int(parsed[5]), parse_int(parsed[6]), 
				      parsed[7], parsed[8], parsed[9], parsed[10], this.name);
				walls.insert_last(w);
				continue;
			}
			
			// Zonas de morte
			if (parsed[0] == "death" && parsed.length() > 10) {
				death d(parse_int(parsed[1]), parse_int(parsed[2]), 
				       parse_int(parsed[3]), parse_int(parsed[4]), 
				       parse_int(parsed[5]), parse_int(parsed[6]), 
				       parse_int(parsed[7]), parsed[8], parsed[9], 
				       parse_int(parsed[10]), parse_int(parsed[11]));
				deaths.insert_last(d);
				continue;
			}
			
			// Zonas de jogo desativado
			if (parsed[0] == "disable_game" && parsed.length() > 4) {
				game_disabled g(parse_int(parsed[1]), parse_int(parsed[2]), 
				               parse_int(parsed[3]), parse_int(parsed[4]));
				disableds.insert_last(g);
				continue;
			}
			
			// Items/Objetos coletáveis
			if (parsed[0] == "item" && parsed.length() > 8) {
				spawn_obj(parsed[1], parse_int(parsed[2]),
				         parse_int(parsed[3]), parse_int(parsed[4]),
				         parse_int(parsed[5]), parsed[6], parsed[7],
				         parse_int(parsed[8]));
				continue;
			}

			// ========================================================================
			//  TASK 1.3.1: PARSING COMPLETO DOS 27+ TIPOS FALTANTES
			// ========================================================================

			// MAP NAME - Nome de exibição do mapa
			if (parsed[0] == "map" && parsed.length() > 1) {
				map_name_display = lines[x].substr(4); // Pega tudo após "map:"
				continue;
			}

			// URL - Música de fundo via URL
			if (parsed[0] == "url" && parsed.length() > 1) {
				background_music_url = lines[x].substr(4); // Pega tudo após "url:"
				continue;
			}

			// TETO - Som de teto/chuva
			if (parsed[0] == "teto" && parsed.length() > 1) {
				ceiling_sound = parsed[1];
				continue;
			}

			// X - Coordenada X de spawn do jogador
			if (parsed[0] == "x" && parsed.length() > 1) {
				player_spawn_x = parse_int(parsed[1]);
				continue;
			}

			// Y - Coordenada Y de spawn do jogador
			if (parsed[0] == "y" && parsed.length() > 1) {
				player_spawn_y = parse_int(parsed[1]);
				continue;
			}

			// DOOR / PORTA / DR - Portas (10 parâmetros)
			if ((parsed[0] == "door" || parsed[0] == "porta" || parsed[0] == "dr") && parsed.length() >= 10) {
				door d(parse_int(parsed[1]), parse_int(parsed[2]),
				      parse_int(parsed[3]), parse_int(parsed[4]),
				      parse_int(parsed[5]), parsed[6], parsed[7], parsed[8], parsed[9]);
				d.map = this.name;
				doors.insert_last(d);
				continue;
			}

			// SOUND_SOURCE / SOM / SS - Fontes sonoras (6 parâmetros)
			if ((parsed[0] == "sound_source" || parsed[0] == "som" || parsed[0] == "ss") && parsed.length() >= 6) {
				// Validação de parâmetros
				int lx = parse_int(parsed[1]);
				int rx = parse_int(parsed[2]);
				int miny = parse_int(parsed[3]);
				int maxy = parse_int(parsed[4]);
				string sound_file = parsed[5].replace(".wav", ".ogg");

				// Validação de limites
				if (lx < 0 || rx > max_x || miny < 0 || maxy > max_y) {
					debug_log("[PARSE_ERROR] sound_source fora dos limites do mapa: " + lines[x]);
					continue;
				}

				// Validação de arquivo
				if (sound_file.is_empty() || !sound_file.ends_with(".ogg")) {
					debug_log("[PARSE_ERROR] sound_source com arquivo inválido: " + sound_file);
					continue;
				}

				sound_source ss(lx, rx, miny, maxy, sound_file, "ss_" + lx + "_" + miny);
				ss.map = this.name;
				sound_sources.insert_last(ss);
				continue;
			}

			// SS2 - Sound Streams (zonas com música de fundo)
			if (parsed[0] == "ss2" && parsed.length() >= 6) {
				int minx = parse_int(parsed[1]);
				int maxx = parse_int(parsed[2]);
				int miny = parse_int(parsed[3]);
				int maxy = parse_int(parsed[4]);
				string sound_file = parsed[5].replace(".wav", ".ogg");
				int volume = (parsed.length() >= 7) ? parse_int(parsed[6]) : 100;

				sound_stream stream(minx, maxx, miny, maxy, sound_file, volume);
				stream.map = this.name;
				sound_streams.insert_last(stream);
				continue;
			}

			// TEXTO / TXT - Objetos de texto (4 parâmetros)
			if ((parsed[0] == "texto" || parsed[0] == "txt") && parsed.length() >= 4) {
				int x = parse_int(parsed[1]);
				int y = parse_int(parsed[2]);
				string text = parsed[3];

				// Validação de coordenadas
				if (x < 0 || x > max_x || y < 0 || y > max_y) {
					debug_log("[PARSE_ERROR] texto fora dos limites: " + lines[x]);
					continue;
				}

				texto t(x, y, text);
				t.map = this.name;
				textos.insert_last(t);
				continue;
			}

			// DLG - Diálogos (4 parâmetros)
			if (parsed[0] == "dlg" && parsed.length() >= 4) {
				int x = parse_int(parsed[1]);
				int y = parse_int(parsed[2]);
				string message = parsed[3];
				string snd = (parsed.length() >= 5) ? parsed[4] : "";

				// Validação de coordenadas
				if (x < 0 || x > max_x || y < 0 || y > max_y) {
					debug_log("[PARSE_ERROR] dlg fora dos limites: " + lines[x]);
					continue;
				}

				dialog dlg(x, y, message, snd);
				dlg.map = this.name;
				dialogs.insert_last(dlg);
				continue;
			}

			// AREIA_MOVEDISSA / AM - Areia movediça (quicksand)
			if ((parsed[0] == "areia_movedissa" || parsed[0] == "am") && parsed.length() >= 3) {
				int x = parse_int(parsed[1]);
				int y = parse_int(parsed[2]);

				quicksand qs(x, y, this.name);
				quicksands.insert_last(qs);
				continue;
			}

			// TP / TRAVELPOINT - Pontos de viagem (8 parâmetros)
			if ((parsed[0] == "tp" || parsed[0] == "travelpoint") && parsed.length() >= 8) {
				int zone_x1 = parse_int(parsed[1]);
				int zone_y1 = parse_int(parsed[2]);
				int zone_x2 = parse_int(parsed[3]);
				int zone_y2 = parse_int(parsed[4]);
				int dest_x = parse_int(parsed[5]);
				int dest_y = parse_int(parsed[6]);
				string dest_map = parsed[7];
				string message = (parsed.length() > 8) ? parsed[8] : "Teleportado.";

				travel_point tp(zone_x1, zone_y1, zone_x2, zone_y2, dest_x, dest_y, dest_map, message);
				tp.map = this.name;
				travel_points.insert_last(tp);
				continue;
			}

			// PTM - Portal customizado com som (9 parâmetros)
			if (parsed[0] == "ptm" && parsed.length() >= 9) {
				int zone_x1 = parse_int(parsed[1]);
				int zone_y1 = parse_int(parsed[2]);
				int zone_x2 = parse_int(parsed[3]);
				int zone_y2 = parse_int(parsed[4]);
				int dest_x = parse_int(parsed[5]);
				int dest_y = parse_int(parsed[6]);
				string dest_map = parsed[7];
				string message = (parsed.length() > 8) ? parsed[8] : "Portal ativado.";
				string snd = (parsed.length() > 9) ? parsed[9] : "door17open.ogg";

				custom_portal cp(zone_x1, zone_y1, zone_x2, zone_y2, dest_x, dest_y, dest_map, message, snd);
				cp.map = this.name;
				custom_portals.insert_last(cp);
				continue;
			}

			// PM - Ponto de pickup com item (10 parâmetros)
			if (parsed[0] == "pm" && parsed.length() >= 10) {
				int zone_x1 = parse_int(parsed[1]);
				int zone_y1 = parse_int(parsed[2]);
				int zone_x2 = parse_int(parsed[3]);
				int zone_y2 = parse_int(parsed[4]);
				int dest_x = parse_int(parsed[5]);
				int dest_y = parse_int(parsed[6]);
				string dest_map = parsed[7];
				string message = (parsed.length() > 8) ? parsed[8] : "Item coletado.";
				string snd = (parsed.length() > 9) ? parsed[9] : "door17open.ogg";
				string item = (parsed.length() > 10) ? parsed[10] : "item";

				pickup_point pp(zone_x1, zone_y1, zone_x2, zone_y2, dest_x, dest_y, dest_map, message, snd, item);
				pp.map = this.name;
				pickup_points.insert_last(pp);
				continue;
			}

			// CPM - Portal customizado com tempo (13 parâmetros)
			if (parsed[0] == "cpm" && parsed.length() >= 13) {
				int zone_x1 = parse_int(parsed[1]);
				int zone_y1 = parse_int(parsed[2]);
				int zone_x2 = parse_int(parsed[3]);
				int zone_y2 = parse_int(parsed[4]);
				int dest_x = parse_int(parsed[5]);
				int dest_y = parse_int(parsed[6]);
				string dest_map = parsed[7];
				string travel_msg = (parsed.length() > 8) ? parsed[8] : "Viajando...";
				string color = (parsed.length() > 9) ? parsed[9] : "ffffff";
				int travel_time = (parsed.length() > 10) ? parse_int(parsed[10]) : 5000;
				string arrival_msg = (parsed.length() > 11) ? parsed[11] : "Chegou.";
				string effect = (parsed.length() > 12) ? parsed[12] : "appear";

				timed_portal tp(zone_x1, zone_y1, zone_x2, zone_y2, dest_x, dest_y, dest_map,
				               travel_msg, color, travel_time, arrival_msg, effect);
				tp.map = this.name;
				timed_portals.insert_last(tp);
				continue;
			}

			// CONGELAR - Zona de congelamento (4 parâmetros)
			if (parsed[0] == "congelar" && parsed.length() >= 5) {
				int x1 = parse_int(parsed[1]);
				int x2 = parse_int(parsed[2]);
				int y1 = parse_int(parsed[3]);
				int y2 = parse_int(parsed[4]);

				freeze_zone fz(x1, x2, y1, y2);
				fz.map = this.name;
				freeze_zones.insert_last(fz);
				continue;
			}

			// DARMAS - Desabilitar arma específica
			if (parsed[0] == "darmas" && parsed.length() >= 2) {
				string weapon = parsed[1];
				disabled_weapons.insert_last(weapon);
				continue;
			}

			// DESC - Descrição de área (formato completo com 6 parâmetros)
			if (parsed[0] == "desc" && parsed.length() >= 6) {
				int x = parse_int(parsed[1]);
				int y = parse_int(parsed[2]);
				int fx = parse_int(parsed[3]);
				int fy = parse_int(parsed[4]);
				string text = parsed[5];

				description desc(x, y, fx, fy, text);
				desc.map = this.name;
				descriptions.insert_last(desc);
				continue;
			}

			// DESATIVAR - Desabilitar funcionalidades do jogo
			if (parsed[0] == "desativar" && parsed.length() >= 2) {
				string feature = parsed[1];
				desactivados.set(feature, feature);
				continue;
			}

			// SAFEMAP - Marcar mapa inteiro como safezone
			if (parsed[0] == "safemap") {
				is_safe_map = true;
				continue;
			}

			// SAFEZONE / SAFEZ - Aliases para sz (safezone)
			if ((parsed[0] == "safezone" || parsed[0] == "safez") && parsed.length() >= 5) {
				safezone sz(parse_int(parsed[1]), parse_int(parsed[2]),
				           parse_int(parsed[3]), parse_int(parsed[4]));
				safezones.insert_last(sz);
				continue;
			}

			// REVERB - Zona de reverberação (4+ parâmetros)
			if (parsed[0] == "reverb" && parsed.length() >= 5) {
				int x1 = parse_int(parsed[1]);
				int x2 = parse_int(parsed[2]);
				int y1 = parse_int(parsed[3]);
				int y2 = parse_int(parsed[4]);
				int intensity = (parsed.length() >= 6) ? parse_int(parsed[5]) : 50;

				reverb_zone rz(x1, x2, y1, y2, intensity);
				rz.map = this.name;
				reverb_zones.insert_last(rz);
				continue;
			}

			// PORTAMAPA - Alias para travelpoint
			if (parsed[0] == "portamapa" && parsed.length() >= 8) {
				int zone_x1 = parse_int(parsed[1]);
				int zone_y1 = parse_int(parsed[2]);
				int zone_x2 = parse_int(parsed[3]);
				int zone_y2 = parse_int(parsed[4]);
				int dest_x = parse_int(parsed[5]);
				int dest_y = parse_int(parsed[6]);
				string dest_map = parsed[7];
				string message = (parsed.length() > 8) ? parsed[8] : "Teleportado.";

				travel_point tp(zone_x1, zone_y1, zone_x2, zone_y2, dest_x, dest_y, dest_map, message);
				tp.map = this.name;
				travel_points.insert_last(tp);
				continue;
			}

			// PM2 - Variante de PM (mesmo parsing que PM)
			if (parsed[0] == "pm2" && parsed.length() >= 10) {
				int zone_x1 = parse_int(parsed[1]);
				int zone_y1 = parse_int(parsed[2]);
				int zone_x2 = parse_int(parsed[3]);
				int zone_y2 = parse_int(parsed[4]);
				int dest_x = parse_int(parsed[5]);
				int dest_y = parse_int(parsed[6]);
				string dest_map = parsed[7];
				string message = (parsed.length() > 8) ? parsed[8] : "Item coletado.";
				string snd = (parsed.length() > 9) ? parsed[9] : "door17open.ogg";
				string item = (parsed.length() > 10) ? parsed[10] : "item";

				pickup_point pp(zone_x1, zone_y1, zone_x2, zone_y2, dest_x, dest_y, dest_map, message, snd, item);
				pp.map = this.name;
				pickup_points.insert_last(pp);
				continue;
			}

			// W2 - Variante de parede (mesmo parsing que W)
			if (parsed[0] == "w2" && parsed.length() >= 5) {
				platform p1(parsed[0], parse_int(parsed[1]), parse_int(parsed[1]),
				           parse_int(parsed[2]), parse_int(parsed[3]), parsed[4]);
				platforms.insert_last(p1);
				continue;
			}

			// PNPC - NPC passivo (mesmo parsing que NPC, sem agressão)
			if (parsed[0] == "pnpc" && parsed.length() > 25) {
				npc b(parse_int(parsed[1]), parse_int(parsed[2]),
				     parse_int(parsed[3]), parse_int(parsed[4]),
				     parse_int(parsed[5]), parse_int(parsed[6]),
				     parse_int(parsed[7]), parse_int(parsed[8]),
				     parse_int(parsed[9]), parse_int(parsed[10]),
				     parse_int(parsed[11]), parsed[12], parsed[13],
				     parsed[14], parsed[15], parsed[16], parsed[17],
				     parse_int(parsed[18]), (parse_int(parsed[19]) != 0),
				     (parse_int(parsed[20]) != 0), this.name, parsed[21],
				     parse_int(parsed[22]), parse_int(parsed[23]),
				     parsed[24], parse_int(parsed[25]));
				b.pacifista = true;
				npcs.insert_last(b);
				continue;
			}

			// WHERE - Localização atual (parsing simples)
			if (parsed[0] == "where" && parsed.length() >= 2) {
				// WHERE já existe mais abaixo no código (linha 1868+)
				// Então vamos apenas registrar aqui para consistência
				continue;
			}

			// ========================================================================
			// FIM DO PARSING DOS NOVOS TIPOS (Task 1.3.1)
			// ========================================================================
		}
	}
	
	// ============================================================================
	// ATUALIZAÇÃO DE JOGADORES NO MAPA
	// ============================================================================
	void update_players_on_map(bool normal = true) {
		int value;
		string[] mapplayers_keys;
		
		if (!mapplayers_db.is_empty()) {
			mapplayers_keys = mapplayers_db.get_keys();
		}
		
		if (mapplayers.length() > 0) {
			mapplayers.resize(0);
		}
		
		if (normal) {
			// Atualizar índices dos jogadores existentes no DB
			for (uint i = 0; i < mapplayers_keys.length(); i++) {
				mapplayers_db.set(mapplayers_keys[i], get_player_index_from(mapplayers_keys[i]));
				mapplayers_db.get(mapplayers_keys[i], value);
				mapplayers.insert_last(value);
			}
			return;
		}
		else {
			// Reconstruir DB do zero baseado no array de jogadores
			mapplayers_db.delete_all();
			for (uint i = 0; i < players.length(); i++) {
				if (players[i].mapindex == this.mapindex) {
					mapplayers_db.set(players[i].charname, i);
					mapplayers.insert_last(i);
				}
			}
		}
	}
	
	// ============================================================================
	// LOOP PRINCIPAL DO MAPA
	// ============================================================================
	void maploop() {
		// Pausar mapa se não houver jogadores
		if (mapplayers.length() == 0 && paused == 0) {
			paused = 1;
		}
		
		// Executar loops de cada sistema
		if (arbols.length() > 0) {
			arbolLoop();
		}
		if (arbols_data.length() > 0) {
			arboldataloop();
		}
		if (walls.length() > 0) {
			wallLoop();
		}
		if (walls_data.length() > 0) {
			walldataloop();
		}
		if (deaths.length() > 0) {
			deathloop();
		}
		if (bullets.length() > 0) {
			bulletloop();
		}
		if (boladefogos.length() > 0) {
			boladefogoloop();
		}
		if (earthquakes.length() > 0) {
			earthquakeloop();
		}
		if (mines.length() > 0) {
			mineloop();
		}
		if (objs.length() > 0) {
			objloop();
		}
		if (objs_data.length() > 0) {
			objs_dataloop();
		}
		if (npcs.length() > 0 && pvp) {
			npcLoop();
		}
		if (npcs_data.length() > 0) {
			npcDataLoop();
		}
		// monstruoloop() e monstruo_dataloop() desabilitados - usando sistema global
		if (plasmabombs.length() > 0) {
			plasmabomb_loop();
		}
		if (pias.length() > 0) {
			pialoop();
		}
		if (portals.length() > 0) {
			portal_loop();
		}
	}
	
	// ============================================================================
	// MANIPULAÇÃO DE DADOS DO MAPA
	// ============================================================================
	void remove_line(string line) {
		for (uint i = 0; i < mapdata.length(); i++) {
			if (mapdata[i] == line) {
				mapdata.remove_at(i);
				return;
			}
		}
	}
	
	void add_line(string line) {
		mapdata.insert_last(line);
	}
	
	void replace_line(string line, string replace) {
		for (uint i = 0; i < mapdata.length(); i++) {
			if (mapdata[i].find(line) > -1) {
				mapdata[i] = mapdata[i].replace(line, replace);
				return;
			}
		}
	}
	
	// ============================================================================
	// SONS MÓVEIS
	// ============================================================================
	void update_moving_sound(int id, int x, int y) {
		for (uint i = 0; i < msounds.length(); i++) {
			if (msounds[i].id == "" + id) {
				msounds[i].update_position(x, y);
				for (uint j = 0; j < mapplayers.length(); j++) {
					int pidx = mapplayers[j];
					if(pidx < 0 || pidx >= int(players.length())) continue;
					send_reliable_text(players[pidx].peer_id, "um " + id + " " + x + " " + y + " " + this.name, 0);
				}
				break;
			}
		}
	}
	
	// Sobrecarga com string (converter para int)
	void update_moving_sound(string id_str, int x, int y) {
		int id = string_to_number(id_str);
		update_moving_sound(id, x, y);
	}
	
	void destroy_moving_sound(int id) {
		for (uint i = 0; i < msounds.length(); i++) {
			if (msounds[i].id == "" + id) {
				send_packet(0, "destroymsound " + id, true);
				@msounds[i] = null;
				msounds.remove_at(i);
				break;
			}
		}
	}
	
	// Sobrecarga com string
	void destroy_moving_sound(string id_str) {
		int id = string_to_number(id_str);
		destroy_moving_sound(id);
	}
	
	// ============================================================================
	// MÉTODOS DE LOOP DOS SISTEMAS DO MAPA
	// ============================================================================
	
	#include "map_resource_loops.nvgt"
	
	// ============================================================================
	// FASE 3: LOOP DE MORTE -  IMPLEMENTADO
	// ============================================================================
	
	void deathloop() {
		for (uint i = 0; i < mapplayers.length(); i++) {
			int pidx = mapplayers[i];
			if(pidx < 0 || pidx >= int(players.length())) continue;
			// Jogador está em zona de morte ativa
			if (players[pidx].ndeath == 1 && 
			    players[pidx].tdeath.elapsed >= players[pidx].death_time) {
				players[pidx].tdeath.restart();
				
				// Jogador não está assistindo (watching)
				if (players[pidx].watching == 0) {
					// Verificar se precisa de item e se jogador tem
					bool can_die = false;
					if (players[pidx].death_index < 0 || players[pidx].death_index >= int(this.deaths.length())) {
						continue;
					}
					if (this.deaths[players[pidx].death_index].require_item == 1) {
						if (players[pidx].inv_item_number(this.deaths[players[pidx].death_index].item) < 
						    this.deaths[players[pidx].death_index].item_cantity) {
							can_die = true;
						}
					}
					else {
						can_die = true;
					}
					
					if (can_die) {
						// Morte progressiva (dano contínuo)
						if (players[pidx].progressive_death == 1) {
							players[pidx].health -= players[pidx].death_life;
							players[pidx].lasthit = players[pidx].death_reason;
						}
						// Morte instantânea
						else if (players[pidx].progressive_death == 0) {
							players[pidx].health = -1;
							players[pidx].lasthit = players[pidx].death_reason;
						}
					}
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 6: LOOPS DE BOLAS DE FOGO -  IMPLEMENTADO
	// ============================================================================
	
	void boladefogoloop() {
		for (uint i = 0; i < boladefogos.length(); i++) {
			// Remover bola de fogo após 5 segundos
			if (boladefogos[i].tremover.elapsed >= 5000) {
				destroy_moving_sound(boladefogos[i].s);
				@boladefogos[i] = null;
				boladefogos.remove_at(i);
				break;
			}
			
			// Verificar colisão com paredes
			if (this.get_tile_at(boladefogos[i].x, boladefogos[i].y).find("wall") > -1) {
				destroy_moving_sound(boladefogos[i].s);
				send_packet(5, "play_npc boobytraphit1.ogg", boladefogos[i].x, boladefogos[i].y);
				@boladefogos[i] = null;
				boladefogos.remove_at(i);
				break;
			}
			
			// Movimento da bola de fogo (60ms por tile)
			if (boladefogos[i].tandar.elapsed >= 60) {
				boladefogos[i].tandar.restart();
				
				// Mover baseado na direção (usando constantes BGT)
				// Right=3, Left=2, Back=1, Forward=0
				if (boladefogos[i].lado == 3) { // Right
					boladefogos[i].x++;
					update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
				}
				else if (boladefogos[i].lado == 2) { // Left
					boladefogos[i].x--;
					update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
				}
				else if (boladefogos[i].lado == 1) { // Back
					boladefogos[i].y--;
					update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
				}
				else if (boladefogos[i].lado == 0) { // Forward
					boladefogos[i].y++;
					update_moving_sound(boladefogos[i].s, boladefogos[i].x, boladefogos[i].y);
				}
				
				// Verificar colisão com jogadores
				for (uint j = 0; j < mapplayers.length(); j++) {
					int pidx = mapplayers[j];
					if(pidx < 0 || pidx >= int(players.length())) continue;
					if (players[pidx].x == boladefogos[i].x && 
					    boladefogos[i].y == players[pidx].y && 
					    players[pidx].watching == 0 && 
					    players[pidx].pacifico == 0 && 
					    players[pidx].afk == false && 
					    !emequipe(boladefogos[i].nome, players[pidx].charname)) {
						
						// Aplicar dano
						players[pidx].health -= 2000;
						players[pidx].lasthit = "boladefogo_" + boladefogos[i].nome;
						send_packet(0, "inithurt " + players[pidx].voice, 
						           players[pidx].x, players[pidx].y);
						destroy_moving_sound(boladefogos[i].s);
						send_packet(5, "play_npc molotovatinge.ogg", players[pidx].x, players[pidx].y);
						
						// Se jogador sobreviveu, aplicar fogo contínuo
						if (players[pidx].health > 0) 
							players[pidx].spawn_playerfire(boladefogos[i].nome);
						
						@boladefogos[i] = null;
						boladefogos.remove_at(i);
						break;
					}
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 7: LOOPS DE BALAS -  IMPLEMENTADO
	// ============================================================================
	
	void bulletloop() {
		for (uint i = 0; i < bullets.length(); i++) {
			// Mover bala baseado na direção e verificar colisão
			// Left=2, Right=3, Forward=0, Back=1 (constantes BGT)
			switch (bullets[i].facing) {
				case 2: // Left
					bullets[i].x -= 1;
					bullets[i].distance += 1;
					bulletcheck(i);
					break;
				case 3: // Right
					bullets[i].x += 1;
					bullets[i].distance += 1;
					bulletcheck(i);
					break;
				case 0: // Forward
					bullets[i].y += 1;
					bullets[i].distance += 1;
					bulletcheck(i);
					break;
				case 1: // Back
					bullets[i].y -= 1;
					bullets[i].distance += 1;
					bulletcheck(i);
					break;
				default:
					bullets.remove_at(i);
			}
		}
	}
	
	void bulletcheck(int b) {
		// Verificar se bala ainda existe (pode ter sido removida em loop anterior)
		if (b >= int(bullets.length())) return;
		
		// Verificar safezone
		bool safezone = get_safezone_at(bullets[b].x, bullets[b].y);
		int j = get_player_index_from(bullets[b].owner);
		
		// Remover bala se: está em safezone, alcançou range máximo, dono não existe, ou dono está pacífico
		if (safezone || bullets[b].distance >= bullets[b].range || j < 0 || players[j].pacifico == 1) {
			bullets.remove_at(b);
			return;
		}
		
		int dano = bullets[b].damage;
		int amount = bullets[b].damage;
		
		// ========================================================================
		// COLISÃO COM ÁRVORES
		// ========================================================================
		for (uint bu = 0; bu < arbols.length(); bu++) {
			if (bullets[b].x == arbols[bu].x) {
				if (bullets[b].y == arbols[bu].miny) {
					arbols[bu].vida -= dano;
					// Som de impacto na árvore (resolvido via helper central de armas)
					send_packet(5, "play_wall " + get_weapon_wall_impact_sound(bullets[b].weapon) + ".ogg",
					           bullets[b].x, bullets[b].y);
					bullets.remove_at(b);
					return;
				}
			}
		}
		
		// ========================================================================
		// COLISÃO COM PORTAIS
		// ========================================================================
		for (uint bu = 0; bu < portals.length(); bu++) {
			if (bullets[b].x == portals[bu].x && bullets[b].y == portals[bu].y) {
				portals[bu].health -= dano;
				string portal_impact_sound = get_weapon_wall_impact_sound(bullets[b].weapon) + ".ogg";
				if(portals[bu].sounds_impact.length() > 0) {
					portal_impact_sound = portals[bu].sounds_impact[random(0, portals[bu].sounds_impact.length() - 1)];
				}
				send_packet(5, "play_wall " + portal_impact_sound, portals[bu].x, portals[bu].y);
				bullets.remove_at(b);
				return;
			}
		}
		
		// ========================================================================
		// COLISÃO COM PAREDES DESTRUTÍVEIS
		// ========================================================================
		for (uint bu = 0; bu < walls.length(); bu++) {
			if (bullets[b].x == walls[bu].x) {
				if (bullets[b].y == walls[bu].miny) {
					walls[bu].vida -= dano;
					send_packet(5, "play_wall " + get_weapon_wall_impact_sound(bullets[b].weapon) + ".ogg",
					           bullets[b].x, bullets[b].y);
					bullets.remove_at(b);
					return;
				}
			}
		}
		
		// ========================================================================
		// COLISÃO COM NPCs
		// ========================================================================
		for (uint bu = 0; bu < npcs.length(); bu++) {
			if (bullets[b].x == npcs[bu].x && bullets[b].y == npcs[bu].y) {
				// Som de impacto no NPC
				if (npcs[bu].impactosbala != "default" && npcs[bu].impactos.length() > 0) {
					send_packet(5, "play_body " + npcs[bu].impactos[random(0, npcs[bu].impactos.length() - 1)] + ".ogg", 
					           bullets[b].x, bullets[b].y);
				}
				else {
					send_packet(5, "play_body " + get_weapon_body_impact_sound(bullets[b].weapon) + ".ogg",
					           bullets[b].x, bullets[b].y);
				}
				
				if (bu > npcs.length()) return;
				
				// Aplicar dano
				if (npcs[bu].danoquerecibira == 0) {
					npcs[bu].vida -= dano;
				}
				else {
					npcs[bu].vida -= npcs[bu].danoquerecibira;
				}
				npcs[bu].asesino = bullets[b].owner;
				bullets.remove_at(b);
				return;
			}
		}
		
		// ========================================================================
		// COLISÃO COM MONSTROS
		// ========================================================================
		for (uint bu = 0; bu < monstruos.length(); bu++) {
			if (bullets[b].x == monstruos[bu].x && bullets[b].y == monstruos[bu].y) {
				monstruos[bu].golpeado = bullets[b].owner;
				monstruos[bu].vida -= dano;
				bullets.remove_at(b);
				return;
			}
		}
		
		// ========================================================================
		// COLISÃO COM JOGADORES (PvP)
		// ========================================================================
		dano = amount;
		j = get_player_index_from(bullets[b].owner);
		
		for (uint i = 0; i < mapplayers.length(); i++) {
			int pidx = mapplayers[i];
			if(pidx < 0 || pidx >= int(players.length())) continue;
			// Condições para hit: mesma posição, não é o próprio jogador, não está invisível, não está AFK, não está pacífico
			if (bullets[b].x == players[pidx].x && 
			    bullets[b].y == players[pidx].y && 
			    players[pidx].invs == 0 && 
			    !players[pidx].afk && 
			    players[pidx].pacifico == 0 && 
			    pidx != j) {
				
				// Verificar friendly fire (equipe)
				bool same_team = false;
				if(j >= 0 && j < int(players.length())) {
					for (uint bunda = 0; bunda < players[j].nomesequipe.length(); bunda++) {
						if (players[j].nomesequipe[bunda] == players[pidx].charname) {
							same_team = true;
							break; // Não atirar em membros da equipe
						}
					}
				}
				if(same_team) {
					bullets.remove_at(b); // Consome o projétil sem causar dano
					return;
				}
				
				// Sistema de miss/hit aleatório (1-6)
				int pozic = random(1, 6);
				
				// Miss (pozic == 2) - bala errou
				if (pozic == 2) {
					send_packet(5, "play_wall ba.ogg", bullets[b].x, bullets[b].y);
					bullets.remove_at(b);
					return;
				}
				
				// Hit confirmado - aplicar dano
				if (!players[pidx].crouched &&
				    players[pidx].watching == 0 &&
				    !players[pidx].in_portal) {
					
					// Sistema de degradação de roupas
					int c_i = -1;
					if (players[pidx].clothing_indexs.length() > 0) {
						c_i = random(0, players[pidx].clothing_indexs.length() - 1);
					}
					
					players[pidx].lasthit = bullets[b].owner;
					
					// Degradar roupa se houver
					if (c_i > -1 && has_clothe(c_i, pidx) &&
					    clothes[players[pidx].clothing_indexs[c_i]].enable_degradation) {
						players[pidx].manage_degradation(
							clothes[players[pidx].clothing_indexs[c_i]].name, 
							clothes[players[pidx].clothing_indexs[c_i]].degradation
						);
					}
					
					// Aplicar proteção de roupa ao dano
					if (players[pidx].clothing_protection > 0) {
						double new_amount = amount * players[pidx].clothing_protection;
						double new_damage = amount - new_amount;
						players[pidx].health -= new_damage;
					}
					else {
						players[pidx].health -= amount;
					}
					
					// Som de impacto no corpo
					send_packet(5, "play_body " + get_weapon_body_impact_sound(bullets[b].weapon) + ".ogg",
					           bullets[b].x, bullets[b].y);
					
					bullets.remove_at(b);
					return;
				}
			}
		}
		
		// ========================================================================
		// COLISÃO COM PAREDES DO MAPA
		// ========================================================================
		if (is_wall(bullets[b].x, bullets[b].y)) {
			send_packet(5, "play_wall " + get_weapon_wall_impact_sound(bullets[b].weapon) + ".ogg",
			           bullets[b].x, bullets[b].y);
			bullets.remove_at(b);
			return;
		}
	}
	
	// ============================================================================
	// FASE 8: LOOP DE TERREMOTOS -  IMPLEMENTADO
	// ============================================================================
	
	void earthquakeloop() {
		for (uint i = 0; i < earthquakes.length(); i++) {
			// Dano periódico a cada 5 segundos enquanto terremoto está ativo
			if (earthquakes[i].active && earthquakes[i].damagetimer.elapsed >= 5000) {
				earthquakes[i].damagetimer.restart();
				
				// Aplicar dano a todos os jogadores no mapa (exceto quem está watching)
				for (uint j = 0; j < mapplayers.length(); j++) {
					int pidx = mapplayers[j];
					if(pidx < 0 || pidx >= int(players.length())) continue;
					if (players[pidx].health > 0 && players[pidx].watching == 0) {
						// Dano aleatório entre 30000-40000
						players[pidx].health -= random(30000, 40000);
						players[pidx].lasthit = "terremoto_ " + earthquakes[i].owner;
						
						// Som de dor do jogador
						send_packet(0, "inithurt " + players[pidx].voice, 
						           players[pidx].x, players[pidx].y);
					}
				}
			}
			
			// Terremoto termina após duração especificada
			if (earthquakes[i].t.elapsed >= earthquakes[i].duration && earthquakes[i].active) {
				send_packet(0, "msg2 ;parece que el terremoto ha terminado.;", false);
				earthquakes[i].active = false;
			}
			
			// Remover terremoto quando inativo
			if (!earthquakes[i].active) {
				destroy_moving_sound(earthquakes[i].earthquake_sound);
				@earthquakes[i] = null;
				earthquakes.remove_at(i);
			}
		}
	}
	
	// ============================================================================
	// FASE 9: LOOP DE MINAS -  IMPLEMENTADO
	// ============================================================================
	
	void mineloop() {
		for (uint i = 0; i < mines.length(); i++) {
			if (mines[i].active) {
				int distance;
				
				// Som de explosão
				send_packet(0, "impact " + mines[i].sound_explosion, mines[i].x, mines[i].y);
				
				// Dano em jogadores dentro do raio
				for (uint j = 0; j < mapplayers.length(); j++) {
					int pidx = mapplayers[j];
					if(pidx < 0 || pidx >= int(players.length())) continue;
					distance = get_distance(mines[i].x, players[pidx].x, 
					                       mines[i].y, players[pidx].y);
					
					// Só aplica dano se: não pacífico, não AFK, não newbie, sem antimina, não em portal
					if (players[pidx].pacifico == 0 && 
					    !players[pidx].afk && 
					    !players[pidx].newbie && 
					    players[pidx].antimina == 0 && 
					    !players[pidx].in_portal) {
						
						send_packet(0, "inithurt " + players[pidx].voice, 
						           players[pidx].x, players[pidx].y);
						players[pidx].lasthit = mines[i].owner + "'s mina";
						players[pidx].health -= mines[i].get_damage(distance);
					}
				}
				
				// Dano em árvores
				for (uint j = 0; j < arbols.length(); j++) {
					distance = get_distance(mines[i].x, arbols[j].x, 
					                       mines[i].y, arbols[j].miny);
					arbols[j].vida -= mines[i].get_damage(distance);
				}
				
				// Dano em NPCs (se enablebombs estiver ativo)
				for (uint j = 0; j < npcs.length(); j++) {
					if (npcs[j].enablebombs) {
						distance = get_distance(mines[i].x, npcs[j].x, 
						                       mines[i].y, npcs[j].y);
						npcs[j].asesino = mines[i].owner;
						npcs[j].vida -= mines[i].get_damage(distance);
					}
				}
				
				// Dano em portais
				for (uint j = 0; j < portals.length(); j++) {
					distance = get_distance(mines[i].x, portals[j].x, 
					                       mines[i].y, portals[j].y);
					portals[j].health -= mines[i].get_damage(distance);
				}
				
				// Dano em paredes destrutíveis
				for (uint j = 0; j < walls.length(); j++) {
					distance = get_distance(mines[i].x, walls[j].x, 
					                       mines[i].y, walls[j].miny);
					walls[j].vida -= mines[i].get_damage(distance);
				}
				
				// Remover mina após explosão
				mines.remove_at(i);
				break;
			}
		}
	}
	
	// ============================================================================
	// FASE 10: LOOPS DE NPCs -  IMPLEMENTADO
	// ============================================================================
	
	void npcLoop() {
		for (uint i = 0; i < npcs.length(); i++) {
			// Inicializar mapindex se necessário
			if (npcs[i].mapindex == -1) {
				npcs[i].mapindex = get_map_index_from(this.name);
			}
			
			// Morte do NPC
			if (npcs[i].vida <= 0) {
				npcs[i].die();
				npc_data nd(
					npcs[i].x_inicial,
					npcs[i].y_inicial,
					npcs[i].vida_inicial,
					npcs[i].xp_reward,
					npcs[i].distanciaataques,
					npcs[i].danoquerecibira,
					npcs[i].danoquedara,
					npcs[i].danodelespejo,
					npcs[i].tiempoparaatacar,
					npcs[i].tiempoparacaminar,
					npcs[i].tiempodelossonidos,
					npcs[i].itemsadar,
					npcs[i].sonidoataque,
					join(npcs[i].sonidosnervioso, ","),
					npcs[i].sonidomuerte,
					npcs[i].nombrenpc,
					npcs[i].msgmuerte,
					npcs[i].tiempoaparicion,
					npcs[i].enablerespawn,
					npcs[i].enablebombs,
					this.name,
					npcs[i].pasosnpc,
					npcs[i].left_range,
					npcs[i].right_range,
					npcs[i].impactosbala,
					npcs[i].degradation,
					npcs[i].pacifista
				);
				npcs_data.insert_last(nd);
				@npcs[i] = null;
				npcs.remove_at(i);
				break;
			}
			
			// Sons nervosos periódicos
			if (npcs[i].ttiempodelossonidos.elapsed >= npcs[i].tiempodelossonidos) {
				npcs[i].ttiempodelossonidos.restart();
				if(npcs[i].sonidosnervioso.length() > 0) {
					send_packet(5, "play_npc " + npcs[i].sonidosnervioso[random(0, npcs[i].sonidosnervioso.length() - 1)] + ".ogg",
					           npcs[i].x, npcs[i].y);
				}
			}
			
			// Verificar se jogador alvo ainda existe no mapa
			if (npcs[i].p_index > -1) {
				bool exists = npcs[i].exists_player_in_my_map();
				if (!exists) npcs[i].p_index = -1;
			}
			
			// Selecionar novo jogador para atacar se não tem alvo
			if (npcs[i].p_index == -1) {
				npcs[i].p_index = npcs[i].select_player_to_attack();
			}
			
			// Atualizar jogador alvo (verificar se ficou pacífico ou AFK)
			if (npcs[i].update_player.elapsed >= 50) {
				npcs[i].update_player.restart();
				if (mapplayers.length() > 1) {
					if (npcs[i].p_index >= int(players.length())) {
						npcs[i].p_index = -1;
					}
					else if (npcs[i].p_index > -1 && 
					    (players[npcs[i].p_index].pacifico == 1 || players[npcs[i].p_index].afk)) {
						npcs[i].p_index = npcs[i].change_player(npcs[i].p_index);
					}
				}
			}
			
			// Movimento do NPC em direção ao jogador
			if (npcs[i].ttiempoparacaminar.elapsed >= npcs[i].tiempoparacaminar && npcs[i].p_index > -1) {
				npcs[i].ttiempoparacaminar.restart();
				npcs[i].move();
			}
			
			// Sistema de ataque
			if (npcs[i].ttiempoparaatacar.elapsed >= npcs[i].tiempoparaatacar) {
				npcs[i].ttiempoparaatacar.restart();
				
				// Condições para atacar:
				// - Tem jogador alvo
				// - Está dentro da distância de ataque
				// - Jogador não está AFK, watching ou pacífico
				if (npcs[i].p_index > -1) {
					if (npcs[i].p_index >= int(players.length())) {
						npcs[i].p_index = -1;
						continue;
					}
					int distance = get_distance(npcs[i].x, players[npcs[i].p_index].x, 
					                           npcs[i].y, players[npcs[i].p_index].y);
					
					if (distance > -1 && 
					    distance <= npcs[i].distanciaataques && 
					    !players[npcs[i].p_index].afk && 
					    players[npcs[i].p_index].watching == 0 && 
					    players[npcs[i].p_index].pacifico == 0) {
						npcs[i].attack();
					}
				}
			}
		}
	}
	
	void npcDataLoop() {
		for (uint i = 0; i < npcs_data.length(); i++) {
			// Verificar se é hora de fazer respawn
			if (npcs_data[i].respawn_timer.elapsed >= npcs_data[i].tiempoaparicion) {

				// Modo: Respawn único (enablerespawn == false)
				if (!npcs_data[i].enablerespawn) {
					// Verificar se NPC já existe
					if (get_npc_index(npcs_data[i].nombrenpc) > -1) {
						// NPC já está ativo, não criar outro
						continue;
					}
					
					// Só cria se não existir nenhum NPC deste tipo
					npc n(npcs_data[i].x, npcs_data[i].y, npcs_data[i].vida,
					     npcs_data[i].xp_reward, npcs_data[i].distanciaataques,
					     npcs_data[i].danoquerecibira, npcs_data[i].danoquedara,
					     npcs_data[i].danodelespejo, npcs_data[i].tiempoparaatacar,
					     npcs_data[i].tiempoparacaminar, npcs_data[i].tiempodelossonidos,
					     npcs_data[i].itemsadar, npcs_data[i].sonidoataque,
					     npcs_data[i].sonidonervioso, npcs_data[i].sonidomuerte,
					     npcs_data[i].nombrenpc, npcs_data[i].msgmuerte,
					     npcs_data[i].tiempoaparicion, npcs_data[i].enablerespawn,
					     npcs_data[i].enablebombs, this.name, npcs_data[i].pasosnpc,
					     npcs_data[i].left_range, npcs_data[i].right_range,
					     npcs_data[i].impactosbala, npcs_data[i].degradation);
					n.pacifista = npcs_data[i].pacifista;

					@npcs_data[i] = null;
					npcs_data.remove_at(i);
					npcs.insert_last(n);
					break;
				}
				// Modo: Respawn múltiplo (enablerespawn == true)
				else if (npcs_data[i].enablerespawn) {
					// Sempre criar novo NPC quando respawnar
					npc n(npcs_data[i].x, npcs_data[i].y, npcs_data[i].vida,
					     npcs_data[i].xp_reward, npcs_data[i].distanciaataques,
					     npcs_data[i].danoquerecibira, npcs_data[i].danoquedara,
					     npcs_data[i].danodelespejo, npcs_data[i].tiempoparaatacar,
					     npcs_data[i].tiempoparacaminar, npcs_data[i].tiempodelossonidos,
					     npcs_data[i].itemsadar, npcs_data[i].sonidoataque,
					     npcs_data[i].sonidonervioso, npcs_data[i].sonidomuerte,
					     npcs_data[i].nombrenpc, npcs_data[i].msgmuerte,
					     npcs_data[i].tiempoaparicion, npcs_data[i].enablerespawn,
					     npcs_data[i].enablebombs, this.name, npcs_data[i].pasosnpc,
					     npcs_data[i].left_range, npcs_data[i].right_range,
					     npcs_data[i].impactosbala, npcs_data[i].degradation);
					n.pacifista = npcs_data[i].pacifista;

					@npcs_data[i] = null;
					npcs_data.remove_at(i);
					npcs.insert_last(n);
					break;
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 11: LOOPS DE MONSTROS - DESABILITADO (usando monstruo_global_loop())
	// ============================================================================
	
	// ============================================================================
	// FASE 12: LOOP DE BOMBAS DE PLASMA -  IMPLEMENTADO
	// ============================================================================
	
	void plasmabomb_loop() {
		for (uint i = 0; i < plasmabombs.length(); i++) {
			// Contagem regressiva (1 segundo por tick)
			if (plasmabombs[i].explosiontime > 0 && plasmabombs[i].objecttimer.elapsed >= 1000) {
				plasmabombs[i].objecttimer.restart();
				plasmabombs[i].explosiontime -= 1;
			}
			
			// EXPLOSÃO - Mata todos no mapa (exceto admins, newbies, afk, watching, pacíficos)
			if (plasmabombs[i].explosiontime == 0) {
				send_packet(5, "play_npc " + plasmabombs[i].explosion_sound, 
				           plasmabombs[i].coor_x, plasmabombs[i].coor_y);
				
				// Aplicar morte instantânea a todos os jogadores no mapa
				for (uint j = 0; j < mapplayers.length(); j++) {
					int pidx = mapplayers[j];
					if(pidx < 0 || pidx >= int(players.length())) continue;
					if (!players[pidx].afk && 
					    !players[pidx].newbie && 
					    !players[pidx].is_admin && 
					    players[pidx].watching == 0 && 
					    players[pidx].pacifico == 0) {
						
						players[pidx].lasthit = plasmabombs[i].name + " " + "de" + " " + plasmabombs[i].owner;
						players[pidx].health = 0;
					}
				}
				
				// Remover bomba após explosão
				plasmabombs.remove_at(i);
				break;
			}
		}
	}
	
	// ============================================================================
	// FASE 13: LOOPS DE PIAS -  IMPLEMENTADO
	// ============================================================================
	
	void pialoop() {
		for (uint i = 0; i < pias.length(); i++) {
			// Fechar pia automaticamente após tempo (7903ms)
			if (pias[i].aberta && pias[i].fechar.elapsed >= 7903) {
				pias[i].aberta = false;
				send_packet(0, "startmoving", pias[i].x, pias[i].y, 0);
				pias[i].fechando.force(0);
				pias[i].fechando.pause();
				pias[i].fechar.force(0);
				pias[i].fechar.pause();
			}
			
			// Limpeza contínua dos jogadores na pia
			if (pias[i].aberta && pias[i].fechando.elapsed >= 250) {
				pias[i].fechando.restart();
				for (uint j = 0; j < mapplayers.length(); j++) {
					int pidx = mapplayers[j];
					if(pidx < 0 || pidx >= int(players.length())) continue;
					if (pias[i].x == players[pidx].x && 
					    pias[i].y == players[pidx].y) {
						players[pidx].sujo -= 5;
						if (players[pidx].sujo < 0) players[pidx].sujo = 0;
					}
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 14: LOOP DE PORTAIS -  IMPLEMENTADO
	// ============================================================================
	
	void portal_loop() {
		for (uint i = 0; i < portals.length(); i++) {
			// Atualizar timer do portal (contagem regressiva)
			if (portals[i].time_wait > 0 && portals[i].portaltimer.elapsed >= 1000) {
				portals[i].portaltimer.restart();
				portals[i].time_wait -= 1;
				update_moving_sound(portals[i].sound_loop, portals[i].x, portals[i].y);
			}
			
			// Portal destruído (health <= 0) - EXPLODE e causa dano em área
			if (portals[i].health <= 0) {
				int distance;
				destroy_moving_sound(portals[i].sound_loop);
				send_packet(5, "play_npc " + portals[i].sound_explosion, 
				           portals[i].x, portals[i].y, portals[i].damage_range);
				
				// Dano em jogadores
				for (uint j = 0; j < mapplayers.length(); j++) {
					int pidx = mapplayers[j];
					if(pidx < 0 || pidx >= int(players.length())) continue;
					distance = get_distance(portals[i].x, players[pidx].x, 
					                       portals[i].y, players[pidx].y);
					players[pidx].lasthit = "portal_de_luz";
					players[pidx].health -= portals[i].get_damage(distance);
				}
				
				// Dano em árvores
				for (uint j = 0; j < arbols.length(); j++) {
					distance = get_distance(portals[i].x, arbols[j].x, 
					                       portals[i].y, arbols[j].miny);
					arbols[j].vida -= portals[i].get_damage(distance);
				}
				
				// Dano em NPCs (se enablebombs != 0)
				for (uint j = 0; j < npcs.length(); j++) {
					if (npcs[j].enablebombs) {
						distance = get_distance(portals[i].x, npcs[j].x, 
						                       portals[i].y, npcs[j].y);
						npcs[j].asesino = portals[i].owner;
						npcs[j].vida -= portals[i].get_damage(distance);
					}
				}
				
				// Dano em paredes
				for (uint j = 0; j < walls.length(); j++) {
					distance = get_distance(portals[i].x, walls[j].x, 
					                       portals[i].y, walls[j].miny);
					walls[j].vida -= portals[i].get_damage(distance);
				}
				
				portals.remove_at(i);
				break;
			}
			
			// Portal pronto para teleporte (time_wait == 0)
			if (portals[i].time_wait == 0) {
				string[] portalplayers = portals[i].portalplayers.get_keys();
				int restorehealth;
				
				// Teleportar todos os jogadores no portal
				for (int j = int(portalplayers.length()) - 1; j > -1; j--) {
					int index = get_player_index_from(portalplayers[j]);
					
					if (index > -1) {
						if (players[index].in_portal) {
							// Teleportar jogador
							changemap(portals[i].destination, index, 
							         portals[i].destination_x, portals[i].destination_y);
							
							// Restaurar health (troca: portal perde health, jogador ganha)
							portals[i].portalplayers.get(portalplayers[j], restorehealth);
							players[index].health += restorehealth;
							portals[i].health -= restorehealth;
							
							// Finalizar teleporte
							send_reliable_text(players[index].peer_id, "startmoving", 0);
							players[index].in_portal = false;
							portals[i].portalplayers.delete(j);
						}
					}
				}
				
				// Destruir portal após uso
				destroy_moving_sound(portals[i].sound_loop);
				send_packet(5, "play_npc " + portals[i].sound_final, portals[i].x, portals[i].y);
				
				// Som de aparição no mapa de destino
				server_maps[portals[i].mapindex2].send_packet(5, "play_npc " + portals[i].sound_appears, 
				                                               portals[i].destination_x, portals[i].destination_y);
				
				portals.remove_at(i);
				break;
			}
		}
	}
	
	// ============================================================================
	// CONVERSÃO COMPLETA - TODAS AS 14 FASES IMPLEMENTADAS! 
	// ============================================================================
	
	// ============================================================================
	// MÉTODOS AUXILIARES - VERIFICAÇÃO DE ENTIDADES
	// ============================================================================
	
	int have_extract(int x, int y) {
		for (uint i = 0; i < extracts.length(); i++) {
			int minx = extracts[i].minx;
			int maxx = extracts[i].maxx;
			int miny = extracts[i].miny;
			int maxy = extracts[i].maxy;
			if (minx > x) continue;
			if (minx <= x && maxx >= x && miny <= y && maxy >= y) {
				return i;
			}
		}
		return -1;
	}
	
	int have_toilet(int x, int y) {
		for (uint i = 0; i < banheiros.length(); i++) {
			if (x == banheiros[i].x && y == banheiros[i].y) {
				return i;
			}
		}
		return -1;
	}
	
	int have_handwash(int x, int y) {
		for (uint i = 0; i < pias.length(); i++) {
			if (x == pias[i].x && y == pias[i].y) {
				return i;
			}
		}
		return -1;
	}
	
	int have_mine(int x, int y) {
		for (uint i = 0; i < mines.length(); i++) {
			if (mines[i].x == x && mines[i].y == y) {
				return i;
			}
		}
		return -1;
	}
	
	int have_obj(int x, int y) {
		for (uint i = 0; i < objs.length(); i++) {
			if (objs[i].x == x && objs[i].y == y) {
				return i;
			}
		}
		return -1;
	}
	
	bool have_portal(int x, int y, int &out portalindex) {
		for (uint i = 0; i < portals.length(); i++) {
			if (portals[i].x == x && portals[i].y == y) {
				portalindex = i;
				return true;
			}
		}
		portalindex = -1;
		return false;
	}
	
