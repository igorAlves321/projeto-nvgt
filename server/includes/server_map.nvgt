	// ============================================================================
	// FASE 11: LOOPS DE MONSTROS - ✅ IMPLEMENTADO
	// ============================================================================
	
	void monstruoloop() {
		for (uint i = 0; i < monstruos.length(); i++) {
			// Morte do monstro
			if (monstruos[i].vida <= 0) {
				send_packet(5, "play_npc m_monstruo.ogg", monstruos[i].x, monstruos[i].y);
				string golp = monstruos[i].golpeado;
				send_reliable(0, "msgmuerte " + golp + "; ;ha derrotado al monstruo legendario!", 3);
				
				// Recompensas para quem matou
				int xx = get_player_index_from(golp);
				if (xx > -1) {
					gc(players[xx].charname, random(20, 35));
					players[xx].inv_add_item("hueso_del_monstruo", 1);
					players[xx].inv_add_item("reais", 94525239);
					players[xx].inv_add_item("dólares", 16592363);
					ganhaxp(players[xx].charname, random(65000000, 75000000));
				}
				
				// Criar dados para respawn
				monstruo_data mnd(monstruos[i].x, monstruos[i].y);
				@monstruos[i] = null;
				monstruos.remove_at(i);
				monstruos_data.insert_last(mnd);
				break;
			}
			
			// Sons nervosos periódicos
			if (monstruos[i].tsom.elapsed >= monstruos[i].asom + random(1000, 3200)) {
				monstruos[i].tsom.restart();
				string ss = "monstruonervoso.ogg";
				send_packet(5, "play_npc " + ss, monstruos[i].x, monstruos[i].y);
			}
			
			// Movimento e ataque do monstro
			if (monstruos[i].monstruotimer.elapsed >= monstruos[i].monstruotime) {
				monstruos[i].monstruotimer.restart();
				
				for (uint j = 0; j < mapplayers.length(); j++) {
					// Mover em direção ao jogador (eixo X)
					if (monstruos[i].x > players[mapplayers[j]].x + 2 && 
					    players[mapplayers[j]].watching == 0 && 
					    players[mapplayers[j]].newbie == false && 
					    players[mapplayers[j]].afk == false) {
						monstruos[i].x -= 2;
						string ss = get_tile_at(monstruos[i].x, monstruos[i].y);
						send_packet(5, "play_step " + ss + "step" + random(1, 5) + ".ogg", 
						           monstruos[i].x, monstruos[i].y);
						monstruos[i].monstruotimer.restart();
						break;
					}
					else if (monstruos[i].x < players[mapplayers[j]].x - 2 && 
					         players[mapplayers[j]].watching == 0 && 
					         players[mapplayers[j]].afk == false && 
					         players[mapplayers[j]].newbie == false) {
						monstruos[i].x += 2;
						string ss = get_tile_at(monstruos[i].x, monstruos[i].y);
						send_packet(5, "play_step " + ss + "step" + random(1, 5) + ".ogg", 
						           monstruos[i].x, monstruos[i].y);
						monstruos[i].monstruotimer.restart();
						break;
					}
					
					// Sistema de ataque do monstro
					int distance = get_distance(monstruos[i].x, players[mapplayers[j]].x, 
					                           monstruos[i].y, players[mapplayers[j]].y);
					
					if (distance > 2 && 
					    players[mapplayers[j]].afk == false && 
					    players[mapplayers[j]].watching == 0 && 
					    players[mapplayers[j]].pacifico == 0 && 
					    players[mapplayers[j]].newbie == false && 
					    monstruos[i].tempoatirar.elapsed >= 1500 && 
					    monstruos[i].tiros > 0) {
						
						monstruos[i].tempoatirar.restart();
						string ss = "monstruobater" + random(1, 4) + ".ogg";
						
						// Ataque especial (monstruobater2.ogg) - derruba jogador
						if (ss == "monstruobater2.ogg") {
							send_packet(5, "play_npc " + ss, monstruos[i].x, monstruos[i].y);
							send_reliable(players[mapplayers[j]].peer_id, "ataque", 0);
							players[mapplayers[j]].centado = true;
						}
						else {
							send_packet(5, "play_npc " + ss, monstruos[i].x, monstruos[i].y);
						}
						
						// Aplicar dano
						players[mapplayers[j]].health -= random(40000, 60000);
						send_packet(0, "inithurt " + players[mapplayers[j]].voice, 
						           players[mapplayers[j]].x, players[mapplayers[j]].y);
						players[mapplayers[j]].lasthit = "monstruo";
						monstruos[i].tiros--;
						break;
					}
					
					// Recarregar tiros
					if (monstruos[i].tiros <= 0) {
						monstruos[i].tiros = 1;
						monstruos[i].tempoatirar.restart();
					}
				}
			}
		}
	}
	
	void monstruo_dataloop() {
		for (uint i = 0; i < monstruos_data.length(); i++) {
			// Verificar tempo de respawn
			if (monstruos_data[i].respawn_timer.elapsed >= monstruos_data[i].trespawn) {
				monstruo mn(monstruos_data[i].x, monstruos_data[i].y, this.name);
				@monstruos_data[i] = null;
				monstruos_data.remove_at(i);
				monstruos.insert_last(mn);
				break;
			}
		}
	}
	
	// ============================================================================
	// FASE 12: LOOP DE BOMBAS DE PLASMA - ✅ IMPLEMENTADO
	// ============================================================================
	
	void plasmabomb_loop() {
		for (uint i = 0; i < plasmabombs.length(); i++) {
			// Contagem regressiva (1 segundo por tick)
			if (plasmabombs[i].explosiontime > 0 && plasmabombs[i].objecttimer.elapsed >= 1000) {
				plasmabombs[i].objecttimer.restart();
				plasmabombs[i].explosiontime -= 1;
			}
			
			// EXPLOSÃO - Mata todos no mapa (exceto admins, newbies, afk, watching, pacíficos)
			if (plasmabombs[i].explosiontime == 0) {
				send_packet(5, "play_npc " + plasmabombs[i].explosion_sound, 
				           plasmabombs[i].coor_x, plasmabombs[i].coor_y);
				
				// Aplicar morte instantânea a todos os jogadores no mapa
				for (uint j = 0; j < mapplayers.length(); j++) {
					if (!players[mapplayers[j]].afk && 
					    !players[mapplayers[j]].newbie && 
					    !players[mapplayers[j]].is_admin && 
					    players[mapplayers[j]].watching == 0 && 
					    players[mapplayers[j]].pacifico == 0) {
						
						players[mapplayers[j]].lasthit = plasmabombs[i].name + " " + "de" + " " + plasmabombs[i].owner;
						players[mapplayers[j]].health = 0;
					}
				}
				
				// Remover bomba após explosão
				plasmabombs.remove_at(i);
				break;
			}
		}
	}
	
	// ============================================================================
	// FASE 13: LOOPS DE PIAS - ✅ IMPLEMENTADO
	// ============================================================================
	
	void pialoop() {
		for (uint i = 0; i < pias.length(); i++) {
			// Fechar pia automaticamente após tempo (7903ms)
			if (pias[i].aberta && pias[i].fechar.elapsed >= 7903) {
				pias[i].aberta = false;
				send_packet(0, "startmoving", pias[i].x, pias[i].y, 0);
				pias[i].fechando.force(0);
				pias[i].fechando.pause();
				pias[i].fechar.force(0);
				pias[i].fechar.pause();
			}
			
			// Limpeza contínua dos jogadores na pia
			if (pias[i].aberta && pias[i].fechando.elapsed >= 250) {
				pias[i].fechando.restart();
				for (uint j = 0; j < mapplayers.length(); j++) {
					if (pias[i].x == players[mapplayers[j]].x && 
					    pias[i].y == players[mapplayers[j]].y) {
						players[mapplayers[j]].sujo -= 5;
						if (players[mapplayers[j]].sujo < 0) players[mapplayers[j]].sujo = 0;
					}
				}
			}
		}
	}
	
	// ============================================================================
	// FASE 14: LOOP DE PORTAIS - ✅ IMPLEMENTADO
	// ============================================================================
	
	void portal_loop() {
		for (uint i = 0; i < portals.length(); i++) {
			// Atualizar timer do portal (contagem regressiva)
			if (portals[i].time_wait > 0 && portals[i].portaltimer.elapsed >= 1000) {
				portals[i].portaltimer.restart();
				portals[i].time_wait -= 1;
				update_moving_sound(portals[i].sound_loop, portals[i].x, portals[i].y);
			}
			
			// Portal destruído (health <= 0) - EXPLODE e causa dano em área
			if (portals[i].health <= 0) {
				int distance;
				destroy_moving_sound(portals[i].sound_loop);
				send_packet(5, "play_npc " + portals[i].sound_explosion, 
				           portals[i].x, portals[i].y, portals[i].damage_range);
				
				// Dano em jogadores
				for (uint j = 0; j < mapplayers.length(); j++) {
					distance = get_distance(portals[i].x, players[mapplayers[j]].x, 
					                       portals[i].y, players[mapplayers[j]].y);
					players[mapplayers[j]].lasthit = "portal_de_luz";
					players[mapplayers[j]].health -= portals[i].get_damage(distance);
				}
				
				// Dano em árvores
				for (uint j = 0; j < arbols.length(); j++) {
					distance = get_distance(portals[i].x, arbols[j].x, 
					                       portals[i].y, arbols[j].miny);
					arbols[j].vida -= portals[i].get_damage(distance);
				}
				
				// Dano em NPCs (se enablebombs != 0)
				for (uint j = 0; j < npcs.length(); j++) {
					if (npcs[j].enablebombs) {
						distance = get_distance(portals[i].x, npcs[j].x, 
						                       portals[i].y, npcs[j].y);
						npcs[j].asesino = portals[i].owner;
						npcs[j].vida -= portals[i].get_damage(distance);
					}
				}
				
				// Dano em paredes
				for (uint j = 0; j < walls.length(); j++) {
					distance = get_distance(portals[i].x, walls[j].x, 
					                       portals[i].y, walls[j].miny);
					walls[j].vida -= portals[i].get_damage(distance);
				}
				
				portals.remove_at(i);
				break;
			}
			
			// Portal pronto para teleporte (time_wait == 0)
			if (portals[i].time_wait == 0) {
				string[] portalplayers = portals[i].portalplayers.get_keys();
				int restorehealth;
				
				// Teleportar todos os jogadores no portal
				for (int j = int(portalplayers.length()) - 1; j > -1; j--) {
					int index = get_player_index_from(portalplayers[j]);
					
					if (index > -1) {
						if (players[index].in_portal) {
							// Teleportar jogador
							changemap(portals[i].destination, index, 
							         portals[i].destination_x, portals[i].destination_y);
							
							// Restaurar health (troca: portal perde health, jogador ganha)
							portals[i].portalplayers.get(portalplayers[j], restorehealth);
							players[index].health += restorehealth;
							portals[i].health -= restorehealth;
							
							// Finalizar teleporte
							send_reliable(players[index].peer_id, "startmoving", 0);
							players[index].in_portal = false;
							portals[i].portalplayers.delete(j);
						}
					}
				}
				
				// Destruir portal após uso
				destroy_moving_sound(portals[i].sound_loop);
				send_packet(5, "play_npc " + portals[i].sound_final, portals[i].x, portals[i].y);
				
				// Som de aparição no mapa de destino
				server_maps[portals[i].mapindex2].send_packet(5, "play_npc " + portals[i].sound_appears, 
				                                               portals[i].destination_x, portals[i].destination_y);
				
				portals.remove_at(i);
				break;
			}
		}
	}
	
	// ============================================================================
	// CONVERSÃO COMPLETA - TODAS AS 14 FASES IMPLEMENTADAS! 🎉
	// ============================================================================
	
	// ============================================================================
	// MÉTODOS AUXILIARES - VERIFICAÇÃO DE ENTIDADES
	// ============================================================================
	
	int have_extract(int x, int y) {
		for (uint i = 0; i < extracts.length(); i++) {
			int minx = extracts[i].minx;
			int maxx = extracts[i].maxx;
			int miny = extracts[i].miny;
			int maxy = extracts[i].maxy;
			if (minx > x) continue;
			if (minx <= x && maxx >= x && miny <= y && maxy >= y) {
				return i;
			}
		}
		return -1;
	}
	
	int have_toilet(int x, int y) {
		for (uint i = 0; i < banheiros.length(); i++) {
			if (x == banheiros[i].x && y == banheiros[i].y) {
				return i;
			}
		}
		return -1;
	}
	
	int have_handwash(int x, int y) {
		for (uint i = 0; i < pias.length(); i++) {
			if (x == pias[i].x && y == pias[i].y) {
				return i;
			}
		}
		return -1;
	}
	
	int have_mine(int x, int y) {
		for (uint i = 0; i < mines.length(); i++) {
			if (mines[i].x == x && mines[i].y == y) {
				return i;
			}
		}
		return -1;
	}
	
	int have_obj(int x, int y) {
		for (uint i = 0; i < objs.length(); i++) {
			if (objs[i].x == x && objs[i].y == y) {
				return i;
			}
		}
		return -1;
	}
	
	bool have_portal(int x, int y, int &out portalindex) {
		for (uint i = 0; i < portals.length(); i++) {
			if (portals[i].x == x && portals[i].y == y) {
				portalindex = i;
				return true;
			}
		}
		portalindex = -1;
		return false;
	}
	
	int get_npc_index(int id) {
		for (uint x = 0; x < npcs.length(); x++) {
			if (npcs[x].id == id) {
				return x;
			}
		}
		return -1;
	}
	
	int get_npc_index(int x, int y) {
		for (uint i = 0; i < npcs.length(); i++) {
			if (npcs[i].x_inicial == x && npcs[i].y_inicial == y) {
				return i;
			}
		}
		return -1;
	}
	
	int get_npc_index(string name) {
		for (uint x = 0; x < npcs.length(); x++) {
			if (npcs[x].nombrenpc == name) {
				return x;
			}
		}
		return -1;
	}
	
	int get_npc_quantity(string name) {
		int quantity = 0;
		for (uint x = 0; x < npcs.length(); x++) {
			if (npcs[x].nombrenpc == name) {
				quantity++;
			}
		}
		return quantity;
	}
	
	bool is_disabled(string item) {
		if (desactivados.exists(item)) {
			return true;
		}
		return false;
	}
	
	string get_tile_at(int x, int y) {
		string outval;
		int minx, maxx, miny, maxy;
		for (uint i = 0; i < platforms.length(); i++) {
			minx = platforms[i].min_x;
			maxx = platforms[i].max_x;
			miny = platforms[i].min_y;
			maxy = platforms[i].max_y;
			if (minx > x) continue;
			if (minx <= x && maxx >= x && miny <= y && maxy >= y) {
				outval = platforms[i].tiles;
				continue;
			}
		}
		return outval;
	}
	
	bool is_platform(int x, int y) {
		int minx, maxx, miny, maxy;
		for (uint i = 0; i < platforms.length(); i++) {
			minx = platforms[i].min_x;
			maxx = platforms[i].max_x;
			miny = platforms[i].min_y;
			maxy = platforms[i].max_y;
			if (minx > x) continue;
			if (minx <= x && maxx >= x && miny <= y && maxy >= y && platforms[i].is_platform) 
				return platforms[i].is_platform;
		}
		return false;
	}
	
	bool is_staircase(int x, int y) {
		int minx, maxx, miny, maxy;
		for (uint i = 0; i < platforms.length(); i++) {
			minx = platforms[i].min_x;
			maxx = platforms[i].max_x;
			miny = platforms[i].min_y;
			maxy = platforms[i].max_y;
			if (minx > x) continue;
			if (minx <= x && maxx >= x && miny <= y && maxy >= y && platforms[i].is_staircase) 
				return platforms[i].is_staircase;
		}
		return false;
	}
	
	bool is_wall(int x, int y) {
		int minx, maxx, miny, maxy;
		for (uint i = 0; i < platforms.length(); i++) {
			minx = platforms[i].min_x;
			maxx = platforms[i].max_x;
			miny = platforms[i].min_y;
			maxy = platforms[i].max_y;
			if (minx > x) continue;
			if (minx <= x && maxx >= x && miny <= y && maxy >= y && platforms[i].is_wall) 
				return platforms[i].is_wall;
		}
		return false;
	}
	
	string get_zone_at(int x, int y) {
		string outval;
		for (uint i = 0; i < zones.length(); i++) {
			if (zones.length() > 0) {
				int minx = zones[i].min_x;
				int maxx = zones[i].max_x;
				int miny = zones[i].min_y;
				int maxy = zones[i].max_y;
				if (minx > x) continue;
				if (minx <= x && maxx >= x && miny <= y && maxy >= y) 
					outval = zones[i].text;
			}
		}
		return outval;
	}
	
	string get_locate_at() {
		string outval;
		for (uint i = 0; i < mapdata.length(); i++) {
			string[] parsed = string_split(mapdata[i], ":", false);
			if (parsed[0] == "where" && parsed.length() > 1) {
				outval = parsed[1];
			}
		}
		return outval;
	}
	
	bool get_safezone_at(int x, int y) {
		for (uint i = 0; i < safezones.length(); i++) {
			if (safezones.length() > 0) {
				int minx = safezones[i].min_x;
				int maxx = safezones[i].max_x;
				int miny = safezones[i].min_y;
				int maxy = safezones[i].max_y;
				if (minx > x) continue;
				if (minx <= x && maxx >= x && miny <= y && maxy >= y) 
					return true;
			}
		}
		return false;
	}
	
	// ============================================================================
	// MÉTODOS DE VISUALIZAÇÃO
	// ============================================================================
	
	void view_items(int index) {
		string final;
		int items_cantity = 0;
		for (uint x = 0; x < objs.length(); x++) {
			int coor_x = objs[x].x, coor_y = objs[x].y;
			string direction_x, direction_y, name = objs[x].itemname;
			double distance_min_x = players[index].x - coor_x;
			double distance_max_x = coor_x - players[index].x;
			double distance_min_y = players[index].y - coor_y;
			double distance_max_y = coor_y - players[index].y;
			
			if (distance_min_x <= 30 && distance_min_y <= 30 && 
			    distance_max_x <= 30 && distance_max_y <= 30) {
				if (coor_x < players[index].x) 
					direction_x = distance_min_x + " ;pasos a tu izquierda;";
				else if (coor_x > players[index].x) 
					direction_x = distance_max_x + " ;pasos a tu derecha;";
				else if (coor_x == players[index].x) 
					direction_x = ";justo al frente de ti;";
				
				if (coor_y < players[index].y) 
					direction_y = distance_min_y + " ;pasos hacia abajo;";
				else if (coor_y > players[index].y) 
					direction_y = distance_max_y + " ;pasos hacia arriba;";
				
				items_cantity++;
				if (direction_x != "" && direction_y != "") 
					final += ";" + name + ";, " + direction_y + ", " + direction_x + ". ";
				else if (direction_x != "" && direction_y == "") 
					final += ";" + name + ";, " + direction_x + ". ";
				else if (direction_x == "" && direction_y != "") 
					final += ";" + name + ";, " + direction_y + ". ";
			}
		}
		if (items_cantity == 0) final = ";No hay objetos cerca de ti.;";
		send_reliable(players[index].peer_id, "msg2 " + final, 0);
	}
	
	void view(int index) {
		bool achou = false;
		int distance;
		int range = 12;
		string a = "Cerca de ti se encuentra:;";
		
		// Árvores próximas
		for (uint i = 0; i < arbols.length(); i++) {
			distance = get_distance(players[index].x, arbols[i].x, 
			                       players[index].y, arbols[i].miny);
			if (distance <= range) {
				a += " ;" + arbols[i].name + ";, ;con; " + arbols[i].vida + " ;de vida.;";
				achou = true;
			}
		}
		
		// Paredes próximas
		for (uint i = 0; i < walls.length(); i++) {
			distance = get_distance(players[index].x, walls[i].x, 
			                       players[index].y, walls[i].miny);
			if (distance <= range) {
				a += " ;" + walls[i].name + ";, ;con; " + walls[i].vida + " ;de vida.;";
				achou = true;
			}
		}
		
		// NPCs próximos
		for (uint i = 0; i < npcs.length(); i++) {
			distance = get_distance(players[index].x, npcs[i].x, 
			                       players[index].y, npcs[i].y);
			if (distance <= range) {
				a += " ;" + npcs[i].nombrenpc + ";, ;com; " + npcs[i].vida + "; ;de vida.";
				achou = true;
			}
		}
		
		// Portais próximos
		for (uint i = 0; i < portals.length(); i++) {
			distance = get_distance(players[index].x, portals[i].x, 
			                       players[index].y, portals[i].y);
			if (distance <= range) {
				a += " " + portals[i].getdesc();
				achou = true;
			}
		}
		
		// Jaulas próximas (se existir o sistema)
		for (uint i = 0; i < jaulas.length(); i++) {
			distance = get_distance(players[index].x, jaulas[i].x, 
			                       players[index].y, jaulas[i].y);
			if (distance <= range && jaulas[i].map == this.name) {
				a += " ;jaula de; " + jaulas[i].dueno + ", ;com; " + jaulas[i].vida + "; ;de vida.";
				achou = true;
			}
		}
		
		// Cachorros mascotes (se existir o sistema)
		for (uint i = 0; i < cachorromascotas.length(); i++) {
			distance = get_distance(players[index].x, cachorromascotas[i].x, 
			                       players[index].y, cachorromascotas[i].y);
			if (distance <= range && cachorromascotas[i].mapindex == this.mapindex) {
				a += " " + cachorromascotas[i].getdesc();
				achou = true;
			}
		}
		
		// Monstros próximos
		for (uint i = 0; i < monstruos.length(); i++) {
			distance = get_distance(players[index].x, monstruos[i].x, 
			                       players[index].y, monstruos[i].y);
			if (distance <= range) {
				a += " ;el monstruo legendario;, ;com; " + monstruos[i].vida + "; ;de vida.;";
				achou = true;
			}
		}
		
		if (achou == false) 
			send_reliable(players[index].peer_id, "msgnormal Nada por perto.", 0);
		else if (achou == true) 
			send_reliable(players[index].peer_id, "msg2 " + a, 0);
	}
	
	// ============================================================================
	// MÉTODOS DE COMUNICAÇÃO EM REDE
	// ============================================================================
	
	void send_packet(int channel, string packet, int x = -1, int y = -1, int range = 20, bool reliable = true) {
		for (uint i = 0; i < mapplayers.length(); i++) {
			if (get_distance(players[mapplayers[i]].x, x, players[mapplayers[i]].y, y) <= range) {
				if (reliable) 
					send_reliable(players[mapplayers[i]].peer_id, packet + " " + x + " " + y, channel);
				else 
					send_unreliable(players[mapplayers[i]].peer_id, packet + " " + x + " " + y, channel);
			}
		}
	}
	
	void send_packet(int channel, string packet, bool reliable = true) {
		for (uint i = 0; i < mapplayers.length(); i++) {
			if (reliable) 
				send_reliable(players[mapplayers[i]].peer_id, packet, channel);
			else 
				send_unreliable(players[mapplayers[i]].peer_id, packet, channel);
		}
	}
	
	void send_to_others(int peer, int channel, string packet, int x = 0, int y = 0, int range = 20, bool reliable = false) {
		if (mapplayers.length() <= 1) return;
		for (uint i = 0; i < mapplayers.length(); i++) {
			if (players[mapplayers[i]].peer_id != peer) {
				if (get_distance(players[mapplayers[i]].x, x, players[mapplayers[i]].y, y) <= range) {
					if (reliable) 
						send_reliable(players[mapplayers[i]].peer_id, packet + " " + x + " " + y, channel);
					else 
						send_unreliable(players[mapplayers[i]].peer_id, packet + " " + x + " " + y, channel);
				}
			}
		}
	}
	
	void send_to_others(int peer, int channel, string packet, bool reliable = false) {
		if (mapplayers.length() <= 1) return;
		for (uint i = 0; i < mapplayers.length(); i++) {
			if (players[mapplayers[i]].peer_id != peer) {
				if (reliable) 
					send_reliable(players[mapplayers[i]].peer_id, packet, channel);
				else 
					send_unreliable(players[mapplayers[i]].peer_id, packet, channel);
			}
		}
	}
	
	// A CONTINUAR COM OUTROS MÉTODOS...
	
} // end class map

// ============================================================================
// FUNÇÕES GLOBAIS DE GERENCIAMENTO DE MAPAS
// ============================================================================

// Carrega todos os mapas do diretório maps/
void spawn_maps() {
	string[] filemaps = find_files("maps/*.map");
	if (filemaps.length() > 0) {
		for (uint x = 0; x < filemaps.length(); x++) {
			map map1(filemaps[x]);
			server_maps.insert_last(map1);
			server_maps[x].mapindex = x;
		}
	}
	else {
		alert("Info", "Não há arquivos no diretório maps/. Por favor, tenha pelo menos um arquivo no diretório e execute o servidor novamente.");
		exit();
	}
}

// Retorna o índice de um mapa no array server_maps[] pelo nome
int get_map_index_from(string m) {
	for (uint i = 0; i < server_maps.length(); i++) {
		if (server_maps[i].name == m) {
			return i;
		}
	}
	return -1;
}

// Funções utilitárias para conversão de arrays/strings
string linear(string[] a, string char_separator = "\r\n") {
	string final;
	for (uint i = 0; i < a.length(); i++) {
		final += a[i] + char_separator;
	}
	return final;
}

string linear(uint[] data, string char_separator = "\r\n") {
	string final;
	for (uint i = 0; i < data.length(); i++) {
		final += data[i] + char_separator;
	}
	return final;
}

string[] delinear(string a, string char_separator = "\r\n") {
	return a.split(char_separator);
}

// ============================================================================
// FUNÇÕES GLOBAIS DE ACESSO A MÉTODOS DA CLASSE MAP
// ============================================================================

// Obter tile em uma posição específica de um mapa
string get_tile_at(int x, int y, string mapname) {
	int mapindex = get_map_index_from(mapname);
	if (mapindex < 0 || mapindex >= int(server_maps.length())) 
		return "";
	return server_maps[mapindex].get_tile_at(x, y);
}

// Obter zona em uma posição específica de um mapa
string get_zone_at(int x, int y, string mapname) {
	int mapindex = get_map_index_from(mapname);
	if (mapindex < 0 || mapindex >= int(server_maps.length())) 
		return "";
	return server_maps[mapindex].get_zone_at(x, y);
}

// Verificar se uma posição é plataforma
bool is_platform(int x, int y, string mapname) {
	int mapindex = get_map_index_from(mapname);
	if (mapindex < 0 || mapindex >= int(server_maps.length())) 
		return false;
	return server_maps[mapindex].is_platform(x, y);
}

// Verificar se uma posição é escada
bool is_staircase(int x, int y, string mapname) {
	int mapindex = get_map_index_from(mapname);
	if (mapindex < 0 || mapindex >= int(server_maps.length())) 
		return false;
	return server_maps[mapindex].is_staircase(x, y);
}

// Verificar se uma posição está em zona segura
bool get_safezone_at(int x, int y, string mapname) {
	int mapindex = get_map_index_from(mapname);
	if (mapindex < 0 || mapindex >= int(server_maps.length())) 
		return false;
	return server_maps[mapindex].get_safezone_at(x, y);
}

