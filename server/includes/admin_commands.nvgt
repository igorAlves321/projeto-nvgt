// Comando /pinfo - InformacAes do jogador (menu navegavel)
// Envia dados estruturados para o cliente criar menu acessAvel
void cmd_pinfo(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "pinfo", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "pinfo", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	
	// Verificar status de ban (para online e offline)
	// check_ban_db(username, comp_id, &out reason, &out remaining_seconds)
	string ban_reason = "";
	int ban_remaining = 0;
	bool is_banned = check_ban_db(target_name, "", ban_reason, ban_remaining);
	
	// Converter segundos restantes para string legAvel
	string ban_expire = "N/A";
	if(is_banned && ban_remaining > 0) {
		int hours = ban_remaining / 3600;
		int minutes = (ban_remaining % 3600) / 60;
		ban_expire = hours + "h " + minutes + "min";
	} else if(is_banned && ban_remaining == -1) {
		ban_expire = "Permanente";
	}
	
	// Formato: pinfo_data:nome|status|banido|razao_ban|expira_ban|nivel|xp|hp|mapa|pos|admin|gold
	// PIPE (|) separa campos
	string data = "pinfo_data:";
	
	// Jogador ONLINE
	if(target != -1) {
		data += target_name + "|";                                    // 0: Nome
		data += "Online|";                                            // 1: Status
		data += (is_banned ? "Sim" : "Não") + "|";                   // 2: Banido?
		data += (is_banned ? ban_reason : "N/A") + "|";              // 3: Razão do ban
		data += (is_banned ? ban_expire : "N/A") + "|";              // 4: Expira ban
		data += players[target].level + "|";                          // 5: Nivel
		data += players[target].xp + "|";                             // 6: XP
		data += players[target].health + "/" + players[target].max_health + "|"; // 7: HP
		data += players[target].map + "|";                            // 8: Mapa
		data += players[target].x + "," + players[target].y + "|";   // 9: Posicao
		data += (players[target].admin ? "Sim" : "Não") + "|";       // 10: Admin?
		data += players[target].gold;                                 // 11: Ouro
		
		send_reliable_text(players[player_index].peer_id, data, 0);
		debug_log("ADMIN: " + players[player_index].charname + " consultou info de " + target_name + " (online)");
		return;
	}
	
	// Jogador OFFLINE - buscar no sistema de arquivos
	bool exists = file_exists("players/" + target_name + "/player.dat") || 
	              file_exists("players/" + target_name + "/player.usr");
	
	if(!exists) {
		send_admin_error(player_index, "pinfo", "Jogador '" + target_name + "' não encontrado no sistema!");
		return;
	}
	
	// Verificar se e admin
	bool is_admin_player = file_exists("players/" + target_name + "/admin.usr");
	
	// Dados offline (campos indisponAveis marcados como "?")
	data += target_name + "|";                                    // 0: Nome
	data += "Offline|";                                           // 1: Status
	data += (is_banned ? "Sim" : "Não") + "|";                   // 2: Banido?
	data += (is_banned ? ban_reason : "N/A") + "|";              // 3: Razão do ban
	data += (is_banned ? ban_expire : "N/A") + "|";              // 4: Expira ban
	data += "?|";                                                 // 5: Nivel (desconhecido offline)
	data += "?|";                                                 // 6: XP (desconhecido offline)
	data += "?|";                                                 // 7: HP (desconhecido offline)
	data += "?|";                                                 // 8: Mapa (desconhecido offline)
	data += "?|";                                                 // 9: Posicao (desconhecido offline)
	data += (is_admin_player ? "Sim" : "Não") + "|";             // 10: Admin?
	data += "?";                                                  // 11: Ouro (desconhecido offline)
	
	send_reliable_text(players[player_index].peer_id, data, 0);
	debug_log("ADMIN: " + players[player_index].charname + " consultou info de " + target_name + " (offline)");
}

#include "admin_player_state_commands.nvgt"

// Comando /freeze - Congelar jogo
void cmd_freeze(int player_index) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "freeze", "Você não tem permissao!");
		return;
	}

	game_frozen = true;

	broadcast_all("msg2 O jogo foi congelado por um administrador.");
	send_reliable_text(players[player_index].peer_id, "msg2 Jogo congelado.", 0);

	debug_log("ADMIN: " + players[player_index].charname + " congelou o jogo");
}

// Comando /unfreeze - Descongelar jogo
void cmd_unfreeze(int player_index) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "unfreeze", "Você não tem permissao!");
		return;
	}

	game_frozen = false;

	broadcast_all("msg2 O jogo foi descongelado.");
	send_reliable_text(players[player_index].peer_id, "msg2 Jogo descongelado.", 0);

	debug_log("ADMIN: " + players[player_index].charname + " descongelou o jogo");
}

// Comando /n - Aviso global (notificacao)
void cmd_notify(int player_index, string message) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "n", "Você não tem permissao!");
		return;
	}

	if(message.length() == 0 || message.length() > 500) {
		send_admin_error(player_index, "n", "Mensagem invalida!");
		return;
	}

	string formatted = "[AVISO] " + message;
	broadcast_all("msg2 " + formatted);

	debug_log("ADMIN: " + players[player_index].charname + " enviou aviso: " + message);
}

// Comando /regalos - Dar presente para todos os jogadores online
void cmd_regalos(int player_index, string item_name, int quantity = 1) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "regalos", "Você não tem permissao!");
		return;
	}

	if(!is_valid_item_name(item_name)) {
		send_admin_error(player_index, "regalos", "Nome de item inválido!");
		return;
	}

	if(quantity < 1 || quantity > ADMIN_MAX_ITEM_QTY) {
		send_admin_error(player_index, "regalos", "Quantidade invalida!");
		return;
	}

	int count = 0;
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].online && !players[i].dead) {
			add_item_to_player(i, item_name, quantity);
			send_reliable_text(players[i].peer_id, "msg2 Você recebeu um presente: " + quantity + "x " + item_name + "!", 0);
			count++;
		}
	}

	send_reliable_text(players[player_index].peer_id, "msg2 Presente dado para " + count + " jogadores.", 0);
	eadm(players[player_index].charname + " deu " + quantity + "x " + item_name + " para todos!");

	debug_log("ADMIN: " + players[player_index].charname + " deu presente para " + count + " jogadores");
}

// Comando /xps - Toggle XP especial
void cmd_xps(int player_index) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "xps", "Você não tem permissao!");
		return;
	}

	special_xp_enabled = !special_xp_enabled;

	string status = special_xp_enabled ? "ativado" : "desativado";
	broadcast_all("msg2 XP especial foi " + status + "!");
	send_reliable_text(players[player_index].peer_id, "msg2 XP especial " + status + ".", 0);

	debug_log("ADMIN: " + players[player_index].charname + " " + status + " XP especial");
}

// Comando /pvp - Toggle PvP global
void cmd_pvp(int player_index) {
