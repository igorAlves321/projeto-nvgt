// admin_commands.nvgt - Sistema de Comandos Administrativos
// ✅ ITEM 4: COMANDOS ADMINISTRATIVOS
// ✅ Task 1.2.1: Validação de Inputs Admin

// ============================================================================
// 🔒 CONSTANTES DE SEGURANÇA (Task 1.2.1)
// ============================================================================
// Limites para validação de inputs em comandos administrativos

const int ADMIN_MIN_LEVEL = 1;
const int ADMIN_MAX_LEVEL = 100;
const int ADMIN_MAX_GOLD = 999999999;   // ~1 bilhão
const int ADMIN_MAX_XP = 999999999;
const int ADMIN_MAX_ITEM_QTY = 9999;
const int ADMIN_MAX_DURATION = 525600;  // 1 ano em minutos
const int ADMIN_MAX_COORD = 99999;      // Limite de coordenadas
const int ADMIN_MIN_COORD = -99999;
const int ADMIN_MAX_REASON_LEN = 500;   // Tamanho máximo de razão para ban/kick

// ============================================================================
// 🔒 FUNÇÕES DE VALIDAÇÃO (Task 1.2.1)
// ============================================================================

// Envia erro formatado para o admin e retorna false para interromper execução
bool send_admin_error(int player_index, string command, string message) {
    send_reliable(players[player_index].peer_id, "msg2 [ERRO] /" + command + ": " + message, 0);
    debug_log("ADMIN ERROR: " + players[player_index].charname + " - /" + command + " - " + message);
    return false;
}

// Valida se uma string contém apenas dígitos (números positivos)
bool is_valid_number(string str) {
    if(str.length() == 0) return false;
    
    // Permite sinal negativo no início
    uint start = 0;
    if(str[0] == '-') {
        if(str.length() == 1) return false; // Apenas "-" não é válido
        start = 1;
    }
    
    for(uint i = start; i < str.length(); i++) {
        if(str[i] < '0' || str[i] > '9') return false;
    }
    return true;
}

// Valida se uma string contém apenas dígitos positivos (sem sinal negativo)
bool is_positive_number(string str) {
    if(str.length() == 0) return false;
    for(uint i = 0; i < str.length(); i++) {
        if(str[i] < '0' || str[i] > '9') return false;
    }
    return true;
}

// Valida nome de jogador (não vazio, sem caracteres especiais perigosos)
bool is_valid_player_name(string name) {
    if(name.length() == 0) return false;
    if(name.length() > 32) return false; // Limite razoável
    
    // Verificar caracteres perigosos
    if(name.find(";") >= 0) return false;
    if(name.find("|") >= 0) return false;
    if(name.find("\\") >= 0) return false;
    if(name.find("\"") >= 0) return false;
    if(name.find("'") >= 0) return false;
    
    return true;
}

// Valida nome de item (não vazio, caracteres válidos)
bool is_valid_item_name(string item) {
    if(item.length() == 0) return false;
    if(item.length() > 64) return false;
    
    // Verificar caracteres perigosos
    if(item.find(";") >= 0) return false;
    if(item.find("|") >= 0) return false;
    if(item.find("\\") >= 0) return false;
    
    return true;
}

// Valida nome de mapa
bool is_valid_map_name(string map_name) {
    if(map_name.length() == 0) return false;
    if(map_name.length() > 64) return false;
    
    // Verificar caracteres perigosos para path traversal
    if(map_name.find("..") >= 0) return false;
    if(map_name.find("/") >= 0) return false;
    if(map_name.find("\\") >= 0) return false;
    if(map_name.find(":") >= 0) return false;
    
    return true;
}

// Valida se um valor inteiro está dentro dos limites
bool is_within_limits(int value, int min_val, int max_val) {
    return (value >= min_val && value <= max_val);
}

// Valida coordenada
bool is_valid_coord(int coord) {
    return is_within_limits(coord, ADMIN_MIN_COORD, ADMIN_MAX_COORD);
}

// ============================================================================
// 🔒 VERIFICAÇÃO DE PERMISSÕES
// ============================================================================

// Verifica permissão de admin
bool is_admin(int player_index) {
	return players[player_index].admin;
}

// Verifica se é super admin (usando admin_status)
bool is_super_admin(int player_index) {
	return players[player_index].admin_status;
}

// Comando /playtime
void cmd_playtime(int player_index, string target_name = "") {
	if(!is_admin(player_index)) {
		send_reliable(players[player_index].peer_id, "msg2 Você não tem permissão!", 0);
		return;
	}
	
	if(target_name == "") {
		// Mostrar próprio tempo
		int minutes = int(players[player_index].playtimer.elapsed / 60000);
		send_reliable(players[player_index].peer_id, "msg2 Seu tempo conectado: " + minutes + " minutos", 0);
	} else {
		// 2. Validação de Nome do Jogador
		if(!is_valid_player_name(target_name)) {
			send_admin_error(player_index, "playtime", "Nome de jogador inválido!");
			return;
		}
		
		// 3. Validação de Entidade
		int target = get_player_index_from(target_name);
		if(target == -1) {
			send_admin_error(player_index, "playtime", "Jogador '" + target_name + "' não encontrado ou offline.");
			return;
		}
		
		int minutes = int(players[target].playtimer.elapsed / 60000);
		send_reliable(players[player_index].peer_id, "msg2 Tempo de " + target_name + ": " + minutes + " minutos", 0);
	}
	
	debug_log("ADMIN: " + players[player_index].charname + " usou /playtime");
}

// Comando /kick
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_kick(int player_index, string target_name, string reason = "Expulso por admin") {
	// 1. Validação de Permissão
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "kick", "Você não tem permissão!");
		return;
	}
	
	// 2. Validação de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "kick", "Nome de jogador inválido!");
		return;
	}
	
	// 3. Validação de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "kick", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}
	
	// 4. Proteção: Não pode kickar outro admin
	if(players[target].admin) {
		send_admin_error(player_index, "kick", "Você não pode kickar este jogador (admin protegido)!");
		return;
	}
	
	// 5. Validação do tamanho da razão
	if(reason.length() > 256) {
		reason = reason.substr(0, 256); // Truncar razão muito longa
	}
	
	// --- EXECUÇÃO DA LÓGICA ---
	// Guardar peer_id antes de qualquer modificação
	uint64 target_peer = players[target].peer_id;
	
	// 1. Notificar o alvo ANTES de desconectar (para ele ver a mensagem)
	send_reliable(target_peer, "msg2 Você foi chutado do servidor! Motivo: " + reason, 0);
	send_reliable(target_peer, "chutad", 0); // Toca som de chute no cliente
	
	// 2. Broadcast para todos os outros
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].peer_id != target_peer) {
			send_reliable(players[i].peer_id, "msg2 " + target_name + " foi chutado do servidor. Motivo: " + reason, 0);
		}
	}
	
	// 3. Log
	debug_log("ADMIN: " + players[player_index].charname + " chutou " + target_name + " - Motivo: " + reason);
	
	// Pequena espera para entregar msg/som antes de fechar conexão
	wait(500);
	
	// 4. Desconectar fisicamente o jogador
	server_net.disconnect_peer_forcefully(target_peer);
	
	// 5. Remover da lista de jogadores (limpeza imediata)
	remove_player(target_peer);
}

// Comando /inventory
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_inventory(int player_index, string target_name) {
	// 1. Validação de Permissão
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "inventory", "Você não tem permissão!");
		return;
	}
	
	// 2. Validação de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "inventory", "Nome de jogador inválido!");
		return;
	}
	
	// 3. Validação de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "inventory", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}
	
	// --- EXECUÇÃO DA LÓGICA ---
	// Serializar inventário
	string inv = players[target].inv.serialize();
	string[] items = inv.split("|");
	
	send_reliable(players[player_index].peer_id, "msg2 === Inventário de " + target_name + " ===", 0);
	
	for(uint i = 0; i < items.length(); i++) {
		if(items[i].find(":") > -1) {
			string[] parts = items[i].split(":");
			send_reliable(players[player_index].peer_id, "msg2 " + parts[0] + " x" + parts[1], 0);
		}
	}
	
	debug_log("ADMIN: " + players[player_index].charname + " visualizou inventário de " + target_name);
}

// Comando /freezeall
// ✅ Task 1.2.1: Validação de inputs
void cmd_freezeall(int player_index, int duration = 10) {
	// 1. Validação de Permissão
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "freezeall", "Você precisa ser super admin!");
		return;
	}
	
	// 2. Validação de Duração
	if(!is_within_limits(duration, 1, 3600)) { // Máximo 1 hora
		send_admin_error(player_index, "freezeall", "Duração deve ser entre 1 e 3600 segundos.");
		return;
	}
	
	// --- EXECUÇÃO DA LÓGICA ---
	for(uint i = 0; i < players.length(); i++) {
		if(!players[i].admin) { // Não congelar admins
			players[i].congelado = 1;
			send_reliable(players[i].peer_id, "msg2 Você foi congelado por " + duration + " segundos!", 0);
		}
	}
	
	debug_log("ADMIN: " + players[player_index].charname + " congelou todos os jogadores por " + duration + "s");
	
	// Broadcast
	for(uint i = 0; i < players.length(); i++) {
		send_reliable(players[i].peer_id, "msg2 ADMIN CONGELOU TODOS POR " + duration + " SEGUNDOS!", 0);
	}
}

// Comando /backup
// ✅ Task 1.2.1: Validação de permissão
void cmd_backup(int player_index) {
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "backup", "Você precisa ser super admin!");
		return;
	}
	
	send_reliable(players[player_index].peer_id, "msg2 Iniciando backup do banco em backups/ ...", 0);
	
	// Salvar tudo e disparar backup do banco (assíncrono)
	auto_save_all_players();
	perform_database_backup();
	
	send_reliable(players[player_index].peer_id, "msg2 Backup solicitado com sucesso.", 0);
	debug_log("ADMIN: " + players[player_index].charname + " solicitou backup do banco");
}

// Comando /forcedc (força desconexão de todos)
// ✅ Task 1.2.1: Validação de permissão
void cmd_forcedc(int player_index) {
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "forcedc", "Você precisa ser super admin!");
		return;
	}
	
	debug_log("ADMIN: " + players[player_index].charname + " forçou desconexão de todos");
	
	// Notificar todos
	for(uint i = 0; i < players.length(); i++) {
		send_reliable(players[i].peer_id, "msg2 SERVIDOR REINICIANDO EM 10 SEGUNDOS!", 0);
	}
	
	// Salvar tudo
	auto_save_all_players();
	
	// Aguardar 10 segundos e desconectar todos
	// TODO: Implementar timer com callback quando disponível
}

// Comando /tp (teleportar)
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_tp(int player_index, string target_name) {
	// 1. Validação de Permissão
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "tp", "Você não tem permissão!");
		return;
	}
	
	// 2. Validação de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "tp", "Nome de jogador inválido!");
		return;
	}
	
	// 3. Validação de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "tp", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}
	
	// --- EXECUÇÃO DA LÓGICA ---
	players[player_index].x = players[target].x;
	players[player_index].y = players[target].y;
	players[player_index].map = players[target].map;
	
	send_reliable(players[player_index].peer_id, "msg2 Teleportado para " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " teleportou para " + target_name);
}

