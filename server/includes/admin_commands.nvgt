	if(minutes < 1 || minutes > ADMIN_MAX_DURATION) {
		send_admin_error(player_index, "prender", "DuraÃ§Ã£o invÃ¡lida!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "prender", "Jogador nÃ£o encontrado!");
		return;
