
const int ADMIN_MIN_LEVEL = 1;
const int ADMIN_MAX_LEVEL = 100;
const int ADMIN_MAX_GOLD = 999999999;
const int ADMIN_MAX_XP = 999999999;
const int ADMIN_MAX_ITEM_QTY = 9999;
const int ADMIN_MAX_DURATION = 525600;
const int ADMIN_MAX_COORD = 99999;
const int ADMIN_MIN_COORD = -99999;
const int ADMIN_MAX_REASON_LEN = 500;

bool send_admin_error(int player_index, string command, string message) {
    send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] /" + command + ": " + message, 0);
    debug_log("ADMIN ERROR: " + players[player_index].charname + " - /" + command + " - " + message);
    return false;
}

bool is_valid_number(string str) {
    if(str.length() == 0) return false;

    uint start = 0;
    if(str[0] == '-') {
        if(str.length() == 1) return false;
        start = 1;
    }

    for(uint i = start; i < str.length(); i++) {
        if(str[i] < '0' || str[i] > '9') return false;
    }
    return true;
}

bool is_positive_number(string str) {
    if(str.length() == 0) return false;
    for(uint i = 0; i < str.length(); i++) {
        if(str[i] < '0' || str[i] > '9') return false;
    }
    return true;
}

bool is_valid_player_name(string name) {
    if(name.length() == 0) return false;
    if(name.length() > 32) return false;

    if(name.find(";") >= 0) return false;
    if(name.find("|") >= 0) return false;
    if(name.find("\\") >= 0) return false;
    if(name.find("\"") >= 0) return false;
    if(name.find("'") >= 0) return false;

    return true;
}

bool is_valid_item_name(string item) {
    if(item.length() == 0) return false;
    if(item.length() > 64) return false;

    if(item.find(";") >= 0) return false;
    if(item.find("|") >= 0) return false;
    if(item.find("\\") >= 0) return false;

    return true;
}

bool is_valid_map_name(string map_name) {
    if(map_name.length() == 0) return false;
    if(map_name.length() > 64) return false;

    if(map_name.find("..") >= 0) return false;
    if(map_name.find("/") >= 0) return false;
    if(map_name.find("\\") >= 0) return false;
    if(map_name.find(":") >= 0) return false;

    return true;
}

bool is_within_limits(int value, int min_val, int max_val) {
    return (value >= min_val && value <= max_val);
}

bool is_valid_coord(int coord) {
    return is_within_limits(coord, ADMIN_MIN_COORD, ADMIN_MAX_COORD);
}

bool is_admin(int player_index) {
	return players[player_index].admin;
}

bool is_super_admin(int player_index) {
	return players[player_index].admin_status;
}

bool can_access_item_builder(int player_index) {
    if(player_index < 0 || player_index >= int(players.length())) return false;
    string username = players[player_index].charname;
    return check_is_admin(username);
}

void cmd_playtime(int player_index, string target_name = "") {
	if(!is_admin(player_index)) {
		send_reliable_text(players[player_index].peer_id, "msg2 Você não tem permissao!", 0);
		return;
	}

	if(target_name == "") {
		int minutes = int(players[player_index].playtimer.elapsed / 60000);
		send_reliable_text(players[player_index].peer_id, "msg2 Seu tempo conectado: " + minutes + " minutos", 0);
	} else {
		if(!is_valid_player_name(target_name)) {
			send_admin_error(player_index, "playtime", "Nome de jogador invalido!");
			return;
		}

		int target = get_player_index_from(target_name);
		if(target == -1) {
			send_admin_error(player_index, "playtime", "Jogador '" + target_name + "' não encontrado ou offline.");
			return;
		}

		int minutes = int(players[target].playtimer.elapsed / 60000);
		send_reliable_text(players[player_index].peer_id, "msg2 Tempo de " + target_name + ": " + minutes + " minutos", 0);
	}

	debug_log("ADMIN: " + players[player_index].charname + " usou /playtime");
}

void cmd_kick(int player_index, string target_name, string reason = "Expulso por admin") {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "kick", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "kick", "Nome de jogador invalido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "kick", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}

	string motivo_guarda;
	if(!can_moderate(players[player_index].charname, target_name, motivo_guarda)) {
		send_admin_error(player_index, "kick", motivo_guarda);
		return;
	}

	if(reason.length() > 256) {
		reason = reason.substr(0, 256);
	}

	uint64 target_peer = players[target].peer_id;

	send_reliable_text(target_peer, "msg2 Você foi chutado do servidor! Motivo: " + reason, 0);
	send_reliable_text(target_peer, "chutad", 0);

	for(uint i = 0; i < players.length(); i++) {
		if(players[i].peer_id != target_peer) {
			send_reliable_text(players[i].peer_id, "msg2 " + target_name + " foi chutado do servidor. Motivo: " + reason, 0);
		}
	}

	debug_log("ADMIN: " + players[player_index].charname + " chutou " + target_name + " - Motivo: " + reason);

	wait(500);

	force_disconnect_and_cleanup(target_peer, true);
}

void cmd_inventory(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "inventory", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "inventory", "Nome de jogador invalido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "inventory", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}

	string inv = players[target].inv.serialize();
	string[] items = inv.split("|");

	send_reliable_text(players[player_index].peer_id, "msg2 === Inventario de " + target_name + " ===", 0);

	for(uint i = 0; i < items.length(); i++) {
		if(items[i].find(":") > -1) {
			string[] parts = items[i].split(":");
			send_reliable_text(players[player_index].peer_id, "msg2 " + parts[0] + " x" + parts[1], 0);
		}
	}

	debug_log("ADMIN: " + players[player_index].charname + " visualizou inventario de " + target_name);
}

void cmd_freezeall(int player_index, int duration = 10) {
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "freezeall", "Você precisa ser super admin!");
		return;
	}

	if(!is_within_limits(duration, 1, 3600)) {
		send_admin_error(player_index, "freezeall", "Duracao deve ser entre 1 e 3600 segundos.");
		return;
	}

	for(uint i = 0; i < players.length(); i++) {
		if(!players[i].admin) {
			players[i].congelado = 1;
			send_reliable_text(players[i].peer_id, "msg2 Você foi congelado por " + duration + " segundos!", 0);
		}
	}

	debug_log("ADMIN: " + players[player_index].charname + " congelou todos os jogadores por " + duration + "s");

	for(uint i = 0; i < players.length(); i++) {
		send_reliable_text(players[i].peer_id, "msg2 ADMIN CONGELOU TODOS POR " + duration + " SEGUNDOS!", 0);
	}
}

void cmd_backup(int player_index) {
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "backup", "Você precisa ser super admin!");
		return;
	}

	send_reliable_text(players[player_index].peer_id, "msg2 Iniciando backup do banco em server/backups/ ...", 0);

	auto_save_all_players();
	perform_database_backup();

	send_reliable_text(players[player_index].peer_id, "msg2 Backup solicitado com sucesso.", 0);
	debug_log("ADMIN: " + players[player_index].charname + " solicitou backup do banco");
}

void cmd_forcedc(int player_index) {
    if(!is_super_admin(player_index)) {
        send_admin_error(player_index, "forcedc", "Você precisa ser super admin!");
        return;
    }

    debug_log("ADMIN: " + players[player_index].charname + " forcou desconexao de todos");

    for(uint i = 0; i < players.length(); i++) {
        send_reliable_text(players[i].peer_id, "msg2 SERVIDOR REINICIANDO AGORA!", 0);
    }

    auto_save_all_players();
    perform_database_backup();

    server_running = false;
}

#include "admin_teleport_commands.nvgt"

void cmd_givexp(int player_index, string target_name, int xp_amount) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "givexp", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "givexp", "Nome de jogador invalido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "givexp", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}

	if(!is_within_limits(xp_amount, 1, ADMIN_MAX_XP)) {
		send_admin_error(player_index, "givexp", "Quantidade de XP deve ser entre 1 e " + ADMIN_MAX_XP + ".");
		return;
	}

	ganhaxp(target, xp_amount, 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Você deu " + xp_amount + " XP para " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " deu " + xp_amount + " XP para " + target_name);
}

void cmd_giveitem(int player_index, string target_name, string item_name, int quantity = 1) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "giveitem", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "giveitem", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "giveitem", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}

	if(!is_valid_item_name(item_name)) {
		send_admin_error(player_index, "giveitem", "Nome de item inválido!");
		return;
	}

	if(!is_within_limits(quantity, 1, ADMIN_MAX_ITEM_QTY)) {
		send_admin_error(player_index, "giveitem", "Quantidade deve ser entre 1 e " + ADMIN_MAX_ITEM_QTY + ".");
		return;
	}

	players[target].inv_add_item(item_name, quantity);
	send_reliable_text(players[player_index].peer_id, "msg2 Você deu " + quantity + "x " + item_name + " para " + target_name, 0);
	send_reliable_text(players[target].peer_id, "msg2 Você recebeu " + quantity + "x " + item_name + " de um admin", 0);
	debug_log("ADMIN: " + players[player_index].charname + " deu " + quantity + "x " + item_name + " para " + target_name);
}

#include "admin_zone_commands.nvgt"

#include "admin_moderation_commands.nvgt"

#include "admin_grant_commands.nvgt"

void cmd_pinfo(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "pinfo", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "pinfo", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);

	string ban_reason = "";
	int ban_remaining = 0;
	bool is_banned = check_ban_db(target_name, "", ban_reason, ban_remaining);

	string ban_expire = "N/A";
	if(is_banned && ban_remaining > 0) {
		int hours = ban_remaining / 3600;
		int minutes = (ban_remaining % 3600) / 60;
		ban_expire = hours + "h " + minutes + "min";
	} else if(is_banned && ban_remaining == -1) {
		ban_expire = "Permanente";
	}

	string data = "pinfo_data:";

	if(target != -1) {
		data += target_name + "|";
		data += "Online|";
		data += (is_banned ? "Sim" : "Não") + "|";
		data += (is_banned ? ban_reason : "N/A") + "|";
		data += (is_banned ? ban_expire : "N/A") + "|";
		data += players[target].level + "|";
		data += players[target].xp + "|";
		data += players[target].health + "/" + players[target].max_health + "|";
		data += players[target].map + "|";
		data += players[target].x + "," + players[target].y + "|";
		data += (players[target].admin ? "Sim" : "Não") + "|";
		data += players[target].gold;

		send_reliable_text(players[player_index].peer_id, data, 0);
		debug_log("ADMIN: " + players[player_index].charname + " consultou info de " + target_name + " (online)");
		return;
	}

	bool exists = file_exists("players/" + target_name + "/player.dat") ||
	              file_exists("players/" + target_name + "/player.usr");

	if(!exists) {
		send_admin_error(player_index, "pinfo", "Jogador '" + target_name + "' não encontrado no sistema!");
		return;
	}

	bool is_admin_player = file_exists("players/" + target_name + "/admin.usr");

	data += target_name + "|";
	data += "Offline|";
	data += (is_banned ? "Sim" : "Não") + "|";
	data += (is_banned ? ban_reason : "N/A") + "|";
	data += (is_banned ? ban_expire : "N/A") + "|";
	data += "?|";
	data += "?|";
	data += "?|";
	data += "?|";
	data += "?|";
	data += (is_admin_player ? "Sim" : "Não") + "|";
	data += "?";

	send_reliable_text(players[player_index].peer_id, data, 0);
	debug_log("ADMIN: " + players[player_index].charname + " consultou info de " + target_name + " (offline)");
}

#include "admin_player_state_commands.nvgt"

void cmd_freeze(int player_index) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "freeze", "Você não tem permissao!");
		return;
	}

	game_frozen = true;

	broadcast_all("msg2 O jogo foi congelado por um administrador.");
	send_reliable_text(players[player_index].peer_id, "msg2 Jogo congelado.", 0);

	debug_log("ADMIN: " + players[player_index].charname + " congelou o jogo");
}

void cmd_unfreeze(int player_index) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "unfreeze", "Você não tem permissao!");
		return;
	}

	game_frozen = false;

	broadcast_all("msg2 O jogo foi descongelado.");
	send_reliable_text(players[player_index].peer_id, "msg2 Jogo descongelado.", 0);

	debug_log("ADMIN: " + players[player_index].charname + " descongelou o jogo");
}

void cmd_notify(int player_index, string message) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "n", "Você não tem permissao!");
		return;
	}

	if(message.length() == 0 || message.length() > 500) {
		send_admin_error(player_index, "n", "Mensagem invalida!");
		return;
	}

	string formatted = "[AVISO] " + message;
	broadcast_all("msg2 " + formatted);

	debug_log("ADMIN: " + players[player_index].charname + " enviou aviso: " + message);
}

void cmd_regalos(int player_index, string item_name, int quantity = 1) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "regalos", "Você não tem permissao!");
		return;
	}

	if(!is_valid_item_name(item_name)) {
		send_admin_error(player_index, "regalos", "Nome de item inválido!");
		return;
	}

	if(quantity < 1 || quantity > ADMIN_MAX_ITEM_QTY) {
		send_admin_error(player_index, "regalos", "Quantidade invalida!");
		return;
	}

	int count = 0;
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].online && !players[i].dead) {
			add_item_to_player(i, item_name, quantity);
			send_reliable_text(players[i].peer_id, "msg2 Você recebeu um presente: " + quantity + "x " + item_name + "!", 0);
			count++;
		}
	}

	send_reliable_text(players[player_index].peer_id, "msg2 Presente dado para " + count + " jogadores.", 0);
	eadm(players[player_index].charname + " deu " + quantity + "x " + item_name + " para todos!");

	debug_log("ADMIN: " + players[player_index].charname + " deu presente para " + count + " jogadores");
}

