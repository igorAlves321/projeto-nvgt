// Comando /dare - Dar créditos (dinheiro)
void cmd_dare(int player_index, string target_name, int amount) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "dare", "Você não tem permissão!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "dare", "Nome de jogador inválido!");
		return;
	}

	if(amount < 1 || amount > ADMIN_MAX_GOLD) {
		send_admin_error(player_index, "dare", "Quantidade inválida!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "dare", "Jogador não encontrado!");
		return;
	}

	players[target].money += amount;

	send_reliable(players[target].peer_id, "msg2 Você recebeu $" + amount + " créditos!", 0);
	send_reliable(players[player_index].peer_id, "msg2 Dado $" + amount + " créditos para " + target_name, 0);

	debug_log("ADMIN: " + players[player_index].charname + " deu $" + amount + " para " + target_name);
}

