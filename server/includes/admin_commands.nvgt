// Comando /addcargo - Adicionar cargo a jogador
void cmd_addcargo(int player_index, string target_name, string role) {
	if(!has_role(players[player_index].charname, "dev")) {
		send_admin_error(player_index, "addcargo", "Apenas devs podem usar este comando!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "addcargo", "Nome de jogador invÃ¡lido!");
		return;
	}

	string[] valid_roles = {"dev", "admin", "moderator", "builder", "event_manager", "translator", "vip"};
	bool valid = false;
	for(uint i = 0; i < valid_roles.length(); i++) {
		if(role == valid_roles[i]) {
			valid = true;
			break;
		}
	}

	if(!valid) {
		send_admin_error(player_index, "addcargo", "Cargo invÃ¡lido! Use: dev, admin, moderator, builder, event_manager, translator, vip");
		return;
	}

	if(add_role(target_name, role)) {
		send_reliable_text(players[player_index].peer_id, "msg2 Cargo " + role + " adicionado a " + target_name, 0);
		
		int target = get_player_index_from(target_name);
		if(target != -1) {
			send_reliable_text(players[target].peer_id, "msg2 VocÃª recebeu o cargo: " + role, 0);
		}

		debug_log("ADMIN: " + players[player_index].charname + " deu cargo " + role + " para " + target_name);
	} else {
		send_admin_error(player_index, "addcargo", "Erro ao adicionar cargo.");
	}
}

// Comando /removecargo - Remover cargo de jogador
void cmd_removecargo(int player_index, string target_name, string role) {
	if(!has_role(players[player_index].charname, "dev")) {
		send_admin_error(player_index, "removecargo", "Apenas devs podem usar este comando!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "removecargo", "Nome de jogador invÃ¡lido!");
		return;
	}

	if(remove_role(target_name, role)) {
		send_reliable_text(players[player_index].peer_id, "msg2 Cargo " + role + " removido de " + target_name, 0);
		
		int target = get_player_index_from(target_name);
		if(target != -1) {
			send_reliable_text(players[target].peer_id, "msg2 Seu cargo foi removido: " + role, 0);
		}

		debug_log("ADMIN: " + players[player_index].charname + " removeu cargo " + role + " de " + target_name);
	} else {
		send_admin_error(player_index, "removecargo", "Erro ao remover cargo.");
	}
}

// Comando /cargos - Ver cargos de um jogador
void cmd_cargos(int player_index, string target_name) {
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "cargos", "Nome de jogador invÃ¡lido!");
		return;
	}

	string[] roles = get_player_roles(target_name);

	if(roles.length() == 0) {
		send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " nÃ£o tem cargos.", 0);
	} else {
		string role_list = join(roles, ", ");
		send_reliable_text(players[player_index].peer_id, "msg2 Cargos de " + target_name + ": " + role_list, 0);
	}
}

// Comando /listadmins - Listar equipe do servidor
void cmd_listadmins(int player_index) {
	string[] admins = get_all_staff();

	if(admins.length() == 0) {
		send_reliable_text(players[player_index].peer_id, "msg2 Nenhum membro da equipe encontrado.", 0);
	} else {
		string list = "=== Equipe do Servidor ===";
		for(uint i = 0; i < admins.length(); i++) {
			list += " " + admins[i];
		}
		send_reliable_text(players[player_index].peer_id, "msg2 " + list, 0);
	}
}

// Helper para formatar uptime
string format_uptime(uint64 milliseconds) {
	int seconds = milliseconds / 1000;
	int minutes = seconds / 60;
	int hours = minutes / 60;
	int days = hours / 24;

	hours = hours % 24;
	minutes = minutes % 60;
	seconds = seconds % 60;

	return days + "d " + hours + "h " + minutes + "m " + seconds + "s";
}

// ============================================================================
// ðŸ”§ CONSTRUTOR DE ITENS - Item Builder Tool (Admin Only)
// ============================================================================

// Comando /create_item_tool - Criar item generico (consumivel, armadura, material, melee)
// Formato legado aceito: type|name|display|desc|category|damage|defense|heal|mp|weight|value|rarity|sound|extra1|extra2
// Campos efetivamente persistidos no schema BGT: name, msg(desc/display), health(heal), audio(sound)
// Helpers de validacao para Item Builder
bool item_builder_is_blank(const string&in value) {
    return value.trim_whitespace() == "";
}

void item_builder_send_empty_field_error(int player_index, const string&in command_name, const string&in field_name) {
    send_admin_error(player_index, command_name, "Campo vazio: " + field_name + ".");
}

void item_builder_send_invalid_field_error(int player_index, const string&in command_name, const string&in field_name, const string&in detail = "") {
    string msg = "Dados invalidos: " + field_name;
    if(detail != "") msg += " (" + detail + ")";
    msg += ".";
    send_admin_error(player_index, command_name, msg);
}

bool item_builder_is_safe_payload(const string&in payload, int max_length = 4096) {
    if(payload.length() == 0) return false;
    if(int(payload.length()) > max_length) return false;
    if(payload.find("\r") >= 0 || payload.find("\n") >= 0) return false;
    return true;
}

bool item_builder_is_valid_identifier(const string&in value) {
    string v = value.trim_whitespace();
    if(v == "" || v.find(" ") >= 0) return false;
    for(uint i = 0; i < v.length(); i++) {
        string ch = v.substr(i, 1);
        bool is_letter = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z");
        bool is_digit = (ch >= "0" && ch <= "9");
        bool is_ok = is_letter || is_digit || ch == "_";
        if(!is_ok) return false;
    }
    return true;
}

bool item_builder_is_valid_number_string(const string&in value, bool allow_decimal) {
    string v = value.trim_whitespace();
    if(v == "") return false;
    bool has_digit = false;
    int dot_count = 0;
    for(uint i = 0; i < v.length(); i++) {
        string ch = v.substr(i, 1);
        if(ch >= "0" && ch <= "9") {
            has_digit = true;
            continue;
        }
        if(ch == "-" && i == 0) continue;
        if(allow_decimal && ch == ".") {
            dot_count++;
            if(dot_count > 1) return false;
            continue;
        }
        return false;
    }
    return has_digit;
}

bool item_builder_parse_int_field(int player_index, const string&in command_name, const string&in field_name, const string&in raw_value, int min_value, int max_value, int&out parsed_value) {
    if(!item_builder_is_valid_number_string(raw_value, false)) {
        item_builder_send_invalid_field_error(player_index, command_name, field_name, "deve ser numero inteiro");
        return false;
    }
    parsed_value = parse_int(raw_value.trim_whitespace());
    if(parsed_value < min_value || parsed_value > max_value) {
        item_builder_send_invalid_field_error(player_index, command_name, field_name, "fora do intervalo");
        return false;
    }
    return true;
}

bool item_builder_parse_float_field(int player_index, const string&in command_name, const string&in field_name, const string&in raw_value, double min_value, double max_value, double&out parsed_value) {
    if(!item_builder_is_valid_number_string(raw_value, true)) {
        item_builder_send_invalid_field_error(player_index, command_name, field_name, "deve ser numero");
        return false;
    }
    parsed_value = parse_float(raw_value.trim_whitespace());
    if(parsed_value < min_value || parsed_value > max_value) {
        item_builder_send_invalid_field_error(player_index, command_name, field_name, "fora do intervalo");
        return false;
    }
    return true;
}

void item_builder_ensure_metadata_tables() {
    if(!database_initialized || bancoJogo is null) return;

    string q_types = """
        CREATE TABLE IF NOT EXISTS item_builder_types (
            type_name TEXT PRIMARY KEY
        );
    """;
    string q_rarities = """
        CREATE TABLE IF NOT EXISTS item_builder_rarities (
            rarity_name TEXT PRIMARY KEY
        );
    """;
    string q_categories = """
        CREATE TABLE IF NOT EXISTS item_builder_categories (
            item_type TEXT NOT NULL,
            category_name TEXT NOT NULL,
            PRIMARY KEY (item_type, category_name)
        );
    """;
    bancoJogo.execute(q_types);
    bancoJogo.execute(q_rarities);
    bancoJogo.execute(q_categories);

    bancoJogo.execute("INSERT OR IGNORE INTO item_builder_types(type_name) VALUES ('weapon'),('armor'),('consumable'),('misc');");
    bancoJogo.execute("INSERT OR IGNORE INTO item_builder_rarities(rarity_name) VALUES ('common'),('uncommon'),('rare'),('epic'),('legendary');");
    bancoJogo.execute("INSERT OR IGNORE INTO item_builder_categories(item_type, category_name) VALUES ('weapon','sword'),('weapon','dagger'),('weapon','axe'),('weapon','hammer'),('weapon','firearm');");
    bancoJogo.execute("INSERT OR IGNORE INTO item_builder_categories(item_type, category_name) VALUES ('armor','head'),('armor','chest'),('armor','legs'),('armor','boots'),('armor','gloves');");
    bancoJogo.execute("INSERT OR IGNORE INTO item_builder_categories(item_type, category_name) VALUES ('consumable','potion'),('consumable','food'),('consumable','drink');");
    bancoJogo.execute("INSERT OR IGNORE INTO item_builder_categories(item_type, category_name) VALUES ('misc','material'),('misc','quest'),('misc','currency'),('misc','junk'),('misc','legacy');");
}

string item_builder_join_values(const string&in query, const string&in separator = ",") {
    if(!database_initialized || bancoJogo is null) return "";
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) return "";

    string joined_values = "";
    while(stmt.step() == SQLITE_ROW) {
        string value = stmt.column_text(0).trim_whitespace();
        if(value == "") continue;
        if(joined_values != "") joined_values += separator;
        joined_values += value;
    }
    return joined_values;
}

bool item_builder_is_protected_type(const string&in type_name) {
    return type_name == "weapon" || type_name == "armor" || type_name == "consumable" || type_name == "misc";
}

bool item_builder_is_protected_rarity(const string&in rarity_name) {
    return rarity_name == "common" || rarity_name == "uncommon" || rarity_name == "rare" || rarity_name == "epic" || rarity_name == "legendary";
}

bool item_builder_is_protected_category(const string&in item_type, const string&in category_name) {
    if(item_type == "weapon") {
        return category_name == "sword" || category_name == "dagger" || category_name == "axe" || category_name == "hammer" || category_name == "firearm";
    }
    if(item_type == "armor") {
        return category_name == "head" || category_name == "chest" || category_name == "legs" || category_name == "boots" || category_name == "gloves";
    }
    if(item_type == "consumable") {
        return category_name == "potion" || category_name == "food" || category_name == "drink";
    }
    if(item_type == "misc") {
        return category_name == "material" || category_name == "quest" || category_name == "currency" || category_name == "junk" || category_name == "legacy";
    }
    return false;
}

void cmd_item_builder_meta(int player_index) {
    if(!can_access_item_builder(player_index)) {
        send_admin_error(player_index, "item_builder_meta", "Permissao negada.");
        return;
    }
    if(!database_initialized || bancoJogo is null) {
        send_admin_error(player_index, "item_builder_meta", "Banco nao inicializado.");
        return;
    }

    try {
    create_items_tables();
    item_builder_ensure_metadata_tables();

    string types = item_builder_join_values("SELECT type_name FROM item_builder_types ORDER BY type_name ASC;");
    string rarities = item_builder_join_values("SELECT rarity_name FROM item_builder_rarities ORDER BY rarity_name ASC;");
    string cat_weapon = item_builder_join_values("SELECT category_name FROM item_builder_categories WHERE item_type='weapon' ORDER BY category_name ASC;");
    string cat_armor = item_builder_join_values("SELECT category_name FROM item_builder_categories WHERE item_type='armor' ORDER BY category_name ASC;");
    string cat_consumable = item_builder_join_values("SELECT category_name FROM item_builder_categories WHERE item_type='consumable' ORDER BY category_name ASC;");
    string cat_misc = item_builder_join_values("SELECT category_name FROM item_builder_categories WHERE item_type='misc' ORDER BY category_name ASC;");

    string payload = "ITEM_BUILDER_META|" + types + "|" + rarities + "|" + cat_weapon + "|" + cat_armor + "|" + cat_consumable + "|" + cat_misc;
    send_reliable_text(players[player_index].peer_id, "msg2 " + payload, 0);
    }
    catch {
        send_admin_error(player_index, "item_builder_meta", "Falha interna ao carregar metadata.");
        debug_log("ITEM BUILDER ERROR /item_builder_meta: " + get_exception_info() + " (" + get_exception_file() + ":" + get_exception_line() + ")");
    }
}

void cmd_item_builder_meta_list(int player_index) {
    if(!can_access_item_builder(player_index)) {
        send_admin_error(player_index, "ib_list_meta", "Permissao negada.");
