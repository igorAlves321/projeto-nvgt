// Comando /prender - Prender jogador na prisÃ£o
void cmd_prender(int player_index, string target_name, int minutes, string reason) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "prender", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "prender", "Nome de jogador invÃ¡lido!");
