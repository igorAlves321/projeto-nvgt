	if(!is_admin(player_index)) {
		send_admin_error(player_index, "revive", "Você não tem permissão!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "revive", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "revive", "Jogador não encontrado!");
		return;
