// ============================================================================
// ðŸ”’ CONSTANTES DE SEGURANÃ‡A (Task 1.2.1)
// ============================================================================
// Limites para validaÃ§Ã£o de inputs em comandos administrativos

const int ADMIN_MIN_LEVEL = 1;
const int ADMIN_MAX_LEVEL = 100;
const int ADMIN_MAX_GOLD = 999999999;   // ~1 bilhÃ£o
const int ADMIN_MAX_XP = 999999999;
const int ADMIN_MAX_ITEM_QTY = 9999;
const int ADMIN_MAX_DURATION = 525600;  // 1 ano em minutos
const int ADMIN_MAX_COORD = 99999;      // Limite de coordenadas
const int ADMIN_MIN_COORD = -99999;
const int ADMIN_MAX_REASON_LEN = 500;   // Tamanho mÃ¡ximo de razÃ£o para ban/kick

// ============================================================================
// ðŸ”’ FUNÃ‡Ã•ES DE VALIDAÃ‡ÃƒO (Task 1.2.1)
// ============================================================================

// Envia erro formatado para o admin e retorna false para interromper execuÃ§Ã£o
bool send_admin_error(int player_index, string command, string message) {
    send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] /" + command + ": " + message, 0);
    debug_log("ADMIN ERROR: " + players[player_index].charname + " - /" + command + " - " + message);
    return false;
}

// Valida se uma string contÃ©m apenas dÃ­gitos (nÃºmeros positivos)
bool is_valid_number(string str) {
    if(str.length() == 0) return false;
    
    // Permite sinal negativo no inÃ­cio
    uint start = 0;
    if(str[0] == '-') {
        if(str.length() == 1) return false; // Apenas "-" nÃ£o Ã© vÃ¡lido
        start = 1;
    }
    
    for(uint i = start; i < str.length(); i++) {
        if(str[i] < '0' || str[i] > '9') return false;
    }
    return true;
}

// Valida se uma string contÃ©m apenas dÃ­gitos positivos (sem sinal negativo)
bool is_positive_number(string str) {
    if(str.length() == 0) return false;
    for(uint i = 0; i < str.length(); i++) {
        if(str[i] < '0' || str[i] > '9') return false;
    }
    return true;
}

// Valida nome de jogador (nÃ£o vazio, sem caracteres especiais perigosos)
bool is_valid_player_name(string name) {
    if(name.length() == 0) return false;
    if(name.length() > 32) return false; // Limite razoÃ¡vel
    
    // Verificar caracteres perigosos
    if(name.find(";") >= 0) return false;
    if(name.find("|") >= 0) return false;
    if(name.find("\\") >= 0) return false;
    if(name.find("\"") >= 0) return false;
    if(name.find("'") >= 0) return false;
    
    return true;
}

// Valida nome de item (nÃ£o vazio, caracteres vÃ¡lidos)
bool is_valid_item_name(string item) {
    if(item.length() == 0) return false;
    if(item.length() > 64) return false;
    
    // Verificar caracteres perigosos
    if(item.find(";") >= 0) return false;
    if(item.find("|") >= 0) return false;
    if(item.find("\\") >= 0) return false;
    
    return true;
}

// Valida nome de mapa
bool is_valid_map_name(string map_name) {
    if(map_name.length() == 0) return false;
    if(map_name.length() > 64) return false;
    
    // Verificar caracteres perigosos para path traversal
    if(map_name.find("..") >= 0) return false;
    if(map_name.find("/") >= 0) return false;
    if(map_name.find("\\") >= 0) return false;
    if(map_name.find(":") >= 0) return false;
    
    return true;
}

// Valida se um valor inteiro estÃ¡ dentro dos limites
bool is_within_limits(int value, int min_val, int max_val) {
    return (value >= min_val && value <= max_val);
}

// Valida coordenada
bool is_valid_coord(int coord) {
    return is_within_limits(coord, ADMIN_MIN_COORD, ADMIN_MAX_COORD);
}

// ============================================================================
// ðŸ”’ VERIFICAÃ‡ÃƒO DE PERMISSÃ•ES
// ============================================================================

// Verifica permissÃ£o de admin
bool is_admin(int player_index) {
	return players[player_index].admin;
}

// Verifica se Ã© super admin (usando admin_status)
bool is_super_admin(int player_index) {
	return players[player_index].admin_status;
}

// Permissao para gerenciar catalogo de itens (admin/dev)
bool can_access_item_builder(int player_index) {
    if(player_index < 0 || player_index >= int(players.length())) return false;
    string username = players[player_index].charname;
    return check_is_admin(username);
}


// Comando /playtime
void cmd_playtime(int player_index, string target_name = "") {
	if(!is_admin(player_index)) {
		send_reliable_text(players[player_index].peer_id, "msg2 VocÃª nÃ£o tem permissÃ£o!", 0);
		return;
	}
	
	if(target_name == "") {
		// Mostrar prÃ³prio tempo
		int minutes = int(players[player_index].playtimer.elapsed / 60000);
		send_reliable_text(players[player_index].peer_id, "msg2 Seu tempo conectado: " + minutes + " minutos", 0);
	} else {
		// 2. ValidaÃ§Ã£o de Nome do Jogador
		if(!is_valid_player_name(target_name)) {
			send_admin_error(player_index, "playtime", "Nome de jogador invÃ¡lido!");
			return;
		}
		
		// 3. ValidaÃ§Ã£o de Entidade
		int target = get_player_index_from(target_name);
		if(target == -1) {
			send_admin_error(player_index, "playtime", "Jogador '" + target_name + "' nÃ£o encontrado ou offline.");
			return;
		}
		
		int minutes = int(players[target].playtimer.elapsed / 60000);
		send_reliable_text(players[player_index].peer_id, "msg2 Tempo de " + target_name + ": " + minutes + " minutos", 0);
	}
	
	debug_log("ADMIN: " + players[player_index].charname + " usou /playtime");
}

// Comando /kick
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_kick(int player_index, string target_name, string reason = "Expulso por admin") {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "kick", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}
	
	// 2. ValidaÃ§Ã£o de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "kick", "Nome de jogador invÃ¡lido!");
		return;
	}
	
	// 3. ValidaÃ§Ã£o de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "kick", "Jogador '" + target_name + "' nÃ£o encontrado ou offline.");
		return;
	}
	
	// 4. ProteÃ§Ã£o: NÃ£o pode kickar outro admin
	if(players[target].admin) {
		send_admin_error(player_index, "kick", "VocÃª nÃ£o pode kickar este jogador (admin protegido)!");
		return;
	}
	
	// 5. ValidaÃ§Ã£o do tamanho da razÃ£o
	if(reason.length() > 256) {
		reason = reason.substr(0, 256); // Truncar razÃ£o muito longa
	}
	
	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	// Guardar peer_id antes de qualquer modificaÃ§Ã£o
	uint64 target_peer = players[target].peer_id;
	
	// 1. Notificar o alvo ANTES de desconectar (para ele ver a mensagem)
	send_reliable_text(target_peer, "msg2 VocÃª foi chutado do servidor! Motivo: " + reason, 0);
	send_reliable_text(target_peer, "chutad", 0); // Toca som de chute no cliente
	
	// 2. Broadcast para todos os outros
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].peer_id != target_peer) {
			send_reliable_text(players[i].peer_id, "msg2 " + target_name + " foi chutado do servidor. Motivo: " + reason, 0);
		}
	}
	
	// 3. Log
	debug_log("ADMIN: " + players[player_index].charname + " chutou " + target_name + " - Motivo: " + reason);
	
	// Pequena espera para entregar msg/som antes de fechar conexÃ£o
	wait(500);
	
	// 4. Desconectar fisicamente o jogador
	force_disconnect_and_cleanup(target_peer, true);
}

// Comando /inventory
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_inventory(int player_index, string target_name) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "inventory", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}
	
	// 2. ValidaÃ§Ã£o de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "inventory", "Nome de jogador invÃ¡lido!");
		return;
	}
	
	// 3. ValidaÃ§Ã£o de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "inventory", "Jogador '" + target_name + "' nÃ£o encontrado ou offline.");
		return;
	}
	
	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	// Serializar inventÃ¡rio
	string inv = players[target].inv.serialize();
	string[] items = inv.split("|");
	
	send_reliable_text(players[player_index].peer_id, "msg2 === InventÃ¡rio de " + target_name + " ===", 0);
	
	for(uint i = 0; i < items.length(); i++) {
		if(items[i].find(":") > -1) {
			string[] parts = items[i].split(":");
			send_reliable_text(players[player_index].peer_id, "msg2 " + parts[0] + " x" + parts[1], 0);
		}
	}
	
	debug_log("ADMIN: " + players[player_index].charname + " visualizou inventÃ¡rio de " + target_name);
}

// Comando /freezeall
// âœ… Task 1.2.1: ValidaÃ§Ã£o de inputs
void cmd_freezeall(int player_index, int duration = 10) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "freezeall", "VocÃª precisa ser super admin!");
		return;
	}
	
	// 2. ValidaÃ§Ã£o de DuraÃ§Ã£o
	if(!is_within_limits(duration, 1, 3600)) { // MÃ¡ximo 1 hora
		send_admin_error(player_index, "freezeall", "DuraÃ§Ã£o deve ser entre 1 e 3600 segundos.");
		return;
	}
	
	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	for(uint i = 0; i < players.length(); i++) {
		if(!players[i].admin) { // NÃ£o congelar admins
			players[i].congelado = 1;
			send_reliable_text(players[i].peer_id, "msg2 VocÃª foi congelado por " + duration + " segundos!", 0);
		}
	}
	
	debug_log("ADMIN: " + players[player_index].charname + " congelou todos os jogadores por " + duration + "s");
	
	// Broadcast
	for(uint i = 0; i < players.length(); i++) {
		send_reliable_text(players[i].peer_id, "msg2 ADMIN CONGELOU TODOS POR " + duration + " SEGUNDOS!", 0);
	}
}

// Comando /backup
// âœ… Task 1.2.1: ValidaÃ§Ã£o de permissÃ£o
void cmd_backup(int player_index) {
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "backup", "VocÃª precisa ser super admin!");
		return;
	}
	
	send_reliable_text(players[player_index].peer_id, "msg2 Iniciando backup do banco em backups/ ...", 0);
	
	// Salvar tudo e disparar backup do banco (assÃ­ncrono)
	auto_save_all_players();
	perform_database_backup();
	
	send_reliable_text(players[player_index].peer_id, "msg2 Backup solicitado com sucesso.", 0);
	debug_log("ADMIN: " + players[player_index].charname + " solicitou backup do banco");
}

// Comando /forcedc (forÃ§a desconexÃ£o de todos)
// âœ… Task 1.2.1: ValidaÃ§Ã£o de permissÃ£o
void cmd_forcedc(int player_index) {
    if(!is_super_admin(player_index)) {
        send_admin_error(player_index, "forcedc", "Voce precisa ser super admin!");
        return;
    }

    debug_log("ADMIN: " + players[player_index].charname + " forçou desconexao de todos");

    // Notificar todos e desconectar de forma imediata/segura
    for(uint i = 0; i < players.length(); i++) {
        send_reliable_text(players[i].peer_id, "msg2 SERVIDOR REINICIANDO AGORA!", 0);
    }

    // Salvar estado antes de encerrar
    auto_save_all_players();
    perform_database_backup();

    // Encerrar o loop principal do servidor (shutdown gracioso)
    server_running = false;
}

// Comando /tp (teleportar)
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_tp(int player_index, string target_name) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "tp", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}
	
	// 2. ValidaÃ§Ã£o de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "tp", "Nome de jogador invÃ¡lido!");
		return;
	}
	
	// 3. ValidaÃ§Ã£o de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "tp", "Jogador '" + target_name + "' nÃ£o encontrado ou offline.");
		return;
	}
	
	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	players[player_index].x = players[target].x;
	players[player_index].y = players[target].y;
	players[player_index].map = players[target].map;
	
	send_reliable_text(players[player_index].peer_id, "msg2 Teleportado para " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " teleportou para " + target_name);
}

