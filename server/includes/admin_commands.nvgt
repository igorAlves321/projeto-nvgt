// Comando /givexp
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_givexp(int player_index, string target_name, int xp_amount) {
	// 1. Validação de Permissão
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "givexp", "Você não tem permissão!");
		return;
	}
	
	// 2. Validação de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "givexp", "Nome de jogador inválido!");
		return;
	}
	
	// 3. Validação de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "givexp", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}
	
	// 4. Validação de Limites de XP
	if(!is_within_limits(xp_amount, 1, ADMIN_MAX_XP)) {
		send_admin_error(player_index, "givexp", "Quantidade de XP deve ser entre 1 e " + ADMIN_MAX_XP + ".");
		return;
	}
	
	// --- EXECUÇÃO DA LÓGICA ---
	ganhaxp(target, xp_amount, 0);
	send_reliable(players[player_index].peer_id, "msg2 Você deu " + xp_amount + " XP para " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " deu " + xp_amount + " XP para " + target_name);
}

// Comando /giveitem
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_giveitem(int player_index, string target_name, string item_name, int quantity = 1) {
	// 1. Validação de Permissão
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "giveitem", "Você não tem permissão!");
		return;
	}
	
	// 2. Validação de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "giveitem", "Nome de jogador inválido!");
		return;
	}
	
	// 3. Validação de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "giveitem", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}
	
	// 4. Validação de Nome do Item
	if(!is_valid_item_name(item_name)) {
		send_admin_error(player_index, "giveitem", "Nome de item inválido!");
		return;
	}
	
	// 5. Validação de Quantidade
	if(!is_within_limits(quantity, 1, ADMIN_MAX_ITEM_QTY)) {
		send_admin_error(player_index, "giveitem", "Quantidade deve ser entre 1 e " + ADMIN_MAX_ITEM_QTY + ".");
		return;
	}
	
	// --- EXECUÇÃO DA LÓGICA ---
	players[target].inv_add_item(item_name, quantity);
	send_reliable(players[player_index].peer_id, "msg2 Você deu " + quantity + "x " + item_name + " para " + target_name, 0);
	send_reliable(players[target].peer_id, "msg2 Você recebeu " + quantity + "x " + item_name + " de um admin", 0);
	debug_log("ADMIN: " + players[player_index].charname + " deu " + quantity + "x " + item_name + " para " + target_name);
}

// ============================================================================
// 🆕 COMANDOS DE GESTÃO DE ZONAS DESABILITADAS
// ============================================================================

// Comando /addzone - Adicionar nova zona desabilitada
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_addzone(int player_index, int minx, int maxx, int miny, int maxy, string map_name, string message = "Zona Segura") {
	// 1. Validação de Permissão
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "addzone", "Apenas super admins podem usar este comando!");
		return;
	}

	// 2. Validação de Coordenadas
	if(!is_valid_coord(minx) || !is_valid_coord(maxx) || !is_valid_coord(miny) || !is_valid_coord(maxy)) {
		send_admin_error(player_index, "addzone", "Coordenadas fora dos limites permitidos (" + ADMIN_MIN_COORD + " a " + ADMIN_MAX_COORD + ").");
		return;
	}

	// 3. Validação de Lógica das Coordenadas
	if(minx > maxx || miny > maxy) {
		send_admin_error(player_index, "addzone", "Coordenadas inválidas: min deve ser menor que max.");
		return;
	}

	// 4. Validação de Nome do Mapa
	if(!is_valid_map_name(map_name)) {
		send_admin_error(player_index, "addzone", "Nome de mapa inválido!");
		return;
	}

	// 5. Validação de Mensagem
	if(message.length() > 128) {
		message = message.substr(0, 128); // Truncar mensagem muito longa
	}

	// --- EXECUÇÃO DA LÓGICA ---
	game_disabled_zone@ nova_zona = game_disabled_zone(minx, maxx, miny, maxy, map_name, message);
	nova_zona.disable_pvp = true;
	nova_zona.disable_items = false;
	nova_zona.disable_commands = false;
	game_disabled_zones.insert_last(nova_zona);

	send_reliable(players[player_index].peer_id,
		"msg2 Zona adicionada: [" + minx + "," + maxx + "] x [" + miny + "," + maxy + "] no mapa " + map_name, 0);

	debug_log("ADMIN: " + players[player_index].charname + " adicionou zona desabilitada no mapa " + map_name);
}

// Comando /removezone - Remover zona desabilitada por índice
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_removezone(int player_index, int zone_index) {
	// 1. Validação de Permissão
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "removezone", "Apenas super admins podem usar este comando!");
		return;
	}

	// 2. Validação de Índice
	if(zone_index < 0 || zone_index >= int(game_disabled_zones.length())) {
		send_admin_error(player_index, "removezone", "Índice de zona inválido (0-" + (int(game_disabled_zones.length()) - 1) + "). Use /listzones para ver as zonas.");
		return;
	}

	// --- EXECUÇÃO DA LÓGICA ---
	string map_removed = game_disabled_zones[zone_index].map;
	game_disabled_zones.remove_at(zone_index);

	send_reliable(players[player_index].peer_id, "msg2 Zona " + zone_index + " removida do mapa " + map_removed, 0);
	debug_log("ADMIN: " + players[player_index].charname + " removeu zona " + zone_index);
}

// Comando /listzones - Listar todas as zonas desabilitadas
// ✅ Task 1.2.1: Validação de permissão
void cmd_listzones(int player_index) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "listzones", "Você não tem permissão!");
		return;
	}

	if(game_disabled_zones.length() == 0) {
		send_reliable(players[player_index].peer_id, "msg2 Nenhuma zona desabilitada configurada", 0);
		return;
	}

	string result = "=== ZONAS DESABILITADAS (" + game_disabled_zones.length() + ") ===\\r\\n";

	for(uint i = 0; i < game_disabled_zones.length(); i++) {
		result += "[" + i + "] Mapa: " + game_disabled_zones[i].map +
			" | Área: [" + game_disabled_zones[i].minx + "-" + game_disabled_zones[i].maxx +
			"] x [" + game_disabled_zones[i].miny + "-" + game_disabled_zones[i].maxy + "]";

		if(game_disabled_zones[i].disable_pvp) result += " | PvP:OFF";
		if(game_disabled_zones[i].disable_items) result += " | Items:OFF";
		if(game_disabled_zones[i].disable_commands) result += " | Commands:OFF";

		result += "\\r\\n";
	}

	send_reliable(players[player_index].peer_id, "say " + result, 0);
}

// Comando /togglezonepvp - Alternar PvP em uma zona
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_togglezonepvp(int player_index, int zone_index) {
	// 1. Validação de Permissão
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "togglezonepvp", "Apenas super admins podem usar este comando!");
		return;
	}

	// 2. Validação de Índice
	if(zone_index < 0 || zone_index >= int(game_disabled_zones.length())) {
		send_admin_error(player_index, "togglezonepvp", "Índice de zona inválido (0-" + (int(game_disabled_zones.length()) - 1) + "). Use /listzones para ver as zonas.");
		return;
	}

	// --- EXECUÇÃO DA LÓGICA ---
	game_disabled_zones[zone_index].disable_pvp = !game_disabled_zones[zone_index].disable_pvp;

	string status = game_disabled_zones[zone_index].disable_pvp ? "desabilitado" : "habilitado";
	send_reliable(players[player_index].peer_id,
		"msg2 PvP " + status + " na zona " + zone_index + " (" + game_disabled_zones[zone_index].map + ")", 0);

	debug_log("ADMIN: " + players[player_index].charname + " alterou PvP na zona " + zone_index + " para " + status);
}

// Comando /checkzone - Verificar se posição atual está em zona desabilitada
// ✅ Task 1.2.1: Comando público (sem restrição de admin) - validação básica de índice
void cmd_checkzone(int player_index) {
	// Validação básica de player_index
	if(player_index < 0 || player_index >= int(players.length())) {
		return;
	}

	bool in_zone = false;
	int zone_id = -1;

	for(uint i = 0; i < game_disabled_zones.length(); i++) {
		if(game_disabled_zones[i].is_inside(players[player_index].x, players[player_index].y, players[player_index].map)) {
			in_zone = true;
			zone_id = i;
			break;
		}
	}

	if(in_zone) {
		send_reliable(players[player_index].peer_id,
			"msg2 Você está na zona [" + zone_id + "] - " + game_disabled_zones[zone_id].message +
			" | PvP:" + (game_disabled_zones[zone_id].disable_pvp ? "OFF" : "ON"), 0);
	} else {
		send_reliable(players[player_index].peer_id, "msg2 Você não está em nenhuma zona desabilitada", 0);
	}
}

// Comando /savezones - Salvar zonas em arquivo de configuração
// ✅ Task 1.2.1: Validação de permissão
void cmd_savezones(int player_index) {
	// 1. Validação de Permissão
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "savezones", "Apenas super admins podem usar este comando!");
		return;
	}

	// --- EXECUÇÃO DA LÓGICA ---
	file f;
	if(!f.open("disabled_zones.cfg", "wb")) {
		send_admin_error(player_index, "savezones", "Erro ao abrir arquivo para salvar!");
		return;
	}

	string content = "// Zonas Desabilitadas - Configuração\\n";
	content += "// Formato: map|minx|maxx|miny|maxy|pvp|items|commands|message\\n\\n";

	for(uint i = 0; i < game_disabled_zones.length(); i++) {
		content += game_disabled_zones[i].map + "|";
		content += game_disabled_zones[i].minx + "|";
		content += game_disabled_zones[i].maxx + "|";
		content += game_disabled_zones[i].miny + "|";
		content += game_disabled_zones[i].maxy + "|";
		content += (game_disabled_zones[i].disable_pvp ? "1" : "0") + "|";
		content += (game_disabled_zones[i].disable_items ? "1" : "0") + "|";
		content += (game_disabled_zones[i].disable_commands ? "1" : "0") + "|";
		content += game_disabled_zones[i].message + "\\n";
	}

	f.write(content);
	f.close();

	send_reliable(players[player_index].peer_id,
		"msg2 " + game_disabled_zones.length() + " zonas salvas em disabled_zones.cfg", 0);

	debug_log("ADMIN: " + players[player_index].charname + " salvou " + game_disabled_zones.length() + " zonas");
}

// Comando /loadzones - Carregar zonas de arquivo de configuração
// ✅ Task 1.2.1: Validação de permissão
void cmd_loadzones(int player_index) {
	// 1. Validação de Permissão
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "loadzones", "Apenas super admins podem usar este comando!");
		return;
	}

	// --- EXECUÇÃO DA LÓGICA ---
	file f;
	if(!f.open("disabled_zones.cfg", "rb")) {
		send_admin_error(player_index, "loadzones", "Arquivo disabled_zones.cfg não encontrado!");
		return;
	}

	string content = f.read();
	f.close();

	// Limpar zonas atuais
	game_disabled_zones.resize(0);

	string[] lines = content.split("\\n");
	int loaded = 0;

	for(uint i = 0; i < lines.length(); i++) {
		string line = trim(lines[i]);
		if(line == "" || line.substr(0, 2) == "//") continue;

		string[] parts = line.split("|");
		if(parts.length() >= 9) {
			string map = parts[0];
			int minx = string_to_number(parts[1]);
			int maxx = string_to_number(parts[2]);
			int miny = string_to_number(parts[3]);
			int maxy = string_to_number(parts[4]);
			bool pvp = (parts[5] == "1");
			bool items = (parts[6] == "1");
			bool commands = (parts[7] == "1");
			string message = parts[8];

			game_disabled_zone@ zona = game_disabled_zone(minx, maxx, miny, maxy, map, message);
			zona.disable_pvp = pvp;
			zona.disable_items = items;
			zona.disable_commands = commands;
			game_disabled_zones.insert_last(zona);
			loaded++;
		}
	}

	send_reliable(players[player_index].peer_id, "msg2 " + loaded + " zonas carregadas de disabled_zones.cfg", 0);
	debug_log("ADMIN: " + players[player_index].charname + " carregou " + loaded + " zonas");
}

// Comando /createportal - Criar portal de teletransporte
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_createportal(int player_index, string destination_map, int dest_x, int dest_y) {
	// 1. Validação de Permissão
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "createportal", "Você não tem permissão!");
		return;
	}

	// 2. Validação de Nome do Mapa de Destino
	if(!is_valid_map_name(destination_map)) {
		send_admin_error(player_index, "createportal", "Nome de mapa inválido! Use apenas letras, números e underscore.");
		return;
	}

	// 3. Validação de Coordenadas
	if(!is_valid_coord(dest_x) || !is_valid_coord(dest_y)) {
		send_admin_error(player_index, "createportal", "Coordenadas inválidas! Use valores entre " + ADMIN_MIN_COORD + " e " + ADMIN_MAX_COORD + ".");
		return;
	}

	// 4. Verificar se o mapa de destino existe
	int dest_map_index = get_map_index_from(destination_map);
	if(dest_map_index == -1) {
		send_admin_error(player_index, "createportal", "Mapa de destino não encontrado: " + destination_map);
		return;
	}

	// --- EXECUÇÃO DA LÓGICA ---
	spawn_portal(player_index, players[player_index].x, players[player_index].y, 
	             players[player_index].map, destination_map, dest_x, dest_y);

	send_reliable(players[player_index].peer_id, "msg2 Portal criado para " + destination_map + " em (" + dest_x + ", " + dest_y + ")", 0);
	debug_log("ADMIN: " + players[player_index].charname + " criou portal para " + destination_map);
}

// Comando /deleteportal - Deletar portal próximo
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_deleteportal(int player_index, int range = 10) {
	// 1. Validação de Permissão
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "deleteportal", "Você não tem permissão!");
		return;
	}

	// 2. Validação de Range
	if(range < 1 || range > 100) {
		send_admin_error(player_index, "deleteportal", "Range inválido! Use valores entre 1 e 100.");
		return;
	}

	// 3. Validação do Mapa
	int map_index = get_map_index_from(players[player_index].map);
	if(map_index == -1) {
		send_admin_error(player_index, "deleteportal", "Erro ao obter mapa atual!");
		return;
	}

	// --- EXECUÇÃO DA LÓGICA ---
	for(uint i = 0; i < server_maps[map_index].portals.length(); i++) {
		portal@ pt = server_maps[map_index].portals[i];
		int distance = int(get_distance(players[player_index].x, players[player_index].y, pt.x, pt.y));

		if(distance <= range) {
			send_reliable(players[player_index].peer_id, "msg2 Portal deletado!", 0);
			server_maps[map_index].portals.remove_at(i);
			debug_log("ADMIN: " + players[player_index].charname + " deletou portal em " + players[player_index].map);
			return;
		}
	}

	send_admin_error(player_index, "deleteportal", "Nenhum portal encontrado em um raio de " + range + " tiles.");
}

// Comando /tempban - Banir temporariamente
// ✅ Task 1.2.1: Validação completa de inputs
void cmd_tempban(int player_index, string target_name, double days, string reason = "Violação das regras") {
	// 1. Validação de Permissão
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "tempban", "Você não tem permissão!");
		return;
	}

	// 2. Validação de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "tempban", "Nome de jogador inválido!");
		return;
	}

	// 3. Validação de Duração
	if(days < 0.001 || days > 365.0) {
		send_admin_error(player_index, "tempban", "Duração inválida! Use valores entre 0.001 e 365 dias.");
		return;
	}

	// 4. Validação de Razão
	if(reason.length() > ADMIN_MAX_REASON_LEN) {
		reason = reason.substr(0, ADMIN_MAX_REASON_LEN);
	}

	// 5. Verificar se jogador existe
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "tempban", "Jogador '" + target_name + "' não encontrado!");
		return;
	}

	// 6. Não pode banir outro admin
	if(players[target].admin) {
		send_admin_error(player_index, "tempban", "Você não pode banir outro administrador!");
		return;
	}

	// --- EXECUÇÃO DA LÓGICA ---
	double minutes = days * 1440.0; // 1 dia = 1440 minutos
	create_temp_ban(target_name, minutes, 0.0, reason, players[target].computer_id);

	// Broadcast
	eadm(players[player_index].charname + " baniu temporariamente " + target_name + " por " + days + " dias. Razão: " + reason);

	// Notificar jogador banido
	send_reliable(players[target].peer_id, "msg2 Você foi banido temporariamente por " + days + " dias. Razão: " + reason, 0);

	debug_log("ADMIN: " + players[player_index].charname + " baniu " + target_name + " por " + days + " dias");

	// Desconectar jogador (TODO: Implementar quando network estiver pronto)
	// server_net.disconnect_peer(players[target].peer_id);
}
