			save_player(i);
			saved++;
		}
	}

	send_reliable_text(players[player_index].peer_id, "msg2 Salvos " + saved + " jogadores.", 0);
	debug_log("ADMIN: " + players[player_index].charname + " forÃ§ou salvamento de " + saved + " jogadores");
}

