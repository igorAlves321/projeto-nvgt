}

// ============================================================================
// ðŸ†• COMANDOS DE GESTÃƒO DE ZONAS DESABILITADAS
// ============================================================================

// Comando /addzone - Adicionar nova zona desabilitada
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_addzone(int player_index, int minx, int maxx, int miny, int maxy, string map_name, string message = "Zona Segura") {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "addzone", "Apenas super admins podem usar este comando!");
		return;
	}

	// 2. ValidaÃ§Ã£o de Coordenadas
	if(!is_valid_coord(minx) || !is_valid_coord(maxx) || !is_valid_coord(miny) || !is_valid_coord(maxy)) {
		send_admin_error(player_index, "addzone", "Coordenadas fora dos limites permitidos (" + ADMIN_MIN_COORD + " a " + ADMIN_MAX_COORD + ").");
		return;
	}

	// 3. ValidaÃ§Ã£o de LÃ³gica das Coordenadas
	if(minx > maxx || miny > maxy) {
		send_admin_error(player_index, "addzone", "Coordenadas invÃ¡lidas: min deve ser menor que max.");
		return;
	}

	// 4. ValidaÃ§Ã£o de Nome do Mapa
	if(!is_valid_map_name(map_name)) {
		send_admin_error(player_index, "addzone", "Nome de mapa invÃ¡lido!");
		return;
	}

	// 5. ValidaÃ§Ã£o de Mensagem
	if(message.length() > 128) {
		message = message.substr(0, 128); // Truncar mensagem muito longa
	}

	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	game_disabled_zone@ nova_zona = game_disabled_zone(minx, maxx, miny, maxy, map_name, message);
	nova_zona.disable_pvp = true;
	nova_zona.disable_items = false;
	nova_zona.disable_commands = false;
	game_disabled_zones.insert_last(nova_zona);

	send_reliable_text(players[player_index].peer_id,
		"msg2 Zona adicionada: [" + minx + "," + maxx + "] x [" + miny + "," + maxy + "] no mapa " + map_name, 0);

	debug_log("ADMIN: " + players[player_index].charname + " adicionou zona desabilitada no mapa " + map_name);
}

// Comando /removezone - Remover zona desabilitada por Ã­ndice
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_removezone(int player_index, int zone_index) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "removezone", "Apenas super admins podem usar este comando!");
		return;
	}

	// 2. ValidaÃ§Ã£o de Ãndice
	if(zone_index < 0 || zone_index >= int(game_disabled_zones.length())) {
		send_admin_error(player_index, "removezone", "Ãndice de zona invÃ¡lido (0-" + (int(game_disabled_zones.length()) - 1) + "). Use /listzones para ver as zonas.");
		return;
	}

	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	string map_removed = game_disabled_zones[zone_index].map;
	game_disabled_zones.remove_at(zone_index);

	send_reliable_text(players[player_index].peer_id, "msg2 Zona " + zone_index + " removida do mapa " + map_removed, 0);
	debug_log("ADMIN: " + players[player_index].charname + " removeu zona " + zone_index);
}

// Comando /listzones - Listar todas as zonas desabilitadas
// âœ… Task 1.2.1: ValidaÃ§Ã£o de permissÃ£o
void cmd_listzones(int player_index) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "listzones", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}

	if(game_disabled_zones.length() == 0) {
		send_reliable_text(players[player_index].peer_id, "msg2 Nenhuma zona desabilitada configurada", 0);
		return;
	}

	string result = "=== ZONAS DESABILITADAS (" + game_disabled_zones.length() + ") ===\\r\\n";

	for(uint i = 0; i < game_disabled_zones.length(); i++) {
		result += "[" + i + "] Mapa: " + game_disabled_zones[i].map +
			" | Ãrea: [" + game_disabled_zones[i].minx + "-" + game_disabled_zones[i].maxx +
			"] x [" + game_disabled_zones[i].miny + "-" + game_disabled_zones[i].maxy + "]";

		if(game_disabled_zones[i].disable_pvp) result += " | PvP:OFF";
		if(game_disabled_zones[i].disable_items) result += " | Items:OFF";
		if(game_disabled_zones[i].disable_commands) result += " | Commands:OFF";

		result += "\\r\\n";
	}

	send_reliable_text(players[player_index].peer_id, "say " + result, 0);
}

// Comando /togglezonepvp - Alternar PvP em uma zona
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_togglezonepvp(int player_index, int zone_index) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "togglezonepvp", "Apenas super admins podem usar este comando!");
		return;
	}

	// 2. ValidaÃ§Ã£o de Ãndice
	if(zone_index < 0 || zone_index >= int(game_disabled_zones.length())) {
		send_admin_error(player_index, "togglezonepvp", "Ãndice de zona invÃ¡lido (0-" + (int(game_disabled_zones.length()) - 1) + "). Use /listzones para ver as zonas.");
		return;
	}

	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	game_disabled_zones[zone_index].disable_pvp = !game_disabled_zones[zone_index].disable_pvp;

	string status = game_disabled_zones[zone_index].disable_pvp ? "desabilitado" : "habilitado";
	send_reliable_text(players[player_index].peer_id,
		"msg2 PvP " + status + " na zona " + zone_index + " (" + game_disabled_zones[zone_index].map + ")", 0);

	debug_log("ADMIN: " + players[player_index].charname + " alterou PvP na zona " + zone_index + " para " + status);
}

// Comando /checkzone - Verificar se posiÃ§Ã£o atual estÃ¡ em zona desabilitada
// âœ… Task 1.2.1: Comando pÃºblico (sem restriÃ§Ã£o de admin) - validaÃ§Ã£o bÃ¡sica de Ã­ndice
void cmd_checkzone(int player_index) {
	// ValidaÃ§Ã£o bÃ¡sica de player_index
	if(player_index < 0 || player_index >= int(players.length())) {
		return;
	}

	bool in_zone = false;
	int zone_id = -1;

	for(uint i = 0; i < game_disabled_zones.length(); i++) {
		if(game_disabled_zones[i].is_inside(players[player_index].x, players[player_index].y, players[player_index].map)) {
			in_zone = true;
			zone_id = i;
			break;
		}
	}

	if(in_zone) {
		send_reliable_text(players[player_index].peer_id,
			"msg2 VocÃª estÃ¡ na zona [" + zone_id + "] - " + game_disabled_zones[zone_id].message +
			" | PvP:" + (game_disabled_zones[zone_id].disable_pvp ? "OFF" : "ON"), 0);
	} else {
		send_reliable_text(players[player_index].peer_id, "msg2 VocÃª nÃ£o estÃ¡ em nenhuma zona desabilitada", 0);
	}
}

// Comando /savezones - Salvar zonas em arquivo de configuraÃ§Ã£o
// âœ… Task 1.2.1: ValidaÃ§Ã£o de permissÃ£o
void cmd_savezones(int player_index) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "savezones", "Apenas super admins podem usar este comando!");
		return;
	}

	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	file f;
	if(!f.open("disabled_zones.cfg", "wb")) {
		send_admin_error(player_index, "savezones", "Erro ao abrir arquivo para salvar!");
		return;
	}

	string content = "// Zonas Desabilitadas - ConfiguraÃ§Ã£o\\n";
	content += "// Formato: map|minx|maxx|miny|maxy|pvp|items|commands|message\\n\\n";

	for(uint i = 0; i < game_disabled_zones.length(); i++) {
		content += game_disabled_zones[i].map + "|";
		content += game_disabled_zones[i].minx + "|";
		content += game_disabled_zones[i].maxx + "|";
		content += game_disabled_zones[i].miny + "|";
		content += game_disabled_zones[i].maxy + "|";
		content += (game_disabled_zones[i].disable_pvp ? "1" : "0") + "|";
		content += (game_disabled_zones[i].disable_items ? "1" : "0") + "|";
		content += (game_disabled_zones[i].disable_commands ? "1" : "0") + "|";
		content += game_disabled_zones[i].message + "\\n";
	}

	f.write(content);
	f.close();

	send_reliable_text(players[player_index].peer_id,
		"msg2 " + game_disabled_zones.length() + " zonas salvas em disabled_zones.cfg", 0);

	debug_log("ADMIN: " + players[player_index].charname + " salvou " + game_disabled_zones.length() + " zonas");
}

int load_disabled_zones_from_disk() {
	file f;
	if(!f.open("disabled_zones.cfg", "rb")) {
		return -1;
	}

	string content = f.read();
	f.close();

	// Limpar zonas atuais
	game_disabled_zones.resize(0);

	string[] lines = content.split("\\n");
	int loaded = 0;

	for(uint i = 0; i < lines.length(); i++) {
		string line = trim(lines[i]);
		if(line == "" || line.substr(0, 2) == "//") continue;

		string[] parts = line.split("|");
		if(parts.length() >= 9) {
			string map = parts[0];
			int minx = string_to_number(parts[1]);
			int maxx = string_to_number(parts[2]);
			int miny = string_to_number(parts[3]);
			int maxy = string_to_number(parts[4]);
			bool pvp = (parts[5] == "1");
			bool items = (parts[6] == "1");
			bool commands = (parts[7] == "1");
			string message = parts[8];

			game_disabled_zone@ zona = game_disabled_zone(minx, maxx, miny, maxy, map, message);
			zona.disable_pvp = pvp;
			zona.disable_items = items;
			zona.disable_commands = commands;
			game_disabled_zones.insert_last(zona);
			loaded++;
		}
	}

	return loaded;
}

// Comando /loadzones - Carregar zonas de arquivo de configuraÃ§Ã£o
// âœ… Task 1.2.1: ValidaÃ§Ã£o de permissÃ£o
void cmd_loadzones(int player_index) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_super_admin(player_index)) {
		send_admin_error(player_index, "loadzones", "Apenas super admins podem usar este comando!");
		return;
	}

	int loaded = load_disabled_zones_from_disk();
	if(loaded < 0) {
		send_admin_error(player_index, "loadzones", "Arquivo disabled_zones.cfg nÃ£o encontrado!");
		return;
	}

	send_reliable_text(players[player_index].peer_id, "msg2 " + loaded + " zonas carregadas de disabled_zones.cfg", 0);
	debug_log("ADMIN: " + players[player_index].charname + " carregou " + loaded + " zonas");
}

// Comando /createportal - Criar portal de teletransporte
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_createportal(int player_index, string destination_map, int dest_x, int dest_y) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "createportal", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}

	// 2. ValidaÃ§Ã£o de Nome do Mapa de Destino
	if(!is_valid_map_name(destination_map)) {
		send_admin_error(player_index, "createportal", "Nome de mapa invÃ¡lido! Use apenas letras, nÃºmeros e underscore.");
		return;
	}

	// 3. ValidaÃ§Ã£o de Coordenadas
	if(!is_valid_coord(dest_x) || !is_valid_coord(dest_y)) {
		send_admin_error(player_index, "createportal", "Coordenadas invÃ¡lidas! Use valores entre " + ADMIN_MIN_COORD + " e " + ADMIN_MAX_COORD + ".");
		return;
	}

	// 4. Verificar se o mapa de destino existe
	int dest_map_index = get_map_index_from(destination_map);
	if(dest_map_index == -1) {
		send_admin_error(player_index, "createportal", "Mapa de destino nÃ£o encontrado: " + destination_map);
		return;
	}

	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	spawn_portal(player_index, players[player_index].x, players[player_index].y, 
	             players[player_index].map, destination_map, dest_x, dest_y);

	send_reliable_text(players[player_index].peer_id, "msg2 Portal criado para " + destination_map + " em (" + dest_x + ", " + dest_y + ")", 0);
	debug_log("ADMIN: " + players[player_index].charname + " criou portal para " + destination_map);
}

// Comando /deleteportal - Deletar portal prÃ³ximo
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_deleteportal(int player_index, int range = 10) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "deleteportal", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}

	// 2. ValidaÃ§Ã£o de Range
	if(range < 1 || range > 100) {
		send_admin_error(player_index, "deleteportal", "Range invÃ¡lido! Use valores entre 1 e 100.");
		return;
	}

	// 3. ValidaÃ§Ã£o do Mapa
	int map_index = get_map_index_from(players[player_index].map);
	if(map_index == -1) {
		send_admin_error(player_index, "deleteportal", "Erro ao obter mapa atual!");
		return;
	}

	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	for(uint i = 0; i < server_maps[map_index].portals.length(); i++) {
		portal@ pt = server_maps[map_index].portals[i];
		int distance = int(get_distance(players[player_index].x, players[player_index].y, pt.x, pt.y));

		if(distance <= range) {
			send_reliable_text(players[player_index].peer_id, "msg2 Portal deletado!", 0);
			server_maps[map_index].portals.remove_at(i);
			debug_log("ADMIN: " + players[player_index].charname + " deletou portal em " + players[player_index].map);
			return;
		}
	}

	send_admin_error(player_index, "deleteportal", "Nenhum portal encontrado em um raio de " + range + " tiles.");
}

// Comando /tempban - Banir temporariamente
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_tempban(int player_index, string target_name, double days, string reason = "ViolaÃ§Ã£o das regras") {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "tempban", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}

	// 2. ValidaÃ§Ã£o de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "tempban", "Nome de jogador invÃ¡lido!");
		return;
	}

	// 3. ValidaÃ§Ã£o de DuraÃ§Ã£o
	if(days < 0.001 || days > 365.0) {
		send_admin_error(player_index, "tempban", "DuraÃ§Ã£o invÃ¡lida! Use valores entre 0.001 e 365 dias.");
		return;
	}

	// 4. ValidaÃ§Ã£o de RazÃ£o
	if(reason.length() > ADMIN_MAX_REASON_LEN) {
		reason = reason.substr(0, ADMIN_MAX_REASON_LEN);
	}

	// 5. Verificar se jogador existe
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "tempban", "Jogador '" + target_name + "' nÃ£o encontrado!");
		return;
	}

	// 6. NÃ£o pode banir outro admin
	if(players[target].admin) {
		send_admin_error(player_index, "tempban", "VocÃª nÃ£o pode banir outro administrador!");
		return;
	}

	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	// âœ… MigraÃ§Ã£o SQL: Usando add_ban_db() em vez de create_temp_ban()
	double minutes = days * 1440.0; // 1 dia = 1440 minutos
	string admin_name = players[player_index].charname;
	string computer_id = players[target].computer_id;
	
	if(!add_ban_db(target_name, computer_id, "", admin_name, reason, minutes)) {
		// Fallback para sistema legado se SQL falhar
		create_temp_ban(target_name, minutes, 0.0, reason, computer_id);
		debug_log("WARN: Fallback para create_temp_ban() - SQL falhou");
	}

	// Broadcast
	eadm(admin_name + " baniu temporariamente " + target_name + " por " + days + " dias. RazÃ£o: " + reason);

	// Notificar jogador banido
	send_reliable_text(players[target].peer_id, "msg2 VocÃª foi banido temporariamente por " + days + " dias. RazÃ£o: " + reason, 0);

	debug_log("ADMIN: " + players[player_index].charname + " baniu " + target_name + " por " + days + " dias");

	// Desconectar jogador banido e limpar rastros de conexÃ£o
	uint64 target_peer = players[target].peer_id;
	force_disconnect_and_cleanup(target_peer, true);
}

// ============================================================================
// COMANDOS ADMIN ADICIONAIS - Para Menu Administrativo
// ============================================================================

// Comando /ban - Banir permanentemente
void cmd_ban(int player_index, string target_name, string reason = "ViolaÃ§Ã£o das regras") {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "ban", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "ban", "Nome de jogador invÃ¡lido!");
		return;
	}

	if(reason.length() > ADMIN_MAX_REASON_LEN) {
		reason = reason.substr(0, ADMIN_MAX_REASON_LEN);
	}

	int target = get_player_index_from(target_name);
	
	if(target != -1 && players[target].admin) {
		send_admin_error(player_index, "ban", "VocÃª nÃ£o pode banir outro administrador!");
		return;
	}

	string computer_id = (target != -1) ? players[target].computer_id : "";
	string admin_name = players[player_index].charname;
	
	// âœ… MigraÃ§Ã£o SQL: Usando add_ban_db() com expire_minutes=0 para ban permanente
	if(!add_ban_db(target_name, computer_id, "", admin_name, reason, 0)) {
		// Fallback para sistema legado se SQL falhar
		create_temp_ban(target_name, 525600.0 * 10, 0.0, reason, computer_id);
		debug_log("WARN: Fallback para create_temp_ban() - SQL falhou");
	}

	eadm(admin_name + " baniu permanentemente " + target_name + ". RazÃ£o: " + reason);

	if(target != -1) {
		send_reliable_text(players[target].peer_id, "msg2 VocÃª foi banido permanentemente. RazÃ£o: " + reason, 0);
	}

	debug_log("ADMIN: " + players[player_index].charname + " baniu PERMANENTEMENTE " + target_name);
}

// Comando /unban - Desbanir jogador
void cmd_unban(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "unban", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "unban", "Nome de jogador invÃ¡lido!");
		return;
	}

	// âœ… MigraÃ§Ã£o SQL: Tenta desbanir via SQL primeiro, depois fallback
	bool unbanned = unban_player_db(target_name);
	
	// TambÃ©m tenta remover do sistema legado para garantir limpeza completa
	bool legacy_removed = remove_temp_ban(target_name);
	
	if(unbanned || legacy_removed) {
		send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " foi desbanido.", 0);
		eadm(players[player_index].charname + " desbaniu " + target_name);
		debug_log("ADMIN: " + players[player_index].charname + " desbaniu " + target_name);
	} else {
		send_admin_error(player_index, "unban", "Jogador nÃ£o estÃ¡ banido ou ban nÃ£o encontrado.");
	}
}

// Comando /silenciar - Silenciar jogador (mute)
void cmd_silenciar(int player_index, string target_name, int minutes = 10) {
	if(!is_admin(player_index)) {
