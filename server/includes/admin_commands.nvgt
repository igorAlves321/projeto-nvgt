// Comando /givexp
// âœ… Task 1.2.1: ValidaÃ§Ã£o completa de inputs
void cmd_givexp(int player_index, string target_name, int xp_amount) {
	// 1. ValidaÃ§Ã£o de PermissÃ£o
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "givexp", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}
	
	// 2. ValidaÃ§Ã£o de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "givexp", "Nome de jogador invÃ¡lido!");
		return;
	}
	
	// 3. ValidaÃ§Ã£o de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "givexp", "Jogador '" + target_name + "' nÃ£o encontrado ou offline.");
		return;
	}
	
	// 4. ValidaÃ§Ã£o de Limites de XP
	if(!is_within_limits(xp_amount, 1, ADMIN_MAX_XP)) {
		send_admin_error(player_index, "givexp", "Quantidade de XP deve ser entre 1 e " + ADMIN_MAX_XP + ".");
		return;
	}
	
	// --- EXECUÃ‡ÃƒO DA LÃ“GICA ---
	ganhaxp(target, xp_amount, 0);
	send_reliable_text(players[player_index].peer_id, "msg2 VocÃª deu " + xp_amount + " XP para " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " deu " + xp_amount + " XP para " + target_name);
}

// Comando /giveitem
