		send_admin_error(player_index, "giveitem", "VocÃª nÃ£o tem permissÃ£o!");
		return;
	}
	
	// 2. ValidaÃ§Ã£o de Nome do Jogador
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "giveitem", "Nome de jogador invÃ¡lido!");
		return;
	}
	
	// 3. ValidaÃ§Ã£o de Entidade (Jogador Existe?)
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "giveitem", "Jogador '" + target_name + "' nÃ£o encontrado ou offline.");
		return;
	}
	
	// 4. ValidaÃ§Ã£o de Nome do Item
	if(!is_valid_item_name(item_name)) {
		send_admin_error(player_index, "giveitem", "Nome de item invÃ¡lido!");
		return;
	}
	
	// 5. ValidaÃ§Ã£o de Quantidade
	if(!is_within_limits(quantity, 1, ADMIN_MAX_ITEM_QTY)) {
		send_admin_error(player_index, "giveitem", "Quantidade deve ser entre 1 e " + ADMIN_MAX_ITEM_QTY + ".");
