// Helper para formatar uptime
string format_uptime(uint64 milliseconds) {
	int seconds = milliseconds / 1000;
	int minutes = seconds / 60;
	int hours = minutes / 60;
	int days = hours / 24;

	hours = hours % 24;
	minutes = minutes % 60;
	seconds = seconds % 60;

	return days + "d " + hours + "h " + minutes + "m " + seconds + "s";
}

// ============================================================================
// 🔧 CONSTRUTOR DE ITENS - Item Builder Tool (Admin Only)
// ============================================================================

// Comando /create_item_tool - Criar item genérico (consumível, armadura, material, melee)
// Formato: type|name|display|desc|category|damage|defense|heal|mp|weight|value|rarity|sound|extra1|extra2
void cmd_create_item_tool(int player_index, string data) {
    // Verificar se é admin
    if(!is_admin(player_index)) {
        send_admin_error(player_index, "create_item_tool", "Permissão negada. Apenas admins podem criar itens.");
        return;
    }
    
    // Parsear dados separados por |
    string[] parts = data.split("|");
    if(parts.length() < 12) {
        send_admin_error(player_index, "create_item_tool", "Dados insuficientes. Esperado 12+ campos.");
        debug_log("Item Builder: dados insuficientes: " + parts.length() + " campos");
        return;
    }
    
    // Extrair dados
    string item_type = parts[0];     // weapon, armor, consumable, misc
    string name = parts[1];          // ID interno
    string display = parts[2];       // Nome visível
    string desc = parts[3];          // Descrição
    string category = parts[4];      // Subcategoria (sword, potion, etc)
    int damage = string_to_number(parts[5]);
    int defense = string_to_number(parts[6]);
    int heal = string_to_number(parts[7]);
    int mp = string_to_number(parts[8]);
    float weight = parse_float(parts[9]);
    int value = string_to_number(parts[10]);
    string rarity = parts[11];
    string sound_file = parts.length() > 12 ? parts[12] : "";
    int max_stack = parts.length() > 13 ? string_to_number(parts[13]) : 1;
    float drop_rate = parts.length() > 14 ? parse_float(parts[14]) : 1.0;
    
    // Validar ID interno (sem espaços, alfanumérico)
    if(name.length() == 0 || name.find(" ") >= 0) {
        send_admin_error(player_index, "create_item_tool", "ID interno inválido. Não pode ter espaços.");
        return;
    }
    
    // Determinar se é empilhável baseado no tipo
    bool stackable = (item_type == "consumable" || item_type == "misc");
    if(max_stack <= 1) {
        stackable = false;
        max_stack = 1;
    }
    
    // Tentar criar no banco de dados
    bool success = create_item(
        name, display, desc, item_type, category,
        damage, defense, heal, mp,
        stackable, max_stack, weight, value,
        rarity, drop_rate, false, true, true,
        "", sound_file
    );
    
    if(success) {
        // Recarregar itens na memória
        load_items_from_database();
        
        string msg = "✅ Item criado com sucesso: " + display + " (" + name + ")";
        send_reliable(players[player_index].peer_id, "msg2 " + msg, 0);
        debug_log("ITEM BUILDER: " + players[player_index].charname + " criou item " + name);
    } else {
        send_reliable(players[player_index].peer_id, "msg2 ❌ Erro ao criar item. O ID '" + name + "' já existe?", 0);
    }
}

// Comando /create_weapon_tool - Criar arma de fogo (formato weapons_list.db)
// Formato: name=ammo=sound_shoot=sound_impact=sound_draw=sound_reload=damage=distance=ammo_total=ammo_cantity=speed=speed_burst=speed_loading=require_ammo=enable_burst=is_dropable=sound_impact_on_corpse=sound_unload=sound_mode1=sound_mode2=ammo_cantity_descount=sound_shoot_dist=degradation_point
void cmd_create_weapon_tool(int player_index, string data) {
    if(!is_admin(player_index)) {
        send_admin_error(player_index, "create_weapon_tool", "Permissão negada. Apenas admins podem criar armas.");
        return;
    }

    if(!file_exists("weapons_list.db")) {
        file f;
        f.open("weapons_list.db", "w");
        f.write("// weapons_list.db - Banco de Dados de Armas\r\n");
        f.write("// Formato: name=ammo=sound_shoot=sound_impact=sound_draw=sound_reload=damage=distance=ammo_total=ammo_cantity=speed=speed_burst=speed_loading=require_ammo=enable_burst=is_dropable=sound_impact_on_corpse=sound_unload=sound_mode1=sound_mode2=ammo_cantity_descount=sound_shoot_dist=degradation_point\r\n\r\n");
        f.close();
    }

    string[] parts = data.split("=");
    if(parts.length() < 23) {
        send_admin_error(player_index, "create_weapon_tool", "Dados insuficientes. Esperado 23 campos separados por =");
        debug_log("Weapon Builder: dados insuficientes: " + parts.length() + " campos");
        return;
    }

    string weapon_name = parts[0];
    string ammo_name = parts[1];
    string shoot_sound = parts[2];
    int damage = string_to_number(parts[6]);
    int distance = string_to_number(parts[7]);
    if(damage < 1) damage = 1;
    if(distance < 1) distance = 1;

    file check;
    check.open("weapons_list.db", "r");
    string existing = check.read();
    check.close();

    if(existing.find(weapon_name + "=") >= 0) {
        send_reliable(players[player_index].peer_id, "msg2 ❌ Arma '" + weapon_name + "' já existe no banco de dados.", 0);
        return;
    }

    file f;
    f.open("weapons_list.db", "a");
    f.write(data + "\r\n");
    f.close();

    weapons_list.resize(0);
    load_weapons();

    string display_name = string_replace(weapon_name, "_", " ", true);
    string description = "Arma de fogo. Municao: " + ammo_name + ". Alcance: " + distance + ".";
    int value = damage * 8;
    if(value < 20) value = 20;

    bool created_in_db = create_item(
        weapon_name, display_name, description, "weapon", "firearm",
        damage, 0, 0, 0,
        false, 1, 2.0, value,
        "common", 0.0, false, true, true,
        shoot_sound, shoot_sound
    );

    if(!created_in_db) {
        string upsert_query = """
            UPDATE items
            SET display_name = ?, description = ?, item_type = 'weapon', category = 'firearm',
                damage = ?, stackable = 0, max_stack = 1, weight = 2.0, value = ?,
                sound_file = ?, use_sound = ?, updated_at = CURRENT_TIMESTAMP
            WHERE name = ?;
        """;
        sqlite3statement@ up_stmt = bancoJogo.prepare(upsert_query);
        if(@up_stmt != null) {
            up_stmt.bind_text(1, display_name);
            up_stmt.bind_text(2, description);
            up_stmt.bind_int(3, damage);
            up_stmt.bind_int(4, value);
            up_stmt.bind_text(5, shoot_sound);
            up_stmt.bind_text(6, shoot_sound);
            up_stmt.bind_text(7, weapon_name);
            up_stmt.step();
        }
    }

    load_items_from_database();

    string msg = "✅ Arma criada com sucesso: " + weapon_name;
    send_reliable(players[player_index].peer_id, "msg2 " + msg, 0);
    debug_log("WEAPON BUILDER: " + players[player_index].charname + " criou arma " + weapon_name);
    send_reliable(players[player_index].peer_id, "msg2 ⚠️ Catalogo SQLite sincronizado. Jogadores podem precisar reconectar para runtime de arma.", 0);
}

// Comando /list_items - Listar itens disponíveis
void cmd_list_items(int player_index) {
    if(!is_admin(player_index)) {
        send_admin_error(player_index, "list_items", "Permissão negada.");
        return;
    }

    string list_items = "=== Itens do Banco de Dados ===\n";

    string query = "SELECT name, display_name, item_type, value FROM items ORDER BY item_type, name LIMIT 200;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);

    int count = 0;
    if(@stmt != null) {
        while(stmt.step() == SQLITE_ROW) {
            string name = stmt.column_text(0);
            string display = stmt.column_text(1);
            string type = stmt.column_text(2);
            int value = stmt.column_int(3);

            list_items += "[" + type + "] " + name + " - " + display + " (" + value + "g)\n";
            count++;
        }
    }

    if(count == 0) {
        list_items += "(Nenhum item cadastrado)\n";
    }

    list_items += "\n(Fonte unica: tabela items do SQLite)\n";
    send_reliable(players[player_index].peer_id, "msg2 " + list_items, 0);
}

// Comando /edit_item_tool - Editar item existente no catalogo SQLite
// Formato: name|display|desc|type|category|damage|defense|heal|mp|weight|value|rarity|sound|max_stack|drop_rate
void cmd_edit_item_tool(int player_index, string data) {
    if(!is_admin(player_index)) {
        send_admin_error(player_index, "edit_item_tool", "Permissao negada. Apenas admins podem editar itens.");
        return;
    }

    string[] parts = data.split("|");
    if(parts.length() < 15) {
        send_admin_error(player_index, "edit_item_tool", "Dados insuficientes. Esperado 15 campos separados por |.");
        return;
    }

    string name = parts[0];
    string display = parts[1];
    string desc = parts[2];
    string item_type = parts[3];
    string category = parts[4];
    int damage = string_to_number(parts[5]);
    int defense = string_to_number(parts[6]);
    int heal = string_to_number(parts[7]);
    int mp = string_to_number(parts[8]);
    float weight = parse_float(parts[9]);
    int value = string_to_number(parts[10]);
    string rarity = parts[11];
    string sound_file = parts[12];
    int max_stack = string_to_number(parts[13]);
    float drop_rate = parse_float(parts[14]);

    if(name == "") {
        send_admin_error(player_index, "edit_item_tool", "Nome interno do item invalido.");
        return;
    }

    string exists_query = "SELECT id FROM items WHERE name = ? LIMIT 1;";
    sqlite3statement@ exists_stmt = bancoJogo.prepare(exists_query);
    if(@exists_stmt == null) {
        send_reliable(players[player_index].peer_id, "msg2 Erro ao validar item: " + bancoJogo.get_last_error_text(), 0);
        return;
    }
    exists_stmt.bind_text(1, name);
    if(exists_stmt.step() != SQLITE_ROW) {
        send_reliable(players[player_index].peer_id, "msg2 Item nao encontrado no catalogo: " + name, 0);
        return;
    }

    bool stackable = (item_type == "consumable" || item_type == "misc");
    if(max_stack <= 1) {
        stackable = false;
        max_stack = 1;
    }

    string query = """
        UPDATE items
        SET display_name = ?, description = ?, item_type = ?, category = ?,
            damage = ?, defense = ?, heal_amount = ?, mp_restore = ?,
            stackable = ?, max_stack = ?, weight = ?, value = ?,
            rarity = ?, drop_rate = ?, sound_file = ?, use_sound = ?, updated_at = CURRENT_TIMESTAMP
        WHERE name = ?;
    """;

    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) {
        send_reliable(players[player_index].peer_id, "msg2 Erro ao preparar UPDATE: " + bancoJogo.get_last_error_text(), 0);
        return;
    }

    stmt.bind_text(1, display);
    stmt.bind_text(2, desc);
    stmt.bind_text(3, item_type);
    stmt.bind_text(4, category);
    stmt.bind_int(5, damage);
    stmt.bind_int(6, defense);
    stmt.bind_int(7, heal);
    stmt.bind_int(8, mp);
    stmt.bind_int(9, stackable ? 1 : 0);
    stmt.bind_int(10, max_stack);
    stmt.bind_double(11, weight);
    stmt.bind_int(12, value);
    stmt.bind_text(13, rarity);
    stmt.bind_double(14, drop_rate);
    stmt.bind_text(15, sound_file);
    stmt.bind_text(16, sound_file);
    stmt.bind_text(17, name);

    if(stmt.step() != SQLITE_DONE) {
        send_reliable(players[player_index].peer_id, "msg2 Erro ao editar item: " + bancoJogo.get_last_error_text(), 0);
        return;
    }

    load_items_from_database();
    send_reliable(players[player_index].peer_id, "msg2 Item atualizado com sucesso: " + name, 0);
    debug_log("ITEM BUILDER: " + players[player_index].charname + " editou item " + name);
}

// Comando /delete_item_tool - Excluir item do catalogo SQLite
void cmd_delete_item_tool(int player_index, string item_name) {
    if(!is_admin(player_index)) {
        send_admin_error(player_index, "delete_item_tool", "Permissao negada. Apenas admins podem excluir itens.");
        return;
    }

    item_name = item_name.trim_whitespace();
    if(item_name == "") {
        send_admin_error(player_index, "delete_item_tool", "Nome de item invalido.");
        return;
    }

    string exists_query = "SELECT id FROM items WHERE name = ? LIMIT 1;";
    sqlite3statement@ exists_stmt = bancoJogo.prepare(exists_query);
    if(@exists_stmt == null) {
        send_reliable(players[player_index].peer_id, "msg2 Erro ao validar item: " + bancoJogo.get_last_error_text(), 0);
        return;
    }
    exists_stmt.bind_text(1, item_name);
    if(exists_stmt.step() != SQLITE_ROW) {
        send_reliable(players[player_index].peer_id, "msg2 Item nao encontrado no catalogo: " + item_name, 0);
        return;
    }

    string query = "DELETE FROM items WHERE name = ?;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) {
        send_reliable(players[player_index].peer_id, "msg2 Erro ao preparar DELETE: " + bancoJogo.get_last_error_text(), 0);
        return;
    }

    stmt.bind_text(1, item_name);
    if(stmt.step() != SQLITE_DONE) {
        send_reliable(players[player_index].peer_id, "msg2 Erro ao excluir item: " + bancoJogo.get_last_error_text(), 0);
        return;
    }

    load_items_from_database();
    send_reliable(players[player_index].peer_id, "msg2 Item removido do catalogo: " + item_name, 0);
    send_reliable(players[player_index].peer_id, "msg2 Nota: se for arma legado, ela ainda pode existir no weapons_list.db.", 0);
    debug_log("ITEM BUILDER: " + players[player_index].charname + " removeu item " + item_name);
}
