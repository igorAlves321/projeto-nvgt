void send_welcome_message(player@ p) {
    // Mensagem de boas-vindas
    string welcome = "Bem-vindo de volta, " + p.charname + "!";
    // TODO: Adicionar campo last_login na classe player se necessário

    send_reliable(p.peer_id, "msg|" + welcome, 0);

    // Informações adicionais
    send_reliable(p.peer_id, "msg|Nível: " + p.level + " | XP: " + p.exp + "/" + p.xprequerida, 0);
    send_reliable(p.peer_id, "msg|Ouro: " + p.gold + " | Stryx: " + p.stryx, 0);

    debug_log("  ✓ Mensagem de boas-vindas enviada");
}

// ============================================================
// 7. REGISTRAR TIMERS PESSOAIS
// ============================================================

void register_player_timers(player@ p) {
    debug_log("Registrando timers pessoais de " + p.charname);

    // Reiniciar todos os timers do jogador
    p.playtimer.restart();
    p.safetimer.restart();
    p.pingtimer.restart();
    p.afksecondtimer.restart();

    // Outros timers específicos conforme necessário

    debug_log("✓ Timers registrados");
}

// ============================================================
// FUNÇÃO PRINCIPAL DE CARREGAMENTO COMPLETO
// ============================================================

// Função principal que orquestra todo o carregamento do jogador
// Esta função deve ser chamada após a autenticação bem-sucedida
bool load_player_complete(player@ p) {
    if(p is null) {
        debug_log("ERRO: load_player_complete - player é nulo");
        return false;
    }

    debug_log("╔════════════════════════════════════════════════════════════╗");
    debug_log("║     CARREGAMENTO COMPLETO DE JOGADOR: " + p.charname);
    debug_log("╚════════════════════════════════════════════════════════════╝");

    // PASSO 1: Carregar dados completos do banco SQLite
    if(!load_player_data_complete(p)) {
        debug_log("✗ FALHA NO PASSO 1: Carregamento de dados");
        return false;
    }

    // PASSO 2: Inventário e equipamentos já são carregados no passo 1

    // PASSO 3: Validar e restaurar localização
    if(!validate_and_restore_location(p)) {
        debug_log("✗ FALHA NO PASSO 3: Validação de localização");
        return false;
    }

    // PASSO 4: Popular estruturas globais
    populate_global_structures(p);

    // PASSO 5: Restaurar dados sociais
    load_player_friends(p);
    // Guild e party já foram carregados no passo 1

    // PASSO 6: Sincronizar estado com o cliente
    sync_player_state_to_client(p);

    // PASSO 7: Registrar timers pessoais
    register_player_timers(p);

    debug_log("╔════════════════════════════════════════════════════════════╗");
    debug_log("║     ✓✓✓ JOGADOR CARREGADO COM SUCESSO ✓✓✓                 ║");
    debug_log("║     " + p.charname + " está pronto para jogar!");
    debug_log("╚════════════════════════════════════════════════════════════╝");

    return true;
}

// ============================================================
// RESULTADO ESPERADO
// ============================================================
//
// Com este módulo implementado:
// ✅ Jogador é carregado completamente do banco de dados
// ✅ Inventário e equipamentos são restaurados
// ✅ Localização no mapa é validada
// ✅ Estruturas globais são populadas
// ✅ Dados sociais são carregados
// ✅ Estado é sincronizado com o cliente
// ✅ Timers pessoais são iniciados
// ✅ Jogador pode entrar no jogo completamente funcional
//
// Este é o sistema que substitui load_configs.bgt + get_player_info.bgt
// ============================================================
