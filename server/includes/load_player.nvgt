void send_stats_to_client(player@ p) {
    // Enviar stats para o cliente
    string stats_packet = "stats|";
    stats_packet += p.health + "|";
    stats_packet += p.maxhealth + "|";
    stats_packet += p.stamina + "|";
    stats_packet += p.exp + "|";
    stats_packet += p.xprequerida + "|";
    stats_packet += p.level + "|";
    stats_packet += p.gold;

    send_reliable(p.peer_id, stats_packet, 0);

    debug_log("  ✓ Stats enviados");
}

