// load_player.nvgt - Sistema Completo de Carregamento do Jogador
// ✅ Epic 1 Task 2: Reescrever load_configs.bgt + get_player_info.bgt
//
// Este módulo é responsável por carregar completamente um jogador do banco de dados
// e reintegrá-lo no ambiente do servidor após autenticação bem-sucedida.
//
// Estrutura de carregamento:
// 1. Carregar dados básicos do banco SQLite
// 2. Restaurar inventário e equipamentos
// 3. Validar e restaurar localização no mapa
// 4. Popular estruturas globais
// 5. Restaurar dados sociais (guild, party, friends)
// 6. Sincronizar estado com o cliente
// 7. Registrar timers pessoais

// ============================================================
// 1. CARREGAR DADOS COMPLETOS DO BANCO SQLITE
// ============================================================

bool load_player_data_complete(player@ p) {
    if(!database_initialized || p is null) {
        debug_log("ERRO: load_player_data_complete - Banco não inicializado ou player nulo");
        return false;
    }

    debug_log("=== Carregando dados completos de " + p.charname + " ===");

    // Query completa para carregar todos os dados do jogador
    string query = """
        SELECT
            level, experience, gold, hp, max_hp, mp, max_mp, race,
            map_name, x, y, z, is_admin, gender,
            inventory, equipment,
            stryx, creditos, saldo, gcoins, greais,
            kills, deaths, play_time,
            arena_wins, arena_kills,
            bounty_on_head, bounty_value, bounty_owner,
            title, rank,
            last_login, created_at,
            xp_requerida, matou, reencarnacoes,
            stamina, fome, sanity, radiation,
            voice_id, idioma_chat,
            guild_id, party_id
        FROM players
        WHERE username = ?;
    """;

    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) {
        debug_log("ERRO ao preparar query load_player_data_complete: " + bancoJogo.get_last_error_text());
        return false;
    }

    stmt.bind_text(1, p.charname);

    if(stmt.step() == SQLITE_ROW) {
        int col = 0;

        // Dados básicos
        p.player_level = stmt.column_int(col++);
        p.level = p.player_level;
        p.exp = stmt.column_int(col++);
        p.xp = p.exp;
        p.gold = stmt.column_int(col++);
        p.saldo = p.gold;
        p.hp = stmt.column_int(col++);
        p.max_hp = stmt.column_int(col++);
        p.mp = stmt.column_int(col++);
        p.max_mp = stmt.column_int(col++);
        p.race = stmt.column_text(col++);

        // Localização
        p.map = stmt.column_text(col++);
        p.map_name = p.map;
        p.mapaatual = p.map;
        p.x = stmt.column_int(col++);
        p.y = stmt.column_int(col++);
        p.z = stmt.column_int(col++);

        // Admin
        p.admin_status = (stmt.column_int(col++) == 1);
        p.is_admin = p.admin_status;
        p.admin = p.admin_status;

        // Gênero (sexo2 é usado para sufixos: "o" masculino, "a" feminino)
        p.sexo = stmt.column_int(col++);
        p.sexo2 = (p.sexo == 0 ? "o" : "a");

        // Inventário e equipamentos (JSON serializado)
        string inventory_json = stmt.column_text(col++);
        string equipment_json = stmt.column_text(col++);

        // Economia
        p.stryx = stmt.column_double(col++);
        p.creditos = stmt.column_double(col++);
        p.saldo = stmt.column_double(col++);
        p.gcoins = stmt.column_int(col++);
        p.greais = stmt.column_int(col++);

        // Estatísticas
        p.kills = stmt.column_int(col++);
        p.matou = p.kills;
        p.deaths = stmt.column_int(col++);
        p.playtime = stmt.column_double(col++);

        // Arena
        p.arena_wins = stmt.column_int(col++);
        p.arena_kills = stmt.column_int(col++);

        // Bounty
        p.bounty_on_head = stmt.column_int(col++);
        p.bounty_value = stmt.column_int(col++);
        p.bounty_owner = stmt.column_text(col++);

        // Título e rank
        p.title = stmt.column_text(col++);
        p.rank = stmt.column_int(col++);

        // Datas (não usado diretamente, mas pode ser útil para logs)
        col++; // last_login
        col++; // created_at

        // XP e estatísticas
        p.xprequerida = stmt.column_int(col++);
        p.matou = stmt.column_int(col++);
        p.reencarnou = stmt.column_int(col++);

        // Status/Condições
        p.stamina = stmt.column_int(col++);
        p.fome = stmt.column_int(col++);
        p.sanity = stmt.column_double(col++);
        p.radiation = stmt.column_int(col++);

        // Configurações
        p.voice_id = stmt.column_text(col++);
        p.idiomachat = stmt.column_text(col++);

        // IDs sociais (guild, party)
        int guild_id = stmt.column_int(col++);
        int party_id = stmt.column_int(col++);

        // Configurar valores derivados
        p.health = p.hp;
        p.maxhealth = p.max_hp;

        debug_log("✓ Dados básicos carregados para " + p.charname);

        // Carregar inventário e equipamentos
        if(inventory_json != "" && inventory_json != "{}") {
            load_player_inventory(p, inventory_json);
        }

        if(equipment_json != "" && equipment_json != "{}") {
            load_player_equipment(p, equipment_json);
        }

        // Carregar dados sociais
        if(guild_id > 0) {
            load_player_guild(p, guild_id);
        }

        if(party_id > 0) {
            load_player_party(p, party_id);
        }

        return true;
    }

    debug_log("ERRO: Jogador " + p.charname + " não encontrado no banco de dados");
    return false;
}

// ============================================================
// 2. RESTAURAR INVENTÁRIO E EQUIPAMENTOS
// ============================================================

void load_player_inventory(player@ p, string inventory_json) {
    debug_log("Carregando inventário de " + p.charname);

    // TODO: Implementar parsing de JSON do inventário
    // Por enquanto, vamos criar uma implementação básica
    // que desserializa o JSON e popula o inventário do jogador

    // O inventário está no formato JSON: {"item_name": quantidade, ...}
    // Exemplo: {"espada_ferro": 1, "pocao_vida": 5, "ouro": 100}

    // NVGT não tem JSON nativo, então vamos fazer parsing manual simples
    // Para produção, seria melhor usar uma biblioteca JSON ou implementar parser completo

    if(inventory_json == "" || inventory_json == "{}") {
        debug_log("Inventário vazio para " + p.charname);
        return;
    }

    // Remover chaves do JSON
    inventory_json = inventory_json.substr(1, inventory_json.length() - 2);

    // Split por vírgulas (itens)
    string[] items = inventory_json.split(",");

    for(uint i = 0; i < items.length(); i++) {
        // Split por : (nome:quantidade)
        string[] parts = items[i].split(":");
        if(parts.length() >= 2) {
            string item_name = parts[0].trim_whitespace();
            item_name = item_name.substr(1, item_name.length() - 2); // Remover aspas

            int quantidade = string_to_number(parts[1].trim_whitespace());

            // Adicionar item ao inventário do jogador
            p.inv.set(item_name, quantidade);
            debug_log("  + " + item_name + " x" + quantidade);
        }
    }

    debug_log("✓ Inventário carregado: " + p.inv.get_keys().length() + " tipos de itens");
}

void load_player_equipment(player@ p, string equipment_json) {
    debug_log("Carregando equipamentos de " + p.charname);

    // Equipamentos no formato JSON: {"slot": "item_name", ...}
    // Exemplo: {"arma": "espada_ferro", "armadura": "colete_kevlar", "capacete": "capacete_policia"}

    if(equipment_json == "" || equipment_json == "{}") {
        debug_log("Equipamentos vazios para " + p.charname);
        return;
    }

    // Parsing simples de JSON (similar ao inventário)
    equipment_json = equipment_json.substr(1, equipment_json.length() - 2);
    string[] equipments = equipment_json.split(",");

    for(uint i = 0; i < equipments.length(); i++) {
        string[] parts = equipments[i].split(":");
        if(parts.length() >= 2) {
            string slot = parts[0].trim_whitespace();
            slot = slot.substr(1, slot.length() - 2); // Remover aspas

            string item = parts[1].trim_whitespace();
            item = item.substr(1, item.length() - 2); // Remover aspas

            // Aplicar equipamento baseado no slot
            apply_equipment_to_player(p, slot, item);
            debug_log("  + Equipado: " + item + " em " + slot);
        }
    }

    debug_log("✓ Equipamentos carregados");
}

void apply_equipment_to_player(player@ p, string slot, string item_name) {
    // Aplicar equipamento baseado no slot
    // Esta função deve marcar as flags corretas no player baseado no item

    if(slot == "colete" || slot == "armadura") {
        if(item_name.find_first("kevlar") >= 0 || item_name.find_first("balas") >= 0) {
            p.colete_aprova_de_balas = 1;
        } else if(item_name.find_first("salva_vida") >= 0 || item_name.find_first("salvavida") >= 0) {
            p.coletesalvavida = 1;
        } else if(item_name.find_first("militar") >= 0) {
            p.coletemilitar = 1;
        } else if(item_name.find_first("camuflado") >= 0) {
            p.coletecamuflado = 1;
        } else if(item_name.find_first("mizuno") >= 0) {
            p.coletemizuno = 1;
        }
    } else if(slot == "capacete" || slot == "head") {
        if(item_name.find_first("policia") >= 0) {
            p.capacetepolicia = 1;
        } else if(item_name.find_first("panama") >= 0) {
            p.chapeupanama = 1;
        } else if(item_name.find_first("bone") >= 0 && item_name.find_first("mizuno") >= 0) {
            p.bonemizuno = 1;
        }
    } else if(slot == "calca" || slot == "legs") {
        if(item_name.find_first("jeans") >= 0) {
            p.calcajeans = 1;
        } else if(item_name.find_first("legging") >= 0) {
            p.calcalegging = 1;
        } else if(item_name.find_first("camuflada") >= 0) {
            p.calcacamuflada = 1;
        } else if(item_name.find_first("mizuno") >= 0) {
            p.calcamizuno = 1;
        }
    } else if(slot == "sapato" || slot == "feet") {
        if(item_name.find_first("nike") >= 0) {
            p.tenisnike = 1;
        } else if(item_name.find_first("adidas") >= 0) {
            p.tenisadidas = 1;
        } else if(item_name.find_first("coturno") >= 0) {
            p.coturnomilitar = 1;
        } else if(item_name.find_first("magnetico") >= 0) {
            p.sapatomagnetico = 1;
        } else if(item_name.find_first("scarpin") >= 0) {
            p.sapatoscarpin = 1;
        } else if(item_name.find_first("bota") >= 0 && item_name.find_first("mizuno") >= 0) {
            p.botamizuno = 1;
        }
    } else if(slot == "luvas" || slot == "hands") {
        p.luvas = 1;
    } else if(slot == "escudo" || slot == "shield") {
        p.escudo = 1;
    } else if(slot == "pulseira" || slot == "bracelet") {
        if(item_name.find_first("ouro") >= 0) {
            p.pulseiraouro = 1;
        } else if(item_name.find_first("prata") >= 0) {
            p.pulseiraprata = 1;
        } else if(item_name.find_first("bronze") >= 0) {
            p.pulseirabronze = 1;
        } else {
            p.pulseira = 1;
        }
    } else if(slot == "anel" || slot == "ring") {
        p.anel = 1;
    } else if(slot == "bracadeira" || slot == "bracer") {
        p.bracadeira = 1;
    } else if(slot == "caneleira" || slot == "shin_guard") {
        if(item_name.find_first("metal") >= 0) {
            p.caneleirametal = 1;
        } else if(item_name.find_first("madeira") >= 0) {
            p.caneleiramadeira = 1;
        }
    }

    // Recalcular proteção total das roupas
    recalculate_clothing_protection(p);
}

void recalculate_clothing_protection(player@ p) {
    // Recalcular proteção total baseada nos equipamentos
    p.clothing_protection = 0;

    // Cada peça contribui com uma porcentagem
    if(p.colete_aprova_de_balas == 1) p.clothing_protection += 30;
    else if(p.coletemilitar == 1) p.clothing_protection += 25;
    else if(p.coletemizuno == 1) p.clothing_protection += 20;
    else if(p.coletecamuflado == 1) p.clothing_protection += 20;

    if(p.capacetepolicia == 1) p.clothing_protection += 15;
    if(p.escudo == 1) p.clothing_protection += 10;
    if(p.luvas == 1) p.clothing_protection += 5;
    if(p.caneleirametal == 1) p.clothing_protection += 10;
    else if(p.caneleiramadeira == 1) p.clothing_protection += 5;

    // Limite máximo de 90% de proteção
    if(p.clothing_protection > 90) p.clothing_protection = 90;

    debug_log("Proteção total de " + p.charname + ": " + p.clothing_protection + "%");
}

