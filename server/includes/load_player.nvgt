
bool load_player_data_complete(player@ p) {
    if(!database_initialized || p is null) {
        debug_log("ERRO: load_player_data_complete - Banco não inicializado ou player nulo");
        return false;
    }

    debug_log("=== Carregando dados completos de " + p.charname + " ===");

    string query = """
        SELECT
            level, experience, gold, hp, max_hp, mp, max_mp, race,
            map_name, x, y, z, is_admin, gender,
            inventory, equipment,
            stryx, creditos, saldo, gcoins, greais,
            kills, deaths, play_time,
            arena_wins, arena_kills,
            bounty_on_head, bounty_value, bounty_owner,
            title, rank,
            last_login, created_at,
            xp_requerida, matou, reencarnacoes,
            stamina, fome, sanity, radiation,
            voice_id, idioma_chat,
            guild_id, party_id
        FROM players
        WHERE username = ?;
    """;

    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) {
        debug_log("ERRO ao preparar query load_player_data_complete: " + bancoJogo.get_last_error_text());
        return false;
    }

    stmt.bind_text(1, p.charname);

    if(stmt.step() == SQLITE_ROW) {
        int col = 0;

        p.player_level = stmt.column_int(col++);
        p.level = p.player_level;
        p.exp = stmt.column_int(col++);
        p.xp = p.exp;
        p.gold = stmt.column_int(col++);
        p.saldo = p.gold;
        p.hp = stmt.column_int(col++);
        p.max_hp = stmt.column_int(col++);
        p.mp = stmt.column_int(col++);
        p.max_mp = stmt.column_int(col++);
        p.race = stmt.column_text(col++);

        p.map = stmt.column_text(col++);
        p.map_name = p.map;
        p.mapaatual = p.map;
        p.x = stmt.column_int(col++);
        p.y = stmt.column_int(col++);
        p.z = stmt.column_int(col++);

        p.admin_status = (stmt.column_int(col++) == 1);
        p.is_admin = p.admin_status;
        p.admin = p.admin_status;

        p.sexo = stmt.column_int(col++);
        p.sexo2 = (p.sexo == 0 ? "o" : "a");

        string inventory_json = stmt.column_text(col++);
        string equipment_json = stmt.column_text(col++);

        p.stryx = stmt.column_double(col++);
        p.creditos = stmt.column_double(col++);
        p.saldo = stmt.column_double(col++);
        p.gcoins = stmt.column_int(col++);
        p.greais = stmt.column_int(col++);

        p.kills = stmt.column_int(col++);
        p.matou = p.kills;
        p.deaths = stmt.column_int(col++);
        p.playtime = stmt.column_double(col++);

        p.arena_wins = stmt.column_int(col++);
        p.arena_kills = stmt.column_int(col++);

        p.bounty_on_head = stmt.column_int(col++);
        p.bounty_value = stmt.column_int(col++);
        p.bounty_owner = stmt.column_text(col++);

        p.title = stmt.column_text(col++);
        p.rank = stmt.column_int(col++);

        p.last_login_at = stmt.column_text(col++);
        p.created_at = stmt.column_text(col++);

        p.xprequerida = stmt.column_int(col++);
        p.matou = stmt.column_int(col++);
        p.reencarnou = stmt.column_int(col++);

        p.stamina = stmt.column_int(col++);
        p.fome = stmt.column_int(col++);
        p.sanity = stmt.column_double(col++);
        p.radiation = stmt.column_int(col++);

        p.voice_id = stmt.column_text(col++);
        p.idiomachat = stmt.column_text(col++);

        int guild_id = stmt.column_int(col++);
        int party_id = stmt.column_int(col++);

        p.health = p.hp;
        p.maxhealth = p.max_hp;

        debug_log("✓ Dados básicos carregados para " + p.charname);

        if(inventory_json != "" && inventory_json != "{}") {
            load_player_inventory(p, inventory_json);
        } else {
            debug_log(" Inventário vazio para " + p.charname + ", aplicando inventário padrão...");
            string default_inv = get_default_inventory_json();
            load_player_inventory(p, default_inv);
            save_player_inventory_to_db(p);
        }

        if(equipment_json != "" && equipment_json != "{}") {
            load_player_equipment(p, equipment_json);
        }

        load_player_guild(p, guild_id);
        load_player_party(p, party_id);

        return true;
    }

    debug_log("ERRO: Jogador " + p.charname + " não encontrado no banco de dados");
    return false;
}

bool load_player_inventory_from_database(player@ p, bool allow_legacy_file_fallback = false) {
    if(@p == null || !database_initialized) return false;

    string query = "SELECT inventory FROM players WHERE username = ?;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) return false;

    stmt.bind_text(1, p.charname);
    if(stmt.step() == SQLITE_ROW) {
        string inventory_json = stmt.column_text(0);

        p.inv.delete_all();
        if(inventory_json != "" && inventory_json != "{}") {
            load_player_inventory(p, inventory_json);
            return true;
        }

        if(!allow_legacy_file_fallback) {
            return false;
        }
    } else {
        return false;
    }

    string legacy_path = "players/" + p.charname + "/inv.md";
    if(!file_exists(legacy_path)) {
        return false;
    }

    file f;
    if(!f.open(legacy_path, "r")) {
        return false;
    }

    string[] lines = delinear(f.read());
    f.close();

    int loaded = 0;
    for(uint i = 0; i < lines.length(); i++) {
        if(lines[i] == "") continue;
        string[] data = string_split(lines[i], "=", true);
        if(data.length() != 2) continue;

        int qty = string_to_number(data[1]);
        if(qty <= 0) continue;

        p.inv.set(data[0], qty);
        loaded++;
    }

    if(loaded > 0) {
        save_player_inventory_to_db(p);
        debug_log("MIGRATION: inventario legado migrado para DB: " + p.charname + " (" + loaded + " itens)");
        return true;
    }

    return false;
}
string json_escape_string(const string&in input) {
    string output = "";
    for(uint i = 0; i < input.length(); i++) {
        string ch = input.substr(i, 1);
        if(ch == "\\") output += "\\\\";
        else if(ch == "\"") output += "\\\"";
        else if(ch == "\n") output += "\\n";
        else if(ch == "\r") output += "\\r";
        else if(ch == "\t") output += "\\t";
        else output += ch;
    }
    return output;
}

string json_unescape_string(const string&in input) {
    string output = "";
    bool escaping = false;
    for(uint i = 0; i < input.length(); i++) {
        string ch = input.substr(i, 1);
        if(escaping) {
            if(ch == "n") output += "\n";
            else if(ch == "r") output += "\r";
            else if(ch == "t") output += "\t";
            else output += ch;
            escaping = false;
            continue;
        }
        if(ch == "\\") {
            escaping = true;
            continue;
        }
        output += ch;
    }
    if(escaping) output += "\\";
    return output;
}

string[] parse_simple_json_object_entries(const string&in object_inner) {
    string[] entries;
    string current = "";
    bool in_quotes = false;
    bool escaping = false;

    for(uint i = 0; i < object_inner.length(); i++) {
        string ch = object_inner.substr(i, 1);
        if(escaping) {
            current += ch;
            escaping = false;
            continue;
        }
        if(ch == "\\") {
            current += ch;
            escaping = true;
            continue;
        }
        if(ch == "\"") {
            in_quotes = !in_quotes;
            current += ch;
            continue;
        }
        if(ch == "," && !in_quotes) {
            entries.insert_last(current.trim_whitespace());
            current = "";
            continue;
        }
        current += ch;
    }

    string tail = current.trim_whitespace();
    if(tail != "") entries.insert_last(tail);
    return entries;
}

void load_player_inventory(player@ p, string inventory_json) {
    debug_log("Carregando inventario de " + p.charname);

    if(inventory_json == "" || inventory_json == "{}") {
        debug_log("Inventario vazio para " + p.charname);
        return;
    }

    if(inventory_json.length() < 2 || inventory_json[0] != '{' || inventory_json[inventory_json.length() - 1] != '}') {
        debug_log("Inventario JSON inválido para " + p.charname + ": formato inesperado");
        return;
    }

    inventory_json = inventory_json.substr(1, inventory_json.length() - 2);
    if(inventory_json.trim_whitespace() == "") {
        debug_log("Inventario vazio para " + p.charname);
        return;
    }

    string[] items = parse_simple_json_object_entries(inventory_json);
    for(uint i = 0; i < items.length(); i++) {
        string entry = items[i].trim_whitespace();
        if(entry == "") continue;

        int sep = entry.find_first(":");
        if(sep <= 0) continue;

        string key_raw = entry.substr(0, sep).trim_whitespace();
        string val_raw = entry.substr(sep + 1).trim_whitespace();
        if(key_raw.length() < 2 || key_raw[0] != '"' || key_raw[key_raw.length() - 1] != '"') continue;

        string item_name = json_unescape_string(key_raw.substr(1, key_raw.length() - 2));
        int quantidade = string_to_number(val_raw);
        if(item_name == "" || quantidade <= 0) continue;

        p.inv.set(item_name, quantidade);
        debug_log("  + " + item_name + " x" + quantidade);
    }

    debug_log("Inventario carregado: " + p.inv.get_keys().length() + " tipos de itens");
}

void save_player_inventory_to_db(player@ p) {
    if(@p == null) return;

    string json = "{";
    string[] keys = p.inv.get_keys();
    bool first = true;
    for(uint i = 0; i < keys.length(); i++) {
        int qty = 0;
        p.inv.get(keys[i], qty);
        if(qty <= 0) continue;

        if(!first) json += ",";
        first = false;
        json += "\"" + json_escape_string(keys[i]) + "\":" + qty;
    }
    json += "}";

    string query = "UPDATE players SET inventory = ? WHERE username = ?;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt != null) {
        stmt.bind_text(1, json);
        stmt.bind_text(2, p.charname);
        stmt.step();
        debug_log("Inventario salvo no banco para " + p.charname);
    }
}

string build_player_equipment_json(player@ p) {
    if(@p == null) return "{}";

    string json = "{";
    bool first = true;

    string slot_name = "";
    string item_name = "";

    if(p.colete_aprova_de_balas == 1) { slot_name = "body"; item_name = "colete_aprova_de_balas"; }
    else if(p.coletemilitar == 1) { slot_name = "body"; item_name = "coletemilitar"; }
    else if(p.coletecamuflado == 1) { slot_name = "body"; item_name = "coletecamuflado"; }
    else if(p.coletesalvavida == 1) { slot_name = "body"; item_name = "coletesalvavida"; }
    else if(p.coletemizuno == 1) { slot_name = "body"; item_name = "coletemizuno"; }
    if(slot_name != "") {
        if(!first) json += ",";
        first = false;
        json += "\"" + json_escape_string(slot_name) + "\":\"" + json_escape_string(item_name) + "\"";
        slot_name = ""; item_name = "";
    }

    if(p.capacetepolicia == 1) { slot_name = "head"; item_name = "capacete_policia"; }
    else if(p.chapeupanama == 1) { slot_name = "head"; item_name = "chapeu_panama"; }
    else if(p.bonemizuno == 1) { slot_name = "head"; item_name = "bone_mizuno"; }
    if(slot_name != "") {
        if(!first) json += ",";
        first = false;
        json += "\"" + json_escape_string(slot_name) + "\":\"" + json_escape_string(item_name) + "\"";
        slot_name = ""; item_name = "";
    }

    if(p.escudo == 1) {
        if(!first) json += ",";
        first = false;
        json += "\"shield\":\"escudo\"";
    }
    if(p.luvas == 1) {
        if(!first) json += ",";
        first = false;
        json += "\"hands\":\"luvas\"";
    }

    if(p.coturnomilitar == 1) { slot_name = "feet"; item_name = "coturno_militar"; }
    else if(p.tenisnike == 1) { slot_name = "feet"; item_name = "tenis_nike"; }
    else if(p.tenisadidas == 1) { slot_name = "feet"; item_name = "tenis_adidas"; }
    if(slot_name != "") {
        if(!first) json += ",";
        first = false;
        json += "\"" + json_escape_string(slot_name) + "\":\"" + json_escape_string(item_name) + "\"";
        slot_name = ""; item_name = "";
    }

    if(p.pulseiraouro == 1) { slot_name = "accessory_1"; item_name = "pulseira_ouro"; }
    else if(p.pulseiraprata == 1) { slot_name = "accessory_1"; item_name = "pulseira_prata"; }
    else if(p.pulseirabronze == 1) { slot_name = "accessory_1"; item_name = "pulseira_bronze"; }
    else if(p.pulseira == 1) { slot_name = "accessory_1"; item_name = "pulseira"; }
    if(slot_name != "") {
        if(!first) json += ",";
        first = false;
        json += "\"" + json_escape_string(slot_name) + "\":\"" + json_escape_string(item_name) + "\"";
        slot_name = ""; item_name = "";
    }

    if(p.anel == 1) {
        if(!first) json += ",";
        first = false;
        json += "\"accessory_2\":\"anel\"";
    }

    if(p.bracadeira == 1) {
        if(!first) json += ",";
        first = false;
        json += "\"bracadeira\":\"bracadeira\"";
    }
    if(p.caneleirametal == 1) {
        if(!first) json += ",";
        first = false;
        json += "\"caneleira\":\"caneleira_metal\"";
    } else if(p.caneleiramadeira == 1) {
        if(!first) json += ",";
        first = false;
        json += "\"caneleira\":\"caneleira_madeira\"";
    }

    json += "}";
    return json;
}

void save_player_equipment_to_db(player@ p) {
    if(@p == null || !database_initialized || bancoJogo is null) return;

    string equipment_json = build_player_equipment_json(p);
    string query = "UPDATE players SET equipment = ? WHERE username = ?;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) return;

    stmt.bind_text(1, equipment_json);
    stmt.bind_text(2, p.charname);
    stmt.step();
}

void load_player_equipment(player@ p, string equipment_json) {
    debug_log("Carregando equipamentos de " + p.charname);

    p.colete_aprova_de_balas = 0;
    p.coletemilitar = 0;
    p.coletecamuflado = 0;
    p.coletesalvavida = 0;
    p.coletemizuno = 0;
    p.capacetepolicia = 0;
    p.chapeupanama = 0;
    p.bonemizuno = 0;
    p.tenisnike = 0;
    p.tenisadidas = 0;
    p.coturnomilitar = 0;
    p.luvas = 0;
    p.escudo = 0;
    p.pulseiraouro = 0;
    p.pulseiraprata = 0;
    p.pulseirabronze = 0;
    p.pulseira = 0;
    p.anel = 0;
    p.bracadeira = 0;
    p.caneleirametal = 0;
    p.caneleiramadeira = 0;

    if(equipment_json == "" || equipment_json == "{}") {
        debug_log("Equipamentos vazios para " + p.charname);
        return;
    }

    if(equipment_json.length() < 2 || equipment_json[0] != '{' || equipment_json[equipment_json.length() - 1] != '}') {
        debug_log("Equipamentos JSON inválido para " + p.charname + ": formato inesperado");
        return;
    }

    equipment_json = equipment_json.substr(1, equipment_json.length() - 2);
    if(equipment_json.trim_whitespace() == "") {
        debug_log("Equipamentos vazios para " + p.charname);
        return;
    }

    string[] equipments = parse_simple_json_object_entries(equipment_json);
    for(uint i = 0; i < equipments.length(); i++) {
        string entry = equipments[i].trim_whitespace();
        if(entry == "") continue;

        int sep = entry.find_first(":");
        if(sep <= 0) continue;

        string slot_raw = entry.substr(0, sep).trim_whitespace();
        string item_raw = entry.substr(sep + 1).trim_whitespace();
        if(slot_raw.length() < 2 || slot_raw[0] != '"' || slot_raw[slot_raw.length() - 1] != '"') continue;
        if(item_raw.length() < 2 || item_raw[0] != '"' || item_raw[item_raw.length() - 1] != '"') continue;

        string slot = json_unescape_string(slot_raw.substr(1, slot_raw.length() - 2));
        string item = json_unescape_string(item_raw.substr(1, item_raw.length() - 2));
        if(slot == "" || item == "") continue;

        apply_equipment_to_player(p, slot, item);
        debug_log("  + Equipado: " + item + " em " + slot);
    }

    debug_log("Equipamentos carregados");
}

void apply_equipment_to_player(player@ p, string slot, string item_name) {

    slot = slot.trim_whitespace().lower();
    item_name = item_name.trim_whitespace().lower();

    if(slot == "colete" || slot == "armadura" || slot == "body") {
        if(item_name.find_first("kevlar") >= 0 || item_name.find_first("balas") >= 0) {
            p.colete_aprova_de_balas = 1;
        } else if(item_name.find_first("salva_vida") >= 0 || item_name.find_first("salvavida") >= 0) {
            p.coletesalvavida = 1;
        } else if(item_name.find_first("militar") >= 0) {
            p.coletemilitar = 1;
        } else if(item_name.find_first("camuflado") >= 0) {
            p.coletecamuflado = 1;
        } else if(item_name.find_first("mizuno") >= 0) {
            p.coletemizuno = 1;
        }
    } else if(slot == "capacete" || slot == "head") {
        if(item_name.find_first("policia") >= 0) {
            p.capacetepolicia = 1;
        } else if(item_name.find_first("panama") >= 0) {
            p.chapeupanama = 1;
        } else if(item_name.find_first("bone") >= 0 && item_name.find_first("mizuno") >= 0) {
            p.bonemizuno = 1;
        }
    } else if(slot == "calca" || slot == "legs") {
        if(item_name.find_first("jeans") >= 0) {
            p.calcajeans = 1;
        } else if(item_name.find_first("legging") >= 0) {
            p.calcalegging = 1;
        } else if(item_name.find_first("camuflada") >= 0) {
            p.calcacamuflada = 1;
        } else if(item_name.find_first("mizuno") >= 0) {
            p.calcamizuno = 1;
        }
    } else if(slot == "sapato" || slot == "feet") {
        if(item_name.find_first("nike") >= 0) {
            p.tenisnike = 1;
        } else if(item_name.find_first("adidas") >= 0) {
            p.tenisadidas = 1;
        } else if(item_name.find_first("coturno") >= 0) {
            p.coturnomilitar = 1;
        } else if(item_name.find_first("magnetico") >= 0) {
            p.sapatomagnetico = 1;
        } else if(item_name.find_first("scarpin") >= 0) {
            p.sapatoscarpin = 1;
        } else if(item_name.find_first("bota") >= 0 && item_name.find_first("mizuno") >= 0) {
            p.botamizuno = 1;
        }
    } else if(slot == "luvas" || slot == "hands") {
        p.luvas = 1;
    } else if(slot == "escudo" || slot == "shield") {
        p.escudo = 1;
    } else if(slot == "pulseira" || slot == "bracelet" || slot == "accessory_1") {
        if(item_name.find_first("ouro") >= 0) {
            p.pulseiraouro = 1;
        } else if(item_name.find_first("prata") >= 0) {
            p.pulseiraprata = 1;
        } else if(item_name.find_first("bronze") >= 0) {
            p.pulseirabronze = 1;
        } else {
            p.pulseira = 1;
        }
    } else if(slot == "anel" || slot == "ring" || slot == "accessory_2") {
        p.anel = 1;
    } else if(slot == "bracadeira" || slot == "bracer") {
        p.bracadeira = 1;
    } else if(slot == "caneleira" || slot == "shin_guard") {
        if(item_name.find_first("metal") >= 0) {
            p.caneleirametal = 1;
        } else if(item_name.find_first("madeira") >= 0) {
            p.caneleiramadeira = 1;
        }
    }

    recalculate_clothing_protection(p);
}

void recalculate_clothing_protection(player@ p) {
    p.clothing_protection = 0;

    if(p.colete_aprova_de_balas == 1) p.clothing_protection += 30;
    else if(p.coletemilitar == 1) p.clothing_protection += 25;
    else if(p.coletemizuno == 1) p.clothing_protection += 20;
    else if(p.coletecamuflado == 1) p.clothing_protection += 20;

    if(p.capacetepolicia == 1) p.clothing_protection += 15;
    if(p.escudo == 1) p.clothing_protection += 10;
    if(p.luvas == 1) p.clothing_protection += 5;
    if(p.caneleirametal == 1) p.clothing_protection += 10;
    else if(p.caneleiramadeira == 1) p.clothing_protection += 5;

    if(p.clothing_protection > 90) p.clothing_protection = 90;

    debug_log("Proteção total de " + p.charname + ": " + p.clothing_protection + "%");
}

bool validate_and_restore_location(player@ p) {
    debug_log("Validando localização de " + p.charname + " [" + p.map + " (" + p.x + "," + p.y + ")]");

    if(p.map == "" || p.map == "null") {
        debug_log(" Mapa vazio/inválido, restaurando para mapa inicial");
        p.map = mapainicial;
        p.map_name = mapainicial;
        p.mapaatual = mapainicial;
        p.x = 0;
        p.y = 0;
        p.z = 0;
    }

    int map_idx = get_map_index_from(p.map);
    if(map_idx < 0 || map_idx >= int(server_maps.length())) {
        debug_log(" Mapa '" + p.map + "' não existe, restaurando para mapa inicial");
        p.map = mapainicial;
        p.map_name = mapainicial;
        p.mapaatual = mapainicial;
        p.x = 0;
        p.y = 0;
        p.z = 0;
        map_idx = get_map_index_from(p.map);
    }

    if(map_idx < 0 || map_idx >= int(server_maps.length())) {
        debug_log("ERRO: mapa inicial inválido ao restaurar localização de " + p.charname);
        return false;
    }

    bool out_of_bounds = (p.x < 0 || p.y < 0 || p.x > server_maps[map_idx].max_x || p.y > server_maps[map_idx].max_y);
    bool blocked = !is_walkable(p.x, p.y, p.map);

    if(out_of_bounds || blocked) {
        debug_log(" Posição inválida/bloqueada para " + p.charname + ", reposicionando em (0,0)");
        p.x = 0;
        p.y = 0;
        p.z = 0;

        if(!is_walkable(p.x, p.y, p.map)) {
            p.x = 1;
            p.y = 1;
            if(!is_walkable(p.x, p.y, p.map)) {
                p.x = server_maps[map_idx].max_x / 2;
                p.y = server_maps[map_idx].max_y / 2;
            }
        }
    }

    p.mapindex = map_idx;

    debug_log("✓ Localização válida");
    return true;
}

void populate_global_structures(player@ p) {
    debug_log("Populando estruturas globais para " + p.charname);

    debug_log("✓ Estruturas globais populadas");
}

void load_player_guild(player@ p, int guild_id) {
    debug_log("Carregando guild de " + p.charname + " (ID: " + guild_id + ")");

    guild@ g = get_player_guild(p.charname);
    if(g !is null) {
        debug_log("✓ Guild vinculada: " + g.name + " [" + g.tag + "]");
        return;
    }

    for(uint i = 0; i < active_guilds.length(); i++) {
        guild@ candidate = active_guilds[i];
        if(candidate !is null && candidate.is_member(p.charname)) {
            player_guilds.set(p.charname, candidate.name);
            debug_log("✓ Guild restaurada por varredura: " + candidate.name);
            return;
        }
    }

    if(guild_id > 0 && guild_id <= int(active_guilds.length())) {
        guild@ by_id = active_guilds[guild_id - 1];
        if(by_id !is null && by_id.is_member(p.charname)) {
            player_guilds.set(p.charname, by_id.name);
            debug_log("✓ Guild restaurada por ID: " + by_id.name);
            return;
        }
    }

    debug_log("INFO: Sem guild ativa para " + p.charname + " (guild_id=" + guild_id + ")");

    debug_log("✓ Guild carregada");
}

void load_player_party(player@ p, int party_id) {
    debug_log("Carregando party de " + p.charname + " (ID: " + party_id + ")");

    party@ pty = get_player_party(p.charname);
    if(pty !is null) {
        debug_log("✓ Party já ativa para " + p.charname + " (líder: " + pty.leader + ")");
        return;
    }

    for(uint i = 0; i < active_parties.length(); i++) {
        if(active_parties[i] !is null && active_parties[i].is_member(p.charname)) {
            debug_log("✓ Party restaurada por varredura (líder: " + active_parties[i].leader + ")");
            return;
        }
    }

    if(party_id > 0 && party_id <= int(active_parties.length())) {
        party@ by_id = active_parties[party_id - 1];
        if(by_id !is null && by_id.is_member(p.charname)) {
            debug_log("✓ Party restaurada por ID (líder: " + by_id.leader + ")");
            return;
        }
    }

    debug_log("INFO: Sem party ativa para " + p.charname + " (party_id=" + party_id + ")");

    debug_log("✓ Party carregada");
}

void load_player_friends(player@ p) {
    debug_log("Carregando amigos de " + p.charname);

    load_player_friends(p.charname);

    int pindex = get_player_index_from(p.charname);
    if(pindex >= 0) {
        check_online_friends(pindex);
    }

    debug_log("✓ Lista de amigos carregada");
}

void sync_player_state_to_client(player@ p) {
    debug_log("Sincronizando estado de " + p.charname + " com o cliente");

    send_inventory_to_client(p);

    send_equipment_to_client(p);

    send_stats_to_client(p);

    send_configs_to_client(p);

    send_players(p);

    send_welcome_message(p);

    debug_log("✓ Estado sincronizado com o cliente");
}

void send_players(player@ p, bool to_others = true) {
    int mapindex = p.mapindex;
    if(mapindex < 0 || mapindex >= int(server_maps.length())) {
        debug_log("AVISO: send_players - mapindex inválido para " + p.charname);
        return;
    }

    string final = "set_map_players ";
    int count = 0;

    for(uint x = 0; x < server_maps[mapindex].mapplayers.length(); x++) {
        int pindex = server_maps[mapindex].mapplayers[x];
        if(pindex >= 0 && pindex < int(players.length())) {
            final += players[pindex].charname + " ";
            final += players[pindex].x + " ";
            final += players[pindex].y + " ";
            final += players[pindex].bipar + " ";
            final += players[pindex].pacifico + " ";
            final += players[pindex].peer_id + "\r\n";
            count++;
        }
    }

    if(count == 0) {
        final = "set_map_players none";
    }

    send_reliable_text(p.peer_id, final, 6);
    debug_log("  ✓ Lista de jogadores enviada (" + count + " jogadores no mapa)");

    if(to_others && mapindex >= 0) {
        string add_packet = "add_player_to_map " + p.charname + " " + p.x + " " + p.y + " " + p.bipar + " " + p.pacifico + " " + p.peer_id;
        server_maps[mapindex].send_to_others(p.peer_id, 6, add_packet, true);
    }
}

void send_inventory_to_client(player@ p) {
    string[] keys = p.inv.get_keys();

    if(keys.length() == 0) {
        debug_log("   Inventário vazio para " + p.charname);
        return;
    }

    string inv_packet = "setinv ";
    for(uint i = 0; i < keys.length(); i++) {
        string item_name = keys[i];
        int quantidade = 0;
        p.inv.get(item_name, quantidade);

        if(quantidade > 0) {
            inv_packet += item_name + "=" + quantidade + "\r\n";
        }
    }

    send_reliable_text(p.peer_id, inv_packet, 0);
    debug_log("  ✓ Inventário enviado (" + keys.length() + " itens)");
}

void send_item_update_to_client(player@ p, string item_name, int quantidade) {
    if(@p == null) return;
    string packet = "inv " + item_name + "=" + quantidade + "\r\n";
    send_reliable_text(p.peer_id, packet, 0);
}

void send_equipment_to_client(player@ p) {
    string[] equipped;

    if(p.colete_aprova_de_balas == 1) equipped.insert_last("colete_aprova_de_balas");
    else if(p.coletemilitar == 1) equipped.insert_last("coletemilitar");
    else if(p.coletecamuflado == 1) equipped.insert_last("coletecamuflado");
    else if(p.coletesalvavida == 1) equipped.insert_last("coletesalvavida");
    else if(p.coletemizuno == 1) equipped.insert_last("coletemizuno");

    if(p.capacetepolicia == 1) equipped.insert_last("capacete_policia");
    if(p.escudo == 1) equipped.insert_last("escudo");
    if(p.luvas == 1) equipped.insert_last("luvas");
    if(p.coturnomilitar == 1) equipped.insert_last("coturno_militar");

    recalculate_clothing_protection(p);

    string equipment_csv = "";
    for(uint i = 0; i < equipped.length(); i++) {
        if(i > 0) equipment_csv += ",";
        equipment_csv += equipped[i];
    }
    send_reliable_text(p.peer_id, "setequipment " + equipment_csv, 0);

    debug_log("  ✓ Equipamentos enviados");
}

void send_stats_to_client(player@ p) {
    string stats_packet = "stats|";
    stats_packet += p.health + "|";
    stats_packet += p.maxhealth + "|";
    stats_packet += p.stamina + "|";
    stats_packet += p.exp + "|";
    stats_packet += p.xprequerida + "|";
    stats_packet += p.level + "|";
    stats_packet += p.gold;

    send_reliable_text(p.peer_id, stats_packet, 0);

    debug_log("  ✓ Stats enviados");
}

void send_configs_to_client(player@ p) {
    if(p.idiomachat == "" || p.idiomachat == "null") {
        p.idiomachat = "pt";
    }

    if(p.voice < 0) {
        p.voice = 1;
    }

    if(p.voice_id == "" || p.voice_id == "null") {
        p.voice_id = "default";
    }

    send_reliable_text(p.peer_id, "setconfig " + p.idiomachat + "|" + p.voice + "|" + p.voice_id, 0);

    debug_log("  ✓ Configurações enviadas");
}

void send_welcome_message(player@ p) {
    string welcome = "Bem-vindo de volta, " + p.charname + "!";

    send_reliable_text(p.peer_id, "say " + welcome, 0);
    if(p.last_login_at != "" && p.last_login_at != "null") {
        send_reliable_text(p.peer_id, "say Último login: " + p.last_login_at, 0);
    }

    send_reliable_text(p.peer_id, "say Nível: " + p.level + " | XP: " + p.exp + "/" + p.xprequerida, 0);
    send_reliable_text(p.peer_id, "say Ouro: " + p.gold + " | Stryx: " + p.stryx, 0);

    debug_log("  ✓ Mensagem de boas-vindas enviada");
}

void register_player_timers(player@ p) {
    debug_log("Registrando timers pessoais de " + p.charname);

    p.playtimer.restart();
    p.safetimer.restart();
    p.pingtimer.restart();
    p.afksecondtimer.restart();

    debug_log("✓ Timers registrados");
}

bool load_player_complete(player@ p) {
    if(p is null) {
        debug_log("ERRO: load_player_complete - player é nulo");
        return false;
    }

    debug_log("╔════════════════════════════════════════════════════════════╗");
    debug_log("║     CARREGAMENTO COMPLETO DE JOGADOR: " + p.charname);
    debug_log("╚════════════════════════════════════════════════════════════╝");

    if(!load_player_data_complete(p)) {
        debug_log("✗ FALHA NO PASSO 1: Carregamento de dados");
        return false;
    }

    if(!validate_and_restore_location(p)) {
        debug_log("✗ FALHA NO PASSO 3: Validação de localização");
        return false;
    }

    populate_global_structures(p);

    load_player_friends(p);

    sync_player_state_to_client(p);

    register_player_timers(p);

    debug_log("╔════════════════════════════════════════════════════════════╗");
    debug_log("║     ✓✓✓ JOGADOR CARREGADO COM SUCESSO ✓✓✓                 ║");
    debug_log("║     " + p.charname + " está pronto para jogar!");
    debug_log("╚════════════════════════════════════════════════════════════╝");

    return true;
}
