// ============================================================
// 6. SINCRONIZAR ESTADO COM O CLIENTE
// ============================================================

void sync_player_state_to_client(player@ p) {
    debug_log("Sincronizando estado de " + p.charname + " com o cliente");

    // Enviar inventário
    send_inventory_to_client(p);

    // Enviar equipamentos
    send_equipment_to_client(p);

    // Enviar stats (vida, stamina, xp)
    send_stats_to_client(p);

    // Enviar configurações
    send_configs_to_client(p);

    // Enviar lista de jogadores no mapa
    send_players(p);

    // Enviar mensagem de boas-vindas
    send_welcome_message(p);

    debug_log("✓ Estado sincronizado com o cliente");
}

// Enviar lista de jogadores no mapa para o cliente (compatibilidade BGT)
void send_players(player@ p, bool to_others = true) {
    // Encontrar índice do mapa do jogador
    int mapindex = p.mapindex;
    if(mapindex < 0 || mapindex >= int(server_maps.length())) {
        debug_log("AVISO: send_players - mapindex inválido para " + p.charname);
        return;
    }
    
    // Construir lista de jogadores no mapa
    string final = "set_map_players ";
    int count = 0;
    
    for(uint x = 0; x < server_maps[mapindex].mapplayers.length(); x++) {
        int pindex = server_maps[mapindex].mapplayers[x];
        if(pindex >= 0 && pindex < int(players.length())) {
            final += players[pindex].charname + " ";
            final += players[pindex].x + " ";
            final += players[pindex].y + " ";
            final += players[pindex].bipar + " ";
            final += players[pindex].pacifico + " ";
            final += players[pindex].peer_id + "\r\n";
            count++;
        }
    }
    
    // Se não há jogadores, enviar "none"
    if(count == 0) {
        final = "set_map_players none";
    }
    
    send_reliable(p.peer_id, final, 6);
    debug_log("  ✓ Lista de jogadores enviada (" + count + " jogadores no mapa)");
    
    // Notificar outros jogadores no mapa
    if(to_others && mapindex >= 0) {
        string add_packet = "add_player_to_map " + p.charname + " " + p.x + " " + p.y + " " + p.bipar + " " + p.pacifico + " " + p.peer_id;
        server_maps[mapindex].send_to_others(p.peer_id, 6, add_packet, true);
    }
}

void send_inventory_to_client(player@ p) {
    // Enviar cada item do inventário para o cliente
    string[] keys = p.inv.get_keys();

    for(uint i = 0; i < keys.length(); i++) {
        string item_name = keys[i];
        int quantidade = 0;
        p.inv.get(item_name, quantidade);

        // Pacote: "inv|item_name|quantidade"
        send_reliable(p.peer_id, "inv|" + item_name + "|" + quantidade, 0);
    }

    debug_log("  ✓ Inventário enviado (" + keys.length() + " itens)");
}

