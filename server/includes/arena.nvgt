
enum arena_mode {
	MODE_FFA,
	MODE_TEAM,
	MODE_ELIMINATION,
	MODE_CAPTURE
}

class arena {
	string map_name;
	int x_spawn;
	int y_spawn;
	int max_players;
	bool active;
	string[] players_in_arena;
	timer match_timer;
	int match_duration;
	bool match_started;
	arena_mode mode;
	int min_players;

	dictionary scores;
	dictionary team_scores;

	int xp_reward_winner = 500;
	int gold_reward_winner = 100;
	int xp_reward_participant = 100;
	int gold_reward_participant = 20;

	arena(string map, int x, int y, int max_p = 10, int duration = 300000, arena_mode game_mode = MODE_FFA) {
		map_name = map;
		x_spawn = x;
		y_spawn = y;
		max_players = max_p;
		active = false;
		match_duration = duration;
		match_started = false;
		mode = game_mode;
		min_players = 2;
	}

	void add_score(string player_name, int points) {
		if(scores.exists(player_name)) {
			int current = int(scores[player_name]);
			scores.set(player_name, current + points);
		} else {
			scores.set(player_name, points);
		}
	}

	int get_score(string player_name) {
		if(scores.exists(player_name)) {
			return int(scores[player_name]);
		}
		return 0;
	}

	string get_winner() {
		string winner = "";
		int highest_score = 0;

		string[]@ keys = scores.get_keys();
		for(uint i = 0; i < keys.length(); i++) {
			int score = int(scores[keys[i]]);
			if(score > highest_score) {
				highest_score = score;
				winner = keys[i];
			}
		}

		return winner;
	}

	void reset_scores() {
		scores.delete_all();
		team_scores.delete_all();
	}
}

arena@[] arenas;

// De onde cada lutador veio (nome -> mapa / x / y), para devolve-lo depois.
dictionary arena_retorno_mapa;
dictionary arena_retorno_x;
dictionary arena_retorno_y;

const int ARENA_ESPALHAMENTO = 10;

void create_arena(string map_name, int x, int y, int max_players = 10, int duration = 300000) {
	arena a(map_name, x, y, max_players, duration);
	arenas.insert_last(a);
}

bool add_player_to_arena(int arena_index, int player_index) {
	if(arena_index < 0 || arena_index >= int(arenas.length())) {
		return false;
	}

	if(player_index < 0 || player_index >= int(players.length())) {
		return false;
	}

	if(int(arenas[arena_index].players_in_arena.length()) >= arenas[arena_index].max_players) {
		send_reliable_text(players[player_index].peer_id,
			"msg2 A arena está cheia!", 0);
		return false;
	}

	for(uint i = 0; i < arenas[arena_index].players_in_arena.length(); i++) {
		if(arenas[arena_index].players_in_arena[i] == players[player_index].charname) {
			return false;
		}
	}

	int mapa_arena = get_map_index_from(arenas[arena_index].map_name);
	if(mapa_arena < 0) {
		send_reliable_text(players[player_index].peer_id,
			"msg2 ;A arena não está disponível no momento.;", 0);
		return false;
	}

	arenas[arena_index].players_in_arena.insert_last(players[player_index].charname);

	// Guarda de onde o jogador veio para devolve-lo ao fim da partida.
	string nome = players[player_index].charname;
	arena_retorno_mapa.set(nome, players[player_index].map);
	arena_retorno_x.set(nome, players[player_index].x);
	arena_retorno_y.set(nome, players[player_index].y);

	// Os lutadores nao nascem todos no mesmo ponto.
	int chegada_x = arenas[arena_index].x_spawn + random(-ARENA_ESPALHAMENTO, ARENA_ESPALHAMENTO);
	if(chegada_x < 0) chegada_x = 0;
	if(server_maps[mapa_arena].max_x > 0 && chegada_x > server_maps[mapa_arena].max_x) chegada_x = server_maps[mapa_arena].max_x;

	players[player_index].in_arena = 1;
	players[player_index].maparena = arenas[arena_index].map_name;
	players[player_index].xarena = chegada_x;
	players[player_index].yarena = arenas[arena_index].y_spawn;

	move_player_to_map(player_index, arenas[arena_index].map_name, chegada_x, arenas[arena_index].y_spawn);
	players[player_index].map_name = arenas[arena_index].map_name;
	players[player_index].mapaatual = arenas[arena_index].map_name;

	send_reliable_text(players[player_index].peer_id,
		"msg2 Você entrou na arena! Aguarde o início da partida.", 0);

	return true;
}

bool remove_player_from_arena(int arena_index, int player_index) {
	if(arena_index < 0 || arena_index >= int(arenas.length())) {
		return false;
	}

	if(player_index < 0 || player_index >= int(players.length())) {
		return false;
	}

	for(uint i = 0; i < arenas[arena_index].players_in_arena.length(); i++) {
		if(arenas[arena_index].players_in_arena[i] == players[player_index].charname) {
			arenas[arena_index].players_in_arena.remove_at(i);
			break;
		}
	}

	string mapa_da_arena = arenas[arena_index].map_name;

	players[player_index].in_arena = 0;
	players[player_index].maparena = "";
	players[player_index].xarena = 0;
	players[player_index].yarena = 0;

	string nome = players[player_index].charname;
	string volta_mapa = "";
	int volta_x = 1;
	int volta_y = 0;
	if(arena_retorno_mapa.exists(nome)) {
		arena_retorno_mapa.get(nome, volta_mapa);
		arena_retorno_x.get(nome, volta_x);
		arena_retorno_y.get(nome, volta_y);
		arena_retorno_mapa.delete(nome);
		arena_retorno_x.delete(nome);
		arena_retorno_y.delete(nome);
	}

	// Quem morreu na arena ja e levado embora pelo fluxo de morte; so os vivos
	// que ainda estao no mapa da arena voltam para onde estavam.
	if(players[player_index].health > 0 && players[player_index].map == mapa_da_arena) {
		if(volta_mapa == "" || get_map_index_from(volta_mapa) < 0) {
			volta_mapa = mapainicial;
			volta_x = 1;
			volta_y = 0;
		}

		move_player_to_map(player_index, volta_mapa, volta_x, volta_y);
		players[player_index].map_name = volta_mapa;
		players[player_index].mapaatual = volta_mapa;
	}

	return true;
}

bool start_arena_match(int arena_index) {
	if(arena_index < 0 || arena_index >= int(arenas.length())) {
		return false;
	}

	if(arenas[arena_index].players_in_arena.length() < 2) {
		return false;
	}

	arenas[arena_index].match_started = true;
	arenas[arena_index].match_timer.restart();

	for(uint i = 0; i < arenas[arena_index].players_in_arena.length(); i++) {
		int player_idx = get_player_index_from(arenas[arena_index].players_in_arena[i]);
		if(player_idx > -1) {
			send_reliable_text(players[player_idx].peer_id,
				"msg2 A partida começou! Boa sorte!", 0);
			send_reliable_text(players[player_idx].peer_id, "ps arena_start.ogg", 0);
		}
	}

	return true;
}

void end_arena_match(int arena_index) {
	if(arena_index < 0 || arena_index >= int(arenas.length())) {
		return;
	}

	arenas[arena_index].match_started = false;

	give_arena_rewards(arena_index);

	// remove_player_from_arena() mexe em players_in_arena: percorre uma copia.
	string[] lutadores = arenas[arena_index].players_in_arena;
	for(uint i = 0; i < lutadores.length(); i++) {
		int player_idx = get_player_index_from(lutadores[i]);
		if(player_idx > -1) {
			remove_player_from_arena(arena_index, player_idx);
			send_reliable_text(players[player_idx].peer_id,
				"msg2 A partida terminou!", 0);
		}
	}

	arenas[arena_index].players_in_arena.resize(0);

	// Com a arena livre, quem ficou esperando na fila entra.
	try_create_match();
}

// Tira da partida quem desconectou ou ja saiu da arena por outro caminho.
void arena_remover_ausentes(int arena_index) {
	if(arena_index < 0 || arena_index >= int(arenas.length())) return;

	for(int i = int(arenas[arena_index].players_in_arena.length()) - 1; i >= 0; i--) {
		int player_idx = get_player_index_from(arenas[arena_index].players_in_arena[i]);
		if(player_idx < 0 || players[player_idx].in_arena == 0) {
			arenas[arena_index].players_in_arena.remove_at(i);
		}
	}
}

void arena_loop() {
	for(uint i = 0; i < arenas.length(); i++) {
		if(arenas[i].match_started) {
			arena_remover_ausentes(i);

			if(arenas[i].match_timer.elapsed >= arenas[i].match_duration) {
				end_arena_match(i);
				continue;
			}

			if(arenas[i].players_in_arena.length() <= 1) {
				if(arenas[i].players_in_arena.length() == 1) {
					int winner_idx = get_player_index_from(arenas[i].players_in_arena[0]);
					if(winner_idx > -1) {
						send_reliable_text(players[winner_idx].peer_id,
							"msg2 Você venceu a partida de arena!", 0);
						send_reliable_text(players[winner_idx].peer_id, "ps victory.ogg", 0);
					}
				}
				end_arena_match(i);
			}
		}
	}
}

int get_arena_index(string map_name) {
	for(uint i = 0; i < arenas.length(); i++) {
		if(arenas[i].map_name == map_name) {
			return i;
		}
	}
	return -1;
}

string[] matchmaking_queue;

void add_to_matchmaking(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) return;

	string player_name = players[player_index].charname;

	for(uint i = 0; i < matchmaking_queue.length(); i++) {
		if(matchmaking_queue[i] == player_name) {
			send_reliable_text(players[player_index].peer_id,
				"msg2 Você já está na fila de matchmaking!", 0);
			return;
		}
	}

	matchmaking_queue.insert_last(player_name);
	send_reliable_text(players[player_index].peer_id,
		"msg2 Você entrou na fila de matchmaking. Aguarde um oponente...", 0);

	try_create_match();
}

void remove_from_matchmaking(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) return;

	string player_name = players[player_index].charname;

	for(uint i = 0; i < matchmaking_queue.length(); i++) {
		if(matchmaking_queue[i] == player_name) {
			matchmaking_queue.remove_at(i);
			send_reliable_text(players[player_index].peer_id,
				"msg2 Você saiu da fila de matchmaking.", 0);
			return;
		}
	}
}

void try_create_match() {
	if(matchmaking_queue.length() < 2) return;

	// Quem desconectou enquanto esperava sai da fila.
	for(int i = int(matchmaking_queue.length()) - 1; i >= 0; i--) {
		if(get_player_index_from(matchmaking_queue[i]) < 0) matchmaking_queue.remove_at(i);
	}
	if(matchmaking_queue.length() < 2) return;

	// O local da arena vem da tabela arena_config (gravada por /setarena).
	string cfg_mapa = "";
	int cfg_x = 0;
	int cfg_y = 0;
	int cfg_max = 10;
	int cfg_duracao = 300000;
	if(!arena_carregar_config(cfg_mapa, cfg_x, cfg_y, cfg_max, cfg_duracao)) return;

	int arena_index = get_arena_index(cfg_mapa);
	if(arena_index == -1) {
		create_arena(cfg_mapa, cfg_x, cfg_y, cfg_max, cfg_duracao);
		arena_index = int(arenas.length()) - 1;
	}

	// Uma partida por vez no mesmo local: a fila espera a atual terminar.
	if(arenas[arena_index].match_started || arenas[arena_index].players_in_arena.length() > 0) return;

	arenas[arena_index].x_spawn = cfg_x;
	arenas[arena_index].y_spawn = cfg_y;
	arenas[arena_index].max_players = cfg_max;
	arenas[arena_index].match_duration = cfg_duracao;
	arenas[arena_index].reset_scores();

	int players_to_add = (int(matchmaking_queue.length()) < arenas[arena_index].max_players)
	                     ? int(matchmaking_queue.length())
	                     : int(arenas[arena_index].max_players);

	for(int i = 0; i < players_to_add; i++) {
		int player_idx = get_player_index_from(matchmaking_queue[0]);
		if(player_idx > -1) {
			add_player_to_arena(arena_index, player_idx);
		}
		matchmaking_queue.remove_at(0);
	}

	if(int(arenas[arena_index].players_in_arena.length()) >= arenas[arena_index].min_players) {
		start_arena_match(arena_index);
	}
	else {
		// Nao sobrou gente suficiente: devolve quem ja tinha entrado.
		string[] lutadores = arenas[arena_index].players_in_arena;
		for(uint i = 0; i < lutadores.length(); i++) {
			int player_idx = get_player_index_from(lutadores[i]);
			if(player_idx > -1) remove_player_from_arena(arena_index, player_idx);
		}
		arenas[arena_index].players_in_arena.resize(0);
	}
}

bool arena_esta_na_fila(string player_name) {
	for(uint i = 0; i < matchmaking_queue.length(); i++) {
		if(matchmaking_queue[i] == player_name) return true;
	}
	return false;
}

// ---------------------------------------------------------------------------
// Local da arena no SQLite (tabela arena_config, uma linha so). A tabela e
// criada no primeiro uso, entao nao depende de chamada de init.
// ---------------------------------------------------------------------------

bool arena_tabela_pronta = false;

bool arena_garantir_tabela() {
	if(arena_tabela_pronta) return true;
	if(!database_initialized || bancoJogo is null) return false;

	string create_arena_config = """
		CREATE TABLE IF NOT EXISTS arena_config (
			id INTEGER PRIMARY KEY CHECK (id = 1),
			mapa TEXT NOT NULL,
			x INTEGER DEFAULT 0,
			y INTEGER DEFAULT 0,
			max_jogadores INTEGER DEFAULT 10,
			duracao_ms INTEGER DEFAULT 300000
		);
	""";

	if(bancoJogo.execute(create_arena_config) != SQLITE_OK) {
		debug_log("ERRO ao criar tabela arena_config: " + bancoJogo.get_last_error_text());
		return false;
	}

	arena_tabela_pronta = true;
	return true;
}

// Devolve false quando nao ha local gravado ou o mapa dele nao esta carregado.
bool arena_carregar_config(string &out mapa, int &out x, int &out y, int &out max_jogadores, int &out duracao_ms) {
	mapa = "";
	x = 0;
	y = 0;
	max_jogadores = 10;
	duracao_ms = 300000;

	if(!arena_garantir_tabela()) return false;

	sqlite3statement@ stmt = bancoJogo.prepare("SELECT mapa, x, y, max_jogadores, duracao_ms FROM arena_config WHERE id = 1;");
	if(@stmt == null) return false;
	if(stmt.step() != SQLITE_ROW) return false;

	mapa = stmt.column_text(0);
	x = stmt.column_int(1);
	y = stmt.column_int(2);
	max_jogadores = stmt.column_int(3);
	duracao_ms = stmt.column_int(4);

	if(max_jogadores < 2) max_jogadores = 2;
	if(duracao_ms < 30000) duracao_ms = 30000;

	return (mapa != "" && get_map_index_from(mapa) >= 0);
}

bool arena_salvar_config(string mapa, int x, int y, int max_jogadores, int duracao_ms) {
	if(!arena_garantir_tabela()) return false;

	sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR REPLACE INTO arena_config (id, mapa, x, y, max_jogadores, duracao_ms) VALUES (1, ?, ?, ?, ?, ?);");
	if(@stmt == null) {
		debug_log("ERRO ao preparar arena_salvar_config: " + bancoJogo.get_last_error_text());
		return false;
	}

	stmt.bind_text(1, mapa);
	stmt.bind_int(2, x);
	stmt.bind_int(3, y);
	stmt.bind_int(4, max_jogadores);
	stmt.bind_int(5, duracao_ms);

	return (stmt.step() == SQLITE_DONE);
}

// Pacote "arena" (ligacao para 3812742 no celular, net.bgt:2252): entra na
// fila de combate; um segundo pedido tira o jogador da fila.
void arena_pedir_entrada(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) return;

	player@ p = players[player_index];

	if(p.in_arena != 0) {
		send_reliable_text(p.peer_id, "msg2 ;Você já está na arena.;", 0);
		return;
	}

	if(arena_esta_na_fila(p.charname)) {
		remove_from_matchmaking(player_index);
		return;
	}

	if(p.afk || p.paralisado || p.paralisado2 || p.health <= 0 || p.watching != 0 || game_frozen) {
		send_reliable_text(p.peer_id, "msg2 ;Você não pode entrar na arena agora.;", 0);
		return;
	}

	if(p.map == "portal_espiritual") {
		send_reliable_text(p.peer_id, "msg2 ;Você não pode entrar na arena agora.;", 0);
		return;
	}

	string cfg_mapa = "";
	int cfg_x = 0;
	int cfg_y = 0;
	int cfg_max = 10;
	int cfg_duracao = 300000;
	if(!arena_carregar_config(cfg_mapa, cfg_x, cfg_y, cfg_max, cfg_duracao)) {
		send_reliable_text(p.peer_id, "msg2 ;A arena não está disponível no momento.;", 0);
		return;
	}

	add_to_matchmaking(player_index);
}

// /setarena [max_jogadores] [minutos]: grava a posicao atual do administrador
// como local da arena.
void cmd_setarena(int player_index, string[] args) {
	if(player_index < 0 || player_index >= int(players.length())) return;

	player@ p = players[player_index];

	if(get_map_index_from(p.map) < 0) {
		send_reliable_text(p.peer_id, "msgnormal Erro ao obter o mapa atual.", 0);
		return;
	}

	int max_jogadores = 10;
	int minutos = 5;
	if(args.length() >= 1 && (!try_parse_int_token(args[0], max_jogadores) || max_jogadores < 2 || max_jogadores > 50)) {
		send_reliable_text(p.peer_id, "msgnormal Uso: /setarena [max_jogadores 2-50] [minutos 1-60]", 0);
		return;
	}
	if(args.length() >= 2 && (!try_parse_int_token(args[1], minutos) || minutos < 1 || minutos > 60)) {
		send_reliable_text(p.peer_id, "msgnormal Uso: /setarena [max_jogadores 2-50] [minutos 1-60]", 0);
		return;
	}

	if(!arena_salvar_config(p.map, p.x, p.y, max_jogadores, minutos * 60000)) {
		send_reliable_text(p.peer_id, "msgnormal Erro ao gravar o local da arena. Verifique o log do servidor.", 0);
		return;
	}

	send_reliable_text(p.peer_id, "msgnormal Arena definida em " + p.map + " (" + p.x + ", " + p.y + "), até " + max_jogadores + " jogadores, " + minutos + " minutos por partida.", 0);
	debug_log("ADMIN: " + p.charname + " definiu a arena em " + p.map + " (" + p.x + "," + p.y + ")");
}

void give_arena_rewards(int arena_index) {
	if(arena_index < 0 || arena_index >= int(arenas.length())) return;

	string winner = arenas[arena_index].get_winner();

	for(uint i = 0; i < arenas[arena_index].players_in_arena.length(); i++) {
		string player_name = arenas[arena_index].players_in_arena[i];
		int player_idx = get_player_index_from(player_name);

		if(player_idx > -1) {
			bool is_winner = (player_name == winner);

			if(is_winner) {
				ganhaxp(player_idx, arenas[arena_index].xp_reward_winner,
					arenas[arena_index].gold_reward_winner);

				send_reliable_text(players[player_idx].peer_id,
					"msg2 Você venceu a arena! Recompensa: " +
					arenas[arena_index].xp_reward_winner + " XP e " +
					arenas[arena_index].gold_reward_winner + " ouro!", 0);

				players[player_idx].arena_wins += 1;
			} else {
				ganhaxp(player_idx, arenas[arena_index].xp_reward_participant,
					arenas[arena_index].gold_reward_participant);

				send_reliable_text(players[player_idx].peer_id,
					"msg2 Obrigado por participar! Recompensa: " +
					arenas[arena_index].xp_reward_participant + " XP e " +
					arenas[arena_index].gold_reward_participant + " ouro.", 0);
			}
		}
	}

	arenas[arena_index].reset_scores();
}

string get_arena_ranking(int arena_index) {
	if(arena_index < 0 || arena_index >= int(arenas.length())) {
		return "Arena inválida.";
	}

	string ranking = "=== RANKING DA ARENA ===\n";

	string[] players_list;
	int[] scores_list;

	string[]@ keys = arenas[arena_index].scores.get_keys();
	for(uint i = 0; i < keys.length(); i++) {
		players_list.insert_last(keys[i]);
		scores_list.insert_last(int(arenas[arena_index].scores[keys[i]]));
	}

	for(uint i = 0; i < scores_list.length(); i++) {
		for(uint j = i + 1; j < scores_list.length(); j++) {
			if(scores_list[j] > scores_list[i]) {
				int temp_score = scores_list[i];
				scores_list[i] = scores_list[j];
				scores_list[j] = temp_score;

				string temp_name = players_list[i];
				players_list[i] = players_list[j];
				players_list[j] = temp_name;
			}
		}
	}

	for(uint i = 0; i < players_list.length(); i++) {
		ranking += (i + 1) + ". " + players_list[i] + ": " + scores_list[i] + " pontos\n";
	}

	if(players_list.length() == 0) {
		ranking += "Nenhum jogador pontuou ainda.\n";
	}

	return ranking;
}

void register_arena_kill(int arena_index, string killer, string victim) {
	if(arena_index < 0 || arena_index >= int(arenas.length())) return;

	arenas[arena_index].add_score(killer, 1);

	for(uint i = 0; i < arenas[arena_index].players_in_arena.length(); i++) {
		int player_idx = get_player_index_from(arenas[arena_index].players_in_arena[i]);
		if(player_idx > -1) {
			send_reliable_text(players[player_idx].peer_id,
				"msg2 " + killer + " eliminou " + victim + "!", 0);
		}
	}
}
