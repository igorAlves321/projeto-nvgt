// zones.nvgt - Sistema de Zonas Nomeadas (convertido de zones.bgt)
// Conversão: BGT → NVGT

class zone {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string text;
	
	zone(int minx, int maxx, int miny, int maxy, string txt) {
		this.min_x = minx;
		this.max_x = maxx;
		this.min_y = miny;
		this.max_y = maxy;
		this.text = txt;
	}
} // end zones
