// safezones.nvgt - Sistema de Zonas Seguras (convertido de safezones.bgt)
// Conversão: BGT → NVGT

class safezone {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	
	safezone(int minx, int maxx, int miny, int maxy) {
		this.min_x = minx;
		this.max_x = maxx;
		this.min_y = miny;
		this.max_y = maxy;
	}
} // end safezones
