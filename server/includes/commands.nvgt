    }
    else if(command == "sell" || command == "vender") {
        return cmd_sell(player, args);
    }
    
    // ✅ Comandos do Sistema de Cargos/Permissões
    else if(command == "addcargo") {
        // Montar o array parsed como esperado pela função
        string[] parsed;
        parsed.insert_last("/addcargo");
        for(uint i = 0; i < args.length(); i++) {
            parsed.insert_last(args[i]);
        }
        cmd_addcargo(player_index, parsed);
        return true;
    }
    else if(command == "removecargo") {
        string[] parsed;
        parsed.insert_last("/removecargo");
        for(uint i = 0; i < args.length(); i++) {
            parsed.insert_last(args[i]);
        }
        cmd_removecargo(player_index, parsed);
        return true;
    }
    else if(command == "cargos") {
        string[] parsed;
        parsed.insert_last("/cargos");
