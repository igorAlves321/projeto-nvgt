        }
        eadm("[ADMIN MSG] " + player.charname + ": " + join(args, " "));
        return true;
    }
    else if(command == "builderstats" || command == "bstats") {
        int m_idx = get_map_index_from(player.map);
        if(m_idx < 0) {
            player.send_message("say Mapa atual não encontrado.");
            return false;
        }
        string bmsg = "Mapa: " + server_maps[m_idx].name + " | Tamanho: " + server_maps[m_idx].max_x + "x" + server_maps[m_idx].max_y;
        bmsg += " | Objetos: " + server_maps[m_idx].objs.length() + " | Zonas: " + game_disabled_zones.length();
        player.send_message("say " + bmsg);
        return true;
    }
    else if(command == "checkweight" || command == "peso") {
        double current_w = calculate_inventory_weight(player_index);
        double max_w = player.max_carry_weight;
        int pct = max_w > 0 ? int((current_w / max_w) * 100) : 0;
        player.send_message("say Peso atual: " + current_w + "/" + max_w + " kg (" + pct + "%).");
        return true;
    }
    else if(command == "move") {
        if(args.length() < 3) {
            player.send_message("say Uso: /move <jogador> <x> <y>");
            return false;
        }
        int target = get_player_index_from(args[0]);
        if(target < 0) {
            player.send_message("say Jogador não encontrado.");
            return false;
        }
        int nx = string_to_number(args[1]);
        int ny = string_to_number(args[2]);
        move_player_to_map(target, players[target].map, nx, ny);
        player.send_message("say Jogador " + args[0] + " movido para " + nx + ", " + ny + ".");
        return true;
    }
    else if(command == "changemap") {
        if(args.length() < 2) {
            player.send_message("say Uso: /changemap <jogador> <mapa> [x] [y]");
            return false;
        }
        int target = get_player_index_from(args[0]);
        if(target < 0) {
            player.send_message("say Jogador não encontrado.");
            return false;
        }
        string nmap = args[1];
        int nx = args.length() > 2 ? string_to_number(args[2]) : 0;
        int ny = args.length() > 3 ? string_to_number(args[3]) : 0;
        move_player_to_map(target, nmap, nx, ny);
        player.send_message("say Jogador " + args[0] + " transferido para o mapa " + nmap + ".");
        return true;
    }
    else if(command == "map") {
        int m_idx = get_map_index_from(player.map);
        if(m_idx >= 0) {
            player.send_message("say Mapa atual: " + server_maps[m_idx].name + " (" + server_maps[m_idx].max_x + "x" + server_maps[m_idx].max_y + ")");
        } else {
            player.send_message("say Mapa atual: " + player.map);
        }
        return true;
    }
    else if(command == "listmaps") {
        string mlist = "=== MAPAS (" + server_maps.length() + ") ===\r\n";
