// Registrar um comando
void register_command(string name, string description, bool admin_only = false, 
                     string[] aliases = {}, string usage = "") {
    ServerCommand@ cmd = ServerCommand(name, description, admin_only);
    cmd.aliases = aliases;
    cmd.usage = (usage != "") ? usage : name;
    
    // NVGT: Armazenar como handle no dictionary
    registered_commands.set(name, @cmd);
    
    // Registrar aliases
    for(uint i = 0; i < aliases.length(); i++) {
        command_aliases[aliases[i]] = name;
    }
}

// Resolver comando (incluindo aliases)
string resolve_command(string input) {
    if(registered_commands.exists(input)) {
        return input;
    }
    
    if(command_aliases.exists(input)) {
        string real_name;
        command_aliases.get(input, real_name);
        return real_name;
    }
    
    return "";
}

// Verificar se jogador pode usar comando
bool can_use_command(player@ player, string command_name) {
    if(!registered_commands.exists(command_name)) {
        return false;
    }
    
    ServerCommand@ cmd;
    registered_commands.get(command_name, @cmd);
    if(cmd is null) return false;
    
    // ✅ Usar novo sistema de cargos para verificar permissão
    if(cmd.admin_only) {
        // Verificar se é admin, mod ou dev usando o sistema de roles
        if(!check_is_admin(player.charname) && !check_is_mod(player.charname)) {
            return false;
        }
    }
    
    return true;
}

// Processar comando completo
bool process_command(player@ player, string full_command) {
    if(player is null || full_command == "") return false;
    
    // Só processar comandos que começam com /
    if(full_command.length() < 1 || full_command[0] != '/') {
        return false;  // Deixar fallback processar
    }
    
    // Remover a barra inicial para processar
    string command_without_slash = full_command.substr(1);
    
    string[] parts = command_without_slash.split(" ");
    if(parts.length() == 0) return false;
    
    string command_name = parts[0].lower();
    string[] args;
    
    // Extrair argumentos
    for(uint i = 1; i < parts.length(); i++) {
        args.push_back(parts[i]);
    }
    
    // Resolver comando (verificar aliases)
    string resolved = resolve_command(command_name);
    if(resolved == "") {
        return false;
    }
    
    // Verificar permissões
    if(!can_use_command(player, resolved)) {
        player.send_message("say Você não tem permissão para usar este comando.");
        return false;
    }
    
    // Executar comando
    return execute_command(player, resolved, args);
}

// Executar comando específico
bool execute_command(player@ player, string command, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) return false;
    
    // 🆕 INTEGRAÇÃO: Comandos Administrativos
    if(command == "playtime") {
        string target = args.length() > 0 ? args[0] : "";
        cmd_playtime(player_index, target);
        return true;
    }
    else if(command == "kick") {
        if(args.length() < 1) {
            player.send_message("say Uso: /kick <jogador> [razão]");
            return false;
        }
        string target = args[0];
        string reason = args.length() > 1 ? join(args, " ").substr(target.length() + 1) : "Expulso por admin";
        cmd_kick(player_index, target, reason);
        return true;
    }
    else if(command == "inventory") {
        if(args.length() < 1) {
            player.send_message("say Uso: /inventory <jogador>");
            return false;
        }
        cmd_inventory(player_index, args[0]);
        return true;
    }
    else if(command == "freezeall") {
        int duration = args.length() > 0 ? string_to_number(args[0]) : 10;
        cmd_freezeall(player_index, duration);
        return true;
    }
    else if(command == "backup") {
        cmd_backup(player_index);
        return true;
    }
    else if(command == "forcedc") {
        cmd_forcedc(player_index);
        return true;
    }
    else if(command == "tp") {
        if(args.length() < 1) {
            player.send_message("say Uso: /tp <jogador>");
            return false;
        }
        cmd_tp(player_index, args[0]);
        return true;
    }
    else if(command == "tphere") {
        if(args.length() < 1) {
            player.send_message("say Uso: /tphere <jogador>");
            return false;
        }
        cmd_tphere(player_index, args[0]);
        return true;
    }
    else if(command == "givexp") {
        if(args.length() < 2) {
            player.send_message("say Uso: /givexp <jogador> <quantidade>");
            return false;
        }
        cmd_givexp(player_index, args[0], string_to_number(args[1]));
        return true;
    }
    else if(command == "giveitem") {
        if(args.length() < 2) {
            player.send_message("say Uso: /giveitem <jogador> <item> [quantidade]");
            return false;
        }
        string target = args[0];
        string item = args[1];
        int quantity = args.length() > 2 ? string_to_number(args[2]) : 1;
        cmd_giveitem(player_index, target, item, quantity);
        return true;
    }
    // ============================================================================
    // NOVOS COMANDOS ADMIN - Menu Administrativo
    // ============================================================================
    else if(command == "tb" || command == "tempban") {
        if(args.length() < 2) {
            player.send_message("say Uso: /tb <jogador> <dias> [razão]");
            return false;
        }
        string target = args[0];
        double days = string_to_number(args[1]);
        string reason = args.length() > 2 ? join(args, " ").substr(target.length() + args[1].length() + 2) : "Violação das regras";
        cmd_tempban(player_index, target, days, reason);
        return true;
    }
    else if(command == "ban") {
        if(args.length() < 1) {
            player.send_message("say Uso: /ban <jogador> [razão]");
            return false;
        }
        string target = args[0];
        string reason = args.length() > 1 ? join(args, " ").substr(target.length() + 1) : "Violação das regras";
        cmd_ban(player_index, target, reason);
        return true;
    }
    else if(command == "unban") {
        if(args.length() < 1) {
            player.send_message("say Uso: /unban <jogador>");
            return false;
        }
        cmd_unban(player_index, args[0]);
        return true;
    }
    else if(command == "silenciar" || command == "mute") {
        if(args.length() < 1) {
            player.send_message("say Uso: /silenciar <jogador> [minutos]");
            return false;
        }
        int minutes = args.length() > 1 ? string_to_number(args[1]) : 10;
        cmd_silenciar(player_index, args[0], minutes);
        return true;
    }
    else if(command == "unsilenciar" || command == "unmute") {
        if(args.length() < 1) {
            player.send_message("say Uso: /unsilenciar <jogador>");
            return false;
        }
        cmd_unsilenciar(player_index, args[0]);
        return true;
    }
    else if(command == "prender") {
        if(args.length() < 3) {
            player.send_message("say Uso: /prender <jogador> <minutos> <razão>");
            return false;
        }
        string target = args[0];
        int minutes = string_to_number(args[1]);
        string reason = join(args, " ").substr(target.length() + args[1].length() + 2);
        cmd_prender(player_index, target, minutes, reason);
        return true;
    }
    else if(command == "soltar") {
        if(args.length() < 1) {
            player.send_message("say Uso: /soltar <jogador>");
            return false;
        }
        cmd_soltar(player_index, args[0]);
        return true;
    }
    else if(command == "sendmap") {
        if(args.length() < 2) {
            player.send_message("say Uso: /sendmap <jogador> <mapa>");
            return false;
        }
        cmd_sendmap(player_index, args[0], args[1]);
        return true;
    }
    else if(command == "dar") {
        if(args.length() < 2) {
            player.send_message("say Uso: /dar <jogador> <item> [quantidade]");
            return false;
        }
        string target = args[0];
        string item = args[1];
        int quantity = args.length() > 2 ? string_to_number(args[2]) : 1;
        cmd_dar(player_index, target, item, quantity);
        return true;
    }
    else if(command == "remover") {
        if(args.length() < 2) {
            player.send_message("say Uso: /remover <jogador> <item> [quantidade]");
            return false;
        }
        string target = args[0];
        string item = args[1];
        int quantity = args.length() > 2 ? string_to_number(args[2]) : 1;
        cmd_remover(player_index, target, item, quantity);
        return true;
    }
    else if(command == "dare") {
        if(args.length() < 2) {
            player.send_message("say Uso: /dare <jogador> <quantidade>");
            return false;
        }
        cmd_dare(player_index, args[0], string_to_number(args[1]));
        return true;
    }
    else if(command == "darc") {
        if(args.length() < 2) {
            player.send_message("say Uso: /darc <jogador> <quantidade>");
            return false;
        }
        cmd_darc(player_index, args[0], string_to_number(args[1]));
        return true;
    }
    else if(command == "pinfo") {
        if(args.length() < 1) {
            player.send_message("say Uso: /pinfo <jogador>");
            return false;
        }
        cmd_pinfo(player_index, args[0]);
        return true;
    }
