// Estrutura para comando
class ServerCommand {
    string name;
    string description;
    bool admin_only;
    string[] aliases;
    string usage;
    
    ServerCommand(string cmd_name, string cmd_desc, bool is_admin = false) {
        name = cmd_name;
        description = cmd_desc;
        admin_only = is_admin;
        usage = cmd_name;
    }
}

// Sistema global de comandos
dictionary registered_commands;  // name -> ServerCommand
dictionary command_aliases;      // alias -> real_name

