bool cmd_lc(player@ player, string[] args) {
    // Formato: "VocÃƒÂª estÃƒÂ¡ no nÃƒÂ­vel X, no remorte Y e na patente Z. VocÃƒÂª estÃƒÂ¡ com X% de sede..."
    
    // Determinar sufixo baseado no sexo (0=masculino, 1=feminino)
    string sufixo_sujo = (player.sexo == 0) ? "o" : "a";
    string sufixo_cansado = (player.sexo == 0) ? "o" : "a";
    string sufixo_bebado = (player.sexo == 0) ? "o" : "a";
    string sufixo_doente = ""; // doente nÃƒÂ£o muda

    // Debug para verificar o sexo atual
    debug_log("DEBUG SEXO: " + player.charname + " sexo=" + player.sexo + " sufixo=" + sufixo_sujo);

    // Determinar patente/tÃƒÂ­tulo
    // Prioridade: cargo (dev/admin/moderator) > tÃƒÂ­tulo do jogador > "Iniciante"
    string patente = "";
    
    // Verificar cargos primeiro (usando o sistema de roles)
    if(has_role(player.charname, "dev")) {
        patente = "Desenvolvedor";
    } else if(has_role(player.charname, "admin")) {
        patente = "Administrador";
    } else if(has_role(player.charname, "moderator")) {
        patente = "Moderador";
    } else if(has_role(player.charname, "builder")) {
        patente = "Construtor";
    } else if(has_role(player.charname, "translator")) {
        patente = "Tradutor";
    } else if(player.title != "" && player.title.length() > 0) {
        patente = player.title;
    } else {
        patente = "Iniciante";
    }

    // Construir mensagem de nÃƒÂ­vel
    string msg = "VocÃƒÂª estÃƒÂ¡ no nÃƒÂ­vel " + int(player.level);
    
    // Adicionar remorte se maior que 0
    if(player.reencarnou > 0) {
        msg += ", no remorte " + player.reencarnou;
    }
    
    // Adicionar patente
    msg += " e na patente " + patente + ". ";
    
    // Segunda parte: estatÃƒÂ­sticas
    msg += "VocÃƒÂª estÃƒÂ¡ com ";
    
    // Array para construir a lista de estatÃƒÂ­sticas
    string[] stats;
    
    // Sede
    stats.insert_last(round(player.nsede, 0) + "% de sede");
    
    // Fome
    stats.insert_last(round(player.nfome, 0) + "% de fome");
    
    // CansaÃƒÂ§o (stamina invertido - 100 stamina = 0% cansado)
    int cansaco = 100 - player.stamina;
    if(cansaco < 0) cansaco = 0;
    stats.insert_last(cansaco + "% cansad" + sufixo_cansado);
    
    // BÃƒÂªbado (se tiver variÃƒÂ¡vel)
    if(player.caverna > 0) {
        stats.insert_last(player.caverna + "% bÃƒÂªbad" + sufixo_bebado);
    }
    
    // Sujo
    stats.insert_last(round(player.sujo, 0) + "% suj" + sufixo_sujo);
    
    // Doente
    stats.insert_last(round(player.doente, 0) + "% doente");
    
    // Juntar estatÃƒÂ­sticas com vÃƒÂ­rgulas e "e" antes da ÃƒÂºltima
    for(uint i = 0; i < stats.length(); i++) {
        if(i == stats.length() - 1 && i > 0) {
            msg += " e " + stats[i];
        } else if(i > 0) {
            msg += ", " + stats[i];
        } else {
            msg += stats[i];
        }
    }
    msg += ".";
    
    // Adicionar crÃƒÂ©ditos se tiver
    if(player.creditos > 0) {
        msg += " VocÃƒÂª tem " + int(player.creditos) + " crÃƒÂ©ditos de reserva.";
    }

    player.send_message("msg2 " + msg);
    debug_log("Ã°Å¸â€œÅ  [V-KEY] " + player.charname + " verificou status: nÃƒÂ­vel=" + int(player.level) + " patente=" + patente);
    return true;
}

bool cmd_checktime(player@ player, string[] args) {
    // Verificar se o jogador tem relÃƒÂ³gio
    if(player.relogio == 0) {
        player.send_message("say VocÃƒÂª precisa de um relÃƒÂ³gio para ver as horas.");
        debug_log("Ã¢Å’Å¡ [H-KEY] " + player.charname + " tentou ver hora sem relÃƒÂ³gio");
        return false;
    }

    // Pegar hora atual do sistema usando constantes globais TIME_*
    int hora_atual = TIME_HOUR;
    int minuto_atual = TIME_MINUTE;

    // Formatar hora com zero ÃƒÂ  esquerda se necessÃƒÂ¡rio
    string hora = hora_atual < 10 ? "0" + hora_atual : "" + hora_atual;
    string minuto = minuto_atual < 10 ? "0" + minuto_atual : "" + minuto_atual;

    player.send_message("say SÃƒÂ£o " + hora + " horas e " + minuto + " minutos.");
    debug_log("Ã¢Å’Å¡ [H-KEY] " + player.charname + " verificou hora: " + hora + ":" + minuto);
    return true;
}

bool cmd_falarnomapa(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: /falarnomapa <mensagem>");
        return false;
    }

    string message = join(args, " ");

    // Usar telllocal para enviar corretamente no formato fm
    int player_index = get_player_index_from(player.charname);
    if(player_index >= 0) {
        telllocal(player_index, message);
    }

    return true;
}

