            parsed.insert_last(args[i]);
        }
        cmd_cargos(player_index, parsed);
        return true;
    }
    else if(command == "listadmins" || command == "admins" || command == "equipe") {
        string[] parsed;
        parsed.insert_last("/listadmins");
        cmd_listadmins(player_index, parsed);
        return true;
    }
    
    // Comando não implementado ainda
    player.send_message("say Comando '" + command + "' reconhecido mas não implementado ainda.");
    return false;
}

// === IMPLEMENTAÇÃO DOS COMANDOS ===

bool cmd_help(player@ player, string[] args) {
    string[] command_list;
    string[] admin_list;
    
    string[] keys = registered_commands.get_keys();
    for(uint i = 0; i < keys.length(); i++) {
        ServerCommand@ cmd;
        registered_commands.get(keys[i], @cmd);
        if(cmd is null) continue;
        
        if(cmd.admin_only) {
            if(player.admin_status) {
                admin_list.push_back(cmd.name + " - " + cmd.description);
            }
        } else {
            command_list.push_back(cmd.name + " - " + cmd.description);
        }
    }
    
    player.send_message("say === COMANDOS DISPONÍVEIS ===");
    for(uint i = 0; i < command_list.length(); i++) {
        player.send_message("say " + command_list[i]);
    }
    
    if(admin_list.length() > 0) {
        player.send_message("say === COMANDOS DE ADMINISTRADOR ===");
        for(uint i = 0; i < admin_list.length(); i++) {
            player.send_message("say " + admin_list[i]);
        }
    }
    
    return true;
}

bool cmd_who(player@ player, string[] args) {
    string[] online = get_online_players();
    player.send_message("say Jogadores online (" + online.length() + "): " + join(online, ", "));
    return true;
}

bool cmd_time(player@ player, string[] args) {
    // TODO: Implementar sistema de tempo de jogo
    player.send_message("say Tempo de jogo: Em desenvolvimento");
    return true;
}

bool cmd_save(player@ player, string[] args) {
    player.save_player_data();
    player.send_message("say Dados salvos com sucesso!");
    return true;
}

bool cmd_quit(player@ player, string[] args) {
    player.send_message("say Desconectando...");
    // TODO: Implementar desconexão graceful
    return true;
}

bool cmd_pm(player@ player, string[] args) {
    if(args.length() < 2) {
        player.send_message("say Uso: pm <jogador> <mensagem>");
        return false;
    }
    
    string target_name = args[0];
    string message = "";
    for(uint i = 1; i < args.length(); i++) {
        if(i > 1) message += " ";
        message += args[i];
    }
    
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        player.send_message("say Jogador '" + target_name + "' não encontrado.");
        return false;
    }
    
    target.send_message("pm [" + player.name + "]: " + message);
    player.send_message("pm Para [" + target.name + "]: " + message);
    
    return true;
}

bool cmd_say(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: say <mensagem>");
        return false;
    }
    
    string message = join(args, " ");
    
    // Broadcast para jogadores no mesmo mapa
    player@[] players_here = get_players_in_map(player.map_name);
    for(uint i = 0; i < players_here.length(); i++) {
        players_here[i].send_message("say " + player.name + " diz: " + message);
    }
    
    return true;
}

bool cmd_inventory(player@ player, string[] args) {
    // Obter itens do inventário do jogador
    string[] inv_keys = player.inv.get_keys();

    if(inv_keys.length() == 0) {
        player.send_message("say Seu inventário está vazio.");
        debug_log("📦 " + player.charname + " verificou inventário vazio");
        return true;
    }

    // Construir mensagem de inventário
    string inv_msg = "=== INVENTÁRIO ===\n";
    inv_msg += "Total de itens: " + inv_keys.length() + "\n\n";

    for(uint i = 0; i < inv_keys.length(); i++) {
        int quantity = 0;
        player.inv.get(inv_keys[i], quantity);

        if(quantity > 0) {
            inv_msg += "- " + inv_keys[i] + ": " + quantity + "\n";
        }
    }

    player.send_message("say " + inv_msg);
    debug_log("📦 " + player.charname + " verificou inventário (" + inv_keys.length() + " itens)");
    return true;
}

bool cmd_score(player@ player, string[] args) {
    string stats = "=== ESTATÍSTICAS ===\n";
    stats += "Nome: " + player.name + "\n";
    stats += "Nível: " + player.player_level + "\n";
    stats += "Experiência: " + player.exp + "\n";
    stats += "Ouro: " + player.gold + "\n";
    stats += "Vida: " + player.hp + "/" + player.max_hp + "\n";
    stats += "Mana: " + player.mp + "/" + player.max_mp + "\n";
    stats += "Raça: " + player.race + "\n";
    stats += "Localização: " + player.map_name + " (" + player.x + "," + player.y + "," + player.z + ")";
    
    player.send_message("say " + stats);
    return true;
}

// === COMANDOS DE CONFIGURAÇÃO DO JOGADOR ===

bool cmd_setvoice(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: setvoice <voz>");
        return false;
    }
    player.voice_id = args[0];
    save_player_to_database(player);
    debug_log("🎤 Jogador " + player.name + " configurou voz: " + args[0]);
    return true;
}

bool cmd_hits(player@ player, string[] args) {
    player.ouvirhits = !player.ouvirhits;
    save_player_to_database(player);
    string status = player.ouvirhits ? "ativados" : "desativados";
    player.send_message("say Sons de impacto " + status);
    return true;
}

bool cmd_idiomachat(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: idiomachat <idioma>");
        return false;
    }
    player.idiomachat = args[0];
    save_player_to_database(player);
    player.send_message("say Idioma do chat configurado: " + args[0]);
    return true;
}

bool cmd_dpassos(player@ player, string[] args) {
    player.ouvirpassos = (player.ouvirpassos == 0) ? 1 : 0;
    save_player_to_database(player);
    string status = (player.ouvirpassos == 0) ? "desativados" : "ativados";
    player.send_message("say Sons de passos " + status);
    return true;
}

bool cmd_ndor(player@ player, string[] args) {
    player.mdor = (player.mdor == 0) ? 1 : 0;
    save_player_to_database(player);
    string status = (player.mdor == 0) ? "ativadas" : "desativadas";
    player.send_message("say Mensagens de dor " + status);
    return true;
}

bool cmd_nnivel(player@ player, string[] args) {
    player.avisanivel = (player.avisanivel == 0) ? 1 : 0;
    save_player_to_database(player);
    string status = (player.avisanivel == 0) ? "ativados" : "desativados";
    player.send_message("say Avisos de nível " + status);
    return true;
}

bool cmd_getversion(player@ player, string[] args) {
    player.send_message("version " + server_version);
    return true;
}

bool cmd_lc(player@ player, string[] args) {
    // Formato: "Você está no nível X, no remorte Y e na patente Z. Você está com X% de sede..."
    
    // Determinar sufixo baseado no sexo (0=masculino, 1=feminino)
    string sufixo_sujo = (player.sexo == 0) ? "o" : "a";
    string sufixo_cansado = (player.sexo == 0) ? "o" : "a";
    string sufixo_bebado = (player.sexo == 0) ? "o" : "a";
    string sufixo_doente = ""; // doente não muda

    // Debug para verificar o sexo atual
    debug_log("DEBUG SEXO: " + player.charname + " sexo=" + player.sexo + " sufixo=" + sufixo_sujo);

    // Determinar patente/título
    // Prioridade: cargo (dev/admin/moderator) > título do jogador > "Iniciante"
    string patente = "";
    
    // Verificar cargos primeiro (usando o sistema de roles)
    if(has_role(player.charname, "dev")) {
        patente = "Desenvolvedor";
    } else if(has_role(player.charname, "admin")) {
        patente = "Administrador";
    } else if(has_role(player.charname, "moderator")) {
        patente = "Moderador";
    } else if(has_role(player.charname, "builder")) {
        patente = "Construtor";
    } else if(has_role(player.charname, "translator")) {
        patente = "Tradutor";
    } else if(player.title != "" && player.title.length() > 0) {
        patente = player.title;
    } else {
        patente = "Iniciante";
    }

    // Construir mensagem de nível
    string msg = "Você está no nível " + int(player.level);
    
    // Adicionar remorte se maior que 0
    if(player.reencarnou > 0) {
        msg += ", no remorte " + player.reencarnou;
    }
    
    // Adicionar patente
    msg += " e na patente " + patente + ". ";
    
    // Segunda parte: estatísticas
    msg += "Você está com ";
    
    // Array para construir a lista de estatísticas
    string[] stats;
    
    // Sede
    stats.insert_last(round(player.nsede, 0) + "% de sede");
    
    // Fome
    stats.insert_last(round(player.nfome, 0) + "% de fome");
    
    // Cansaço (stamina invertido - 100 stamina = 0% cansado)
    int cansaco = 100 - player.stamina;
    if(cansaco < 0) cansaco = 0;
    stats.insert_last(cansaco + "% cansad" + sufixo_cansado);
    
    // Bêbado (se tiver variável)
    if(player.caverna > 0) {
        stats.insert_last(player.caverna + "% bêbad" + sufixo_bebado);
    }
    
    // Sujo
    stats.insert_last(round(player.sujo, 0) + "% suj" + sufixo_sujo);
    
    // Doente
    stats.insert_last(round(player.doente, 0) + "% doente");
    
    // Juntar estatísticas com vírgulas e "e" antes da última
    for(uint i = 0; i < stats.length(); i++) {
        if(i == stats.length() - 1 && i > 0) {
            msg += " e " + stats[i];
        } else if(i > 0) {
            msg += ", " + stats[i];
        } else {
            msg += stats[i];
        }
    }
    msg += ".";
    
    // Adicionar créditos se tiver
    if(player.creditos > 0) {
        msg += " Você tem " + int(player.creditos) + " créditos de reserva.";
    }

    player.send_message("msg2 " + msg);
    debug_log("📊 [V-KEY] " + player.charname + " verificou status: nível=" + int(player.level) + " patente=" + patente);
    return true;
}

bool cmd_checktime(player@ player, string[] args) {
    // Verificar se o jogador tem relógio
    if(player.relogio == 0) {
        player.send_message("say Você precisa de um relógio para ver as horas.");
        debug_log("⌚ [H-KEY] " + player.charname + " tentou ver hora sem relógio");
        return false;
    }

    // Pegar hora atual do sistema usando constantes globais TIME_*
    int hora_atual = TIME_HOUR;
    int minuto_atual = TIME_MINUTE;

    // Formatar hora com zero à esquerda se necessário
    string hora = hora_atual < 10 ? "0" + hora_atual : "" + hora_atual;
    string minuto = minuto_atual < 10 ? "0" + minuto_atual : "" + minuto_atual;

    player.send_message("say São " + hora + " horas e " + minuto + " minutos.");
    debug_log("⌚ [H-KEY] " + player.charname + " verificou hora: " + hora + ":" + minuto);
    return true;
}

bool cmd_falarnomapa(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: /falarnomapa <mensagem>");
        return false;
    }

    string message = join(args, " ");

    // Usar telllocal para enviar corretamente no formato fm
    int player_index = get_player_index_from(player.charname);
    if(player_index >= 0) {
        telllocal(player_index, message);
    }

    return true;
}

