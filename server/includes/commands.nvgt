bool cmd_history(player@ player, string[] args) {
    string player_filter = "";
    string action_filter = "";
    int limit = 20;
    
    if(args.length() > 0) player_filter = args[0];
    if(args.length() > 1) action_filter = args[1];
    if(args.length() > 2) limit = string_to_number(args[2]);
    
    string[] history = get_recent_actions(limit, action_filter, player_filter);
    
    if(history.length() == 0) {
        player.send_message("say Nenhum histÃƒÂ³rico encontrado com os filtros especificados.");
        return false;
    }
    
    player.send_message("say === HISTÃƒâ€œRICO DE AÃƒâ€¡Ãƒâ€¢ES ===\nMostrando " + history.length() + " entradas:");
    for(uint i = 0; i < history.length(); i++) {
        player.send_message("say " + history[i]);
    }
    
    return true;
}

// Comandos de Combate
bool cmd_attack(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: attack <jogador> [arma]");
        return false;
    }
    
    string target_name = args[0];
    string weapon = args.length() > 1 ? args[1] : "";
    
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        player.send_message("say Jogador '" + target_name + "' nÃƒÂ£o encontrado.");
        return false;
    }
    
    if(target.name == player.name) {
        player.send_message("say VocÃƒÂª nÃƒÂ£o pode atacar a si mesmo!");
        return false;
    }
    
    // Verificar se estÃƒÂ£o no mesmo mapa e prÃƒÂ³ximos
    if(target.map_name != player.map_name) {
        player.send_message("say O jogador nÃƒÂ£o estÃƒÂ¡ no mesmo mapa que vocÃƒÂª.");
        return false;
    }
    
    int distance = abs(target.x - player.x) + abs(target.y - player.y) + abs(target.z - player.z);
    if(distance > 2) {
        player.send_message("say VocÃƒÂª precisa estar mais prÃƒÂ³ximo para atacar.");
        return false;
    }
    
    // Verificar se jÃƒÂ¡ estÃƒÂ¡ em combate
    if(is_player_in_combat(player.name)) {
        // Se jÃƒÂ¡ estÃƒÂ¡ em combate com este jogador, executar ataque
        if(execute_attack(player.name, target.name, weapon)) {
            return true;
        } else {
            player.send_message("say Falha ao executar ataque.");
            return false;
        }
    } else {
        // Iniciar novo combate
        if(start_combat(player.name, target.name)) {
            // Executar primeiro ataque
            execute_attack(player.name, target.name, weapon);
            return true;
        } else {
            if(is_player_in_combat(target.name)) {
                player.send_message("say " + target_name + " jÃƒÂ¡ estÃƒÂ¡ em combate com outro jogador.");
            } else {
                player.send_message("say NÃƒÂ£o foi possÃƒÂ­vel iniciar o combate.");
            }
            return false;
        }
    }
}

bool cmd_defend(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say VocÃƒÂª nÃƒÂ£o estÃƒÂ¡ em combate.");
        return false;
    }

    set_player_defending(player.name);
    player.send_message("say Defesa ativada. O proximo ataque recebido tera dano reduzido.");

    log_action(player.name, "defend", "Jogador se defendeu", 
               player.map_name, player.x, player.y, player.z);

    return true;
}

bool cmd_flee(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say VocÃƒÂª nÃƒÂ£o estÃƒÂ¡ em combate.");
        return false;
    }
    
    if(attempt_flee(player.name)) {
        return true;
    } else {
        player.send_message("say VocÃƒÂª nÃƒÂ£o conseguiu fugir! Tente novamente na prÃƒÂ³xima rodada.");
        return false;
    }
}

bool cmd_combat_status(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say VocÃƒÂª nÃƒÂ£o estÃƒÂ¡ em combate.");
        return false;
    }
    
    CombatInstance@ combat = get_player_combat(player.name);
    if(combat is null) {
        player.send_message("say Erro: Dados de combate nÃƒÂ£o encontrados.");
        return false;
    }
    
    string opponent_id = combat.attacker_id == player.name ? combat.defender_id : combat.attacker_id;
    player@ opponent = get_player_by_id(opponent_id);
    
    if(opponent !is null) {
        uint64 combat_duration = (get_time_stamp() - combat.start_time) / 1000;
        string status = "=== STATUS DO COMBATE ===\n";
        status += "Oponente: " + opponent.name + "\n";
        status += "Sua vida: " + player.hp + "/" + player.max_hp + "\n";
        status += "Vida do oponente: " + opponent.hp + "/" + opponent.max_hp + "\n";
        status += "DuraÃƒÂ§ÃƒÂ£o: " + combat_duration + " segundos\n";
        status += "Status: " + combat.battle_status;
        
        player.send_message("say " + status);
    }
    
    return true;
}

// Ã°Å¸â€ â€¢ Comando para usar itens consumÃƒÂ­veis
bool cmd_use(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: /usar <item>");
        return false;
    }
    
    // Nome do item (pode ser mÃƒÂºltiplas palavras, entÃƒÂ£o concatenar)
    string item_name = join(args, " ");
    
    // Obter ÃƒÂ­ndice do jogador
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro: Jogador nÃƒÂ£o encontrado.");
        return false;
    }
    
    // Chamar sistema de consumÃƒÂ­veis
    if(use_item(player_index, item_name)) {
        // Mensagem de sucesso jÃƒÂ¡ enviada pelo sistema de consumÃƒÂ­veis
        return true;
    } else {
        // Mensagem de erro jÃƒÂ¡ enviada pelo sistema de consumÃƒÂ­veis
        return false;
    }
}

// ============================================
// Ã¢Å“â€¦ Task 1.5.2: SISTEMA DE RECOMPENSAS (BOUNTY)
// ============================================

// Constantes do sistema de bounty
const int BOUNTY_MIN_VALUE = 100;       // Valor mÃƒÂ­nimo da recompensa
const int BOUNTY_MAX_VALUE = 10000000;  // Valor mÃƒÂ¡ximo da recompensa
const int BOUNTY_CANCEL_FEE = 50;       // Taxa de cancelamento (50%)

// Comando /bounty - Colocar recompensa na cabeÃƒÂ§a de um jogador
bool cmd_bounty(player@ player, string[] args) {
    if(args.length() < 2) {
        player.send_message("say Uso: /bounty <jogador> <valor>");
        player.send_message("say Valor mÃƒÂ­nimo: " + BOUNTY_MIN_VALUE + " moedas");
        return false;
    }
    
    string target_name = args[0];
    int value = string_to_number(args[1]);
    
    // Obter ÃƒÂ­ndice do jogador que estÃƒÂ¡ colocando a recompensa
    int setter_index = get_player_index_from(player.charname);
    if(setter_index < 0) {
        player.send_message("say Erro interno: Jogador nÃƒÂ£o encontrado.");
        return false;
    }
    
    // Validar valor
    if(value < BOUNTY_MIN_VALUE) {
        player.send_message("say O valor mÃƒÂ­nimo da recompensa ÃƒÂ© " + BOUNTY_MIN_VALUE + " moedas.");
        return false;
    }
    
    if(value > BOUNTY_MAX_VALUE) {
        player.send_message("say O valor mÃƒÂ¡ximo da recompensa ÃƒÂ© " + BOUNTY_MAX_VALUE + " moedas.");
        return false;
    }
    
    // Encontrar o alvo
    int target_index = get_player_index_from(target_name);
    if(target_index < 0) {
        player.send_message("say Jogador '" + target_name + "' nÃƒÂ£o estÃƒÂ¡ online.");
        return false;
    }
    
    // Verificar se tem saldo suficiente
    if(players[setter_index].gold < value) {
        player.send_message("say Voce nao tem moedas suficientes. Seu saldo: " + players[setter_index].gold);
        return false;
    }
    
    // Tentar colocar a recompensa
    if(set_bounty(target_index, setter_index, value)) {
        player.send_message("say Recompensa registrada com sucesso.");
        debug_log("BOUNTY: " + player.charname + " colocou " + value + " na cabeca de " + players[target_index].charname);
        return true;
    } else {
        // Falhou - verificar motivo
        if(target_index == setter_index) {
            player.send_message("say VocÃƒÂª nÃƒÂ£o pode colocar recompensa em si mesmo!");
        } else if(players[target_index].pacifico == 1) {
            player.send_message("say Este jogador estÃƒÂ¡ em modo pacÃƒÂ­fico e nÃƒÂ£o pode receber recompensas.");
        } else if(players[target_index].newbie == true) {
            player.send_message("say Este jogador ÃƒÂ© novato e nÃƒÂ£o pode receber recompensas.");
        } else {
            player.send_message("say NÃƒÂ£o foi possÃƒÂ­vel colocar a recompensa. Tente novamente.");
        }
        return false;
    }
}

// Comando /checkbounty - Ver recompensa na cabeÃƒÂ§a de um jogador
bool cmd_checkbounty(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: /checkbounty <jogador>");
        return false;
    }
    
    string target_name = args[0];
    int target_index = get_player_index_from(target_name);
    
    if(target_index < 0) {
        player.send_message("say Jogador '" + target_name + "' nÃƒÂ£o estÃƒÂ¡ online.");
        return false;
    }
    
    string info = get_bounty_info(target_index);
    player.send_message("say " + info);
    return true;
}

// Comando /mybounty - Ver recompensa na sua prÃƒÂ³pria cabeÃƒÂ§a
bool cmd_mybounty(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro interno: Jogador nÃƒÂ£o encontrado.");
        return false;
    }
    
    if(!has_bounty(player_index)) {
        player.send_message("say VocÃƒÂª nÃƒÂ£o tem recompensa na sua cabeÃƒÂ§a. Ã°Å¸ËœÅ ");
        return true;
    }
    
    string info = get_bounty_info(player_index);
    player.send_message("say Ã¢Å¡Â Ã¯Â¸Â " + info);
    
    // Mostrar tempo online com recompensa
    if(players[player_index].bounty_online_time > 0) {
        int minutes = players[player_index].bounty_online_time / 60;
        player.send_message("say Tempo com recompensa: " + minutes + " minutos");
    }
    
    return true;
}

// Comando /cancelbounty - Cancelar recompensa que vocÃƒÂª colocou
bool cmd_cancelbounty(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: /cancelbounty <jogador>");
        player.send_message("say Ã¢Å¡Â Ã¯Â¸Â Taxa de cancelamento: " + BOUNTY_CANCEL_FEE + "% do valor");
        return false;
    }
    
    string target_name = args[0];
    int canceller_index = get_player_index_from(player.charname);
    
    if(canceller_index < 0) {
        player.send_message("say Erro interno: Jogador nÃƒÂ£o encontrado.");
        return false;
    }
    
    // Verificar se este jogador colocou recompensa no alvo
    if(players[canceller_index].bounty_target != target_name) {
        player.send_message("say VocÃƒÂª nÃƒÂ£o colocou recompensa em " + target_name + ".");
        return false;
    }
    
    // Tentar cancelar
    if(cancel_bounty(canceller_index, target_name)) {
        int target_index = get_player_index_from(target_name);
        
        player.send_message("say Ã¢Å“â€¦ Recompensa cancelada! VocÃƒÂª recebeu de volta 50% do valor.");
        
        // Notificar o alvo se estiver online
        if(target_index >= 0) {
            send_reliable_text(players[target_index].peer_id, 
                "msg2 A recompensa na sua cabeÃƒÂ§a colocada por " + player.charname + " foi cancelada!", 0);
        }
        
        debug_log("BOUNTY CANCELADO: " + player.charname + " cancelou bounty em " + target_name);
        return true;
    } else {
        player.send_message("say NÃƒÂ£o foi possÃƒÂ­vel cancelar a recompensa. O jogador pode estar offline.");
        return false;
    }
}

// Comando /listbounties - Listar todos jogadores com recompensa
bool cmd_listbounties(player@ player, string[] args) {
    string[] bounties = list_all_bounties();
    
    if(bounties.length() == 0) {
        player.send_message("say NÃƒÂ£o hÃƒÂ¡ jogadores com recompensa na cabeÃƒÂ§a no momento.");
        return true;
    }
    
    player.send_message("say === Ã°Å¸â€™Â° LISTA DE RECOMPENSAS (" + bounties.length() + ") ===");
    
    for(uint i = 0; i < bounties.length(); i++) {
        player.send_message("say " + (i+1) + ". " + bounties[i]);
    }
    
    return true;
}

// =========================================================
// Ã¢Å“â€¦ Task 1.4.1: SISTEMA DE LOJAS NPC - HANDLERS DE COMPRA
// =========================================================
// Este mÃƒÂ³dulo implementa a validaÃƒÂ§ÃƒÂ£o encadeada para garantir
// integridade econÃƒÂ´mica nas transaÃƒÂ§ÃƒÂµes de compra de NPC.
// =========================================================

// Comando /buy (formato amigÃƒÂ¡vel) - Comprar item de loja
bool cmd_buy(player@ player, string[] args) {
    if(args.length() < 2) {
        player.send_message("say Uso: /buy <item> <quantidade>");
        player.send_message("say Exemplo: /buy espada 1");
        return false;
    }
    
    string item_name = args[0];
    int quantity = string_to_number(args[1]);
    
    // Converter para formato interno e processar
    string[] internal_args = {string(quantity), item_name};
    return cmd_buy_internal(player, internal_args);
}

// Comando /buy123321123 (formato interno do cliente) - Handler Principal de Compra
// IMPLEMENTAÃƒâ€¡ÃƒÆ’O CRÃƒÂTICA: ValidaÃƒÂ§ÃƒÂ£o Encadeada para SeguranÃƒÂ§a EconÃƒÂ´mica
bool cmd_buy_internal(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro interno: Jogador nÃƒÂ£o encontrado.");
        return false;
    }
    
    // --- VALIDAÃƒâ€¡ÃƒÆ’O 1: Dados de Entrada ---
    if(args.length() < 2) {
        player.send_message("say Dados de compra invÃƒÂ¡lidos.");
        return false;  // InterrupÃƒÂ§ÃƒÂ£o: Dados de entrada invÃƒÂ¡lidos
    }
    
    int quantity = string_to_number(args[0]);
    string item_name = args[1];
    
    if(quantity <= 0) {
        player.send_message("say Quantidade invÃƒÂ¡lida. Use um valor maior que zero.");
        return false;  // InterrupÃƒÂ§ÃƒÂ£o: Quantidade invÃƒÂ¡lida
    }
    
    // --- VALIDAÃƒâ€¡ÃƒÆ’O 2: Item Existe na Loja ---
    int store_index = item_exists_for_sale(item_name);
    if(store_index < 0) {
        player.send_message("say Item '" + item_name + "' nÃƒÂ£o encontrado na loja.");
        return false;  // InterrupÃƒÂ§ÃƒÂ£o: Item nÃƒÂ£o existe
    }
    
    // Obter dados do item da loja
    double unit_price = items_sale[store_index].price;
    string currency_type = items_sale[store_index].money;
    double total_cost = unit_price * quantity;
    
    // --- VALIDAÃƒâ€¡ÃƒÆ’O 3: Moeda Suficiente (Primeira Camada de SeguranÃƒÂ§a) ---
    bool has_funds = false;
    string currency_name = "";
    
    if(currency_type == "stryx") {
        has_funds = players[player_index].has_stryx(total_cost);
        currency_name = "Stryx";
    }
    else if(currency_type == "creditos") {
        has_funds = players[player_index].has_credits(total_cost);
        currency_name = "CrÃƒÂ©ditos";
    }
    else if(currency_type == "saldo" || currency_type == "dinheiro" || currency_type == "reais") {
        has_funds = players[player_index].has_money(total_cost);
        currency_name = "Reais";
    }
    else {
        // Moeda ÃƒÂ© um item do inventÃƒÂ¡rio (ex: euro, coins, etc.)
        has_funds = players[player_index].inv_item_number(currency_type) >= int(total_cost);
        currency_name = currency_type;
    }
    
    if(!has_funds) {
        player.send_message("say " + currency_name + " insuficiente. Requer: " + total_cost + " " + currency_name);
        return false;  // InterrupÃƒÂ§ÃƒÂ£o: Falha na Economia (Camada 1)
    }
    
    // --- VALIDAÃƒâ€¡ÃƒÆ’O 4: EspaÃƒÂ§o no InventÃƒÂ¡rio (Segunda Camada de SeguranÃƒÂ§a) ---
    // Verificar limite de slots do inventÃƒÂ¡rio
    int current_items = int(players[player_index].inv.get_keys().length());
    bool item_exists = players[player_index].inv_item_exists(item_name);
    
    // Se o item nÃƒÂ£o existe no inventÃƒÂ¡rio e jÃƒÂ¡ estÃƒÂ¡ no limite de slots
    if(!item_exists && current_items >= players[player_index].max_inventory_slots) {
        player.send_message("say InventÃƒÂ¡rio cheio! VocÃƒÂª nÃƒÂ£o tem mais slots disponÃƒÂ­veis.");
        player.send_message("say Slots: " + current_items + "/" + players[player_index].max_inventory_slots);
        return false;  // InterrupÃƒÂ§ÃƒÂ£o: Falha no InventÃƒÂ¡rio (Camada 2)
    }
    
    // --- EXECUÃƒâ€¡ÃƒÆ’O DA TRANSAÃƒâ€¡ÃƒÆ’O (Sucesso apÃƒÂ³s todas validaÃƒÂ§ÃƒÂµes) ---
    // A transaÃƒÂ§ÃƒÂ£o sÃƒÂ³ ÃƒÂ© executada se TODAS as validaÃƒÂ§ÃƒÂµes passarem
    
    // AÃƒÂ§ÃƒÂ£o 1: Subtrair a moeda correta
    if(currency_type == "stryx") {
        players[player_index].remove_stryx(total_cost);
    }
    else if(currency_type == "creditos") {
        players[player_index].remove_credits(total_cost);
    }
    else if(currency_type == "saldo" || currency_type == "dinheiro" || currency_type == "reais") {
        players[player_index].remove_money(total_cost, "compra de " + quantity + "x " + item_name);
    }
    else {
        // Item como moeda
        players[player_index].inv_add_item(currency_type, -int(total_cost), true);
    }
    
    // AÃƒÂ§ÃƒÂ£o 2: Adicionar o item ao inventÃƒÂ¡rio
    players[player_index].inv_add_item(item_name, quantity, true);
    
    // --- FEEDBACK E LOG ---
    player.send_message("say Ã¢Å“â€¦ Compra realizada com sucesso!");
    player.send_message("say Ã°Å¸â€œÂ¦ VocÃƒÂª comprou " + quantity + "x " + item_name);
    player.send_message("say Ã°Å¸â€™Â° Total: " + total_cost + " " + currency_name);
    
    // Salvar jogador apÃƒÂ³s transaÃƒÂ§ÃƒÂ£o
    save_player_to_database(players[player_index]);
    
    // Log para auditoria
    debug_log("COMPRA: " + player.charname + " comprou " + quantity + "x " + item_name + 
              " por " + total_cost + " " + currency_name);
    log_to_database("INFO", "ECONOMY", "Compra: " + quantity + "x " + item_name + 
                    " por " + total_cost + " " + currency_name, player_index, player.charname);
    
    return true;
}

// Comando /buy2123321123 - Compra de Itens Especiais (Explosivos, etc.)
// Mesmo padrÃƒÂ£o de validaÃƒÂ§ÃƒÂ£o encadeada
bool cmd_buy_special(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro interno: Jogador nÃƒÂ£o encontrado.");
        return false;
    }
    
    // --- VALIDAÃƒâ€¡ÃƒÆ’O 1: Dados de Entrada ---
    if(args.length() < 2) {
        player.send_message("say Dados de compra invÃƒÂ¡lidos.");
        return false;
    }
    
    int quantity = string_to_number(args[0]);
    string item_name = args[1];
    
    if(quantity <= 0) {
        player.send_message("say Quantidade invÃƒÂ¡lida.");
        return false;
    }
    
    // --- PREÃƒâ€¡OS ESPECIAIS (Loja de Explosivos) ---
    // Esses itens tÃƒÂªm preÃƒÂ§os fixos em "euro" (moeda do inventÃƒÂ¡rio)
    dictionary special_prices;
    special_prices.set("mina", 20);
    special_prices.set("bomba_relÃƒÂ³gio", 100);
    special_prices.set("bomba_remota", 200);
    special_prices.set("mÃƒÂ­ssil_teleguiado", 200);
    special_prices.set("max_bomba", 250);
    special_prices.set("bomba_de_fogo", 250);
    special_prices.set("bomba_atÃƒÂ´mica", 300);
    special_prices.set("mega_laser", 5000);
    special_prices.set("sub_laser", 100000);
    special_prices.set("cuernitoarmani", 1000000);
    special_prices.set("galil", 100000);
    special_prices.set("mÃƒÂ­ssil", 15);
    special_prices.set("laser", 5);
    special_prices.set("7.62mm", 3);
    special_prices.set("5.56mm", 2);
    special_prices.set("9mm", 2);
    
    // --- VALIDAÃƒâ€¡ÃƒÆ’O 2: Item Existe ---
    if(!special_prices.exists(item_name)) {
        player.send_message("say Item especial '" + item_name + "' nÃƒÂ£o encontrado.");
        return false;
    }
    
    int unit_price;
    special_prices.get(item_name, unit_price);
    int total_cost = unit_price * quantity;
    
    // --- VALIDAÃƒâ€¡ÃƒÆ’O 3: Moeda Suficiente (Euro do InventÃƒÂ¡rio) ---
    int player_euros = players[player_index].inv_item_number("euro");
    if(player_euros < total_cost) {
        player.send_message("say Euros insuficientes. Requer: " + total_cost + " euro");
        player.send_message("say VocÃƒÂª tem: " + player_euros + " euro");
        return false;
    }
    
    // --- VALIDAÃƒâ€¡ÃƒÆ’O 4: EspaÃƒÂ§o no InventÃƒÂ¡rio ---
    int current_items = int(players[player_index].inv.get_keys().length());
    bool item_exists = players[player_index].inv_item_exists(item_name);
    
    if(!item_exists && current_items >= players[player_index].max_inventory_slots) {
        player.send_message("say InventÃƒÂ¡rio cheio!");
        return false;
    }
    
    // --- EXECUÃƒâ€¡ÃƒÆ’O DA TRANSAÃƒâ€¡ÃƒÆ’O ---
    players[player_index].inv_add_item("euro", -total_cost, true);
    players[player_index].inv_add_item(item_name, quantity, true);
    
    // --- FEEDBACK ---
    player.send_message("say Ã¢Å“â€¦ Compra especial realizada!");
    player.send_message("say Ã°Å¸â€™Â£ VocÃƒÂª comprou " + quantity + "x " + item_name);
    player.send_message("say Ã°Å¸â€™Â° Total: " + total_cost + " euro");
    
    save_player_to_database(players[player_index]);
    
    debug_log("COMPRA ESPECIAL: " + player.charname + " comprou " + quantity + "x " + item_name + 
              " por " + total_cost + " euro");
    
    return true;
}

// Comando /store - Abrir Menu de Loja (envia lista de itens para cliente)
bool cmd_store(player@ player, string[] args) {
    if(items_sale.length() == 0) {
        player.send_message("say NÃƒÂ£o hÃƒÂ¡ itens disponÃƒÂ­veis na loja no momento.");
        return true;
    }
    
    // Montar lista de itens para o cliente
    string store_list = "";
    for(uint i = 0; i < items_sale.length(); i++) {
        if(i > 0) store_list += "\r\n";
        // Formato: "item, preÃƒÂ§o moeda - descriÃƒÂ§ÃƒÂ£o"
        store_list += items_sale[i].item + ", " + items_sale[i].price + " " + 
                      items_sale[i].money + " - " + items_sale[i].description;
    }
    
    // Enviar lista para o cliente abrir o menu
    send_reliable_text(player.peer_id, "store " + store_list, 0);
    
    debug_log("STORE: " + player.charname + " abriu loja com " + items_sale.length() + " itens");
    return true;
}

// Comando /sell - Vender Item para Loja
bool cmd_sell(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro interno: Jogador nÃƒÂ£o encontrado.");
        return false;
    }
    
    if(args.length() < 2) {
        player.send_message("say Uso: /sell <item> <quantidade>");
        return false;
    }
    
    string item_name = args[0];
    int quantity = string_to_number(args[1]);
    
    if(quantity <= 0) {
        player.send_message("say Quantidade invÃƒÂ¡lida.");
        return false;
    }
    
    // Verificar se jogador tem o item
    int player_quantity = players[player_index].inv_item_number(item_name);
    if(player_quantity < quantity) {
        player.send_message("say VocÃƒÂª nÃƒÂ£o tem " + quantity + "x " + item_name + ".");
        player.send_message("say VocÃƒÂª tem: " + player_quantity + "x " + item_name);
        return false;
    }
    
    // Verificar se item estÃƒÂ¡ na loja (para obter preÃƒÂ§o de venda)
    int store_index = item_exists_for_sale(item_name);
    double sell_price = 0;
    string currency_type = "saldo";
    
    if(store_index >= 0) {
        // Item existe na loja - vende por 50% do preÃƒÂ§o de compra
        sell_price = items_sale[store_index].price * 0.5;
        currency_type = items_sale[store_index].money;
    } else {
        // Item nÃƒÂ£o estÃƒÂ¡ na loja - preÃƒÂ§o base
        sell_price = 1;  // 1 real por item genÃƒÂ©rico
    }
    
    double total_value = sell_price * quantity;
    
    // Executar venda
    players[player_index].inv_add_item(item_name, -quantity, true);
    
    // Adicionar moeda
    if(currency_type == "stryx") {
        players[player_index].add_stryx(total_value);
    }
    else if(currency_type == "creditos") {
        players[player_index].add_credits(total_value);
    }
    else {
        players[player_index].add_money(total_value, "venda de " + quantity + "x " + item_name);
    }
    
    player.send_message("say Ã¢Å“â€¦ Venda realizada!");
    player.send_message("say Ã°Å¸â€œÂ¦ VocÃƒÂª vendeu " + quantity + "x " + item_name);
    player.send_message("say Ã°Å¸â€™Â° Recebeu: " + total_value + " " + currency_type);
    
    save_player_to_database(players[player_index]);
    
    debug_log("VENDA: " + player.charname + " vendeu " + quantity + "x " + item_name + 
              " por " + total_value + " " + currency_type);
    
    return true;
}


