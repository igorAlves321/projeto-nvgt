bool cmd_score(player@ player, string[] args) {
    string stats = "=== ESTATÍSTICAS ===\n";
    stats += "Nome: " + player.name + "\n";
    stats += "Nível: " + player.player_level + "\n";
    stats += "Experiência: " + player.exp + "\n";
    stats += "Ouro: " + player.gold + "\n";
    stats += "Vida: " + player.hp + "/" + player.max_hp + "\n";
    stats += "Mana: " + player.mp + "/" + player.max_mp + "\n";
    stats += "Raça: " + player.race + "\n";
    stats += "Localização: " + player.map_name + " (" + player.x + "," + player.y + "," + player.z + ")";
    
    player.send_message("say " + stats);
    return true;
}

