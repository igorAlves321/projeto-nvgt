    register_command("unban", "Remover ban", true, {"pardon"}, "unban <jogador>");
    register_command("mute", "Silenciar jogador", true, {"silence"}, "mute <jogador> [tempo]");
    register_command("unmute", "Remover silêncio", true, {"unsilence"}, "unmute <jogador>");
    
    // Teleporte e movimento
    register_command("goto", "Teletransportar para jogador", true, {"tp", "teleport"}, "goto <jogador>");
    register_command("summon", "Chamar jogador até você", true, {"bring"}, "summon <jogador>");
    register_command("move", "Mover jogador", true, {}, "move <jogador> <x> <y> [z]");
    register_command("changemap", "Mover jogador para mapa", true, {}, "changemap <jogador> <mapa> [x] [y] [z]");
    
