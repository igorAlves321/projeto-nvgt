// Registrar um comando
void register_command(string name, string description, bool admin_only = false, 
                     string[] aliases = {}, string usage = "") {
    ServerCommand@ cmd = ServerCommand(name, description, admin_only);
    cmd.aliases = aliases;
    cmd.usage = (usage != "") ? usage : name;
    
    // NVGT: Armazenar como handle no dictionary
    registered_commands.set(name, @cmd);
    
    // Registrar aliases
    for(uint i = 0; i < aliases.length(); i++) {
        command_aliases[aliases[i]] = name;
    }
}

// Resolver comando (incluindo aliases)
string resolve_command(string input) {
    if(registered_commands.exists(input)) {
        return input;
    }
    
    if(command_aliases.exists(input)) {
        string real_name;
        command_aliases.get(input, real_name);
        return real_name;
    }
    
    return "";
}

// Verificar se jogador pode usar comando
bool can_use_command(player@ player, string command_name) {
    if(!registered_commands.exists(command_name)) {
        return false;
    }
    
    ServerCommand@ cmd;
    registered_commands.get(command_name, @cmd);
    if(cmd is null) return false;
    
    if(cmd.admin_only && !player.admin_status) {
        return false;
    }
    
    return true;
}

// Processar comando completo
bool process_command(player@ player, string full_command) {
    if(player is null || full_command == "") return false;
    
    string[] parts = full_command.split(" ");
    if(parts.length() == 0) return false;
    
    string command_name = parts[0].lower();
    string[] args;
    
    // Extrair argumentos
    for(uint i = 1; i < parts.length(); i++) {
        args.push_back(parts[i]);
    }
    
    // Resolver comando (verificar aliases)
    string resolved = resolve_command(command_name);
    if(resolved == "") {
        player.send_message("say Comando não reconhecido: " + command_name);
        return false;
    }
    
    // Verificar permissões
    if(!can_use_command(player, resolved)) {
        player.send_message("say Você não tem permissão para usar este comando.");
        return false;
    }
    
    // Executar comando
    return execute_command(player, resolved, args);
}

// Executar comando específico
bool execute_command(player@ player, string command, string[] args) {
    // Comandos básicos
    if(command == "help") {
        return cmd_help(player, args);
    }
    else if(command == "who") {
        return cmd_who(player, args);
    }
    else if(command == "time") {
        return cmd_time(player, args);
    }
    else if(command == "save") {
        return cmd_save(player, args);
    }
    else if(command == "quit") {
        return cmd_quit(player, args);
    }
    else if(command == "pm") {
        return cmd_pm(player, args);
    }
    else if(command == "say") {
        return cmd_say(player, args);
    }
    else if(command == "inventory") {
        return cmd_inventory(player, args);
    }
    else if(command == "score") {
        return cmd_score(player, args);
    }
    
    // Comandos de admin
    else if(command == "freeze") {
        return cmd_freeze(player, args);
    }
    else if(command == "backup") {
        return cmd_backup(player, args);
    }
    else if(command == "broadcast") {
        return cmd_broadcast(player, args);
    }
    else if(command == "kick") {
        return cmd_kick(player, args);
    }
    else if(command == "player_info") {
        return cmd_player_info(player, args);
    }
    else if(command == "server_info") {
        return cmd_server_info(player, args);
    }
    else if(command == "pickup") {
        return cmd_pickup(player, args);
    }
    else if(command == "spawn_item") {
        return cmd_spawn_item(player, args);
    }
    else if(command == "list_items") {
        return cmd_list_items(player, args);
    }
    else if(command == "item_info") {
        return cmd_item_info(player, args);
    }
    else if(command == "statistics") {
        return cmd_statistics(player, args);
    }
    else if(command == "history") {
        return cmd_history(player, args);
    }
    // Comandos de combate
    else if(command == "attack" || command == "atacar") {
        return cmd_attack(player, args);
    }
    else if(command == "defend" || command == "defender") {
        return cmd_defend(player, args);
    }
    else if(command == "flee" || command == "fugir") {
        return cmd_flee(player, args);
    }
    else if(command == "combat_status" || command == "status_combate") {
        return cmd_combat_status(player, args);
    }
    
    // Comando não implementado ainda
    player.send_message("say Comando '" + command + "' reconhecido mas não implementado ainda.");
    return false;
}

// === IMPLEMENTAÇÃO DOS COMANDOS ===

bool cmd_help(player@ player, string[] args) {
    string[] command_list;
    string[] admin_list;
    
    string[] keys = registered_commands.get_keys();
    for(uint i = 0; i < keys.length(); i++) {
        ServerCommand@ cmd;
        registered_commands.get(keys[i], @cmd);
        if(cmd is null) continue;
        
        if(cmd.admin_only) {
            if(player.admin_status) {
                admin_list.push_back(cmd.name + " - " + cmd.description);
            }
        } else {
            command_list.push_back(cmd.name + " - " + cmd.description);
        }
    }
    
    player.send_message("say === COMANDOS DISPONÍVEIS ===");
    for(uint i = 0; i < command_list.length(); i++) {
        player.send_message("say " + command_list[i]);
    }
    
    if(admin_list.length() > 0) {
        player.send_message("say === COMANDOS DE ADMINISTRADOR ===");
        for(uint i = 0; i < admin_list.length(); i++) {
            player.send_message("say " + admin_list[i]);
        }
    }
    
    return true;
}

