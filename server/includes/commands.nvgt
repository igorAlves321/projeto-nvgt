bool cmd_broadcast(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: broadcast <mensagem>");
        return false;
    }
    
    string message = join(args, " ");
    server_broadcast("announce [ANÚNCIO] " + message);
    return true;
}

bool cmd_kick(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: kick <jogador> [motivo]");
        return false;
    }
    
    string target_name = args[0];
    string reason = "Sem motivo especificado";
    if(args.length() > 1) {
        reason = join(nvgt_split(join(args, " "), " "), " ");
    }
    
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        player.send_message("say Jogador '" + target_name + "' não encontrado.");
        return false;
    }
    
    target.send_message("say Você foi expulso pelo administrador " + player.name + ". Motivo: " + reason);
    server_broadcast("say " + target_name + " foi expulso por " + player.name);
    
    // TODO: Implementar desconexão forçada
    return true;
}

bool cmd_player_info(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: player_info <jogador>");
        return false;
    }
    
    string target_name = args[0];
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        player.send_message("say Jogador '" + target_name + "' não encontrado.");
        return false;
    }
    
    string info = "=== INFORMAÇÕES DO JOGADOR ===\n";
    info += "Nome: " + target.name + "\n";
    info += "Nível: " + target.player_level + " (EXP: " + target.exp + ")\n";
    info += "Vida: " + target.hp + "/" + target.max_hp + "\n";
    info += "Mana: " + target.mp + "/" + target.max_mp + "\n";
    info += "Ouro: " + target.gold + "\n";
    info += "Localização: " + target.map_name + " (" + target.x + "," + target.y + "," + target.z + ")\n";
    info += "Admin: " + (target.admin_status ? "Sim" : "Não") + "\n";
    info += "Status: " + target.status;
    
    player.send_message("say " + info);
    return true;
}

bool cmd_pickup(player@ player, string[] args) {
    WorldItem@ item = get_item_at_position(player.map_name, player.x, player.y, player.z);
    if(item is null) {
        player.send_message("say Não há itens nesta posição.");
        return false;
    }
    
    GameItem@ game_item = get_item_by_id(item.item_id);
    if(game_item is null) {
        player.send_message("say Item inválido encontrado.");
        return false;
    }
    
    if(pickup_item_at(player.name, player.map_name, player.x, player.y, player.z)) {
        player.send_message("say Você pegou " + game_item.display_name + " (x" + item.quantity + ").");
        log_action(player.name, "pickup", "Pegou " + game_item.display_name + " (x" + item.quantity + ")", 
                   player.map_name, player.x, player.y, player.z);
        update_statistics("item_collect");
        return true;
    } else {
        player.send_message("say Falha ao pegar o item.");
        return false;
    }
}

bool cmd_spawn_item(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: spawn_item <item> [quantidade] [x] [y] [z]");
        return false;
    }
    
    string item_name = args[0];
    int quantity = 1;
    int x = player.x, y = player.y, z = player.z;
    
    if(args.length() > 1) quantity = string_to_number(args[1]);
    if(args.length() > 2) x = string_to_number(args[2]);
    if(args.length() > 3) y = string_to_number(args[3]);
    if(args.length() > 4) z = string_to_number(args[4]);
    
    if(spawn_item_at(item_name, player.map_name, x, y, z, quantity, "admin:" + player.name)) {
        player.send_message("say Item " + item_name + " (x" + quantity + ") spawnado em (" + x + "," + y + "," + z + ").");
        log_action(player.name, "spawn_item", "Admin spawnou " + item_name + " (x" + quantity + ")", 
                   player.map_name, x, y, z);
        update_statistics("item_spawn");
        return true;
    } else {
        player.send_message("say Falha ao spawnar item " + item_name + ". Verifique se o item existe.");
        return false;
    }
}

bool cmd_list_items(player@ player, string[] args) {
    string[] items_list;
    string[] keys = items_database.get_keys();
    
    for(uint i = 0; i < keys.length(); i++) {
        GameItem@ item;
        items_database.get(keys[i], @item);
        if(item !is null) {
            items_list.push_back(item.name + " - " + item.display_name + " (" + item.item_type + ")");
        }
    }
    
    if(items_list.length() == 0) {
        player.send_message("say Nenhum item cadastrado no sistema.");
        return false;
    }
    
    player.send_message("say === LISTA DE ITENS ===\nTotal: " + items_list.length() + " itens");
    for(uint i = 0; i < items_list.length(); i++) {
        player.send_message("say " + items_list[i]);
    }
    
    return true;
}

bool cmd_item_info(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: item_info <item>");
        return false;
    }
    
    string item_name = args[0];
    GameItem@ item = get_item_by_name(item_name);
    if(item is null) {
        player.send_message("say Item '" + item_name + "' não encontrado.");
        return false;
    }
    
    string info = "=== INFORMAÇÕES DO ITEM ===\n";
    info += "Nome: " + item.name + "\n";
    info += "Nome de exibição: " + item.display_name + "\n";
    info += "Descrição: " + item.description + "\n";
    info += "Tipo: " + item.item_type + " / " + item.category + "\n";
    info += "Raridade: " + item.rarity + "\n";
    
    if(item.damage > 0) info += "Dano: " + item.damage + "\n";
    if(item.defense > 0) info += "Defesa: " + item.defense + "\n";
    if(item.heal_amount > 0) info += "Cura: " + item.heal_amount + "\n";
    if(item.mp_restore > 0) info += "Restaura MP: " + item.mp_restore + "\n";
    
    info += "Empilhável: " + (item.stackable ? "Sim" : "Não") + "\n";
    if(item.stackable) info += "Máx por pilha: " + item.max_stack + "\n";
    info += "Peso: " + item.weight + "\n";
    info += "Valor: " + item.value + " moedas\n";
    info += "Comercializável: " + (item.tradeable ? "Sim" : "Não") + "\n";
    info += "Vendível: " + (item.sellable ? "Sim" : "Não");
    
    player.send_message("say " + info);
    return true;
}

bool cmd_statistics(player@ player, string[] args) {
    string stats = get_current_statistics_report();
    player.send_message("say " + stats);
    return true;
}

bool cmd_history(player@ player, string[] args) {
    string player_filter = "";
    string action_filter = "";
    int limit = 20;
    
    if(args.length() > 0) player_filter = args[0];
    if(args.length() > 1) action_filter = args[1];
    if(args.length() > 2) limit = string_to_number(args[2]);
    
    string[] history = get_recent_actions(limit, action_filter, player_filter);
    
    if(history.length() == 0) {
        player.send_message("say Nenhum histórico encontrado com os filtros especificados.");
        return false;
    }
    
    player.send_message("say === HISTÓRICO DE AÇÕES ===\nMostrando " + history.length() + " entradas:");
    for(uint i = 0; i < history.length(); i++) {
        player.send_message("say " + history[i]);
    }
    
    return true;
}

// Comandos de Combate
bool cmd_attack(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: attack <jogador> [arma]");
        return false;
    }
    
    string target_name = args[0];
    string weapon = args.length() > 1 ? args[1] : "";
    
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        player.send_message("say Jogador '" + target_name + "' não encontrado.");
        return false;
    }
    
    if(target.name == player.name) {
        player.send_message("say Você não pode atacar a si mesmo!");
        return false;
    }
    
    // Verificar se estão no mesmo mapa e próximos
    if(target.map_name != player.map_name) {
        player.send_message("say O jogador não está no mesmo mapa que você.");
        return false;
    }
    
    int distance = abs(target.x - player.x) + abs(target.y - player.y) + abs(target.z - player.z);
    if(distance > 2) {
        player.send_message("say Você precisa estar mais próximo para atacar.");
        return false;
    }
    
    // Verificar se já está em combate
    if(is_player_in_combat(player.name)) {
        // Se já está em combate com este jogador, executar ataque
        if(execute_attack(player.name, target.name, weapon)) {
            return true;
        } else {
            player.send_message("say Falha ao executar ataque.");
            return false;
        }
    } else {
        // Iniciar novo combate
        if(start_combat(player.name, target.name)) {
            // Executar primeiro ataque
            execute_attack(player.name, target.name, weapon);
            return true;
        } else {
            if(is_player_in_combat(target.name)) {
                player.send_message("say " + target_name + " já está em combate com outro jogador.");
            } else {
                player.send_message("say Não foi possível iniciar o combate.");
            }
            return false;
        }
    }
}

bool cmd_defend(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say Você não está em combate.");
        return false;
    }
    
    // Implementar defesa (reduz dano do próximo ataque)
    // TODO: Implementar sistema de defesa temporária
    player.send_message("say Você se preparou para defender!");
    
    log_action(player.name, "defend", "Jogador se defendeu", 
               player.map_name, player.x, player.y, player.z);
    
    return true;
}

bool cmd_flee(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say Você não está em combate.");
        return false;
    }
    
    if(attempt_flee(player.name)) {
        return true;
    } else {
        player.send_message("say Você não conseguiu fugir! Tente novamente na próxima rodada.");
        return false;
    }
}

bool cmd_combat_status(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say Você não está em combate.");
        return false;
    }
    
    CombatInstance@ combat = cast<CombatInstance@>(combat_instances[player.name]);
    if(combat is null) {
        player.send_message("say Erro: Dados de combate não encontrados.");
        return false;
    }
    
    string opponent_id = combat.attacker_id == player.name ? combat.defender_id : combat.attacker_id;
    player@ opponent = get_player_by_id(opponent_id);
    
    if(opponent !is null) {
        uint64 combat_duration = (get_time_stamp() - combat.start_time) / 1000;
        string status = "=== STATUS DO COMBATE ===\n";
        status += "Oponente: " + opponent.name + "\n";
        status += "Sua vida: " + player.hp + "/" + player.max_hp + "\n";
        status += "Vida do oponente: " + opponent.hp + "/" + opponent.max_hp + "\n";
        status += "Duração: " + combat_duration + " segundos\n";
        status += "Status: " + combat.battle_status;
        
        player.send_message("say " + status);
    }
    
    return true;
}
