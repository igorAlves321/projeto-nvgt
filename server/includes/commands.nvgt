    }
    else if(command == "matarpet") {
        if(args.length() < 1) {
            player.send_message("say Uso: /matarpet <jogador>");
            return false;
        }
        cmd_matarpet(player_index, args[0]);
        return true;
    }
    else if(command == "clima" || command == "weather") {
        cmd_clima(player_index);
        return true;
    }
    else if(command == "setclima" || command == "forcarclima") {
        string[] parsed;
        parsed.insert_last("/setclima");
        for(uint i = 0; i < args.length(); i++) {
            parsed.insert_last(args[i]);
        }
        cmd_setclima(player_index, parsed);
        return true;
    }
    else if(command == "climamapa" || command == "mapclima") {
        string[] parsed;
        parsed.insert_last("/climamapa");
        for(uint i = 0; i < args.length(); i++) {
            parsed.insert_last(args[i]);
        }
        cmd_climamapa(player_index, parsed);
        return true;
    }
    else if(command == "mudarsenha") {
        if(args.length() < 2) {
            player.send_message("say Uso: /mudarsenha <senha_atual> <senha_nova>");
            return false;
        }
        cmd_mudarsenha(player_index, args[0], args[1]);
        return true;
    }
    else if(command == "resetarsenha") {
        if(args.length() < 1) {
            player.send_message("say Uso: /resetarsenha <jogador>");
            return false;
        }
        cmd_resetarsenha(player_index, args[0]);
        return true;
    }
    else if(command == "infoconta") {
        if(args.length() < 1) {
            player.send_message("say Uso: /infoconta <jogador>");
            return false;
        }
        cmd_infoconta(player_index, args[0]);
        return true;
    }
    else if(command == "arquivarconta") {
        if(args.length() < 1) {
            player.send_message("say Uso: /arquivarconta <jogador>");
            return false;
        }
        cmd_arquivarconta(player_index, args[0]);
        return true;
    }
    else if(command == "restaurarconta") {
        if(args.length() < 1) {
            player.send_message("say Uso: /restaurarconta <jogador>");
            return false;
        }
        cmd_restaurarconta(player_index, args[0]);
        return true;
    }
    else if(command == "excluirconta") {
        if(args.length() < 1) {
            player.send_message("say Uso: /excluirconta <jogador> CONFIRMAR");
            return false;
        }
        string confirmacao_conta = args.length() > 1 ? args[1] : "";
        cmd_excluirconta(player_index, args[0], confirmacao_conta);
        return true;
    }
    else if(command == "contasdodispositivo") {
        if(args.length() < 1) {
            player.send_message("say Uso: /contasdodispositivo <jogador>");
            return false;
        }
        cmd_contasdodispositivo(player_index, args[0]);
        return true;
    }
    else if(command == "purgarcontas") {
        bool simular_purga = false;
        if(args.length() > 0) {
            string modo_purga = args[0].lower();
            if(modo_purga == "simular" || modo_purga == "simulate" || modo_purga == "teste") simular_purga = true;
        }
        cmd_purgarcontas(player_index, simular_purga);
        return true;
    }
    player.send_message("say Comando '" + command + "' reconhecido mas Nao implementado ainda.");
    return false;
}
bool cmd_freeze(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro: jogador não encontrado.");
        return false;
    }
    cmd_freeze(player_index);
    return true;
}
bool cmd_backup(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro: jogador não encontrado.");
        return false;
    }
    cmd_backup(player_index);
    return true;
}
bool cmd_broadcast(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: broadcast <mensagem>");
        return false;
    }
    string message = join(args, " ");
    server_broadcast("announce [ANÚNCIO] " + message);
    return true;
}
bool cmd_kick(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: kick <jogador> [motivo]");
        return false;
    }
    string target_name = args[0];
    string reason = "Sem motivo especificado";
    if(args.length() > 1) {
        reason = "";
        for(uint i = 1; i < args.length(); i++) {
            if(i > 1) reason += " ";
            reason += args[i];
        }
    }
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        player.send_message("say Jogador '" + target_name + "' não encontrado.");
        return false;
    }
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro: jogador não encontrado.");
        return false;
    }
    cmd_kick(player_index, target_name, reason);
    return true;
}
bool cmd_player_info(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: player_info <jogador>");
        return false;
    }
    string target_name = args[0];
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        player.send_message("say Jogador '" + target_name + "' Nao encontrado.");
        return false;
    }
    string info = "=== INFORMACOES DO JOGADOR ===\n";
    info += "Nome: " + target.name + "\n";
    info += "Nivel: " + target.player_level + " (EXP: " + target.exp + ")\n";
    info += "Vida: " + target.hp + "/" + target.max_hp + "\n";
    info += "Mana: " + target.mp + "/" + target.max_mp + "\n";
    info += "Ouro: " + target.gold + "\n";
    info += "Localizacaoo: " + target.map_name + " (" + target.x + "," + target.y + "," + target.z + ")\n";
    info += "Admin: " + (target.admin_status ? "Sim" : "Nao") + "\n";
    info += "Status: " + target.status;
    player.send_message("say " + info);
    return true;
}
bool cmd_pickup(player@ player, string[] args) {
    WorldItem@ item = get_item_at_position(player.map_name, player.x, player.y, player.z);
    if(item is null) {
        player.send_message("say Nao ha itens nesta posicao.");
        return false;
    }
    GameItem@ game_item = get_item_by_id(item.item_id);
    if(game_item is null) {
        player.send_message("say Item invalido encontrado.");
        return false;
    }
    if(pickup_item_at(player.name, player.map_name, player.x, player.y, player.z)) {
        player.send_message("say Vocpegou " + game_item.display_name + " (x" + item.quantity + ").");
        log_action(player.name, "pickup", "Pegou " + game_item.display_name + " (x" + item.quantity + ")",
                   player.map_name, player.x, player.y, player.z);
        update_statistics("item_collect");
        return true;
    } else {
        player.send_message("say Falha ao pegar o item.");
        return false;
    }
}
bool cmd_spawn_item(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: spawn_item <item> [quantidade] [x] [y] [z]");
        return false;
    }
    string item_name = args[0];
    int quantity = 1;
    int x = player.x, y = player.y, z = player.z;
    if(args.length() > 1) quantity = string_to_number(args[1]);
    if(args.length() > 2) x = string_to_number(args[2]);
    if(args.length() > 3) y = string_to_number(args[3]);
    if(args.length() > 4) z = string_to_number(args[4]);
    if(spawn_item_at(item_name, player.map_name, x, y, z, quantity, "admin:" + player.name)) {
        player.send_message("say Item " + item_name + " (x" + quantity + ") spawnado em (" + x + "," + y + "," + z + ").");
        log_action(player.name, "spawn_item", "Admin spawnou " + item_name + " (x" + quantity + ")",
                   player.map_name, x, y, z);
        update_statistics("item_spawn");
        return true;
    } else {
        player.send_message("say Falha ao spawnar item " + item_name + ". Verifique se o item existe.");
        return false;
    }
}
bool cmd_list_items(player@ player, string[] args) {
    string[] items_list;
    string[] keys = items_database.get_keys();
    for(uint i = 0; i < keys.length(); i++) {
        GameItem@ item;
        items_database.get(keys[i], @item);
        if(item !is null) {
            items_list.push_back(item.name + " - " + item.display_name + " (" + item.item_type + ")");
        }
    }
    if(items_list.length() == 0) {
        player.send_message("say Nenhum item cadastrado no sistema.");
        return false;
    }
    player.send_message("say === LISTA DE ITENS ===\nTotal: " + items_list.length() + " itens");
    for(uint i = 0; i < items_list.length(); i++) {
        player.send_message("say " + items_list[i]);
    }
    return true;
}
bool cmd_item_info(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: item_info <item>");
        return false;
    }
    string item_name = args[0];
    GameItem@ item = get_item_by_name(item_name);
    if(item is null) {
        player.send_message("say Item '" + item_name + "' Nao encontrado.");
        return false;
    }
    string info = "=== INFORMACOES DO ITEM ===\n";
    info += "Nome: " + item.name + "\n";
    info += "Nome de exibicaoo: " + item.display_name + "\n";
    info += "Descricaoo: " + item.description + "\n";
    info += "Tipo: " + item.item_type + " / " + item.category + "\n";
    info += "Raridade: " + item.rarity + "\n";
    if(item.damage > 0) info += "Dano: " + item.damage + "\n";
    if(item.defense > 0) info += "Defesa: " + item.defense + "\n";
    if(item.heal_amount > 0) info += "Cura: " + item.heal_amount + "\n";
    if(item.mp_restore > 0) info += "Restaura MP: " + item.mp_restore + "\n";
    info += "Empilhavel: " + (item.stackable ? "Sim" : "Nao") + "\n";
    if(item.stackable) info += "Max por pilha: " + item.max_stack + "\n";
    info += "Peso: " + item.weight + "\n";
    info += "Valor: " + item.value + " moedas\n";
    info += "Comercializavel: " + (item.tradeable ? "Sim" : "Nao") + "\n";
    info += "Vendivel: " + (item.sellable ? "Sim" : "Nao");
    player.send_message("say " + info);
    return true;
}
bool cmd_drop(int player_index, string item_name) {
    player@ p = players[player_index];
    if(p is null) return false;
    if(p.inv_item_number(item_name) > 0) {
        p.inv_remove_item(item_name, 1);
        spawn_item_at(item_name, p.map_name, p.x, p.y, p.z, 1, "player:" + p.name);
        p.send_message("say Voclargou: " + item_name);
        log_action(p.name, "drop", "Largou item " + item_name, p.map_name, p.x, p.y, p.z);
        return true;
    } else {
        p.send_message("say Voce nao tem esse item.");
        return false;
    }
}
bool cmd_give(int player_index, string target_name, string item_name) {
    player@ p = players[player_index];
    if(p is null) return false;
    if(p.inv_item_number(item_name) <= 0) {
        p.send_message("say Voce nao tem esse item.");
        return false;
    }
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        for(uint i=0; i < players.length(); i++) {
            if(players[i].name == target_name || players[i].charname == target_name) {
                @target = @players[i];
                break;
            }
        }
    }
    if(target is null) {
        p.send_message("say Jogador Nao encontrado.");
        return false;
    }
    p.inv_remove_item(item_name, 1);
    target.inv_add_item(item_name, 1);
    p.send_message("say Vocdeu " + item_name + " para " + target.name);
    target.send_message("say " + p.name + " lhe deu " + item_name);
    log_action(p.name, "give", "Deu " + item_name + " para " + target.name, p.map_name, p.x, p.y, p.z);
    return true;
}
bool cmd_statistics(player@ player, string[] args) {
    string stats = get_current_statistics_report();
    player.send_message("say " + stats);
    return true;
}
bool cmd_history(player@ player, string[] args) {
    string player_filter = "";
    string action_filter = "";
    int limit = 20;
    if(args.length() > 0) player_filter = args[0];
    if(args.length() > 1) action_filter = args[1];
    if(args.length() > 2) limit = string_to_number(args[2]);
    string[] history = get_recent_actions(limit, action_filter, player_filter);
    if(history.length() == 0) {
        player.send_message("say Nenhum historico encontrado com os filtros especificados.");
        return false;
    }
    player.send_message("say === HISTORICO DE ACOES ===\nMostrando " + history.length() + " entradas:");
    for(uint i = 0; i < history.length(); i++) {
        player.send_message("say " + history[i]);
    }
    return true;
}
bool cmd_attack(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: attack <jogador> [arma]");
        return false;
    }
    string target_name = args[0];
    string weapon = args.length() > 1 ? args[1] : "";
    player@ target = get_player_by_name(target_name);
    if(target is null) {
        player.send_message("say Jogador '" + target_name + "' Nao encontrado.");
        return false;
    }
    if(target.name == player.name) {
        player.send_message("say Voce nao pode atacar a si mesmo!");
        return false;
    }
    if(target.map_name != player.map_name) {
        player.send_message("say O jogador Nao esta no mesmo mapa que voce.");
        return false;
    }
    int distance = int(abs(target.x - player.x) + abs(target.y - player.y) + abs(target.z - player.z));
    if(distance > 2) {
        player.send_message("say Voce precisa estar mais proximo para atacar.");
        return false;
    }
    if(is_player_in_combat(player.name)) {
        if(execute_attack(player.name, target.name, weapon)) {
            return true;
        } else {
            player.send_message("say Falha ao executar ataque.");
            return false;
        }
    } else {
        if(start_combat(player.name, target.name)) {
            execute_attack(player.name, target.name, weapon);
            return true;
        } else {
            if(is_player_in_combat(target.name)) {
                player.send_message("say " + target_name + " ja esta em combate com outro jogador.");
            } else {
                player.send_message("say Nao foi possivel iniciar o combate.");
            }
            return false;
        }
    }
}
bool cmd_defend(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say Voce nao esta em combate.");
        return false;
    }
    set_player_defending(player.name);
    player.send_message("say Defesa ativada. O proximo ataque recebido tera dano reduzido.");
    log_action(player.name, "defend", "Jogador se defendeu",
               player.map_name, player.x, player.y, player.z);
    return true;
}
bool cmd_flee(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say Voce nao esta em combate.");
        return false;
    }
    if(attempt_flee(player.name)) {
        return true;
    } else {
        player.send_message("say Voce nao conseguiu fugir! Tente novamente na proxima rodada.");
        return false;
    }
}
bool cmd_combat_status(player@ player, string[] args) {
    if(!is_player_in_combat(player.name)) {
        player.send_message("say Voce nao esta em combate.");
        return false;
    }
    CombatInstance@ combat = get_player_combat(player.name);
    if(combat is null) {
        player.send_message("say Erro: Dados de combate Nao encontrados.");
        return false;
    }
    string opponent_id = combat.attacker_id == player.name ? combat.defender_id : combat.attacker_id;
    player@ opponent = get_player_by_id(opponent_id);
    if(opponent !is null) {
        uint64 combat_duration = (get_time_stamp() - combat.start_time) / 1000;
        string status = "=== STATUS DO COMBATE ===\n";
        status += "Oponente: " + opponent.name + "\n";
        status += "Sua vida: " + player.hp + "/" + player.max_hp + "\n";
        status += "Vida do oponente: " + opponent.hp + "/" + opponent.max_hp + "\n";
        status += "Duracaoo: " + combat_duration + " segundos\n";
        status += "Status: " + combat.battle_status;
        player.send_message("say " + status);
    }
    return true;
}
bool cmd_use(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: /usar <item>");
        return false;
    }
    string item_name = join(args, " ");
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro: Jogador Nao encontrado.");
        return false;
    }
    if(use_item(player_index, item_name)) {
        return true;
    } else {
        return false;
    }
}
const int BOUNTY_MIN_VALUE = 100;
const int BOUNTY_MAX_VALUE = 10000000;
const int BOUNTY_CANCEL_FEE = 50;
bool cmd_bounty(player@ player, string[] args) {
    if(args.length() < 2) {
        player.send_message("say Uso: /bounty <jogador> <valor>");
        player.send_message("say Valor minimo: " + BOUNTY_MIN_VALUE + " moedas");
        return false;
    }
    string target_name = args[0];
    int value = string_to_number(args[1]);
    int setter_index = get_player_index_from(player.charname);
    if(setter_index < 0) {
        player.send_message("say Erro interno: Jogador Nao encontrado.");
        return false;
    }
    if(value < BOUNTY_MIN_VALUE) {
        player.send_message("say O valor minimo da recompensa e " + BOUNTY_MIN_VALUE + " moedas.");
        return false;
    }
    if(value > BOUNTY_MAX_VALUE) {
        player.send_message("say O valor maximo da recompensa e " + BOUNTY_MAX_VALUE + " moedas.");
        return false;
    }
    int target_index = get_player_index_from(target_name);
    if(target_index < 0) {
        player.send_message("say Jogador '" + target_name + "' Nao esta online.");
        return false;
    }
    if(players[setter_index].gold < value) {
        player.send_message("say Voce nao tem moedas suficientes. Seu saldo: " + players[setter_index].gold);
        return false;
    }
    if(set_bounty(target_index, setter_index, value)) {
        player.send_message("say Recompensa registrada com sucesso.");
        debug_log("BOUNTY: " + player.charname + " colocou " + value + " na cabeca de " + players[target_index].charname);
        return true;
    } else {
        if(target_index == setter_index) {
            player.send_message("say Voce nao pode colocar recompensa em si mesmo!");
        } else if(players[target_index].pacifico == 1) {
            player.send_message("say Este jogador esta em modo pacifico e Nao pode receber recompensas.");
        } else if(players[target_index].newbie == true) {
            player.send_message("say Este jogador e novato e Nao pode receber recompensas.");
        } else {
            player.send_message("say Nao foi possivel colocar a recompensa. Tente novamente.");
        }
        return false;
    }
}
bool cmd_checkbounty(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: /checkbounty <jogador>");
        return false;
    }
    string target_name = args[0];
    int target_index = get_player_index_from(target_name);
    if(target_index < 0) {
        player.send_message("say Jogador '" + target_name + "' Nao esta online.");
        return false;
    }
    string info = get_bounty_info(target_index);
    player.send_message("say " + info);
    return true;
}
bool cmd_mybounty(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro interno: Jogador Nao encontrado.");
        return false;
    }
    if(!has_bounty(player_index)) {
        player.send_message("say Voce nao tem recompensa na sua cabeca. ");
        return true;
    }
    string info = get_bounty_info(player_index);
    player.send_message("say " + info);
    if(players[player_index].bounty_online_time > 0) {
        int minutes = players[player_index].bounty_online_time / 60;
        player.send_message("say Tempo com recompensa: " + minutes + " minutos");
    }
    return true;
}
bool cmd_cancelbounty(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: /cancelbounty <jogador>");
        player.send_message("say Taxa de cancelamento: " + BOUNTY_CANCEL_FEE + "% do valor");
        return false;
    }
    string target_name = args[0];
    int canceller_index = get_player_index_from(player.charname);
    if(canceller_index < 0) {
        player.send_message("say Erro interno: Jogador Nao encontrado.");
        return false;
    }
    if(players[canceller_index].bounty_target != target_name) {
        player.send_message("say Voce nao colocou recompensa em " + target_name + ".");
        return false;
    }
    if(cancel_bounty(canceller_index, target_name)) {
        int target_index = get_player_index_from(target_name);
        player.send_message("say Recompensa cancelada! Vocrecebeu de volta 50% do valor.");
        if(target_index >= 0) {
            send_reliable_text(players[target_index].peer_id,
                "msg2 A recompensa na sua cabeca colocada por " + player.charname + " foi cancelada!", 0);
        }
        debug_log("BOUNTY CANCELADO: " + player.charname + " cancelou bounty em " + target_name);
        return true;
    } else {
        player.send_message("say Nao foi possivel cancelar a recompensa. O jogador pode estar offline.");
        return false;
    }
}
bool cmd_listbounties(player@ player, string[] args) {
    string[] bounties = list_all_bounties();
    if(bounties.length() == 0) {
        player.send_message("say Nao ha jogadores com recompensa na cabeca no momento.");
        return true;
    }
    player.send_message("say === LISTA DE RECOMPENSAS (" + bounties.length() + ") ===");
    for(uint i = 0; i < bounties.length(); i++) {
        player.send_message("say " + (i+1) + ". " + bounties[i]);
    }
    return true;
}
bool cmd_buy(player@ player, string[] args) {
    if(args.length() < 2) {
        player.send_message("say Uso: /buy <item> <quantidade>");
        player.send_message("say Exemplo: /buy espada 1");
        return false;
    }
    string item_name = args[0];
    int quantity = string_to_number(args[1]);
    string[] internal_args = {string(quantity), item_name};
    return cmd_buy_internal(player, internal_args);
}
bool cmd_buy_internal(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro interno: Jogador Nao encontrado.");
        return false;
    }
    if(args.length() < 2) {
        player.send_message("say Dados de compra invalidos.");
        return false;
    }
    int quantity = string_to_number(args[0]);
    string item_name = args[1];
    if(quantity <= 0) {
        player.send_message("say Quantidade invalida. Use um valor maior que zero.");
        return false;
    }
    int store_index = item_exists_for_sale(item_name);
    if(store_index < 0) {
        player.send_message("say Item '" + item_name + "' Nao encontrado na loja.");
        return false;
    }
    double unit_price = items_sale[store_index].price;
    string currency_type = items_sale[store_index].money;
    double total_cost = unit_price * quantity;
    bool has_funds = false;
    string currency_name = "";
    if(currency_type == "stryx") {
        has_funds = players[player_index].has_stryx(total_cost);
        currency_name = "Stryx";
    }
    else if(currency_type == "creditos") {
        has_funds = players[player_index].has_credits(total_cost);
        currency_name = "Creditos";
    }
    else if(currency_type == "saldo" || currency_type == "dinheiro" || currency_type == "reais") {
        has_funds = players[player_index].has_money(total_cost);
        currency_name = "Reais";
    }
    else {
        has_funds = players[player_index].inv_item_number(currency_type) >= int(total_cost);
        currency_name = currency_type;
    }
    if(!has_funds) {
        player.send_message("say " + currency_name + " insuficiente. Requer: " + total_cost + " " + currency_name);
        return false;
    }
    int current_items = int(players[player_index].inv.get_keys().length());
    bool item_exists = players[player_index].inv_item_exists(item_name);
    if(!item_exists && current_items >= players[player_index].max_inventory_slots) {
        player.send_message("say Inventario cheio! Voce nao tem mais slots disponiveis.");
        player.send_message("say Slots: " + current_items + "/" + players[player_index].max_inventory_slots);
        return false;
    }
    if(currency_type == "stryx") {
        players[player_index].remove_stryx(total_cost);
    }
    else if(currency_type == "creditos") {
        players[player_index].remove_credits(total_cost);
    }
    else if(currency_type == "saldo" || currency_type == "dinheiro" || currency_type == "reais") {
        players[player_index].remove_money(total_cost, "compra de " + quantity + "x " + item_name);
    }
    else {
        players[player_index].inv_add_item(currency_type, -int(total_cost), true);
    }
    players[player_index].inv_add_item(item_name, quantity, true);
    player.send_message("say Compra realizada com sucesso!");
    player.send_message("say Voccomprou " + quantity + "x " + item_name);
    player.send_message("say Total: " + total_cost + " " + currency_name);
    save_player_to_database(players[player_index]);
    debug_log("COMPRA: " + player.charname + " comprou " + quantity + "x " + item_name +
              " por " + total_cost + " " + currency_name);
    log_to_database("INFO", "ECONOMY", "Compra: " + quantity + "x " + item_name +
                    " por " + total_cost + " " + currency_name, player_index, player.charname);
    return true;
}
bool cmd_buy_special(player@ player, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) {
        player.send_message("say Erro interno: Jogador Nao encontrado.");
        return false;
    }
    if(args.length() < 2) {
        player.send_message("say Dados de compra invalidos.");
        return false;
    }
    int quantity = string_to_number(args[0]);
    string item_name = args[1];
    if(quantity <= 0) {
        player.send_message("say Quantidade invalida.");
        return false;
    }
    dictionary special_prices;
    special_prices.set("mina", 20);
    special_prices.set("bomba_relogio", 100);
    special_prices.set("bomba_remota", 200);
    special_prices.set("missil_teleguiado", 200);
    special_prices.set("max_bomba", 250);
    special_prices.set("bomba_de_fogo", 250);
    special_prices.set("bomba_atomica", 300);
    special_prices.set("mega_laser", 5000);
    special_prices.set("sub_laser", 100000);
    special_prices.set("cuernitoarmani", 1000000);
    special_prices.set("galil", 100000);
    special_prices.set("missil", 15);
    special_prices.set("laser", 5);
    special_prices.set("7.62mm", 3);
    special_prices.set("5.56mm", 2);
    special_prices.set("9mm", 2);
    if(!special_prices.exists(item_name)) {
        player.send_message("say Item especial '" + item_name + "' Nao encontrado.");
        return false;
    }
    int unit_price;
    special_prices.get(item_name, unit_price);
    int total_cost = unit_price * quantity;
    int player_euros = players[player_index].inv_item_number("euro");
    if(player_euros < total_cost) {
        player.send_message("say Euros insuficientes. Requer: " + total_cost + " euro");
        player.send_message("say Voce tem: " + player_euros + " euro");
        return false;
    }
    int current_items = int(players[player_index].inv.get_keys().length());
    bool item_exists = players[player_index].inv_item_exists(item_name);
    if(!item_exists && current_items >= players[player_index].max_inventory_slots) {
        player.send_message("say Inventario cheio!");
        return false;
    }
    players[player_index].inv_add_item("euro", -total_cost, true);
    players[player_index].inv_add_item(item_name, quantity, true);
    player.send_message("say Compra especial realizada!");
    player.send_message("say Voccomprou " + quantity + "x " + item_name);
    player.send_message("say Total: " + total_cost + " euro");
    save_player_to_database(players[player_index]);
    debug_log("COMPRA ESPECIAL: " + player.charname + " comprou " + quantity + "x " + item_name +
              " por " + total_cost + " euro");
    return true;
}
bool cmd_store(player@ player, string[] args) {
    return cmd_loja_abrir(player, args);
}
bool cmd_sell(player@ player, string[] args) {
    return cmd_loja_vender(player, args);
}
