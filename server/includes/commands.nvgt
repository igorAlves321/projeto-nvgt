void register_command(string name, string description, bool admin_only = false,
                     string[] aliases = {}, string usage = "") {
    ServerCommand@ cmd = ServerCommand(name, description, admin_only);
    cmd.aliases = aliases;
    cmd.usage = (usage != "") ? usage : name;
    registered_commands.set(name, @cmd);
    for(uint i = 0; i < aliases.length(); i++) {
        command_aliases[aliases[i]] = name;
    }
}
string resolve_command(string input) {
    if(registered_commands.exists(input)) {
        return input;
    }
    if(command_aliases.exists(input)) {
        string real_name;
        command_aliases.get(input, real_name);
        return real_name;
    }
    return "";
}
bool can_use_command(player@ player, string command_name) {
    if(!registered_commands.exists(command_name)) {
        return false;
    }
    ServerCommand@ cmd;
    registered_commands.get(command_name, @cmd);
    if(cmd is null) return false;

    bool cached;
    if(cached_can_use(player.charname, command_name, cached)) return cached;

    if(has_command_deny(player.charname, command_name)) {
        cache_permission(player.charname, command_name, false);
        return false;
    }

    if(cmd.admin_only) {
        bool ok = passes_role_requirement(player.charname, command_name) || has_command_grant(player.charname, command_name);
        cache_permission(player.charname, command_name, ok);
        return ok;
    }

    cache_permission(player.charname, command_name, true);
    return true;
}
bool process_command(player@ player, string full_command) {
    if(player is null || full_command == "") return false;
    if(full_command.length() < 1 || full_command[0] != '/') {
        return false;
    }
    string command_without_slash = full_command.substr(1);
    string[] parts = command_without_slash.split(" ");
    if(parts.length() == 0) return false;
    string command_name = parts[0].lower();
    string[] args;
    for(uint i = 1; i < parts.length(); i++) {
        args.push_back(parts[i]);
    }
    string resolved = resolve_command(command_name);
    if(resolved == "") {
        return false;
    }
    if(!can_use_command(player, resolved)) {
        log_action(player.charname, "ANTICHEAT", "comando_negado " + resolved);
        player.send_message("say Voce nao tem permissao para usar este comando.");
        return false;
    }
    return execute_command(player, resolved, args);
}
bool execute_command(player@ player, string command, string[] args) {
    int player_index = get_player_index_from(player.charname);
    if(player_index < 0) return false;
    if(command == "playtime") {
        string target = args.length() > 0 ? args[0] : "";
        cmd_playtime(player_index, target);
        return true;
    }
    else if(command == "kick") {
        if(args.length() < 1) {
            player.send_message("say Uso: /kick <jogador> [razao]");
            return false;
        }
        string target = args[0];
        string reason = args.length() > 1 ? join(args, " ").substr(target.length() + 1) : "Expulso por admin";
        cmd_kick(player_index, target, reason);
        return true;
    }
    else if(command == "addcomando") { cmd_addcomando(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "removecomando") { cmd_removecomando(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "negarcomando") { cmd_negarcomando(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "permcomandos") { cmd_permcomandos(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "quempode") { cmd_quempode(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "setcmdcargo") { cmd_setcmdcargo(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "imune") { cmd_imune(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "removerimune") { cmd_removerimune(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "listaimunes") { cmd_listaimunes(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "limparspam") { cmd_limparspam(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "spaminfo") { cmd_spaminfo(player_index, build_command_parsed(command, args)); return true; }
    else if(command == "inventory") {
        if(args.length() < 1) {
            player.send_message("say Uso: /inventory <jogador>");
            return false;
        }
        cmd_inventory(player_index, args[0]);
        return true;
    }
