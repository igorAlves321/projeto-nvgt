    register_command("pm", "Enviar mensagem privada", false, {"msg", "tell", "whisper"}, "pm <jogador> <mensagem>");
    register_command("r", "Responder última mensagem privada", false, {"reply"}, "r <mensagem>");
    register_command("me", "Ação em terceira pessoa", false, {"action"}, "me <ação>");
    
