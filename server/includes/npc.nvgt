
npc@[] npcs_global;

void send_to_map(string message, string mapname) {
	server_broadcast(message, mapname);
}

string npc_sound_file(string snd) {
	if(snd == "") return "";
	if(snd.find(".ogg") > -1) return snd;
	return snd + ".ogg";
}

class npc {
	int x, y;
	int x_inicial = 0, y_inicial = 0;
	int id = 0;

	int vida = 100;
	int vida_inicial = 100;
	int xp_reward = 50;
	int gold_reward = 10;
	int danoquerecibira = 50;
	int danoquedara = 100;
	int danodelespejo = 0;
	int distanciaataques = 5;

	int p_index = -1;
	string target_player = "";
	timer update_player;
	int player_update_interval = 5000;

	int tiempoparaatacar = 3000;
	int tiempoparacaminar = 5000;
	int tiempodelossonidos = 10000;

	timer ttiempoparaatacar;
	timer ttiempoparacaminar;
	timer ttiempodelossonidos;

	string[] sonidosnervioso;
	string[] sonidosataque;
	string[] pasos;
	string[] impactos;
	string sonidoataque = "";
	string sonidomuerte = "";
	string impactosbala = "";
	string pasosnpc = "";

	bool morreu = false;
	bool morrendo = false;
	bool nasceu = true;
	bool pacifista = false;
	string asesino = "";
	string golpeado = "";
	timer tmorreu;

	int mapindex = -1;
	string map = "";
	string name = "";
	string nombrenpc = "";

	bool enablerespawn = true;
	bool enablebombs = false;
	int tiempoaparicion = 0;

	string itemsadar = "";
	string degradation = "";
	string msgmuerte = "";

	int left_range = 0;
	int right_range = 0;

	npc(int nx, int ny, string nmap, string ntype) {
		x = nx;
		y = ny;
		vida_inicial = vida;
		x_inicial = nx;
		y_inicial = ny;
		map = nmap;
		nombrenpc = ntype;
		name = ntype + "_" + nx + "_" + ny;
		mapindex = get_map_index_from(map);
		nasceu = true;
	}

	npc(int nx, int ny, int nvida, int nxp, int ndistanciaataques,
	    int ndanoquerecibira, int ndanoquedara, int ndanodelespejo,
	    int ntiempoparaatacar, int ntiempoparacaminar, int ntiempodelossonidos,
	    string nitemsadar, string nsonidoataque, string nsonidonervioso,
	    string nsonidomuerte, string nnombrenpc, string nmsgmuerte,
	    int ntiempoaparicion, bool nenablerespawn, bool nenablebombs,
	    string nmap, string npasosnpc, int nleft_range, int nright_range,
	    string nimpactosbala, string ndegradation) {
		this.x = nx;
		this.y = ny;
		this.x_inicial = nx;
		this.y_inicial = ny;

		this.vida = nvida;
		this.vida_inicial = nvida;
		this.xp_reward = nxp;
		this.danoquerecibira = ndanoquerecibira;
		this.danoquedara = ndanoquedara;
		this.danodelespejo = ndanodelespejo;
		this.distanciaataques = ndistanciaataques;

		this.tiempoparaatacar = ntiempoparaatacar;
		this.tiempoparacaminar = ntiempoparacaminar;
		this.tiempodelossonidos = ntiempodelossonidos;

		this.itemsadar = string_replace(nitemsadar, ",", "|", true);

		this.sonidoataque = nsonidoataque;
		this.sonidomuerte = nsonidomuerte;
		this.impactosbala = nimpactosbala;
		this.pasosnpc = npasosnpc;

		string attack_sounds = string_replace(nsonidoataque, "|", ",", true);
		if(attack_sounds != "") {
			sonidosataque = attack_sounds.split(",");
		}

		string nervous_sounds = string_replace(nsonidonervioso, "|", ",", true);
		if(nervous_sounds != "") {
			sonidosnervioso = nervous_sounds.split(",");
		}

		string step_sounds = string_replace(npasosnpc, "|", ",", true);
		if(step_sounds != "") {
			pasos = step_sounds.split(",");
		}

		string hit_sounds = string_replace(nimpactosbala, "|", ",", true);
		if(hit_sounds != "") {
			impactos = hit_sounds.split(",");
		}
		else {
			this.impactosbala = "default";
		}

		this.nombrenpc = nnombrenpc;
		this.name = nnombrenpc + "_" + nx + "_" + ny;

		this.map = nmap;
		this.mapindex = get_map_index_from(nmap);

		this.enablerespawn = nenablerespawn;
		this.enablebombs = nenablebombs;
		this.tiempoaparicion = ntiempoaparicion;

		this.left_range = nleft_range;
		this.right_range = nright_range;

		this.msgmuerte = nmsgmuerte;
		this.degradation = ndegradation;

		this.nasceu = true;
		this.morreu = false;
		this.morrendo = false;
	}

	bool exists_player_in_my_map() {
		if(pacifista) return false;
		for(uint i = 0; i < players.length(); i++) {
			if(players[i].map == this.map &&
			   !players[i].afk &&
			   players[i].pacifico == 0 &&
			   players[i].newbie == false) {
				return true;
			}
		}
		return false;
	}

	int select_player_to_attack() {
		if(pacifista) return -1;
		int closest_player = -1;
		double closest_distance = 999999;

		for(uint i = 0; i < players.length(); i++) {
			if(players[i].map != this.map) continue;
			if(players[i].afk) continue;
			if(players[i].pacifico == 1) continue;
			if(players[i].newbie) continue;
			if(players[i].health <= 0) continue;

			if(get_safezone_at(players[i].x, players[i].y, players[i].map)) continue;

			double dist = get_distance(this.x, this.y, players[i].x, players[i].y);

			if(dist < closest_distance) {
				closest_distance = dist;
				closest_player = i;
			}
		}

		return closest_player;
	}

	int change_player(int current_index) {
		if(pacifista) return -1;
		if(current_index > -1 && current_index < players.length()) {
			if(players[current_index].map == this.map &&
			   !players[current_index].afk &&
			   players[current_index].pacifico == 0 &&
			   players[current_index].health > 0 &&
			   !get_safezone_at(players[current_index].x, players[current_index].y, players[current_index].map)) {
				return current_index;
			}
		}

		return select_player_to_attack();
	}

	void move() {
		if(pacifista) return;
		if(update_player.elapsed >= player_update_interval) {
			update_player.restart();
			p_index = change_player(p_index);
		}

		if(p_index < 0 || p_index >= players.length()) return;

		if(ttiempoparacaminar.elapsed < tiempoparacaminar) return;
		ttiempoparacaminar.restart();

		bool can_move_left = (left_range == 0 || this.x > left_range);
		bool can_move_right = (right_range == 0 || this.x < right_range);

		if(this.x > players[p_index].x + 2 && can_move_left) {
			this.x--;
			play_step_sound();
		}
		else if(this.x < players[p_index].x - 2 && can_move_right) {
			this.x++;
			play_step_sound();
		}

		if(this.y > players[p_index].y + 1) {
			this.y--;
		}
		else if(this.y < players[p_index].y - 1) {
			this.y++;
		}
	}

	void play_step_sound() {
		string step_base = "";
		if(pasos.length() > 0) {
			if(pasos.length() == 1 && pasos[0] == "default") {
				step_base = get_tile_at(this.x, this.y, this.map);
			}
			else {
				step_base = pasos[random(0, pasos.length() - 1)];
			}
		}
		else {
			step_base = get_tile_at(this.x, this.y, this.map);
		}
		send_to_map("play " + step_base + "step" + random(1, 5) + ".ogg " + this.x + " " + this.y, this.map);
	}

	void attack() {
		if(pacifista) return;
		if(p_index < 0 || p_index >= players.length()) return;

		if(ttiempoparaatacar.elapsed < tiempoparaatacar) return;

		double dist = get_distance(this.x, this.y, players[p_index].x, players[p_index].y);

		if(dist <= distanciaataques) {
			ttiempoparaatacar.restart();

			if(sonidosataque.length() > 0) {
				string snd_attack = sonidosataque[random(0, sonidosataque.length() - 1)];
				send_to_map("play " + npc_sound_file(snd_attack) + " " + this.x + " " + this.y, this.map);
			}
			else if(sonidoataque != "") {
				send_to_map("play " + npc_sound_file(sonidoataque) + " " + this.x + " " + this.y, this.map);
			}

			int reflected_damage = refletir(p_index, nombrenpc, this.x, this.y, danoquedara);
			if(reflected_damage > 0) {
				this.vida -= reflected_damage;
				this.golpeado = players[p_index].charname;
				this.asesino = players[p_index].charname;
				return;
			}

			players[p_index].health -= danoquedara;
			players[p_index].lasthit = nombrenpc;

			send_to_map("inithurt " + players[p_index].voice + " " + players[p_index].x + " " + players[p_index].y, players[p_index].map);
		}
	}

	void play_nervous_sounds() {
		if(sonidosnervioso.length() == 0) return;
		if(ttiempodelossonidos.elapsed < tiempodelossonidos) return;

		ttiempodelossonidos.restart();

		string snd = sonidosnervioso[random(0, sonidosnervioso.length() - 1)];
		send_to_map("play " + npc_sound_file(snd) + " " + this.x + " " + this.y, this.map);
	}

	void die() {
		morreu = true;
		morrendo = true;

		if(sonidomuerte != "") {
			send_to_map("play " + npc_sound_file(sonidomuerte) + " " + this.x + " " + this.y, this.map);
		}

		string golp = (asesino != "") ? asesino : golpeado;

		if(golp.find("magnet_") > -1) {
			golp = golp.replace("magnet_", "");
			send_reliable_text(0, "msg2 um; ;" + nombrenpc + "; ;morreu no; ;item_magnético; ;de; ;" + golp + ";!", 3);
		}
		else if(golp != "") {
			send_reliable_text(0, "msg2 " + golp + "; ;matou um; ;" + nombrenpc + ";!", 3);
		}

		int killer_index = get_player_index_from(golp);
		if(killer_index > -1) {
			players[killer_index].kills++;

			ganhaxp(killer_index, xp_reward, gold_reward);

			drop_items(killer_index);

			quest_update_kill(players[killer_index].charname, nombrenpc);

			update_achievement_progress(players[killer_index].charname, "kills", 1);

			if(players[killer_index].kills == 10) {
				settitle(killer_index);
				send_reliable_text(players[killer_index].peer_id, "msg2 Parabéns! Você recebeu a patente de Caçador por derrotar 10 monstros!", 0);
			}
		}
	}

	void drop_items(int killer_index) {
		if(itemsadar == "") return;

		string normalized_items = string_replace(itemsadar, ",", "|", true);
		string[] items = normalized_items.split("|");
		for(uint i = 0; i < items.length(); i++) {
			if(items[i] == "") continue;

			string[] parts = items[i].split(":");
			if(parts.length() <= 1 && items[i].find(".") > -1) {
				parts = items[i].split(".");
			}
			string item_name = parts[0];
			int quantity = (parts.length() > 1) ? parse_int(parts[1]) : 1;

			if(killer_index > -1) {
				players[killer_index].inv_add_item(item_name, quantity);
			}
		}
	}
}

class npc_data {
	int x, y;
	int vida = 100;
	int xp_reward = 50;
	int gold_reward = 10;
	int danoquerecibira = 50;
	int danoquedara = 100;
	int danodelespejo = 0;
	int distanciaataques = 5;

	int tiempoparaatacar = 3000;
	int tiempoparacaminar = 5000;
	int tiempodelossonidos = 10000;

	string itemsadar = "";
	string sonidoataque = "";
	string sonidonervioso = "";
	string sonidomuerte = "";
	string nombrenpc = "";
	string msgmuerte = "";
	string map = "";
	string pasosnpc = "";
	string impactosbala = "";
	string degradation = "";

	int tiempoaparicion = 0;
	bool enablerespawn = true;
	bool enablebombs = false;
	bool pacifista = false;
	int left_range = 0;
	int right_range = 0;

	timer trespawn;
	timer respawn_timer;

	npc_data() {}

	npc_data(int nx, int ny, int nvida, int nxp, int ndistanciaataques,
	         int ndanoquerecibira, int ndanoquedara, int ndanodelespejo,
	         int ntiempoparaatacar, int ntiempoparacaminar, int ntiempodelossonidos,
	         string nitemsadar, string nsonidoataque, string nsonidonervioso,
	         string nsonidomuerte, string nnombrenpc, string nmsgmuerte,
	         int ntiempoaparicion, bool nenablerespawn, bool nenablebombs,
	         string nmap, string npasosnpc, int nleft_range, int nright_range,
	         string nimpactosbala, string ndegradation, bool npacifista = false) {
		x = nx;
		y = ny;
		vida = nvida;
		xp_reward = nxp;
		distanciaataques = ndistanciaataques;
		danoquerecibira = ndanoquerecibira;
		danoquedara = ndanoquedara;
		danodelespejo = ndanodelespejo;
		tiempoparaatacar = ntiempoparaatacar;
		tiempoparacaminar = ntiempoparacaminar;
		tiempodelossonidos = ntiempodelossonidos;
		itemsadar = nitemsadar;
		sonidoataque = nsonidoataque;
		sonidonervioso = nsonidonervioso;
		sonidomuerte = nsonidomuerte;
		nombrenpc = nnombrenpc;
		msgmuerte = nmsgmuerte;
		tiempoaparicion = ntiempoaparicion;
		enablerespawn = nenablerespawn;
		enablebombs = nenablebombs;
		pacifista = npacifista;
		map = nmap;
		pasosnpc = npasosnpc;
		left_range = nleft_range;
		right_range = nright_range;
		impactosbala = nimpactosbala;
		degradation = ndegradation;
		trespawn.restart();
	}
}

npc_data@[] npcs_data_global;

void spawn_npc(int x, int y, string map, string type) {
	npc n(x, y, map, type);
	npcs_global.insert_last(n);
}

void npc_global_loop() {
	for(uint i = 0; i < npcs_global.length(); i++) {
		if(npcs_global[i].vida <= 0 && !npcs_global[i].morreu) {
			npcs_global[i].die();

			if(npcs_global[i].enablerespawn) {
				npc_data nd(
					npcs_global[i].x_inicial,
					npcs_global[i].y_inicial,
					npcs_global[i].vida_inicial,
					npcs_global[i].xp_reward,
					npcs_global[i].distanciaataques,
					npcs_global[i].danoquerecibira,
					npcs_global[i].danoquedara,
					npcs_global[i].danodelespejo,
					npcs_global[i].tiempoparaatacar,
					npcs_global[i].tiempoparacaminar,
					npcs_global[i].tiempodelossonidos,
					npcs_global[i].itemsadar,
					npcs_global[i].sonidoataque,
					"",
					npcs_global[i].sonidomuerte,
					npcs_global[i].nombrenpc,
					npcs_global[i].msgmuerte,
					npcs_global[i].tiempoaparicion,
					true,
					npcs_global[i].enablebombs,
					npcs_global[i].map,
					npcs_global[i].pasosnpc,
					npcs_global[i].left_range,
					npcs_global[i].right_range,
					npcs_global[i].impactosbala,
					npcs_global[i].degradation,
					npcs_global[i].pacifista
				);
				npcs_data_global.insert_last(nd);
			}

			npcs_global.remove_at(i);
			continue;
		}

		npcs_global[i].play_nervous_sounds();

		npcs_global[i].move();

		npcs_global[i].attack();
	}

	for(uint i = 0; i < npcs_data_global.length(); i++) {
		if(npcs_data_global[i].trespawn.elapsed >= npcs_data_global[i].tiempoaparicion) {
			npc n(
				npcs_data_global[i].x,
				npcs_data_global[i].y,
				npcs_data_global[i].vida,
				npcs_data_global[i].xp_reward,
				npcs_data_global[i].distanciaataques,
				npcs_data_global[i].danoquerecibira,
				npcs_data_global[i].danoquedara,
				npcs_data_global[i].danodelespejo,
				npcs_data_global[i].tiempoparaatacar,
				npcs_data_global[i].tiempoparacaminar,
				npcs_data_global[i].tiempodelossonidos,
				npcs_data_global[i].itemsadar,
				npcs_data_global[i].sonidoataque,
				npcs_data_global[i].sonidonervioso,
				npcs_data_global[i].sonidomuerte,
				npcs_data_global[i].nombrenpc,
				npcs_data_global[i].msgmuerte,
				npcs_data_global[i].tiempoaparicion,
				npcs_data_global[i].enablerespawn,
				npcs_data_global[i].enablebombs,
				npcs_data_global[i].map,
				npcs_data_global[i].pasosnpc,
				npcs_data_global[i].left_range,
				npcs_data_global[i].right_range,
				npcs_data_global[i].impactosbala,
				npcs_data_global[i].degradation
			);
			n.vida_inicial = npcs_data_global[i].vida;
			n.pacifista = npcs_data_global[i].pacifista;
			npcs_global.insert_last(n);

			npcs_data_global.remove_at(i);
		}
	}
}
