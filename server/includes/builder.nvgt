
const int BUILDER_MIN_RANK = 3;

const int BUILDER_MAP_MAX_X = 50000;
const int BUILDER_MAP_MAX_Y = 50000;

const int BUILDER_MAX_WALLS_PER_MAP = 5000;
const int BUILDER_MAX_PLATFORMS_PER_MAP = 5000;
const int BUILDER_MAX_ZONES_PER_MAP = 1000;
const int BUILDER_MAX_NPCS_PER_MAP = 500;
const int BUILDER_MAX_ITEMS_PER_MAP = 2000;

bool builder_check_permission(player@ p) {
    if(p is null) return false;

    return (p.rank >= BUILDER_MIN_RANK || p.constructor || p.dev || p.admin);
}

void builder_send_error(player@ p, string message) {
    if(p is null) return;
    send_reliable_text(p.peer_id, "say ❌ Builder: " + message, 0);
    debug_log("BUILDER ERROR [" + p.charname + "]: " + message);
}

void builder_send_success(player@ p, string message) {
    if(p is null) return;
    send_reliable_text(p.peer_id, "say  Builder: " + message, 0);
    debug_log("BUILDER SUCCESS [" + p.charname + "]: " + message);
}

bool builder_validate_coords(int x, int y, int max_x = -1, int max_y = -1) {
    int limit_x = (max_x > 0) ? max_x : BUILDER_MAP_MAX_X;
    int limit_y = (max_y > 0) ? max_y : BUILDER_MAP_MAX_Y;

    return (x >= 0 && y >= 0 && x <= limit_x && y <= limit_y);
}

bool builder_validate_dimensions(int width, int height) {
    return (width > 0 && height > 0 && width <= 10000 && height <= 10000);
}

map@ builder_get_player_map(player@ p) {
    if(p is null) return null;

    for(uint i = 0; i < server_maps.length(); i++) {
        if(server_maps[i].name == p.map_name) {
            return server_maps[i];
        }
    }
    return null;
}

string builder_trim(string value) {
    string result = value;
    while(result.length() > 0 && (result.substr(0, 1) == " " || result.substr(0, 1) == "\t")) {
        result = result.substr(1);
    }
    while(result.length() > 0 && (result.substr(result.length() - 1, 1) == " " || result.substr(result.length() - 1, 1) == "\t")) {
        result = result.substr(0, result.length() - 1);
    }
    return result;
}

bool builder_is_valid_map_name(string map_name) {
    if(map_name == "" || map_name.length() > 80) return false;
    if(map_name.find(" ") >= 0) return false;
    if(map_name.find("/") >= 0 || map_name.find("\\") >= 0) return false;
    if(map_name.find("..") >= 0 || map_name.find(":") >= 0) return false;
    return true;
}

string builder_existing_map_path(string map_name) {
    string path_local = "maps/" + map_name + ".map";
    if(file_exists(path_local)) return path_local;
    string path_server = "server/maps/" + map_name + ".map";
    if(file_exists(path_server)) return path_server;
    return "";
}

string builder_preferred_map_path(string map_name) {
    string existing = builder_existing_map_path(map_name);
    if(existing != "") return existing;
    if(directory_exists("server/maps")) return "server/maps/" + map_name + ".map";
    if(!directory_exists("maps")) directory_create("maps");
    return "maps/" + map_name + ".map";
}

void req_builder_create_element(player@ p, string element_data) {
    if(!builder_check_permission(p)) {
        builder_send_error(p, "Permissão negada. Nível Construtor (rank 3+) é exigido.");
        return;
    }

    if(element_data == "") {
        builder_send_error(p, "Dados do elemento inválidos (vazio).");
        return;
    }

    map@ current_map = builder_get_player_map(p);
    if(current_map is null) {
        builder_send_error(p, "Mapa não encontrado: " + p.map_name);
        return;
    }

    string[] parsed = element_data.split(":");
    if(parsed.length() < 2) {
        builder_send_error(p, "Formato inválido. Use: tipo:param1:param2:...");
        return;
    }

    string element_type = parsed[0].lower();

    bool success = false;

    if(element_type == "p" || element_type == "platform") {
        success = builder_create_platform(p, current_map, parsed);
    }
    else if(element_type == "w" || element_type == "wall" || element_type == "pwall") {
        success = builder_create_wall(p, current_map, parsed);
    }
    else if(element_type == "sc" || element_type == "staircase") {
        success = builder_create_staircase(p, current_map, parsed);
    }
    else if(element_type == "z" || element_type == "zone") {
        success = builder_create_zone(p, current_map, parsed);
    }
    else if(element_type == "sz" || element_type == "safezone") {
        success = builder_create_safezone(p, current_map, parsed);
    }
    else if(element_type == "npc") {
        success = builder_create_npc(p, current_map, parsed);
    }
    else if(element_type == "item") {
        success = builder_create_item(p, current_map, parsed);
    }
    else if(element_type == "rt") {
        success = builder_create_toilet(p, current_map, parsed);
    }
    else if(element_type == "lv") {
        success = builder_create_sink(p, current_map, parsed);
    }
    else if(element_type == "ex") {
        success = builder_create_extraction(p, current_map, parsed);
    }
    else if(element_type == "door" || element_type == "porta" || element_type == "dr") {
        success = builder_create_door(p, current_map, parsed);
    }
    else if(element_type == "ss" || element_type == "sound_source" || element_type == "som") {
        success = builder_create_sound_source(p, current_map, parsed);
    }
    else if(element_type == "texto" || element_type == "txt") {
        success = builder_create_text(p, current_map, parsed);
    }
    else if(element_type == "tp" || element_type == "travelpoint") {
        success = builder_create_travelpoint(p, current_map, parsed);
    }
    else if(element_type == "portal") {
        success = builder_create_portal(p, current_map, parsed);
    }
    else if(element_type == "store") {
        success = builder_create_store(p, current_map, parsed);
    }
    else if(element_type == "death" || element_type == "deaths") {
        success = builder_create_death_area(p, current_map, parsed);
    }
    else if(element_type == "am" || element_type == "areia_movedissa") {
        success = builder_create_quicksand(p, current_map, parsed);
    }
    else if(element_type == "maxx") {
        success = builder_set_map_max_x(p, current_map, parsed);
    }
    else if(element_type == "maxy") {
        success = builder_set_map_max_y(p, current_map, parsed);
    }
    else if(element_type == "teto") {
        success = builder_set_ceiling(p, current_map, parsed);
    }
    else if(element_type == "dv") {
        success = builder_disable_element(p, current_map, parsed);
    }
    else {
        builder_send_error(p, "Tipo de elemento desconhecido: " + element_type);
        return;
    }

    if(success) {
        current_map.add_line(element_data);

        log_to_database("INFO", "BUILDER", "Elemento criado: " + element_type,
                       get_player_index_from(p.charname), p.charname);
    }
}

bool builder_remove_last_from_map_array(map@ current_map, string element_type) {
    if(current_map is null) return false;

    if(element_type == "p" || element_type == "platform" || element_type == "sc" || element_type == "staircase") {
        if(current_map.platforms.length() == 0) return false;
        current_map.platforms.remove_at(current_map.platforms.length() - 1);
        return true;
    }
    if(element_type == "w" || element_type == "wall" || element_type == "pwall") {
        if(current_map.walls.length() == 0) return false;
        current_map.walls.remove_at(current_map.walls.length() - 1);
        return true;
    }
    if(element_type == "z" || element_type == "zone") {
        if(current_map.zones.length() == 0) return false;
        current_map.zones.remove_at(current_map.zones.length() - 1);
        return true;
    }
    if(element_type == "sz" || element_type == "safezone") {
        if(current_map.safezones.length() == 0) return false;
        current_map.safezones.remove_at(current_map.safezones.length() - 1);
        return true;
    }
    if(element_type == "npc") {
        if(current_map.npcs.length() == 0) return false;
        current_map.npcs.remove_at(current_map.npcs.length() - 1);
        return true;
    }
    if(element_type == "item") {
        if(current_map.objs.length() == 0) return false;
        current_map.objs.remove_at(current_map.objs.length() - 1);
        return true;
    }
    if(element_type == "rt") {
        if(current_map.banheiros.length() == 0) return false;
        current_map.banheiros.remove_at(current_map.banheiros.length() - 1);
        return true;
    }
    if(element_type == "lv") {
        if(current_map.pias.length() == 0) return false;
        current_map.pias.remove_at(current_map.pias.length() - 1);
        return true;
    }
    if(element_type == "ex") {
        if(current_map.extracts.length() == 0) return false;
        current_map.extracts.remove_at(current_map.extracts.length() - 1);
        return true;
    }
    if(element_type == "door" || element_type == "porta" || element_type == "dr") {
        if(current_map.doors.length() == 0) return false;
        current_map.doors.remove_at(current_map.doors.length() - 1);
        return true;
    }
    if(element_type == "ss" || element_type == "sound_source" || element_type == "som") {
        if(current_map.sound_sources.length() == 0) return false;
        current_map.sound_sources.remove_at(current_map.sound_sources.length() - 1);
        return true;
    }
    if(element_type == "texto" || element_type == "txt") {
        if(current_map.textos.length() == 0) return false;
        current_map.textos.remove_at(current_map.textos.length() - 1);
        return true;
    }
    if(element_type == "tp" || element_type == "travelpoint") {
        if(current_map.travel_points.length() == 0) return false;
        current_map.travel_points.remove_at(current_map.travel_points.length() - 1);
        return true;
    }

    return false;
}

void builder_rebuild_runtime_settings_from_mapdata(map@ current_map) {
    if(current_map is null) return;

    int rebuilt_max_x = current_map.max_x;
    int rebuilt_max_y = current_map.max_y;
    bool has_max_x = false;
    bool has_max_y = false;
    string rebuilt_ceiling = "";

    current_map.desactivados.delete_all();

    for(uint i = 0; i < current_map.mapdata.length(); i++) {
        string[] parsed = current_map.mapdata[i].split(":");
        if(parsed.length() == 0) continue;

        string element_type = parsed[0].lower();
        if(element_type == "maxx" && parsed.length() > 1) {
            int value = string_to_number(parsed[1]);
            if(value > 0 && value <= BUILDER_MAP_MAX_X) {
                rebuilt_max_x = value;
                has_max_x = true;
            }
        }
        else if(element_type == "maxy" && parsed.length() > 1) {
            int value = string_to_number(parsed[1]);
            if(value > 0 && value <= BUILDER_MAP_MAX_Y) {
                rebuilt_max_y = value;
                has_max_y = true;
            }
        }
        else if(element_type == "teto" && parsed.length() > 1) {
            rebuilt_ceiling = parsed[1];
        }
        else if(element_type == "dv" && parsed.length() > 1) {
            current_map.desactivados.set(parsed[1], parsed[1]);
        }
    }

    if(has_max_x) current_map.max_x = rebuilt_max_x;
    if(has_max_y) current_map.max_y = rebuilt_max_y;
    current_map.ceiling_sound = rebuilt_ceiling;
}

bool builder_undo_last_element(player@ p, string line_hint) {
    if(!builder_check_permission(p)) {
        builder_send_error(p, "Permissão negada.");
        return false;
    }

    map@ current_map = builder_get_player_map(p);
    if(current_map is null) {
        builder_send_error(p, "Mapa não encontrado: " + p.map_name);
        return false;
    }

    if(current_map.mapdata.length() == 0) {
        builder_send_error(p, "Não há linhas para desfazer.");
        return false;
    }

    string target_line = builder_trim(line_hint);
    if(target_line == "") {
        target_line = current_map.mapdata[current_map.mapdata.length() - 1];
    }

    int line_index = -1;
    for(uint i = 0; i < current_map.mapdata.length(); i++) {
        if(current_map.mapdata[i] == target_line) {
            line_index = int(i);
        }
    }

    if(line_index < 0) {
        builder_send_error(p, "Linha para desfazer não encontrada no mapdata atual.");
        return false;
    }

    string[] parsed = target_line.split(":");
    if(parsed.length() == 0 || parsed[0] == "") {
        builder_send_error(p, "Linha inválida para desfazer.");
        return false;
    }

    string element_type = parsed[0].lower();
    if(element_type == "maxx" || element_type == "maxy" || element_type == "teto" || element_type == "dv" || element_type == "portal" || element_type == "store" || element_type == "death" || element_type == "deaths" || element_type == "am" || element_type == "areia_movedissa") {
        current_map.mapdata.remove_at(line_index);
        builder_rebuild_runtime_settings_from_mapdata(current_map);
        builder_send_success(p, "Ultimo elemento desfeito: " + element_type);
        log_to_database("INFO", "BUILDER", "Undo elemento: " + element_type,
                        get_player_index_from(p.charname), p.charname);
        return true;
    }
    if(!builder_remove_last_from_map_array(current_map, element_type)) {
        builder_send_error(p, "Undo não suportado para o tipo '" + element_type + "' via builder dinâmico.");
        return false;
    }

    current_map.mapdata.remove_at(line_index);
    builder_send_success(p, "Ultimo elemento desfeito: " + element_type);
    log_to_database("INFO", "BUILDER", "Undo elemento: " + element_type,
                    get_player_index_from(p.charname), p.charname);
    return true;
}

bool builder_create_platform(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 5) {
        builder_send_error(p, "Plataforma requer: p:minx:miny:maxy:som");
        return false;
    }

    int minx = string_to_number(parsed[1]);
    int miny = string_to_number(parsed[2]);
    int maxy = string_to_number(parsed[3]);
    string snd = parsed[4];

    if(!builder_validate_coords(minx, miny, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    if(current_map.platforms.length() >= BUILDER_MAX_PLATFORMS_PER_MAP) {
        builder_send_error(p, "Limite de plataformas atingido (" + BUILDER_MAX_PLATFORMS_PER_MAP + ").");
        return false;
    }

    platform@ new_platform = platform(parsed[0], minx, miny, maxy, maxy, snd);
    current_map.platforms.insert_last(new_platform);

    builder_send_success(p, "Plataforma criada em x=" + minx + " y=" + miny + "-" + maxy);
    return true;
}

bool builder_create_wall(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 5) {
        builder_send_error(p, "Parede requer: pwall:x:miny:maxy:som");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int miny = string_to_number(parsed[2]);
    int maxy = string_to_number(parsed[3]);
    string snd = parsed[4];

    if(!builder_validate_coords(x, miny, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    if(current_map.walls.length() >= BUILDER_MAX_WALLS_PER_MAP) {
        builder_send_error(p, "Limite de paredes atingido (" + BUILDER_MAX_WALLS_PER_MAP + ").");
        return false;
    }

    wall@ new_wall = wall(x, current_map.name, 600000);
    new_wall.miny = miny;
    new_wall.maxy = maxy;
    new_wall.sound_wall = snd;
    current_map.walls.insert_last(new_wall);

    builder_send_success(p, "Parede criada em x=" + x + " y=" + miny + "-" + maxy);
    return true;
}

bool builder_create_staircase(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 6) {
        builder_send_error(p, "Escada requer: sc:minx:miny:maxx:maxy:som");
        return false;
    }

    int minx = string_to_number(parsed[1]);
    int miny = string_to_number(parsed[2]);
    int maxx = string_to_number(parsed[3]);
    int maxy = string_to_number(parsed[4]);
    string snd = parsed[5];

    if(!builder_validate_coords(minx, miny, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    platform@ new_stair = platform("sc", minx, miny, maxx, maxy, snd);
    current_map.platforms.insert_last(new_stair);

    builder_send_success(p, "Escada criada de (" + minx + "," + miny + ") a (" + maxx + "," + maxy + ")");
    return true;
}

bool builder_create_zone(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 6) {
        builder_send_error(p, "Zona requer: z:minx:maxx:miny:maxy:nome");
        return false;
    }

    int minx = string_to_number(parsed[1]);
    int maxx = string_to_number(parsed[2]);
    int miny = string_to_number(parsed[3]);
    int maxy = string_to_number(parsed[4]);
    string name = parsed[5];

    if(!builder_validate_coords(minx, miny, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    if(current_map.zones.length() >= BUILDER_MAX_ZONES_PER_MAP) {
        builder_send_error(p, "Limite de zonas atingido (" + BUILDER_MAX_ZONES_PER_MAP + ").");
        return false;
    }

    zone@ new_zone = zone(minx, maxx, miny, maxy, name);
    current_map.zones.insert_last(new_zone);

    builder_send_success(p, "Zona '" + name + "' criada de (" + minx + "," + miny + ") a (" + maxx + "," + maxy + ")");
    return true;
}

bool builder_create_safezone(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 5) {
        builder_send_error(p, "Zona segura requer: sz:minx:maxx:miny:maxy");
        return false;
    }

    int minx = string_to_number(parsed[1]);
    int maxx = string_to_number(parsed[2]);
    int miny = string_to_number(parsed[3]);
    int maxy = string_to_number(parsed[4]);

    if(!builder_validate_coords(minx, miny, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    safezone@ new_sz = safezone(minx, maxx, miny, maxy);
    current_map.safezones.insert_last(new_sz);

    builder_send_success(p, "Zona segura criada de (" + minx + "," + miny + ") a (" + maxx + "," + maxy + ")");
    return true;
}

bool builder_create_toilet(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 3) {
        builder_send_error(p, "Vaso sanitário requer: rt:x:y");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int y = string_to_number(parsed[2]);

    if(!builder_validate_coords(x, y, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    banheiro@ new_toilet = banheiro(x, y, current_map.name);
    current_map.banheiros.insert_last(new_toilet);

    builder_send_success(p, "Vaso sanitário criado em (" + x + "," + y + ")");
    return true;
}

bool builder_create_sink(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 3) {
        builder_send_error(p, "Pia requer: lv:x:y");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int y = string_to_number(parsed[2]);

    if(!builder_validate_coords(x, y, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    pia@ new_sink = pia(x, y, current_map.name);
    current_map.pias.insert_last(new_sink);

    builder_send_success(p, "Pia criada em (" + x + "," + y + ")");
    return true;
}

bool builder_create_extraction(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 11) {
        builder_send_error(p, "Extração requer 11 parâmetros.");
        return false;
    }

    int x1 = string_to_number(parsed[1]);
    int x2 = string_to_number(parsed[2]);
    int y1 = string_to_number(parsed[3]);
    int y2 = string_to_number(parsed[4]);
    int qty = string_to_number(parsed[5]);
    int presses = string_to_number(parsed[6]);
    int speed = string_to_number(parsed[7]);
    string item = parsed[8];
    string sound_press = parsed[9];
    string sound_spawn = parsed[10];

    if(!builder_validate_coords(x1, y1, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    extract@ new_extract = extract(x1, x2, y1, y2, qty, presses, speed, item, sound_press, sound_spawn);
    current_map.extracts.insert_last(new_extract);

    builder_send_success(p, "Zona de extração '" + item + "' criada.");
    return true;
}

bool builder_create_item(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 9) {
        builder_send_error(p, "Item requer 9 parâmetros.");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int y = string_to_number(parsed[2]);
    int timeout = string_to_number(parsed[3]);
    int qty = string_to_number(parsed[5]);
    string item_name = parsed[6];
    string snd = parsed[7];
    int respawn = string_to_number(parsed[8]);

    if(!builder_validate_coords(x, y, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    if(current_map.objs.length() >= BUILDER_MAX_ITEMS_PER_MAP) {
        builder_send_error(p, "Limite de itens atingido.");
        return false;
    }

    obj@ new_obj = obj(x, y, timeout, 0, qty, item_name, current_map.name, snd, respawn);
    current_map.objs.insert_last(new_obj);

    builder_send_success(p, "Item '" + item_name + "' x" + qty + " criado em (" + x + "," + y + ")");
    return true;
}

bool builder_create_npc(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 26) {
        builder_send_error(p, "NPC requer 26+ parâmetros. Use o menu de builder.");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int y = string_to_number(parsed[2]);

    if(!builder_validate_coords(x, y, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    if(current_map.npcs.length() >= BUILDER_MAX_NPCS_PER_MAP) {
        builder_send_error(p, "Limite de NPCs atingido (" + BUILDER_MAX_NPCS_PER_MAP + ").");
        return false;
    }

    npc@ new_npc = npc(
        string_to_number(parsed[1]),
        string_to_number(parsed[2]),
        string_to_number(parsed[3]),
        string_to_number(parsed[4]),
        string_to_number(parsed[5]),
        string_to_number(parsed[6]),
        string_to_number(parsed[7]),
        string_to_number(parsed[8]),
        string_to_number(parsed[9]),
        string_to_number(parsed[10]),
        string_to_number(parsed[11]),
        parsed[12],
        parsed[13],
        parsed[14],
        parsed[15],
        parsed[16],
        parsed[17],
        string_to_number(parsed[18]),
        (string_to_number(parsed[19]) != 0),
        (string_to_number(parsed[20]) != 0),
        current_map.name,
        parsed[21],
        string_to_number(parsed[22]),
        string_to_number(parsed[23]),
        parsed[24],
        parsed[25]
    );

    current_map.npcs.insert_last(new_npc);

    builder_send_success(p, "NPC criado em (" + x + "," + y + ")");
    return true;
}

bool builder_create_door(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 10) {
        builder_send_error(p, "Porta requer 10+ parâmetros.");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int miny = string_to_number(parsed[2]);
    int maxy = string_to_number(parsed[3]);

    if(!builder_validate_coords(x, miny, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    door@ new_door = door(x, miny,
                         x, maxy,
                         5,
                         parsed[6],
                         parsed[7],
                         parsed[8],
                         parsed[9]);

    current_map.doors.insert_last(new_door);

    builder_send_success(p, "Porta criada em x=" + x + " y=" + miny + "-" + maxy);
    return true;
}

bool builder_create_sound_source(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 6) {
        builder_send_error(p, "Som ambiente requer: ss:x:y:som:volume:loop");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int y = string_to_number(parsed[2]);
    string snd = parsed[3];
    double volume = parse_float(parsed[4]);
    bool loop = (string_to_number(parsed[5]) != 0);

    if(!builder_validate_coords(x, y, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    sound_source@ new_ss = sound_source(x, x, y, y, snd, "ss_" + x + "_" + y);
    new_ss.volume = int(volume * 100);
    current_map.sound_sources.insert_last(new_ss);

    builder_send_success(p, "Fonte sonora '" + snd + "' criada em (" + x + "," + y + ")");
    return true;
}

bool builder_create_text(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 4) {
        builder_send_error(p, "Texto requer: texto:x:y:conteúdo");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int y = string_to_number(parsed[2]);

    string content = parsed[3];
    for(uint i = 4; i < parsed.length(); i++) {
        content += ":" + parsed[i];
    }

    if(!builder_validate_coords(x, y, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas fora dos limites do mapa.");
        return false;
    }

    texto@ new_text = texto(x, y, content);
    current_map.textos.insert_last(new_text);

    builder_send_success(p, "Texto criado em (" + x + "," + y + ")");
    return true;
}

bool builder_create_travelpoint(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 9) {
        builder_send_error(p, "Travelpoint requer 9 parâmetros: tp:zx1:zy1:zx2:zy2:destx:desty:destmap:message");
        return false;
    }

    int zx1 = string_to_number(parsed[1]);
    int zy1 = string_to_number(parsed[2]);
    int zx2 = string_to_number(parsed[3]);
    int zy2 = string_to_number(parsed[4]);
    int dest_x = string_to_number(parsed[5]);
    int dest_y = string_to_number(parsed[6]);
    string dest_map = parsed[7];
    string message = parsed[8];

    if(!builder_validate_coords(zx1, zy1, current_map.max_x, current_map.max_y) ||
       !builder_validate_coords(zx2, zy2, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas da zona fora dos limites do mapa.");
        return false;
    }

    travel_point@ new_tp = travel_point(zx1, zy1, zx2, zy2, dest_x, dest_y, dest_map, message);
    current_map.travel_points.insert_last(new_tp);

    builder_send_success(p, "Travelpoint para '" + dest_map + "' criado na zona (" + zx1 + "," + zy1 + ")-(" + zx2 + "," + zy2 + ")");
    return true;
}
bool builder_create_portal(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 6) {
        builder_send_error(p, "Portal requer: portal:x:y:dest_map:dest_x:dest_y");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int y = string_to_number(parsed[2]);
    string dest_map = parsed[3].trim_whitespace().lower();
    int dest_x = string_to_number(parsed[4]);
    int dest_y = string_to_number(parsed[5]);

    if(!builder_validate_coords(x, y, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas do portal fora dos limites do mapa atual.");
        return false;
    }

    if(!builder_is_valid_map_name(dest_map)) {
        builder_send_error(p, "Mapa de destino inválido.");
        return false;
    }

    string map_file = builder_existing_map_path(dest_map);
    if(map_file == "") {
        builder_send_error(p, "Mapa de destino não encontrado: " + dest_map);
        return false;
    }

    builder_send_success(p, "Portal criado em (" + x + "," + y + ") para " + dest_map + " (" + dest_x + "," + dest_y + ")");
    return true;
}

bool builder_create_store(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 6) {
        builder_send_error(p, "Store requer: store:x1:x2:y1:y2:store_type");
        return false;
    }

    int x1 = string_to_number(parsed[1]);
    int x2 = string_to_number(parsed[2]);
    int y1 = string_to_number(parsed[3]);
    int y2 = string_to_number(parsed[4]);
    string store_type = parsed[5].trim_whitespace().lower();

    if(store_type == "") {
        builder_send_error(p, "Tipo de loja inválido.");
        return false;
    }

    int minx = x1 <= x2 ? x1 : x2;
    int maxx = x1 <= x2 ? x2 : x1;
    int miny = y1 <= y2 ? y1 : y2;
    int maxy = y1 <= y2 ? y2 : y1;

    if(!builder_validate_coords(minx, miny, current_map.max_x, current_map.max_y) ||
       !builder_validate_coords(maxx, maxy, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas da loja fora dos limites do mapa.");
        return false;
    }

    builder_send_success(p, "Loja '" + store_type + "' criada na area (" + minx + "," + miny + ")-(" + maxx + "," + maxy + ")");
    return true;
}

bool builder_create_death_area(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 5) {
        builder_send_error(p, "Death requer ao menos: death:x1:x2:y1:y2");
        return false;
    }

    int x1 = string_to_number(parsed[1]);
    int x2 = string_to_number(parsed[2]);
    int y1 = string_to_number(parsed[3]);
    int y2 = string_to_number(parsed[4]);

    int minx = x1 <= x2 ? x1 : x2;
    int maxx = x1 <= x2 ? x2 : x1;
    int miny = y1 <= y2 ? y1 : y2;
    int maxy = y1 <= y2 ? y2 : y1;

    if(!builder_validate_coords(minx, miny, current_map.max_x, current_map.max_y) ||
       !builder_validate_coords(maxx, maxy, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas da area de morte fora dos limites do mapa.");
        return false;
    }

    builder_send_success(p, "Area de morte criada em (" + minx + "," + miny + ")-(" + maxx + "," + maxy + ")");
    return true;
}

bool builder_create_quicksand(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 3) {
        builder_send_error(p, "Areia movediça requer: am:x:y");
        return false;
    }

    int x = string_to_number(parsed[1]);
    int y = string_to_number(parsed[2]);

    if(!builder_validate_coords(x, y, current_map.max_x, current_map.max_y)) {
        builder_send_error(p, "Coordenadas da areia movediça fora dos limites do mapa.");
        return false;
    }

    builder_send_success(p, "Areia movediça criada em (" + x + "," + y + ")");
    return true;
}

bool builder_set_map_max_x(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 2) {
        builder_send_error(p, "maxx requer valor.");
        return false;
    }

    int new_max_x = string_to_number(parsed[1]);
    if(new_max_x <= 0 || new_max_x > BUILDER_MAP_MAX_X) {
        builder_send_error(p, "Valor inválido (1-" + BUILDER_MAP_MAX_X + ").");
        return false;
    }

    current_map.max_x = new_max_x;
    builder_send_success(p, "Limite X do mapa definido para " + new_max_x);
    return true;
}

bool builder_set_map_max_y(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 2) {
        builder_send_error(p, "maxy requer valor.");
        return false;
    }

    int new_max_y = string_to_number(parsed[1]);
    if(new_max_y <= 0 || new_max_y > BUILDER_MAP_MAX_Y) {
        builder_send_error(p, "Valor inválido (1-" + BUILDER_MAP_MAX_Y + ").");
        return false;
    }

    current_map.max_y = new_max_y;
    builder_send_success(p, "Limite Y do mapa definido para " + new_max_y);
    return true;
}

bool builder_set_ceiling(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 2) {
        builder_send_error(p, "teto requer som (ou 'none').");
        return false;
    }

    current_map.ceiling_sound = parsed[1];
    builder_send_success(p, "Teto configurado: " + parsed[1]);
    return true;
}

bool builder_disable_element(player@ p, map@ current_map, string[] parsed) {
    if(parsed.length() < 2) {
        builder_send_error(p, "dv requer nome do elemento.");
        return false;
    }

    current_map.desactivados.set(parsed[1], parsed[1]);
    builder_send_success(p, "Elemento '" + parsed[1] + "' desativado no mapa.");
    return true;
}

bool builder_save_map(player@ p, map@ target_map) {
    if(!builder_check_permission(p)) {
        builder_send_error(p, "Permissão negada.");
        return false;
    }

    if(target_map is null) {
        builder_send_error(p, "Mapa não encontrado.");
        return false;
    }

    map_global_mutex.lock();

    bool success = false;

    string content = "";
    for(uint i = 0; i < target_map.mapdata.length(); i++) {
        if(i > 0) content += "\r\n";
        content += target_map.mapdata[i];
    }

    string map_path = builder_preferred_map_path(target_map.name);
    file f;
    if(f.open(map_path, "w")) {
        f.write(content);
        f.close();
        success = true;
        builder_send_success(p, "Mapa '" + target_map.name + "' salvo com sucesso!");
        debug_log("BUILDER SAVE: " + p.charname + " salvou mapa " + target_map.name);
    } else {
        builder_send_error(p, "Erro ao salvar arquivo do mapa.");
    }

    map_global_mutex.unlock();

    return success;
}

bool builder_update_map(player@ p, string map_name = "") {
    if(!builder_check_permission(p)) {
        builder_send_error(p, "Permissão negada.");
        return false;
    }

    string target_name = (map_name != "") ? map_name : p.map_name;

    for(uint i = 0; i < server_maps.length(); i++) {
        if(server_maps[i].name == target_name) {
            map refreshed_map(target_name + ".map");
            if(refreshed_map.mapdata.length() == 0) {
                builder_send_error(p, "Falha ao carregar arquivo do mapa '" + target_name + "'.");
                return false;
            }
            refreshed_map.mapindex = int(i);
            server_maps[i] = refreshed_map;
            builder_send_success(p, "Mapa '" + target_name + "' atualizado!");

            for(uint j = 0; j < players.length(); j++) {
                if((players[j].map_name == target_name || players[j].map == target_name) && players[j].is_logged_in) {
                    int pindex = get_player_index_from(players[j].charname);
                    if(pindex >= 0) {
                        changemap(target_name, pindex, players[j].x, players[j].y);
                    }
                }
            }

            return true;
        }
    }

    builder_send_error(p, "Mapa '" + target_name + "' não encontrado.");
    return false;
}

bool builder_create_new_map(player@ p, string map_name, int width, int height, string floor_sound = "1") {
    if(!builder_check_permission(p)) {
        builder_send_error(p, "Permissão negada.");
        return false;
    }

    map_name = builder_trim(map_name);
    floor_sound = builder_trim(floor_sound);
    if(floor_sound == "") floor_sound = "1";

    if(!builder_is_valid_map_name(map_name)) {
        builder_send_error(p, "Nome de mapa inválido. Use nome sem espaços e sem caracteres de caminho.");
        return false;
    }

    if(!builder_validate_dimensions(width, height)) {
        builder_send_error(p, "Dimensões inválidas.");
        return false;
    }

    if(get_map_index_from(map_name) >= 0 || builder_existing_map_path(map_name) != "") {
        builder_send_error(p, "Já existe um mapa com esse nome.");
        return false;
    }

    string[] lines;
    lines.insert_last("map:" + map_name);
    lines.insert_last("maxx:" + width);
    lines.insert_last("maxy:" + height);
    lines.insert_last("platform:0:0:" + height + ":" + floor_sound);
    lines.insert_last("wall:0:0:" + height + ":wallgeneric");
    lines.insert_last("wall:" + width + ":0:" + height + ":wallgeneric");
    lines.insert_last("safezone:0:" + width + ":0:" + height);
    lines.insert_last("zone:0:" + width + ":0:" + height + ":" + map_name);

    string content = linear(lines, "\r\n");
    string new_map_path = builder_preferred_map_path(map_name);

    file map_file;
    if(!map_file.open(new_map_path, "w")) {
        builder_send_error(p, "Erro ao criar arquivo do mapa.");
        return false;
    }
    map_file.write(content);
    map_file.close();

    map new_map(map_name + ".map");
    new_map.mapindex = int(server_maps.length());
    server_maps.insert_last(new_map);

    builder_send_success(p, "Mapa '" + map_name + "' criado com sucesso!");
    debug_log("BUILDER CREATE MAP: " + p.charname + " criou " + map_name);
    log_to_database("INFO", "BUILDER", "Novo mapa criado: " + map_name, get_player_index_from(p.charname), p.charname);
    return true;
}

bool builder_delete_map(player@ p, string map_name) {
    if(!builder_check_permission(p)) {
        builder_send_error(p, "Permissão negada.");
        return false;
    }

    map_name = builder_trim(map_name);
    if(!builder_is_valid_map_name(map_name)) {
        builder_send_error(p, "Nome de mapa inválido.");
        return false;
    }

    if(map_name == mapainicial) {
        builder_send_error(p, "Não é permitido deletar o mapa inicial.");
        return false;
    }

    int map_index = get_map_index_from(map_name);
    if(map_index >= 0) {
        for(uint i = 0; i < players.length(); i++) {
            if((players[i].map_name == map_name || players[i].map == map_name) && players[i].is_logged_in) {
                int pindex = get_player_index_from(players[i].charname);
                if(pindex >= 0) changemap(mapainicial, pindex, 1, 0);
            }
        }

        server_maps.remove_at(map_index);
        for(uint i = map_index; i < server_maps.length(); i++) {
            server_maps[i].mapindex = int(i);
        }
    }

    bool removed_file = false;
    string local_path = "maps/" + map_name + ".map";
    if(file_exists(local_path)) {
        file_delete(local_path);
        removed_file = true;
    }
    string server_path = "server/maps/" + map_name + ".map";
    if(file_exists(server_path)) {
        file_delete(server_path);
        removed_file = true;
    }

    if(map_index < 0 && !removed_file) {
        builder_send_error(p, "Mapa '" + map_name + "' não encontrado.");
        return false;
    }

    builder_send_success(p, "Mapa '" + map_name + "' deletado com sucesso.");
    debug_log("BUILDER DELETE MAP: " + p.charname + " deletou " + map_name);
    log_to_database("INFO", "BUILDER", "Mapa deletado: " + map_name, get_player_index_from(p.charname), p.charname);
    return true;
}
