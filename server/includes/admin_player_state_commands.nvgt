// Comando /kill - Matar jogador
void cmd_kill(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "kill", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "kill", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "kill", "Jogador não encontrado!");
		return;
	}

	players[target].health = 0;
	players[target].dead = true;

	send_reliable_text(players[target].peer_id, "msg2 Você foi morto por um administrador.", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " foi morto.", 0);

	broadcast_message_to_map(players[target].map, "playsound death.ogg " + players[target].x + " " + players[target].y);

	debug_log("ADMIN: " + players[player_index].charname + " matou " + target_name);
}

// Comando /heal - Curar jogador
void cmd_heal(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "heal", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "heal", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "heal", "Jogador não encontrado!");
		return;
	}

	players[target].health = players[target].max_health;

	send_reliable_text(players[target].peer_id, "msg2 Você foi curado por um administrador!", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " foi curado.", 0);

	debug_log("ADMIN: " + players[player_index].charname + " curou " + target_name);
}

// Comando /revive - Reviver jogador morto
void cmd_revive(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "revive", "Você não tem permissao!");
		return;
	}

	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "revive", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "revive", "Jogador não encontrado!");
		return;
	}

	if(!players[target].dead) {
		send_admin_error(player_index, "revive", "Jogador não está morto!");
		return;
	}

	players[target].dead = false;
	players[target].health = players[target].max_health;

	send_reliable_text(players[target].peer_id, "msg2 Você foi revivido por um administrador!", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " foi revivido.", 0);

	debug_log("ADMIN: " + players[player_index].charname + " reviveu " + target_name);
}
