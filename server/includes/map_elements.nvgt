// map_elements.nvgt - Classes para elementos de mapa (Task 1.3.1)
// Implementação completa dos 27+ tipos de elementos faltantes no servidor

// ============================================================================
// PORTAS (DOORS) - Elementos interativos que abrem/fecham
// ============================================================================
class door {
	int x, y;           // Posição da porta
	int fx, fy;         // Posição final (destino ao atravessar)
	int speed;          // Velocidade de abertura
	string map;         // Mapa onde a porta está
	string sound_open;  // Som ao abrir
	string sound_close; // Som ao fechar
	string sound_lock;  // Som de porta trancada
	string sound_use;   // Som ao usar
	bool is_open = false;
	bool is_locked = false;
	timer open_timer;

	door(int x, int y, int fx, int fy, int speed, string snd1, string snd2, string snd3, string snd4) {
		this.x = x;
		this.y = y;
		this.fx = fx;
		this.fy = fy;
		this.speed = speed;
		this.sound_open = snd1;
		this.sound_close = snd2;
		this.sound_lock = snd3;
		this.sound_use = snd4;
	}
}

// ============================================================================
// FONTES SONORAS (SOUND SOURCES) - Sons ambientes estáticos em zonas
// ============================================================================
class sound_source {
	int minx, maxx, miny, maxy; // Área de efeito do som
	string sound_file;          // Arquivo de som (.ogg)
	string id;                  // ID único da fonte sonora
	string map;                 // Mapa onde está localizado
	int volume = 100;           // Volume (0-100)
	bool active = true;         // Se está ativo

	sound_source(int lx, int rx, int miny, int maxy, string sound_file, string id) {
		this.minx = lx;
		this.maxx = rx;
		this.miny = miny;
		this.maxy = maxy;
		this.sound_file = sound_file;
		this.id = id;
	}
}

// ============================================================================
// STREAMS DE SOM (SOUND STREAMS) - Música de fundo em zonas específicas
// ============================================================================
class sound_stream {
	int minx, maxx, miny, maxy; // Área de efeito
	string sound_file;          // Arquivo de música (.ogg)
	int volume = 0;             // Volume do stream
	string map;                 // Mapa

	sound_stream(int minx, int maxx, int miny, int maxy, string sound_file, int volume) {
		this.minx = minx;
		this.maxx = maxx;
		this.miny = miny;
		this.maxy = maxy;
		this.sound_file = sound_file;
		this.volume = volume;
	}
}

// ============================================================================
// OBJETOS DE TEXTO (TEXT OBJECTS) - Textos exibidos em coordenadas específicas
// ============================================================================
class texto {
	int x, y;
	string text;
	string map;

	texto(int x, int y, string text) {
		this.x = x;
		this.y = y;
		this.text = text;
	}
}

// ============================================================================
// DIÁLOGOS (DIALOGS) - Pop-ups de mensagem em locais específicos
// ============================================================================
class dialog {
	int x, y;
	string message;
	string sound_trigger = ""; // Som ao ativar diálogo (opcional)
	string map;
	bool activated = false;
	timer activation_timer;

	dialog(int x, int y, string message, string sound = "") {
		this.x = x;
		this.y = y;
		this.message = message;
		this.sound_trigger = sound;
	}
}

// ============================================================================
// AREIA MOVEDIÇA (QUICKSAND) - Zonas que prendem/afundam jogadores
// ============================================================================
class quicksand {
	int x, y;
	string map;
	int damage_per_tick = 5;      // Dano por tick
	int slow_factor = 50;         // Fator de lentidão (%)
	timer damage_timer;

	quicksand(int x, int y, string mapname) {
		this.x = x;
		this.y = y;
		this.map = mapname;
	}
}

// ============================================================================
// PONTOS DE VIAGEM (TRAVEL POINTS) - Teleportes entre mapas
// ============================================================================
class travel_point {
	int zone_x1, zone_y1, zone_x2, zone_y2; // Zona de ativação
	int dest_x, dest_y;                     // Destino
	string dest_map;                        // Mapa de destino
	string message;                         // Mensagem ao teleportar
	string map;                             // Mapa atual
	bool activated = false;
	timer activation_timer;

	travel_point(int zx1, int zy1, int zx2, int zy2, int dx, int dy, string dmap, string msg) {
		this.zone_x1 = zx1;
		this.zone_y1 = zy1;
		this.zone_x2 = zx2;
		this.zone_y2 = zy2;
		this.dest_x = dx;
		this.dest_y = dy;
		this.dest_map = dmap;
		this.message = msg;
	}
}

// ============================================================================
// PORTAL CUSTOMIZADO (PTM) - Portal com som customizado
// ============================================================================
class custom_portal {
	int zone_x1, zone_y1, zone_x2, zone_y2;
	int dest_x, dest_y;
	string dest_map;
	string message;
	string sound_portal;   // Som customizado do portal
	string map;
	bool activated = false;
	timer activation_timer;

	custom_portal(int zx1, int zy1, int zx2, int zy2, int dx, int dy, string dmap, string msg, string snd) {
		this.zone_x1 = zx1;
		this.zone_y1 = zy1;
		this.zone_x2 = zx2;
		this.zone_y2 = zy2;
		this.dest_x = dx;
		this.dest_y = dy;
		this.dest_map = dmap;
		this.message = msg;
		this.sound_portal = snd;
	}
}

// ============================================================================
// PONTO DE PICKUP (PM) - Pontos com items coletáveis e teleporte
// ============================================================================
class pickup_point {
	int zone_x1, zone_y1, zone_x2, zone_y2;
	int dest_x, dest_y;
	string dest_map;
	string message;
	string sound_item;
	string item_type;
	string map;
	bool collected = false;
	timer cooldown_timer;

	pickup_point(int zx1, int zy1, int zx2, int zy2, int dx, int dy, string dmap, string msg, string snd, string item) {
		this.zone_x1 = zx1;
		this.zone_y1 = zy1;
		this.zone_x2 = zx2;
		this.zone_y2 = zy2;
		this.dest_x = dx;
		this.dest_y = dy;
		this.dest_map = dmap;
		this.message = msg;
		this.sound_item = snd;
		this.item_type = item;
	}
}

// ============================================================================
// PORTAL COM TEMPO (CPM) - Portal customizado com tempo de viagem
// ============================================================================
class timed_portal {
	int zone_x1, zone_y1, zone_x2, zone_y2;
	int dest_x, dest_y;
	string dest_map;
	string travel_msg;
	string color;
	int travel_time;        // Tempo de viagem em ms
	string arrival_msg;
	string effect;
	string map;
	bool activated = false;
	timer activation_timer;

	timed_portal(int zx1, int zy1, int zx2, int zy2, int dx, int dy, string dmap,
	             string tmsg, string col, int ttime, string amsg, string eff) {
		this.zone_x1 = zx1;
		this.zone_y1 = zy1;
		this.zone_x2 = zx2;
		this.zone_y2 = zy2;
		this.dest_x = dx;
		this.dest_y = dy;
		this.dest_map = dmap;
		this.travel_msg = tmsg;
		this.color = col;
		this.travel_time = ttime;
		this.arrival_msg = amsg;
		this.effect = eff;
	}
}

// ============================================================================
// ZONA DE CONGELAMENTO (FREEZE ZONE) - Zonas que congelam movimento
// ============================================================================
class freeze_zone {
	int minx, maxx, miny, maxy;
	string map;
	bool active = true;

	freeze_zone(int x1, int x2, int y1, int y2) {
		this.minx = x1;
		this.maxx = x2;
		this.miny = y1;
		this.maxy = y2;
	}
}

// ============================================================================
// ZONA DE REVERB - Zonas com efeito de reverberação sonora
// ============================================================================
class reverb_zone {
	int minx, maxx, miny, maxy;
	int intensity = 50;  // Intensidade do reverb (0-100)
	string map;

	reverb_zone(int x1, int x2, int y1, int y2, int intensity = 50) {
		this.minx = x1;
		this.maxx = x2;
		this.miny = y1;
		this.maxy = y2;
		this.intensity = intensity;
	}
}

// ============================================================================
// DESCRIÇÃO (DESC) - Descrições de áreas específicas
// ============================================================================
class description {
	int x, y, fx, fy;
	string text;
	string map;

	description(int x, int y, int fx, int fy, string text) {
		this.x = x;
		this.y = y;
		this.fx = fx;
		this.fy = fy;
		this.text = text;
	}
}
