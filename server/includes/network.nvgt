
#include "client_tracker.nvgt"

enum NetChannel {
    CH_DEFAULT = 0,
    CH_CHAT = 1,
    CH_MOVE = 2,
    CH_SYSTEM = 3,
    CH_ACTION = 4,
    CH_AUDIO = 5,
    CH_ADMIN = 6,
    CH_SYNC = 7
}

const int NET_CHANNEL_COUNT = 8;

network server_net;
uint64[] connected_peers;
string[] peer_addresses;
dictionary peer_names;

const string PACKET_ENCRYPTION_KEY = "evm_server_key_2024";

string encrypt_packet(string message) {
    return string_aes_encrypt(message, PACKET_ENCRYPTION_KEY);
}

string decrypt_packet(string message) {
    return string_aes_decrypt(message, PACKET_ENCRYPTION_KEY);
}

class net_handler {
    void send_reliable_text(uint64 peer_id, string message, int channel = 0) {
        message = normalize_network_packet_text(message);
        if (peer_id == 0) {
            for(uint i = 0; i < connected_peers.length(); i++) {
                string encrypted = encrypt_packet(message);
                server_net.send(connected_peers[i], encrypted, channel, true);
            }
        } else {
            string encrypted = encrypt_packet(message);
            server_net.send(peer_id, encrypted, channel, true);
        }
    }

    void send_packet(uint64 peer_id, string message, string map_filter = "") {
        send_reliable_text(peer_id, message, 0);
    }
}

net_handler net;

bool server_init(int port) {
    debug_log("Inicializando servidor na porta " + port);
    debug_log("MAX_PLAYERS: " + MAX_PLAYERS);
    debug_log("MAX_CHANNELS: 20");

    if(!server_net.setup_server(port, MAX_PLAYERS, 20)) {
        debug_log("ERRO: Não foi possível inicializar servidor na porta " + port);
        debug_log("POSSIVEIS CAUSAS:");
        debug_log("1. Outra instancia do servidor ja esta rodando");
        debug_log("2. Outro programa esta usando a porta " + port);
        debug_log("3. Firewall bloqueando a porta");
        debug_log("");
        debug_log("SOLUCOES:");
        debug_log("- Feche outras instancias do servidor (nvgtw.exe)");
        debug_log("- Use o Gerenciador de Tarefas para encerrar processos nvgtw");
        debug_log("- Ou altere a porta em server.nvgt (const int SERVER_PORT = 9317)");
        return false;
    }

    debug_log("[OK] Servidor iniciado com sucesso na porta " + port);
    debug_log("[OK] Servidor esta ouvindo conexoes...");
    debug_log("[OK] Aguardando clientes conectarem...");
    return true;
}

void send_reliable_text(uint64 peer_id, string message, int channel = 0) {
    message = normalize_network_packet_text(message);
    if (peer_id == 0) {
        for(uint i = 0; i < connected_peers.length(); i++) {
            string encrypted = encrypt_packet(message);
            server_net.send(connected_peers[i], encrypted, channel, true);
        }
    } else {
        string encrypted = encrypt_packet(message);
        server_net.send(peer_id, encrypted, channel, true);
    }
}

void send_packet(uint64 peer_id, string message, int channel = 0) {
    if (peer_id == 0) {
        for(uint i = 0; i < connected_peers.length(); i++) {
            string encrypted = encrypt_packet(message);
            server_net.send(connected_peers[i], encrypted, channel, true);
        }
    } else {
        string encrypted = encrypt_packet(message);
        server_net.send(peer_id, encrypted, channel, true);
    }
}

void server_broadcast(string message, string target_map = "", string exclude_player = "") {
    for(uint i = 0; i < connected_peers.length(); i++) {
        uint64 peer_id = connected_peers[i];

        player@ p = get_player_by_peer(peer_id);
        if(target_map != "") {
            if(p is null || p.map != target_map) continue;
        }

        if(exclude_player != "") {
            if(p !is null && p.charname == exclude_player) continue;
            if(get_peer_name(peer_id) == exclude_player) continue;
        }

        send_reliable_text(peer_id, message);
    }
}

void add_connected_peer(uint64 peer_id, string address) {
    connected_peers.push_back(peer_id);
    peer_addresses.push_back(address);
    debug_log("Peer conectado: " + peer_id + " (" + address + ")");
}

void remove_connected_peer(uint64 peer_id) {
    for(uint i = 0; i < connected_peers.size(); i++) {
        if(connected_peers[i] == peer_id) {
            connected_peers.erase(i);
            peer_addresses.erase(i);
            break;
        }
    }

    string peer_key = "" + peer_id;
    if(peer_names.exists(peer_key)) {
        peer_names.delete(peer_key);
    }

    debug_log("Peer desconectado: " + peer_id);
}

void force_disconnect_and_cleanup(uint64 peer_id, bool disconnect_peer = true) {
    if(disconnect_peer) {
        server_net.disconnect_peer_forcefully(peer_id);
    }

    remove_player(peer_id);
    remove_connected_peer(peer_id);
    remove_tracker(peer_id);
    connected_count = int(connected_peers.size());
}

void network_loop() {
    const network_event@ event;
    while((@event = server_net.request()) !is null && event.type != event_none) {
        if(@event is null) continue;
        debug_log("[NET] Evento de rede recebido: tipo=" + event.type + ", peer=" + event.peer_id);
        try {
            server_handle_network_event_const(event);
        }
        catch {
            string event_info = "type=" + event.type + " channel=" + event.channel;
            string packet_info = event_info;
            if(event.type == event_receive) {
                string raw_excerpt = event.message;
                if(raw_excerpt.length() > MAX_NETWORK_LOG_PACKET_CHARS) {
                    raw_excerpt = raw_excerpt.substr(0, MAX_NETWORK_LOG_PACKET_CHARS) + "... [TRUNCADO]";
                }
                packet_info += " raw=" + raw_excerpt;
            }

            log_network_exception_with_context(event.peer_id, packet_info, "network_loop:event_dispatch");
            force_disconnect_and_cleanup(event.peer_id, true);
        }
    }
}

uint get_connected_count() {
    return connected_peers.size();
}

bool is_peer_connected(uint64 peer_id) {
    for(uint i = 0; i < connected_peers.size(); i++) {
        if(connected_peers[i] == peer_id) {
            return true;
        }
    }
    return false;
}

void set_peer_name(uint64 peer_id, string player_name) {
    peer_names["" + peer_id] = player_name;
}

string get_peer_name(uint64 peer_id) {
    string peer_key = "" + peer_id;
    if(peer_names.exists(peer_key)) {
        return string(peer_names[peer_key]);
    }
    return "";
}

const int GHOST_TIMEOUT = 180000;
timer ghost_check_timer;

void check_ghost_players() {
    if(ghost_check_timer.elapsed < 5000) return;
    ghost_check_timer.restart();

    for(int i = int(players.length()) - 1; i >= 0; i--) {
        if(players[i].last_activity.elapsed > GHOST_TIMEOUT) {
            uint64 ghost_peer = players[i].peer_id;
            string ghost_name = players[i].charname;
            int inactive_seconds = int(players[i].last_activity.elapsed / 1000);
            debug_log("Jogador fantasma detectado: " + ghost_name +
                      " (inativo ha " + inactive_seconds + "s, timeout=" + int(GHOST_TIMEOUT / 1000) + "s)");

            send_reliable_text(ghost_peer, "say Você foi desconectado por inatividade.", 0);

            force_disconnect_and_cleanup(ghost_peer, true);

            debug_log("Jogador " + ghost_name + " removido (fantasma)");
        }
    }
}

bool validate_movement(player@ p, int new_x, int new_y) {
    if(p is null) return false;

    if(p.last_move_time.elapsed == 0 || (p.last_valid_x == 0 && p.last_valid_y == 0)) {
        p.last_valid_x = new_x;
        p.last_valid_y = new_y;
        p.last_move_time.restart();
        return true;
    }

    int dx = absolute(new_x - p.last_valid_x);
    int dy = absolute(new_y - p.last_valid_y);
    double distance = sqrt(double(dx * dx + dy * dy));

    if(distance > p.HARD_CAP_DISTANCE) {
        p.violation_count += 3;
        debug_log("[ALERTA] TELEPORTE detectado! " + p.charname + ": " +
                  p.last_valid_x + "," + p.last_valid_y + " -> " + new_x + "," + new_y +
                  " (dist=" + distance + ")");

        return false;
    }

    double time_diff = p.last_move_time.elapsed / 1000.0;
    if(time_diff <= 0.001) time_diff = 0.001;

    double speed = distance / time_diff;
    double allowed_speed = p.MAX_WALK_SPEED * p.SPEED_TOLERANCE;

    if(speed > allowed_speed && distance > 2.0) {
        p.violation_count++;
        debug_log("[WARN] Speedhack? " + p.charname + ": vel=" + speed +
                  " tiles/s (max=" + allowed_speed + "), violacoes=" + p.violation_count);

        if(p.violation_count >= p.MAX_VIOLATIONS) {
            debug_log("[CHEAT] CHEAT confirmado! Corrigindo posicao de " + p.charname);
            return false;
        }

    } else {
        if(p.violation_count > 0) {
            p.violation_count--;
        }
    }

    p.last_valid_x = new_x;
    p.last_valid_y = new_y;
    p.last_move_time.restart();

    return true;
}

void send_position_correction(player@ p) {
    if(p is null) return;

    send_reliable_text(p.peer_id, "teleport " + p.last_valid_x + " " + p.last_valid_y, 0);
    debug_log("[SYNC] Correcao enviada para " + p.charname + ": " + p.last_valid_x + "," + p.last_valid_y);

    p.violation_count = 0;
}
