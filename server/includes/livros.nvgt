// ---------------------------------------------------------------------
// Handler de rede (mesmo formato de handle_party/handle_guild)
// ---------------------------------------------------------------------

void handle_livro(player@ p, string data) {

    if(!network_require_non_empty(p, "handle_livro", data)) return;
    string[] parts = split_pipe_trimmed(data);
    if(parts.length() < 1 || parts[0] == "") {
        network_log_invalid_payload(p, "handle_livro", "acao ausente", data);
        return;
    }

    string action = parts[0];

    debug_log("[LIVRO] " + p.name + " - livro: " + action);

    int player_index = get_player_index_from(p.charname);
    if(player_index < 0) return;

    if(action == "listar") {
        bool gerenciar = (parts.length() >= 2 && parts[1] == "gerenciar");
        if(gerenciar) {
            if(!livro_pode_editar(player_index)) return;
            listar_livros(player_index, "", false);
        } else {
            listar_livros(player_index, "", true);
        }
    } else if(action == "ler" && parts.length() >= 2) {
        enviar_livro_para_leitura(player_index, parts[1]);
    } else if(action == "info" && parts.length() >= 2) {
        cmd_livroinfo(player_index, parts[1]);
    } else if(action == "meus") {
        cmd_meuslivros(player_index);
    } else if(action == "progresso" && parts.length() >= 3) {
        int pagina = 0;
        if(!network_try_parse_int(parts[2], pagina) || pagina < 0) {
            network_reject_invalid_payload(p, "handle_livro", "progresso inválido", data);
            return;
        }
        registrar_leitura(player_index, parts[1], LIVRO_IDIOMA_PADRAO, pagina, 0);
    } else if(action == "criar" && parts.length() >= 3) {
        string descricao = parts.length() >= 4 ? parts[3] : "";
        string musica = parts.length() >= 5 ? parts[4] : "";
        string idioma = parts.length() >= 6 ? parts[5] : LIVRO_IDIOMA_PADRAO;
        criar_livro(player_index, parts[1], parts[2], descricao, musica, idioma);
    } else if(action == "meta" && parts.length() >= 4) {
        string descricao = parts.length() >= 5 ? parts[4] : "";
        string musica = parts.length() >= 6 ? parts[5] : "";
        atualizar_livro_meta(player_index, parts[1], parts[2], parts[3], descricao, musica);
    } else if(action == "acesso" && parts.length() >= 5) {
        int publico = 1;
        int nivel = 0;
        if(!network_try_parse_int(parts[3], publico) || !network_try_parse_int(parts[4], nivel)) {
            network_reject_invalid_payload(p, "handle_livro", "acesso inválido", data);
            return;
        }
        string requer_item = parts.length() >= 6 ? parts[5] : "";
        definir_acesso_livro(player_index, parts[1], parts[2], publico, nivel, requer_item);
    } else if(action == "pagina" && parts.length() >= 5) {
        int numero = 0;
        if(!network_try_parse_int(parts[3], numero) || numero < 1) {
            network_reject_invalid_payload(p, "handle_livro", "numero de pagina inválido", data);
            return;
        }
        // O texto pode conter pipes: tudo a partir do indice 4 volta a ser um so.
        string texto = join_parts_from(parts, 4, "|");
        definir_pagina(player_index, parts[1], parts[2], numero, texto);
    } else if(action == "delpagina" && parts.length() >= 4) {
        int numero = 0;
        if(!network_try_parse_int(parts[3], numero) || numero < 1) {
            network_reject_invalid_payload(p, "handle_livro", "numero de pagina inválido", data);
            return;
        }
        remover_pagina(player_index, parts[1], parts[2], numero);
    } else if(action == "renomear" && parts.length() >= 3) {
        string idioma = parts.length() >= 4 ? parts[3] : LIVRO_IDIOMA_PADRAO;
        renomear_livro(player_index, parts[1], parts[2], idioma);
    } else if(action == "deletar" && parts.length() >= 2) {
        string idioma = parts.length() >= 3 ? parts[2] : LIVRO_IDIOMA_PADRAO;
        deletar_livro(player_index, parts[1], idioma);
    } else if(action == "editar" && parts.length() >= 2) {
        string idioma = parts.length() >= 3 ? parts[2] : LIVRO_IDIOMA_PADRAO;
        enviar_livro_para_edicao(player_index, parts[1], idioma);
    } else {
        network_send_action_error(p, "Livro", action);
    }
}
