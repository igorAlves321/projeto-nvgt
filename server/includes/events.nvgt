void schedule_automatic_events() {
}

void events_send_to_player(int client_index, const string&in message) {
    if(client_index < 0 || client_index >= int(players.length())) return;
    if(players[client_index] is null) return;
    string m = message.replace("\n", "; ");
    send_reliable_text(players[client_index].peer_id, "msg2 ;" + m + ";", 0);
}

bool event_list_contains_player(const string[]&in names, const string&in player_name) {
    for(uint i = 0; i < names.length(); i++) {
        if(names[i] == player_name) return true;
    }
    return false;
}

bool event_is_in_active_list(int event_id) {
    for(uint i = 0; i < active_events.length(); i++) {
        if(active_events[i].id == event_id) return true;
    }
    return false;
}
void cmd_events(int client_index, string[] args) {
    string msg = "=== EVENTOS DISPONÍVEIS ===\n\n";

    if (active_events.length() > 0) {
        msg += "🔥 EVENTOS ATIVOS:\n";
        for (uint i = 0; i < active_events.length(); i++) {
            game_event@ e = active_events[i];
            int remaining = (e.duration_minutes * 60) - (e.start_time.elapsed / 1000);
            msg += "[" + e.id + "] " + e.name + " (";
            msg += (remaining / 60) + "m restantes)\n";
            msg += "Participantes: " + e.participants.length() + "\n---\n";
        }
    }

    if (scheduled_events.length() > 0) {
        msg += "\n📋 PRÓXIMOS EVENTOS:\n";
        for (uint i = 0; i < scheduled_events.length(); i++) {
            game_event@ e = scheduled_events[i];

            if (e.state == EVENT_REGISTERING) {
                msg += "[" + e.id + "] " + e.name + " (REGISTRANDO)\n";
                msg += "Registrados: " + e.registered_players.length();
                msg += "/" + e.max_participants + "\n";
                msg += "Use /registerevent " + e.id + "\n---\n";
            } else {
                msg += "[" + e.id + "] " + e.name + "\n";
                msg += "Nível: " + e.min_level + "-" + e.max_level + "\n---\n";
            }
        }
    }

    msg += "\nUse /eventinfo <id> para detalhes.";
    events_send_to_player(client_index, msg);
}

void cmd_eventinfo(int client_index, string[] args) {
    if (args.length() < 1) {
        events_send_to_player(client_index, "Use: /eventinfo <id>");
        return;
    }

    int id = string_to_number(args[0]);
    game_event@ e = get_event(id);

    if (e is null) {
        events_send_to_player(client_index, "Evento não encontrado.");
        return;
    }

    string msg = "=== " + e.name + " ===\n\n";
    msg += e.description + "\n\n";
    msg += "Tipo: ";

    switch (e.type) {
        case EVENT_PVP_ARENA: msg += "⚔️ Arena PvP\n"; break;
        case EVENT_COLLECTION: msg += "📦 Coleta\n"; break;
        case EVENT_SURVIVAL: msg += "👹 Sobrevivência\n"; break;
        case EVENT_TREASURE_HUNT: msg += "💎 Caça ao Tesouro\n"; break;
        case EVENT_BOSS_SPAWN: msg += "🐉 Boss World\n"; break;
    }

    msg += "Nível: " + e.min_level + "-" + e.max_level + "\n";
    msg += "Participantes: " + e.min_participants + "-" + e.max_participants + "\n";
    msg += "Duração: " + e.duration_minutes + " minutos\n";

    if (e.entry_fee_gold > 0) {
        msg += "Taxa de entrada: " + e.entry_fee_gold + " gold\n";
    }

    msg += "\nRECOMPENSAS:\n";
    msg += "Participação: " + e.participation_gold + " gold, " + e.participation_xp + " XP\n";

    if (e.rewards.length() > 0) {
        msg += "\nRecompensas de ranking:\n";
        for (uint i = 0; i < e.rewards.length(); i++) {
            event_reward@ r = e.rewards[i];
            msg += "Top " + r.rank_min;
            if (r.rank_max != r.rank_min && r.rank_max != -1) {
                msg += "-" + r.rank_max;
            }
            msg += ": " + r.gold + " gold, " + r.xp + " XP\n";

            if (r.title != "") {
                msg += "  Título: " + r.title + "\n";
            }
        }
    }

    events_send_to_player(client_index, msg);
}

void cmd_registerevent(int client_index, string[] args) {
    if (args.length() < 1) {
        events_send_to_player(client_index, "Use: /registerevent <id>");
        return;
    }

    int id = string_to_number(args[0]);
    game_event@ e = get_event(id);

    if (e is null) {
        events_send_to_player(client_index, "Evento não encontrado.");
        return;
    }
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) {
        return;
    }

    string player_name = players[client_index].charname;
    if (player_name == "") {
        events_send_to_player(client_index, "Não foi possível identificar o jogador.");
        return;
    }

    if (e.register_player(player_name)) {
        string ok_msg = "Você se registrou no evento '" + e.name + "'!";
        if (e.entry_fee_gold > 0) {
            ok_msg += " Taxa: " + e.entry_fee_gold + " gold (cobrada no inicio).";
        }
        events_send_to_player(client_index, ok_msg);
        return;
    }

    if (e.state != EVENT_REGISTERING) {
        events_send_to_player(client_index, "Este evento não esta aceitando registros no momento.");
        return;
    }
    if (int(e.registered_players.length()) >= e.max_participants) {
        events_send_to_player(client_index, "Evento lotado.");
        return;
    }
    events_send_to_player(client_index, "Não foi possível registrar (você pode ja estar inscrito).");
}

void cmd_startevent(int client_index, string[] args) {
    if (args.length() < 1) {
        events_send_to_player(client_index, "Use: /startevent <id>");
        return;
    }

    int id = string_to_number(args[0]);
    game_event@ e = get_event(id);

    if (e is null) {
        events_send_to_player(client_index, "Evento não encontrado.");
        return;
    }

    if (e.state == EVENT_SCHEDULED) {
        e.state = EVENT_REGISTERING;
        e.registration_start.restart();
        e.broadcast_global("Evento '" + e.name + "' aberto para registro! Use /registerevent " + e.id);
        events_send_to_player(client_index, "Evento aberto para registro.");
    }
    else if (e.state == EVENT_REGISTERING) {
        e.start();
        if (!event_is_in_active_list(e.id)) active_events.insert_last(e);
        events_send_to_player(client_index, "Evento iniciado!");
    }
}

void cmd_endevent(int client_index, string[] args) {
    if (args.length() < 1) {
        events_send_to_player(client_index, "Use: /endevent <id>");
        return;
    }

    int id = string_to_number(args[0]);
    game_event@ e = get_event(id);

    if (e is null) {
        events_send_to_player(client_index, "Evento não encontrado.");
        return;
    }

    if (e.state == EVENT_ACTIVE) {
        e.end();
        events_send_to_player(client_index, "Evento finalizado!");
    } else {
        events_send_to_player(client_index, "O evento não esta em andamento.");
    }
}

void cmd_eventranking(int client_index, string[] args) {
    events_send_to_player(client_index, "Ranking de evento ainda não esta disponivel neste build.");
}

game_event@ get_event(int id) {
    for (uint i = 0; i < scheduled_events.length(); i++) {
        if (scheduled_events[i].id == id) {
            return scheduled_events[i];
        }
    }

    for (uint i = 0; i < active_events.length(); i++) {
        if (active_events[i].id == id) {
            return active_events[i];
        }
    }

    return null;
}

void events_loop() {
    for (uint i = 0; i < scheduled_events.length(); i++) {
        game_event@ e = scheduled_events[i];
        if (e is null) continue;

        if (e.state == EVENT_SCHEDULED) {
            int schedule_delay_ms = 60000;
            if(e.config.exists("schedule_delay_ms")) e.config.get("schedule_delay_ms", schedule_delay_ms);
            if (e.scheduled_time.elapsed >= schedule_delay_ms) {
                e.state = EVENT_REGISTERING;
                e.registration_start.restart();
                server_broadcast("say [EVENTO GLOBAL] O evento '" + e.name + "' vai começar em " + e.registration_duration_minutes + " minutos! Digite /registerevent " + e.id + " para participar.");
                server_broadcast("ps alarm.ogg");
            }
        }

        else if (e.state == EVENT_REGISTERING) {
            if (e.registration_start.elapsed >= e.registration_duration_minutes * 60 * 1000) {
                if (int(e.registered_players.length()) < e.min_participants) {
                    e.state = EVENT_CANCELLED;
                    server_broadcast("say [EVENTO GLOBAL] O evento '" + e.name + "' foi cancelado por falta de participantes.");
                } else {
                    e.start();
                    if(!event_is_in_active_list(e.id)) active_events.insert_last(e);

                    string event_map = "arena";
                    int event_x = 10;
                    int event_y = 10;
                    if(e.config.exists("event_map")) e.config.get("event_map", event_map);
                    if(e.config.exists("event_x")) e.config.get("event_x", event_x);
                    if(e.config.exists("event_y")) e.config.get("event_y", event_y);

                    for (uint p = 0; p < e.participants.length(); p++) {
                        int p_idx = get_player_index_from(e.participants[p].player_name);
                        if (p_idx < 0) continue;

                        if(e.entry_fee_gold > 0) {
                            if(players[p_idx].gold < e.entry_fee_gold) {
                                send_reliable_text(players[p_idx].peer_id, "msg2 ;Você não tinha ouro para a taxa e ficou fora deste evento.;", 0);
                                continue;
                            }
                            players[p_idx].gold -= e.entry_fee_gold;
                            players[p_idx].saldo = players[p_idx].gold;
                        }

                        move_player_to_map(p_idx, event_map, event_x, event_y);
                        send_reliable_text(players[p_idx].peer_id, "ps teleport.ogg", 0);
                        send_reliable_text(players[p_idx].peer_id, "say [EVENTO] Você foi teleportado para o evento!", 0);
                    }
                }
            }
        }
    }

    for (int i = int(active_events.length()) - 1; i >= 0; i--) {
        game_event@ e = active_events[i];
        if (e is null) { active_events.remove_at(i); continue; }

        if (e.state == EVENT_ACTIVE && e.start_time.elapsed >= e.duration_minutes * 60 * 1000) {
            e.state = EVENT_COMPLETED;
            server_broadcast("say [EVENTO GLOBAL] O evento '" + e.name + "' foi concluido!");

            string return_map = "zona_de_seguranca";
            int return_x = 5;
            int return_y = 5;
            if(e.config.exists("return_map")) e.config.get("return_map", return_map);
            if(e.config.exists("return_x")) e.config.get("return_x", return_x);
            if(e.config.exists("return_y")) e.config.get("return_y", return_y);

            for (uint p = 0; p < e.participants.length(); p++) {
                int p_idx = get_player_index_from(e.participants[p].player_name);
                if (p_idx < 0) continue;
                if (players[p_idx].health <= 0) continue;

                players[p_idx].gold += e.participation_gold;
                players[p_idx].saldo = players[p_idx].gold;
                players[p_idx].xp += e.participation_xp;

                send_reliable_text(players[p_idx].peer_id, "say [RECOMPENSA] Você ganhou " + e.participation_gold + " moedas e " + e.participation_xp + " XP.", 0);
                send_reliable_text(players[p_idx].peer_id, "ps trade_success.ogg", 0);
                move_player_to_map(p_idx, return_map, return_x, return_y);
            }
        }

        if (e.state == EVENT_COMPLETED || e.state == EVENT_CANCELLED) {
            event_history.insert_last(e);
            active_events.remove_at(i);
        }
    }
}

