// /startevent <id> - Inicia evento (admin)
void cmd_startevent(int client_index, string[] args) {
    // Verifica admin
    // if (!is_admin(client_index)) return;
    
    if (args.length() < 1) {
        // send_message(client_index, "Use: /startevent <id>");
        return;
    }
    
    int id = string_to_number(args[0]);
    game_event@ e = get_event(id);
    
    if (e is null) {
        // send_message(client_index, "Evento não encontrado.");
        return;
    }
    
    // Muda para registro
    if (e.state == EVENT_SCHEDULED) {
        e.state = EVENT_REGISTERING;
        e.registration_start.restart();
        e.broadcast_global("📢 Evento '" + e.name + "' aberto para registro! Use /registerevent " + e.id);
        // send_message(client_index, "Evento aberto para registro.");
    }
    // Força início
    else if (e.state == EVENT_REGISTERING) {
        e.start();
        active_events.insert_last(e);
        // send_message(client_index, "Evento iniciado!");
    }
}

// /endevent <id> - Finaliza evento (admin)
void cmd_endevent(int client_index, string[] args) {
    // Verifica admin
    // if (!is_admin(client_index)) return;
    
    if (args.length() < 1) {
        // send_message(client_index, "Use: /endevent <id>");
        return;
    }
    
    int id = string_to_number(args[0]);
    game_event@ e = get_event(id);
    
    if (e is null) {
        // send_message(client_index, "Evento não encontrado.");
        return;
    }
    
    if (e.state == EVENT_ACTIVE) {
        e.end();
        // send_message(client_index, "Evento finalizado!");
    }
}

