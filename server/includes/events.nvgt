
#include "globals.nvgt"

enum event_type {
    EVENT_PVP_ARENA,
    EVENT_COLLECTION,
    EVENT_SURVIVAL,
    EVENT_TREASURE_HUNT,
    EVENT_BOSS_SPAWN,
    EVENT_RACE,
    EVENT_QUIZ
}

enum event_state {
    EVENT_SCHEDULED,
    EVENT_REGISTERING,
    EVENT_ACTIVE,
    EVENT_COMPLETED,
    EVENT_CANCELLED
}

class event_participant {
    string player_name;
    int score;
    int rank;
    int kills;
    int deaths;
    int items_collected;
    int waves_survived;
    timer join_time;
    bool eliminated;

    event_participant(string name) {
        player_name = name;
        score = 0;
        rank = 0;
        kills = 0;
        deaths = 0;
        items_collected = 0;
        waves_survived = 0;
        eliminated = false;
    }
}

class event_reward {
    int rank_min;
    int rank_max;
    int gold;
    int xp;
    dictionary items;
    string title;

    event_reward() {
        rank_min = 1;
        rank_max = 1;
        gold = 0;
        xp = 0;
    }
}

class game_event {
    int id;
    string name;
    string description;
    event_type type;
    event_state state;

    timer scheduled_time;
    int duration_minutes;
    timer start_time;
    timer registration_start;
    int registration_duration_minutes;

    int min_level;
    int max_level;
    int min_participants;
    int max_participants;
    int entry_fee_gold;

    event_participant@[] participants;
    string[] registered_players;

    event_reward@[] rewards;
    int participation_gold;
    int participation_xp;

    dictionary config;

    bool is_ranked;

    game_event() {
        id = 0;
        type = EVENT_PVP_ARENA;
        state = EVENT_SCHEDULED;
        duration_minutes = 30;
        registration_duration_minutes = 5;
        min_level = 1;
        max_level = 99;
        min_participants = 2;
        max_participants = 50;
        entry_fee_gold = 0;
        participation_gold = 100;
        participation_xp = 50;
        is_ranked = true;
    }

    bool register_player(string player_name) {
        if (state != EVENT_REGISTERING) {
            return false;
        }

        for (uint i = 0; i < registered_players.length(); i++) {
            if (registered_players[i] == player_name) {
                return false;
            }
        }

        if (int(registered_players.length()) >= max_participants) {
            return false;
        }

        registered_players.insert_last(player_name);
        broadcast_to_participants(player_name + " se registrou! (" + registered_players.length() + "/" + max_participants + ")");

        return true;
    }

    void start() {
        if (int(registered_players.length()) < min_participants) {
            cancel("Participantes insuficientes.");
            return;
        }

        state = EVENT_ACTIVE;
        start_time.restart();

        for (uint i = 0; i < registered_players.length(); i++) {
            event_participant@ ep = event_participant(registered_players[i]);
            participants.insert_last(ep);
        }

        broadcast_global(" Evento '" + name + "' iniciado!");
        broadcast_to_participants("O evento começou! Boa sorte!");

        switch (type) {
            case EVENT_PVP_ARENA:
                start_pvp_arena();
                break;
            case EVENT_COLLECTION:
                start_collection();
                break;
            case EVENT_SURVIVAL:
                start_survival();
                break;
            case EVENT_TREASURE_HUNT:
                start_treasure_hunt();
                break;
            case EVENT_BOSS_SPAWN:
                start_boss_spawn();
                break;
        }
    }

    void end() {
        state = EVENT_COMPLETED;

        calculate_rankings();

        distribute_rewards();

        broadcast_global("Evento '" + name + "' finalizado!");

        if (name == "Chuva de Cristais") {
            clima_transicao("limpo", 0, 0, "evento");
        }

        save_event_history();
    }

    void cancel(string reason) {
        state = EVENT_CANCELLED;

        for (uint i = 0; i < registered_players.length(); i++) {
        }

        broadcast_global("Evento '" + name + "' cancelado: " + reason);
    }

    void calculate_rankings() {
        if (!is_ranked || participants.length() == 0) return;

        for (uint i = 0; i < participants.length(); i++) {
            for (uint j = i + 1; j < participants.length(); j++) {
                if (participants[j].score > participants[i].score) {
                    event_participant@ temp = participants[i];
                    @participants[i] = participants[j];
                    @participants[j] = temp;
                }
            }
        }

        for (uint i = 0; i < participants.length(); i++) {
            participants[i].rank = i + 1;
        }
    }

    void distribute_rewards() {
        for (uint i = 0; i < participants.length(); i++) {
            event_participant@ p = participants[i];
            int total_gold = participation_gold;
            int total_xp = participation_xp;
            string msg = "=== RECOMPENSAS DO EVENTO ===\n\n";

            if (p.rank > 0) {
                msg += "Sua colocação: #" + p.rank + "\n";
                msg += "Score: " + p.score + "\n\n";
            }

            for (uint j = 0; j < rewards.length(); j++) {
                event_reward@ r = rewards[j];

                bool qualifies = false;
                if (r.rank_max == -1) {
                    qualifies = (p.rank >= r.rank_min);
                } else {
                    qualifies = (p.rank >= r.rank_min && p.rank <= r.rank_max);
                }

                if (qualifies) {
                    total_gold += r.gold;
                    total_xp += r.xp;

                    if (r.title != "") {
                        msg += "🏆 Novo título: " + r.title + "\n";
                    }

                    string[] items = r.items.get_keys();
                    for (uint k = 0; k < items.length(); k++) {
                        int qty;
                        r.items.get(items[k], qty);
                        msg += "📦 Item: " + items[k] + " x" + qty + "\n";
                    }
                }
            }

            msg += "\n💰 Gold: " + total_gold + "\n";
            msg += "⭐ XP: " + total_xp + "\n";

        }
    }

    void broadcast_to_participants(string message) {
        for (uint i = 0; i < participants.length(); i++) {
        }

        for (uint i = 0; i < registered_players.length(); i++) {
        }
    }

    void broadcast_global(string message) {
    }

    bool check_timeout() {
        if (state != EVENT_ACTIVE) return false;

        if (start_time.elapsed >= duration_minutes * 60 * 1000) {
            end();
            return true;
        }
        return false;
    }

    void start_pvp_arena() {
        broadcast_to_participants("⚔️ ARENA PVP ATIVADA!");
        broadcast_to_participants("Elimine outros jogadores para ganhar pontos!");
    }

    void start_collection() {
        int item_count = 100;
        if (config.exists("item_count")) {
            config.get("item_count", item_count);
        }

        broadcast_to_participants("📦 EVENTO DE COLETA!");
        broadcast_to_participants("Colete o máximo de itens em " + duration_minutes + " minutos!");

        if (name == "Chuva de Cristais") {
            clima_transicao("tempestade", 3, duration_minutes * 60000, "evento");
        }
    }

    void start_survival() {
        broadcast_to_participants("👹 EVENTO DE SOBREVIVÊNCIA!");
        broadcast_to_participants("Sobreviva o máximo de ondas possível!");
    }

    void start_treasure_hunt() {
        int treasures = 10;
        if (config.exists("treasure_count")) {
            config.get("treasure_count", treasures);
        }

        broadcast_to_participants("💎 CAÇA AO TESOURO!");
        broadcast_to_participants("Encontre " + treasures + " tesouros escondidos!");
    }

    void start_boss_spawn() {
        broadcast_to_participants("🐉 BOSS WORLD SPAWN!");
        broadcast_to_participants("Derrote o boss para ganhar recompensas!");
    }

    void save_event_history() {
    }
}

game_event@[] scheduled_events;
game_event@[] active_events;
game_event@[] event_history;

void init_events_system() {
    scheduled_events.resize(0);
    active_events.resize(0);
    event_history.resize(0);

    create_default_events();
    schedule_automatic_events();
}

