// ========================================
// COMANDOS
// ========================================

// /events - Lista eventos disponíveis
void cmd_events(int client_index, string[] args) {
    string msg = "=== EVENTOS DISPONÍVEIS ===\n\n";
    
    // Eventos ativos
    if (active_events.length() > 0) {
        msg += "🔥 EVENTOS ATIVOS:\n";
        for (uint i = 0; i < active_events.length(); i++) {
            game_event@ e = active_events[i];
            int remaining = (e.duration_minutes * 60) - (e.start_time.elapsed / 1000);
            msg += "[" + e.id + "] " + e.name + " (";
            msg += (remaining / 60) + "m restantes)\n";
            msg += "Participantes: " + e.participants.length() + "\n---\n";
        }
    }
    
    // Eventos em registro
    if (scheduled_events.length() > 0) {
        msg += "\n📋 PRÓXIMOS EVENTOS:\n";
        for (uint i = 0; i < scheduled_events.length(); i++) {
            game_event@ e = scheduled_events[i];
            
            if (e.state == EVENT_REGISTERING) {
                msg += "[" + e.id + "] " + e.name + " (REGISTRANDO)\n";
                msg += "Registrados: " + e.registered_players.length();
                msg += "/" + e.max_participants + "\n";
                msg += "Use /registerevent " + e.id + "\n---\n";
            } else {
                msg += "[" + e.id + "] " + e.name + "\n";
                msg += "Nível: " + e.min_level + "-" + e.max_level + "\n---\n";
            }
        }
    }
    
    msg += "\nUse /eventinfo <id> para detalhes.";
    // send_message(client_index, msg);
}

// /eventinfo <id> - Informações do evento
void cmd_eventinfo(int client_index, string[] args) {
    if (args.length() < 1) {
        // send_message(client_index, "Use: /eventinfo <id>");
        return;
    }
    
    int id = string_to_number(args[0]);
    game_event@ e = get_event(id);
    
    if (e is null) {
        // send_message(client_index, "Evento não encontrado.");
        return;
    }
    
    string msg = "=== " + e.name + " ===\n\n";
    msg += e.description + "\n\n";
    msg += "Tipo: ";
    
    switch (e.type) {
        case EVENT_PVP_ARENA: msg += "⚔️ Arena PvP\n"; break;
        case EVENT_COLLECTION: msg += "📦 Coleta\n"; break;
        case EVENT_SURVIVAL: msg += "👹 Sobrevivência\n"; break;
        case EVENT_TREASURE_HUNT: msg += "💎 Caça ao Tesouro\n"; break;
        case EVENT_BOSS_SPAWN: msg += "🐉 Boss World\n"; break;
    }
    
    msg += "Nível: " + e.min_level + "-" + e.max_level + "\n";
    msg += "Participantes: " + e.min_participants + "-" + e.max_participants + "\n";
    msg += "Duração: " + e.duration_minutes + " minutos\n";
    
    if (e.entry_fee_gold > 0) {
        msg += "Taxa de entrada: " + e.entry_fee_gold + " gold\n";
    }
    
    msg += "\nRECOMPENSAS:\n";
    msg += "Participação: " + e.participation_gold + " gold, " + e.participation_xp + " XP\n";
    
    if (e.rewards.length() > 0) {
        msg += "\nRecompensas de ranking:\n";
        for (uint i = 0; i < e.rewards.length(); i++) {
            event_reward@ r = e.rewards[i];
            msg += "Top " + r.rank_min;
            if (r.rank_max != r.rank_min && r.rank_max != -1) {
                msg += "-" + r.rank_max;
            }
            msg += ": " + r.gold + " gold, " + r.xp + " XP\n";
            
            if (r.title != "") {
                msg += "  Título: " + r.title + "\n";
            }
        }
    }
    
    // send_message(client_index, msg);
}

