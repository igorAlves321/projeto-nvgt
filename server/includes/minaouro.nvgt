// minaouro.nvgt - Sistema de Mina de Ouro do EVM Server (convertido de BGT)
// Conversão: BGT → NVGT

minaouro@[] minasouro;

class minaouro {
	int x, y, quantoscavar = random(100, 200), quantosouro = random(4, 10);
	string map;
	
	minaouro(int mx, int my, string mmap) {
		x = mx;
		y = my;
		map = mmap;
	}
}

void colocar_minaouro(int x, int y, string map) {
	minaouro o(x, y, map);
	minasouro.push_back(o);
}
