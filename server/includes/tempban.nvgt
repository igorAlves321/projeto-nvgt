
// Banimentos temporarios vivem em server_bans (db_bans.nvgt): expire_date
// preenchido = temporario. O antigo tempbans.usr e importado uma unica vez por
// migrate_tempbans_to_db() e nao e mais lido nem gravado.
//
// tempbanloop() e save_tempbans() continuam existindo porque o loop principal
// e o desligamento em server.nvgt os chamam.

const uint TEMPBAN_VERIFICACAO_MS = 60000;
timer tempban_verificacao_timer;

// Uma vez por minuto: encerra no banco os bans vencidos e avisa a equipe.
void tempbanloop() {
	if(tempban_verificacao_timer.elapsed < TEMPBAN_VERIFICACAO_MS) return;
	tempban_verificacao_timer.restart();

	if(!database_initialized || bancoJogo is null) return;

	string[] vencidos;
	{
		sqlite3statement@ stmt = bancoJogo.prepare("SELECT DISTINCT banned_username FROM server_bans WHERE is_active = 1 AND expire_date IS NOT NULL AND expire_date <= datetime('now');");
		if(@stmt == null) return;

		while(stmt.step() == SQLITE_ROW) {
			vencidos.insert_last(stmt.column_text(0));
		}
	}
	if(vencidos.length() == 0) return;

	cleanup_expired_bans_db();

	for(uint i = 0; i < vencidos.length(); i++) {
		for(uint i2 = 0; i2 < players.length(); i2++) {
			if(players[i2].check_admin()) {
				send_reliable_text(players[i2].peer_id, "msg4 O banimento temporario de " + vencidos[i] + " terminou.", 0);
			}
		}
	}
}

// Nada a gravar no desligamento: cada ban ja esta em server_bans.
void save_tempbans() {
}
