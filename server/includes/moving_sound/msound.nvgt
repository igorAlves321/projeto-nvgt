
class msound_entity {
	string id;
	string soundfile;
	int x, y;
	string map;
	bool looping;
	bool active;
	timer lifetime;
	int max_lifetime;

	msound_entity(string i, string snd, int sx, int sy, string smap, bool loop = true, int life = 0) {
		id = i;
		soundfile = snd;
		x = sx;
		y = sy;
		map = smap;
		looping = loop;
		max_lifetime = life;
		active = true;
		lifetime.restart();
	}

	void update_position(int new_x, int new_y) {
		x = new_x;
		y = new_y;
	}

	bool should_remove() {
		if (!active) return true;

		if (max_lifetime > 0 && lifetime.elapsed >= max_lifetime * 1000) {
			active = false;
			return true;
		}

		return false;
	}

	void stop() {
		active = false;
	}
}

msound_entity@[] msounds;

int msound_next_id = 1;

int spawn_moving_sound(string soundfile, int x, int y, string map) {
	int id = msound_next_id++;

	msound_entity@ entity = msound_entity("" + id, soundfile, x, y, map, true, 0);
	msounds.insert_last(entity);

	broadcast_to_map(map, "cm " + id + " " + soundfile + " " + x + " " + y + " " + map);

	debug_log(" Som móvel criado: ID=" + id + " som=" + soundfile + " pos=(" + x + "," + y + ") mapa=" + map);

	return id;
}

int spawn_moving_sound_timed(string soundfile, int x, int y, string map, int lifetime_ms) {
	int id = msound_next_id++;

	msound_entity@ entity = msound_entity("" + id, soundfile, x, y, map, true, lifetime_ms);
	msounds.insert_last(entity);

	broadcast_to_map(map, "cm " + id + " " + soundfile + " " + x + " " + y + " " + map);

	debug_log(" Som móvel temporário criado: ID=" + id + " lifetime=" + lifetime_ms + "ms");

	return id;
}

void update_moving_sound(int id, int new_x, int new_y) {
	for (uint i = 0; i < msounds.length(); i++) {
		if (msounds[i].id == "" + id) {
			msounds[i].update_position(new_x, new_y);

			broadcast_to_map(msounds[i].map, "um " + id + " " + new_x + " " + new_y);
			return;
		}
	}
}

void destroy_moving_sound(int id) {
	for (uint i = 0; i < msounds.length(); i++) {
		if (msounds[i].id == "" + id) {
			string map = msounds[i].map;

			broadcast_to_map(map, "destroymsound " + id);

			@msounds[i] = null;
			msounds.remove_at(i);

			debug_log("🗑️ Som móvel destruído: ID=" + id);
			return;
		}
	}
}

void clear_moving_sounds_in_map(string map) {
	for (uint i = 0; i < msounds.length(); i++) {
		if (msounds[i].map == map) {
			broadcast_to_map(map, "destroymsound " + msounds[i].id);
			@msounds[i] = null;
			msounds.remove_at(i);
			i--;
		}
	}
}

void moving_sounds_loop() {
	for (uint i = 0; i < msounds.length(); i++) {
		if (msounds[i].should_remove()) {
			broadcast_to_map(msounds[i].map, "destroymsound " + msounds[i].id);

			@msounds[i] = null;
			msounds.remove_at(i);
			i--;
		}
	}
}

void destroy_moving_sound(string id) {
	destroy_moving_sound(parse_int(id));
}

void update_moving_sound(string id, int x, int y) {
	update_moving_sound(parse_int(id), x, y);
}

void init_moving_sounds() {
	msounds.resize(0);
	msound_next_id = 1;
	debug_log(" Sistema de sons móveis inicializado (servidor - broadcast mode)");
}

int get_active_sounds_count() {
	return msounds.length();
}

string get_sounds_info() {
	string info = "Sons móveis ativos: " + msounds.length() + "\n";

	for (uint i = 0; i < msounds.length(); i++) {
		info += "  [" + msounds[i].id + "] " + msounds[i].soundfile +
		        " @ (" + msounds[i].x + ", " + msounds[i].y + ")" +
		        " - Mapa: " + msounds[i].map + "\n";
	}

	return info;
}
