
const int MIN_BID_INCREASE = 10;
const int MIN_AUCTION_DURATION = 60;
const int MAX_AUCTION_DURATION = 86400;
const int AUCTION_CLEANUP_INTERVAL = 30000;

class Auction {
	int id;
	string owner_id;
	string owner_name;

	string item_name;
	int item_quantity;

	int starting_bid;
	int current_bid;
	string current_bidder_id;
	string current_bidder_name;

	uint64 start_time;
	uint64 end_time;
	int duration_seconds;

	bool is_active;
	bool is_finalized;

	Auction(int auction_id, string owner, string owner_nm, string item, int qty, int start_bid, int duration) {
		this.id = auction_id;
		this.owner_id = owner;
		this.owner_name = owner_nm;
		this.item_name = item;
		this.item_quantity = qty;
		this.starting_bid = start_bid;
		this.current_bid = start_bid;
		this.current_bidder_id = "";
		this.current_bidder_name = "";
		this.duration_seconds = duration;
		this.start_time = ticks();
		this.end_time = this.start_time + (duration * 1000);
		this.is_active = true;
		this.is_finalized = false;
	}

	bool is_expired() {
		return ticks() >= end_time;
	}

	int get_time_remaining() {
		uint64 current = ticks();
		if (current >= end_time) return 0;
		return int((end_time - current) / 1000);
	}

	string get_info() {
		string info = "Leilão #" + id + ": " + item_name;
		info += " (x" + item_quantity + ")";
		info += " | Lance atual: " + current_bid + " ouro";
		if (current_bidder_name != "") {
			info += " por " + current_bidder_name;
		}
		info += " | Tempo restante: " + get_time_remaining() + "s";
		return info;
	}
}

mutex auction_mutex;
Auction@[] active_auctions;
int next_auction_id = 1;
timer last_auction_cleanup;

Auction@ get_auction_by_id(int auction_id) {
	for (uint i = 0; i < active_auctions.length(); i++) {
		if (active_auctions[i].id == auction_id) {
			return @active_auctions[i];
		}
	}
	return null;
}

player@ get_auction_player_by_name(const string&in username) {
    return get_player_by_name(username);
}

bool auction_take_item(player@ p, const string&in item_name, int quantity) {
    if (@p == null) return false;
    if (quantity <= 0 || item_name == "") return false;
    if (p.inv_item_number(item_name) < quantity) return false;
    p.inv_remove_item(item_name, quantity);
    return true;
}

void auction_give_item(player@ p, const string&in item_name, int quantity) {
    if (@p == null) return;
    if (quantity <= 0 || item_name == "") return;
    p.inv_add_item(item_name, quantity, true);
}

bool auction_credit_offline_gold(const string&in username, int amount) {
    if (username == "" || amount == 0) return false;
    string query = "UPDATE players SET gold = gold + ? WHERE username = ?;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if (@stmt == null) return false;
    stmt.bind_int(1, amount);
    stmt.bind_text(2, username);
    return stmt.step() == SQLITE_DONE;
}

void cmd_create_auction(int player_index, string item_name, int quantity, int starting_bid, int duration_seconds) {
    if (player_index < 0 || player_index >= int(players.length())) return;
    player@ p = @players[player_index];

    if (item_name.is_empty()) {
        send_reliable_text(p.peer_id, "msg2 Erro: Nome do item inválido.", 0);
        return;
    }
    if (quantity <= 0) {
        send_reliable_text(p.peer_id, "msg2 Erro: Quantidade invalida.", 0);
        return;
    }
    if (starting_bid <= 0) {
        send_reliable_text(p.peer_id, "msg2 Erro: Lance inicial deve ser maior que 0.", 0);
        return;
    }
    if (duration_seconds < MIN_AUCTION_DURATION || duration_seconds > MAX_AUCTION_DURATION) {
        send_reliable_text(p.peer_id, "msg2 Erro: Duracao deve estar entre " + MIN_AUCTION_DURATION + " e " + MAX_AUCTION_DURATION + " segundos.", 0);
        return;
    }
    if (!auction_take_item(p, item_name, quantity)) {
        send_reliable_text(p.peer_id, "msg2 Erro: Você não possui " + quantity + "x " + item_name + ".", 0);
        return;
    }

    auction_mutex.lock();
    int auction_id = next_auction_id++;
    Auction new_auction(auction_id, p.charname, p.charname, item_name, quantity, starting_bid, duration_seconds);
    active_auctions.insert_last(new_auction);
    auction_mutex.unlock();

    send_reliable_text(p.peer_id, "msg2 Leilao #" + auction_id + " criado com sucesso!", 0);
    send_packet(0, "msgnovoleilao " + p.charname + " " + quantity + " " + item_name + " " + starting_bid, 0);
    send_packet(0, "msg2 Novo leilao: " + new_auction.get_info(), 0);
    send_packet(0, "ps auction.ogg", 0);
    save_player_to_database(p);
    debug_log("[AUCTION] Leilao #" + auction_id + " criado por " + p.charname + ": " + item_name + " x" + quantity);
}

void req_place_bid(int player_index, int auction_id, int amount) {
    if (player_index < 0 || player_index >= int(players.length())) return;
    player@ p = @players[player_index];

    auction_mutex.lock();
    Auction@ auction = get_auction_by_id(auction_id);
    if (@auction == null) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Leilao não encontrado.", 0);
        return;
    }
    if (!auction.is_active || auction.is_finalized) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Este leilao não esta mais ativo.", 0);
        return;
    }
    if (auction.is_expired()) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Este leilao ja expirou.", 0);
        return;
    }
    if (p.charname == auction.owner_id) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Você não pode dar lances no seu proprio leilao.", 0);
        return;
    }
    if (p.charname == auction.current_bidder_id) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Você ja e o maior licitante.", 0);
        return;
    }

    int min_bid = auction.current_bid + MIN_BID_INCREASE;
    if (amount < min_bid) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msgaproximaoferta " + min_bid, 0);
        send_reliable_text(p.peer_id, "msg2 Erro: Lance muito baixo. Minimo: " + min_bid + " ouro.", 0);
        return;
    }
    if (p.gold < amount) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Ouro insuficiente. Você tem " + p.gold + ", precisa de " + amount + ".", 0);
        return;
    }

    string previous_bidder_id = auction.current_bidder_id;
    int previous_bid_amount = auction.current_bid;
    if (!previous_bidder_id.is_empty()) {
        player@ previous_bidder = get_auction_player_by_name(previous_bidder_id);
        if (@previous_bidder != null) {
            previous_bidder.gold += previous_bid_amount;
            send_reliable_text(previous_bidder.peer_id, "msg2 Seu lance de " + previous_bid_amount + " foi superado no leilao #" + auction_id + ".", 0);
        } else {
            if (!auction_credit_offline_gold(previous_bidder_id, previous_bid_amount)) {
                debug_log("[AUCTION] Falha ao devolver ouro no DB para jogador offline: " + previous_bidder_id);
            }
        }
    }

    p.gold -= amount;
    auction.current_bid = amount;
    auction.current_bidder_id = p.charname;
    auction.current_bidder_name = p.charname;
    auction_mutex.unlock();

    send_reliable_text(p.peer_id, "msg2 Lance de " + amount + " ouro aceito no leilao #" + auction_id + "!", 0);
    send_packet(0, "msgfezaoferta " + p.charname + " " + amount, 0);
    send_packet(0, "msg2 " + p.charname + " deu lance de " + amount + " ouro no leilao #" + auction_id + "!", 0);
    send_packet(0, "ps bid.ogg", 0);
    save_player_to_database(p);
    if (!previous_bidder_id.is_empty()) {
        player@ previous_bidder_online = get_auction_player_by_name(previous_bidder_id);
        if (@previous_bidder_online != null) save_player_to_database(previous_bidder_online);
    }
    debug_log("[AUCTION] " + p.charname + " deu lance de " + amount + " no leilao #" + auction_id);
}

void cmd_cancel_auction(int player_index, int auction_id) {
    if (player_index < 0 || player_index >= int(players.length())) return;
    player@ p = @players[player_index];

    auction_mutex.lock();
    Auction@ auction = get_auction_by_id(auction_id);
    if (@auction == null) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Leilao não encontrado.", 0);
        return;
    }
    if (auction.owner_id != p.charname) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Apenas o dono pode cancelar o leilao.", 0);
        return;
    }
    if (auction.is_finalized) {
        auction_mutex.unlock();
        send_reliable_text(p.peer_id, "msg2 Erro: Este leilao ja foi finalizado.", 0);
        return;
    }

    if (!auction.current_bidder_id.is_empty()) {
        player@ bidder = get_auction_player_by_name(auction.current_bidder_id);
        if (@bidder != null) {
            bidder.gold += auction.current_bid;
            send_reliable_text(bidder.peer_id, "msg2 O leilao #" + auction_id + " foi cancelado. Seu lance de " + auction.current_bid + " foi devolvido.", 0);
            save_player_to_database(bidder);
        } else {
            if (!auction_credit_offline_gold(auction.current_bidder_id, auction.current_bid)) {
                debug_log("[AUCTION] Falha ao devolver ouro de cancelamento para offline: " + auction.current_bidder_id);
            }
        }
    }

    auction_give_item(p, auction.item_name, auction.item_quantity);
    auction.is_active = false;
    auction.is_finalized = true;
    auction_mutex.unlock();

    send_reliable_text(p.peer_id, "msg2 Leilao #" + auction_id + " cancelado com sucesso.", 0);
    send_packet(0, "msg2 Leilao #" + auction_id + " foi cancelado pelo dono.", 0);
    save_player_to_database(p);
    debug_log("[AUCTION] Leilao #" + auction_id + " cancelado por " + p.charname);
}

void finalize_auction(Auction@ auction) {
    if (@auction == null || auction.is_finalized) return;
    auction.is_finalized = true;
    auction.is_active = false;

    if (!auction.current_bidder_id.is_empty()) {
        player@ winner = get_auction_player_by_name(auction.current_bidder_id);
        player@ owner = get_auction_player_by_name(auction.owner_id);

        if (@winner != null) {
            auction_give_item(winner, auction.item_name, auction.item_quantity);
            send_reliable_text(winner.peer_id, "msg2 Parabens! Você venceu o leilao #" + auction.id + " de " + auction.item_name + " por " + auction.current_bid + " ouro!", 0);
            save_player_to_database(winner);
        } else {
            debug_log("[AUCTION] Vencedor offline no leilao #" + auction.id + ": " + auction.current_bidder_id + ". Entrega do item pendente.");
        }

        if (@owner != null) {
            owner.gold += auction.current_bid;
            send_reliable_text(owner.peer_id, "msg2 Seu leilao #" + auction.id + " foi finalizado! Você recebeu " + auction.current_bid + " ouro.", 0);
            save_player_to_database(owner);
        } else {
            if (!auction_credit_offline_gold(auction.owner_id, auction.current_bid)) {
                debug_log("[AUCTION] Falha ao creditar ouro no DB para dono offline: " + auction.owner_id);
            }
        }

        send_packet(0, "msg2 Leilao #" + auction.id + " finalizado! Vencedor: " + auction.current_bidder_name + " por " + auction.current_bid + " ouro.", 0);
        debug_log("[AUCTION] Leilao #" + auction.id + " finalizado - Vencedor: " + auction.current_bidder_name);
    } else {
        player@ owner = get_auction_player_by_name(auction.owner_id);
        if (@owner != null) {
            auction_give_item(owner, auction.item_name, auction.item_quantity);
            send_reliable_text(owner.peer_id, "msg2 Seu leilao #" + auction.id + " expirou sem lances. Item devolvido.", 0);
            save_player_to_database(owner);
        } else {
            debug_log("[AUCTION] Dono offline no leilao sem lances #" + auction.id + ": " + auction.owner_id + ". Devolucao de item pendente.");
        }
        debug_log("[AUCTION] Leilao #" + auction.id + " expirou sem lances");
    }
}

void auction_cleanup_loop() {
	if (last_auction_cleanup.elapsed < AUCTION_CLEANUP_INTERVAL) return;
	last_auction_cleanup.restart();

	auction_mutex.lock();

	for (int i = int(active_auctions.length()) - 1; i >= 0; i--) {
		Auction@ auction = @active_auctions[i];

		if (auction.is_expired() && !auction.is_finalized) {
			finalize_auction(auction);
		}

		if (auction.is_finalized && (ticks() - auction.end_time) > 300000) {
			active_auctions.remove_at(i);
			debug_log("[AUCTION] Leilão #" + auction.id + " removido da memória.");
		}
	}

	auction_mutex.unlock();
}

void cmd_list_auctions(int player_index) {
	if (player_index < 0 || player_index >= int(players.length())) return;
	player@ p = @players[player_index];

	auction_mutex.lock();

	if (active_auctions.length() == 0) {
		auction_mutex.unlock();
		send_reliable_text(p.peer_id, "msg2 Não há leilões ativos no momento.", 0);
		return;
	}

	string list = "=== Leilões Ativos ===\r\n";
	int count = 0;

	for (uint i = 0; i < active_auctions.length(); i++) {
		if (active_auctions[i].is_active && !active_auctions[i].is_finalized) {
			list += active_auctions[i].get_info() + "\r\n";
			count++;
		}
	}

	auction_mutex.unlock();

	if (count == 0) {
		send_reliable_text(p.peer_id, "msg2 Não há leilões ativos no momento.", 0);
	} else {
		send_reliable_text(p.peer_id, "msg2 " + list, 0);
	}
}
