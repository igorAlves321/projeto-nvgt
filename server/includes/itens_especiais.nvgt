// ============================================================================
//  ITENS ESPECIAIS
// ----------------------------------------------------------------------------
//  Porte dos casos especificos de usar() do BGT (re_server_test.bgt:1400-1736)
//  e do "use" do elixir angelical (net.bgt:889 / voids.bgt:926).
//
//  Entrada unica: usar_item_especial(), chamada no comeco de use_item()
//  (consumables.nvgt). Parametros ajustaveis ficam na tabela itens_especiais
//  (semeada com INSERT OR IGNORE); o estado por jogador que precisa sobreviver
//  ao relogin fica em itens_especiais_estado.
//
//  Diferencas de projeto em relacao ao BGT:
//   - saludfangelical (teto de vida) nao existe no port. O teto aqui e
//     _geral.teto_vida_base + _geral.teto_vida_por_fase * reencarnou, nunca
//     abaixo da vida maxima natural do jogador.
//   - No BGT a vida maxima voltava a 10000 a cada logout. No port maxhealth e
//     persistente, entao a vida ganha por pocao e guardada a parte
//     (vida_extra) e retirada no proximo login, salvo com vitalidade perpetua.
//   - A sanidade do port vai de 0 a 100 (no BGT, 0 a 1000): o ganho da pocao
//     branca e multiplicado por pocao_branca.sanidade_escala.
// ============================================================================

const string IE_ANTIMINAS = "pocao_antiminas";
const string IE_ANTIMETEOROS = "pocao_antimeteoros";
const string IE_TROVAO = "pocao_do_trovao";
const string IE_PROTETORA = "pocao_protetora";
const string IE_AMETISTA = "pocao_de_ametista";
const string IE_VITAL = "pocao_vital";
const string IE_ANGELICAL = "pocao_angelical";
const string IE_BRANCA = "pocao_branca";
const string IE_LUMINOSA = "bebida_luminosa";
const string IE_PO_ENERGIA = "po_de_energia";
const string IE_VITALIDADE = "vitalidade_perpetua";
const string IE_RUNA = "runa_dourada";
const string IE_ENVELOPE = "envelope_circular_dourado";
const string IE_IRATCE = "iratce";
const string IE_IRATCE_GASTO = "iratce_gasto";
const string IE_VIDRO = "vidro_quebrado";
const string IE_CAIXA = "caixa_especial_com_laco_dourado";
const string IE_ELIXIR = "elixir_angelical";
const string IE_GERAL = "_geral";
const string IE_LOJA = "_loja";
const string IE_LOJA_VINCULO = "loja_magica";

const int IE_SALVAR_MS = 60000;
const int IE_VARRER_MS = 30000;

// Lidos pelo playerloop (player.nvgt) e pelo pacote times (pacotes_itens.nvgt).
// Recarregados da tabela itens_especiais em ie_carregar_parametros().
int ie_dur_antiminas_ms = 300000;
int ie_dur_antimeteoros_ms = 600000;
int ie_dur_trovao_ms = 600000;
int ie_dur_protetora_ms = 60000;
int ie_dur_ametista_s = 900;
int ie_dur_luminosa_s = 7200;
double ie_mult_ametista = 6.0;
double ie_mult_luminosa = 3.0;

dictionary ie_numeros;
dictionary ie_textos;
dictionary ie_estados;
timer ie_varredura_timer;
bool ie_tabelas_prontas = false;

class ie_estado {
	string jogador = "";
	player@ dono;
	bool linha_no_banco = false;
	double vida_extra = 0;
	int vitalidade_acumulos = 0;
	double vitalidade_total_s = 0;
	double vitalidade_gasto_s = 0;
	bool regen_ativo = false;
	bool regen_sanidade = false;
	int regen_ticks = 0;
	int mascara = 0;
	timer t_regen;
	timer t_vitalidade;
	timer t_salvar;
}

// ----------------------------------------------------------------------------
// Utilitarios
// ----------------------------------------------------------------------------

bool ie_banco_ok() {
	return database_initialized && bancoJogo !is null;
}

void ie_msg(player@ p, string texto) {
	if(p is null) return;
	send_reliable_text(p.peer_id, "msg2 ;" + texto + ";", 0);
}

void ie_som_em(string mapa, int x, int y, string som) {
	if(som == "" || som == "none") return;
	int mi = get_map_index_from(mapa);
	if(mi < 0 || mi >= int(server_maps.length())) return;
	server_maps[mi].send_packet(0, "play " + som, x, y);
}

void ie_som(player@ p, string som) {
	if(p is null) return;
	ie_som_em(p.map, p.x, p.y, som);
}

void ie_consumir(player@ p, string item, int quantidade) {
	p.inv_add_item(item, -quantidade, true);
	save_player_inventory_to_db(p);
}

void ie_entregar(player@ p, string item, int quantidade) {
	p.inv_add_item(item, quantidade, true);
	save_player_inventory_to_db(p);
}

bool ie_e_item_especial(string nome) {
	if(nome == IE_ANTIMINAS || nome == IE_ANTIMETEOROS || nome == IE_TROVAO) return true;
	if(nome == IE_PROTETORA || nome == IE_AMETISTA || nome == IE_VITAL) return true;
	if(nome == IE_ANGELICAL || nome == IE_BRANCA || nome == IE_LUMINOSA) return true;
	if(nome == IE_PO_ENERGIA || nome == IE_VITALIDADE || nome == IE_RUNA) return true;
	if(nome == IE_ENVELOPE || nome == IE_IRATCE || nome == IE_VIDRO) return true;
	if(nome == IE_CAIXA || nome == IE_ELIXIR) return true;
	if(nome == PET_ITEM_ADOCAO || nome == PET_ITEM_RACAO) return true;
	return false;
}

// ----------------------------------------------------------------------------
// Parametros (tabela itens_especiais)
// ----------------------------------------------------------------------------

double ie_num(string item, string parametro, double padrao) {
	string chave = item + "|" + parametro;
	double valor = padrao;
	if(ie_numeros.exists(chave)) ie_numeros.get(chave, valor);
	return valor;
}

string ie_txt(string item, string parametro, string padrao) {
	string chave = item + "|" + parametro;
	string valor = padrao;
	if(ie_textos.exists(chave)) ie_textos.get(chave, valor);
	return valor;
}

void ie_criar_tabelas() {
	ie_tabelas_prontas = false;
	if(!ie_banco_ok()) return;

	string tabela_parametros = """
		CREATE TABLE IF NOT EXISTS itens_especiais (
			item TEXT NOT NULL,
			parametro TEXT NOT NULL,
			valor REAL NOT NULL DEFAULT 0,
			texto TEXT DEFAULT '',
			PRIMARY KEY (item, parametro)
		);
	""";

	if(bancoJogo.execute(tabela_parametros) != SQLITE_OK) {
		debug_log("ERRO ao criar tabela itens_especiais: " + bancoJogo.get_last_error_text());
		return;
	}

	string tabela_estado = """
		CREATE TABLE IF NOT EXISTS itens_especiais_estado (
			jogador TEXT PRIMARY KEY,
			vida_extra REAL DEFAULT 0,
			vida_natural REAL DEFAULT 0,
			vitalidade_acumulos INTEGER DEFAULT 0,
			vitalidade_total_s REAL DEFAULT 0,
			vitalidade_gasto_s REAL DEFAULT 0,
			regen_ativo INTEGER DEFAULT 0,
			regen_sanidade INTEGER DEFAULT 0,
			regen_ticks INTEGER DEFAULT 0,
			antimina_ms INTEGER DEFAULT -1,
			ameteoro_ms INTEGER DEFAULT -1,
			trovao_ms INTEGER DEFAULT -1,
			protegido_ms INTEGER DEFAULT -1,
			ametista_s INTEGER DEFAULT -1,
			luminosa_s INTEGER DEFAULT -1,
			atualizado_em DATETIME DEFAULT CURRENT_TIMESTAMP
		);
	""";

	if(bancoJogo.execute(tabela_estado) != SQLITE_OK) {
		debug_log("ERRO ao criar tabela itens_especiais_estado: " + bancoJogo.get_last_error_text());
		return;
	}

	ie_tabelas_prontas = true;
}

void ie_semear(string item, string parametro, double valor, string texto = "") {
	sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR IGNORE INTO itens_especiais (item, parametro, valor, texto) VALUES (?, ?, ?, ?);");
	if(@stmt == null) return;

	stmt.bind_text(1, item);
	stmt.bind_text(2, parametro);
	stmt.bind_double(3, valor);
	stmt.bind_text(4, texto);
	stmt.step();
}

void ie_semear_parametros() {
	if(!ie_tabelas_prontas) return;

	// Duracoes originais: player.bgt:1090-1216.
	ie_semear(IE_ANTIMINAS, "duracao_ms", 300000);
	ie_semear(IE_ANTIMINAS, "som", 0, "potion.ogg");
	ie_semear(IE_ANTIMETEOROS, "duracao_ms", 600000);
	ie_semear(IE_ANTIMETEOROS, "som", 0, "potion.ogg");
	ie_semear(IE_TROVAO, "duracao_ms", 600000);
	ie_semear(IE_TROVAO, "som", 0, "spell_thunder_start.ogg");
	ie_semear(IE_PROTETORA, "duracao_ms", 60000);
	ie_semear(IE_PROTETORA, "som", 0, "potion.ogg");
	ie_semear(IE_AMETISTA, "duracao_s", 900);
	ie_semear(IE_AMETISTA, "multiplicador_dano", 6);
	ie_semear(IE_AMETISTA, "som", 0, "getpotionpower.ogg");
	ie_semear(IE_LUMINOSA, "duracao_s", 7200);
	ie_semear(IE_LUMINOSA, "multiplicador_dano", 3);
	ie_semear(IE_LUMINOSA, "som", 0, "poção.ogg");

	ie_semear(IE_VITAL, "vida_min", 10000);
	ie_semear(IE_VITAL, "vida_max", 25000);
	ie_semear(IE_VITAL, "som", 0, "gethealth.ogg");

	// Regeneracao: 120 pulsos de 1 s, compartilhados pelas pocoes angelical e branca.
	ie_semear(IE_ANGELICAL, "pulsos", 120);
	ie_semear(IE_ANGELICAL, "intervalo_ms", 1000);
	ie_semear(IE_ANGELICAL, "vida_min", 5000);
	ie_semear(IE_ANGELICAL, "vida_max", 20000);
	ie_semear(IE_ANGELICAL, "som", 0, "potion.ogg");
	ie_semear(IE_BRANCA, "sanidade_min", 2);
	ie_semear(IE_BRANCA, "sanidade_max", 4);
	ie_semear(IE_BRANCA, "sanidade_escala", 0.1);
	ie_semear(IE_BRANCA, "som", 0, "potion.ogg");

	ie_semear(IE_PO_ENERGIA, "quantidade", 10);
	ie_semear(IE_PO_ENERGIA, "x", 5);
	ie_semear(IE_PO_ENERGIA, "y", 5);
	ie_semear(IE_PO_ENERGIA, "som", 0, "teleporter.ogg");

	// 43200 * 60 segundos conectados = 30 dias por unidade, ate 12 acumulos.
	ie_semear(IE_VITALIDADE, "duracao_s", 2592000);
	ie_semear(IE_VITALIDADE, "acumulos_max", 12);
	ie_semear(IE_VITALIDADE, "som", 0, "notify_powerup.ogg");
	ie_semear(IE_VITALIDADE, "som_fim", 0, "notify_died.ogg");

	ie_semear(IE_IRATCE, "vida", 50000);
	ie_semear(IE_IRATCE, "mapa_bloqueado", 0, "mausoleo_infernal");
	ie_semear(IE_IRATCE, "som", 0, "magia_fogo_iniciou.ogg");

	ie_semear(IE_VIDRO, "divisor", 6);
	ie_semear(IE_VIDRO, "som", 0, "sangra.ogg");

	ie_semear(IE_ENVELOPE, "moedas", 1);

	ie_semear(IE_ELIXIR, "divisor", 9);
	ie_semear(IE_ELIXIR, "alcance", 5);
	ie_semear(IE_ELIXIR, "som", 0, "gethealth.ogg");

	ie_semear(IE_CAIXA, "som", 0, "notify_applause.ogg");

	ie_semear(IE_GERAL, "teto_vida_base", 50000);
	ie_semear(IE_GERAL, "teto_vida_por_fase", 1000);
}

void ie_carregar_parametros() {
	ie_numeros.delete_all();
	ie_textos.delete_all();

	if(ie_tabelas_prontas) {
		sqlite3statement@ stmt = bancoJogo.prepare("SELECT item, parametro, valor, texto FROM itens_especiais;");
		if(@stmt != null) {
			while(stmt.step() == SQLITE_ROW) {
				string chave = stmt.column_text(0) + "|" + stmt.column_text(1);
				double valor = stmt.column_double(2);
				string texto = stmt.column_text(3);
				ie_numeros.set(chave, valor);
				if(texto != "") ie_textos.set(chave, texto);
			}
		}
	}

	ie_dur_antiminas_ms = int(ie_num(IE_ANTIMINAS, "duracao_ms", 300000));
	ie_dur_antimeteoros_ms = int(ie_num(IE_ANTIMETEOROS, "duracao_ms", 600000));
	ie_dur_trovao_ms = int(ie_num(IE_TROVAO, "duracao_ms", 600000));
	ie_dur_protetora_ms = int(ie_num(IE_PROTETORA, "duracao_ms", 60000));
	ie_dur_ametista_s = int(ie_num(IE_AMETISTA, "duracao_s", 900));
	ie_dur_luminosa_s = int(ie_num(IE_LUMINOSA, "duracao_s", 7200));
	ie_mult_ametista = ie_num(IE_AMETISTA, "multiplicador_dano", 6);
	ie_mult_luminosa = ie_num(IE_LUMINOSA, "multiplicador_dano", 3);

	if(ie_dur_antiminas_ms < 1000) ie_dur_antiminas_ms = 1000;
	if(ie_dur_antimeteoros_ms < 1000) ie_dur_antimeteoros_ms = 1000;
	if(ie_dur_trovao_ms < 1000) ie_dur_trovao_ms = 1000;
	if(ie_dur_protetora_ms < 1000) ie_dur_protetora_ms = 1000;
	if(ie_dur_ametista_s < 1) ie_dur_ametista_s = 1;
	if(ie_dur_luminosa_s < 1) ie_dur_luminosa_s = 1;
	if(ie_mult_ametista < 1) ie_mult_ametista = 1;
	if(ie_mult_luminosa < 1) ie_mult_luminosa = 1;
}

// ----------------------------------------------------------------------------
// Catalogo: itens, descricoes e loja
// ----------------------------------------------------------------------------

void ie_registrar_itens() {
	if(!ie_banco_ok()) return;

	int inseridos = 0;
	if(ensure_item_in_catalog(IE_ANTIMINAS, "Poção antiminas")) inseridos++;
	if(ensure_item_in_catalog(IE_ANTIMETEOROS, "Poção antimeteoros")) inseridos++;
	if(ensure_item_in_catalog(IE_TROVAO, "Poção do trovão")) inseridos++;
	if(ensure_item_in_catalog(IE_PROTETORA, "Poção protetora")) inseridos++;
	if(ensure_item_in_catalog(IE_AMETISTA, "Poção de ametista")) inseridos++;
	if(ensure_item_in_catalog(IE_VITAL, "Poção vital")) inseridos++;
	if(ensure_item_in_catalog(IE_ANGELICAL, "Poção angelical")) inseridos++;
	if(ensure_item_in_catalog(IE_BRANCA, "Poção branca")) inseridos++;
	if(ensure_item_in_catalog(IE_LUMINOSA, "Bebida luminosa")) inseridos++;
	if(ensure_item_in_catalog(IE_PO_ENERGIA, "Pó de energia")) inseridos++;
	if(ensure_item_in_catalog(IE_VITALIDADE, "Vitalidade perpétua")) inseridos++;
	if(ensure_item_in_catalog(IE_RUNA, "Runa dourada")) inseridos++;
	if(ensure_item_in_catalog(IE_ENVELOPE, "Envelope circular dourado")) inseridos++;
	if(ensure_item_in_catalog(IE_IRATCE, "Iratce")) inseridos++;
	if(ensure_item_in_catalog(IE_IRATCE_GASTO, "Iratce gasto")) inseridos++;
	if(ensure_item_in_catalog(IE_VIDRO, "Vidro quebrado")) inseridos++;
	if(ensure_item_in_catalog(IE_CAIXA, "Caixa especial com laço dourado")) inseridos++;
	if(ensure_item_in_catalog(IE_ELIXIR, "Elixir angelical")) inseridos++;

	if(inseridos > 0) {
		load_items_from_database();
		debug_log("ITENS ESPECIAIS: " + inseridos + " itens inseridos no catalogo");
	}
}

void ie_descrever(string item, string descricao) {
	sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR IGNORE INTO item_descriptions (name, description) VALUES (?, ?);");
	if(@stmt != null) {
		stmt.bind_text(1, item);
		stmt.bind_text(2, descricao);
		stmt.step();
	}

	if(!item_descriptions.exists(item)) item_descriptions.set(item, descricao);
}

void ie_semear_descricoes() {
	if(!ie_banco_ok()) return;

	sqlite3statement@ tabela = bancoJogo.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name='item_descriptions' LIMIT 1;");
	if(@tabela == null || tabela.step() != SQLITE_ROW) return;

	ie_descrever(IE_ANTIMINAS, "Um frasco transparente de conteúdo amarelo, que emite uma luz da mesma cor. Na tampa está escrito: poção para evitar as minas. Dura 5 minutos.");
	ie_descrever(IE_ANTIMETEOROS, "Um frasco transparente de conteúdo verde-esmeralda, que emite uma luz da mesma cor. Na tampa está escrito: poção para se proteger dos meteoros. Dura 10 minutos.");
	ie_descrever(IE_TROVAO, "Um frasco transparente. Ao segurá-lo você sente uma pequena descarga elétrica. O conteúdo é azulado e solta faíscas. Na tampa está escrito: para mais velocidade. Dura 10 minutos.");
	ie_descrever(IE_PROTETORA, "Um frasco transparente de conteúdo branco e luminoso, que traz uma sensação de bem-estar. Na tampa está escrito: protege de enfermidades demoníacas. Dura 1 minuto.");
	ie_descrever(IE_AMETISTA, "Ao beber este líquido maravilhoso, o dano dos seus ataques é multiplicado por 6 durante 15 minutos de combate.");
	ie_descrever(IE_VITAL, "Uma poção que faz uma grande energia correr pelas suas veias, aumentando a sua vida e a sua vida máxima até você sair do jogo.");
	ie_descrever(IE_ANGELICAL, "Um frasco branco-prateado com um anjo desenhado. Beba e a sua vida se regenerará sozinha durante 2 minutos.");
	ie_descrever(IE_BRANCA, "Uma poção branca e serena. Devolve aos poucos a sua tranquilidade mental durante 2 minutos.");
	ie_descrever(IE_LUMINOSA, "Uma garrafa pequena com um líquido que emana uma luz potente e aparentemente inextinguível. Triplica o dano dos seus ataques por 2 horas de combate.");
	ie_descrever(IE_PO_ENERGIA, "Um pó com carga negativa. Com 10 porções, leva você de volta à sua ilha privada.");
	ie_descrever(IE_VITALIDADE, "Coloca a sua vida no máximo sempre que você conecta ao jogo, durante 30 dias. Se usar várias, o efeito é acumulativo.");
	ie_descrever(IE_RUNA, "Uma runa dourada entregue aos casados. Leva você até onde o seu cônjuge estiver.");
	ie_descrever(IE_ENVELOPE, "Um envelope circular dourado. Abra para receber a moeda que ele guarda.");
