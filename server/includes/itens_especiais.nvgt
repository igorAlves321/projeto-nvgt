	ie_descrever(IE_IRATCE_GASTO, "Um iratce que já entregou todo o seu poder. Agora é só uma lembrança.");
	ie_descrever(IE_VIDRO, "Um caco de vidro afiado. Usá-lo fere gravemente quem o segura.");
	ie_descrever(IE_CAIXA, "Uma caixa de presente preciosa, muito bem decorada. Será uma boa ideia abri-la para ver o que tem dentro?");
	ie_descrever(IE_ELIXIR, "Um frasco muito comprido, com um líquido dourado dentro. Cura você e os companheiros de equipe que estiverem por perto.");
