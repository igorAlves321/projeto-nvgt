// hcaverna.nvgt - Sistema de Homem das Cavernas do EVM Server (convertido de BGT)
// Conversão: BGT → NVGT

hcaverna@[] hcavernas_ativas;

class hcaverna {
	int x, y, vida = random(100000, 300000), morrendo = 0, morreu = 0, narma, ndist = 7, ndano = random(2000, 4000), natirar = 1232, nsom = 5000;
	string mapa, golpeado, njogador;
	timer tandar, tmorreu, tsom, tatirar;
	string[] tipoarma = {"", "lança", "espada_curta", "espada"};
	
	hcaverna(int zx, int zy, string m, int tn) {
		x = zx;
		y = zy;
		mapa = m;
		tmorreu.force(0);
		tmorreu.pause();
		narma = tn;
		if (tn == 3) {
			ndist = 10;
			natirar = random(800, 1400);
			ndano = random(5000, 8000);
		}
	}
	
	~hcaverna() {
		for (uint i = 0; i < walls.length(); i++) {
			if (walls[i].map == mapa) walls[i].vida = -1;
		}
	}
}

void colocar_hcaverna(int x, int y, string m, int nn = random(1, 2)) {
	hcaverna z(x, y, m, nn);
	hcavernas_ativas.insert_last(z);
	colocar_wall(97, m, 1000000000);
	spawn_obj(100, 0, "antídoto-", 1, m);
}

void hcavernaloop() {
	for (uint i = 0; i < hcavernas_ativas.length(); i++) {
		int saiu = 0;
		
		// Sistema de morte
		if (hcavernas_ativas[i].vida <= 0 && hcavernas_ativas[i].morreu == 1 && hcavernas_ativas[i].tmorreu.elapsed >= 4450) {
			net.send_packet(0, "play " + get_tile_at(hcavernas_ativas[i].x, hcavernas_ativas[i].y, hcavernas_ativas[i].mapa) + "harland.ogg " + hcavernas_ativas[i].x + " " + hcavernas_ativas[i].y, hcavernas_ativas[i].mapa);
			string golp = hcavernas_ativas[i].golpeado;
			// net.send_reliable(0, "msg2 " + golp + "; ;matou um; ;homem_das_cavernas;!", 3);
			int xx = get_player_index_from(golp);
			if (xx > -1) {
				ganhaxp(players[xx].charname, random(1050, 1500));
			}
			hcavernas_ativas.remove_at(i);
			saiu = 1;
			return;
		}
		
		if (saiu == 1) break;
		else if (hcavernas_ativas[i].morreu == 0 && hcavernas_ativas[i].vida <= 0) {
			net.send_packet(0, "play v1morte1.ogg " + hcavernas_ativas[i].x + " " + hcavernas_ativas[i].y, hcavernas_ativas[i].mapa);
			hcavernas_ativas[i].tmorreu.restart();
			hcavernas_ativas[i].morreu = 1;
		}
		
		// Sons periódicos
		if (hcavernas_ativas[i].tsom.elapsed >= hcavernas_ativas[i].nsom && hcavernas_ativas[i].morrendo == 0 && hcavernas_ativas[i].morreu == 0) {
			hcavernas_ativas[i].nsom = random(2000, 6200);
			net.send_packet(0, "play uga" + random(1, 2) + ".ogg " + hcavernas_ativas[i].x + " " + hcavernas_ativas[i].y, hcavernas_ativas[i].mapa);
			hcavernas_ativas[i].tsom.restart();
		}
		
		if (saiu == 1) break;
		int andar = 1;
		
		// Sistema de ataque
		if (hcavernas_ativas[i].tatirar.elapsed >= hcavernas_ativas[i].natirar && hcavernas_ativas[i].morreu == 0) {
			hcavernas_ativas[i].tatirar.restart();
			int i2 = get_player_index_from(hcavernas_ativas[i].njogador);
			
			if (i2 > -1) {
				if (players[i2].pacifico == 1 || get_safezone_at(players[i2].x, players[i2].y, players[i2].map) == true || players[i2].afk || players[i2].map != hcavernas_ativas[i].mapa) i2 = -1;
			}
			
			if (i2 < 0) hcavernas_ativas[i].njogador = selecionar_jogador(hcavernas_ativas[i].mapa);
			i2 = get_player_index_from(hcavernas_ativas[i].njogador);
			
			if (i2 > -1) {
				if (players[i2].pacifico == 1 || get_safezone_at(players[i2].x, players[i2].y, players[i2].map) == true || players[i2].afk || players[i2].map != hcavernas_ativas[i].mapa) i2 = -1;
			}
			
			if (i2 < 0) break;
			
			if (g(hcavernas_ativas[i].x, hcavernas_ativas[i].y, players[i2].x, players[i2].y) <= hcavernas_ativas[i].ndist && players[i2].afk == false && players[i2].pacifico == 0 && get_safezone_at(players[i2].x, players[i2].y, players[i2].map) == false) {
				andar = 0;
				net.send_packet(0, "play " + hcavernas_ativas[i].tipoarma[hcavernas_ativas[i].narma] + ".ogg " + hcavernas_ativas[i].x + " " + hcavernas_ativas[i].y, hcavernas_ativas[i].mapa);
				players[i2].health -= hcavernas_ativas[i].ndano;
				net.send_packet(0, "play uga_bater" + random(1, 2) + ".ogg " + hcavernas_ativas[i].x + " " + hcavernas_ativas[i].y, hcavernas_ativas[i].mapa);
				players[i2].lasthit = "homem_das_cavernas";
				break;
			}
		}
		
		andar = 0;
		
		// Sistema de movimento (apenas para armas corpo a corpo)
		if (hcavernas_ativas[i].tandar.elapsed >= 210 && hcavernas_ativas[i].morrendo == 0 && hcavernas_ativas[i].morreu == 0 && andar == 1 && hcavernas_ativas[i].narma < 3) {
			hcavernas_ativas[i].tandar.restart();
			int i2 = get_player_index_from(hcavernas_ativas[i].njogador);
			
			if (i2 > -1) {
				if (players[i2].pacifico == 1 || get_safezone_at(players[i2].x, players[i2].y, players[i2].map) == true || players[i2].afk || players[i2].map != hcavernas_ativas[i].mapa) i2 = -1;
			}
			
			if (i2 < 0) hcavernas_ativas[i].njogador = selecionar_jogador(hcavernas_ativas[i].mapa);
			i2 = get_player_index_from(hcavernas_ativas[i].njogador);
			
			if (i2 > -1) {
				if (players[i2].pacifico == 1 || get_safezone_at(players[i2].x, players[i2].y, players[i2].map) == true || players[i2].afk || players[i2].map != hcavernas_ativas[i].mapa) i2 = -1;
			}
			
			if (i2 < 0) break;
			
			if (hcavernas_ativas[i].x > players[i2].x - 1 && !players[i2].afk && get_tile_at(hcavernas_ativas[i].x - 1, hcavernas_ativas[i].y, hcavernas_ativas[i].mapa).find("wall") == -1 && andar == 1) {
				hcavernas_ativas[i].x--;
				net.send_packet(0, "play " + get_tile_at(hcavernas_ativas[i].x, hcavernas_ativas[i].y, hcavernas_ativas[i].mapa) + "step" + random(1, 5) + ".ogg " + hcavernas_ativas[i].x + " " + hcavernas_ativas[i].y, hcavernas_ativas[i].mapa);
				andar = 0;
				break;
			}
			else if (hcavernas_ativas[i].x < players[i2].x + 1 && !players[i2].afk && get_tile_at(hcavernas_ativas[i].x + 1, hcavernas_ativas[i].y, hcavernas_ativas[i].mapa).find("wall") == -1 && andar == 1) {
				hcavernas_ativas[i].x++;
				net.send_packet(0, "play " + get_tile_at(hcavernas_ativas[i].x, hcavernas_ativas[i].y, hcavernas_ativas[i].mapa) + "step" + random(1, 5) + ".ogg " + hcavernas_ativas[i].x + " " + hcavernas_ativas[i].y, hcavernas_ativas[i].mapa);
				andar = 0;
				break;
			}
		}
		
		// Detectar jogadores próximos
		for (uint i2 = 0; i2 < players.length(); i2++) {
			if (players[i2].map == hcavernas_ativas[i].mapa && players[i2].afk == false && players[i2].pacifico == 0 && g(hcavernas_ativas[i].x, hcavernas_ativas[i].y, players[i2].x, players[i2].y) <= hcavernas_ativas[i].ndist) {
				hcavernas_ativas[i].njogador = players[i2].charname;
				break;
			}
		}
	}
}
