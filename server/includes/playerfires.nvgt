// playerfires.nvgt - Sistema de Fogo no Jogador
// Convertido de playerfires.bgt para NVGT
// Gerencia queimaduras de bolas de fogo e fogo grudado

class playerfire {
	int x, y;          // Posição do fogo
	string map;        // Mapa onde o fogo está
	int owner;         // Índice do jogador que causou o fogo
	int damage;        // Dano por tick
	int duration;      // Duração total em ms
	string enemy;      // Nome do inimigo que causou o fogo
	timer t;          // Timer para dano periódico (a cada 1 segundo)
	timer tt;         // Timer total de duração (30 segundos por padrão)
	
	playerfire(string enemy_name) {
		this.enemy = enemy_name;
		this.damage = 10; // Dano padrão
		this.duration = 30000; // 30 segundos padrão
		t.restart();
		tt.restart();
	}
	
	// Construtor completo
	playerfire() {
		this.damage = 10;
		this.duration = 30000;
	}
}

