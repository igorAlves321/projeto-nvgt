// playerfires.nvgt - Sistema de Fogo no Jogador
// Convertido de playerfires.bgt para NVGT
// Gerencia queimaduras de bolas de fogo e fogo grudado

class playerfire {
	string enemy;      // Nome do inimigo que causou o fogo
	timer t;          // Timer para dano periódico (a cada 1 segundo)
	timer tt;         // Timer total de duração (30 segundos)
	
	playerfire(string enemy_name) {
		this.enemy = enemy_name;
		t.restart();
		tt.restart();
	}
}
