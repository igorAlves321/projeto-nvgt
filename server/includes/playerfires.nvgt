
class playerfire {
	int x, y;
	string map;
	int owner;
	int damage;
	int duration;
	string enemy;
	timer t;
	timer tt;

	playerfire(string enemy_name) {
		this.enemy = enemy_name;
		this.damage = 10;
		this.duration = 30000;
		t.restart();
		tt.restart();
	}

	playerfire() {
		this.damage = 10;
		this.duration = 30000;
	}
}
