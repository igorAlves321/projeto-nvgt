
monstruo@[] monstruos_global;

void send_to_map_m(string message, string mapname) {
	server_broadcast(message, mapname);
}

class monstruo {
	int x, y;
	int x_inicial = 0, y_inicial = 0;
	int id = 0;

	int vida = 100;
	int vida_max = 100;
	int xp_reward = 50;
	int gold_reward_min = 100;
	int gold_reward_max = 500;
	int dano_min = 100;
	int dano_max = 200;
	int distanciaataques = 5;

	int p_index = -1;
	string target_player = "";
	timer update_player;
	int player_update_interval = 3000;

	int tiempoparaatacar = 2000;
	int tiempoparacaminar = 300;
	int tiempodelossonidos = 8000;

	timer ttiempoparaatacar;
	timer ttiempoparacaminar;
	timer ttiempodelossonidos;

	string[] sonidosnervioso;
	string sonidoataque = "";
	string sonidomuerte = "";
	string impactosbala = "";
	string impactos = "";
	string pasosmonstruo = "";

	bool morreu = false;
	bool morrendo = false;
	bool nasceu = true;
	string asesino = "";
	string golpeado = "";
	timer tmorreu;

	int mapindex = -1;
	string map = "";
	string name = "";
	string tipo = "";

	bool enablerespawn = true;
	int tiempoaparicion = 60000;
	int spawn_chance = 0;
	int spawn_count_min = 1;
	int spawn_count_max = 3;

	string itemsadar = "";
	string degradation = "";
	string msgmuerte = "";

	int left_range = 0;
	int right_range = 0;
	int ladoandar = 2;
	bool agressivo = true;

	monstruo(int nx, int ny, string nmap, string ntipo) {
		x = nx;
		y = ny;
		x_inicial = nx;
		y_inicial = ny;
		map = nmap;
		tipo = ntipo;
		name = ntipo + "_" + nx + "_" + ny;
		mapindex = get_map_index_from(map);
		nasceu = true;

		setup_by_type(ntipo);
	}

	void setup_by_type(string type) {
		if(type == "cachorro") {
			vida = random(2000, 2300);
			vida_max = vida;
			xp_reward = random(10, 20);
			gold_reward_min = 5;
			gold_reward_max = 15;
			dano_min = 300;
			dano_max = 500;
			distanciaataques = 2;
			tiempoparaatacar = 500;
			tiempoparacaminar = 290;
			sonidomuerte = "m_cachorro.ogg";
			itemsadar = "corpo_de_cachorro:1";
		}
		else if(type == "lobo") {
			vida = random(3000, 3300);
			vida_max = vida;
			xp_reward = random(20, 30);
			gold_reward_min = 10;
			gold_reward_max = 30;
			dano_min = 400;
			dano_max = 600;
			distanciaataques = 2;
			tiempoparaatacar = 500;
			tiempoparacaminar = 250;
			sonidomuerte = "m_lobo.ogg";
			itemsadar = "corpo_de_lobo:1";
		}
		else if(type == "zumbi") {
			vida = random(3000, 6000);
			vida_max = vida;
			xp_reward = random(50, 100);
			gold_reward_min = 1000;
			gold_reward_max = 3000;
			dano_min = 500;
			dano_max = 1000;
			distanciaataques = 3;
			tiempoparaatacar = 800;
			tiempoparacaminar = 400;
			sonidomuerte = "m_zumbi.ogg";
			spawn_chance = 15;
			spawn_count_min = 1;
			spawn_count_max = 2;
		}
		else if(type == "urso") {
			vida = random(5000, 8000);
			vida_max = vida;
			xp_reward = random(100, 200);
			gold_reward_min = 500;
			gold_reward_max = 1500;
			dano_min = 800;
			dano_max = 1500;
			distanciaataques = 3;
			tiempoparaatacar = 1000;
			tiempoparacaminar = 500;
			sonidomuerte = "m_urso.ogg";
			itemsadar = "corpo_de_urso:1|pele_de_urso:1";
		}
	}

	bool exists_player_in_my_map() {
		for(uint i = 0; i < players.length(); i++) {
			if(players[i].map == this.map &&
			   !players[i].afk &&
			   players[i].pacifico == 0 &&
			   players[i].newbie == false &&
			   players[i].health > 0) {
				return true;
			}
		}
		return false;
	}

	int selecionar_jogador() {
		int closest_player = -1;
		double closest_distance = 999999;

		for(uint i = 0; i < players.length(); i++) {
			if(players[i].map != this.map) continue;
			if(players[i].afk) continue;
			if(players[i].pacifico == 1) continue;
			if(players[i].newbie) continue;
			if(players[i].health <= 0) continue;

			if(get_safezone_at(players[i].x, players[i].y, players[i].map)) continue;

			double dist = get_distance(this.x, this.y, players[i].x, players[i].y);

			if(agressivo) {
				double weight = dist / (players[i].health + 1);

				if(weight < closest_distance) {
					closest_distance = weight;
					closest_player = i;
				}
			}
			else {
				if(dist < closest_distance) {
					closest_distance = dist;
					closest_player = i;
				}
			}
		}

		return closest_player;
	}

	int change_player(int current_index) {
		if(current_index > -1 && current_index < players.length()) {
			if(players[current_index].map == this.map &&
			   !players[current_index].afk &&
			   players[current_index].pacifico == 0 &&
			   players[current_index].health > 0 &&
			   !get_safezone_at(players[current_index].x, players[current_index].y, players[current_index].map)) {
				return current_index;
			}
		}

		return selecionar_jogador();
	}

	void move() {
		if(update_player.elapsed >= player_update_interval) {
			update_player.restart();
			p_index = change_player(p_index);
		}

		if(p_index < 0 || p_index >= players.length()) return;

		if(ttiempoparacaminar.elapsed < tiempoparacaminar) return;
		ttiempoparacaminar.restart();

		bool can_move_left = (left_range == 0 || this.x > left_range);
		bool can_move_right = (right_range == 0 || this.x < right_range);

		if(this.x > players[p_index].x && can_move_left) {
			this.x -= ladoandar;
			if(this.x < players[p_index].x) this.x = players[p_index].x;
			play_step_sound();
		}
		else if(this.x < players[p_index].x && can_move_right) {
			this.x += ladoandar;
			if(this.x > players[p_index].x) this.x = players[p_index].x;
			play_step_sound();
		}

		if(this.y > players[p_index].y) {
			this.y -= ladoandar;
			if(this.y < players[p_index].y) this.y = players[p_index].y;
		}
		else if(this.y < players[p_index].y) {
			this.y += ladoandar;
			if(this.y > players[p_index].y) this.y = players[p_index].y;
		}
	}

	void play_step_sound() {
		if(pasosmonstruo != "") {
			send_to_map_m("play " + pasosmonstruo + " " + this.x + " " + this.y, this.map);
		}
		else {
			string tile = get_tile_at(this.x, this.y, this.map);
			send_to_map_m("play " + tile + "step" + random(1, 5) + ".ogg " + this.x + " " + this.y, this.map);
		}
	}

	void attack() {
		if(p_index < 0 || p_index >= players.length()) return;
		if(ttiempoparaatacar.elapsed < tiempoparaatacar) return;

		double dist = get_distance(this.x, this.y, players[p_index].x, players[p_index].y);

		if(dist <= distanciaataques) {
			ttiempoparaatacar.restart();

			if(sonidoataque != "") {
				send_to_map_m("play " + sonidoataque + " " + this.x + " " + this.y, this.map);
			}

			int reflected_damage = refletir(p_index, tipo, this.x, this.y, random(dano_min, dano_max));
			if(reflected_damage > 0) {
				this.vida -= reflected_damage;
				this.golpeado = players[p_index].charname;
				this.asesino = players[p_index].charname;
				return;
			}

			int damage = random(dano_min, dano_max);
			players[p_index].health -= damage;
			players[p_index].lasthit = tipo;

			send_to_map_m("inithurt " + players[p_index].voice + " " + players[p_index].x + " " + players[p_index].y, players[p_index].map);
		}
	}

	void play_nervous_sounds() {
		if(sonidosnervioso.length() == 0) return;
		if(ttiempodelossonidos.elapsed < tiempodelossonidos) return;

		ttiempodelossonidos.restart();

		string snd = sonidosnervioso[random(0, sonidosnervioso.length() - 1)];
		send_to_map_m("play " + snd + " " + this.x + " " + this.y, this.map);
	}

	void die() {
		morreu = true;
		morrendo = true;

		if(sonidomuerte != "") {
			send_to_map_m("play " + sonidomuerte + " " + this.x + " " + this.y, this.map);
		}

		string golp = (asesino != "") ? asesino : golpeado;

		if(golp != "") {
			send_reliable_text(0, "msg2 " + golp + "; ;matou um; ;" + tipo + ";!", 3);
		}

		int killer_index = get_player_index_from(golp);
		if(killer_index > -1) {
			int gold = random(gold_reward_min, gold_reward_max);
			ganhaxp(killer_index, xp_reward, gold);

			drop_items(killer_index);

			if(spawn_chance > 0 && random(1, 100) <= spawn_chance) {
				spawn_more_monsters();
			}
		}
	}

	void drop_items(int killer_index) {
		if(itemsadar == "") return;

		string[] items = itemsadar.split("|");
		for(uint i = 0; i < items.length(); i++) {
			if(items[i] == "") continue;

			string[] parts = items[i].split(":");
			string item_name = parts[0];
			int quantity = (parts.length() > 1) ? parse_int(parts[1]) : 1;

			if(killer_index > -1) {
				players[killer_index].inv_add_item(item_name, quantity);
			}
		}
	}

	void spawn_more_monsters() {
		int count = random(spawn_count_min, spawn_count_max);

		for(int i = 0; i < count; i++) {
			int spawn_x = this.x + random(-5, 5);
			int spawn_y = this.y + random(-5, 5);

			spawn_monstruo(spawn_x, spawn_y, this.map, this.tipo);
		}

		send_reliable_text(0, "msg2 Mais; ;" + tipo + "s; ;apareceram!", 3);
	}
}

class monstruo_data {
	int x, y;
	int vida;
	int xp_reward;
	int gold_min, gold_max;
	int dano_min, dano_max;
	string tipo;
	string map;
	int tiempoaparicion;
	timer trespawn;
	bool enablerespawn;

	monstruo_data(int nx, int ny, int nvida, int nxp, int ngold_min, int ngold_max,
	             int ndano_min, int ndano_max, string ntipo, string nmap,
	             int ntiempoaparicion, bool nenablerespawn) {
		x = nx;
		y = ny;
		vida = nvida;
		xp_reward = nxp;
		gold_min = ngold_min;
		gold_max = ngold_max;
		dano_min = ndano_min;
		dano_max = ndano_max;
		tipo = ntipo;
		map = nmap;
		tiempoaparicion = ntiempoaparicion;
		enablerespawn = nenablerespawn;
		trespawn.restart();
	}
}

monstruo_data@[] monstruos_data;

void spawn_monstruo(int x, int y, string map, string tipo) {
	monstruo m(x, y, map, tipo);
	monstruos_global.insert_last(m);
}

void monstruo_global_loop() {
	for(uint i = 0; i < monstruos_global.length(); i++) {
		if(monstruos_global[i].vida <= 0 && !monstruos_global[i].morreu) {
			monstruos_global[i].die();

			if(monstruos_global[i].enablerespawn) {
				monstruo_data md(
					monstruos_global[i].x_inicial,
					monstruos_global[i].y_inicial,
					monstruos_global[i].vida_max,
					monstruos_global[i].xp_reward,
					monstruos_global[i].gold_reward_min,
					monstruos_global[i].gold_reward_max,
					monstruos_global[i].dano_min,
					monstruos_global[i].dano_max,
					monstruos_global[i].tipo,
					monstruos_global[i].map,
					monstruos_global[i].tiempoaparicion,
					true
				);
				monstruos_data.insert_last(md);
			}

			monstruos_global.remove_at(i);
			continue;
		}

		monstruos_global[i].play_nervous_sounds();

		monstruos_global[i].move();

		monstruos_global[i].attack();
	}

	for(uint i = 0; i < monstruos_data.length(); i++) {
		if(monstruos_data[i].trespawn.elapsed >= monstruos_data[i].tiempoaparicion) {
			spawn_monstruo(
				monstruos_data[i].x,
				monstruos_data[i].y,
				monstruos_data[i].map,
				monstruos_data[i].tipo
			);

			monstruos_data.remove_at(i);
		}
	}
}
