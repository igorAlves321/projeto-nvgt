
vidrioroto@[] vidriosrotos;

class vidrioroto {
	int x, y;
	int quantoscavar = 1;
	int quantosvidrio = 1;
	string map;

	vidrioroto(int mx, int my, string mmap) {
		x = mx;
		y = my;
		map = mmap;
	}
}

void colocar_vidrioroto(int x, int y, string map) {
	vidrioroto o(x, y, map);
	vidriosrotos.insert_last(o);
}
