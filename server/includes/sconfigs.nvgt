// sconfigs.nvgt - Sistema de Configurações do Jogador
// Convertido de sconfigs.bgt para NVGT
// Salva configurações do jogador ao desconectar do servidor

void sconfigs(int index) {
	dictionary sd;
	file f;
	string nequipe, clothing, body_parts;
	
	// Montar string de equipamento
	for(uint i = 0; i < players[index].nomesequipe.length(); i++) {
		nequipe += players[index].nomesequipe[i] + "\r\n";
	}
	sd.set("nomesequipe", nequipe);
	
	// Montar string de roupas
	for(int x = 0; x < players[index].clothing.length(); x++) {
		clothing += players[index].clothing[x] + "\r\n";
	}
	sd.set("title", players[index].title);
	sd.set("clothing", clothing);
	
	// Montar string de partes do corpo
	for(int x = 0; x < players[index].body_parts.length(); x++) {
		body_parts += players[index].body_parts[x] + "\r\n";
	}
	sd.set("body_parts", body_parts);
	
	// Salvar configurações básicas
	sd.set("relogio", players[index].relogio);
	sd.set("parachute", players[index].have_parachute);
	sd.set("married", players[index].whomarried);
	sd.set("parabatai", players[index].whoparabatai);
	sd.set("elemental_energy", players[index].elemental_energy);
	
	// Salvar preferências de idioma
	sd.set("l_es_v", players[index].l_es_v);
	sd.set("l_en_v", players[index].l_en_v);
	sd.set("l_fr_v", players[index].l_fr_v);
	sd.set("l_pt_v", players[index].l_pt_v);
	
	// Salvar configurações de spam e silenciamento
	sd.set("silenciado", players[index].silenciado);
	sd.set("antispam", players[index].antispam);
	sd.set("antispam_time", players[index].antispam_time);
	sd.set("total_messages", players[index].total_messages);
	
	// Salvar preferências de avisos
	sd.set("avisafangelical", players[index].avisafangelical);
	sd.set("avisanivel", players[index].avisanivel);
	sd.set("avisaserver", players[index].avisaserver);
	sd.set("avisaxp", players[index].avisaxp);
	sd.set("arank", players[index].arank);
	sd.set("dequipo", players[index].dequipo);
	sd.set("aitem", players[index].aitem);
	sd.set("avisarcg", players[index].avisarcg);
	sd.set("dpm", players[index].dpm);
	
	// Salvar timers de penalidades
	sd.set("temposilencio", players[index].temposilencio);
	sd.set("tsilencio", players[index].tsilencio.elapsed);
	
	// Salvar efeitos de itens especiais
	sd.set("bebida", players[index].caverna);
	sd.set("tbebida", players[index].tcaverna.elapsed);
	sd.set("caverna_time", players[index].caverna_time);
	sd.set("amethyst", players[index].amethyst);
	sd.set("tamethyst", players[index].tamethyst.elapsed);
	sd.set("amethyst_time", players[index].amethyst_time);
	
	// Salvar estados gerais
	sd.set("afktime", players[index].afktime);
	sd.set("reply", players[index].replyname);
	sd.set("muted", players[index].muted);
	sd.set("draw", players[index].draw);
	
	// Salvar posição e mapa
	sd.set("x", players[index].x);
	sd.set("y", players[index].y);
	sd.set("map", players[index].map);
	
	// Salvar validação de nome
	sd.set("validated_name", players[index].validated_name);
	sd.set("needs_to_change", players[index].needs_to_change);
	
	// Salvar atributos básicos do personagem
	sd.set("sexo", players[index].sexo);
	sd.set("xp", players[index].xp);
	sd.set("stryx", players[index].stryx);
	sd.set("creditos", players[index].creditos);
	sd.set("level", players[index].level);
	sd.set("fangelical", players[index].fangelical);
	
	// Salvar necessidades fisiológicas
	sd.set("nsede", players[index].nsede);
	sd.set("nfome", players[index].nfome);
	sd.set("ncoco", players[index].ncoco);
	sd.set("nurina", players[index].nurina);
	sd.set("sujo", players[index].sujo);
	sd.set("ngripe", players[index].ngripe);
	
	// Salvar efeitos mágicos/especiais
	sd.set("trueno", players[index].trueno);
	sd.set("ameteoro", players[index].ameteoro);
	sd.set("antimina", players[index].antimina);
	sd.set("protegido", players[index].protegido);
	sd.set("ttrueno", players[index].tmveloz2.elapsed);
	sd.set("tameteoro", players[index].tameteoro.elapsed);
	sd.set("tiempometeoro", players[index].tiempometeoro);
	sd.set("tmeteoro", players[index].tmeteoro.elapsed);
	sd.set("tantimina", players[index].tantimina.elapsed);
	sd.set("tprotegido", players[index].tprotegido.elapsed);
	
	// Salvar estados de gameplay
	sd.set("pacifico", players[index].pacifico);
	sd.set("lregras", players[index].lregras);
	
	// Salvar degradação
	sd.set("anillodegradacion", players[index].anillodegradacion);
	sd.set("vitalidaddegradacion", players[index].vitalidaddegradacion);
	sd.set("vitalidad_time", players[index].vitalidad_time);
	
	// Salvar saúde e sanidade
	sd.set("maxhealth", players[index].maxhealth);
	sd.set("saludfangelical", players[index].saludfangelical);
	sd.set("healthfixed", players[index].healthfixed);
	sd.set("nbaculo", players[index].nbaculo);
	sd.set("baculofangelical", players[index].baculofangelical);
	sd.set("baculotiempo", players[index].baculotiempo);
	sd.set("cantidadcachorros", players[index].cantidadcachorros);
	sd.set("health", players[index].health);
	sd.set("sanity", players[index].sanity);
	
	// Salvar inventário serializado
	sd.set("invs", players[index].invs);
	
	// Salvar dados de respawn/retorno
	sd.set("mapavoltar", players[index].mapavoltar);
	
	// Salvar time anterior
	string nteam;
	for(uint i = 0; i < players[index].preteam.length(); i++) {
		nteam += players[index].preteam[i] + "\r\n";
	}
	sd.set("preteam", nteam);
	sd.set("premapa", players[index].premapa);
	sd.set("prex", players[index].prex);
	sd.set("prey", players[index].prey);
	
	// Salvar dados de pagamento e ilha
	sd.set("payment", players[index].payment);
	sd.set("payed", players[index].payed);
	sd.set("have_island", players[index].have_island);
	
	// Salvar prisão e paralisação
	sd.set("tempoprision", players[index].tempoprision);
	sd.set("saldo", players[index].saldo);
	sd.set("paralisado", players[index].paralisado);
	sd.set("nparalisado", players[index].nparalisado);
	
	// Salvar contadores de kills para o sistema de patentes
	sd.set("kills", players[index].kills);
	sd.set("matou", players[index].matou);
	
	// Salvar variáveis do sistema de recompensas
	sd.set("bounty_on_head", players[index].bounty_on_head);
	sd.set("bounty_value", players[index].bounty_value);
	sd.set("bounty_owner", players[index].bounty_owner);
	sd.set("bounty_active", players[index].bounty_active);
	sd.set("bounty_target", players[index].bounty_target);
	sd.set("bounty_online_time", players[index].bounty_online_time);
	
	// Salvar arquivo de configuração
	string charfolder = "players/" + players[index].charname;
	file arq;
	arq.open("players/" + players[index].charname + "/configs.ini", "wb");
	arq.write(serialize(sd));
	arq.close();
	
	// Resetar gerenciador de variáveis
	players[index].v_m.reset();
	
	// Salvar degradação separadamente
	players[index].save_degradation();
}
