}

// ==================== FUNÇÕES DE EQUIPE E SELEÇÃO ====================
// Estas funções são usadas por NPCs e sistemas de combate

string selecionar_jogador(string mapa) {
    string[] nomes;
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].map == mapa && !players[i].afk && players[i].pacifico != 1) {
            nomes.insert_last(players[i].charname);
        }
    }
    if(nomes.length() == 0) return "";
    return nomes[random(0, nomes.length() - 1)];
}

bool emequipe(string nome, string alvo) {
    int n = get_player_index_from(nome);
    int nb = get_player_index_from(alvo);
    if(n < 0 || nb < 0) return true;
    
    if(players[n].nomesequipe.find(alvo) > -1 || 
       players[nb].afk == true || 
       players[nb].pacifico == 1 || 
       get_safezone_at(players[nb].x, players[nb].y, players[nb].map) == true) {
        return true;
    }
    return false;
}

