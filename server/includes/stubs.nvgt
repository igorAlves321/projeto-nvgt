// ✅ IMPLEMENTADO: Função de seleção de jogador
// Seleciona um jogador válido para NPCs atacarem
// Critério pode ser: nome do mapa, "closest", "weakest", etc.
string selecionar_jogador(string criteria) {
    // Se criteria é um mapa, procurar jogador nesse mapa
    string target_map = criteria;

    // Lista de jogadores válidos
    string[] valid_players;

    for(uint i = 0; i < players.length(); i++) {
        // Verificar se jogador é válido para ataque
        bool is_valid = true;

        // Verificar mapa se critério for um mapa
        if(target_map != "" && players[i].map != target_map) {
            is_valid = false;
        }

        // Jogador em modo pacífico não é alvo
        if(players[i].pacifico == 1) {
            is_valid = false;
        }

        // Jogador em safezone não é alvo
        if(players[i].insz == true) {
            is_valid = false;
        }

        // Jogador AFK não é alvo
        if(players[i].afk == true) {
            is_valid = false;
        }

        // Jogador newbie não é alvo
        if(players[i].newbie == true) {
            is_valid = false;
        }

        if(is_valid) {
            valid_players.insert_last(players[i].charname);
        }
    }

    // Se não há jogadores válidos, retornar vazio
    if(valid_players.length() == 0) {
        return "";
    }

    // Selecionar aleatoriamente entre os jogadores válidos
    int random_index = random(0, int(valid_players.length()) - 1);
    return valid_players[random_index];
}

// ✅ IMPLEMENTADO: Sistema de Verificação de Equipe
// Verifica se dois jogadores estão na mesma equipe
bool emequipe(string player1, string player2) {
    // Buscar índices dos jogadores
    int idx1 = get_player_index_from(player1);
    int idx2 = get_player_index_from(player2);

    // Se algum jogador não existe, não estão na mesma equipe
    if(idx1 < 0 || idx2 < 0) return false;

    // Se nenhum está em equipe, retorna false
    if(players[idx1].emequipe == 0 || players[idx2].emequipe == 0) {
        return false;
    }

    // Verificar se player2 está na lista de equipe do player1
    if(players[idx1].is_team_member(player2)) {
        return true;
    }

    // Verificar se player1 está na lista de equipe do player2 (double-check)
    if(players[idx2].is_team_member(player1)) {
        return true;
    }

    return false;
}

