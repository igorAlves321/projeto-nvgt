// ✅ IMPLEMENTADO: Sistema de Fogo Contínuo (Player Fire)
// Cria fogo que causa dano contínuo ao jogador
void spawn_playerfire(int x, int y, string map, int owner_index, int damage, int duration) {
	// Verificar se há jogadores na posição
	for(uint i = 0; i < players.length(); i++) {
		// Verificar se jogador está na posição do fogo
		if(players[i].x == x && players[i].y == y && players[i].map == map) {
			// Verificar se jogador já não está pegando fogo
			bool already_burning = false;
			for(uint j = 0; j < players[i].playerfires.length(); j++) {
				if(players[i].playerfires[j].x == x && players[i].playerfires[j].y == y) {
					already_burning = true;
					break;
				}
			}
			
			if(!already_burning) {
				// Criar novo playerfire
				playerfire pf;
				pf.x = x;
				pf.y = y;
				pf.map = map;
				pf.owner = owner_index;
				pf.damage = damage;
				pf.duration = duration;
				pf.t.restart();
				pf.tt.restart();
				
				// Adicionar ao array do jogador
				players[i].playerfires.insert_last(pf);
				
				// Notificar jogador
				send_reliable(players[i].peer_id, "msg2 Você está pegando fogo! Use antídoto!", 0);
				
				// Som de fogo
				int mapindex = get_map_index_from(map);
				if(mapindex >= 0) {
					server_maps[mapindex].send_packet(0, "play fire_start.ogg " + x + " " + y, x, y);
				}
				
				debug_log("PLAYERFIRE: Jogador " + players[i].charname + " pegou fogo em " + x + "," + y);
			}
			break;
		}
	}
}

