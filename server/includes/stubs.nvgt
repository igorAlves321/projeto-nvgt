    debug_log("Transfer: " + origin + " -> " + destination + " | " + itemname + " | " + info + " | Amount: " + amount);
}

// ==================== FUNÇÕES DE NPC (Únicas aqui) ====================
void die(int npc_index) { debug_log("NPC_DIE: " + npc_index); }
void attack(int npc_index, int target_player) { debug_log("NPC_ATTACK: " + npc_index); }
void move(int npc_index, int direction) {}
bool exists_player_in_my_map(int npc_index) {
    // Compatibilidade BGT->NVGT:
    // em NVGT os NPCs ficam dentro de cada mapa (server_maps[i].npcs),
    // não em um array global `npcs`.
    if(npc_index < 0) return false;

    int flat_index = 0;
    for(uint m = 0; m < server_maps.length(); m++) {
        int npc_count = int(server_maps[m].npcs.length());
        if(npc_index < flat_index + npc_count) {
            return exists_player_in_my_map(server_maps[m].name);
        }
        flat_index += npc_count;
    }

    return false;
}
int select_player_to_attack(int npc_index) {
    if(npc_index < 0) return -1;

    int flat_index = 0;
    for(uint m = 0; m < server_maps.length(); m++) {
        int npc_count = int(server_maps[m].npcs.length());
        if(npc_index < flat_index + npc_count) {
            if(server_maps[m].mapplayers.length() == 0) return -1;
            int pick = random(0, server_maps[m].mapplayers.length() - 1);
            int player_index = server_maps[m].mapplayers[pick];
            if(player_index < 0 || player_index >= int(players.length())) return -1;
            return player_index;
        }
        flat_index += npc_count;
    }
    return -1;
}

int change_player(int npc_index, int exclude = -1) {
    if(npc_index < 0) return -1;

    int flat_index = 0;
    for(uint m = 0; m < server_maps.length(); m++) {
        int npc_count = int(server_maps[m].npcs.length());
        if(npc_index < flat_index + npc_count) {
            for(uint i = 0; i < server_maps[m].mapplayers.length(); i++) {
                int candidate = server_maps[m].mapplayers[i];
                if(candidate == exclude) continue;
                if(candidate < 0 || candidate >= int(players.length())) continue;
                if(players[candidate].health <= 0 || players[candidate].afk || players[candidate].pacifico == 1 || players[candidate].newbie) continue;
                return candidate;
            }
            return -1;
        }
        flat_index += npc_count;
    }
    return -1;
}

void change_player(int npc_index) {
    change_player(npc_index, -1);
}

bool exists_player_in_my_map(string map_name) {
    if(map_name == "") return false;
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].map != map_name) continue;
        if(players[i].afk) continue;
        if(players[i].pacifico == 1) continue;
        if(players[i].newbie) continue;
        if(players[i].health <= 0) continue;
        return true;
    }
    return false;
}

// ==================== FUNÇÕES MATEMÁTICAS (Únicas aqui) ====================
// Função de arredondamento
double round(double value) {
    return double(int(value + 0.5));
}

// Função de split customizada
string[] nvgt_split_fixed(string str, string delimiter, int max_parts) {
    string[] result;

    if(delimiter == "") {
        result.insert_last(str);
        return result;
    }

    if(max_parts <= 0) {
        return str.split(delimiter);
    }

    int start = 0;
    int pieces = 0;

    while(pieces < max_parts - 1) {
        int pos = str.find(delimiter, start);
        if(pos < 0) break;

        result.insert_last(str.substr(start, pos - start));
        start = pos + delimiter.length();
        pieces++;
    }

    result.insert_last(str.substr(start));
    return result;
}

// ==================== FUNÇÕES DE STRING (Únicas aqui) ====================
// Função trim - remover espaços em branco do início e fim
string trim(string str) {
    if(str.length() == 0) return "";

    uint start = 0;
    while(start < str.length() && (str[start] == ' ' || str[start] == '\t' || str[start] == '\r' || str[start] == '\n')) {
        start++;
    }

    if(start == str.length()) return "";

    uint end = str.length() - 1;
    while(end > start && (str[end] == ' ' || str[end] == '\t' || str[end] == '\r' || str[end] == '\n')) {
        end--;
    }

    return str.substr(start, (end - start) + 1);
}

// ==================== FUNÇÕES DE BOMBA (Únicas aqui) ====================
// Calcular distância de uma bomba até um jogador
int get_bomba_distance(maxbomba@ bomb, player@ p) {
    if(bomb.map != p.map) return -1;
    int dx = abs(bomb.x - p.x);
    int dy = abs(bomb.y - p.y);
    return int(sqrt(double(dx*dx + dy*dy)));
}

// ==================== FUNÇÕES DE INVENTÁRIO (Únicas aqui) ====================
// Remover item do inventário do jogador
bool item_take(int player_index, string item_name, int quantity) {
    if(player_index < 0 || player_index >= int(players.length())) return false;

    int current_quantity = players[player_index].inv_item_number(item_name);
    if(current_quantity < quantity) {
        debug_log("ITEM_TAKE FALHOU: " + players[player_index].charname + " não tem " + quantity + "x " + item_name + " (tem apenas " + current_quantity + ")");
        return false;
    }

    players[player_index].inv_remove_item(item_name, quantity);
    debug_log("ITEM_TAKE: " + players[player_index].charname + " removeu " + quantity + "x " + item_name);
    return true;
}

// Dar item ao jogador
bool item_give(int player_index, string item_name, int quantity) {
    if(player_index < 0 || player_index >= int(players.length())) return false;

    players[player_index].inv_add_item(item_name, quantity);
    debug_log("ITEM_GIVE: " + players[player_index].charname + " recebeu " + quantity + "x " + item_name);
    return true;
}

