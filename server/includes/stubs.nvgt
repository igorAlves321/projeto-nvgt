// ==================== VARIÁVEIS GLOBAIS (Únicas aqui) ====================
timer savetimer;
int enable_double_emeralds = 0;
int MAX_PLAYERS = 100;

// Função de mudança de nome (placeholder)
void changename(int player_index, string new_name) {
    if(player_index < 0 || player_index >= int(players.length())) return;

    player@ p = players[player_index];
    if(p is null) return;

    string old_name = p.charname;
    string target_name = new_name.trim_whitespace();

    // Limpar flags para evitar loop infinito no playerloop
    p.needs_to_change = false;
    p.validated_name = "";

    if(old_name == "" || target_name == "") {
        send_reliable_text(p.peer_id, "msg2 Nao foi possivel alterar nome: dados invalidos.", 0);
        return;
    }

    if(target_name == old_name) {
        send_reliable_text(p.peer_id, "msg2 Seu nome ja estava atualizado.", 0);
        return;
    }

    if(!is_valid_username(target_name)) {
        send_reliable_text(p.peer_id, "msg2 Nome invalido. Use apenas letras/numeros (3 a 20).", 0);
        return;
    }

    int conflict_online = get_player_index_from(target_name);
    if(conflict_online >= 0 && conflict_online != player_index) {
        send_reliable_text(p.peer_id, "msg2 Ja existe um jogador online com esse nome.", 0);
        return;
    }

    if(player_exists_in_database(target_name)) {
        send_reliable_text(p.peer_id, "msg2 Esse nome ja esta em uso.", 0);
        return;
    }

    // Atualizar nome principal na tabela players
    {
        string q = "UPDATE players SET username = ? WHERE username = ?;";
        sqlite3statement@ stmt = bancoJogo.prepare(q);
        if(stmt is null) {
            send_reliable_text(p.peer_id, "msg2 Erro ao atualizar nome no banco.", 0);
            debug_log("CHANGENAME: falha prepare players update: " + bancoJogo.get_last_error_text());
            return;
        }
        stmt.bind_text(1, target_name);
        stmt.bind_text(2, old_name);
        if(stmt.step() != SQLITE_DONE) {
            send_reliable_text(p.peer_id, "msg2 Erro ao atualizar nome no banco.", 0);
            debug_log("CHANGENAME: falha step players update: " + bancoJogo.get_last_error_text());
            return;
        }
    }

    // Atualizacoes auxiliares em tabelas relacionadas
    {
        sqlite3statement@ stmt_roles = bancoJogo.prepare("UPDATE player_roles SET username = ? WHERE username = ?;");
        if(stmt_roles !is null) {
            stmt_roles.bind_text(1, target_name);
            stmt_roles.bind_text(2, old_name);
            stmt_roles.step();
        }

        sqlite3statement@ stmt_sessions = bancoJogo.prepare("UPDATE player_sessions SET username = ? WHERE username = ?;");
        if(stmt_sessions !is null) {
            stmt_sessions.bind_text(1, target_name);
            stmt_sessions.bind_text(2, old_name);
            stmt_sessions.step();
        }

        sqlite3statement@ stmt_bans1 = bancoJogo.prepare("UPDATE server_bans SET banned_username = ? WHERE banned_username = ?;");
        if(stmt_bans1 !is null) {
            stmt_bans1.bind_text(1, target_name);
            stmt_bans1.bind_text(2, old_name);
            stmt_bans1.step();
        }

        sqlite3statement@ stmt_bans2 = bancoJogo.prepare("UPDATE server_bans SET admin_username = ? WHERE admin_username = ?;");
        if(stmt_bans2 !is null) {
            stmt_bans2.bind_text(1, target_name);
            stmt_bans2.bind_text(2, old_name);
            stmt_bans2.step();
        }
    }

    // Atualizar objeto do jogador em memoria
    p.charname = target_name;
    p.name = target_name;
    set_peer_name(p.peer_id, target_name);

    // Atualizar referencias em outros jogadores online (respostas, observacao, equipe, bounty)
    for(uint oi = 0; oi < players.length(); oi++) {
        if(players[oi] is null) continue;

        if(players[oi].replyname == old_name) {
            players[oi].replyname = target_name;
        }
        if(players[oi].w_name == old_name) {
            players[oi].w_name = target_name;
        }
        if(players[oi].bounty_owner == old_name) {
            players[oi].bounty_owner = target_name;
        }

        for(uint ni = 0; ni < players[oi].nomesequipe.length(); ni++) {
            if(players[oi].nomesequipe[ni] == old_name) {
                players[oi].nomesequipe[ni] = target_name;
            }
        }
        for(uint wi = 0; wi < players[oi].watcher_list.length(); wi++) {
            if(players[oi].watcher_list[wi] == old_name) {
                players[oi].watcher_list[wi] = target_name;
            }
        }
    }

    // Atualizar guilds ativas + indice player_guilds
    for(uint gi = 0; gi < active_guilds.length(); gi++) {
        if(active_guilds[gi] is null) continue;

        if(active_guilds[gi].leader == old_name) {
            active_guilds[gi].leader = target_name;
        }

        for(uint i = 0; i < active_guilds[gi].officers.length(); i++) {
            if(active_guilds[gi].officers[i] == old_name) {
                active_guilds[gi].officers[i] = target_name;
            }
        }
        for(uint i = 0; i < active_guilds[gi].members.length(); i++) {
            if(active_guilds[gi].members[i] == old_name) {
                active_guilds[gi].members[i] = target_name;
            }
        }

        if(active_guilds[gi].pending_invites.exists(old_name)) {
            string invite_ts = "";
            active_guilds[gi].pending_invites.get(old_name, invite_ts);
            active_guilds[gi].pending_invites.set(target_name, invite_ts);
            active_guilds[gi].pending_invites.delete(old_name);
        }
    }
    if(player_guilds.exists(old_name)) {
        string gname = string(player_guilds[old_name]);
        player_guilds.set(target_name, gname);
        player_guilds.delete(old_name);
    }
    save_guilds();

    // Atualizar parties ativas
    for(uint pi = 0; pi < active_parties.length(); pi++) {
        if(active_parties[pi] is null) continue;

        if(active_parties[pi].leader == old_name) {
            active_parties[pi].leader = target_name;
        }
        for(uint i = 0; i < active_parties[pi].members.length(); i++) {
            if(active_parties[pi].members[i] == old_name) {
                active_parties[pi].members[i] = target_name;
            }
        }
        if(active_parties[pi].pending_invites.exists(old_name)) {
            string invite_ts = "";
            active_parties[pi].pending_invites.get(old_name, invite_ts);
            active_parties[pi].pending_invites.set(target_name, invite_ts);
            active_parties[pi].pending_invites.delete(old_name);
        }
    }

    // Atualizar listas de amigos carregadas em memoria
    if(player_friends.exists(old_name)) {
        friend_list@ own_fl = cast<friend_list@>(player_friends[old_name]);
        if(own_fl !is null) {
            own_fl.owner = target_name;
            @player_friends[target_name] = @own_fl;
            player_friends.delete(old_name);
        }
    }
    string[] friend_keys = player_friends.get_keys();
    for(uint i = 0; i < friend_keys.length(); i++) {
        friend_list@ fl = cast<friend_list@>(player_friends[friend_keys[i]]);
        if(fl is null) continue;
        bool changed = false;
        for(uint f = 0; f < fl.friends.length(); f++) {
            if(fl.friends[f] == old_name) {
                fl.friends[f] = target_name;
                changed = true;
            }
        }
        if(changed) fl.save();
    }
    if(player_friends.exists(target_name)) {
        friend_list@ own_fl2 = cast<friend_list@>(player_friends[target_name]);
        if(own_fl2 !is null) own_fl2.save();
    }

    // Atualizar mailboxes carregadas em memoria
    if(player_mailboxes.exists(old_name)) {
        mailbox@ own_mb = cast<mailbox@>(player_mailboxes[old_name]);
        if(own_mb !is null) {
            own_mb.owner = target_name;
            @player_mailboxes[target_name] = @own_mb;
            player_mailboxes.delete(old_name);
        }
    }
    string[] mb_keys = player_mailboxes.get_keys();
    for(uint i = 0; i < mb_keys.length(); i++) {
        mailbox@ mb = cast<mailbox@>(player_mailboxes[mb_keys[i]]);
        if(mb is null) continue;
        bool changed = false;
        for(uint m = 0; m < mb.messages.length(); m++) {
            if(mb.messages[m].sender == old_name) {
                mb.messages[m].sender = target_name;
                changed = true;
            }
            if(mb.messages[m].recipient == old_name) {
                mb.messages[m].recipient = target_name;
                changed = true;
            }
        }
        if(changed) mb.save();
    }
    if(player_mailboxes.exists(target_name)) {
        mailbox@ own_mb2 = cast<mailbox@>(player_mailboxes[target_name]);
        if(own_mb2 !is null) own_mb2.save();
    }

    // Migrar pasta de dados legados do jogador
    string old_dir = "players/" + old_name;
    string new_dir = "players/" + target_name;
    if(directory_exists(old_dir) && !directory_exists(new_dir)) {
        debug_log("CHANGENAME: migracao automatica de pasta legada nao suportada por este runtime (" + old_dir + " -> " + new_dir + ").");
    }

    // Persistir estado atual completo do jogador com o novo username
    save_player_to_database(p);

    send_reliable_text(p.peer_id, "msg2 Nome alterado com sucesso para " + target_name + ".", 0);
    debug_log("CHANGENAME: " + old_name + " -> " + target_name);
}

// Função de informações do servidor
bool cmd_server_info(player@ player, string[] args) {
    string info = "=== SERVIDOR EVM ===\\r\\n";
    info += "Versão: NVGT Alpha\\r\\n";
    info += "Jogadores Online: " + connected_count + "/" + MAX_PLAYERS + "\\r\\n";
    info += "Uptime: " + (server_uptime.elapsed / 1000) + " segundos\\r\\n";
    send_reliable_text(player.peer_id, "say " + info);
    return true;
}

// Função de helper para propriedade status
void player_add_status_property() {}

// Função de spawn de fogo do jogador (versão alternativa)
void spawn_playerfire(int x, int y, string map_name, string owner = "") {
    if(map_name == "") return;

    string fire_owner = owner.trim_whitespace();
    if(fire_owner == "") fire_owner = "ambiente";

    for(uint i = 0; i < players.length(); i++) {
        if(players[i] is null) continue;
        if(!players[i].is_logged_in) continue;
        if(players[i].map != map_name) continue;
        if(players[i].health <= 0) continue;
        if(players[i].x != x || players[i].y != y) continue;
        if(owner != "" && players[i].charname == owner) continue;

        players[i].spawn_playerfire(fire_owner);
    }
}

// ==================== FUNÇÕES DE HISTORY (Log e Estatísticas) ====================
// Estas funções complementam ou substituem history.nvgt quando não incluído

// Estatísticas em memória
int stats_total_logins = 0;
int stats_total_registrations = 0;
int stats_total_combats = 0;
int stats_items_spawned = 0;
int stats_items_collected = 0;
int stats_messages_sent = 0;
int stats_database_queries = 0;
int stats_backup_count = 0;
const int ACTION_HISTORY_MAX = 500;
string[] action_history_lines;
string[] action_history_players;
string[] action_history_types;

void log_action(string player_name, string action_type, string action_details,
                string map_name = "", int x = 0, int y = 0, int z = 0,
                string additional_data = "", string affected_player = "", string item_name = "") {
    // Criar mensagem de log formatada
    string log_msg = "ACTION: [" + player_name + "] " + action_type + " - " + action_details;
    if(map_name != "") {
        log_msg += " @ " + map_name + " (" + x + "," + y + "," + z + ")";
    }
    if(affected_player != "") {
        log_msg += " [Target: " + affected_player + "]";
    }
    if(item_name != "") {
        log_msg += " [Item: " + item_name + "]";
    }
    if(additional_data != "") {
        log_msg += " [Extra: " + additional_data + "]";
    }
    debug_log(log_msg);
    action_history_lines.insert_last(log_msg);
    action_history_players.insert_last(player_name);
    action_history_types.insert_last(action_type);
    while(action_history_lines.length() > ACTION_HISTORY_MAX) {
        action_history_lines.remove_at(0);
        action_history_players.remove_at(0);
        action_history_types.remove_at(0);
    }
}

void update_statistics(string stat_type, int increment = 1) {
    if(stat_type == "login") {
        stats_total_logins += increment;
    }
    else if(stat_type == "registration") {
        stats_total_registrations += increment;
    }
    else if(stat_type == "combat") {
        stats_total_combats += increment;
    }
    else if(stat_type == "item_spawn") {
        stats_items_spawned += increment;
    }
    else if(stat_type == "item_collect") {
        stats_items_collected += increment;
    }
    else if(stat_type == "message") {
        stats_messages_sent += increment;
    }
    else if(stat_type == "database_query") {
        stats_database_queries += increment;
    }
    else if(stat_type == "backup") {
        stats_backup_count += increment;
    }
    debug_log("STATS: " + stat_type + " +" + increment);
}

string get_current_statistics_report() {
    string report = "=== ESTATÍSTICAS DO SERVIDOR ===\n";
    report += "Logins: " + stats_total_logins + "\n";
    report += "Registros: " + stats_total_registrations + "\n";
    report += "Combates: " + stats_total_combats + "\n";
    report += "Itens spawnados: " + stats_items_spawned + "\n";
    report += "Itens coletados: " + stats_items_collected + "\n";
    report += "Mensagens: " + stats_messages_sent + "\n";
    report += "Queries DB: " + stats_database_queries + "\n";
    report += "Backups: " + stats_backup_count + "\n";
    return report;
}

string[] get_recent_actions(int limit = 50, string action_type = "", string player_name = "") {
    string[] results;
    if(limit <= 0) limit = 1;
    string type_filter = action_type.trim_whitespace();
    string player_filter = player_name.trim_whitespace();

    for(int i = int(action_history_lines.length()) - 1; i >= 0; i--) {
        if(player_filter != "" && action_history_players[i] != player_filter) continue;
        if(type_filter != "" && action_history_types[i] != type_filter) continue;
        results.insert_last(action_history_lines[i]);
        if(int(results.length()) >= limit) break;
    }

    if(results.length() == 0) {
        results.insert_last("Nenhuma acao registrada com os filtros informados.");
    }
    return results;
}

// ==================== FUNÇÕES DE EQUIPE E SELEÇÃO ====================
// Estas funções são usadas por NPCs e sistemas de combate

string selecionar_jogador(string mapa) {
    string[] nomes;
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].map == mapa && !players[i].afk && players[i].pacifico != 1) {
            nomes.insert_last(players[i].charname);
        }
    }
    if(nomes.length() == 0) return "";
    return nomes[random(0, nomes.length() - 1)];
}

bool emequipe(string nome, string alvo) {
    int n = get_player_index_from(nome);
    int nb = get_player_index_from(alvo);
    if(n < 0 || nb < 0) return true;
    
    if(players[n].nomesequipe.find(alvo) > -1 || 
       players[nb].afk == true || 
       players[nb].pacifico == 1 || 
       get_safezone_at(players[nb].x, players[nb].y, players[nb].map) == true) {
        return true;
    }
    return false;
}

