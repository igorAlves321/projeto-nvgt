// Array para mensagens administrativas
string[] msgadm_array;

// Função de mensagem administrativa
void msgadm(string message) {
    msgadm_array.push_back(message);
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].admin_status) {
            send_reliable(players[i].peer_id, "msg [ADM] " + message);
        }
    }
}

