// ✅ IMPLEMENTADO: Sistema de Mudança de Mapa
// Baseado nos padrões encontrados em globals.nvgt:310 e admin_commands.nvgt:177
void changemap(string player_name, string new_map) {
    // Buscar índice do jogador pelo nome
    int player_index = get_player_index_from(player_name);
    if(player_index < 0) {
        debug_log("CHANGEMAP: Jogador não encontrado: " + player_name);
        return;
    }

    // Salvar mapa anterior
    string old_map = players[player_index].map;

    // Atualizar mapa do jogador
    players[player_index].map = new_map;
    players[player_index].map_name = new_map;
    players[player_index].mapaatual = new_map;

    // Notificar jogador da mudança de mapa
    send_reliable(players[player_index].peer_id, "msg2 Você foi transportado para: " + new_map, 0);

    // Log de mudança de mapa
    debug_log("CHANGEMAP: " + player_name + " mudou de " + old_map + " -> " + new_map);

    // Resetar timer de viagem de mapa
    players[player_index].maptraveltimer.restart();
}

// ✅ IMPLEMENTADO: Funções de sistema temporal (uptime do servidor)
// Baseado no timer global server_uptime (server.nvgt:99)
int ups() { return int(server_uptime.elapsed / 1000); }  // Segundos
int upm() { return ups() / 60; }                         // Minutos
int uph() { return upm() / 60; }                         // Horas
int upd() { return uph() / 24; }                         // Dias
int upw() { return upd() / 7; }                          // Semanas

