// ==================== FUNÇÕES DE HISTORY (Log e Estatísticas) ====================
// Estas funções complementam ou substituem history.nvgt quando não incluído

// Estatísticas em memória
int stats_total_logins = 0;
int stats_total_registrations = 0;
int stats_total_combats = 0;
int stats_items_spawned = 0;
int stats_items_collected = 0;
int stats_messages_sent = 0;
int stats_database_queries = 0;
int stats_backup_count = 0;

void log_action(string player_name, string action_type, string action_details,
                string map_name = "", int x = 0, int y = 0, int z = 0,
                string additional_data = "", string affected_player = "", string item_name = "") {
    // Criar mensagem de log formatada
    string log_msg = "ACTION: [" + player_name + "] " + action_type + " - " + action_details;
    if(map_name != "") {
        log_msg += " @ " + map_name + " (" + x + "," + y + "," + z + ")";
    }
    if(affected_player != "") {
        log_msg += " [Target: " + affected_player + "]";
    }
    if(item_name != "") {
        log_msg += " [Item: " + item_name + "]";
    }
    if(additional_data != "") {
        log_msg += " [Extra: " + additional_data + "]";
    }
    debug_log(log_msg);
}

void update_statistics(string stat_type, int increment = 1) {
    if(stat_type == "login") {
        stats_total_logins += increment;
    }
    else if(stat_type == "registration") {
        stats_total_registrations += increment;
    }
    else if(stat_type == "combat") {
        stats_total_combats += increment;
    }
    else if(stat_type == "item_spawn") {
        stats_items_spawned += increment;
    }
    else if(stat_type == "item_collect") {
        stats_items_collected += increment;
    }
    else if(stat_type == "message") {
        stats_messages_sent += increment;
    }
    else if(stat_type == "database_query") {
        stats_database_queries += increment;
    }
    else if(stat_type == "backup") {
        stats_backup_count += increment;
    }
    debug_log("STATS: " + stat_type + " +" + increment);
}

string get_current_statistics_report() {
    string report = "=== ESTATÍSTICAS DO SERVIDOR ===\n";
    report += "Logins: " + stats_total_logins + "\n";
    report += "Registros: " + stats_total_registrations + "\n";
    report += "Combates: " + stats_total_combats + "\n";
    report += "Itens spawnados: " + stats_items_spawned + "\n";
    report += "Itens coletados: " + stats_items_collected + "\n";
    report += "Mensagens: " + stats_messages_sent + "\n";
    report += "Queries DB: " + stats_database_queries + "\n";
    report += "Backups: " + stats_backup_count + "\n";
    return report;
}

