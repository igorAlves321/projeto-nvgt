// ==================== FUNÇÕES DE XP (Wrappers para string -> int) ====================
// NOTA: A implementação principal está em systems_advanced.nvgt (ganhaxp com int)
// Estas são apenas wrappers para chamadas com nome de jogador (string)
void ganhaxp(string player_name, int exp_amount, int gold_amount) {
    int index = get_player_index_from(player_name);
    if(index >= 0) ganhaxp(index, exp_amount, gold_amount);
}

void ganhaxp(string player_name, int exp_amount) {
    ganhaxp(player_name, exp_amount, 0);
}

// XP dobrado
void apply_doublexp(string player_name, int amount) {
    int index = get_player_index_from(player_name);
    if(index < 0) return;
    players[index].exp += amount * 2;
    players[index].xp += amount * 2;
    check_level_up(index);
    send_reliable(players[index].peer_id,
        "msg2 Você ganhou +" + (amount * 2) + " XP (Dobrado)!", 0);
    debug_log("DOUBLEXP: " + player_name + " ganhou " + (amount * 2) + " XP");
}

// ==================== FUNÇÕES DE CRÉDITOS/MOEDAS (Únicas aqui) ====================
// ge() - "give emeralds/credits" - dar créditos ao jogador
void ge(string playername, double amount) {
    int index = get_player_index_from(playername);
    if (index > -1) {
        players[index].creditos += amount;
        send_reliable(players[index].peer_id, "msg2 Você recebeu " + amount + " créditos!", 0);
        debug_log("GE: " + playername + " recebeu " + amount + " créditos");
    }
}

// gc() - "give coins/gold" - dar moedas/gold ao jogador
void gc(string playername, double amount) {
    int index = get_player_index_from(playername);
    if (index > -1) {
        players[index].inv_add_item("coins", int(amount));
        send_reliable(players[index].peer_id, "msg2 Você recebeu " + amount + " moedas!", 0);
        debug_log("GC: " + playername + " recebeu " + amount + " moedas");
    }
}

