// ==================== FUNÇÕES DE BOMBA ====================

// Calcular distância de uma bomba até um jogador
int get_bomba_distance(maxbomba@ bomb, player@ p) {
    if(bomb.map != p.map) return -1;

    int dx = abs(bomb.x - p.x);
    int dy = abs(bomb.y - p.y);

    return int(sqrt(double(dx*dx + dy*dy)));
}

// ==================== ✅ FUNÇÕES DE INVENTÁRIO IMPLEMENTADAS ====================

// ✅ IMPLEMENTADO: Remover item do inventário do jogador
bool item_take(int player_index, string item_name, int quantity) {
    if(player_index < 0 || player_index >= int(players.length())) return false;

    // Verificar se o jogador tem a quantidade necessária
    int current_quantity = players[player_index].inv_item_number(item_name);
    if(current_quantity < quantity) {
        debug_log("ITEM_TAKE FALHOU: " + players[player_index].charname + " não tem " + quantity + "x " + item_name + " (tem apenas " + current_quantity + ")");
        return false;
    }

    // Remover item usando o sistema de inventário do player
    players[player_index].inv_remove_item(item_name, quantity);

    debug_log("ITEM_TAKE: " + players[player_index].charname + " removeu " + quantity + "x " + item_name);
    return true;
}

// ✅ IMPLEMENTADO: Dar item ao jogador
bool item_give(int player_index, string item_name, int quantity) {
    if(player_index < 0 || player_index >= int(players.length())) return false;

    // Adicionar item usando o sistema de inventário do player
    players[player_index].inv_add_item(item_name, quantity);

    debug_log("ITEM_GIVE: " + players[player_index].charname + " recebeu " + quantity + "x " + item_name);
    return true;
}


