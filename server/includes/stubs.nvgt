// ==================== FUNÇÕES DE STRING (Únicas aqui) ====================
// Função trim - remover espaços em branco do início e fim
string trim(string str) {
    if(str.length() == 0) return "";

    uint start = 0;
    while(start < str.length() && (str[start] == ' ' || str[start] == '\t' || str[start] == '\r' || str[start] == '\n')) {
        start++;
    }

    if(start == str.length()) return "";

    uint end = str.length() - 1;
    while(end > start && (str[end] == ' ' || str[end] == '\t' || str[end] == '\r' || str[end] == '\n')) {
        end--;
    }

    return str.substr(start, (end - start) + 1);
}

// ==================== FUNÇÕES DE BOMBA (Únicas aqui) ====================
// Calcular distância de uma bomba até um jogador
int get_bomba_distance(maxbomba@ bomb, player@ p) {
    if(bomb.map != p.map) return -1;
    int dx = abs(bomb.x - p.x);
    int dy = abs(bomb.y - p.y);
    return int(sqrt(double(dx*dx + dy*dy)));
}

// ==================== FUNÇÕES DE INVENTÁRIO (Únicas aqui) ====================
// Remover item do inventário do jogador
bool item_take(int player_index, string item_name, int quantity) {
    if(player_index < 0 || player_index >= int(players.length())) return false;

    int current_quantity = players[player_index].inv_item_number(item_name);
    if(current_quantity < quantity) {
        debug_log("ITEM_TAKE FALHOU: " + players[player_index].charname + " não tem " + quantity + "x " + item_name + " (tem apenas " + current_quantity + ")");
        return false;
    }

    players[player_index].inv_remove_item(item_name, quantity);
    debug_log("ITEM_TAKE: " + players[player_index].charname + " removeu " + quantity + "x " + item_name);
    return true;
}

// Dar item ao jogador
bool item_give(int player_index, string item_name, int quantity) {
    if(player_index < 0 || player_index >= int(players.length())) return false;

    players[player_index].inv_add_item(item_name, quantity);
    debug_log("ITEM_GIVE: " + players[player_index].charname + " recebeu " + quantity + "x " + item_name);
    return true;
}

// ==================== FUNÇÕES DE DESCRIÇÕES (Únicas aqui) ====================
dictionary location_descriptions;
dictionary item_descriptions;

void init_descriptions() {
    item_descriptions.set("soco", "Seus punhos. Dano básico corpo a corpo.");
    item_descriptions.set("pistola", "Arma de fogo leve. Alcance médio, dano moderado.");
    item_descriptions.set("m4a1", "Rifle de assalto militar. Alta cadência de tiro.");
    item_descriptions.set("galil", "Rifle de assalto. Boa precisão e alcance.");
    item_descriptions.set("mp7", "Submetralhadora compacta. Alta taxa de disparo.");
    item_descriptions.set("bazuca", "Lançador de mísseis. Dano em área devastador.");
    item_descriptions.set("espada", "Arma branca corpo a corpo. Dano elevado.");
    item_descriptions.set("escudo", "Escudo de proteção. Reduz dano recebido.");
    item_descriptions.set("coins", "Moeda do servidor. Use para comprar itens.");
    item_descriptions.set("reais", "Moeda alternativa. Valor comercial.");
    item_descriptions.set("colete_aprova_de_balas", "Colete balístico militar. Proteção: 40%");
    item_descriptions.set("colete_militar", "Colete tático. Proteção: 35%");
    item_descriptions.set("capacete_policia", "Capacete policial. Proteção de cabeça: 15%");
    item_descriptions.set("coturno_militar", "Botas militares reforçadas. Proteção: 20%");
    item_descriptions.set("kit_medico", "Kit de primeiros socorros. Restaura saúde.");
    item_descriptions.set("comida", "Alimento básico. Restaura fome.");
    item_descriptions.set("agua", "Água potável. Restaura sede.");
    item_descriptions.set("ferro", "Barra de ferro. Material de construção.");
    item_descriptions.set("madeira", "Tábua de madeira. Material básico.");
    item_descriptions.set("ouro", "Lingote de ouro. Material valioso.");
    debug_log("Sistema de descrições inicializado com " + item_descriptions.get_size() + " itens");
}

string getdesc(string map, int x, int y) {
    string key = map + "_" + x + "_" + y;
    string desc = "";
    if(location_descriptions.get(key, desc)) {
        return desc;
    }
    return "Localização: " + map + " (" + x + ", " + y + ")";
}

string getdesc(string item_name) {
    string desc = "";
    if(item_descriptions.get(item_name, desc)) {
        return desc;
    }
    return "Item: " + item_name;
}

