// crafting.nvgt - Sistema de Crafting
// Fluxo seguro com inventory_sync (anti-dupe)

class crafting {
	dictionary recipes; // result_item -> "ingredient:qty,ingredient:qty|description|result_qty"

	crafting() {}

	void load_default_recipes() {
		add_recipe("espada_de_ferro", "ferro:3,madeira:1", "Espada de ferro basica", 1);
		add_recipe("arco", "madeira:2,corda:1", "Arco simples", 1);
		add_recipe("flecha", "madeira:1,pedra:1", "Flechas", 10);
		add_recipe("escudo_de_madeira", "madeira:4", "Escudo basico de madeira", 1);
		add_recipe("colete", "couro:5,linha:2", "Colete de protecao", 1);

		add_recipe("espada_de_ouro", "ouro:5,madeira:1", "Espada de ouro", 1);
		add_recipe("armadura_de_ferro", "ferro:8,couro:2", "Armadura completa de ferro", 1);
		add_recipe("machado_de_ferro", "ferro:3,madeira:2", "Machado de ferro", 1);
		add_recipe("picareta_de_ferro", "ferro:3,madeira:2", "Picareta de ferro", 1);

		add_recipe("espada_laser", "cristal:3,bateria:1,circuito:2", "Espada de energia", 1);
		add_recipe("pistola_laser", "cristal:2,bateria:2,metal:3", "Pistola de energia", 1);
		add_recipe("armadura_quantum", "nanotecnologia:5,bateria:3,blindagem:4", "Armadura avancada", 1);

		add_recipe("kit_medico", "bandagem:3,antidoto:1,remedio:1", "Kit de primeiros socorros", 1);
		add_recipe("antidoto", "erva_medicinal:2,agua:1", "Antidoto para venenos", 1);
		add_recipe("comida_cozida", "carne:1,lenha:1", "Comida preparada", 5);
		add_recipe("pocao_de_vida", "erva_vermelha:2,cristal_pequeno:1,agua:1", "Restaura vida", 1);

		add_recipe("teleporter", "cristal:2,circuito:1", "Teleportador de uso unico", 1);
		add_recipe("mina", "polvora:2,metal:1,detonador:1", "Mina explosiva", 1);
		add_recipe("bomba", "polvora:3,metal:2,timer:1", "Bomba temporizada", 1);

		debug_log("CRAFTING: Carregadas " + recipes.get_size() + " receitas padrao");
	}

	void add_recipe(string result_item, string ingredients, string description = "", int result_quantity = 1) {
		string recipe_data = ingredients + "|" + description + "|" + result_quantity;
		recipes.set(result_item, recipe_data);
	}

	bool get_recipe_data(string item_name, string &out ingredients_str, string &out description, int &out result_quantity) {
		string recipe_data = "";
		if(!recipes.get(item_name, recipe_data)) return false;

		string[] recipe_parts = recipe_data.split("|");
		if(recipe_parts.length() < 1) return false;

		ingredients_str = recipe_parts[0];
		description = recipe_parts.length() > 1 ? recipe_parts[1] : item_name;
		result_quantity = recipe_parts.length() > 2 ? string_to_number(recipe_parts[2]) : 1;
		if(result_quantity <= 0) result_quantity = 1;
		return true;
	}

	bool can_craft(int player_index, string item_name) {
		if(player_index < 0 || player_index >= int(players.length())) return false;
		if(!recipes.exists(item_name)) return false;

		string ingredients_str = "";
		string description = "";
		int result_quantity = 1;
		if(!get_recipe_data(item_name, ingredients_str, description, result_quantity)) return false;

		string[] ingredients = ingredients_str.split(",");
		for(uint i = 0; i < ingredients.length(); i++) {
			string[] item_data = ingredients[i].split(":");
			if(item_data.length() < 2) continue;

			string ingredient_name = item_data[0].trim_whitespace();
			int required_quantity = string_to_number(item_data[1]);
			if(required_quantity <= 0) continue;

			if(players[player_index].inv_item_number(ingredient_name) < required_quantity) {
				return false;
			}
		}

		return true;
	}

	bool craft(int player_index, string item_name) {
		if(player_index < 0 || player_index >= int(players.length())) return false;
		player@ p = players[player_index];

		string ingredients_str = "";
		string description = "";
		int result_quantity = 1;
		if(!get_recipe_data(item_name, ingredients_str, description, result_quantity)) {
			send_reliable_text(p.peer_id, "msg2 Receita não encontrada.", 0);
			return false;
		}

		if(!can_craft(player_index, item_name)) {
			send_reliable_text(p.peer_id, "msg2 Você não tem os ingredientes necessarios!", 0);
			return false;
		}

		// Guarda ingredientes validados para remocao segura
		string[] ingredients = ingredients_str.split(",");
		string[] names;
		int[] qtys;
		for(uint i = 0; i < ingredients.length(); i++) {
			string[] item_data = ingredients[i].split(":");
			if(item_data.length() < 2) continue;
			string ingredient_name = item_data[0].trim_whitespace();
			int required_quantity = string_to_number(item_data[1]);
			if(ingredient_name == "" || required_quantity <= 0) continue;
			names.insert_last(ingredient_name);
			qtys.insert_last(required_quantity);
		}

		// Remocao anti-dupe
		for(uint i = 0; i < names.length(); i++) {
			if(!remove_item_with_sync(p, names[i], qtys[i])) {
				send_reliable_text(p.peer_id, "msg2 Falha ao remover ingredientes. Craft cancelado.", 0);
				return false;
			}
		}

		// Entrega do item resultado
		if(!add_item_with_sync(p, item_name, result_quantity)) {
			send_reliable_text(p.peer_id, "msg2 Falha ao entregar item criado. Contate um admin.", 0);
			return false;
		}

		server_stats.register_craft(p.charname, item_name);
		send_reliable_text(p.peer_id, "msg2 Você criou: " + description + " x" + result_quantity, 0);

		int mapindex = p.mapindex;
		if(mapindex >= 0) {
			server_maps[mapindex].send_packet(0, "play craft.ogg " + p.x + " " + p.y, p.x, p.y);
		}

		debug_log("CRAFTING: " + p.charname + " criou " + item_name + " x" + result_quantity);
		return true;
	}

	string[] get_craftable_items(int player_index) {
		string[] craftable_items;
		string[] all_recipes = recipes.get_keys();
		for(uint i = 0; i < all_recipes.length(); i++) {
			if(can_craft(player_index, all_recipes[i])) craftable_items.insert_last(all_recipes[i]);
		}
		return craftable_items;
	}

	string list_all_recipes() {
		string[] all_recipes = recipes.get_keys();
		string result = "=== RECEITAS DISPONIVEIS (" + all_recipes.length() + ") ===\n";
		for(uint i = 0; i < all_recipes.length(); i++) {
			string ingredients_str = "";
			string description = "";
			int result_quantity = 1;
			if(get_recipe_data(all_recipes[i], ingredients_str, description, result_quantity)) {
				result += "\n" + all_recipes[i] + ": " + ingredients_str;
				if(description != "") result += " (" + description + ")";
				if(result_quantity > 1) result += " => x" + result_quantity;
			}
		}
		return result;
	}

	string show_recipe(string item_name) {
		string ingredients_str = "";
		string description = "";
		int quantity = 1;
		if(!get_recipe_data(item_name, ingredients_str, description, quantity)) {
			return "Receita não encontrada: " + item_name;
		}

		string[] ingredients = ingredients_str.split(",");
		string result = "=== RECEITA: " + item_name + " ===\n";
		if(description != "") result += description + "\n";
		result += "Resultado: " + quantity + "x " + item_name + "\n";
		result += "Ingredientes necessarios:\n";

		for(uint i = 0; i < ingredients.length(); i++) {
			string[] item_data = ingredients[i].split(":");
			if(item_data.length() >= 2) {
				result += " - " + item_data[1] + "x " + item_data[0] + "\n";
			}
		}

		return result;
	}
}

crafting crafting_system;

void init_crafting_system() {
	crafting_system.recipes.delete_all();
	crafting_system.load_default_recipes();
}

