
class weapon {
	string name;
	string ammo;
	string sound_shoot;
	string sound_impact;
	string sound_draw;
	string sound_reload;
	double damage;
	double distance;
	double ammo_total;
	double ammo_cantity;
	double speed;
	double speed_burst;
	double speed_loading;
	int require_ammo;
	int enable_burst;
	int is_dropable;
	string sound_impact_on_corpse;
	string sound_unload;
	string sound_mode1;
	string sound_mode2;
	double ammo_cantity_descount;
	string sound_shoot_dist;
	double degradation_point;

	string[] sounds_impact;
	string[] sounds_impact_on_corpse;

	weapon() {
		name = "";
		ammo = "";
		sound_shoot = "";
		sound_impact = "";
		sound_draw = "";
		sound_reload = "";
		damage = 50;
		distance = 500;
		ammo_total = 100;
		ammo_cantity = 30;
		speed = 1000;
		speed_burst = 100;
		speed_loading = 2000;
		require_ammo = 1;
		enable_burst = 0;
		is_dropable = 1;
		sound_impact_on_corpse = "";
		sound_unload = "";
		sound_mode1 = "";
		sound_mode2 = "";
		ammo_cantity_descount = 1;
		sound_shoot_dist = "";
		degradation_point = 1;
	}

	weapon(string[] data) {
		if(data.length() < 23) {
			debug_log("WEAPON ERROR: Dados insuficientes para criar arma. Esperado 23, recebido " + data.length());
			weapon();
			return;
		}

		name = data[0];
		ammo = data[1];
		sound_shoot = data[2];
		sound_impact = data[3];
		sound_draw = data[4];
		sound_reload = data[5];
		damage = string_to_number(data[6]);
		distance = string_to_number(data[7]);
		ammo_total = string_to_number(data[8]);
		ammo_cantity = string_to_number(data[9]);
		speed = string_to_number(data[10]);
		speed_burst = string_to_number(data[11]);
		speed_loading = string_to_number(data[12]);
		require_ammo = string_to_number(data[13]);
		enable_burst = string_to_number(data[14]);
		is_dropable = string_to_number(data[15]);
		sound_impact_on_corpse = data[16];
		sound_unload = data[17];
		sound_mode1 = data[18];
		sound_mode2 = data[19];
		ammo_cantity_descount = string_to_number(data[20]);
		sound_shoot_dist = data[21];
		degradation_point = string_to_number(data[22]);

		if(sound_impact != "") {
			sounds_impact = sound_impact.split(",");
		}

		if(sound_impact_on_corpse != "") {
			sounds_impact_on_corpse = sound_impact_on_corpse.split(",");
		}

		debug_log("WEAPON: Arma '" + name + "' carregada - Dano: " + damage + ", Alcance: " + distance);
	}

	string get_random_impact_sound() {
		if(sounds_impact.length() == 0) return "rico1";
		return sounds_impact[random(0, sounds_impact.length() - 1)];
	}

	string get_random_corpse_impact_sound() {
		if(sounds_impact_on_corpse.length() == 0) return "body1";
		return sounds_impact_on_corpse[random(0, sounds_impact_on_corpse.length() - 1)];
	}
}

weapon@[] weapons_list;

const string WEAPONS_COLUMNS = "name, ammo, sound_shoot, sound_impact, sound_draw, sound_reload, damage, distance, ammo_total, ammo_cantity, speed, speed_burst, speed_loading, require_ammo, enable_burst, is_dropable, sound_impact_on_corpse, sound_unload, sound_mode1, sound_mode2, ammo_cantity_descount, sound_shoot_dist, degradation_point";

void create_weapons_table() {
	if(!database_initialized || bancoJogo is null) return;

	string create_weapons = """
		CREATE TABLE IF NOT EXISTS weapons (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			name TEXT UNIQUE NOT NULL,
			ammo TEXT DEFAULT '',
			sound_shoot TEXT DEFAULT '',
			sound_impact TEXT DEFAULT '',
			sound_draw TEXT DEFAULT '',
			sound_reload TEXT DEFAULT '',
			damage REAL DEFAULT 50,
			distance REAL DEFAULT 500,
			ammo_total REAL DEFAULT 100,
			ammo_cantity REAL DEFAULT 30,
			speed REAL DEFAULT 1000,
			speed_burst REAL DEFAULT 100,
			speed_loading REAL DEFAULT 2000,
			require_ammo INTEGER DEFAULT 1,
			enable_burst INTEGER DEFAULT 0,
			is_dropable INTEGER DEFAULT 1,
			sound_impact_on_corpse TEXT DEFAULT '',
			sound_unload TEXT DEFAULT '',
			sound_mode1 TEXT DEFAULT '',
			sound_mode2 TEXT DEFAULT '',
			ammo_cantity_descount REAL DEFAULT 1,
			sound_shoot_dist TEXT DEFAULT '',
			degradation_point REAL DEFAULT 1,
			created_at DATETIME DEFAULT CURRENT_TIMESTAMP
		);
	""";

	if(bancoJogo.execute(create_weapons) != SQLITE_OK) {
		debug_log("ERRO ao criar tabela weapons: " + bancoJogo.get_last_error_text());
	}
}

int count_weapons_in_database() {
	if(!database_initialized || bancoJogo is null) return 0;

	sqlite3statement@ stmt = bancoJogo.prepare("SELECT COUNT(*) FROM weapons;");
	if(@stmt == null) return 0;
	if(stmt.step() == SQLITE_ROW) return stmt.column_int(0);
	return 0;
}

bool weapon_exists_in_database(string weapon_name) {
	if(!database_initialized || bancoJogo is null) return false;

	sqlite3statement@ stmt = bancoJogo.prepare("SELECT id FROM weapons WHERE name = ? LIMIT 1;");
	if(@stmt == null) return false;
	stmt.bind_text(1, weapon_name);
	return stmt.step() == SQLITE_ROW;
}

bool save_weapon_to_database(weapon@ w) {
	if(!database_initialized || bancoJogo is null) return false;
	if(@w == null || w.name == "") return false;
	if(weapon_exists_in_database(w.name)) return false;

	string query = "INSERT OR IGNORE INTO weapons (" + WEAPONS_COLUMNS + ") VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);";
	sqlite3statement@ stmt = bancoJogo.prepare(query);
	if(@stmt == null) {
		debug_log("ERRO ao preparar insercao de arma: " + bancoJogo.get_last_error_text());
		return false;
	}

	stmt.bind_text(1, w.name);
	stmt.bind_text(2, w.ammo);
	stmt.bind_text(3, w.sound_shoot);
	stmt.bind_text(4, w.sound_impact);
	stmt.bind_text(5, w.sound_draw);
	stmt.bind_text(6, w.sound_reload);
	stmt.bind_double(7, w.damage);
	stmt.bind_double(8, w.distance);
	stmt.bind_double(9, w.ammo_total);
	stmt.bind_double(10, w.ammo_cantity);
	stmt.bind_double(11, w.speed);
	stmt.bind_double(12, w.speed_burst);
	stmt.bind_double(13, w.speed_loading);
	stmt.bind_int(14, w.require_ammo);
	stmt.bind_int(15, w.enable_burst);
	stmt.bind_int(16, w.is_dropable);
	stmt.bind_text(17, w.sound_impact_on_corpse);
	stmt.bind_text(18, w.sound_unload);
	stmt.bind_text(19, w.sound_mode1);
	stmt.bind_text(20, w.sound_mode2);
	stmt.bind_double(21, w.ammo_cantity_descount);
	stmt.bind_text(22, w.sound_shoot_dist);
	stmt.bind_double(23, w.degradation_point);

	if(stmt.step() != SQLITE_DONE) {
		debug_log("ERRO ao inserir arma " + w.name + ": " + bancoJogo.get_last_error_text());
		return false;
	}
	return true;
}

weapon@ weapon_from_line(string line) {
	line = line.trim_whitespace();
	if(line == "" || line.find("//") == 0) return null;

	string[] parts = line.split("=");
	if(parts.length() < 23) return null;

	parts[0] = parts[0].trim_whitespace();
	parts[1] = parts[1].trim_whitespace();
	if(parts[0] == "") return null;

	weapon@ w = weapon(parts);
	return w;
}

int save_weapon_lines_to_database(string[]@ lines) {
	int saved = 0;
	for(uint i = 0; i < lines.length(); i++) {
		weapon@ w = weapon_from_line(lines[i]);
		if(@w == null) continue;
		if(save_weapon_to_database(w)) saved++;
	}
	return saved;
}

void import_legacy_weapons_file(string filename) {
	if(!database_initialized || bancoJogo is null) return;
	if(!file_exists(filename)) return;

	file f;
	if(!f.open(filename, "rb")) {
		debug_log("WEAPONS: não foi possível abrir " + filename + " para migração");
		return;
	}
	string content = f.read();
	f.close();

	string[] lines = content.replace("\r\n", "\n").split("\n");
	int imported = save_weapon_lines_to_database(lines);

	debug_log("WEAPONS MIGRACAO: " + imported + " armas importadas de " + filename);

	file_copy(filename, filename + ".migrado", true);
	file_delete(filename);
}

