void init_weapons_database() {
	if(!database_initialized || bancoJogo is null) return;

	create_weapons_table();
	import_legacy_weapons_file("weapons_list.db");
	import_legacy_weapons_file("weapons.db");
	seed_default_weapons();
}

void load_weapons() {
	debug_log("Carregando armas do banco de dados...");

	weapons_list.resize(0);

	if(!database_initialized || bancoJogo is null) {
		debug_log("ERRO: load_weapons - banco de dados não inicializado");
		return;
	}

	init_weapons_database();

	sqlite3statement@ stmt = bancoJogo.prepare("SELECT " + WEAPONS_COLUMNS + " FROM weapons ORDER BY id;");
	if(@stmt == null) {
		debug_log("ERRO ao preparar query de armas: " + bancoJogo.get_last_error_text());
		return;
	}

	while(stmt.step() == SQLITE_ROW) {
		weapon@ w = weapon();
		w.name = stmt.column_text(0);
		w.ammo = stmt.column_text(1);
		w.sound_shoot = stmt.column_text(2);
		w.sound_impact = stmt.column_text(3);
		w.sound_draw = stmt.column_text(4);
		w.sound_reload = stmt.column_text(5);
		w.damage = stmt.column_double(6);
		w.distance = stmt.column_double(7);
		w.ammo_total = stmt.column_double(8);
		w.ammo_cantity = stmt.column_double(9);
		w.speed = stmt.column_double(10);
		w.speed_burst = stmt.column_double(11);
		w.speed_loading = stmt.column_double(12);
		w.require_ammo = stmt.column_int(13);
		w.enable_burst = stmt.column_int(14);
		w.is_dropable = stmt.column_int(15);
		w.sound_impact_on_corpse = stmt.column_text(16);
		w.sound_unload = stmt.column_text(17);
		w.sound_mode1 = stmt.column_text(18);
		w.sound_mode2 = stmt.column_text(19);
		w.ammo_cantity_descount = stmt.column_double(20);
		w.sound_shoot_dist = stmt.column_text(21);
		w.degradation_point = stmt.column_double(22);

		if(w.sound_impact != "") {
			w.sounds_impact = w.sound_impact.split(",");
		}
		if(w.sound_impact_on_corpse != "") {
			w.sounds_impact_on_corpse = w.sound_impact_on_corpse.split(",");
		}

		weapons_list.insert_last(w);
	}

	debug_log("WEAPONS: " + weapons_list.length() + " armas carregadas do banco de dados");
}

weapon@ get_weapon_by_name(string weapon_name) {
	for(uint i = 0; i < weapons_list.length(); i++) {
		if(weapons_list[i].name == weapon_name) {
			return weapons_list[i];
		}
	}
	return null;
}

int get_weapon_index(string weapon_name) {
	for(uint i = 0; i < weapons_list.length(); i++) {
		if(weapons_list[i].name == weapon_name) {
			return i;
		}
	}
	return -1;
}

bool is_valid_weapon_index(int weapon_index) {
	return (weapon_index >= 0 && weapon_index < int(weapons_list.length()));
}

int calculate_weapon_damage(int weapon_index) {
	int w = weapon_index - 1;

	if(!is_valid_weapon_index(w)) {
		debug_log("WEAPON: Índice inválido " + weapon_index + ", usando dano padrão");
		return 50;
	}

	return int(weapons_list[w].damage);
}

string get_weapon_wall_impact_sound(int weapon_index) {
	int w = weapon_index - 1;

	if(!is_valid_weapon_index(w)) {
		return "rico1";
	}

	return weapons_list[w].get_random_impact_sound();
}

string get_weapon_body_impact_sound(int weapon_index) {
	int w = weapon_index - 1;

	if(!is_valid_weapon_index(w)) {
		return "body1";
	}

	return weapons_list[w].get_random_corpse_impact_sound();
}

double get_weapon_distance(int weapon_index) {
	int w = weapon_index - 1;

	if(!is_valid_weapon_index(w)) {
		return 500.0;
	}

	return weapons_list[w].distance;
}

bool weapon_requires_ammo(int weapon_index) {
	int w = weapon_index - 1;

	if(!is_valid_weapon_index(w)) {
		return true;
	}

	return (weapons_list[w].require_ammo == 1);
}

string get_weapon_ammo_name(int weapon_index) {
	int w = weapon_index - 1;

	if(!is_valid_weapon_index(w)) {
		return "9mm";
	}

	return weapons_list[w].ammo;
}

void list_all_weapons() {
	debug_log("=== ARMAS CARREGADAS (" + weapons_list.length() + ") ===");

	for(uint i = 0; i < weapons_list.length(); i++) {
		debug_log(i + ": " + weapons_list[i].name +
			" (Dano: " + weapons_list[i].damage +
			", Alcance: " + weapons_list[i].distance +
			", Munição: " + weapons_list[i].ammo + ")");
	}
}

string get_weapon_info(int weapon_index) {
	int w = weapon_index - 1;

	if(!is_valid_weapon_index(w)) {
		return "Arma não encontrada (índice " + weapon_index + ")";
	}

	weapon@ wpn = weapons_list[w];

	string info = "=== " + wpn.name + " ===\n";
	info += "Munição: " + wpn.ammo + "\n";
	info += "Dano: " + wpn.damage + "\n";
	info += "Alcance: " + wpn.distance + "\n";
	info += "Velocidade (semi): " + wpn.speed + "ms\n";
	info += "Velocidade (auto): " + wpn.speed_burst + "ms\n";
	info += "Tempo de recarga: " + wpn.speed_loading + "ms\n";
	info += "Modo automático: " + (wpn.enable_burst == 1 ? "Sim" : "Não") + "\n";
	info += "Requer munição: " + (wpn.require_ammo == 1 ? "Sim" : "Não") + "\n";
	info += "Sons de impacto (parede): " + wpn.sounds_impact.length() + "\n";
	info += "Sons de impacto (corpo): " + wpn.sounds_impact_on_corpse.length() + "\n";
	info += "Degradação: " + wpn.degradation_point + "\n";

	return info;
}
