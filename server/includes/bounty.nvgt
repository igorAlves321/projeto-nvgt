// bounty.nvgt - Sistema de Recompensas (Bounty)
// Mini-Task 16 - Versao NVGT com anuncios globais e pagamento automatico

const int BOUNTY_SYSTEM_MIN_VALUE = 100;

bool set_bounty(int target_index, int setter_index, int value) {
	if(target_index < 0 || target_index >= int(players.length())) return false;
	if(setter_index < 0 || setter_index >= int(players.length())) return false;

	player@ target = @players[target_index];
	player@ setter = @players[setter_index];
	if(target is null || setter is null) return false;

	if(target_index == setter_index) {
		send_reliable_text(setter.peer_id, "say [SISTEMA] Voce nao pode colocar recompensa na propria cabeca!", 0);
		return false;
	}
	if(target.pacifico == 1) {
		send_reliable_text(setter.peer_id, "say [SISTEMA] O alvo esta em modo pacifico.", 0);
		return false;
	}
	if(target.afk) {
		send_reliable_text(setter.peer_id, "say [SISTEMA] O alvo esta ausente no momento.", 0);
		return false;
	}
	if(target.newbie) {
		send_reliable_text(setter.peer_id, "say [SISTEMA] O alvo e novato e nao pode receber recompensa.", 0);
		return false;
	}
	if(value < BOUNTY_SYSTEM_MIN_VALUE) {
		send_reliable_text(setter.peer_id, "say [SISTEMA] O valor minimo da recompensa e " + BOUNTY_SYSTEM_MIN_VALUE + " moedas.", 0);
		return false;
	}
	if(setter.gold < value) {
		send_reliable_text(setter.peer_id, "say [SISTEMA] Voce nao tem ouro suficiente.", 0);
		return false;
	}

	setter.gold -= value;
	setter.saldo = setter.gold;

	if(target.bounty_on_head == 1) {
		target.bounty_value += value;
	} else {
		target.bounty_on_head = 1;
		target.bounty_value = value;
		target.bounty_active = 1;
		target.bounty_online_time = 0;
	}
	target.bounty_owner = setter.charname;
	setter.bounty_target = target.charname;

	settitle(target_index);

	server_broadcast("say [CACADA] " + setter.charname + " colocou uma recompensa de " + value + " moedas pela cabeca de " + target.charname + "!");
	server_broadcast("ps alarm.ogg");

	return true;
}

bool remove_bounty(int target_index) {
	if(target_index < 0 || target_index >= int(players.length())) return false;
	player@ target = @players[target_index];
	if(target is null) return false;
	if(target.bounty_on_head == 0) return false;

	target.bounty_on_head = 0;
	target.bounty_value = 0;
	target.bounty_owner = "";
	target.bounty_active = 0;
	target.bounty_online_time = 0;

	settitle(target_index);
	return true;
}

void process_bounty_kill(int killer_index, int victim_index) {
	if(killer_index < 0 || killer_index >= int(players.length())) return;
	if(victim_index < 0 || victim_index >= int(players.length())) return;

	player@ killer = @players[killer_index];
	player@ victim = @players[victim_index];
	if(killer is null || victim is null) return;

	if(victim.bounty_on_head != 1 || victim.bounty_active != 1) return;
	if(victim.bounty_value <= 0) return;

	int reward = victim.bounty_value;
	killer.gold += reward;
	killer.saldo = killer.gold;

	remove_bounty(victim_index);

	server_broadcast("say [CACADA CONCLUIDA] " + killer.charname + " eliminou o procurado " + victim.charname + " e recebeu " + reward + " moedas!");
	send_reliable_text(killer.peer_id, "ps trade_success.ogg", 0);
}

bool has_bounty(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) return false;
	return players[player_index].bounty_on_head == 1;
}

int get_bounty_value(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) return 0;
	return players[player_index].bounty_value;
}

string get_bounty_info(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) return "Jogador invalido";
	if(players[player_index].bounty_on_head == 0) {
		return players[player_index].charname + " nao tem recompensa na cabeca.";
	}

	string info = players[player_index].charname + " tem recompensa de " + players[player_index].bounty_value + " moedas";
	if(players[player_index].bounty_owner != "") info += " colocada por " + players[player_index].bounty_owner;
	return info;
}

string[] list_all_bounties() {
	string[] bounty_list;
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].bounty_on_head == 1) {
			string entry = players[i].charname + ": " + players[i].bounty_value + " moedas";
			if(players[i].bounty_owner != "") entry += " (por " + players[i].bounty_owner + ")";
			bounty_list.insert_last(entry);
		}
	}
	return bounty_list;
}

void update_bounty_online_time(int player_index, int seconds) {
	if(player_index < 0 || player_index >= int(players.length())) return;
	if(players[player_index].bounty_on_head == 1) players[player_index].bounty_online_time += seconds;
}

bool cancel_bounty(int canceller_index, string target_name) {
	if(canceller_index < 0 || canceller_index >= int(players.length())) return false;
	if(players[canceller_index].bounty_target != target_name) return false;

	int target_index = get_player_index_from(target_name);
	if(target_index == -1) return false;
	if(players[target_index].bounty_owner != players[canceller_index].charname) return false;

	int refund = players[target_index].bounty_value / 2;
	players[canceller_index].gold += refund;
	players[canceller_index].saldo = players[canceller_index].gold;

	remove_bounty(target_index);
	players[canceller_index].bounty_target = "";
	return true;
}
