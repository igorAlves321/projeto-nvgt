bool cmd_lc(player@ player, string[] args) {
    string sufixo_sujo = (player.sexo == 0) ? "o" : "a";
    string sufixo_cansado = (player.sexo == 0) ? "o" : "a";
    string sufixo_bebado = (player.sexo == 0) ? "o" : "a";
    string sufixo_doente = "";
    debug_log("DEBUG SEXO: " + player.charname + " sexo=" + player.sexo + " sufixo=" + sufixo_sujo);
    string patente = "";
    if(has_role(player.charname, "dev")) {
        patente = "Desenvolvedor";
    } else if(has_role(player.charname, "admin")) {
        patente = "Administrador";
    } else if(has_role(player.charname, "moderator")) {
        patente = "Moderador";
    } else if(has_role(player.charname, "builder")) {
        patente = "Construtor";
    } else if(has_role(player.charname, "translator")) {
        patente = "Tradutor";
    } else if(player.title != "" && player.title.length() > 0) {
        patente = player.title;
    } else {
        patente = "Iniciante";
    }
    string msg = "Voce esta no nivel " + int(player.level);
    if(player.reencarnou > 0) {
        msg += ", no remorte " + player.reencarnou;
    }
    msg += " e na patente " + patente + ". ";
    msg += "Vocesta com ";
    string[] stats;
    stats.insert_last(round(player.nsede, 0) + "% de sede");
    stats.insert_last(round(player.nfome, 0) + "% de fome");
    int cansaco = 100 - player.stamina;
    if(cansaco < 0) cansaco = 0;
    stats.insert_last(cansaco + "% cansad" + sufixo_cansado);
    if(player.caverna > 0) {
        stats.insert_last(player.caverna + "% bebad" + sufixo_bebado);
    }
    stats.insert_last(round(player.sujo, 0) + "% suj" + sufixo_sujo);
    stats.insert_last(round(player.doente, 0) + "% doente");
    for(uint i = 0; i < stats.length(); i++) {
        if(i == stats.length() - 1 && i > 0) {
            msg += " e " + stats[i];
        } else if(i > 0) {
            msg += ", " + stats[i];
        } else {
            msg += stats[i];
        }
    }
    msg += ".";
    if(player.creditos > 0) {
        msg += " Voce tem " + int(player.creditos) + " creditos de reserva.";
    }
    player.send_message("msg2 " + msg);
    debug_log("[V-KEY] " + player.charname + " verificou status: nivel=" + int(player.level) + " patente=" + patente);
    return true;
}

bool cmd_checktime(player@ player, string[] args) {
    if(player.relogio == 0) {
        player.send_message("say Voce precisa de um relogio para ver as horas.");
        debug_log("[H-KEY] " + player.charname + " tentou ver hora sem relogio");
        return false;
    }
    int hora_atual = TIME_HOUR;
    int minuto_atual = TIME_MINUTE;
    string hora = hora_atual < 10 ? "0" + hora_atual : "" + hora_atual;
    string minuto = minuto_atual < 10 ? "0" + minuto_atual : "" + minuto_atual;
    player.send_message("say Sao " + hora + " horas e " + minuto + " minutos.");
    debug_log("[H-KEY] " + player.charname + " verificou hora: " + hora + ":" + minuto);
    return true;
}

bool cmd_falarnomapa(player@ player, string[] args) {
    if(args.length() == 0) {
        player.send_message("say Uso: /falarnomapa <mensagem>");
        return false;
    }
    string message = join(args, " ");
    int player_index = get_player_index_from(player.charname);
    if(player_index >= 0) {
        telllocal(player_index, message);
    }
    return true;
}
