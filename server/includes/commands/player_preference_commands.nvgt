bool cmd_setvoice(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: setvoice <voz>");
        return false;
    }
    player.voice_id = args[0];
    save_player_to_database(player);
    debug_log("Jogador " + player.name + " configurou voz: " + args[0]);
    return true;
}

bool cmd_hits(player@ player, string[] args) {
    player.ouvirhits = !player.ouvirhits;
    save_player_to_database(player);
    string status = player.ouvirhits ? "ativados" : "desativados";
    player.send_message("say Sons de impacto " + status);
    return true;
}

bool cmd_idiomachat(player@ player, string[] args) {
    if(args.length() < 1) {
        player.send_message("say Uso: idiomachat <idioma>");
        return false;
    }
    player.idiomachat = args[0];
    save_player_to_database(player);
    player.send_message("say Idioma do chat configurado: " + args[0]);
    return true;
}

bool cmd_dpassos(player@ player, string[] args) {
    player.ouvirpassos = (player.ouvirpassos == 0) ? 1 : 0;
    save_player_to_database(player);
    string status = (player.ouvirpassos == 0) ? "desativados" : "ativados";
    player.send_message("say Sons de passos " + status);
    return true;
}

bool cmd_ndor(player@ player, string[] args) {
    player.mdor = (player.mdor == 0) ? 1 : 0;
    save_player_to_database(player);
    string status = (player.mdor == 0) ? "ativadas" : "desativadas";
    player.send_message("say Mensagens de dor " + status);
    return true;
}

bool cmd_nnivel(player@ player, string[] args) {
    player.avisanivel = (player.avisanivel == 0) ? 1 : 0;
    save_player_to_database(player);
    string status = (player.avisanivel == 0) ? "ativados" : "desativados";
    player.send_message("say Avisos de nivel " + status);
    return true;
}

bool cmd_getversion(player@ player, string[] args) {
    player.send_message("version " + server_version);
    return true;
}
