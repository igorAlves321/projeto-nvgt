// Comando /tp (teleportar)
// Task 1.2.1: Validacao completa de inputs
void cmd_tp(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "tp", "Você não tem permissao!");
		return;
	}
	
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "tp", "Nome de jogador invalido!");
		return;
	}
	
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "tp", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}
	
	players[player_index].x = players[target].x;
	players[player_index].y = players[target].y;
	players[player_index].map = players[target].map;
	
	send_reliable_text(players[player_index].peer_id, "msg2 Teleportado para " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " teleportou para " + target_name);
}

// Comando /tphere (trazer jogador)
// Task 1.2.1: Validacao de inputs
void cmd_tphere(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "tphere", "Você não tem permissao!");
		return;
	}
	
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "tphere", "Nome de jogador inválido!");
		return;
	}
	
	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "tphere", "Jogador '" + target_name + "' não encontrado ou offline.");
		return;
	}
	
	players[target].x = players[player_index].x;
	players[target].y = players[player_index].y;
	players[target].map = players[player_index].map;
	
	send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " foi trazido ate você", 0);
	send_reliable_text(players[target].peer_id, "msg2 Você foi teleportado por um admin", 0);
	debug_log("ADMIN: " + players[player_index].charname + " trouxe " + target_name);
}

// Comando /createportal - Criar portal de teletransporte
// Task 1.2.1: Validacao completa de inputs
void cmd_createportal(int player_index, string destination_map, int dest_x, int dest_y) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "createportal", "Você não tem permissao!");
		return;
	}

	if(!is_valid_map_name(destination_map)) {
		send_admin_error(player_index, "createportal", "Nome de mapa invalido! Use apenas letras, numeros e underscore.");
		return;
	}

	if(!is_valid_coord(dest_x) || !is_valid_coord(dest_y)) {
		send_admin_error(player_index, "createportal", "Coordenadas invalidas! Use valores entre " + ADMIN_MIN_COORD + " e " + ADMIN_MAX_COORD + ".");
		return;
	}

	int dest_map_index = get_map_index_from(destination_map);
	if(dest_map_index == -1) {
		send_admin_error(player_index, "createportal", "Mapa de destino não encontrado: " + destination_map);
		return;
	}

	spawn_portal(player_index, players[player_index].x, players[player_index].y, 
	             players[player_index].map, destination_map, dest_x, dest_y);

	send_reliable_text(players[player_index].peer_id, "msg2 Portal criado para " + destination_map + " em (" + dest_x + ", " + dest_y + ")", 0);
	debug_log("ADMIN: " + players[player_index].charname + " criou portal para " + destination_map);
}

// Comando /deleteportal - Deletar portal proximo
// Task 1.2.1: Validacao completa de inputs
void cmd_deleteportal(int player_index, int range = 10) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "deleteportal", "Você não tem permissao!");
		return;
	}

	if(range < 1 || range > 100) {
		send_admin_error(player_index, "deleteportal", "Range inválido! Use valores entre 1 e 100.");
		return;
	}

	int map_index = get_map_index_from(players[player_index].map);
	if(map_index == -1) {
		send_admin_error(player_index, "deleteportal", "Erro ao obter mapa atual!");
		return;
	}

	for(uint i = 0; i < server_maps[map_index].portals.length(); i++) {
		portal@ pt = server_maps[map_index].portals[i];
		int distance = int(get_distance(players[player_index].x, players[player_index].y, pt.x, pt.y));

		if(distance <= range) {
			send_reliable_text(players[player_index].peer_id, "msg2 Portal deletado!", 0);
			server_maps[map_index].portals.remove_at(i);
			debug_log("ADMIN: " + players[player_index].charname + " deletou portal em " + players[player_index].map);
			return;
		}
	}

	send_admin_error(player_index, "deleteportal", "Nenhum portal encontrado em um raio de " + range + " tiles.");
}
