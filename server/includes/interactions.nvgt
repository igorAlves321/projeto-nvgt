
#include "shared_globals.nvgt"
#include "player.nvgt"
#include "items.nvgt"

void process_zone_interaction(int player_index, string zone_message) {
	player@ p = players[player_index];
    if(p is null) return;

	string msga = zone_message;
    msga = msga.replace("zsa ", "");

    debug_log("Interação de zona: " + p.name + " em " + p.map_name + ": " + msga);

    if(p.map_name == "helicóptero_de_guerra") {
        if(p.x == 1 && p.y >= 0 && p.y <= 2) {
            if(p.inv_item_number("paquete_militar") < 1) {
                p.inv_add_item("paquete_militar", 1);
                server_maps[p.mapindex].send_packet(0, "play getsurvival_pack.ogg", p.x, p.y);
                p.send_message("msg2 ;tomas un paquete del estante.;");
            } else {
                p.send_message("msg2 ;simplemente eso no se puede.;");
            }
            return;
        }
        if(p.x == 1 && p.y >= 5 && p.y <= 7) {
            if(p.inv_item_number("paquete_médico_militar") < 1) {
                p.inv_add_item("paquete_médico_militar", 1);
                server_maps[p.mapindex].send_packet(0, "play getpackage.ogg", p.x, p.y);
                p.send_message("msg2 ;tomas un paquete del estante.;");
            } else {
                p.send_message("msg2 ;simplemente eso no se puede.;");
            }
            return;
        }
    }

    if(p.map_name == "pueblo_de_zaragoza" && msga == "Ventanilla de servicio.") {
        if(p.inv_item_number("dólares") >= 5000) {
            p.send_message("msg ¡muchas gracias por elejirnos a nosotros! aquí tiene su entrada.");
            p.inv_add_item("dólares", -5000);
            p.inv_add_item("boleto_de_entrada_a_la_pirámide", 1);
        }
        return;
    }

    if(p.map_name == "pueblo_de_zaragoza" && msga == "Entrada a las ruinas de la pirámide.") {
        if(p.inv_item_number("boleto_de_entrada_a_la_pirámide") >= 1) {
            p.inv_add_item("boleto_de_entrada_a_la_pirámide", -1);
            p.teleport(652, 0, "pueblo_de_zaragoza");
            p.send_message("msg lentamente, te adentras en las ruinas de la pirámide.");
        }
        return;
    }

    if(p.map_name == "pueblo_de_zaragoza" && msga == "Tapa del sistema de alcantarillado.") {
        if(p.inv_item_number("llabe_del_alcantarillado") >= 1) {
            p.teleport(1, 100, "alcantarillas");
            p.send_message("msg introduces la llabe que encontraste, y suena un click. alzas la tapa, y te adentras en este lugar.");
        }
        return;
    }

    if(msga.find("un hermoso reloj colgado en la pared") > -1) {
        server_maps[p.mapindex].send_packet(0, "play relogio2.ogg", p.x, p.y);
        p.send_message("msg São " + server_calendar.get_time_string() + ".");
        return;
    }

    if(p.map_name == "oficina_principal_seelfer" && msga.find("un hada con traje formal") > -1) {
        if(p.inv_item_number("espada_infernal") >= 1) {
            p.send_message("msg oh, gracias por esto! la necesitaba de verdad! supongo que puedo pagarte con esto...");
            server_maps[p.mapindex].send_packet(0, "play door17open.ogg", p.x, p.y);
            p.gcoins += 10;
            p.inv_add_item("espada_infernal", -1);
        } else {
             p.send_message("msg oye, humano. esas hadas tienen un arma... podrías conseguirme una? la necesito para una investigación.");
             server_maps[p.mapindex].send_packet(0, "play door17open.ogg", p.x, p.y);
        }
        return;
    }

    if(msga == "Una cama bastante cómoda. ¡Ey, pero no es para ti!") {
        cmd_amarrarpet(player_index);
        return;
    }

    if(msga.find("Zona de jaulas") > -1 || msga.find("canil") > -1) {
        pet_zona_de_adocao(player_index);
        return;
    }

    if(msga == "una máquina de la cual salen cartas.") {
        if(p.inv_item_number("sobre_con_sello_con_forma_de_espiral_de_fuego") > 10) {
            p.send_message("msg ya tienes más de 10 cartas en tu poder!");
        } else {
            p.inv_add_item("sobre_con_sello_con_forma_de_espiral_de_fuego", 1);
            p.send_message("msg Tomas un sobre de la máquina.");
        }
        return;
    }

    if(p.map_name == "estación_espacial" && msga.find("entrada a la cámara de despliegue") > -1) {
        if(p.inv_item_number("llave_de_acero") >= 1) {
            p.inv_add_item("llave_de_acero", -1);
            p.teleport(102, 0, "estación_espacial");
            p.send_message("msg Bueno, parece que tienes la llave así que puedes pasar.");
            server_maps[p.mapindex].send_packet(0, "play door17open.ogg", p.x, p.y);
        } else {
            server_maps[p.mapindex].send_packet(0, "play door17open.ogg", p.x, p.y);
            p.send_message("msg Ey, chico. si quieres pasar al otro lado, necesitarás la llave.");
        }
        return;
    }
}
