
string get_file_size(string filename) {
	file sizer;
	if(!sizer.open(filename, "rb")) return "0 B";

	string size = sizer.read();
	sizer.close();
	return get_string_size(size);
}

double get_file_size_b(string filename) {
	file sizer;
	if(!sizer.open(filename, "rb")) return 0;

	string size = sizer.read();
	sizer.close();
	return get_string_size_b(size);
}

string get_string_size(string size) {
	double bytes = size.length();
	return convert_size(bytes);
}

string convert_size(double size) {
	double bytes = size;

	if(bytes < 1024) {
		return round(bytes, 2) + " B";
	}

	bytes = bytes / 1024;
	if(bytes < 1024) {
		return round(bytes, 2) + " KB";
	}

	bytes = bytes / 1024;
	if(bytes < 1024) {
		return round(bytes, 2) + " MB";
	}

	bytes = bytes / 1024;
	if(bytes < 1024) {
		return round(bytes, 2) + " GB";
	}

	bytes = bytes / 1024;
	return round(bytes, 2) + " TB";
}

double get_string_size_b(string size) {
	return size.length();
}

string format_bytes(double bytes) {
	return convert_size(bytes);
}

double get_directory_size(string path) {
	string[] files = find_files(path + "/*");
	double total = 0;

	for(uint i = 0; i < files.length(); i++) {
		if(directory_exists(files[i])) {
			total += get_directory_size(files[i]);
		}
		else {
			total += get_file_size_b(files[i]);
		}
	}

	return total;
}

bool is_file_too_large(string filename, double max_mb = 10) {
	double size_b = get_file_size_b(filename);
	double max_bytes = max_mb * 1024 * 1024;
	return size_b > max_bytes;
}
