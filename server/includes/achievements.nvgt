// Obter achievement progress do jogador
achievement_progress@ get_player_achievements(string player_name) {
	if(!player_achievements.exists(player_name)) {
		achievement_progress ap(player_name);
		ap.load();
		player_achievements.set(player_name, @ap);
		return ap;
	}
	
	return cast<achievement_progress@>(player_achievements[player_name]);
}

// Obter achievement por ID
achievement_definition@ get_achievement_by_id(int ach_id) {
	for(uint i = 0; i < achievement_database.length(); i++) {
		if(achievement_database[i].id == ach_id) {
			return achievement_database[i];
		}
	}
	return null;
}

// Verificar e desbloquear achievement
void check_achievement(string player_name, int ach_id) {
	achievement_progress@ ap = get_player_achievements(player_name);
	
	// Já desbloqueado?
	if(ap.has_achievement(ach_id)) return;
	
	achievement_definition@ adef = get_achievement_by_id(ach_id);
	if(adef is null) return;
	
	// Verificar se está completo
	if(ap.check_achievement_complete(adef)) {
		// Desbloquear!
		ap.unlock_achievement(ach_id, adef.points, adef.title_reward);
		ap.save();
		
		// Notificar jogador
		int player_idx = get_player_index_from(player_name);
		if(player_idx >= 0) {
			send_reliable(players[player_idx].peer_id, "msg2 =============================", 0);
			send_reliable(players[player_idx].peer_id, "msg2 🏆 CONQUISTA DESBLOQUEADA! 🏆", 0);
			send_reliable(players[player_idx].peer_id, "msg2 " + adef.name, 0);
			send_reliable(players[player_idx].peer_id, "msg2 " + adef.description, 0);
			send_reliable(players[player_idx].peer_id, "msg2 +" + adef.points + " pontos de conquista", 0);
			
			if(adef.title_reward != "") {
				send_reliable(players[player_idx].peer_id, "msg2 Título desbloqueado: " + adef.title_reward, 0);
			}
			
			// Dar recompensas
			string[] reward_keys = adef.rewards.get_keys();
			for(uint i = 0; i < reward_keys.length(); i++) {
				int amount = int(adef.rewards[reward_keys[i]]);
				if(reward_keys[i] == "gold") {
					players[player_idx].gold += amount;
					send_reliable(players[player_idx].peer_id, "msg2 +" + amount + " gold", 0);
				} else if(reward_keys[i] == "xp") {
					players[player_idx].xp += amount;
					send_reliable(players[player_idx].peer_id, "msg2 +" + amount + " XP", 0);
				}
			}
			
			send_reliable(players[player_idx].peer_id, "msg2 =============================", 0);
		}
		
		debug_log("ACHIEVEMENTS: " + player_name + " desbloqueou '" + adef.name + "'");
	}
}

// Atualizar progresso de achievement
void update_achievement_progress(string player_name, string req_type, int value) {
	achievement_progress@ ap = get_player_achievements(player_name);
	
	// Atualizar progresso de todos os achievements relevantes
	for(uint i = 0; i < achievement_database.length(); i++) {
		if(ap.has_achievement(achievement_database[i].id)) continue;
		
		if(achievement_database[i].requirements.exists(req_type)) {
			ap.update_progress(achievement_database[i].id, req_type, value);
			check_achievement(player_name, achievement_database[i].id);
		}
	}
	
	ap.save();
}

// Definir progresso absoluto de achievement
void set_achievement_progress(string player_name, string req_type, int value) {
	achievement_progress@ ap = get_player_achievements(player_name);
	
	for(uint i = 0; i < achievement_database.length(); i++) {
		if(ap.has_achievement(achievement_database[i].id)) continue;
		
		if(achievement_database[i].requirements.exists(req_type)) {
			ap.set_progress(achievement_database[i].id, req_type, value);
			check_achievement(player_name, achievement_database[i].id);
		}
	}
	
	ap.save();
}

// Comando: Listar achievements
void cmd_achievements(int player_index, string filter = "all") {
	achievement_progress@ ap = get_player_achievements(players[player_index].charname);
	
	send_reliable(players[player_index].peer_id, "msg2 === Conquistas (" + ap.unlocked_achievements.length() + "/" + achievement_database.length() + ") ===", 0);
	send_reliable(players[player_index].peer_id, "msg2 Pontos Totais: " + ap.total_points, 0);
	
	for(uint i = 0; i < achievement_database.length(); i++) {
		achievement_definition@ adef = achievement_database[i];
		bool unlocked = ap.has_achievement(adef.id);
		
		if(filter != "all") {
			if(filter == "unlocked" && !unlocked) continue;
			if(filter == "locked" && unlocked) continue;
		}
		
		if(adef.is_secret && !unlocked) {
			send_reliable(players[player_index].peer_id, "msg2 #" + adef.id + " - [SECRETA]", 0);
		} else {
			string line = "#" + adef.id + " - " + adef.name;
			if(unlocked) {
				line += " ✅ (" + adef.points + " pts)";
			} else {
				line += " (" + adef.points + " pts)";
			}
			send_reliable(players[player_index].peer_id, "msg2 " + line, 0);
		}
	}
	
	send_reliable(players[player_index].peer_id, "msg2 Use /achievementinfo <id> para detalhes", 0);
}

// Comando: Ver info de achievement
void cmd_achievementinfo(int player_index, int ach_id) {
	achievement_definition@ adef = get_achievement_by_id(ach_id);
	if(adef is null) {
		send_reliable(players[player_index].peer_id, "msg2 Conquista não encontrada!", 0);
		return;
	}
	
	achievement_progress@ ap = get_player_achievements(players[player_index].charname);
	bool unlocked = ap.has_achievement(ach_id);
	
	if(adef.is_secret && !unlocked) {
		send_reliable(players[player_index].peer_id, "msg2 Esta é uma conquista secreta!", 0);
		return;
	}
	
	send_reliable(players[player_index].peer_id, "msg2 === Conquista #" + adef.id + " ===", 0);
	send_reliable(players[player_index].peer_id, "msg2 " + adef.name, 0);
	send_reliable(players[player_index].peer_id, "msg2 " + adef.description, 0);
	send_reliable(players[player_index].peer_id, "msg2 Pontos: " + adef.points, 0);
	
	if(unlocked) {
		send_reliable(players[player_index].peer_id, "msg2 Status: ✅ DESBLOQUEADA", 0);
	} else {
		send_reliable(players[player_index].peer_id, "msg2 Status: Bloqueada", 0);
		
		// Mostrar progresso
		send_reliable(players[player_index].peer_id, "msg2 --- Progresso ---", 0);
		string[] req_keys = adef.requirements.get_keys();
		for(uint i = 0; i < req_keys.length(); i++) {
			int required = int(adef.requirements[req_keys[i]]);
			int current = ap.get_progress(adef.id, req_keys[i]);
			send_reliable(players[player_index].peer_id, "msg2 " + req_keys[i] + ": " + current + "/" + required, 0);
		}
	}
	
	if(adef.title_reward != "") {
		send_reliable(players[player_index].peer_id, "msg2 Título: " + adef.title_reward, 0);
	}
}

// Comando: Listar títulos
void cmd_titles(int player_index) {
	achievement_progress@ ap = get_player_achievements(players[player_index].charname);
	
	send_reliable(players[player_index].peer_id, "msg2 === Títulos Desbloqueados (" + ap.unlocked_titles.length() + ") ===", 0);
	
	if(ap.active_title != "") {
		send_reliable(players[player_index].peer_id, "msg2 Título Ativo: " + ap.active_title, 0);
	}
	
	for(uint i = 0; i < ap.unlocked_titles.length(); i++) {
		string marker = (ap.unlocked_titles[i] == ap.active_title) ? "[ATIVO] " : "";
		send_reliable(players[player_index].peer_id, "msg2 " + marker + ap.unlocked_titles[i], 0);
	}
	
	send_reliable(players[player_index].peer_id, "msg2 Use /settitle <título> para equipar", 0);
}

// Comando: Equipar título
void cmd_settitle(int player_index, string title) {
	achievement_progress@ ap = get_player_achievements(players[player_index].charname);
	
	if(!ap.has_title(title)) {
		send_reliable(players[player_index].peer_id, "msg2 Você não desbloqueou esse título!", 0);
		return;
	}
	
	ap.active_title = title;
	ap.save();
	
	send_reliable(players[player_index].peer_id, "msg2 Título equipado: " + title, 0);
}

// Comando: Remover título
void cmd_removetitle(int player_index) {
	achievement_progress@ ap = get_player_achievements(players[player_index].charname);
	
	ap.active_title = "";
	ap.save();
	
	send_reliable(players[player_index].peer_id, "msg2 Título removido", 0);
}
