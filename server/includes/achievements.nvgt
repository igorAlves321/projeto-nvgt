// achievements.nvgt - Sistema de Conquistas/Achievements
// Conversão: Novo sistema para NVGT
// Fase 5: Conteúdo Avançado

// Categorias de achievement
enum achievement_category {
	ACH_COMBAT,
	ACH_EXPLORATION,
	ACH_SOCIAL,
	ACH_ECONOMY,
	ACH_SPECIAL
}

// Definição de achievement
class achievement_definition {
	int id;
	string name;
	string description;
	achievement_category category;
	int points;
	dictionary requirements;  // tipo_requisito -> valor necessário
	dictionary rewards;       // tipo_recompensa -> quantidade
	bool is_secret;
	string title_reward;      // Título desbloqueado
	
	achievement_definition(int ach_id, string ach_name, string desc, achievement_category cat) {
		this.id = ach_id;
		this.name = ach_name;
		this.description = desc;
		this.category = cat;
		this.points = 10;
		this.is_secret = false;
		this.title_reward = "";
	}
	
	void add_requirement(string req_type, int value) {
		requirements.set(req_type, "" + value);
	}
	
	void add_reward(string reward_type, int amount) {
		rewards.set(reward_type, "" + amount);
	}
}

// Progresso de achievement do jogador
class achievement_progress {
	string player_name;
	string[] unlocked_achievements;  // IDs de achievements desbloqueados
	dictionary progress;              // achievement_id + "_" + req_type -> valor atual
	int total_points;
	string active_title;
	string[] unlocked_titles;
	
	achievement_progress(string pname) {
		this.player_name = pname;
		this.total_points = 0;
		this.active_title = "";
	}
	
	bool has_achievement(int ach_id) {
		for(uint i = 0; i < unlocked_achievements.length(); i++) {
			if(unlocked_achievements[i] == "" + ach_id) {
				return true;
			}
		}
		return false;
	}
	
	void update_progress(int ach_id, string req_type, int value) {
		string key = "" + ach_id + "_" + req_type;
		if(progress.exists(key)) {
			int current = int(progress[key]);
			progress.set(key, "" + (current + value));
		} else {
			progress.set(key, "" + value);
		}
	}
	
	void set_progress(int ach_id, string req_type, int value) {
		string key = "" + ach_id + "_" + req_type;
		progress.set(key, "" + value);
	}
	
	int get_progress(int ach_id, string req_type) {
		string key = "" + ach_id + "_" + req_type;
		if(progress.exists(key)) {
			return int(progress[key]);
		}
		return 0;
	}
	
	bool check_achievement_complete(achievement_definition@ adef) {
		string[] req_keys = adef.requirements.get_keys();
		for(uint i = 0; i < req_keys.length(); i++) {
			int required = int(adef.requirements[req_keys[i]]);
			int current = get_progress(adef.id, req_keys[i]);
			if(current < required) {
				return false;
			}
		}
		return true;
	}
	
	void unlock_achievement(int ach_id, int points, string title = "") {
		unlocked_achievements.insert_last("" + ach_id);
		total_points += points;
		
		if(title != "" && !has_title(title)) {
			unlocked_titles.insert_last(title);
		}
	}
	
	bool has_title(string title) {
		for(uint i = 0; i < unlocked_titles.length(); i++) {
			if(unlocked_titles[i] == title) {
				return true;
			}
		}
		return false;
	}
	
	void save() {
		string path = "players/" + player_name + "/achievements.dat";
		
		file f;
		if(!f.open(path, "wb")) {
			debug_log("ACHIEVEMENTS: Erro ao salvar achievements de " + player_name);
			return;
		}
		
		// Salvar achievements desbloqueados
		f.write("" + unlocked_achievements.length() + "\n");
		for(uint i = 0; i < unlocked_achievements.length(); i++) {
			f.write(unlocked_achievements[i] + "\n");
		}
		
		// Salvar progresso
		string[] prog_keys = progress.get_keys();
		f.write("" + prog_keys.length() + "\n");
		for(uint i = 0; i < prog_keys.length(); i++) {
			f.write(prog_keys[i] + "\n");
			f.write("" + int(progress[prog_keys[i]]) + "\n");
		}
		
		// Salvar pontos e título
		f.write("" + total_points + "\n");
		f.write(active_title + "\n");
		
		// Salvar títulos
		f.write("" + unlocked_titles.length() + "\n");
		for(uint i = 0; i < unlocked_titles.length(); i++) {
			f.write(unlocked_titles[i] + "\n");
		}
		
		f.close();
		debug_log("ACHIEVEMENTS: Progresso de " + player_name + " salvo");
	}
	
	void load() {
		string path = "players/" + player_name + "/achievements.dat";
		
		file f;
		if(!f.open(path, "rb")) {
			return;  // Arquivo não existe
		}
		
		string content = f.read();
		f.close();
		
		string[] lines = content.split("\n");
		if(lines.length() < 1) return;
		
		int line_idx = 0;
		
		// Carregar achievements
		int ach_count = parse_int(lines[line_idx++]);
		for(int i = 0; i < ach_count && line_idx < int(lines.length()); i++) {
			unlocked_achievements.insert_last(lines[line_idx++]);
		}
		
		// Carregar progresso
		if(line_idx < int(lines.length())) {
			int prog_count = parse_int(lines[line_idx++]);
			for(int i = 0; i < prog_count && line_idx + 1 < int(lines.length()); i++) {
				string key = lines[line_idx++];
				int val = parse_int(lines[line_idx++]);
				progress.set(key, "" + val);
			}
		}
		
		// Carregar pontos e título
		if(line_idx < int(lines.length())) {
			total_points = parse_int(lines[line_idx++]);
		}
		if(line_idx < int(lines.length())) {
			active_title = lines[line_idx++];
		}
		
		// Carregar títulos
		if(line_idx < int(lines.length())) {
			int title_count = parse_int(lines[line_idx++]);
			for(int i = 0; i < title_count && line_idx < int(lines.length()); i++) {
				unlocked_titles.insert_last(lines[line_idx++]);
			}
		}
		
		debug_log("ACHIEVEMENTS: Progresso de " + player_name + " carregado (" + unlocked_achievements.length() + " conquistas)");
	}
}

// Banco de dados de achievements
achievement_definition@[] achievement_database;

// Dictionary de progresso de achievements
dictionary player_achievements;

// Inicializar sistema de achievements
