// platforms.nvgt - Sistema de Plataformas (convertido de platforms.bgt)
// Conversão: BGT → NVGT

class platform {
	string plattype;
	bool is_platform = false;
	bool is_staircase = false;
	bool is_wall = false;
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string tiles;
	
	platform(string type, int minx, int maxx, int miny, int maxy, string tile) {
		this.plattype = type;
		this.min_x = minx;
		this.max_x = maxx;
		this.min_y = miny;
		this.max_y = maxy;
		this.tiles = tile;
		set_type(this.plattype);
	}

	void set_type(string type) {
		if (type == "p") {
			is_platform = true;
		}
		if (type == "sc") {
			is_staircase = true;
		}
		if (type == "w") {
			is_wall = true;
		}
	}
} // end platform
