    }
}
void cmd_create_item_tool(int player_index, string data) {
    if(!can_access_item_builder(player_index)) {
        send_admin_error(player_index, "create_item_tool", "Permissao negada. Apenas staff de construcao pode criar itens.");
        return;
    }

    if(!database_initialized || bancoJogo is null) {
        send_admin_error(player_index, "create_item_tool", "Banco de dados não inicializado.");
        return;
    }
    try {
    create_items_tables();

    if(!item_builder_is_safe_payload(data)) {
        send_admin_error(player_index, "create_item_tool", "Payload invalido (tamanho ou quebra de linha).");
        return;
    }

    string[] parts = data.split("|");
    if(parts.length() < 2) {
        send_admin_error(player_index, "create_item_tool", "Dados insuficientes. Esperado ao menos type|name.");
        return;
    }

    string item_type = parts[0].trim_whitespace();
    string name = parts[1].trim_whitespace();
    string display = parts.length() > 2 ? parts[2].trim_whitespace() : "";
    string desc = parts.length() > 3 ? parts[3].trim_whitespace() : "";
    string sound_file = parts.length() > 12 ? parts[12].trim_whitespace() : "";

    int heal = 0;

    if(item_builder_is_blank(item_type) || item_builder_is_blank(name)) {
        if(item_builder_is_blank(item_type)) item_builder_send_empty_field_error(player_index, "create_item_tool", "type");
        else item_builder_send_empty_field_error(player_index, "create_item_tool", "name");
        return;
    }

    if(!item_builder_is_valid_identifier(item_type)) {
        item_builder_send_invalid_field_error(player_index, "create_item_tool", "type", "use letras, numeros e underscore");
        return;
    }

    if(parts.length() > 7 && !item_builder_is_blank(parts[7])) {
        if(!item_builder_parse_int_field(player_index, "create_item_tool", "heal", parts[7], 0, 100000, heal)) return;
    }

    if(!item_builder_is_valid_identifier(name)) {
        item_builder_send_invalid_field_error(player_index, "create_item_tool", "name", "use letras, numeros e underscore");
        return;
    }

    if(desc == "") desc = display;
    if(desc == "") desc = name;

    bool success = create_item(
        name, display, desc, item_type, "legacy",
        0, 0, heal, 0,
        true, 999, 1.0, 0,
        "common", 1.0, false, true, true,
        "", sound_file
    );

    if(success) {
        load_items_from_database();
        string msg = "Item criado com sucesso: " + display + " (" + name + ")";
        send_reliable_text(players[player_index].peer_id, "msg2 " + msg, 0);
        debug_log("ITEM BUILDER: " + players[player_index].charname + " criou item " + name);
    } else {
        send_admin_error(player_index, "create_item_tool", "Erro ao criar item. O ID '" + name + "' ja existe?");
    }
    }
    catch {
        send_admin_error(player_index, "create_item_tool", "Falha interna ao criar item.");
        debug_log("ITEM BUILDER ERROR /create_item_tool: " + get_exception_info() + " (" + get_exception_file() + ":" + get_exception_line() + ")");
    }
}
// Comando /create_weapon_tool - Criar arma de fogo (formato weapons_list.db)
// Formato: name=ammo=sound_shoot=sound_impact=sound_draw=sound_reload=damage=distance=ammo_total=ammo_cantity=speed=speed_burst=speed_loading=require_ammo=enable_burst=is_dropable=sound_impact_on_corpse=sound_unload=sound_mode1=sound_mode2=ammo_cantity_descount=sound_shoot_dist=degradation_point
void cmd_create_weapon_tool(int player_index, string data) {
    if(!can_access_item_builder(player_index)) {
        send_admin_error(player_index, "create_weapon_tool", "Permissao negada. Apenas staff de construcao pode criar armas.");
        return;
    }

    if(!database_initialized || bancoJogo is null) {
        send_admin_error(player_index, "create_weapon_tool", "Banco de dados não inicializado.");
        return;
    }
    try {
    create_items_tables();

    if(!file_exists("weapons_list.db")) {
        file f;
        f.open("weapons_list.db", "w");
        f.write("// weapons_list.db - Banco de Dados de Armas\r\n");
        f.write("// Formato: name=ammo=sound_shoot=sound_impact=sound_draw=sound_reload=damage=distance=ammo_total=ammo_cantity=speed=speed_burst=speed_loading=require_ammo=enable_burst=is_dropable=sound_impact_on_corpse=sound_unload=sound_mode1=sound_mode2=ammo_cantity_descount=sound_shoot_dist=degradation_point\r\n\r\n");
        f.close();
    }

    if(!item_builder_is_safe_payload(data, 8192)) {
        send_admin_error(player_index, "create_weapon_tool", "Payload invalido (tamanho ou quebra de linha).");
        return;
    }

    string[] parts = data.split("=");
    if(parts.length() < 23) {
        send_admin_error(player_index, "create_weapon_tool", "Dados insuficientes. Esperado 23 campos separados por =");
        debug_log("Weapon Builder: dados insuficientes: " + parts.length() + " campos");
        return;
    }

    string weapon_name = parts[0].trim_whitespace();
    string ammo_name = parts[1].trim_whitespace();
    string shoot_sound = parts[2];
    int damage = 0;
    int distance = 0;

    if(weapon_name == "" || !item_builder_is_valid_identifier(weapon_name)) {
        send_admin_error(player_index, "create_weapon_tool", "Nome da arma invalido.");
        return;
    }
    if(ammo_name == "" || !item_builder_is_valid_identifier(ammo_name)) {
        send_admin_error(player_index, "create_weapon_tool", "Nome da municao invalido.");
        return;
    }
    if(!item_builder_parse_int_field(player_index, "create_weapon_tool", "damage", parts[6], 1, 100000, damage)) return;
    if(!item_builder_parse_int_field(player_index, "create_weapon_tool", "distance", parts[7], 1, 100000, distance)) return;

    file check;
    check.open("weapons_list.db", "r");
    string existing = check.read();
    check.close();

    if(existing.find(weapon_name + "=") >= 0) {
        send_admin_error(player_index, "create_weapon_tool", "Arma ja existe no banco de dados: " + weapon_name);
        return;
    }

    file f;
    f.open("weapons_list.db", "a");
    f.write(data + "\r\n");
    f.close();

    weapons_list.resize(0);
    load_weapons();

    string display_name = string_replace(weapon_name, "_", " ", true);
    string description = "Arma de fogo. Municao: " + ammo_name + ". Alcance: " + distance + ".";
    int value = damage * 8;
    if(value < 20) value = 20;

    bool created_in_db = create_item(
        weapon_name, display_name, description, "weapon", "firearm",
        damage, 0, 0, 0,
        false, 1, 2.0, value,
        "common", 0.0, false, true, true,
        shoot_sound, shoot_sound
    );

    if(!created_in_db) {
        string upsert_query = """
            UPDATE items
            SET audio = ?, msg = ?, health = 0, updated_at = CURRENT_TIMESTAMP
            WHERE name = ?;
        """;
        sqlite3statement@ up_stmt = bancoJogo.prepare(upsert_query);
        if(@up_stmt != null) {
            up_stmt.bind_text(1, shoot_sound == "" ? "none" : shoot_sound);
            up_stmt.bind_text(2, description);
            up_stmt.bind_text(3, weapon_name);
            up_stmt.step();
        }
    }

    load_items_from_database();

    string msg = "Arma criada com sucesso: " + weapon_name;
    send_reliable_text(players[player_index].peer_id, "msg2 " + msg, 0);
    debug_log("WEAPON BUILDER: " + players[player_index].charname + " criou arma " + weapon_name);
    send_reliable_text(players[player_index].peer_id, "msg2 Catalogo SQLite sincronizado. Jogadores podem precisar reconectar para runtime de arma.", 0);
    }
    catch {
        send_admin_error(player_index, "create_weapon_tool", "Falha interna ao criar arma.");
        debug_log("ITEM BUILDER ERROR /create_weapon_tool: " + get_exception_info() + " (" + get_exception_file() + ":" + get_exception_line() + ")");
    }
}

// Comando /list_items - Listar itens disponAveis
void cmd_list_items(int player_index) {
    if(!can_access_item_builder(player_index)) {
        send_admin_error(player_index, "list_items", "Permissao negada.");
        return;
    }

    if(!database_initialized || bancoJogo is null) {
        send_admin_error(player_index, "list_items", "Banco de dados não inicializado.");
        return;
    }

    try {
    // Garante que a tabela exista mesmo em cenarios de bootstrap parcial
    create_items_tables();

    string list_items = "=== Itens do Banco de Dados ===\n";

    string query = "SELECT name, msg, audio FROM items ORDER BY name LIMIT 200;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);

    int count = 0;
    if(@stmt != null) {
        while(stmt.step() == SQLITE_ROW) {
            string name = stmt.column_text(0);
            string msg = stmt.column_text(1);
            string audio = stmt.column_text(2);
            string display = msg;
            if(display == "") display = name;
            list_items += "[legacy] " + name + " - " + display;
            if(audio != "" && audio != "none") {
                list_items += " (audio: " + audio + ")";
            }
            list_items += "\n";
            count++;
        }
    }
    else {
        // Se a query falhou (ex: tabela ausente/corrompida), retorna erro claro sem derrubar servidor
        send_admin_error(player_index, "list_items", "Erro ao listar itens: " + bancoJogo.get_last_error_text());
        return;
    }

    if(count == 0) {
        list_items += "(Nenhum item cadastrado)\n";
    }

    list_items += "\n(Fonte unica: tabela items do SQLite / database/ig.db)\n";
    send_reliable_text(players[player_index].peer_id, "msg2 " + list_items, 0);
    }
    catch {
        send_admin_error(player_index, "list_items", "Falha interna ao listar itens.");
        debug_log("ITEM BUILDER ERROR /list_items: " + get_exception_info() + " (" + get_exception_file() + ":" + get_exception_line() + ")");
    }
}

// Comando /edit_item_tool - Editar item existente no catalogo SQLite
// Formato aceito (compat): name|display|desc|type|category|damage|defense|heal|mp|weight|value|rarity|sound|max_stack|drop_rate
// Campos efetivamente persistidos no schema BGT: msg(desc/display), audio(sound), health(heal)
void cmd_edit_item_tool(int player_index, string data) {
    if(!can_access_item_builder(player_index)) {
        send_admin_error(player_index, "edit_item_tool", "Permissao negada. Apenas staff de construcao pode editar itens.");
        return;
    }

    if(!database_initialized || bancoJogo is null) {
        send_admin_error(player_index, "edit_item_tool", "Banco de dados não inicializado.");
        return;
    }
    try {
    create_items_tables();

    if(!item_builder_is_safe_payload(data)) {
        send_admin_error(player_index, "edit_item_tool", "Payload invalido (tamanho ou quebra de linha).");
        return;
    }

    string[] raw_parts = data.split("|");
    if(raw_parts.length() < 1) {
        send_admin_error(player_index, "edit_item_tool", "Dados insuficientes. Campo name obrigatorio ausente.");
        return;
    }
    string[] parts(15);
    for(uint i = 0; i < parts.length(); i++) parts[i] = "";
    for(uint i = 0; i < raw_parts.length() && i < parts.length(); i++) {
        parts[i] = raw_parts[i];
    }

    string name = parts[0].trim_whitespace();
    if(name == "" || !item_builder_is_valid_identifier(name)) {
        item_builder_send_invalid_field_error(player_index, "edit_item_tool", "name", "id invalido");
        return;
    }

    string exists_query = "SELECT id, msg, audio, health FROM items WHERE name = ? LIMIT 1;";
    sqlite3statement@ exists_stmt = bancoJogo.prepare(exists_query);
    if(@exists_stmt == null) {
        send_admin_error(player_index, "edit_item_tool", "Erro ao validar item: " + bancoJogo.get_last_error_text());
        return;
    }
    exists_stmt.bind_text(1, name);
    if(exists_stmt.step() != SQLITE_ROW) {
        send_admin_error(player_index, "edit_item_tool", "Item não encontrado no catalogo: " + name);
        return;
    }

    string msg_value = exists_stmt.column_text(1);
    string audio_value = exists_stmt.column_text(2);
    double health_value = exists_stmt.column_double(3);

    if(!item_builder_is_blank(parts[2])) {
        msg_value = parts[2].trim_whitespace();
    } else if(!item_builder_is_blank(parts[1])) {
        msg_value = parts[1].trim_whitespace();
    }
    if(!item_builder_is_blank(parts[12])) {
        audio_value = parts[12].trim_whitespace();
    }
    if(!item_builder_is_blank(parts[7])) {
        int heal = 0;
        if(!item_builder_parse_int_field(player_index, "edit_item_tool", "heal", parts[7], 0, 100000, heal)) return;
        health_value = heal;
    }

    if(item_builder_is_blank(msg_value)) {
        item_builder_send_empty_field_error(player_index, "edit_item_tool", "desc");
        return;
    }

    if(audio_value == "") audio_value = "none";

    string query = "UPDATE items SET msg = ?, audio = ?, health = ?, updated_at = CURRENT_TIMESTAMP WHERE name = ?;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) {
        send_admin_error(player_index, "edit_item_tool", "Erro ao preparar UPDATE: " + bancoJogo.get_last_error_text());
        return;
    }

    stmt.bind_text(1, msg_value);
    stmt.bind_text(2, audio_value);
    stmt.bind_double(3, health_value);
    stmt.bind_text(4, name);

    if(stmt.step() != SQLITE_DONE) {
        send_admin_error(player_index, "edit_item_tool", "Erro ao editar item: " + bancoJogo.get_last_error_text());
        return;
    }

    load_items_from_database();
    send_reliable_text(players[player_index].peer_id, "msg2 Item atualizado com sucesso: " + name, 0);
    debug_log("ITEM BUILDER: " + players[player_index].charname + " editou item " + name);
    }
    catch {
        send_admin_error(player_index, "edit_item_tool", "Falha interna ao editar item.");
        debug_log("ITEM BUILDER ERROR /edit_item_tool: " + get_exception_info() + " (" + get_exception_file() + ":" + get_exception_line() + ")");
    }
}
// Comando /delete_item_tool - Excluir item do catalogo SQLite
void cmd_delete_item_tool(int player_index, string item_name) {
    if(!can_access_item_builder(player_index)) {
        send_admin_error(player_index, "delete_item_tool", "Permissao negada. Apenas staff de construcao pode excluir itens.");
        return;
    }

    if(!database_initialized || bancoJogo is null) {
        send_admin_error(player_index, "delete_item_tool", "Banco de dados não inicializado.");
        return;
    }
    try {
    create_items_tables();

    item_name = item_name.trim_whitespace();
    if(item_name == "") {
        send_admin_error(player_index, "delete_item_tool", "Nome de item invalido.");
        return;
    }

    string exists_query = "SELECT id FROM items WHERE name = ? LIMIT 1;";
    sqlite3statement@ exists_stmt = bancoJogo.prepare(exists_query);
    if(@exists_stmt == null) {
        send_admin_error(player_index, "delete_item_tool", "Erro ao validar item: " + bancoJogo.get_last_error_text());
        return;
    }
    exists_stmt.bind_text(1, item_name);
    if(exists_stmt.step() != SQLITE_ROW) {
        send_admin_error(player_index, "delete_item_tool", "Item não encontrado no catalogo: " + item_name);
        return;
    }

    string query = "DELETE FROM items WHERE name = ?;";
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt == null) {
        send_admin_error(player_index, "delete_item_tool", "Erro ao preparar DELETE: " + bancoJogo.get_last_error_text());
        return;
    }

    stmt.bind_text(1, item_name);
    if(stmt.step() != SQLITE_DONE) {
        send_admin_error(player_index, "delete_item_tool", "Erro ao excluir item: " + bancoJogo.get_last_error_text());
        return;
    }

    load_items_from_database();
    send_reliable_text(players[player_index].peer_id, "msg2 Item removido do catalogo: " + item_name, 0);
    send_reliable_text(players[player_index].peer_id, "msg2 Nota: se for arma legado, ela ainda pode existir no weapons_list.db.", 0);
    debug_log("ITEM BUILDER: " + players[player_index].charname + " removeu item " + item_name);
    }
    catch {
        send_admin_error(player_index, "delete_item_tool", "Falha interna ao excluir item.");
        debug_log("ITEM BUILDER ERROR /delete_item_tool: " + get_exception_info() + " (" + get_exception_file() + ":" + get_exception_line() + ")");
    }
}

