void cmd_item_builder_add_category(int player_index, string item_type, string category_name) {
    if(!can_access_item_builder(player_index)) {
        send_admin_error(player_index, "ib_add_category", "Permissao negada.");
        return;
    }
    item_type = item_type.trim_whitespace();
    category_name = category_name.trim_whitespace();
    if(item_type == "" || !item_builder_is_valid_identifier(item_type)) {
        send_admin_error(player_index, "ib_add_category", "Tipo invalido.");
        return;
    }
    if(category_name == "" || !item_builder_is_valid_identifier(category_name)) {
        send_admin_error(player_index, "ib_add_category", "Categoria invalida.");
        return;
    }
    if(!database_initialized || bancoJogo is null) {
        send_admin_error(player_index, "ib_add_category", "Banco de dados não inicializado.");
        return;
    }
    try {
    item_builder_ensure_metadata_tables();

    sqlite3statement@ type_stmt = bancoJogo.prepare("INSERT OR IGNORE INTO item_builder_types(type_name) VALUES (?);");
    if(@type_stmt !is null) {
        type_stmt.bind_text(1, item_type);
        type_stmt.step();
    }

    sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR IGNORE INTO item_builder_categories(item_type, category_name) VALUES (?, ?);");
    if(@stmt is null) {
        send_admin_error(player_index, "ib_add_category", "Erro SQL: " + bancoJogo.get_last_error_text());
        return;
    }
    stmt.bind_text(1, item_type);
    stmt.bind_text(2, category_name);
    if(stmt.step() != SQLITE_DONE) {
        send_admin_error(player_index, "ib_add_category", "Erro ao adicionar categoria: " + bancoJogo.get_last_error_text());
        return;
    }
    send_reliable_text(players[player_index].peer_id, "msg2 Categoria adicionada: " + item_type + " -> " + category_name, 0);
    }
    catch {
        send_admin_error(player_index, "ib_add_category", "Falha interna ao adicionar categoria.");
        debug_log("ITEM BUILDER ERROR /ib_add_category: " + get_exception_info() + " (" + get_exception_file() + ":" + get_exception_line() + ")");
    }
}

