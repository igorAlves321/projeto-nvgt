
string[] banidos;

string get_comp_bans() {
	if (banidos.length() == 0) return "Ninguém banido";
	string ret = "Banidos: ";
	string[] b;

	for (uint i = 0; i < banidos.length(); i++) {
		string[] dd = banidos[i].split(":", false);
		b.insert_last(dd[0]);
	}
	return "Banidos: " + linear(b);
}

bool comp_ban(string username) {
	int banindex = get_player_index_from(username);
	if (banindex > -1) {
		string peer_address = "unknown";
		for(uint i = 0; i < connected_peers.length(); i++) {
			if(connected_peers[i] == players[banindex].peer_id && i < peer_addresses.length()) {
				peer_address = peer_addresses[i];
				break;
			}
		}
		string b = username + ":" + players[banindex].computer_id + ":" + peer_address;
		banidos.insert_last(b);
		return true;
	}
	else {
		return false;
	}
}

bool comp_unban(string username) {
	bool baniu = false;
	for (uint i = 0; i < banidos.length(); i++) {
		string[] d = banidos[i].split(":", false);
		if (d[0] == username) {
			banidos.remove_at(i);
			baniu = true;
		}
	}
	return baniu;
}

bool banido(string id) {
	for (uint i = 0; i < banidos.length(); i++) {
		string[] ver = banidos[i].split(":", false);
		if (ver.length() > 1) {
			if (ver[1].find(id) > -1) return true;
		}
	}
	return false;
}
