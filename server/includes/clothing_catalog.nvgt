	semear_roupa_padrao("colete_militar", PARTE_TRONCO, "no corpo, um colete militar.", "coletedraw", "retirarcolete", 1, 1, 0.5, 15.0);
	semear_roupa_padrao("colete_camuflado", PARTE_TRONCO, "no corpo, um colete camuflado.", "coletedraw", "retirarcolete", 1, 1, 0.5, 12.0);
	semear_roupa_padrao("colete_mizuno", PARTE_TRONCO, "no corpo, um colete mizuno.", "colete2draw", "retirarcolete", 1, 1, 0.5, 9.0);
	semear_roupa_padrao("colete_salvavida", PARTE_TRONCO, "no corpo, um colete salva-vidas.", "coletedraw", "retirarcolete", 1, 1, 0.4, 7.0);
	semear_roupa_padrao("casaco_peles", PARTE_TRONCO, "no corpo, um casaco de peles.", "vestir_casaco_de_neve", "retirarjaqueta", 1, 1, 0.3, 6.0);
	semear_roupa_padrao("jaqueta_couro", PARTE_TRONCO, "no corpo, uma jaqueta de couro.", "camisadraw", "retirarjaqueta", 1, 1, 0.3, 4.0);
	semear_roupa_padrao("camisa_malha", PARTE_TRONCO, "no corpo, uma camisa de malha.", "camisadraw", "retirarcamisa", 1, 1, 0.2, 2.0);

