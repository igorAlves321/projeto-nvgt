	semear_roupa_padrao("bota_mizuno", PARTE_PES, "nos pes, um par de botas mizuno.", "botadraw", "retirarbota", 1, 1, 0.3, 5.0);
	semear_roupa_padrao("tenis_nike", PARTE_PES, "nos pes, um par de tenis nike.", "tenisdraw", "retirartenis", 1, 1, 0.2, 3.0);
	semear_roupa_padrao("tenis_adidas", PARTE_PES, "nos pes, um par de tenis adidas.", "tenisdraw", "retirartenis", 1, 1, 0.2, 3.0);
