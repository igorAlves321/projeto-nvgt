// ============================================================================
// clothing_catalog.nvgt - Catalogo de roupas (data-driven) + motor de vestir
// ----------------------------------------------------------------------------
// Consolidacao do sistema de roupas do BGT (includes/clothes.bgt, voids.bgt,
// net.bgt, re_server_test.bgt) para o projeto NVGT.
//
// Diferencas conscientes em relacao ao BGT:
//  - O catalogo mora no sqlite (tabela clothes_catalog) em vez do clothes.db
//    de texto separado por "=".
//  - protecao e guardada em PERCENTUAL 0..100 (o BGT guardava fracao,
//    protection*0.01). Toda a matematica de dano usa aplicar_protecao().
//  - As pecas vestidas de cada jogador sao persistidas em player_clothing,
//    em vez de ficarem so na memoria/arquivo de configs.
//
// ATENCAO: este arquivo e a UNICA fonte de verdade de clothing_protection.
// ============================================================================

// ---------------------------------------------------------------------------
// Partes do corpo (vocabulario normalizado com equipment_buffs.nvgt)
// ---------------------------------------------------------------------------
const string PARTE_CABECA = "head";
const string PARTE_ROSTO = "face";
const string PARTE_TRONCO = "body";
const string PARTE_PERNAS = "legs";
const string PARTE_PES = "feet";
const string PARTE_MAOS = "hands";
const string PARTE_CANELAS = "shins";
const string PARTE_ESCUDO = "shield";
const string PARTE_PULSEIRA = "accessory_1";
const string PARTE_ANEL = "accessory_2";
const string PARTE_BRACO = "arm";
const string PARTE_PULSO = "wrist";
const string PARTE_COSTAS = "back";

const double PROTECAO_MAXIMA_ROUPAS = 90.0;
const string MARCADOR_MIGRACAO_ROUPAS = "__migracao__";

// ---------------------------------------------------------------------------
// class roupa - uma entrada do catalogo (== class clothe do BGT)
// ---------------------------------------------------------------------------
class roupa {
	string nome = "";
	string parte_corpo = "";
	string descricao = "";
	string som_vestir = "";
	string som_tirar = "";
	string especial = "";
	string criado_por = "system";
	int mostrar_para_todos = 1;
	int permite_desgaste = 1;
	double desgaste_por_tiro = 0.5;
	double protecao = 0;

	roupa() {
	}

	roupa(string nome2, string parte_corpo2, string descricao2, string som_vestir2,
	      string som_tirar2, int mostrar_para_todos2, int permite_desgaste2,
	      double desgaste_por_tiro2, double protecao2, string especial2 = "",
	      string criado_por2 = "system") {
		this.nome = nome2;
		this.parte_corpo = parte_corpo2;
		this.descricao = descricao2;
		this.som_vestir = som_vestir2;
		this.som_tirar = som_tirar2;
		this.mostrar_para_todos = mostrar_para_todos2;
		this.permite_desgaste = permite_desgaste2;
		this.desgaste_por_tiro = desgaste_por_tiro2;
		this.protecao = protecao2;
		this.especial = especial2;
		this.criado_por = criado_por2;
	}

	bool eh_relogio() {
		if(this.especial.lower() == "relogio") return true;
		string n = this.nome.lower();
		if(n.find("relogio") >= 0) return true;
		if(n.find("watch") >= 0) return true;
		return false;
	}

	bool eh_paraquedas() {
		if(this.especial.lower() == "paraquedas") return true;
		string n = this.nome.lower();
		if(n.find("paraquedas") >= 0) return true;
		if(n.find("paracaidas") >= 0) return true;
		return false;
	}

	string linha_de_catalogo() {
		return this.nome + " [" + this.parte_corpo + "] protecao=" + this.protecao +
		       "% desgaste=" + this.desgaste_por_tiro +
		       (this.especial != "" ? " especial=" + this.especial : "");
	}
}

roupa@[] catalogo_roupas;

// ---------------------------------------------------------------------------
// Utilitarios de nome
// ---------------------------------------------------------------------------
string normalizar_nome_de_roupa(string nome) {
	string n = nome.trim_whitespace().lower();
	n = n.replace(" ", "_");
	return n;
}

string chave_usuario_roupas(string username) {
	return username.trim_whitespace().lower();
}

// ---------------------------------------------------------------------------
// Consultas ao catalogo em memoria
// ---------------------------------------------------------------------------
int indice_roupa(string nome) {
	string alvo = normalizar_nome_de_roupa(nome);
	for(uint i = 0; i < catalogo_roupas.length(); i++) {
		if(catalogo_roupas[i].nome == alvo) return int(i);
	}
	return -1;
}

roupa@ obter_roupa(string nome) {
	int idx = indice_roupa(nome);
	if(idx < 0) return null;
	return catalogo_roupas[idx];
}

bool roupa_existe(string nome) {
	if(indice_roupa(nome) >= 0) return true;
	if(!database_initialized || bancoJogo is null) return false;

	sqlite3statement@ stmt = bancoJogo.prepare("SELECT 1 FROM clothes_catalog WHERE nome = ?;");
	if(@stmt == null) return false;
	stmt.bind_text(1, normalizar_nome_de_roupa(nome));
	return stmt.step() == SQLITE_ROW;
}

// ---------------------------------------------------------------------------
// Criacao das tabelas
// ---------------------------------------------------------------------------
void criar_tabelas_roupas() {
	if(!database_initialized || bancoJogo is null) {
		debug_log("ERRO: criar_tabelas_roupas - Banco nao inicializado");
		return;
	}

	debug_log("Criando tabela clothes_catalog...");

	string criar_catalogo = """
		CREATE TABLE IF NOT EXISTS clothes_catalog (
			nome TEXT PRIMARY KEY,
			parte_corpo TEXT NOT NULL,
			descricao TEXT DEFAULT '',
			som_vestir TEXT DEFAULT '',
			som_tirar TEXT DEFAULT '',
			mostrar_para_todos INTEGER DEFAULT 1,
			permite_desgaste INTEGER DEFAULT 1,
			desgaste_por_tiro REAL DEFAULT 0.5,
			protecao REAL DEFAULT 0,
			especial TEXT DEFAULT '',
			criado_por TEXT DEFAULT 'system',
			criado_em DATETIME DEFAULT CURRENT_TIMESTAMP
		);
	""";

	if(bancoJogo.execute(criar_catalogo) != SQLITE_OK) {
		debug_log("ERRO ao criar tabela clothes_catalog: " + bancoJogo.get_last_error_text());
	} else {
		debug_log("OK - Tabela clothes_catalog criada/verificada");
	}

	string criar_vestidas = """
		CREATE TABLE IF NOT EXISTS player_clothing (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			username TEXT NOT NULL,
			nome_roupa TEXT NOT NULL,
			parte_corpo TEXT NOT NULL,
			degradacao REAL DEFAULT 0,
			vestida_em DATETIME DEFAULT CURRENT_TIMESTAMP,
			UNIQUE(username, nome_roupa),
			UNIQUE(username, parte_corpo)
		);
	""";

	if(bancoJogo.execute(criar_vestidas) != SQLITE_OK) {
		debug_log("ERRO ao criar tabela player_clothing: " + bancoJogo.get_last_error_text());
	} else {
		debug_log("OK - Tabela player_clothing criada/verificada");
	}

	bancoJogo.execute("CREATE INDEX IF NOT EXISTS idx_player_clothing_username ON player_clothing(username);");
}

// ---------------------------------------------------------------------------
// Seed do catalogo padrao
// ---------------------------------------------------------------------------
void semear_roupa_padrao(string nome, string parte, string descricao, string som_vestir,
                         string som_tirar, int mostrar, int desgasta, double desgaste,
                         double protecao, string especial = "") {
	if(!database_initialized || bancoJogo is null) return;

	string query = """
		INSERT OR IGNORE INTO clothes_catalog
			(nome, parte_corpo, descricao, som_vestir, som_tirar,
			 mostrar_para_todos, permite_desgaste, desgaste_por_tiro, protecao, especial, criado_por)
		VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'system');
	""";

	sqlite3statement@ stmt = bancoJogo.prepare(query);
	if(@stmt == null) {
		debug_log("ERRO ao preparar semear_roupa_padrao: " + bancoJogo.get_last_error_text());
		return;
	}

	stmt.bind_text(1, normalizar_nome_de_roupa(nome));
	stmt.bind_text(2, parte);
	stmt.bind_text(3, descricao);
	stmt.bind_text(4, som_vestir);
	stmt.bind_text(5, som_tirar);
	stmt.bind_int(6, mostrar);
	stmt.bind_int(7, desgasta);
	stmt.bind_double(8, desgaste);
	stmt.bind_double(9, protecao);
	stmt.bind_text(10, especial);
	stmt.step();
}

