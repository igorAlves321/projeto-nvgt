	semear_roupa_padrao("chapeu_panama", PARTE_CABECA, "na cabeca, um chapeu panama.", "bonedraw", "retirarcapacete2", 1, 1, 0.2, 1.0);
	semear_roupa_padrao("bone_mizuno", PARTE_CABECA, "na cabeca, um bone mizuno.", "bonedraw", "retirarcapacete2", 1, 1, 0.2, 1.0);

