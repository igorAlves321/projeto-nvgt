// refletir.nvgt - Sistema de Reflexo de Dano
// Extraído de comandos.nvgt para uso com o novo sistema de NPCs

// Função de reflexo de dano
// Retorna o dano que será refletido ao atacante
int refletir(int index, string nome, int x, int y, int dano) {
	// Verificar se jogador tem star2 (escudo de reflexo)
	if (!players[index].star2) return 0;
	
	// Sons de reflexo
	server_broadcast("play lih.ogg " + players[index].x + " " + players[index].y, players[index].map);
	server_broadcast("rico " + nome + "apanhando1.ogg " + x + " " + y, players[index].map);
	
	return dano;
}
