
int refletir(int index, string nome, int x, int y, int dano) {
	if (!players[index].star2) return 0;

	server_broadcast("play lih.ogg " + players[index].x + " " + players[index].y, players[index].map);
	server_broadcast("rico " + nome + "apanhando1.ogg " + x + " " + y, players[index].map);

	return dano;
}
