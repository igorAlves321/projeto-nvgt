// consumables.nvgt - Sistema de Itens Consumíveis do EVM Server
// Conversão: BGT → NVGT
// Gerencia efeitos de poções, comida, joias e buffs temporários

// =====================================================
// CLASSE DE EFEITO CONSUMÍVEL
// =====================================================

class consumable_effect {
	string item_name;
	string effect_type;  // "health", "sanity", "food", "buff", "xp", "gold", "cure"
	int value;           // Valor do efeito (HP, sanity, etc)
	int duration_ms;     // Duração do buff em milissegundos (0 = instantâneo)
	string buff_name;    // Nome da variável de buff (ex: "antimina")
	string sound;        // Som ao usar
	string message;      // Mensagem ao jogador
	
	consumable_effect(string name, string type, int val, int dur = 0, string buff = "", string snd = "", string msg = "") {
		item_name = name;
		effect_type = type;
		value = val;
		duration_ms = dur;
		buff_name = buff;
		sound = snd;
		message = msg;
	}
}

// =====================================================
// ESTRUTURA DE BUFF ATIVO
// =====================================================

class active_buff {
	string player_name;
	string buff_name;
	int value;
	timer duration_timer;
	int duration_ms;
	
	active_buff(string p, string b, int v, int d) {
		player_name = p;
		buff_name = b;
		value = v;
		duration_ms = d;
		duration_timer.restart();
	}
	
	bool is_expired() {
		return duration_timer.elapsed >= duration_ms;
	}
}

// =====================================================
// ARRAYS GLOBAIS
// =====================================================

dictionary consumables;           // item_name => consumable_effect
active_buff@[] active_buffs;      // Lista de buffs ativos

// =====================================================
// INICIALIZAÇÃO DO SISTEMA
// =====================================================

