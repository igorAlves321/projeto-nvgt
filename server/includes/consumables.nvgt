
class consumable_effect {
	string item_name;
	string effect_type;
	int value;
	int duration_ms;
	string buff_name;
	string sound;
	string message;

	string teleport_map;
	int teleport_x;
	int teleport_y;
	string items_to_give;
	double thirst_reduce;
	double thirst_fill;
	double hunger_reduce;
	double hunger_fill;
	double degradation;

	consumable_effect(string name, string type, int val, int dur = 0, string buff = "", string snd = "", string msg = "") {
		item_name = name;
		effect_type = type;
		value = val;
		duration_ms = dur;
		buff_name = buff;
		sound = snd;
		message = msg;
		teleport_map = "";
		teleport_x = 0;
		teleport_y = 0;
		items_to_give = "";
		thirst_reduce = 0;
		thirst_fill = 0;
		hunger_reduce = 0;
		hunger_fill = 0;
		degradation = 0;
	}

	consumable_effect(string name, string type, int val, int dur, string buff, string snd, string msg,
	                   string tele_map, int tele_x, int tele_y, string give_items,
	                   double th_reduce, double th_fill, double hu_reduce, double hu_fill, double degrad) {
		item_name = name;
		effect_type = type;
		value = val;
		duration_ms = dur;
		buff_name = buff;
		sound = snd;
		message = msg;
		teleport_map = tele_map;
		teleport_x = tele_x;
		teleport_y = tele_y;
		items_to_give = give_items;
		thirst_reduce = th_reduce;
		thirst_fill = th_fill;
		hunger_reduce = hu_reduce;
		hunger_fill = hu_fill;
		degradation = degrad;
	}
}

class active_buff {
	string player_name;
	string buff_name;
	int value;
	timer duration_timer;
	int duration_ms;

	active_buff(string p, string b, int v, int d) {
		player_name = p;
		buff_name = b;
		value = v;
		duration_ms = d;
		duration_timer.restart();
	}

	bool is_expired() {
		return duration_timer.elapsed >= duration_ms;
	}
}

dictionary consumables;
active_buff@[] active_buffs;

