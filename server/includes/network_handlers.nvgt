void handle_chat(player@ p, string data) {
    // Formato: mensagem
    // Exemplo: CHAT:OlÃ¡ a todos!
    
    string message = data.trim_whitespace();
    if(message.length() == 0) return;

    debug_log("ðŸ’¬ " + p.name + ": " + message);

    int player_index = get_player_index_from(p.charname);
    if(player_index >= 0) {
        telllocal(player_index, message);
    }
}

void handle_party(player@ p, string data) {
    // Formato: action|params
    // Exemplo: PARTY:invite|JoÃ£o
    // Exemplo: PARTY:accept
    // Exemplo: PARTY:leave

    if(!network_require_non_empty(p, "handle_party", data)) return;
    string[] parts = split_pipe_trimmed(data);
    if(parts.length() < 1 || parts[0] == "") {
        network_log_invalid_payload(p, "handle_party", "aÃ§Ã£o ausente", data);
        return;
    }

    string action = parts[0];

    debug_log("ðŸ‘¥ " + p.name + " - party: " + action);

    int player_index = get_player_index_from(p.charname);
    if(player_index < 0) return;

    if(action == "create") {
        cmd_createparty(player_index);
    } else if(action == "invite" && parts.length() >= 2) {
        cmd_invite(player_index, parts[1]);
    } else if(action == "join" || action == "accept") {
        cmd_joinparty(player_index);
    } else if(action == "leave") {
        cmd_leaveparty(player_index);
    } else if(action == "kick" && parts.length() >= 2) {
        cmd_kickparty(player_index, parts[1]);
    } else if(action == "disband") {
        cmd_disbandparty(player_index);
    } else if(action == "chat") {
        cmd_partychat(player_index, join_parts_from(parts, 1, "|"));
    } else if(action == "info" || action == "list") {
        cmd_partyinfo(player_index);
    } else {
        network_send_action_error(p, "Party", action);
    }
}

void handle_guild(player@ p, string data) {
    // Formato: action|params
    // Exemplo: GUILD:create|MinhaGuild
    // Exemplo: GUILD:invite|JoÃ£o
    // Exemplo: GUILD:leave

