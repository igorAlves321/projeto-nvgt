    if(!p.is_admin) return;

    string[] parts = data.split("|");
    if(parts.length() < 1) return;

    string command = parts[0];

    debug_log("👑 ADMIN " + p.name + ": " + command);

    // TODO: Implementar comandos admin completos (admin_commands.nvgt já existe)
    send_reliable(p.peer_id, "say Admin command: " + command, 0);
}

void handle_builder(player@ p, string data) {
    // Formato: action|params
    // Exemplo: BUILDER:create|wall|100|50
    // Exemplo: BUILDER:delete|obj_123

    if(!p.constructor && !p.is_admin) return;

    string[] parts = data.split("|");
    if(parts.length() < 1) return;

    string action = parts[0];

    debug_log("🏗️ BUILDER " + p.name + ": " + action);

    // TODO: Integrar com builder.nvgt existente
    send_reliable(p.peer_id, "say Builder: " + action, 0);
}

// ============================================================
// 8. HANDLERS DE SISTEMA
// ============================================================

void handle_ping(player@ p) {
    // Responder com PONG
    send_reliable(p.peer_id, MSG_PONG, 0);
}

void handle_update(player@ p, string data) {
    // Atualização de estado do cliente
    // Formato: stat_name|value
    // Exemplo: UPDATE:health|80

    string[] parts = data.split("|");
    if(parts.length() < 2) return;

    string stat_name = parts[0];
    string value = parts[1];

    // Aceitar atualizações limitadas do cliente
    // (maioria das stats são server-side)
}

// ============================================================
// FUNÇÃO PRINCIPAL DE PROCESSAMENTO
// ============================================================

// Esta função substitui/complementa o process_player_command() existente
// Ela verifica se a mensagem usa o novo protocolo, senão usa fallback
void process_network_message(uint64 peer_id, string message) {
    player@ p = get_player_by_peer(peer_id);
    if(p is null) {
        debug_log("⚠️ Mensagem de peer não autenticado: " + peer_id);
        return;
    }

    // Verificar se usa novo protocolo (tem dois pontos no início)
    if(message.find(":") > 0 && message.find(":") < 15) {
        // Usa novo protocolo, dispatch
        dispatch_network_message(p, message);
    } else {
        // Usa protocolo antigo, fallback para process_player_command
        process_player_command(peer_id, message);
    }
}

