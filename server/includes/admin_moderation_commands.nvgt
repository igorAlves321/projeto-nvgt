void cmd_tempban(int player_index, string target_name, double days, string reason = "Violacao das regras") {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "tempban", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "tempban", "Nome de jogador invalido!");
		return;
	}
	if(days < 0.001 || days > 365.0) {
		send_admin_error(player_index, "tempban", "Duracao invalida! Use valores entre 0.001 e 365 dias.");
		return;
	}
	if(reason.length() > ADMIN_MAX_REASON_LEN) reason = reason.substr(0, ADMIN_MAX_REASON_LEN);

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "tempban", "Jogador '" + target_name + "' não encontrado!");
		return;
	}
	string motivo_guarda;
	if(!can_moderate(players[player_index].charname, target_name, motivo_guarda)) {
		send_admin_error(player_index, "tempban", motivo_guarda);
		return;
	}

	double minutes = days * 1440.0;
	string admin_name = players[player_index].charname;
	string computer_id = players[target].computer_id;
	if(!add_ban_db(target_name, computer_id, "", admin_name, reason, int(minutes))) {
		create_temp_ban(target_name, minutes, 0.0, reason, computer_id);
		debug_log("WARN: Fallback para create_temp_ban() - SQL falhou");
	}

	eadm(admin_name + " baniu temporariamente " + target_name + " por " + days + " dias. Razão: " + reason);
	send_reliable_text(players[target].peer_id, "msg2 Você foi banido temporariamente por " + days + " dias. Razão: " + reason, 0);
	debug_log("ADMIN: " + players[player_index].charname + " baniu " + target_name + " por " + days + " dias");

	uint64 target_peer = players[target].peer_id;
	force_disconnect_and_cleanup(target_peer, true);
}

void cmd_ban(int player_index, string target_name, string reason = "Violacao das regras") {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "ban", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "ban", "Nome de jogador inválido!");
		return;
	}
	if(reason.length() > ADMIN_MAX_REASON_LEN) reason = reason.substr(0, ADMIN_MAX_REASON_LEN);

	string motivo_guarda;
	if(!can_moderate(players[player_index].charname, target_name, motivo_guarda)) {
		send_admin_error(player_index, "ban", motivo_guarda);
		return;
	}

	int target = get_player_index_from(target_name);

	string computer_id = (target != -1) ? players[target].computer_id : "";
	string admin_name = players[player_index].charname;
	if(!add_ban_db(target_name, computer_id, "", admin_name, reason, 0)) {
		create_temp_ban(target_name, 525600.0 * 10, 0.0, reason, computer_id);
		debug_log("WARN: Fallback para create_temp_ban() - SQL falhou");
	}

	eadm(admin_name + " baniu permanentemente " + target_name + ". Razão: " + reason);
	if(target != -1) {
		send_reliable_text(players[target].peer_id, "msg2 Você foi banido permanentemente. Razão: " + reason, 0);
	}
	debug_log("ADMIN: " + players[player_index].charname + " baniu PERMANENTEMENTE " + target_name);
}

void cmd_unban(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "unban", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "unban", "Nome de jogador inválido!");
		return;
	}

	bool unbanned = unban_player_db(target_name);
	bool legacy_removed = remove_temp_ban(target_name);
	if(unbanned || legacy_removed) {
		send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " foi desbanido.", 0);
		eadm(players[player_index].charname + " desbaniu " + target_name);
		debug_log("ADMIN: " + players[player_index].charname + " desbaniu " + target_name);
	} else {
		send_admin_error(player_index, "unban", "Jogador não está banido ou ban não encontrado.");
	}
}

void cmd_silenciar(int player_index, string target_name, int minutes = 10) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "silenciar", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "silenciar", "Nome de jogador inválido!");
		return;
	}
	if(minutes < 1 || minutes > ADMIN_MAX_DURATION) {
		send_admin_error(player_index, "silenciar", "Duracao invalida!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "silenciar", "Jogador não encontrado!");
		return;
	}

	string motivo_guarda;
	if(!can_moderate(players[player_index].charname, target_name, motivo_guarda)) {
		send_admin_error(player_index, "silenciar", motivo_guarda);
		return;
	}

	players[target].is_muted = true;
	players[target].mute_end_time = ticks() + (minutes * 60 * 1000);
	send_reliable_text(players[target].peer_id, "msg2 Você foi silenciado por " + minutes + " minutos.", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " foi silenciado por " + minutes + " minutos.", 0);
	debug_log("ADMIN: " + players[player_index].charname + " silenciou " + target_name + " por " + minutes + " min");
}

void cmd_unsilenciar(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "unsilenciar", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "unsilenciar", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "unsilenciar", "Jogador não encontrado!");
		return;
	}

	players[target].is_muted = false;
	players[target].mute_end_time = 0;
	send_reliable_text(players[target].peer_id, "msg2 Seu silencio foi removido.", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 SilAncio de " + target_name + " removido.", 0);
	debug_log("ADMIN: " + players[player_index].charname + " removeu silencio de " + target_name);
}

void cmd_prender(int player_index, string target_name, int minutes, string reason) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "prender", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "prender", "Nome de jogador inválido!");
		return;
	}
	if(minutes < 1 || minutes > ADMIN_MAX_DURATION) {
		send_admin_error(player_index, "prender", "Duracao invalida!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "prender", "Jogador não encontrado!");
		return;
	}

	players[target].arrested = true;
	players[target].arrest_end_time = ticks() + (minutes * 60 * 1000);
	players[target].arrest_reason = reason;
	teleport_player(target, "prisao", 0, 0, 0);
	send_reliable_text(players[target].peer_id, "msg2 Você foi preso por " + minutes + " minutos. Razão: " + reason, 0);
	eadm(players[player_index].charname + " prendeu " + target_name + " por " + minutes + " min. Razão: " + reason);
	debug_log("ADMIN: " + players[player_index].charname + " prendeu " + target_name);
}

void cmd_soltar(int player_index, string target_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "soltar", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "soltar", "Nome de jogador inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "soltar", "Jogador não encontrado!");
		return;
	}
	if(!players[target].arrested) {
		send_admin_error(player_index, "soltar", "Jogador não está preso!");
		return;
	}

	players[target].arrested = false;
	players[target].arrest_end_time = 0;
	players[target].arrest_reason = "";
	teleport_player(target, "spawn", 0, 0, 0);
	send_reliable_text(players[target].peer_id, "msg2 Você foi solto da prisao.", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " foi solto.", 0);
	debug_log("ADMIN: " + players[player_index].charname + " soltou " + target_name);
}
