
class ClientTracker {
    timer window_timer;
    int packet_count = 0;

    int MAX_PPS = 50;

    int violations = 0;
    int MAX_VIOLATIONS = 3;

    bool check_limit() {
        packet_count++;

        if(window_timer.elapsed >= 1000) {
            if(packet_count > MAX_PPS) {
                violations++;
            } else {
                violations = 0;
            }

            packet_count = 0;
            window_timer.restart();

            if(violations >= MAX_VIOLATIONS) {
                return false;
            }
        }

        if(packet_count > MAX_PPS * 4) {
            return false;
        }

        return true;
    }

    string get_stats() {
        return "PPS: " + packet_count + "/" + MAX_PPS + ", Violations: " + violations + "/" + MAX_VIOLATIONS;
    }

    void reset() {
        packet_count = 0;
        violations = 0;
        window_timer.restart();
    }
}

dictionary client_trackers;

ClientTracker@ get_tracker(uint64 peer_id) {
    string key = "" + peer_id;

    if(client_trackers.exists(key)) {
        ClientTracker@ t;
        client_trackers.get(key, @t);
        return t;
    }

    ClientTracker@ new_tracker = ClientTracker();
    client_trackers.set(key, @new_tracker);
    return new_tracker;
}

void remove_tracker(uint64 peer_id) {
    string key = "" + peer_id;
    if(client_trackers.exists(key)) {
        client_trackers.delete(key);
    }
}

bool check_client_rate_limit(uint64 peer_id) {
    ClientTracker@ tracker = get_tracker(peer_id);
    return tracker.check_limit();
}
