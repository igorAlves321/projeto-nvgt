
// Guildas persistem nas tabelas guildas e guilda_membros (ver o fim do
// arquivo). GUILDS_FILE e so o arquivo legado, importado uma unica vez.
const string GUILDS_FILE = "database/guilds.dat";
const uint GUILD_XP_SAVE_INTERVAL_MS = 30000;

class guild {
	string name;
	string leader;
	string[] officers;
	string[] members;
	int guild_gold;
	string tag;
	dictionary storage;
	timer creation_date;
	int max_members;
	int max_officers;
	dictionary pending_invites;
	int level;
	int xp;
	timer xp_save_timer;

	guild(string guild_name, string leader_name, string guild_tag) {
		this.name = guild_name;
		this.leader = leader_name;
		this.tag = guild_tag;
		this.guild_gold = 0;
		this.max_members = 50;
		this.max_officers = 5;
		this.level = 1;
		this.xp = 0;
		members.insert_last(leader_name);
		creation_date.restart();
	}

	bool is_member(string player_name) {
		if(leader == player_name) return true;

		for(uint i = 0; i < officers.length(); i++) {
			if(officers[i] == player_name) return true;
		}

		for(uint i = 0; i < members.length(); i++) {
			if(members[i] == player_name) return true;
		}

		return false;
	}

	bool is_leader(string player_name) {
		return leader == player_name;
	}

	bool is_officer(string player_name) {
		if(leader == player_name) return true;

		for(uint i = 0; i < officers.length(); i++) {
			if(officers[i] == player_name) return true;
		}

		return false;
	}

	bool is_full() {
		return (officers.length() + members.length() + 1) >= uint(max_members);
	}

	int member_count() {
		return officers.length() + members.length() + 1;
	}

	void add_member(string player_name) {
		if(!is_member(player_name) && !is_full()) {
			members.insert_last(player_name);
		}
	}

	void remove_member(string player_name) {
		for(uint i = 0; i < officers.length(); i++) {
			if(officers[i] == player_name) {
				officers.remove_at(i);
				return;
			}
		}

		for(uint i = 0; i < members.length(); i++) {
			if(members[i] == player_name) {
				members.remove_at(i);
				return;
			}
		}
	}

	void promote_to_officer(string player_name) {
		if(officers.length() >= uint(max_officers)) return;

		for(uint i = 0; i < members.length(); i++) {
			if(members[i] == player_name) {
				members.remove_at(i);
				officers.insert_last(player_name);
				return;
			}
		}
	}

	void demote_to_member(string player_name) {
		for(uint i = 0; i < officers.length(); i++) {
			if(officers[i] == player_name) {
				officers.remove_at(i);
				members.insert_last(player_name);
				return;
			}
		}
	}

	void broadcast_message(string message) {
		int leader_idx = get_player_index_from(leader);
		if(leader_idx >= 0) {
			send_reliable_text(players[leader_idx].peer_id, "msg2 [Guild] " + message, 0);
		}

		for(uint i = 0; i < officers.length(); i++) {
			int idx = get_player_index_from(officers[i]);
			if(idx >= 0) {
				send_reliable_text(players[idx].peer_id, "msg2 [Guild] " + message, 0);
			}
		}

		for(uint i = 0; i < members.length(); i++) {
			int idx = get_player_index_from(members[i]);
			if(idx >= 0) {
				send_reliable_text(players[idx].peer_id, "msg2 [Guild] " + message, 0);
			}
		}
	}

	void add_invite(string player_name) {
		pending_invites.set(player_name, "" + time_stamp());
	}

	bool has_invite(string player_name) {
		return pending_invites.exists(player_name);
	}

	void remove_invite(string player_name) {
		pending_invites.delete(player_name);
	}

	void add_gold(int amount) {
		guild_gold += amount;
	}

	void remove_gold(int amount) {
		guild_gold -= amount;
		if(guild_gold < 0) guild_gold = 0;
	}

	void add_xp(int amount) {
		xp += amount;

		bool subiu = false;
		while(xp >= get_required_xp_for_level(level + 1) && level < 10) {
			level++;
			subiu = true;
			broadcast_message("Guild subiu para nAvel " + level + "!");
		}

		// XP de guilda entra a cada abate: grava no banco no maximo a cada
		// GUILD_XP_SAVE_INTERVAL_MS, ou na hora quando sobe de nivel.
		if(subiu || xp_save_timer.elapsed >= GUILD_XP_SAVE_INTERVAL_MS) {
			xp_save_timer.restart();
			guilda_db_salvar_progresso(this);
		}
	}

	int get_required_xp_for_level(int target_level) {
		return target_level * target_level * 1000;
	}
}

guild@[] active_guilds;

dictionary player_guilds;

void guild_save_social_state_if_online(string player_name) {
	int idx = get_player_index_from(player_name);
	if(idx >= 0) save_player_to_database(players[idx]);
}

guild@ get_player_guild(string player_name) {
	if(!player_guilds.exists(player_name)) return null;

	string guild_name = string(player_guilds[player_name]);

	for(uint i = 0; i < active_guilds.length(); i++) {
		if(active_guilds[i].name == guild_name) {
			return active_guilds[i];
		}
	}

	return null;
}

bool is_in_guild(string player_name) {
	return player_guilds.exists(player_name);
}

guild@ get_guild_by_name(string guild_name) {
	for(uint i = 0; i < active_guilds.length(); i++) {
		if(active_guilds[i].name == guild_name) {
			return active_guilds[i];
		}
	}
	return null;
}

void cmd_createguild(int player_index, string guild_name, string guild_tag = "") {
	if(is_in_guild(players[player_index].charname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você ja está em uma guild!", 0);
		return;
	}

	int cost = 10000;
	if(players[player_index].gold < cost) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Criar guild custa " + cost + " gold!", 0);
		return;
	}

	if(guild_name.length() < 3 || guild_name.length() > 20) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Nome deve ter entre 3 e 20 caracteres!", 0);
		return;
	}

	if(get_guild_by_name(guild_name) !is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Ja existe uma guild com esse nome!", 0);
		return;
	}

	if(guild_tag == "") {
		guild_tag = guild_name.substr(0, 3).upper();
	}

	if(guild_tag.length() > 5) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Tag deve ter no maximo 5 caracteres!", 0);
		return;
	}

	players[player_index].gold -= cost;

	guild g(guild_name, players[player_index].charname, guild_tag);
	active_guilds.insert_last(g);
	player_guilds.set(players[player_index].charname, guild_name);
	guild_save_social_state_if_online(players[player_index].charname);

	send_reliable_text(players[player_index].peer_id, "msg2 Guild '" + guild_name + "' criada! Tag: [" + guild_tag + "]", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Você e o líder. Use /inviteguild para convidar membros", 0);

	debug_log("GUILD: " + players[player_index].charname + " criou guild '" + guild_name + "'");
	save_guilds();
}

void cmd_inviteguild(int player_index, string target_name) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	if(!g.is_officer(players[player_index].charname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Apenas líder e oficiais podem convidar!", 0);
		return;
	}

	if(g.is_full()) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Guild cheia! Maximo: " + g.max_members + " membros", 0);
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Jogador não encontrado!", 0);
		return;
	}

	if(is_in_guild(target_name)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] " + target_name + " ja está em uma guild!", 0);
		return;
	}

	g.add_invite(target_name);

	send_reliable_text(players[player_index].peer_id, "msg2 Convite enviado para " + target_name, 0);
	send_reliable_text(players[target].peer_id, "msg2 Você foi convidado para a guild '" + g.name + "' [" + g.tag + "]!", 0);
	send_reliable_text(players[target].peer_id, "msg2 Use /joinguild para aceitar", 0);

	debug_log("GUILD: " + players[player_index].charname + " convidou " + target_name + " para '" + g.name + "'");
}

void cmd_joinguild(int player_index) {
	if(is_in_guild(players[player_index].charname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você ja está em uma guild!", 0);
		return;
	}

	guild@ found_guild = null;
	for(uint i = 0; i < active_guilds.length(); i++) {
		if(active_guilds[i].has_invite(players[player_index].charname)) {
			@found_guild = active_guilds[i];
			break;
		}
	}

	if(found_guild is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não tem convites pendentes!", 0);
		return;
	}

	if(found_guild.is_full()) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Guild cheia!", 0);
		found_guild.remove_invite(players[player_index].charname);
		return;
	}

	found_guild.add_member(players[player_index].charname);
	found_guild.remove_invite(players[player_index].charname);
	player_guilds.set(players[player_index].charname, found_guild.name);
	guild_save_social_state_if_online(players[player_index].charname);

	send_reliable_text(players[player_index].peer_id, "msg2 Você entrou na guild '" + found_guild.name + "' [" + found_guild.tag + "]!", 0);
	found_guild.broadcast_message(players[player_index].charname + " entrou na guild!");

	debug_log("GUILD: " + players[player_index].charname + " entrou em '" + found_guild.name + "'");
	save_guilds();
}

void cmd_leaveguild(int player_index) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	string pname = players[player_index].charname;

	if(g.is_leader(pname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 Como líder, use /disbandguild para dissolver a guild", 0);
		return;
	}

	g.remove_member(pname);
	player_guilds.delete(pname);
	guild_save_social_state_if_online(pname);

	g.broadcast_message(pname + " saiu da guild");
	send_reliable_text(players[player_index].peer_id, "msg2 Você saiu da guild", 0);

	debug_log("GUILD: " + pname + " saiu de '" + g.name + "'");
	save_guilds();
}

void cmd_kickguild(int player_index, string target_name) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	if(!g.is_officer(players[player_index].charname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Apenas líder e oficiais podem expulsar!", 0);
		return;
	}

	if(!g.is_member(target_name)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] " + target_name + " não está na guild!", 0);
		return;
	}

	if(g.is_leader(target_name)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não pode expulsar o líder!", 0);
		return;
	}

	if(g.is_officer(target_name) && !g.is_leader(players[player_index].charname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Apenas o líder pode expulsar oficiais!", 0);
		return;
	}

	int target = get_player_index_from(target_name);
	if(target >= 0) {
		send_reliable_text(players[target].peer_id, "msg2 Você foi expulso da guild!", 0);
	}

	g.remove_member(target_name);
	player_guilds.delete(target_name);
	guild_save_social_state_if_online(target_name);

	g.broadcast_message(target_name + " foi expulso da guild");

	debug_log("GUILD: " + players[player_index].charname + " expulsou " + target_name + " de '" + g.name + "'");
	save_guilds();
}

void cmd_disbandguild(int player_index) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	if(!g.is_leader(players[player_index].charname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Apenas o líder pode dissolver a guild!", 0);
		return;
	}

	g.broadcast_message("Guild '" + g.name + "' foi dissolvida pelo líder");
	guild_save_social_state_if_online(g.leader);
	for(uint i = 0; i < g.officers.length(); i++) {
		guild_save_social_state_if_online(g.officers[i]);
	}
	for(uint i = 0; i < g.members.length(); i++) {
		guild_save_social_state_if_online(g.members[i]);
	}

	player_guilds.delete(g.leader);
	for(uint i = 0; i < g.officers.length(); i++) {
		player_guilds.delete(g.officers[i]);
	}
	for(uint i = 0; i < g.members.length(); i++) {
		player_guilds.delete(g.members[i]);
	}

	for(uint i = 0; i < active_guilds.length(); i++) {
		if(active_guilds[i].name == g.name) {
			active_guilds.remove_at(i);
			break;
		}
	}

	debug_log("GUILD: '" + g.name + "' dissolvida por " + players[player_index].charname);
	save_guilds();
}

void cmd_guildchat(int player_index, string message) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	if(social_barrar_fala(player_index)) return;

	// Mesma lista de guild.broadcast_message(), mas pulando quem ignorou o
	// remetente.
	string remetente = players[player_index].charname;
	string[] destinos;
	destinos.insert_last(g.leader);
	for(uint i = 0; i < g.officers.length(); i++) destinos.insert_last(g.officers[i]);
	for(uint i = 0; i < g.members.length(); i++) destinos.insert_last(g.members[i]);

	string[] enviados;
	string texto = filter_message(message);
	for(uint i = 0; i < destinos.length(); i++) {
		if(enviados.find(destinos[i]) >= 0) continue;
		enviados.insert_last(destinos[i]);

		int idx = get_player_index_from(destinos[i]);
		if(idx < 0) continue;
		if(idx != player_index && players[idx].has_muted(remetente)) continue;
		send_reliable_text(players[idx].peer_id, "msg2 [Guild] " + remetente + ": " + texto, 0);
	}
}

void cmd_guildinfo(int player_index) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	send_reliable_text(players[player_index].peer_id, "msg2 === Guild: " + g.name + " [" + g.tag + "] ===", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Lider: " + g.leader, 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Nivel: " + g.level + " (XP: " + g.xp + ")", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Membros: " + g.member_count() + "/" + g.max_members, 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Tesouro: " + g.guild_gold + " gold", 0);

	if(g.officers.length() > 0) {
		send_reliable_text(players[player_index].peer_id, "msg2 Oficiais: " + g.officers.length(), 0);
		for(uint i = 0; i < g.officers.length(); i++) {
			send_reliable_text(players[player_index].peer_id, "msg2 - " + g.officers[i], 0);
		}
	}
}

void cmd_promoteguild(int player_index, string target_name) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	if(!g.is_leader(players[player_index].charname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Apenas o líder pode promover!", 0);
		return;
	}

	if(g.officers.length() >= uint(g.max_officers)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Maximo de oficiais atingido! (" + g.max_officers + ")", 0);
		return;
	}

	g.promote_to_officer(target_name);
	g.broadcast_message(target_name + " foi promovido a oficial!");

	debug_log("GUILD: " + target_name + " promovido em '" + g.name + "'");
	save_guilds();
}

void cmd_demoteguild(int player_index, string target_name) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	if(!g.is_leader(players[player_index].charname)) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Apenas o líder pode rebaixar!", 0);
		return;
	}

	g.demote_to_member(target_name);
	g.broadcast_message(target_name + " foi rebaixado a membro");

	debug_log("GUILD: " + target_name + " rebaixado em '" + g.name + "'");
	save_guilds();
}

void cmd_donateguild(int player_index, int amount) {
	guild@ g = get_player_guild(players[player_index].charname);
	if(g is null) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não está em uma guild!", 0);
		return;
	}

	if(amount <= 0) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Quantidade invalida!", 0);
		return;
	}

	if(players[player_index].gold < amount) {
		send_reliable_text(players[player_index].peer_id, "msg2 [ERRO] Você não tem " + amount + " gold!", 0);
		return;
	}

	players[player_index].gold -= amount;
	g.add_gold(amount);

	g.broadcast_message(players[player_index].charname + " doou " + amount + " gold!");

	debug_log("GUILD: " + players[player_index].charname + " doou " + amount + " gold para '" + g.name + "'");

	save_guilds();
}

// Formato do guilds.dat legado: nome|lider|tag|ouro|nivel|xp|oficiais|membros
guild@ deserialize_guild(string data) {
	string[] parts = data.split("|");
	if(parts.length() < 8) return null;

	string name = parts[0];
	string leader = parts[1];
	string tag = parts[2];
	int gold = parse_int(parts[3]);
	int lvl = parse_int(parts[4]);
	int gxp = parse_int(parts[5]);
	string officers_str = parts[6];
	string members_str = parts[7];

	guild g(name, leader, tag);
	g.guild_gold = gold;
	g.level = lvl;
	g.xp = gxp;

	g.members.resize(0);

	if(officers_str != "") {
		string[] offs = officers_str.split(",");
		for(uint i = 0; i < offs.length(); i++) {
			if(offs[i] != "") {
				g.officers.insert_last(offs[i]);
			}
		}
	}

	if(members_str != "") {
		string[] mems = members_str.split(",");
		for(uint i = 0; i < mems.length(); i++) {
			if(mems[i] != "") {
				g.members.insert_last(mems[i]);
			}
		}
	}

	return g;
}

// --------------------------------------------------------------------------
// Persistencia no SQLite
// --------------------------------------------------------------------------
// guildas(id, nome, lider, tag, ouro, nivel, xp, max_membros, max_oficiais)
// guilda_membros(guilda_id, username, cargo, ordem)  cargo: lider/oficial/membro
//
// As guildas continuam em memoria (active_guilds / player_guilds); o banco e
// regravado por save_guilds() a cada mudanca, como o arquivo era.

bool guildas_tabelas_ok = false;
bool guildas_carregadas = false;

bool guildas_garantir_tabelas() {
	if(guildas_tabelas_ok) return true;
	if(!database_initialized || bancoJogo is null) return false;

	string criar_guildas = """
		CREATE TABLE IF NOT EXISTS guildas (
			id INTEGER PRIMARY KEY AUTOINCREMENT,
			nome TEXT UNIQUE NOT NULL,
			lider TEXT NOT NULL,
			tag TEXT DEFAULT '',
			ouro INTEGER DEFAULT 0,
			nivel INTEGER DEFAULT 1,
			xp INTEGER DEFAULT 0,
			max_membros INTEGER DEFAULT 50,
			max_oficiais INTEGER DEFAULT 5,
			criada_em DATETIME DEFAULT CURRENT_TIMESTAMP
		);
	""";

	string criar_membros = """
		CREATE TABLE IF NOT EXISTS guilda_membros (
			username TEXT PRIMARY KEY,
			guilda_id INTEGER NOT NULL,
			cargo TEXT NOT NULL DEFAULT 'membro',
			ordem INTEGER DEFAULT 0
		);
	""";

	if(bancoJogo.execute(criar_guildas) != SQLITE_OK) {
		debug_log("ERRO ao criar tabela guildas: " + bancoJogo.get_last_error_text());
		return false;
	}

	if(bancoJogo.execute(criar_membros) != SQLITE_OK) {
		debug_log("ERRO ao criar tabela guilda_membros: " + bancoJogo.get_last_error_text());
		return false;
	}

	bancoJogo.execute("CREATE INDEX IF NOT EXISTS idx_guilda_membros_guilda ON guilda_membros(guilda_id);");

	guildas_tabelas_ok = true;
	return true;
}

int guilda_db_id(string nome) {
	if(!guildas_garantir_tabelas()) return -1;

	sqlite3statement@ stmt = bancoJogo.prepare("SELECT id FROM guildas WHERE nome = ?;");
	if(@stmt == null) return -1;

	stmt.bind_text(1, nome);
	if(stmt.step() != SQLITE_ROW) return -1;

	return stmt.column_int(0);
}

// substituir = true regrava o cargo de quem ja esta na tabela (save normal);
// false preserva o que existe (importacao do arquivo legado).
bool guilda_db_inserir_membro(int guilda_id, string username, string cargo, int ordem, bool substituir) {
	if(username == "") return false;

	string verbo = substituir ? "INSERT OR REPLACE" : "INSERT OR IGNORE";
	sqlite3statement@ stmt = bancoJogo.prepare(verbo + " INTO guilda_membros (username, guilda_id, cargo, ordem) VALUES (?, ?, ?, ?);");
	if(@stmt == null) {
		debug_log("GUILD: erro ao preparar membro: " + bancoJogo.get_last_error_text());
		return false;
	}

	stmt.bind_text(1, username);
	stmt.bind_int(2, guilda_id);
	stmt.bind_text(3, cargo);
	stmt.bind_int(4, ordem);
	return stmt.step() == SQLITE_DONE;
}

// Grava a lista de membros de uma guilda. O lider entra uma vez so, como 'lider'.
void guilda_db_gravar_membros(guild@ g, int guilda_id, bool substituir) {
	int ordem = 0;
	guilda_db_inserir_membro(guilda_id, g.leader, "lider", ordem++, substituir);

	for(uint i = 0; i < g.officers.length(); i++) {
		if(g.officers[i] == g.leader) continue;
		guilda_db_inserir_membro(guilda_id, g.officers[i], "oficial", ordem++, substituir);
	}

	for(uint i = 0; i < g.members.length(); i++) {
		if(g.members[i] == g.leader) continue;
		if(g.officers.find(g.members[i]) >= 0) continue;
		guilda_db_inserir_membro(guilda_id, g.members[i], "membro", ordem++, substituir);
	}
}

bool guilda_db_gravar(guild@ g) {
	if(g is null || g.name == "") return false;
	if(!guildas_garantir_tabelas()) return false;

	{
		sqlite3statement@ inserir = bancoJogo.prepare("INSERT OR IGNORE INTO guildas (nome, lider, tag) VALUES (?, ?, ?);");
		if(@inserir == null) {
			debug_log("GUILD: erro ao preparar insert: " + bancoJogo.get_last_error_text());
			return false;
		}
		inserir.bind_text(1, g.name);
		inserir.bind_text(2, g.leader);
		inserir.bind_text(3, g.tag);
		inserir.step();
	}

	{
		sqlite3statement@ atualizar = bancoJogo.prepare("UPDATE guildas SET lider = ?, tag = ?, ouro = ?, nivel = ?, xp = ?, max_membros = ?, max_oficiais = ? WHERE nome = ?;");
		if(@atualizar == null) {
			debug_log("GUILD: erro ao preparar update: " + bancoJogo.get_last_error_text());
			return false;
		}
		atualizar.bind_text(1, g.leader);
		atualizar.bind_text(2, g.tag);
		atualizar.bind_int(3, g.guild_gold);
		atualizar.bind_int(4, g.level);
		atualizar.bind_int(5, g.xp);
		atualizar.bind_int(6, g.max_members);
		atualizar.bind_int(7, g.max_officers);
		atualizar.bind_text(8, g.name);
		if(atualizar.step() != SQLITE_DONE) {
			debug_log("GUILD: erro ao gravar '" + g.name + "': " + bancoJogo.get_last_error_text());
			return false;
		}
	}

	int guilda_id = guilda_db_id(g.name);
	if(guilda_id <= 0) return false;

	{
		sqlite3statement@ limpar = bancoJogo.prepare("DELETE FROM guilda_membros WHERE guilda_id = ?;");
		if(@limpar == null) return false;
		limpar.bind_int(1, guilda_id);
		limpar.step();
	}

	guilda_db_gravar_membros(g, guilda_id, true);
	return true;
}

// Ouro, nivel e XP de uma guilda, sem regravar a lista de membros.
void guilda_db_salvar_progresso(guild@ g) {
	if(g is null || !guildas_carregadas) return;
	if(!guildas_garantir_tabelas()) return;

	sqlite3statement@ stmt = bancoJogo.prepare("UPDATE guildas SET ouro = ?, nivel = ?, xp = ? WHERE nome = ?;");
	if(@stmt == null) return;

	stmt.bind_int(1, g.guild_gold);
	stmt.bind_int(2, g.level);
	stmt.bind_int(3, g.xp);
	stmt.bind_text(4, g.name);
	stmt.step();
}

void guilda_db_apagar(int guilda_id) {
	sqlite3statement@ membros = bancoJogo.prepare("DELETE FROM guilda_membros WHERE guilda_id = ?;");
	if(@membros != null) {
		membros.bind_int(1, guilda_id);
		membros.step();
	}

	sqlite3statement@ guilda = bancoJogo.prepare("DELETE FROM guildas WHERE id = ?;");
	if(@guilda != null) {
		guilda.bind_int(1, guilda_id);
		guilda.step();
	}
}

void save_guilds() {
	// Sem a carga inicial, a lista em memoria esta vazia: gravar agora
	// apagaria as guildas do banco.
	if(!guildas_carregadas) {
		debug_log("GUILD: save ignorado, guildas ainda nao carregadas do banco");
		return;
	}
	if(!guildas_garantir_tabelas()) {
		debug_log("GUILD: Erro ao salvar guilds (banco indisponivel)");
		return;
	}

	int[] ids_db;
	string[] nomes_db;
	{
		sqlite3statement@ stmt = bancoJogo.prepare("SELECT id, nome FROM guildas;");
		if(@stmt == null) {
			debug_log("GUILD: Erro ao salvar guilds: " + bancoJogo.get_last_error_text());
			return;
		}
		while(stmt.step() == SQLITE_ROW) {
			ids_db.insert_last(stmt.column_int(0));
			nomes_db.insert_last(stmt.column_text(1));
		}
	}

	// Guildas dissolvidas saem do banco.
	for(uint i = 0; i < ids_db.length(); i++) {
		if(get_guild_by_name(nomes_db[i]) is null) guilda_db_apagar(ids_db[i]);
	}

	int salvas = 0;
	for(uint i = 0; i < active_guilds.length(); i++) {
		if(active_guilds[i] is null) continue;
		if(guilda_db_gravar(active_guilds[i])) salvas++;
	}

	debug_log("GUILD: Salvo " + salvas + " guilds");
}

// Importacao unica do guilds.dat: INSERT OR IGNORE, depois vira guilds.dat.migrado.
void guildas_importar_arquivo_legado() {
	if(!file_exists(GUILDS_FILE)) return;

	string content;
	if(!globais_ler_arquivo(GUILDS_FILE, content)) return;

	string[] lines = content.replace("\r", "").split("\n");
	int importadas = 0;

	for(uint i = 0; i < lines.length(); i++) {
		if(lines[i] == "") continue;

		guild@ g = deserialize_guild(lines[i]);
		if(g is null || g.name == "") continue;

		sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR IGNORE INTO guildas (nome, lider, tag, ouro, nivel, xp) VALUES (?, ?, ?, ?, ?, ?);");
		if(@stmt == null) {
			debug_log("GUILD: erro ao importar guilds.dat: " + bancoJogo.get_last_error_text());
			return;
		}
		stmt.bind_text(1, g.name);
		stmt.bind_text(2, g.leader);
		stmt.bind_text(3, g.tag);
		stmt.bind_int(4, g.guild_gold);
		stmt.bind_int(5, g.level);
		stmt.bind_int(6, g.xp);
		if(stmt.step() != SQLITE_DONE) {
			debug_log("GUILD: erro ao importar '" + g.name + "': " + bancoJogo.get_last_error_text());
			return;
		}

		int guilda_id = guilda_db_id(g.name);
		if(guilda_id <= 0) continue;

		guilda_db_gravar_membros(g, guilda_id, false);
		importadas++;
	}

	debug_log("GUILD MIGRACAO: " + importadas + " guilds importadas de " + GUILDS_FILE);
	globais_arquivar_legado(GUILDS_FILE);
}

void load_guilds() {
	if(!guildas_garantir_tabelas()) {
		debug_log("GUILD: Erro ao carregar guilds (banco indisponivel)");
		return;
	}

	guildas_importar_arquivo_legado();

	active_guilds.resize(0);
	player_guilds.delete_all();

	int[] ids;
	{
		sqlite3statement@ stmt = bancoJogo.prepare("SELECT id, nome, lider, tag, ouro, nivel, xp, max_membros, max_oficiais FROM guildas ORDER BY id;");
		if(@stmt == null) {
			debug_log("GUILD: Erro ao carregar guilds: " + bancoJogo.get_last_error_text());
			return;
		}

		while(stmt.step() == SQLITE_ROW) {
			guild g(stmt.column_text(1), stmt.column_text(2), stmt.column_text(3));
			g.members.resize(0);
			g.guild_gold = stmt.column_int(4);
			g.level = stmt.column_int(5);
			g.xp = stmt.column_int(6);
			if(stmt.column_int(7) > 0) g.max_members = stmt.column_int(7);
			if(stmt.column_int(8) > 0) g.max_officers = stmt.column_int(8);

			active_guilds.insert_last(g);
			ids.insert_last(stmt.column_int(0));
		}
	}

	for(uint i = 0; i < active_guilds.length(); i++) {
		guild@ g = active_guilds[i];
		player_guilds.set(g.leader, g.name);

		sqlite3statement@ stmt = bancoJogo.prepare("SELECT username, cargo FROM guilda_membros WHERE guilda_id = ? ORDER BY ordem, rowid;");
		if(@stmt == null) continue;
		stmt.bind_int(1, ids[i]);

		while(stmt.step() == SQLITE_ROW) {
			string username = stmt.column_text(0);
			string cargo = stmt.column_text(1);
			if(username == "" || username == g.leader) continue;

			if(cargo == "oficial") g.officers.insert_last(username);
			else g.members.insert_last(username);
			player_guilds.set(username, g.name);
		}
	}

	guildas_carregadas = true;
	debug_log("GUILD: Carregado " + active_guilds.length() + " guilds");
}

void init_guilds() {
	load_guilds();
}
