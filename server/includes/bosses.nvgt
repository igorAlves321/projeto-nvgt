
#include "globals.nvgt"

enum boss_state {
    BOSS_SLEEPING,
    BOSS_ALIVE,
    BOSS_FIGHTING,
    BOSS_ENRAGED,
    BOSS_DEAD
}

enum boss_ability_type {
    ABILITY_AOE_DAMAGE,
    ABILITY_SUMMON,
    ABILITY_HEAL,
    ABILITY_STUN,
    ABILITY_DOT,
    ABILITY_BUFF_SELF,
    ABILITY_DEBUFF_PLAYERS
}

class boss_ability {
    boss_ability_type type;
    string name;
    string description;
    int cooldown;
    timer last_use;
    int damage;
    int radius;
    int duration;
    string summon_type;
    int summon_count;

    boss_ability() {
        cooldown = 30;
        damage = 0;
        radius = 0;
        duration = 0;
        summon_count = 1;
    }
}

class boss_participant {
    string player_name;
    int damage_dealt;
    int healing_done;
    timer joined_time;

    boss_participant(string name) {
        player_name = name;
        damage_dealt = 0;
        healing_done = 0;
    }
}

class boss {
    int id;
    string name;
    string description;
    int level;
    int max_hp;
    int current_hp;
    int attack_power;
    int defense;
    float x, y, z;
    string map;
    boss_state state;

    dictionary threat_table;
    string current_target;

    boss_ability@[] abilities;
    int enrage_timer_minutes;
    timer fight_start_time;
    timer respawn_timer;
    int respawn_delay_minutes;

    boss_participant@[] participants;
    int required_level;
    int max_participants;

    int guaranteed_gold_min;
    int guaranteed_gold_max;
    int guaranteed_xp;

    int[] phase_thresholds;
    int current_phase;

    // Ataque sem o bonus de furia, restaurado a cada spawn.
    int ataque_base = 0;
    // Quem ja foi avisado de que nao tem nivel para este combate.
    dictionary avisados_nivel;
    // Ligado quando ha um local valido salvo em boss_estado: o chefe nasce
    // sozinho assim que o mapa estiver carregado.
    bool spawn_automatico = false;

    boss() {
        id = 0;
        level = 1;
        max_hp = 10000;
        current_hp = max_hp;
        attack_power = 100;
        defense = 50;
        state = BOSS_SLEEPING;
        enrage_timer_minutes = 15;
        respawn_delay_minutes = 60;
        required_level = 1;
        max_participants = 20;
        guaranteed_gold_min = 1000;
        guaranteed_gold_max = 5000;
        guaranteed_xp = 5000;
        current_phase = 0;
    }

    int get_hp_percent() {
        if (max_hp == 0) return 0;
        return (current_hp * 100) / max_hp;
    }

    bool check_phase_transition() {
        int hp_pct = get_hp_percent();
        for (uint i = current_phase; i < phase_thresholds.length(); i++) {
            if (hp_pct <= phase_thresholds[i]) {
                current_phase = i + 1;
                return true;
            }
        }
        return false;
    }

    void add_threat(string player_name, int amount) {
        int current_threat = 0;
        if (threat_table.exists(player_name)) {
            threat_table.get(player_name, current_threat);
        }
        current_threat += amount;
        threat_table.set(player_name, current_threat);

        update_target();
    }

    void update_target() {
        string[] keys = threat_table.get_keys();
        int max_threat = 0;
        string new_target = "";

        for (uint i = 0; i < keys.length(); i++) {
            int threat;
            threat_table.get(keys[i], threat);
            if (threat > max_threat) {
                max_threat = threat;
                new_target = keys[i];
            }
        }

        if (new_target != current_target && new_target != "") {
            current_target = new_target;
            broadcast_to_participants(name + " mudou de alvo para " + new_target + "!");

            // A entidade no mapa passa a perseguir quem tem mais ameaca.
            monstruo@ m = boss_entidade(id);
            int alvo = get_player_index_from(new_target);
            if (m !is null && alvo > -1) {
                m.p_index = alvo;
                m.update_player.restart();
            }
        }
    }

    bool is_participant(string player_name) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) return true;
        }
        return false;
    }

    void add_participant(string player_name) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                return;
            }
        }

        boss_participant@ bp = boss_participant(player_name);
        participants.insert_last(bp);
    }

    void record_damage(string player_name, int damage) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                participants[i].damage_dealt += damage;
                return;
            }
        }
    }

    void broadcast_to_participants(string message) {
        for (uint i = 0; i < participants.length(); i++) {
            int pidx = get_player_index_from(participants[i].player_name);
            if (pidx < 0) continue;
            loot_enviar_mensagem(players[pidx], message);
        }
    }

    // Coloca o chefe no mundo como um monstro atacavel em (map, x, y).
    // Devolve false, sem mudar o estado, quando o mapa nao esta carregado.
    bool spawn() {
        if (get_map_index_from(this.map) < 0) return false;

        boss_remover_entidade(id);

        if (ataque_base <= 0) ataque_base = attack_power;
        attack_power = ataque_base;

        current_hp = max_hp;
        state = BOSS_ALIVE;
        current_phase = 0;
        threat_table.delete_all();
        avisados_nivel.delete_all();
        participants.resize(0);
        current_target = "";

        monstruo@ m = spawn_monstruo_especial(int(this.x), int(this.y), this.map, this.name, max_hp,
            attack_power * BOSS_DANO_FATOR_MIN, attack_power * BOSS_DANO_FATOR_MAX);
        m.boss_id = id;
        m.distanciaataques = 3;
        m.tiempoparaatacar = 1500;

        send_reliable_text(0, "msg2 ;O chefe; " + name + " ;apareceu em; " + this.map + ";!", 3);
        debug_log("BOSSES: " + name + " nasceu em " + this.map + " (" + int(this.x) + "," + int(this.y) + ")");
        return true;
    }

    void die() {
        if (state == BOSS_DEAD || state == BOSS_SLEEPING) return;

        state = BOSS_DEAD;
        current_hp = 0;
        respawn_timer.restart();

        boss_remover_entidade(id);

        distribute_loot();

        broadcast_to_participants("Você derrotou " + name + "!");
        send_reliable_text(0, "msg2 ;O chefe; " + name + " ;foi derrotado;!", 3);
        debug_log("BOSSES: " + name + " derrotado com " + participants.length() + " participante(s)");

        threat_table.delete_all();
        current_target = "";
    }

    void distribute_loot() {
        if (participants.length() == 0) return;

        int total_damage = 0;
        for (uint i = 0; i < participants.length(); i++) {
            total_damage += participants[i].damage_dealt;
        }

        if (total_damage == 0) return;

        loot_premio@[] premios = boss_loot_carregar(id);

        for (uint i = 0; i < participants.length(); i++) {
            int pidx = get_player_index_from(participants[i].player_name);
            if (pidx < 0) continue;

            float contribution = float(participants[i].damage_dealt) / float(total_damage);

            int gold_reward = int((guaranteed_gold_min + guaranteed_gold_max) / 2 * contribution);

            int xp_reward = int(guaranteed_xp * contribution);

            players[pidx].gold += gold_reward;
            players[pidx].saldo = players[pidx].gold;
            if (xp_reward > 0) ganhaxp(pidx, xp_reward, 0);

            string msg = "Recompensas por derrotar " + name + ":\n";
            msg += "Gold: " + gold_reward + "\n";
            msg += "XP: " + xp_reward + "\n";

            string itens = loot_entregar_premios(players[pidx], premios);
            if (itens != "") {
                msg += "ITENS:\n" + itens;
            }

            loot_enviar_mensagem(players[pidx], msg);
        }
    }

    void use_ability(int ability_index) {
        if (ability_index < 0 || ability_index >= int(abilities.length())) return;

        boss_ability@ ability = abilities[ability_index];

        if (ability.last_use.elapsed < ability.cooldown * 1000) return;

        ability.last_use.restart();

        broadcast_to_participants(name + " usa " + ability.name + "!");

        switch (ability.type) {
            case ABILITY_AOE_DAMAGE:
                broadcast_to_participants("Dano em área! " + ability.damage + " de dano!");
                break;
            case ABILITY_SUMMON:
                broadcast_to_participants(name + " invocou " + ability.summon_count + " " + ability.summon_type + "!");
                break;
            case ABILITY_HEAL:
                current_hp = min(current_hp + ability.damage, max_hp);
                broadcast_to_participants(name + " se curou em " + ability.damage + " de vida!");
                break;
            case ABILITY_STUN:
                broadcast_to_participants("Todos foram atordoados por " + ability.duration + " segundos!");
                break;
            case ABILITY_DOT:
                broadcast_to_participants("Dano contínuo aplicado! " + ability.damage + " de dano por " + ability.duration + " segundos!");
                break;
            case ABILITY_BUFF_SELF:
                broadcast_to_participants(name + " ficou mais forte!");
                break;
            case ABILITY_DEBUFF_PLAYERS:
                broadcast_to_participants("Seus atributos foram reduzidos!");
                break;
        }
    }
}

boss@[] world_bosses;
dictionary boss_by_id;

// O ataque do chefe vira dano por golpe na mesma escala dos monstros comuns.
const int BOSS_DANO_FATOR_MIN = 5;
const int BOSS_DANO_FATOR_MAX = 10;

// ---------------------------------------------------------------------
// Ligacao com o combate. Cada chefe vivo e um monstruo de monstruos_global
// marcado com boss_id; monstruo_global_loop() chama boss_registrar_dano_entidade
// quando ele sofre dano e boss_entidade_morreu quando ele morre.
// ---------------------------------------------------------------------

monstruo@ boss_entidade(int boss_id) {
    if (boss_id <= 0) return null;
    for (uint i = 0; i < monstruos_global.length(); i++) {
        if (monstruos_global[i].boss_id == boss_id && monstruos_global[i].vida > 0) return monstruos_global[i];
    }
    return null;
}

// Nao remove do array (quem remove e monstruo_global_loop): so desliga o
// vinculo e deixa o monstro sem vida para sair no proximo ciclo.
void boss_remover_entidade(int boss_id) {
    if (boss_id <= 0) return;
    for (uint i = 0; i < monstruos_global.length(); i++) {
        if (monstruos_global[i].boss_id != boss_id) continue;
        monstruos_global[i].boss_id = 0;
        monstruos_global[i].vida = 0;
        monstruos_global[i].vida_registrada = 0;
        monstruos_global[i].morreu = true;
    }
}

void boss_registrar_dano_entidade(int boss_id, string autor, int dano, int vida_restante) {
    boss@ b = get_boss(boss_id);
    if (b is null) return;
    if (b.state == BOSS_DEAD || b.state == BOSS_SLEEPING) return;

    b.current_hp = vida_restante > 0 ? vida_restante : 0;

    if (b.state == BOSS_ALIVE) {
        b.state = BOSS_FIGHTING;
        b.fight_start_time.restart();
    }

    int pidx = get_player_index_from(autor);
    if (pidx < 0) return;

    if (!b.is_participant(autor)) {
        if (players[pidx].level < b.required_level) {
            if (!b.avisados_nivel.exists(autor)) {
                b.avisados_nivel.set(autor, 1);
                loot_enviar_mensagem(players[pidx], "Você precisa do nível " + b.required_level + " para receber recompensas de " + b.name + ".");
            }
            return;
        }
        if (int(b.participants.length()) >= b.max_participants) return;

        b.add_participant(autor);
        loot_enviar_mensagem(players[pidx], "Você entrou no combate contra " + b.name + "!");
    }

    b.record_damage(autor, dano);
    b.add_threat(autor, dano);
}

void boss_entidade_morreu(int boss_id) {
    boss@ b = get_boss(boss_id);
    if (b is null) return;
    b.die();
}

// ---------------------------------------------------------------------
// Local de cada chefe no SQLite (tabela boss_estado). /spawnboss grava o
// ponto escolhido pelo administrador; na partida seguinte o chefe volta a
// nascer ali.
// ---------------------------------------------------------------------

void criar_tabela_boss_estado() {
    if(!database_initialized || bancoJogo is null) return;

    string create_boss_estado = """
        CREATE TABLE IF NOT EXISTS boss_estado (
            boss_id INTEGER PRIMARY KEY,
            mapa TEXT NOT NULL,
            x INTEGER DEFAULT 0,
            y INTEGER DEFAULT 0
        );
    """;

    if(bancoJogo.execute(create_boss_estado) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela boss_estado: " + bancoJogo.get_last_error_text());
    }
}

bool boss_salvar_local(boss@ b) {
    if(b is null) return false;
    if(!database_initialized || bancoJogo is null) return false;

    sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR REPLACE INTO boss_estado (boss_id, mapa, x, y) VALUES (?, ?, ?, ?);");
    if(@stmt == null) {
        debug_log("ERRO ao preparar boss_salvar_local: " + bancoJogo.get_last_error_text());
        return false;
    }

    stmt.bind_int(1, b.id);
    stmt.bind_text(2, b.map);
    stmt.bind_int(3, int(b.x));
    stmt.bind_int(4, int(b.y));

    return (stmt.step() == SQLITE_DONE);
}

void init_bosses_system() {
    world_bosses.resize(0);
    boss_by_id.delete_all();

    create_default_bosses();

    init_boss_loot();

    load_bosses_data();
}

// ---------------------------------------------------------------------
// Loot dos chefes no SQLite (tabela boss_loot). O codigo so faz a carga
// inicial com a tabela vazia; em runtime os premios sao lidos do banco.
// ---------------------------------------------------------------------

void criar_tabela_boss_loot() {
    if(!database_initialized || bancoJogo is null) {
        debug_log("ERRO: criar_tabela_boss_loot - Banco não inicializado");
        return;
    }

    string create_boss_loot = """
        CREATE TABLE IF NOT EXISTS boss_loot (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            boss_id INTEGER NOT NULL,
            item_name TEXT NOT NULL,
            qty_min INTEGER DEFAULT 1,
            qty_max INTEGER DEFAULT 1,
            chance REAL DEFAULT 1.0,
            UNIQUE(boss_id, item_name)
        );
    """;

    if(bancoJogo.execute(create_boss_loot) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela boss_loot: " + bancoJogo.get_last_error_text());
    }
}

bool boss_loot_inserir(int boss_id, string item_name, string exibicao, int qty_min, int qty_max, double chance) {
    if(!database_initialized || bancoJogo is null) return false;

    ensure_item_in_catalog(item_name, exibicao);

    sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR IGNORE INTO boss_loot (boss_id, item_name, qty_min, qty_max, chance) VALUES (?, ?, ?, ?, ?);");
    if(@stmt == null) {
        debug_log("ERRO ao preparar boss_loot_inserir: " + bancoJogo.get_last_error_text());
        return false;
    }

    stmt.bind_int(1, boss_id);
    stmt.bind_text(2, item_name);
    stmt.bind_int(3, qty_min);
    stmt.bind_int(4, qty_max);
    stmt.bind_double(5, chance);

    return (stmt.step() == SQLITE_DONE);
}

int seed_boss_loot() {
    int semeados = 0;

    // Rei Rato Gigante
    if(boss_loot_inserir(1, "corpo_de_rato", "Corpo de rato", 1, 1, 1.0)) semeados++;
    if(boss_loot_inserir(1, "coroa_do_rei_rato", "Coroa do Rei Rato", 1, 1, 0.2)) semeados++;

    // Lobo Alpha
    if(boss_loot_inserir(2, "corpo_de_lobo", "Corpo de lobo", 2, 2, 1.0)) semeados++;
    if(boss_loot_inserir(2, "espada_de_presa", "Espada de Presa", 1, 1, 0.15)) semeados++;

    // Golem de Pedra Antigo
    if(boss_loot_inserir(3, "nucleo_de_golem", "Núcleo de Golem", 1, 1, 1.0)) semeados++;
    if(boss_loot_inserir(3, "armadura_de_ferro", "Armadura de ferro", 1, 1, 0.25)) semeados++;
    if(boss_loot_inserir(3, "martelo_ancestral", "Martelo Ancestral", 1, 1, 0.1)) semeados++;

    return semeados;
}

void init_boss_loot() {
    criar_tabela_boss_loot();

    int total = loot_contar_linhas("boss_loot");
    if(total == 0) {
        int semeados = seed_boss_loot();
        debug_log("BOSSES: tabela boss_loot vazia, " + semeados + " premios semeados");
    } else {
        debug_log("BOSSES: " + total + " premios registrados em boss_loot");
    }

    loot_sincronizar_catalogo_itens("boss_loot");
}

loot_premio@[] boss_loot_carregar(int boss_id) {
    loot_premio@[] premios;
    if(!database_initialized || bancoJogo is null) return premios;

    sqlite3statement@ stmt = bancoJogo.prepare("SELECT item_name, qty_min, qty_max, chance FROM boss_loot WHERE boss_id = ? ORDER BY chance DESC, id;");
    if(@stmt == null) return premios;

    stmt.bind_int(1, boss_id);

    while(stmt.step() == SQLITE_ROW) {
        premios.insert_last(loot_ler_premio(stmt));
    }

    return premios;
}

