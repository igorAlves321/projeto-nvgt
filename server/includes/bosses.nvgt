void add_boss(boss@ b) {
    world_bosses.insert_last(b);
    boss_by_id.set("" + b.id, @b);
}

boss@ get_boss(int id) {
    boss@ b;
    if (boss_by_id.get("" + id, @b)) {
        return b;
    }
    return null;
}

void boss_responder(int client_index, string mensagem) {
    if (client_index < 0 || client_index >= int(players.length())) return;
    loot_enviar_mensagem(players[client_index], mensagem);
}

void cmd_bosses(int client_index, string[] args) {
    if (world_bosses.length() == 0) {
        boss_responder(client_index, "Nenhum chefe registrado.");
        return;
    }

    string msg = "=== CHEFES DO MUNDO ===\n";

    for (uint i = 0; i < world_bosses.length(); i++) {
        boss@ b = world_bosses[i];

        msg += "[" + b.id + "] " + b.name + " (Nível " + b.level + ")\n";
        msg += "Localização: " + b.map + "\n";

        switch (b.state) {
            case BOSS_SLEEPING:
                msg += "Status: Aguardando spawn\n";
                break;
            case BOSS_ALIVE:
                msg += "Status: Vivo (" + b.get_hp_percent() + "% de vida)\n";
                break;
            case BOSS_FIGHTING:
                msg += "Status: Em combate (" + b.get_hp_percent() + "% de vida)\n";
                msg += "Participantes: " + b.participants.length() + "\n";
                break;
            case BOSS_ENRAGED:
                msg += "Status: Enfurecido (" + b.get_hp_percent() + "% de vida)\n";
                msg += "Participantes: " + b.participants.length() + "\n";
                break;
            case BOSS_DEAD: {
                int remaining = (b.respawn_delay_minutes * 60) - int(b.respawn_timer.elapsed / 1000);
                if (remaining < 0) remaining = 0;
                msg += "Status: Morto (respawn em " + (remaining / 60) + " minutos)\n";
                break;
            }
        }

        msg += "Nível requerido: " + b.required_level + "\n";
    }

    msg += "Use /bossinfo <id> para mais detalhes.";

    boss_responder(client_index, msg);
}

void cmd_bossinfo(int client_index, string[] args) {
    if (args.length() < 1) {
        boss_responder(client_index, "Uso: /bossinfo <id>");
        return;
    }

    int id = string_to_number(args[0]);
    boss@ b = get_boss(id);

    if (b is null) {
        boss_responder(client_index, "Chefe não encontrado.");
        return;
    }

    string msg = "=== " + b.name + " ===\n";
    msg += b.description + "\n";
    msg += "Nível: " + b.level + "\n";
    msg += "Vida: " + b.current_hp + " / " + b.max_hp + "\n";
    msg += "Ataque: " + b.attack_power + "\n";
    msg += "Defesa: " + b.defense + "\n";
    msg += "Localização: " + b.map + "\n";
    msg += "Nível mínimo: " + b.required_level + "\n";
    msg += "Tempo até a fúria: " + b.enrage_timer_minutes + " minutos\n";
    msg += "Tempo de respawn: " + b.respawn_delay_minutes + " minutos\n";

    if (b.abilities.length() > 0) {
        msg += "HABILIDADES:\n";
        for (uint i = 0; i < b.abilities.length(); i++) {
            msg += "- " + b.abilities[i].name + " (recarga de " + b.abilities[i].cooldown + " segundos)\n";
            if (b.abilities[i].description != "") msg += "  " + b.abilities[i].description + "\n";
        }
    }

    msg += "RECOMPENSAS:\n";
    msg += "- Gold: " + b.guaranteed_gold_min + " - " + b.guaranteed_gold_max + "\n";
    msg += "- XP: " + b.guaranteed_xp + "\n";

    loot_premio@[] premios = boss_loot_carregar(b.id);
    if (premios.length() > 0) {
        msg += loot_descrever_premios(premios);
    }

    boss_responder(client_index, msg);
}

// Faz o chefe nascer onde o administrador esta e grava o local.
void cmd_spawnboss(int client_index, string[] args) {
    if (client_index < 0 || client_index >= int(players.length())) return;

    if (args.length() < 1) {
        boss_responder(client_index, "Uso: /spawnboss <id>");
        return;
    }

    int id = string_to_number(args[0]);
    boss@ b = get_boss(id);

    if (b is null) {
        boss_responder(client_index, "Chefe não encontrado.");
        return;
    }

    if (b.state != BOSS_SLEEPING && b.state != BOSS_DEAD) {
        boss_responder(client_index, b.name + " já está vivo em " + b.map + ".");
        return;
    }

    if (get_map_index_from(players[client_index].map) < 0) {
        boss_responder(client_index, "Erro ao obter o mapa atual.");
        return;
    }

    b.map = players[client_index].map;
    b.x = players[client_index].x;
    b.y = players[client_index].y;

    if (!b.spawn()) {
        boss_responder(client_index, "Não foi possível fazer o chefe nascer aqui.");
        return;
    }

    boss_salvar_local(b);

    boss_responder(client_index, b.name + " nasceu em " + b.map + " (" + int(b.x) + ", " + int(b.y) + ").");
    debug_log("ADMIN: " + players[client_index].charname + " fez nascer o chefe " + b.id + " (" + b.name + ") em " + b.map);
}

void cmd_killboss(int client_index, string[] args) {
    if (client_index < 0 || client_index >= int(players.length())) return;

    if (args.length() < 1) {
        boss_responder(client_index, "Uso: /killboss <id>");
        return;
    }

    int id = string_to_number(args[0]);
    boss@ b = get_boss(id);

    if (b is null) {
        boss_responder(client_index, "Chefe não encontrado.");
        return;
    }

    if (b.state == BOSS_DEAD || b.state == BOSS_SLEEPING) {
        boss_responder(client_index, b.name + " não está vivo.");
        return;
    }

    b.die();

    boss_responder(client_index, b.name + " foi morto. As recompensas foram entregues aos participantes.");
    debug_log("ADMIN: " + players[client_index].charname + " matou o chefe " + b.id + " (" + b.name + ")");
}

void bosses_loop() {
    for (uint i = 0; i < world_bosses.length(); i++) {
        boss@ b = world_bosses[i];

        if (b.state == BOSS_SLEEPING) {
            if (b.spawn_automatico) {
                b.spawn_automatico = false;
                b.spawn();
            }
            continue;
        }

        if (b.state == BOSS_DEAD) {
            if (b.respawn_timer.elapsed >= b.respawn_delay_minutes * 60 * 1000) {
                // Sem o mapa carregado o chefe volta a aguardar um /spawnboss.
                if (!b.spawn()) b.state = BOSS_SLEEPING;
            }
            continue;
        }

        monstruo@ m = boss_entidade(b.id);
        if (m is null) {
            // A entidade saiu do mundo sem passar pela morte.
            b.state = BOSS_SLEEPING;
            continue;
        }

        if (b.state == BOSS_FIGHTING) {
            if (b.fight_start_time.elapsed >= b.enrage_timer_minutes * 60 * 1000) {
                b.state = BOSS_ENRAGED;
                b.attack_power = int(b.attack_power * 1.5);
                m.dano_min = b.attack_power * BOSS_DANO_FATOR_MIN;
                m.dano_max = b.attack_power * BOSS_DANO_FATOR_MAX;
                b.broadcast_to_participants(b.name + " ENTROU EM FÚRIA!");
            }
        }

        if (b.state == BOSS_FIGHTING || b.state == BOSS_ENRAGED) {
            if (b.abilities.length() > 0 && random(0, 100) < 10) {
                int ability_index = random(0, int(b.abilities.length()) - 1);
                b.use_ability(ability_index);

                // A cura da habilidade vale tambem para a entidade no mapa.
                if (b.current_hp > m.vida) {
                    m.vida = b.current_hp;
                    m.vida_registrada = m.vida;
                }
            }

            if (b.check_phase_transition()) {
                b.broadcast_to_participants(b.name + " entrou na Fase " + b.current_phase + "!");
            }
        }
    }
}

void save_bosses_data() {
    for (uint i = 0; i < world_bosses.length(); i++) {
        if (get_map_index_from(world_bosses[i].map) < 0) continue;
        boss_salvar_local(world_bosses[i]);
    }
}

void load_bosses_data() {
    criar_tabela_boss_estado();
    if(!database_initialized || bancoJogo is null) return;

    sqlite3statement@ stmt = bancoJogo.prepare("SELECT boss_id, mapa, x, y FROM boss_estado;");
    if(@stmt == null) return;

    int carregados = 0;
    while(stmt.step() == SQLITE_ROW) {
        boss@ b = get_boss(stmt.column_int(0));
        if (b is null) continue;

        b.map = stmt.column_text(1);
        b.x = stmt.column_int(2);
        b.y = stmt.column_int(3);
        b.spawn_automatico = true;
        carregados++;
    }

    if (carregados > 0) debug_log("BOSSES: " + carregados + " local(is) de chefe carregado(s) de boss_estado");
}
