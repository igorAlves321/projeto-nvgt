
#include "globals.nvgt"

enum boss_state {
    BOSS_SLEEPING,
    BOSS_ALIVE,
    BOSS_FIGHTING,
    BOSS_ENRAGED,
    BOSS_DEAD
}

enum boss_ability_type {
    ABILITY_AOE_DAMAGE,
    ABILITY_SUMMON,
    ABILITY_HEAL,
    ABILITY_STUN,
    ABILITY_DOT,
    ABILITY_BUFF_SELF,
    ABILITY_DEBUFF_PLAYERS
}

class boss_ability {
    boss_ability_type type;
    string name;
    string description;
    int cooldown;
    timer last_use;
    int damage;
    int radius;
    int duration;
    string summon_type;
    int summon_count;

    boss_ability() {
        cooldown = 30;
        damage = 0;
        radius = 0;
        duration = 0;
        summon_count = 1;
    }
}

class boss_participant {
    string player_name;
    int damage_dealt;
    int healing_done;
    timer joined_time;

    boss_participant(string name) {
        player_name = name;
        damage_dealt = 0;
        healing_done = 0;
    }
}

class boss {
    int id;
    string name;
    string description;
    int level;
    int max_hp;
    int current_hp;
    int attack_power;
    int defense;
    float x, y, z;
    string map;
    boss_state state;

    dictionary threat_table;
    string current_target;

    boss_ability@[] abilities;
    int enrage_timer_minutes;
    timer fight_start_time;
    timer respawn_timer;
    int respawn_delay_minutes;

    boss_participant@[] participants;
    int required_level;
    int max_participants;

    int guaranteed_gold_min;
    int guaranteed_gold_max;
    int guaranteed_xp;

    int[] phase_thresholds;
    int current_phase;

    boss() {
        id = 0;
        level = 1;
        max_hp = 10000;
        current_hp = max_hp;
        attack_power = 100;
        defense = 50;
        state = BOSS_SLEEPING;
        enrage_timer_minutes = 15;
        respawn_delay_minutes = 60;
        required_level = 1;
        max_participants = 20;
        guaranteed_gold_min = 1000;
        guaranteed_gold_max = 5000;
        guaranteed_xp = 5000;
        current_phase = 0;
    }

    int get_hp_percent() {
        if (max_hp == 0) return 0;
        return (current_hp * 100) / max_hp;
    }

    bool check_phase_transition() {
        int hp_pct = get_hp_percent();
        for (uint i = current_phase; i < phase_thresholds.length(); i++) {
            if (hp_pct <= phase_thresholds[i]) {
                current_phase = i + 1;
                return true;
            }
        }
        return false;
    }

    void add_threat(string player_name, int amount) {
        int current_threat = 0;
        if (threat_table.exists(player_name)) {
            threat_table.get(player_name, current_threat);
        }
        current_threat += amount;
        threat_table.set(player_name, current_threat);

        update_target();
    }

    void update_target() {
        string[] keys = threat_table.get_keys();
        int max_threat = 0;
        string new_target = "";

        for (uint i = 0; i < keys.length(); i++) {
            int threat;
            threat_table.get(keys[i], threat);
            if (threat > max_threat) {
                max_threat = threat;
                new_target = keys[i];
            }
        }

        if (new_target != current_target && new_target != "") {
            current_target = new_target;
            broadcast_to_participants("O boss mudou de alvo para " + new_target + "!");
        }
    }

    void add_participant(string player_name) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                return;
            }
        }

        boss_participant@ bp = boss_participant(player_name);
        participants.insert_last(bp);
    }

    void record_damage(string player_name, int damage) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                participants[i].damage_dealt += damage;
                return;
            }
        }
    }

    void broadcast_to_participants(string message) {
        for (uint i = 0; i < participants.length(); i++) {
        }
    }

    void spawn() {
        current_hp = max_hp;
        state = BOSS_ALIVE;
        current_phase = 0;
        threat_table.delete_all();
        participants.resize(0);
        current_target = "";

    }

    void die() {
        state = BOSS_DEAD;
        respawn_timer.restart();

        distribute_loot();

        broadcast_to_participants("Você derrotou " + name + "!");

        threat_table.delete_all();
        current_target = "";
    }

    void distribute_loot() {
        if (participants.length() == 0) return;

        int total_damage = 0;
        for (uint i = 0; i < participants.length(); i++) {
            total_damage += participants[i].damage_dealt;
        }

        if (total_damage == 0) return;

        loot_premio@[] premios = boss_loot_carregar(id);

        for (uint i = 0; i < participants.length(); i++) {
            int pidx = get_player_index_from(participants[i].player_name);
            if (pidx < 0) continue;

            float contribution = float(participants[i].damage_dealt) / float(total_damage);

            int gold_reward = int((guaranteed_gold_min + guaranteed_gold_max) / 2 * contribution);

            int xp_reward = int(guaranteed_xp * contribution);

            players[pidx].gold += gold_reward;
            players[pidx].saldo = players[pidx].gold;
            if (xp_reward > 0) ganhaxp(pidx, xp_reward, 0);

            string msg = "Recompensas por derrotar " + name + ":\n";
            msg += "Gold: " + gold_reward + "\n";
            msg += "XP: " + xp_reward + "\n";

            string itens = loot_entregar_premios(players[pidx], premios);
            if (itens != "") {
                msg += "ITENS:\n" + itens;
            }

            loot_enviar_mensagem(players[pidx], msg);
        }
    }

    void use_ability(int ability_index) {
        if (ability_index < 0 || ability_index >= int(abilities.length())) return;

        boss_ability@ ability = abilities[ability_index];

        if (ability.last_use.elapsed < ability.cooldown * 1000) return;

        ability.last_use.restart();

        broadcast_to_participants(" " + name + " usa " + ability.name + "!");

        switch (ability.type) {
            case ABILITY_AOE_DAMAGE:
                broadcast_to_participants("💥 Dano em área! " + ability.damage + " de dano!");
                break;
            case ABILITY_SUMMON:
                broadcast_to_participants("👹 " + name + " invocou " + ability.summon_count + " " + ability.summon_type + "!");
                break;
            case ABILITY_HEAL:
                current_hp = min(current_hp + ability.damage, max_hp);
                broadcast_to_participants("💚 " + name + " se curou em " + ability.damage + " HP!");
                break;
            case ABILITY_STUN:
                broadcast_to_participants("😵 Todos foram atordoados por " + ability.duration + " segundos!");
                break;
            case ABILITY_DOT:
                broadcast_to_participants("☠️ Dano contínuo aplicado! " + ability.damage + " de dano por " + ability.duration + "s!");
                break;
            case ABILITY_BUFF_SELF:
                broadcast_to_participants("💪 " + name + " ficou mais forte!");
                break;
            case ABILITY_DEBUFF_PLAYERS:
                broadcast_to_participants("🔻 Seus atributos foram reduzidos!");
                break;
        }
    }
}

boss@[] world_bosses;
dictionary boss_by_id;

void init_bosses_system() {
    world_bosses.resize(0);
    boss_by_id.delete_all();

    create_default_bosses();

    init_boss_loot();

    load_bosses_data();
}

// ---------------------------------------------------------------------
// Loot dos chefes no SQLite (tabela boss_loot). O codigo so faz a carga
// inicial com a tabela vazia; em runtime os premios sao lidos do banco.
// ---------------------------------------------------------------------

void criar_tabela_boss_loot() {
    if(!database_initialized || bancoJogo is null) {
        debug_log("ERRO: criar_tabela_boss_loot - Banco não inicializado");
        return;
    }

    string create_boss_loot = """
        CREATE TABLE IF NOT EXISTS boss_loot (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            boss_id INTEGER NOT NULL,
            item_name TEXT NOT NULL,
            qty_min INTEGER DEFAULT 1,
            qty_max INTEGER DEFAULT 1,
            chance REAL DEFAULT 1.0,
            UNIQUE(boss_id, item_name)
        );
    """;

    if(bancoJogo.execute(create_boss_loot) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela boss_loot: " + bancoJogo.get_last_error_text());
    }
}

bool boss_loot_inserir(int boss_id, string item_name, string exibicao, int qty_min, int qty_max, double chance) {
    if(!database_initialized || bancoJogo is null) return false;

    ensure_item_in_catalog(item_name, exibicao);

    sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR IGNORE INTO boss_loot (boss_id, item_name, qty_min, qty_max, chance) VALUES (?, ?, ?, ?, ?);");
    if(@stmt == null) {
        debug_log("ERRO ao preparar boss_loot_inserir: " + bancoJogo.get_last_error_text());
        return false;
    }

    stmt.bind_int(1, boss_id);
    stmt.bind_text(2, item_name);
    stmt.bind_int(3, qty_min);
    stmt.bind_int(4, qty_max);
    stmt.bind_double(5, chance);

    return (stmt.step() == SQLITE_DONE);
}

int seed_boss_loot() {
    int semeados = 0;

    // Rei Rato Gigante
    if(boss_loot_inserir(1, "corpo_de_rato", "Corpo de rato", 1, 1, 1.0)) semeados++;
    if(boss_loot_inserir(1, "coroa_do_rei_rato", "Coroa do Rei Rato", 1, 1, 0.2)) semeados++;

    // Lobo Alpha
    if(boss_loot_inserir(2, "corpo_de_lobo", "Corpo de lobo", 2, 2, 1.0)) semeados++;
    if(boss_loot_inserir(2, "espada_de_presa", "Espada de Presa", 1, 1, 0.15)) semeados++;

    // Golem de Pedra Antigo
    if(boss_loot_inserir(3, "nucleo_de_golem", "Núcleo de Golem", 1, 1, 1.0)) semeados++;
    if(boss_loot_inserir(3, "armadura_de_ferro", "Armadura de ferro", 1, 1, 0.25)) semeados++;
    if(boss_loot_inserir(3, "martelo_ancestral", "Martelo Ancestral", 1, 1, 0.1)) semeados++;

    return semeados;
}

void init_boss_loot() {
    criar_tabela_boss_loot();

    int total = loot_contar_linhas("boss_loot");
    if(total == 0) {
        int semeados = seed_boss_loot();
        debug_log("BOSSES: tabela boss_loot vazia, " + semeados + " premios semeados");
    } else {
        debug_log("BOSSES: " + total + " premios registrados em boss_loot");
    }

    loot_sincronizar_catalogo_itens("boss_loot");
}

loot_premio@[] boss_loot_carregar(int boss_id) {
    loot_premio@[] premios;
    if(!database_initialized || bancoJogo is null) return premios;

    sqlite3statement@ stmt = bancoJogo.prepare("SELECT item_name, qty_min, qty_max, chance FROM boss_loot WHERE boss_id = ? ORDER BY chance DESC, id;");
    if(@stmt == null) return premios;

    stmt.bind_int(1, boss_id);

    while(stmt.step() == SQLITE_ROW) {
        premios.insert_last(loot_ler_premio(stmt));
    }

    return premios;
}

