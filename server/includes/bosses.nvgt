}

// Adiciona boss ao sistema
void add_boss(boss@ b) {
    world_bosses.insert_last(b);
    boss_by_id.set("" + b.id, @b);
}

// Busca boss por ID
boss@ get_boss(int id) {
    boss@ b;
    if (boss_by_id.get("" + id, @b)) {
        return b;
    }
    return null;
}

// ========================================
// COMANDOS
// ========================================

// /bosses - Lista todos os bosses e status
void cmd_bosses(int client_index, string[] args) {
    if (world_bosses.length() == 0) {
        // send_message(client_index, "Nenhum boss disponível no momento.");
        return;
    }
    
    string msg = "=== BOSSES DO MUNDO ===\n\n";
    
    for (uint i = 0; i < world_bosses.length(); i++) {
        boss@ b = world_bosses[i];
        
        msg += "[" + b.id + "] " + b.name + " (Nível " + b.level + ")\n";
        msg += "Localização: " + b.map + "\n";
        
        switch (b.state) {
            case BOSS_SLEEPING:
                msg += "Status: 💤 Aguardando spawn\n";
                break;
            case BOSS_ALIVE:
                msg += "Status: ✅ Vivo (" + b.get_hp_percent() + "% HP)\n";
                break;
            case BOSS_FIGHTING:
                msg += "Status: ⚔️ Em combate (" + b.get_hp_percent() + "% HP)\n";
                msg += "Participantes: " + b.participants.length() + "\n";
                break;
            case BOSS_ENRAGED:
                msg += "Status: 😡 ENRAIVECIDO (" + b.get_hp_percent() + "% HP)\n";
                break;
            case BOSS_DEAD: {
                // Declaração de variável em bloco separado para evitar erro de switch
                int remaining = (b.respawn_delay_minutes * 60) - (b.respawn_timer.elapsed / 1000);
                msg += "Status: ☠️ Morto (respawn em " + (remaining / 60) + "m)\n";
                break;
            }
        }
        
        msg += "Nível requerido: " + b.required_level + "\n";
        msg += "---\n";
    }
    
    msg += "\nUse /bossinfo <id> para mais detalhes.";
    
    // send_message(client_index, msg);
}

// /bossinfo <id> - Informações detalhadas do boss
void cmd_bossinfo(int client_index, string[] args) {
    if (args.length() < 1) {
        // send_message(client_index, "Use: /bossinfo <id>");
        return;
    }
    
    int id = string_to_number(args[0]);
    boss@ b = get_boss(id);
    
    if (b is null) {
        // send_message(client_index, "Boss não encontrado.");
        return;
    }
    
    string msg = "=== " + b.name + " ===\n\n";
    msg += b.description + "\n\n";
    msg += "Nível: " + b.level + "\n";
    msg += "HP: " + b.current_hp + " / " + b.max_hp + "\n";
    msg += "Ataque: " + b.attack_power + "\n";
    msg += "Defesa: " + b.defense + "\n";
    msg += "Localização: " + b.map + "\n";
    msg += "Nível mínimo: " + b.required_level + "\n";
    msg += "Tempo de enrage: " + b.enrage_timer_minutes + " minutos\n";
    msg += "Tempo de respawn: " + b.respawn_delay_minutes + " minutos\n\n";
    
    // Habilidades
    if (b.abilities.length() > 0) {
        msg += "🎯 HABILIDADES:\n";
        for (uint i = 0; i < b.abilities.length(); i++) {
            msg += "- " + b.abilities[i].name + " (CD: " + b.abilities[i].cooldown + "s)\n";
            msg += "  " + b.abilities[i].description + "\n";
        }
        msg += "\n";
    }
    
    // Loot
    if (b.loot_table.length() > 0) {
        msg += "💎 POSSÍVEL LOOT:\n";
        msg += "- Gold: " + b.guaranteed_gold_min + " - " + b.guaranteed_gold_max + "\n";
        msg += "- XP: " + b.guaranteed_xp + "\n";
        for (uint i = 0; i < b.loot_table.length(); i++) {
            msg += "- " + b.loot_table[i].item_name;
            if (b.loot_table[i].quantity > 1) {
                msg += " x" + b.loot_table[i].quantity;
            }
            if (b.loot_table[i].guaranteed) {
                msg += " (GARANTIDO)";
            } else {
                msg += " (" + int(b.loot_table[i].drop_chance * 100) + "% chance)";
            }
            msg += "\n";
        }
    }
    
    // send_message(client_index, msg);
}

// /spawnboss <id> - Força spawn de um boss (admin)
void cmd_spawnboss(int client_index, string[] args) {
    // Verifica se é admin
    // if (!is_admin(client_index)) {
    //     send_message(client_index, "Você não tem permissão para usar este comando.");
    //     return;
    // }
    
    if (args.length() < 1) {
        // send_message(client_index, "Use: /spawnboss <id>");
        return;
    }
    
    int id = string_to_number(args[0]);
    boss@ b = get_boss(id);
    
    if (b is null) {
        // send_message(client_index, "Boss não encontrado.");
        return;
    }
    
    if (b.state != BOSS_SLEEPING && b.state != BOSS_DEAD) {
        // send_message(client_index, "Este boss já está ativo.");
        return;
    }
    
    b.spawn();
    // send_message(client_index, "Boss " + b.name + " foi spawnado!");
    // global_broadcast("⚔️ Boss " + b.name + " spawnou em " + b.map + "!");
}

// /killboss <id> - Força morte de um boss (admin/debug)
void cmd_killboss(int client_index, string[] args) {
    // Verifica se é admin
    // if (!is_admin(client_index)) {
    //     send_message(client_index, "Você não tem permissão para usar este comando.");
    //     return;
    // }
    
    if (args.length() < 1) {
        // send_message(client_index, "Use: /killboss <id>");
        return;
    }
    
    int id = string_to_number(args[0]);
    boss@ b = get_boss(id);
    
    if (b is null) {
        // send_message(client_index, "Boss não encontrado.");
        return;
    }
    
    if (b.state == BOSS_DEAD) {
        // send_message(client_index, "Este boss já está morto.");
        return;
    }
    
    b.die();
    // send_message(client_index, "Boss " + b.name + " foi morto!");
}

// ========================================
// LOOP PRINCIPAL
// ========================================

void bosses_loop() {
    for (uint i = 0; i < world_bosses.length(); i++) {
        boss@ b = world_bosses[i];
        
        // Respawn automático
        if (b.state == BOSS_DEAD) {
            if (b.respawn_timer.elapsed >= b.respawn_delay_minutes * 60 * 1000) {
                b.spawn();
            }
        }
        
        // Enrage timer
        if (b.state == BOSS_FIGHTING) {
            if (b.fight_start_time.elapsed >= b.enrage_timer_minutes * 60 * 1000) {
                if (b.state != BOSS_ENRAGED) {
                    b.state = BOSS_ENRAGED;
                    b.attack_power = int(b.attack_power * 1.5);
                    b.broadcast_to_participants("⚠️⚠️⚠️ " + b.name + " ENTROU EM FÚRIA! ⚠️⚠️⚠️");
                }
            }
        }
        
        // Usa habilidades aleatoriamente durante combate
        if (b.state == BOSS_FIGHTING || b.state == BOSS_ENRAGED) {
            // Chance de usar habilidade a cada ciclo
            if (b.abilities.length() > 0 && random(0, 100) < 10) {  // 10% de chance
                int ability_index = random(0, b.abilities.length() - 1);
                b.use_ability(ability_index);
            }
            
            // Verifica transição de fase
            if (b.check_phase_transition()) {
                b.broadcast_to_participants("⚡ " + b.name + " entrou na Fase " + b.current_phase + "!");
            }
        }
    }
}

