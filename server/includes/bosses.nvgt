// ========================================
// SISTEMA DE BOSSES - FASE 5
// ========================================
// Sistema completo de bosses com mecânicas especiais,
// spawn/respawn, aggro, fases e loot melhorado

#include "globals.nvgt"

// ========================================
// ENUMS
// ========================================

enum boss_state {
    BOSS_SLEEPING,    // Boss não spawnou ainda
    BOSS_ALIVE,       // Boss ativo no mundo
    BOSS_FIGHTING,    // Boss em combate
    BOSS_ENRAGED,     // Boss enraivecido (HP < 20%)
    BOSS_DEAD         // Boss morto (aguardando respawn)
}

enum boss_ability_type {
    ABILITY_AOE_DAMAGE,      // Dano em área
    ABILITY_SUMMON,          // Invocar adds
    ABILITY_HEAL,            // Curar-se
    ABILITY_STUN,            // Atordoar jogadores
    ABILITY_DOT,             // Dano ao longo do tempo
    ABILITY_BUFF_SELF,       // Buffar-se
    ABILITY_DEBUFF_PLAYERS   // Debuffar jogadores
}

// ========================================
// CLASSES
// ========================================

class boss_ability {
    boss_ability_type type;
    string name;
    string description;
    int cooldown;           // Em segundos
    timer last_use;
    int damage;             // Para habilidades de dano
    int radius;             // Para habilidades de área
    int duration;           // Para buffs/debuffs
    string summon_type;     // Para summon
    int summon_count;       // Quantidade de adds
    
    boss_ability() {
        cooldown = 30;
        damage = 0;
        radius = 0;
        duration = 0;
        summon_count = 1;
    }
}

class boss_loot_entry {
    string item_name;
    int quantity;
    float drop_chance;  // 0.0 a 1.0
    bool guaranteed;    // Se true, sempre dropa
    
    boss_loot_entry() {
        quantity = 1;
        drop_chance = 0.1;
        guaranteed = false;
    }
}

class boss_participant {
    string player_name;
    int damage_dealt;
    int healing_done;
    timer joined_time;
    
    boss_participant(string name) {
        player_name = name;
        damage_dealt = 0;
        healing_done = 0;
    }
}

class boss {
    int id;
    string name;
    string description;
    int level;
    int max_hp;
    int current_hp;
    int attack_power;
    int defense;
    float x, y, z;
    string map;
    boss_state state;
    
    // Sistema de aggro/ameaça
    dictionary threat_table;  // player_name -> threat_value
    string current_target;
    
    // Mecânicas especiais
    boss_ability@[] abilities;
    int enrage_timer_minutes;  // Tempo até enrage
    timer fight_start_time;
    timer respawn_timer;
    int respawn_delay_minutes;
    
    // Tracking de participantes
    boss_participant@[] participants;
    int required_level;
    int max_participants;
    
    // Loot
    boss_loot_entry@[] loot_table;
    int guaranteed_gold_min;
    int guaranteed_gold_max;
    int guaranteed_xp;
    
    // Fases do boss (HP thresholds)
    int[] phase_thresholds;  // Ex: [75, 50, 25] - ativa habilidades em cada fase
    int current_phase;
    
    boss() {
        id = 0;
        level = 1;
        max_hp = 10000;
        current_hp = max_hp;
        attack_power = 100;
        defense = 50;
        state = BOSS_SLEEPING;
        enrage_timer_minutes = 15;
        respawn_delay_minutes = 60;
        required_level = 1;
        max_participants = 20;
        guaranteed_gold_min = 1000;
        guaranteed_gold_max = 5000;
        guaranteed_xp = 5000;
        current_phase = 0;
    }
    
    // Calcula HP %
    int get_hp_percent() {
        if (max_hp == 0) return 0;
        return (current_hp * 100) / max_hp;
    }
    
    // Verifica mudança de fase
    bool check_phase_transition() {
        int hp_pct = get_hp_percent();
        for (uint i = current_phase; i < phase_thresholds.length(); i++) {
            if (hp_pct <= phase_thresholds[i]) {
                current_phase = i + 1;
                return true;
            }
        }
        return false;
    }
    
    // Adiciona ameaça de um jogador
    void add_threat(string player_name, int amount) {
        int current_threat = 0;
        if (threat_table.exists(player_name)) {
            threat_table.get(player_name, current_threat);
        }
        current_threat += amount;
        threat_table.set(player_name, current_threat);
        
        // Atualiza alvo se necessário
        update_target();
    }
    
    // Atualiza alvo baseado em maior ameaça
    void update_target() {
        string[] keys = threat_table.get_keys();
        int max_threat = 0;
        string new_target = "";
        
        for (uint i = 0; i < keys.length(); i++) {
            int threat;
            threat_table.get(keys[i], threat);
            if (threat > max_threat) {
                max_threat = threat;
                new_target = keys[i];
            }
        }
        
        if (new_target != current_target && new_target != "") {
            current_target = new_target;
            broadcast_to_participants("O boss mudou de alvo para " + new_target + "!");
        }
    }
    
    // Adiciona participante
    void add_participant(string player_name) {
        // Verifica se já existe
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                return;
            }
        }
        
        // Adiciona novo
        boss_participant@ bp = boss_participant(player_name);
        participants.insert_last(bp);
    }
    
    // Registra dano de participante
    void record_damage(string player_name, int damage) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                participants[i].damage_dealt += damage;
                return;
            }
        }
    }
    
    // Envia mensagem para todos participantes
    void broadcast_to_participants(string message) {
        for (uint i = 0; i < participants.length(); i++) {
            // Assume função global send_message(player_name, message)
            // send_message(participants[i].player_name, message);
        }
    }
    
    // Spawna o boss
    void spawn() {
        current_hp = max_hp;
        state = BOSS_ALIVE;
        current_phase = 0;
        threat_table.delete_all();
        participants.resize(0);
        current_target = "";
        
        // Broadcast global
        // global_broadcast("Boss " + name + " (Nível " + level + ") spawnou em " + map + "!");
    }
    
    // Boss morre
    void die() {
        state = BOSS_DEAD;
        respawn_timer.restart();
        
        // Distribui loot
        distribute_loot();
        
        // Broadcast
        broadcast_to_participants("Você derrotou " + name + "!");
        // global_broadcast("O boss " + name + " foi derrotado!");
        
        // Limpa
        threat_table.delete_all();
        current_target = "";
    }
    
    // Distribui loot para participantes
    void distribute_loot() {
        if (participants.length() == 0) return;
        
        // Calcula total de dano
        int total_damage = 0;
        for (uint i = 0; i < participants.length(); i++) {
            total_damage += participants[i].damage_dealt;
        }
        
        if (total_damage == 0) return;
        
        // Distribui para cada participante baseado em contribuição
        for (uint i = 0; i < participants.length(); i++) {
            float contribution = float(participants[i].damage_dealt) / float(total_damage);
            
            // Gold baseado em contribuição
            int gold_reward = int((guaranteed_gold_min + guaranteed_gold_max) / 2 * contribution);
            
            // XP baseado em contribuição
            int xp_reward = int(guaranteed_xp * contribution);
            
            string msg = "Recompensas por derrotar " + name + ":\n";
            msg += "Gold: " + gold_reward + "\n";
            msg += "XP: " + xp_reward + "\n";
            
            // Tenta dropar itens (chance individual)
            for (uint j = 0; j < loot_table.length(); j++) {
                bool should_drop = loot_table[j].guaranteed;
                if (!should_drop) {
                    float roll = random(0, 100) / 100.0;
                    should_drop = (roll <= loot_table[j].drop_chance);
                }
                
                if (should_drop) {
                    msg += "Item: " + loot_table[j].item_name;
                    if (loot_table[j].quantity > 1) {
                        msg += " x" + loot_table[j].quantity;
                    }
                    msg += "\n";
                }
            }
            
            // Envia para o jogador
            // send_message(participants[i].player_name, msg);
        }
    }
    
    // Usa habilidade
    void use_ability(int ability_index) {
        if (ability_index < 0 || ability_index >= int(abilities.length())) return;
        
        boss_ability@ ability = abilities[ability_index];
        
        // Verifica cooldown (elapsed é propriedade, não função)
        if (ability.last_use.elapsed < ability.cooldown * 1000) return;
        
        ability.last_use.restart();
        
        // Broadcast
        broadcast_to_participants("⚠️ " + name + " usa " + ability.name + "!");
        
        // Executa efeito baseado no tipo
        switch (ability.type) {
            case ABILITY_AOE_DAMAGE:
                broadcast_to_participants("💥 Dano em área! " + ability.damage + " de dano!");
                break;
            case ABILITY_SUMMON:
                broadcast_to_participants("👹 " + name + " invocou " + ability.summon_count + " " + ability.summon_type + "!");
                break;
            case ABILITY_HEAL:
                current_hp = min(current_hp + ability.damage, max_hp);
                broadcast_to_participants("💚 " + name + " se curou em " + ability.damage + " HP!");
                break;
            case ABILITY_STUN:
                broadcast_to_participants("😵 Todos foram atordoados por " + ability.duration + " segundos!");
                break;
            case ABILITY_DOT:
                broadcast_to_participants("☠️ Dano contínuo aplicado! " + ability.damage + " de dano por " + ability.duration + "s!");
                break;
            case ABILITY_BUFF_SELF:
                broadcast_to_participants("💪 " + name + " ficou mais forte!");
                break;
            case ABILITY_DEBUFF_PLAYERS:
                broadcast_to_participants("🔻 Seus atributos foram reduzidos!");
                break;
        }
    }
}

// ========================================
// SISTEMA GLOBAL DE BOSSES
// ========================================

boss@[] world_bosses;
dictionary boss_by_id;

// Inicializa sistema de bosses
void init_bosses_system() {
    // Limpa
    world_bosses.resize(0);
    boss_by_id.delete_all();
    
    // Cria bosses pré-definidos
    create_default_bosses();
    
    // Carrega dados salvos (se existir)
    load_bosses_data();
}

