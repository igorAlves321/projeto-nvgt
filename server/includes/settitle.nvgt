// settitle.nvgt - Sistema de Patentes/Títulos do EVM Server
// Convertido de settitle.bgt para NVGT
// Define o título do jogador baseado em status, nível e conquistas

// Função para definir título do jogador
void settitle(int index) {
	// Prioridade 1: Cheater
	if(file_exists("players/" + players[index].charname + "/cheater.usr")) {
		players[index].title = "Cheater\n";
		return;
	}
	
	// Prioridade 2: Recompensado (bounty na cabeça)
	if(players[index].bounty_on_head == 1) {
		players[index].title = "Recompensado\n";
		return;
	}
	
	// Prioridade 3: Mercenário (matou >= 10 jogadores)
	if(players[index].matou >= 10 && players[index].afk == false && players[index].pacifico == 0) {
		players[index].title = "Mercenári" + players[index].sexo2 + "\n";
		return;
	}
	
	// Prioridade 4: Caçador (kills >= 10 mobs)
	if(players[index].kills >= 10 && players[index].afk == false && players[index].pacifico == 0) {
		players[index].title = "Caçador" + (players[index].sexo == 0 ? "a" : "") + "\n";
		return;
	}
	
	// Prioridade 5: Status especiais
	if(players[index].afk == true) {
		players[index].title = "Ausente\n";
		return;
	}
	
	if(players[index].pacifico == 1 && players[index].afk == false) {
		players[index].title = "Pacífic" + players[index].sexo2 + "\n";
		return;
	}
	
	if(players[index].pacifico == 0 && players[index].afk == false && players[index].newbie == true) {
		players[index].title = "Novat" + players[index].sexo2 + "\n";
		return;
	}
	
	// Sistema de patentes militares baseadas em nível (apenas para jogadores combatentes)
	if(players[index].newbie == false && players[index].pacifico == 0 && players[index].afk == false) {
		// Nível 0-200: Soldado
		if(players[index].level <= 200) {
			players[index].title = "Soldad" + players[index].sexo2 + "\n";
		}
		// Nível 201-1000: Cabo
		else if(players[index].level > 200 && players[index].level <= 1000) {
			players[index].title = "Cab" + players[index].sexo2 + "\n";
		}
		// Nível 1001-2000: Sargento
		else if(players[index].level > 1000 && players[index].level <= 2000) {
			players[index].title = "Sargent" + players[index].sexo2 + "\n";
		}
		// Nível 2001-3000: Subtenente
		else if(players[index].level > 2000 && players[index].level <= 3000) {
			players[index].title = "Subtenente\n";
		}
		// Nível 3001-4000: Tenente
		else if(players[index].level > 3000 && players[index].level <= 4000) {
			players[index].title = "Tenente\n";
		}
		// Nível 4001-5000: Capitão
		else if(players[index].level > 4000 && players[index].level <= 5000) {
			players[index].title = "Capitã" + players[index].sexo2 + "\n";
		}
		// Nível 5001-6000: Major
		else if(players[index].level > 5000 && players[index].level <= 6000) {
			players[index].title = "Major\n";
		}
		// Nível 6001-7000: Tenente-Coronel
		else if(players[index].level > 6000 && players[index].level <= 7000) {
			players[index].title = "Tenente-Coronel\n";
		}
		// Nível 7001-10000: Coronel
		else if(players[index].level > 7000 && players[index].level <= 10000) {
			players[index].title = "Coronel\n";
		}
		// Nível 10001-12000: General de Brigada
		else if(players[index].level > 10000 && players[index].level <= 12000) {
			players[index].title = "General de Brigada\n";
		}
		// Nível 12001-16000: General de Divisão
		else if(players[index].level > 12000 && players[index].level <= 16000) {
			players[index].title = "General de Divisão\n";
		}
		// Nível 16001-20000: General de Exército
		else if(players[index].level > 16000 && players[index].level <= 20000) {
			players[index].title = "General de Exército\n";
		}
		// Nível 20000+: Marechal
		else if(players[index].level >= 20000) {
			players[index].title = "Marechal\n";
		}
	}
}

// Função auxiliar para atualizar título do jogador (wrapper)
void update_player_title(int index) {
	settitle(index);
}

// Função para obter nome da patente sem aplicar
string get_rank_name(int level, bool is_newbie, bool is_pacifico, bool is_afk, int matou_count, int kills_count) {
	// Mercenário
	if(matou_count >= 10 && is_afk == false && is_pacifico == false) {
		return "Mercenário";
	}
	
	// Caçador
	if(kills_count >= 10 && is_afk == false && is_pacifico == false) {
		return "Caçador";
	}
	
	// AFK
	if(is_afk == true) {
		return "Ausente";
	}
	
	// Pacífico
	if(is_pacifico == true && is_afk == false) {
		return "Pacífico";
	}
	
	// Novato
	if(is_pacifico == false && is_afk == false && is_newbie == true) {
		return "Novato";
	}
	
	// Patentes militares (combatentes)
	if(is_newbie == false && is_pacifico == false && is_afk == false) {
		if(level <= 200) return "Soldado";
		else if(level <= 1000) return "Cabo";
		else if(level <= 2000) return "Sargento";
		else if(level <= 3000) return "Subtenente";
		else if(level <= 4000) return "Tenente";
		else if(level <= 5000) return "Capitão";
		else if(level <= 6000) return "Major";
		else if(level <= 7000) return "Tenente-Coronel";
		else if(level <= 10000) return "Coronel";
		else if(level <= 12000) return "General de Brigada";
		else if(level <= 16000) return "General de Divisão";
		else if(level <= 20000) return "General de Exército";
		else return "Marechal";
	}
	
	return "Sem Patente";
}
