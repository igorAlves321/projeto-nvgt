// auth.nvgt - Sistema de Autenticação do Servidor EVM
// Usa hash SHA-256 para armazenamento seguro de senhas

// Criar nova conta de jogador
void handle_create_account(uint64 peer_id, string username, string password_hash, string email, int gender) {
    debug_log("Tentativa de criação de conta: " + username + " (peer: " + peer_id + ")");

    // Validar username
    if(!is_valid_username(username)) {
        send_reliable(peer_id, "Erro: Nome de usuário inválido. Use 3-20 caracteres alfanuméricos.", 0);
        debug_log("Criação falhou: username inválido - " + username);
        return;
    }

    // Validar email
    if(!is_valid_email(email)) {
        send_reliable(peer_id, "Erro: E-mail inválido.", 0);
        debug_log("Criação falhou: email inválido - " + email);
        return;
    }

    // Verificar se conta já existe
    if(player_exists_in_database(username)) {
        send_reliable(peer_id, "Erro: Esta conta já existe.", 0);
        debug_log("Criação falhou: conta já existe - " + username);
        return;
    }

    // Criar conta no banco de dados
    // IMPORTANTE: password_hash JÁ vem com hash SHA-256 do cliente
    if(!create_player_account(username, password_hash, email, gender)) {
        send_reliable(peer_id, "Erro: Falha ao criar conta. Tente novamente.", 0);
        debug_log("ERRO: Falha ao criar conta no banco - " + username);
        return;
    }

    // Sucesso
    send_reliable(peer_id, "created", 0);
    debug_log("✓ Conta criada: " + username + " (" + email + ")");
    // screen_reader_speak("Nova conta criada: " + username, false); // Comentado para não bugar NVDA
    log_to_database("INFO", "AUTH", "Nova conta criada: " + username, 0, username);
}

// Processar login de jogador
void handle_login(uint64 peer_id, string username, string password_hash, double client_version, string computer_id) {
    debug_log("Tentativa de login: " + username + " (peer: " + peer_id + ")");

    // Verificar se conta existe
    if(!player_exists_in_database(username)) {
        send_reliable(peer_id, "Erro: Conta não encontrada.", 0);
        debug_log("Login falhou: conta não existe - " + username);
        return;
    }

    // Obter hash armazenado do banco
    string stored_hash = get_player_password_hash(username);
    if(stored_hash == "") {
        send_reliable(peer_id, "Erro: Dados da conta corrompidos.", 0);
        debug_log("ERRO: Hash vazio para conta - " + username);
        return;
    }

    // Verificar senha (comparar hashes)
    // IMPORTANTE: password_hash JÁ vem com hash SHA-256 do cliente
    if(password_hash != stored_hash) {
        send_reliable(peer_id, "Erro: Senha incorreta.", 0);
        debug_log("Login falhou: senha incorreta - " + username);
        log_to_database("WARNING", "AUTH", "Tentativa de login com senha incorreta", 0, username);
        return;
    }

    // Verificar versão do cliente
    if(client_version < minversion) {
        send_reliable(peer_id, "updatenow", 0);
        debug_log("Login falhou: versão antiga - " + username + " (v" + client_version + ")");
        return;
    }

    // Verificar ban por computer_id
    if(is_computer_banned(computer_id)) {
        send_reliable(peer_id, "Erro: Você foi banido.", 0);
        debug_log("Login falhou: computer_id banido - " + computer_id);
        return;
    }
    
    // 🆕 Verificar ban temporário
    if(tempbancheck(username, computer_id)) {
        int ban_index = get_tempban_index(username);
        if(ban_index >= 0) {
            int time_left = int((tempbans[ban_index].ms - tempbans[ban_index].tempbantimer.elapsed) / 60000);
            string motivo = tempbans[ban_index].motivo;
            send_reliable(peer_id, "Erro: Você está temporariamente banido. Tempo restante: " + time_left + " minutos. Motivo: " + motivo, 0);
            debug_log("Login falhou: ban temporário ativo - " + username + " (" + time_left + " minutos restantes)");
            return;
        }
    }

    // Verificar limite de jogadores
    if(connected_count >= MAX_PLAYERS) {
        send_reliable(peer_id, "Erro: Servidor cheio. Tente mais tarde.", 0);
        debug_log("Login falhou: servidor cheio - " + username);
        return;
    }

    // Desconectar sessão anterior se existir
    player@ existing = get_player_by_name(username);
    if(existing !is null) {
        debug_log("Sessão anterior detectada para " + username + ", desconectando...");
        remove_player(existing.peer_id);
    }

    // Criar sessão do jogador
    if(!spawn_player_session(peer_id, username, client_version, computer_id)) {
        send_reliable(peer_id, "Erro: Falha ao iniciar sessão.", 0);
        debug_log("ERRO: Falha ao criar sessão - " + username);
        return;
    }

    // Carregar dados do jogador
    player@ p = get_player_by_peer(peer_id);
    if(p is null) {
        debug_log("ERRO CRÍTICO: Jogador não encontrado após spawn - " + username);
        return;
    }

    load_player_from_database(p);

    // Enviar confirmação de login
    send_reliable(peer_id, "x " + p.x, 0);
    send_reliable(peer_id, "y " + p.y, 0);
    send_reliable(peer_id, "loggedin", 0);

    debug_log("✓ " + username + " logou com sucesso [" + p.map_name + " (" + p.x + "," + p.y + ")]");
    // screen_reader_speak(username + " logou", false); // Comentado para não bugar NVDA
    log_to_database("INFO", "AUTH", "Login bem-sucedido", 0, username);
}

// Verificar se computer_id está banido
bool is_computer_banned(string computer_id) {
    // TODO: Implementar verificação de ban no banco de dados
    return false;
}

// Criar sessão de jogador após login
bool spawn_player_session(uint64 peer_id, string username, double version, string computer_id) {
    // Usar construtor com parâmetros conforme definição da classe
    player@ p = player(peer_id, username, "" + version, computer_id);

    p.is_logged_in = true;
    p.conectou = 1;

    // Configurações padrão (já inicializadas na classe, mas garantir valores)
    p.map = mapainicial;
    p.map_name = mapainicial;
    p.x = 1;
    p.y = 0;
    p.health = 5000;
    p.maxhealth = 5000;

    players.insert_last(p);
    set_peer_name(peer_id, username);

    debug_log("Sessão criada para " + username + " (peer: " + peer_id + ")");
    return true;
}
