
class plasmabomb {
	string name;
	string owner;
	string map;
	string active_sound;
	string explosion_sound;
	int coor_x;
	int coor_y;
	int explosiontime = 10;
	timer objecttimer;

	plasmabomb(string owner, int coor_x, int coor_y, string map) {
		this.name = "bomba_de_plasma";
		this.owner = owner;
		this.coor_x = coor_x;
		this.coor_y = coor_y;
		this.active_sound = "bomba.ogg";
		this.explosion_sound = "bombaatomicaexplode.ogg";
		this.map = map;
		send_packet(0, "play " + active_sound, coor_x, coor_y, get_map_index_from(this.map));
	}
}

void spawn_plasma_bomb(string owner, int coor_x, int coor_y, string map) {
	if(!pvp) return;

	int index = get_player_index_from(owner);
	if(index > -1) {
		if(players[index].afk || players[index].pacifico == 1) {
			return;
		}
		else {
			int mapindex = get_map_index_from(map);
			if(mapindex > -1 && server_maps[mapindex].plasmabombs.length() == 0) {
				plasmabomb pb(owner, coor_x, coor_y, map);
				server_maps[mapindex].plasmabombs.insert_last(pb);
				players[index].inv_add_item("bomba_de_plasma", -1);
			}
		}
	}
}
