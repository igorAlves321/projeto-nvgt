    // vamos adicionar isso via dictionary temporariamente
    // Em produção, adicionar: buff@[] active_buffs; na classe player
}

// Aplicar buff a um jogador
bool apply_buff(player@ p, buff@ b) {
    if(@p == null || @b == null) return false;

    debug_log("✨ BUFF: Aplicando " + b.buff_id + " a " + p.name + " (" + b.stat + " +" + b.value + ")");

    // TODO: Verificar stack behavior e lidar com buffs existentes
    // Por enquanto, implementação simplificada

    // Aplicar efeito imediatamente aos stats do player
    if(b.stat == "attack") {
        // TODO: Adicionar campo attack na classe player
        debug_log("  + Attack +" + b.value);
    }
    else if(b.stat == "defense") {
        // TODO: Adicionar campo defense na classe player
        debug_log("  + Defense +" + b.value);
    }
    else if(b.stat == "speed") {
        p.speed_multiplier += b.value;
    }
    else if(b.stat == "hp_max") {
        p.hp += int(b.value);
        // hpm não existe, usando hp
    }

    // Notificar cliente
    string msg = "{\"type\":\"buff_applied\",\"buff\":" + buff_to_json(b) + "}";
    send_reliable(p.peer_id, msg, 0);

    // Agendar expiração se temporário
    if(b.expires_at > 0) {
        // TODO: Implementar scheduler de expiração
        debug_log("  ⏰ Expira em " + b.time_remaining() + "ms");
    } else {
        debug_log("  ♾️ Buff permanente");
    }

    // Recalcular stats
    recalculate_player_stats(p);

    return true;
}

// Remover buff de um jogador
bool remove_buff(player@ p, string buff_id) {
    if(@p == null) return false;

    debug_log("❌ BUFF: Removendo " + buff_id + " de " + p.name);

    // TODO: Implementar remoção do array de buffs
    // Por enquanto, apenas notifica o cliente

    string msg = "{\"type\":\"buff_expired\",\"buff_id\":\"" + buff_id + "\"}";
    send_reliable(p.peer_id, msg, 0);

    // Recalcular stats
    recalculate_player_stats(p);

    return true;
}

// Recalcular stats finais do jogador
void recalculate_player_stats(player@ p) {
    if(@p == null) return;

    // Criar stats temporários para cálculo
    player_stats calculated_stats;

    // TODO: Somar buffs ativos
    // Por enquanto, usar stats base do player

    // Notificar cliente com stats atualizados
    string msg = "{\"type\":\"stat_update\",\"stats\":" + stats_to_json(calculated_stats) + "}";
    send_unreliable(p.peer_id, msg, 0);
}

// ============================================================
// FUNÇÕES DE EQUIPAMENTOS
// ============================================================

// Equipar item de um slot do inventário
bool equip_item(player@ p, string item_name) {
    if(@p == null) return false;

    debug_log("🎽 EQUIP: " + p.name + " equipando " + item_name);

    // Verificar se tem o item
    if(!p.inv.exists(item_name)) {
        send_reliable(p.peer_id, "{\"type\":\"equip_result\",\"status\":\"error\",\"reason\":\"Item não encontrado\"}", 0);
        return false;
    }

    // TODO: Verificar tipo do item e slot apropriado
    // Por enquanto, lógica simplificada baseada em nome

    bool equipped = false;

    // Armas (TODO: Adicionar campo arma na classe player)
    if(item_name.find("espada") >= 0 || item_name.find("machado") >= 0 || item_name.find("pistol") >= 0) {
        equipped = true;

        // Aplicar buff de arma (+5 attack por exemplo)
        buff@ weapon_buff = buff(generate_buff_id(), BUFF_SOURCE_ITEM, "attack", 5, 0, STACK_BEHAVIOR_REPLACE, item_name);
        apply_buff(p, weapon_buff);
    }
    // Armaduras (TODO: Adicionar campo armadura na classe player)
    else if(item_name.find("colete") >= 0 || item_name.find("armadura") >= 0) {
        equipped = true;

        // Aplicar buff de armadura (+10 defense)
        buff@ armor_buff = buff(generate_buff_id(), BUFF_SOURCE_ITEM, "defense", 10, 0, STACK_BEHAVIOR_REPLACE, item_name);
        apply_buff(p, armor_buff);
    }
    // Capacetes (TODO: Adicionar campo helmet na classe player)
    else if(item_name.find("capacete") >= 0 || item_name.find("helmet") >= 0) {
        equipped = true;

        // Aplicar buff de capacete (+3 defense)
        buff@ helmet_buff = buff(generate_buff_id(), BUFF_SOURCE_ITEM, "defense", 3, 0, STACK_BEHAVIOR_REPLACE, item_name);
        apply_buff(p, helmet_buff);
    }
    // Escudos
    else if(item_name.find("escudo") >= 0 || item_name.find("shield") >= 0) {
        p.escudo = 1;
        equipped = true;

        // Aplicar buff de escudo (+8 defense)
        buff@ shield_buff = buff(generate_buff_id(), BUFF_SOURCE_ITEM, "defense", 8, 0, STACK_BEHAVIOR_REPLACE, item_name);
        apply_buff(p, shield_buff);
    }

    if(!equipped) {
        send_reliable(p.peer_id, "{\"type\":\"equip_result\",\"status\":\"error\",\"reason\":\"Item não equipável\"}", 0);
        return false;
    }

    // Remover do inventário (quantidade -1)
    int current = 0;
    p.inv.get(item_name, current);
    if(current > 1) {
        p.inv.set(item_name, current - 1);
    } else {
        p.inv.delete(item_name);
    }

    // Salvar no banco
    save_player_to_database(p);

    // Notificar sucesso
    send_reliable(p.peer_id, "{\"type\":\"equip_result\",\"status\":\"ok\"}", 0);

    // Enviar sincronização de equipamentos
    send_reliable(p.peer_id, "{\"type\":\"equipment_sync\"," + equipment_to_json(p).substr(1), 0);

    debug_log("  ✓ Item equipado com sucesso");

    return true;
}

// Desequipar item de um slot
bool unequip_item(player@ p, string equip_slot) {
    if(@p == null) return false;

    debug_log("🎽 UNEQUIP: " + p.name + " desequipando " + equip_slot);

    string item_name = "";
    bool unequipped = false;

    // Determinar qual item desequipar
    if(equip_slot == EQUIP_SLOT_SHIELD && p.escudo > 0) {
        p.escudo = 0;
        item_name = "shield";
        unequipped = true;
    }
    // TODO: Adicionar outros slots quando campos forem adicionados na classe player

    if(!unequipped) {
        send_reliable(p.peer_id, "{\"type\":\"equip_result\",\"status\":\"error\",\"reason\":\"Nenhum item neste slot\"}", 0);
        return false;
    }

    // TODO: Retornar item ao inventário
    // TODO: Remover buff associado

    // Salvar no banco
    save_player_to_database(p);

    // Notificar sucesso
    send_reliable(p.peer_id, "{\"type\":\"equip_result\",\"status\":\"ok\"}", 0);

    // Enviar sincronização
    send_reliable(p.peer_id, "{\"type\":\"equipment_sync\"," + equipment_to_json(p).substr(1), 0);

    debug_log("  ✓ Item desequipado");

    return true;
}

// Sincronizar equipamentos e buffs com cliente
void sync_equipment_and_buffs(player@ p) {
    if(@p == null) return;

    string msg = "{\"type\":\"equipment_sync\"," + equipment_to_json(p).substr(1);
    send_reliable(p.peer_id, msg, 0);

    debug_log("📤 Equipment sync enviado para " + p.name);
}

// ============================================================
// HANDLERS DE PROTOCOLO JSON
// ============================================================

// Handler: Equipar item
void handle_equip_request(player@ p, string item_name) {
    if(@p == null) return;
    equip_item(p, item_name);
}

// Handler: Desequipar item
void handle_unequip_request(player@ p, string equip_slot) {
    if(@p == null) return;
    unequip_item(p, equip_slot);
}

// Handler: Requisitar estado de equipamentos
void handle_get_equipment_request(player@ p) {
    if(@p == null) return;
    sync_equipment_and_buffs(p);
}

// ============================================================
// DISPATCHER DE MENSAGENS JSON
// ============================================================

// Parser simples para extrair campo "slot" de string
string json_get_string(string json, string field) {
    string search = "\"" + field + "\":\"";
    int pos = json.find(search);
    if(pos < 0) return "";

    int start = pos + search.length();
    int end = json.find("\"", start);
    if(end < 0) return "";

    return json.substr(start, end - start);
}

// Dispatcher principal para mensagens de equipamentos
void dispatch_equipment_json(player@ p, string json_message) {
    if(@p == null) return;

    string msg_type = json_get_type(json_message);

    if(msg_type == "equip") {
        string item_name = json_get_string(json_message, "item");
        if(item_name == "") {
            // Fallback: usar slot como índice
            int slot = json_get_int(json_message, "slot");
            if(slot >= 0) {
                string[] items = p.inv.get_keys();
                if(slot < int(items.length())) {
                    item_name = items[slot];
                }
            }
        }
        handle_equip_request(p, item_name);
    }
    else if(msg_type == "unequip") {
        string equip_slot = json_get_string(json_message, "equip_slot");
        handle_unequip_request(p, equip_slot);
    }
    else if(msg_type == "get_equipment") {
        handle_get_equipment_request(p);
    }
    else {
        debug_log("⚠️ Tipo de mensagem de equipamento desconhecido: " + msg_type);
        send_reliable(p.peer_id, "{\"type\":\"equip_result\",\"status\":\"error\",\"reason\":\"Unknown message type\"}", 0);
    }
}

// ============================================================
// SISTEMA DE EXPIRAÇÃO DE BUFFS (Scheduler)
// ============================================================

// Timer global para verificar buffs expirados
timer buff_expiration_timer;

// Verificar e remover buffs expirados (chamar periodicamente no game loop)
void check_expired_buffs() {
    // Verificar apenas a cada 1 segundo
    if(buff_expiration_timer.elapsed < 1000) return;
    buff_expiration_timer.restart();

    // TODO: Iterar sobre todos os jogadores e verificar buffs
    // Por enquanto, placeholder

    debug_log("🕐 Verificando buffs expirados...");
}

// ============================================================
// FUNÇÕES AUXILIARES
// ============================================================

// Aplicar buff temporário de consumível
bool apply_consumable_buff(player@ p, string stat, float value, uint64 duration_ms) {
    if(@p == null) return false;

    buff@ consumable_buff = buff(
        generate_buff_id(),
        BUFF_SOURCE_CONSUMABLE,
        stat,
        value,
        duration_ms,
        STACK_BEHAVIOR_STACK,
        "consumable"
    );

    return apply_buff(p, consumable_buff);
}

// Aplicar buff de skill
bool apply_skill_buff(player@ p, string skill_name, string stat, float value, uint64 duration_ms) {
    if(@p == null) return false;

    buff@ skill_buff = buff(
        generate_buff_id(),
        BUFF_SOURCE_SKILL,
        stat,
        value,
        duration_ms,
        STACK_BEHAVIOR_REFRESH,
        skill_name
    );

    return apply_buff(p, skill_buff);
}

// Limpar todos os buffs de um jogador (usado em reset/morte)
void clear_all_buffs(player@ p) {
    if(@p == null) return;

    debug_log("🧹 Limpando todos os buffs de " + p.name);

    // TODO: Remover todos os buffs do array
    // Recalcular stats
    recalculate_player_stats(p);

    // Notificar cliente
    send_reliable(p.peer_id, "{\"type\":\"buffs_cleared\"}", 0);
}
