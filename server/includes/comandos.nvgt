bool emequipe(string nome, string alvo) {
	bool encontrado = false;
	int n = get_player_index_from(nome);
	int nb = get_player_index_from(alvo);
	if (n < 0 || nb < 0) return true;
	else if (n > -1 && nb > -1) {
		if (players[n].nomesequipe.find(alvo) > -1 || players[nb].afk == true ||
			players[nb].pacifico == 1 || get_safezone_at(players[nb].x, players[nb].y, players[nb].map) == true)
			return true;
		else return false;
	}
	return true;
}

string selecionar_jogador(string mapa) {
	string[] nomes;
	for (uint i = 0; i < players.length(); i++) {
		if (players[i].map == mapa) nomes.insert_last(players[i].charname);
	}
	if (nomes.length() == 0) return "";
	return nomes[random(0, nomes.length() - 1)];
}

int refletir(int index, string nome, int x, int y, int dano) {
	if (!players[index].star2) return 0;
	net.send_packet_unreliable(0, players[index].x, "play lih.ogg " + players[index].x + " " + players[index].y, players[index].map);
	net.send_packet_unreliable(0, x, "rico " + nome + "apanhando1.ogg " + x + " " + y, players[index].map);
	return dano;
}
