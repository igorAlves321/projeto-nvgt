double gcforte(carroforte@ m1, player@ p2) {
	if (m1.mapa != p2.map || p2.afk || p2.pacifico == 1) return -1;
	int dx, dy;
	if (m1.x <= p2.x) dx = p2.x - m1.x;
	else dx = m1.x - p2.x;
	if (m1.y <= p2.y) dy = p2.y - m1.y;
