
class clothing_item {
	string name;
	double protection;
	string body_part;
	int durability;
	int max_durability;

	clothing_item(string n, double prot, string body, int dur = 100) {
		name = n;
		protection = prot;
		body_part = body;
		durability = dur;
		max_durability = 100;
	}
}

clothing_item@[] available_clothing;

