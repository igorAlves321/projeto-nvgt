// apartamento.nvgt - Sistema de Apartamentos do EVM Server (convertido de BGT)
// Conversão: BGT → NVGT

apartamento@[] apartamentos;

class apartamento {
	string apartamentoinv;
	string map;
	
	apartamento(string cm, string ci) {
		map = cm;
		apartamentoinv = ci;
	}
	
	void inv_add_item(string itemname, int itemvalue, bool enviar = true) {
		string content = apartamentoinv;
		string[] peramitors = content.split("\r\n");
		string[] values;
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos != -1) {
				values.insert_at(i, peramitors[i].substr(eq_pos + 1));
				peramitors[i] = peramitors[i].substr(0, eq_pos);
			}
		}
		
		if (inv_item_exists(itemname)) {
			int orgval;
			if (inv_item(itemname) > -1) {
				orgval = parse_int(values[inv_item(itemname)]);
			}
			else {
				return;
			}
			
			if (orgval + itemvalue < 1) {
				inv_delete_item(itemname);
			}
			else {
				values[inv_item(itemname)] = "" + (orgval + itemvalue);
				string tempinv;
				for (uint i = 0; i < peramitors.length(); i++) {
					tempinv += peramitors[i] + "=" + values[i] + "\r\n";
				}
				apartamentoinv = tempinv;
			}
		}
		else {
			if (itemvalue > 0) {
				apartamentoinv += itemname + "=" + itemvalue + "\r\n";
			}
		}
		// net.send_reliable_text(0, "apartamentoinv " + apartamentoinv);
	}
	
	bool inv_item_exists(string itemname) {
		string content = apartamentoinv;
		string[] peramitors = content.split("\r\n");
		string[] values;
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos != -1) {
				values.insert_at(i, peramitors[i].substr(eq_pos + 1));
				peramitors[i] = peramitors[i].substr(0, eq_pos);
			}
		}
		
		for (uint i = 0; i < peramitors.length(); i++) {
			if (peramitors[i] == itemname) {
				return true;
			}
		}
		return false;
	}
	
	int inv_item_number(string itemname) {
		string content = apartamentoinv;
		string[] peramitors = content.split("\r\n");
		string[] values;
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos != -1) {
				values.insert_at(i, peramitors[i].substr(eq_pos + 1));
				peramitors[i] = peramitors[i].substr(0, eq_pos);
			}
		}
		
		for (uint i = 0; i < peramitors.length(); i++) {
			if (peramitors[i] == itemname) {
				return parse_int(values[i]);
			}
		}
		return 0;
	}
	
	int inv_item(string itemname) {
		string content = apartamentoinv;
		string[] peramitors = content.split("\r\n");
		string[] values;
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos != -1) {
				values.insert_at(i, peramitors[i].substr(eq_pos + 1));
				peramitors[i] = peramitors[i].substr(0, eq_pos);
			}
		}
		
		for (uint i = 0; i < peramitors.length(); i++) {
			if (peramitors[i] == itemname) {
				return i;
			}
		}
		return -1;
	}
	
	void inv_delete_item(string itemname) {
		string content = apartamentoinv;
		string[] peramitors = content.split("\r\n");
		string[] values;
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos != -1) {
				values.insert_at(i, peramitors[i].substr(eq_pos + 1));
				peramitors[i] = peramitors[i].substr(0, eq_pos);
			}
		}
		
		for (uint i = 0; i < peramitors.length(); i++) {
			if (peramitors[i] == itemname) {
				apartamentoinv = apartamentoinv.replace(itemname + "=" + values[i] + "\r\n", "");
			}
		}
	}
}

void colocar_apartamento(string map, string itens = "") {
	apartamento c(map, itens);
	apartamentos.insert_last(c);
}

void atapartamento(string map, string itens) {
	for (uint i = 0; i < apartamentos.length(); i++) {
		if (apartamentos[i].map == map) {
			apartamentos[i].apartamentoinv = itens;
			// net.send_reliable_text(0, "apartamentoinv " + apartamentos[i].apartamentoinv);
			break;
		}
	}
}


// ============================================================================
// SISTEMA DE IMOBILIARIA MODERNO (Mini-Task 17)
// ============================================================================

class player_house {
	string owner;
	string map_name;
	bool is_locked;
	dictionary chest;

	player_house(string p_owner, string p_map) {
		owner = p_owner;
		map_name = p_map;
		is_locked = true;
	}
}

player_house@[] active_houses;

int get_house_index_by_owner(const string&in owner_name) {
	for(uint i = 0; i < active_houses.length(); i++) {
		if(active_houses[i].owner == owner_name) return int(i);
	}
	return -1;
}

int get_house_index_by_map(const string&in map_name) {
	for(uint i = 0; i < active_houses.length(); i++) {
		if(active_houses[i].map_name == map_name) return int(i);
	}
	return -1;
}

bool house_is_locked_for_player(const string&in player_name, const string&in destination_map) {
	int hidx = get_house_index_by_map(destination_map);
	if(hidx < 0) return false;
	if(active_houses[hidx].owner == player_name) return false;
	return active_houses[hidx].is_locked;
}

void cmd_comprarcasa(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) return;
	player@ p = players[player_index];
	if(p is null) return;

	const int preco_casa = 15000;
	if(get_house_index_by_owner(p.charname) >= 0) {
		send_reliable_text(p.peer_id, "say [SISTEMA] Você ja possui uma propriedade!", 0);
		return;
	}

	if(p.gold < preco_casa) {
		send_reliable_text(p.peer_id, "say [SISTEMA] Você precisa de " + preco_casa + " moedas para comprar uma casa.", 0);
		return;
	}

	p.gold -= preco_casa;
	p.saldo = p.gold;

	string novo_mapa = "casa_" + p.charname;
	player_house@ nova = player_house(p.charname, novo_mapa);
	active_houses.insert_last(@nova);

	add_role(p.charname, "builder", "system", "Dono de casa");
	send_reliable_text(p.peer_id, "ps trade_success.ogg", 0);
	send_reliable_text(p.peer_id, "say [CASA] Compra concluida. Sua casa e o mapa '" + novo_mapa + "'. Use /trancar e /bau.", 0);
}

void cmd_toggle_lock(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) return;
	player@ p = players[player_index];
	if(p is null) return;

	int hidx = get_house_index_by_owner(p.charname);
	if(hidx < 0) {
		send_reliable_text(p.peer_id, "say [CASA] Você não possui casa.", 0);
		return;
	}

	active_houses[hidx].is_locked = !active_houses[hidx].is_locked;
	string status = active_houses[hidx].is_locked ? "trancada" : "destrancada";
	send_reliable_text(p.peer_id, "say [CASA] Sua casa agora esta " + status + ".", 0);
}

void cmd_guardar_bau(int player_index, string item_name, int qty) {
	if(player_index < 0 || player_index >= int(players.length())) return;
	if(qty <= 0 || item_name == "") return;
	player@ p = players[player_index];
	if(p is null) return;

	int hidx = get_house_index_by_owner(p.charname);
	if(hidx < 0) {
		send_reliable_text(p.peer_id, "say [ERRO] Você não possui casa.", 0);
		return;
	}
	if(p.map != active_houses[hidx].map_name) {
		send_reliable_text(p.peer_id, "say [ERRO] Você precisa estar dentro da sua casa para usar o bau.", 0);
		return;
	}

	if(!remove_item_with_sync(p, item_name, qty)) {
		send_reliable_text(p.peer_id, "say [ERRO] Item/quantidade inválido no inventario.", 0);
		return;
	}

	double current_qty = 0;
	active_houses[hidx].chest.get(item_name, current_qty);
	active_houses[hidx].chest.set(item_name, current_qty + qty);
	send_reliable_text(p.peer_id, "say [BAU] Você guardou " + qty + "x " + item_name + ".", 0);
}

void cmd_retirar_bau(int player_index, string item_name, int qty) {
	if(player_index < 0 || player_index >= int(players.length())) return;
	if(qty <= 0 || item_name == "") return;
	player@ p = players[player_index];
	if(p is null) return;

	int hidx = get_house_index_by_owner(p.charname);
	if(hidx < 0) {
		send_reliable_text(p.peer_id, "say [ERRO] Você não possui casa.", 0);
		return;
	}
	if(p.map != active_houses[hidx].map_name) {
		send_reliable_text(p.peer_id, "say [ERRO] Você precisa estar dentro da sua casa para usar o bau.", 0);
		return;
	}

	double current_qty = 0;
	if(!active_houses[hidx].chest.get(item_name, current_qty) || current_qty < qty) {
		send_reliable_text(p.peer_id, "say [ERRO] Quantidade insuficiente no bau.", 0);
		return;
	}

	active_houses[hidx].chest.set(item_name, current_qty - qty);
	if(!add_item_with_sync(p, item_name, qty)) {
		active_houses[hidx].chest.set(item_name, current_qty);
		send_reliable_text(p.peer_id, "say [ERRO] Não foi possível devolver o item ao inventario.", 0);
		return;
	}

	send_reliable_text(p.peer_id, "say [BAU] Você retirou " + qty + "x " + item_name + ".", 0);
}
