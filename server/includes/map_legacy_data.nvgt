
class obj_data {
	int x, y;
	string map, itemname;
	string sound_get = "";
	int amount = 1;
	bool disable_respawn = false;
	int time_respawn = 0;
	int time_out = 0;
	timer trespawn;
	int x_data = 0;
	timer respawn_timer;

	obj_data() {}

	obj_data(int ox, int oy, int otimeout, bool odisable, int oamount, string oitemname, string omap, string osound, int otrespawn) {
		x = ox;
		y = oy;
		time_out = otimeout;
		disable_respawn = odisable;
		amount = oamount;
		itemname = oitemname;
		map = omap;
		sound_get = osound;
		time_respawn = otrespawn;
	}
}

class wall_data {
	int x, y;
