class death {
	int minx, maxx, miny, maxy;
	int time = 1000;
	int enable_progressive_death = 1;
	int require_item = 0;
	double life = 100;
	double item_cantity = 0;
	string reason = "";
	string item = "";
	bool instant_death = false;

	death(int minx, int maxx, int miny, int maxy, int damage, string item_required, bool instant) {
		this.minx = minx; this.maxx = maxx;
		this.miny = miny; this.maxy = maxy;
		this.life = damage;
		this.item = item_required;
		this.require_item = item_required == "" ? 0 : 1;
		this.instant_death = instant;
		this.enable_progressive_death = instant ? 0 : 1;
	}

	death(int p1, int p2, int p3, int p4, int p5, int p6, int p7, string s1, string s2, int p8, int p9) {
		this.minx = p1; this.maxx = p2;
		this.miny = p3; this.maxy = p4;
		this.time = p5;
		this.enable_progressive_death = p6;
		this.life = p7;
		this.reason = s1;
		this.item = s2;
		this.require_item = p8;
		this.item_cantity = p9;
		this.instant_death = (p6 == 0);
	}
}

class extract {
	int minx, maxx, miny, maxy;
	int hmitems = 1;
	int attempts = 1;
	int initial_attempts = 1;
	int extracttime = 1000;
	string extracting = "";
	string extracted = "";
	string item = "";
	string name = "";
	timer extracttimer;

	extract(int minx, int maxx, int miny, int maxy, string name) {
		this.minx = minx; this.maxx = maxx;
		this.miny = miny; this.maxy = maxy;
		this.name = name;
		this.item = name;
	}

	extract(int p1, int p2, int p3, int p4, int p5, int p6, int p7, string s1, string s2, string s3) {
		this.minx = p1; this.maxx = p2;
		this.miny = p3; this.maxy = p4;
		this.hmitems = p5;
		this.attempts = p6;
		this.initial_attempts = p6;
		this.extracttime = p7;
		this.item = s1;
		this.name = s1;
		this.extracting = s2;
		this.extracted = s3;
	}

	void extract_item(int player_index) {
		if(player_index < 0 || player_index >= int(players.length())) return;
		int mapindex = get_map_index_from(players[player_index].map);
		if(mapindex < 0) return;

		attempts--;
		if(extracting != "") {
			server_maps[mapindex].send_packet(0, "play " + extracting + ".ogg " + players[player_index].x + " " + players[player_index].y, true);
		}
		if(attempts <= 0) {
			if(extracted != "") {
				server_maps[mapindex].send_packet(0, "play " + extracted + ".ogg " + players[player_index].x + " " + players[player_index].y, true);
			}
			server_maps[mapindex].spawn_obj("" + players[player_index].x, players[player_index].y, 30000, 1, hmitems, item, "get" + item);
			attempts = initial_attempts;
		}
	}
}

class jaula {
	int x, y;
	int dueno = -1;
	int vida = 1000;
	string map;

	jaula(int x, int y, string mapname) {
		this.x = x; this.y = y;
		this.map = mapname;
	}
}

class earthquake {
	int x, y;
	int minx, maxx, miny, maxy;
	string map, owner = "";
	int earthquake_sound = -1;
	int intensity = 5;
	int duration = 60000;
	bool active = false;
	timer t, damagetimer;

	earthquake(int minx, int maxx, int miny, int maxy, int intensity, string mapname) {
		this.minx = minx; this.maxx = maxx;
		this.miny = miny; this.maxy = maxy;
		this.intensity = intensity;
		this.map = mapname;
	}

	earthquake(string owner_name, int range_x, int range_y, string mapname) {
		this.owner = owner_name;
		this.x = range_x;
		this.y = range_y;
		this.minx = 0;
		this.maxx = range_x;
		this.miny = 0;
		this.maxy = range_y;
		this.map = mapname;
		this.active = true;
		this.earthquake_sound = spawn_moving_sound("rumble.ogg", range_x, range_y, mapname);
	}
}

void create_earthquake(string owner_name, int range_x, int range_y, string mapname) {
	int mapindex = get_map_index_from(mapname);
	if(mapindex < 0 || mapindex >= int(server_maps.length())) return;

	earthquake@ quake = earthquake(owner_name, range_x, range_y, mapname);
	server_maps[mapindex].earthquakes.insert_last(quake);

	string locate = server_maps[mapindex].get_locate_at();
	if(locate == "") locate = "em " + mapname;
	send_reliable(0, "msg2 ;un terremoto devastador está fazendo estragos; " + locate, 0);
}
