
#include "network.nvgt"

canhao@[] canhaos_ativos;

class canhao {
	int x, y;
	string map;
	string somcanhao;
	timer canhaotimer;
	int canhaotime;

	canhao(int cx, int cy, string cmap, int ct) {
		x = cx;
		y = cy;
		map = cmap;
		canhaotime = ct;
		somcanhao = spawn_moving_sound("rocketloop.ogg", x, y, map);
	}
}

void canhaoloop() {
	for (uint i = 0; i < canhaos_ativos.length(); i++) {
		if (canhaos_ativos[i].y < 0) {
			destroy_moving_sound(canhaos_ativos[i].somcanhao);
			spawn_canhao(random(1, 20), 10, canhaos_ativos[i].map, (canhaos_ativos[i].canhaotime - 10));
			canhaos_ativos.remove_at(i);
			break;
		}

		if (canhaos_ativos[i].canhaotimer.elapsed >= canhaos_ativos[i].canhaotime) {
			for (uint i2 = 0; i2 < players.length(); i2++) {
				if (canhaos_ativos[i].y == players[i2].y && players[i2].map == canhaos_ativos[i].map &&
					players[i2].x == canhaos_ativos[i].x) {
					players[i2].health = 0;
					players[i2].lasthit = "canhão";
				}
			}

			if (canhaos_ativos[i].y >= 0) {
				canhaos_ativos[i].y--;
				update_moving_sound(canhaos_ativos[i].somcanhao, canhaos_ativos[i].x, canhaos_ativos[i].y);
				canhaos_ativos[i].canhaotimer.restart();
			}
		}
	}
}

void spawn_canhao(int x, int y, string map, int tempo) {
	if (tempo < 50) tempo = 50;
	canhao c(x, y, map, tempo);
	canhaos_ativos.insert_last(c);
}
