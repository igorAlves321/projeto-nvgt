// Funcao para mover jogador de mapa (wrapper de changemap)
void move_player_to_map(int player_index, string destination_map, int dest_x, int dest_y) {
    changemap(destination_map, player_index, dest_x, dest_y);
}

// Funcao para obter timestamp atual em segundos desde epoch
uint64 time_stamp() {
    datetime dt;
    return dt.timestamp;
}

// Comparacao de strings case-insensitive (retorna true se iguais)
bool string_compare_insensitive(const string& in str1, const string& in str2) {
    return str1.lower() == str2.lower();
}

// ===== Compatibilidade BGT (funcoes ausentes sem bgt_compat) =====
string string_replace(const string& in str, const string& in search, const string& in repl, bool replace_all = true) {
    return str.replace(search, repl, replace_all);
}

string string_trim_left(const string& in str, uint count) {
    if(str == "") return str;
    return str.substr(count);
}

string string_to_lower_case(const string& in str) {
    return str.lower();
}

string[] string_split(const string& in str, const string& in delim, bool full = true) {
    return str.split(delim, full);
}

bool string_is_alphanumeric(const string& in str) {
    return str.is_alphanumeric();
}

double absolute(double x) {
    return abs(x);
}

int absolute(int x) {
    return abs(x);
}

string string_hash(const string& in data, int algorithm, bool binary) {
    if(algorithm == 1) return string_hash_sha256(data, binary);
    if(algorithm == 2) return string_hash_sha512(data, binary);
    return "";
}

// Funcao parse_uint - converte string para uint
uint parse_uint(const string& in str) {
    return string_to_number(str);
}

// Funcao min - retorna o menor valor entre dois numeros
int min(int a, int b) {
    return a < b ? a : b;
}

double min(double a, double b) {
    return a < b ? a : b;
}

// Funcao para gerar strings aleatorias (compatibilidade BGT->NVGT)
string randomstring(int length = 16) {
    string chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    string result = "";
    for (int i = 0; i < length; i++) {
        result += chars[random(0, chars.length() - 1)];
    }
    return result;
}

