// Arrays de NPCs e entidades (declarados aqui para uso global)
class wall_entity {
    int x, y;
    string map;
    int vida;
    wall_entity(int wx, int wy, string wmap, int wvida) {
        x = wx; y = wy; map = wmap; vida = wvida;
    }
}

class projetei_entity {
    int x, y;
    string map;
    string somprojetei;
    projetei_entity(int px, int py, string pmap, string psom) {
        x = px; y = py; map = pmap; somprojetei = psom;
    }
}

class fogoqueimar_entity {
    int x, y;
    string map;
    string somfogo;
    fogoqueimar_entity(int fx, int fy, string fmap, string fsom) {
        x = fx; y = fy; map = fmap; somfogo = fsom;
    }
}

class npc_entity {
    int x, y;
    string map, mapa;
    int vida;
    string golpeado;
    bool morreu = false, morrendo = false, nasceu = true;
    // Propriedades para sons e movimento
    timer tsom, tandar, tatirar, tmorreu;
    int nsom = 1000;
    int natirar = 2000;
    string njogador = "";
    npc_entity(int nx, int ny, string nmap, int nvida) {
        x = nx; y = ny; map = nmap; mapa = nmap; vida = nvida; golpeado = "";
        tsom.restart(); tandar.restart(); tatirar.restart(); tmorreu.restart();
    }
}

