// Funcao join para arrays de strings (compatibilidade BGT)
string join(string[] array, string delimiter) {
    if(array.length() == 0) return "";

    string result = array[0];
    for(uint i = 1; i < array.length(); i++) {
        result += delimiter + array[i];
    }
    return result;
}

// Funcao datetime_now para timestamps
string datetime_now() {
    datetime dt;
    return dt.format("%Y-%m-%d %H:%M:%S");
}

// ===== FUNCOES DE AUTENTICACAO COM HASH SHA-256 =====

// Hash de senha usando SHA-256
string hash_password(string password) {
    if(password == "") return "";
    // Retorna hash SHA-256 em formato hexadecimal
    return string_hash(password, 1, false);
}

// Verificar senha contra hash
bool verify_password_hash(string password, string stored_hash) {
    if(password == "" || stored_hash == "") return false;
    string computed_hash = hash_password(password);
    return (computed_hash == stored_hash);
}

// Validar username (alfanumerico, 3-20 caracteres)
bool is_valid_username(string username) {
    if(username.length() < 3 || username.length() > 20) return false;
    return string_is_alphanumeric(username);
}

// Validar email (verificacao basica)
bool is_valid_email(string email) {
    if(email.length() < 5) return false;
    if(email.find("@") == -1) return false;
    if(email.find(".") == -1) return false;
    return true;
}

// Variavel global para controle de jogo pausado
bool gamestopped = false;

// Funcao para trocar jogador de mapa
void changemap(string destination_map, int player_index, int dest_x, int dest_y) {
    if(player_index < 0 || player_index >= int(players.length())) return;
    
    // Obter indice do mapa antigo
    string old_map = players[player_index].map;
    int old_map_index = get_map_index_from(old_map);
    
    // Notificar outros jogadores do mapa antigo que o jogador saiu
    if(old_map_index >= 0 && old_map_index < int(server_maps.length())) {
        server_maps[old_map_index].send_to_others(players[player_index].peer_id, 0, 
            "remove_player_from_map " + players[player_index].charname, true);
    }
    
    // Atualizar posicao e mapa do jogador
    players[player_index].map = destination_map;
    players[player_index].x = dest_x;
    players[player_index].y = dest_y;
    
    // Obter indice do novo mapa
    int new_map_index = get_map_index_from(destination_map);
    if(new_map_index >= 0) {
        players[player_index].mapindex = new_map_index;
    }
    
    // Atualizar lista de jogadores nos mapas
    if(old_map_index >= 0 && old_map_index < int(server_maps.length())) {
        server_maps[old_map_index].update_players_on_map(false);
    }
    if(new_map_index >= 0 && new_map_index < int(server_maps.length())) {
        server_maps[new_map_index].update_players_on_map(false);
    }
    
    // CORRECAO: Carregar dados do mapa e enviar para o cliente
    file f;
    string map_file = "maps/" + destination_map + ".map";
    if(!file_exists(map_file)) {
        string alt_map_file = "server/maps/" + destination_map + ".map";
        if(file_exists(alt_map_file)) map_file = alt_map_file;
    }
    string map_data = "";
    
    if(f.open(map_file, "rb")) {
        map_data = f.read();
        f.close();
        // Enviar com formato BGT (dados do mapa + coordenadas)
        send_reliable(players[player_index].peer_id, "changemap " + map_data + "\r\nx:" + dest_x + "\r\ny:" + dest_y + "\r\n", 0);
        debug_log("ðŸ“¤ Enviado changemap para " + players[player_index].charname + ": " + destination_map + " (" + dest_x + "," + dest_y + ")");
    } else {
        // Se nao conseguir ler o arquivo, enviar formato simplificado (fallback)
        send_reliable(players[player_index].peer_id, "changemap " + destination_map + " " + dest_x + " " + dest_y, 0);
        debug_log("[WARN] Arquivo de mapa não encontrado: " + map_file + " - enviando formato simples");
    }
    
    // Enviar lista de jogadores do novo mapa para o jogador
    if(new_map_index >= 0 && new_map_index < int(server_maps.length())) {
        // Construir lista de jogadores no mapa
        string final = "set_map_players ";
        int count = 0;
        
        for(uint x = 0; x < server_maps[new_map_index].mapplayers.length(); x++) {
            int pindex = server_maps[new_map_index].mapplayers[x];
            if(pindex >= 0 && pindex < int(players.length())) {
                final += players[pindex].charname + " ";
                final += players[pindex].x + " ";
                final += players[pindex].y + " ";
                final += players[pindex].bipar + " ";
                final += players[pindex].pacifico + " ";
                final += players[pindex].peer_id + "\r\n";
                count++;
            }
        }
        
        // Se nao ha jogadores, enviar "none"
        if(count == 0) {
            final = "set_map_players none";
        }
        
        send_reliable(players[player_index].peer_id, final, 6);
        
        // Notificar outros jogadores do novo mapa
        string add_packet = "add_player_to_map " + players[player_index].charname + " " + 
            players[player_index].x + " " + players[player_index].y + " " + 
            players[player_index].bipar + " " + players[player_index].pacifico + " " + 
            players[player_index].peer_id;
        server_maps[new_map_index].send_to_others(players[player_index].peer_id, 6, add_packet, true);
        
        debug_log("ðŸ“¤ Lista de jogadores enviada e notificados (" + count + " no mapa)");
    }
}

// Funcao para escrever arquivo (wrapper)
void file_write(string filename, string content) {
    file f;
    if(f.open(filename, "wb")) {
        f.write(content);
        f.close();
    }
}

// Funcao para verificar se jogo esta desabilitado em coordenadas especificas
bool is_game_disabled(int x, int y, string map) {
    if(map == "") return false;
    for(uint i = 0; i < game_disabled_zones.length(); i++) {
        if(game_disabled_zones[i] is null) continue;
        if(game_disabled_zones[i].is_inside(x, y, map)) {
            return true;
        }
    }
    return false;
}

// Funcao para verificar se uma posicao e caminhavel (Task 4 - movimento_jogador.md)
// Valida: limites do mapa, paredes, obstaculos
bool is_walkable(int x, int y, string mapname) {
    int mapindex = get_map_index_from(mapname);
    
    // Se o mapa nao foi carregado ainda, permitir movimento (confiar no cliente)
    if(mapindex < 0 || mapindex >= int(server_maps.length())) return true;
    
    // Verificar limites do mapa
    if(x < 0 || x > server_maps[mapindex].max_x) return false;
    if(y < 0 || y > server_maps[mapindex].max_y) return false;
    
    // Obter tile na posicao
    string tile = server_maps[mapindex].get_tile_at(x, y);
    
    // NOTA: Tiles vazios agora sao permitidos (mapas podem nao ter tile em toda area)
    // Apenas bloquear tiles explicitamente marcados como parede
    if(tile.find("wall") >= 0 || tile == "blocked" || tile == "obstacle") return false;
    
    return true;
}

// Funcao para verificar se movimento e valido (distancia maxima, anti-teleport)
bool is_valid_movement(int old_x, int old_y, int new_x, int new_y, int max_distance = 5) {
    int dx = abs(new_x - old_x);
    int dy = abs(new_y - old_y);
    
    // Verificar se movimento nao e muito grande (anti-cheat basico)
    if(dx > max_distance || dy > max_distance) return false;
    
    return true;
}

// Funcao ar() - parece ser relacionada a arredondamento
int ar(double value) {
    return int(value + 0.5);
}


// Funcao send_packet10 - envia pacote para todos no mapa exceto remetente
void send_packet10(int channel, string sender, string sender2, string packet, string mapname) {
    int mapindex = get_map_index_from(mapname);
    if(mapindex >= 0 && mapindex < int(server_maps.length())) {
        server_maps[mapindex].send_packet(channel, packet, true);
    }
}





