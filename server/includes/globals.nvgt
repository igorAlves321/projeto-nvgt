// delinear() movido para server_map.nvgt (versao mais completa com parametro opcional)

uint64 get_time_stamp() {
    // NVGT equivalent to get_ticks() ou timestamp
    return ticks();
}

void debug_log(string message) {
    datetime dt;
    string time_str = "[" + dt.format("%Y-%m-%d %H:%M:%S") + "] ";
    
    // Garante que a pasta debug existe
    directory_create("debug");
    
    // Salva no arquivo de log
    file f;
    if (f.open("debug/server_log.txt", "a")) {
        f.write(time_str + message + "\n");
        f.close();
    }
    
    // Tambem mantem log em log.md para compatibilidade
    file f2;
    if (f2.open("log.md", "a")) {
        f2.write(time_str + message + "\n");
        f2.close();
    }
}

// Funcoes de compatibilidade BGT->NVGT
// @deprecated Use parse_int() diretamente. Esta funcao sera removida em versoes futuras.
int string_to_number(string str) {
    return parse_int(str);
}

double string_to_float(string str) {
    return parse_float(str);
}

string number_to_string(int num) {
    return "" + num;
}

int string_contains(const string& in text, const string& in search, int occurance = 1) {
    uint c = 0;
    int pos = -1;
    while(c < occurance) {
        pos = text.find(search, pos + 1);
        if(pos > -1) c++;
        else break;
    }
    return c == occurance ? pos : -1;
}

string normalize_legacy_text(string text) {
    if(text == "") return text;
    // Corrige mojibake comum de conteúdo legado ANSI/UTF-8.
    text = text.replace("Ã£", "ã");
    text = text.replace("Ã¡", "á");
    text = text.replace("Ã©", "é");
    text = text.replace("Ã­", "í");
    text = text.replace("Ã³", "ó");
    text = text.replace("Ãº", "ú");
    text = text.replace("Ã¢", "â");
    text = text.replace("Ãª", "ê");
    text = text.replace("Ã´", "ô");
    text = text.replace("Ã§", "ç");
    text = text.replace("Ã‰", "É");
    text = text.replace("Ã", "Í");
    text = text.replace("Ã“", "Ó");
    text = text.replace("Ãš", "Ú");
    text = text.replace("Ã‡", "Ç");
    text = text.replace("Ã€", "À");
    text = text.replace("ÃŠ", "Ê");
    text = text.replace("Ã”", "Ô");
    text = text.replace("Ã•", "Õ");
    text = text.replace("Ãœ", "Ü");
    text = text.replace("Ã±", "ñ");
    text = text.replace("Ã‘", "Ñ");
    text = text.replace("Â¿", "¿");
    text = text.replace("Â¡", "¡");
    text = text.replace("â€œ", "\"");
    text = text.replace("â€", "\"");
    text = text.replace("â€˜", "'");
    text = text.replace("â€™", "'");
    text = text.replace("â€“", "-");
    text = text.replace("â€”", "-");
    text = text.replace("â€¦", "...");
    text = text.replace("ï»¿", "");
    return text;
}
string normalize_network_packet_text(string packet) {
    string[] text_prefixes = {"say", "msg", "msg2", "msg3", "msg4", "msgnormal", "announce"};
    for(uint i = 0; i < text_prefixes.length(); i++) {
        string pref = text_prefixes[i] + " ";
        if(packet.find(pref) == 0) {
            string payload = packet.substr(pref.length());
            return pref + normalize_legacy_text(payload);
        }
    }
    return packet;
}

void send_reliable(uint64 peer_id, string message) {
    send_reliable_text(peer_id, normalize_network_packet_text(message), 0);
}

void send_reliable(uint64 peer_id, string message, int channel) {
    send_reliable_text(peer_id, normalize_network_packet_text(message), channel);
}

