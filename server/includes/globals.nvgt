// Função write_to para salvar dados de jogador
void write_to(string playername, string filename, string content) {
    string filepath = "server/players/" + playername + "_" + filename;
    file f;
    if (f.open(filepath, "w")) {
        f.write(content);
        f.close();
    }
}

// Funções utilitárias usando NVGT nativo
string[] nvgt_split(string str, string delimiter) {
    return str.split(delimiter);
}

// delinear() movido para server_map.nvgt (versão mais completa com parâmetro opcional)

uint64 get_time_stamp() {
    // NVGT equivalent to get_ticks() ou timestamp
    return ticks();
}

void debug_log(string message) {
    datetime dt;
    string time_str = "[" + dt.format("%Y-%m-%d %H:%M:%S") + "] ";
    
    // Garante que a pasta debug existe
    directory_create("debug");
    
    // Salva no arquivo de log
    file f;
    if (f.open("debug/server_log.txt", "a")) {
        f.write(time_str + message + "\n");
        f.close();
    }
    
    // Também mantém log em log.md para compatibilidade
    file f2;
    if (f2.open("log.md", "a")) {
        f2.write(time_str + message + "\n");
        f2.close();
    }
}

// Funções de compatibilidade BGT→NVGT
int string_to_number(string str) {
    return parse_int(str);
}

double string_to_float(string str) {
    return parse_float(str);
}

string number_to_string(int num) {
    return "" + num;
}

bool string_contains(string text, string search, int pos = 0) {
    return text.find(search, pos) >= 0;
}

// Timer wrapper para compatibilidade
class game_timer {
    timer t;
    void restart() { t.restart(); }
    uint64 elapsed() { return t.elapsed; }
    void force(uint64 time) { t.force(time); }
    void pause() { t.pause(); }
}

// Instância wrapper
class game_instance {
    instance inst;
    game_instance(string name) {
        inst = instance(name);
    }
    bool is_already_running() {
        return inst.is_already_running;
    }
}

// Funções de arquivo usando NVGT nativo
string file_read_all(string filename) {
    file f;
    string content = "";
    if (f.open(filename, "r")) {
        content = f.read();
        f.close();
    }
    return content;
}

void file_write_all(string filename, string content) {
    file f;
    if (f.open(filename, "w")) {
        f.write(content);
        f.close();
    }
}

// Função para gerar strings aleatórias
string generate_random_string(int length) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    string result = "";
    for(int i = 0; i < length; i++) {
        result += chars[random(0, int(chars.length()) - 1)];
    }
    return result;
}

