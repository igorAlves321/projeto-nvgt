// Função para mover jogador de mapa (wrapper de changemap)
void move_player_to_map(int player_index, string destination_map, int dest_x, int dest_y) {
    changemap(destination_map, player_index, dest_x, dest_y);
}

// Função para obter timestamp atual em segundos desde epoch
uint64 time_stamp() {
    datetime dt;
    return dt.timestamp;
}

// Comparação de strings case-insensitive (retorna true se iguais)
bool string_compare_insensitive(const string& in str1, const string& in str2) {
    return str1.lower() == str2.lower();
}

// Função parse_uint - converte string para uint
uint parse_uint(const string& in str) {
    return string_to_number(str);
}

// Função min - retorna o menor valor entre dois números
int min(int a, int b) {
    return a < b ? a : b;
}

double min(double a, double b) {
    return a < b ? a : b;
}

// Função para gerar strings aleatórias (compatibilidade BGT→NVGT)
string randomstring(int length = 16) {
    string chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    string result = "";
    for (int i = 0; i < length; i++) {
        result += chars[random(0, chars.length() - 1)];
    }
    return result;
}

