void colocar_fogoqueimar(int x, int y, int duracao, string mapname) {
    // FIXME: spawn_moving_sound será definido em msound.nvgt
    fogoqueimar_entity@ fogo = fogoqueimar_entity(x, y, mapname, ""); // spawn_moving_sound("fire.wav", x, y, mapname)
    fogoqueimars.push_back(fogo);
}

// Função write_to para salvar dados de jogador
void write_to(string playername, string filename, string content) {
    string filepath = "server/players/" + playername + "_" + filename;
    file f;
    if (f.open(filepath, "w")) {
        f.write(content);
        f.close();
    }
}

// Funções utilitárias usando NVGT nativo
string[] nvgt_split(string str, string delimiter) {
    return str.split(delimiter);
}

string[] delinear(string text) {
    // BGT delinear() equivalent usando NVGT split
    return text.split("\r\n");
}

string linear(string[] a) {
    string final;
    for (uint i = 0; i < a.length(); i++) {
        final += (a[i] + "\r\n");
    }
    return final;
}

uint64 get_time_stamp() {
    // NVGT equivalent to get_ticks() ou timestamp
    return ticks();
}

void debug_log(string message) {
    datetime dt;
    string time_str = "[" + dt.format("%Y-%m-%d %H:%M:%S") + "] ";
    file f;
    if (f.open("log.md", "a")) {
        f.write(time_str + message + "\n");
        f.close();
    }
}

// Funções de compatibilidade BGT→NVGT
int string_to_number(string str) {
    return parse_int(str);
}

double string_to_float(string str) {
    return parse_float(str);
}

string number_to_string(int num) {
    return "" + num;
}

bool string_contains(string text, string search, int pos = 0) {
    return text.find(search, pos) >= 0;
}

// Timer wrapper para compatibilidade
class game_timer {
    timer t;
    void restart() { t.restart(); }
    uint64 elapsed() { return t.elapsed; }
    void force(uint64 time) { t.force(time); }
    void pause() { t.pause(); }
}

// Instância wrapper
class game_instance {
    instance inst;
    game_instance(string name) {
        inst = instance(name);
    }
    bool is_already_running() {
        return inst.is_already_running;
    }
}

// Funções de arquivo usando NVGT nativo
string file_read_all(string filename) {
    file f;
    string content = "";
    if (f.open(filename, "r")) {
        content = f.read();
        f.close();
    }
    return content;
}

void file_write_all(string filename, string content) {
    file f;
    if (f.open(filename, "w")) {
        f.write(content);
        f.close();
    }
}

// Função para gerar strings aleatórias
string generate_random_string(int length) {
    string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
    string result = "";
    for(int i = 0; i < length; i++) {
        result += chars[random(0, int(chars.length()) - 1)];
    }
    return result;
}

// Função de sleep compatível
void server_wait(int milliseconds) {
    wait(milliseconds);
}

// Variáveis globais do servidor (compatibilidade BGT)
const string bell = ascii_to_character(7);
const string bell2 = ascii_to_character(9);

// Arrays para compatibilidade
string[] weapons(39);
string[] weapons2(39);

// Função join para arrays de strings (compatibilidade BGT)
string join(string[] array, string delimiter) {
    if(array.length() == 0) return "";

    string result = array[0];
    for(uint i = 1; i < array.length(); i++) {
        result += delimiter + array[i];
    }
    return result;
}

// Função datetime_now para timestamps
string datetime_now() {
    datetime dt;
    return dt.format("%Y-%m-%d %H:%M:%S");
}

// ===== FUNÇÕES DE AUTENTICAÇÃO COM HASH SHA-256 =====

// Hash de senha usando SHA-256
string hash_password(string password) {
    if(password == "") return "";
    // Retorna hash SHA-256 em formato hexadecimal
    return string_hash(password, 1, false);
}

// Verificar senha contra hash
bool verify_password_hash(string password, string stored_hash) {
    if(password == "" || stored_hash == "") return false;
    string computed_hash = hash_password(password);
    return (computed_hash == stored_hash);
}

// Validar username (alfanumérico, 3-20 caracteres)
bool is_valid_username(string username) {
    if(username.length() < 3 || username.length() > 20) return false;
    return string_is_alphanumeric(username);
}

// Validar email (verificação básica)
bool is_valid_email(string email) {
    if(email.length() < 5) return false;
    if(email.find("@") == -1) return false;
    if(email.find(".") == -1) return false;
    return true;
}
