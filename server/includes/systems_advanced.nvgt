
// Banimentos vivem em server_bans (db_bans.nvgt); o antigo banidos.dat e
// importado uma unica vez por migrate_banidos_dat_to_db().

int calculate_combat_damage(int player_index, int base_damage) {
	if(player_index < 0 || player_index >= int(players.length())) {
		return base_damage;
	}

	int final_damage = base_damage;

	string equipped_weapon = get_equipped_item_in_slot(players[player_index], EQUIP_SLOT_WEAPON);
	if(equipped_weapon != "" && equipped_weapon != "soco") {
		final_damage += int(base_damage * 0.10);
	}

	if(players[player_index].inv_item_number("anel_de_força") > 0) {
		final_damage += int(final_damage * 0.1);
	}

	if(players[player_index].inv_item_number("luvas_de_combate") > 0) {
		final_damage += int(final_damage * 0.15);
	}

	if(players[player_index].inv_item_number("amuleto_de_poder") > 0) {
		final_damage += int(final_damage * 0.2);
	}

	if(random(1, 100) <= 5) {
		final_damage = final_damage * 2;
		send_reliable_text(players[player_index].peer_id, "msg2 CRÍTICO!", 0);
	}

	return final_damage;
}

int calculate_damage_reduction(int player_index, int incoming_damage) {
	double reduction = 0.0;

	reduction += players[player_index].clothing_protection / 100.0;

	if(players[player_index].colete_aprova_de_balas > 0) {
		reduction += 0.3;
	}

	if(players[player_index].capacetepolicia > 0) {
		reduction += 0.1;
	}

	if(players[player_index].casacopeles > 0) {
		reduction += 0.15;
	}

	if(reduction > 0.9) reduction = 0.9;

	int reduced_damage = int(incoming_damage * (1.0 - reduction));
	return reduced_damage;
}

// Estatisticas acumuladas do servidor. A persistencia fica em
// server_statistics (history.nvgt), uma linha por dia: os totais abaixo sao a
// soma de todas as datas e save_stats() soma na linha de hoje so o que mudou
// desde a ultima gravacao. O antigo stats.dat entra como a linha '1970-01-01'.
class statistics {
	int total_kills = 0;
	int total_deaths = 0;
	int total_items_crafted = 0;
	int total_npcs_killed = 0;
	int total_playtime = 0;

	dictionary player_stats;

	// Quanto de cada total ja esta gravado no banco.
	int salvo_kills = 0;
	int salvo_deaths = 0;
	int salvo_items_crafted = 0;
	int salvo_npcs_killed = 0;
	int salvo_playtime = 0;
	bool carregado = false;

	// O objeto global e construido antes de o banco abrir: a leitura fica
	// para carregar_do_banco(), chamado no boot e antes de cada gravacao.
	statistics() {
	}

	bool carregar_do_banco() {
		if(carregado) return true;
		if(!database_initialized || bancoJogo is null) return false;
		if(!estatisticas_garantir_colunas()) return false;

		estatisticas_importar_arquivo_legado();

		sqlite3statement@ stmt = bancoJogo.prepare("SELECT COALESCE(SUM(total_kills), 0), COALESCE(SUM(total_deaths), 0), COALESCE(SUM(items_crafted), 0), COALESCE(SUM(npcs_killed), 0), COALESCE(SUM(playtime_minutes), 0) FROM server_statistics;");
		if(@stmt == null) {
			debug_log("STATS: erro ao carregar totais: " + bancoJogo.get_last_error_text());
			return false;
		}
		if(stmt.step() != SQLITE_ROW) return false;

		salvo_kills = stmt.column_int(0);
		salvo_deaths = stmt.column_int(1);
		salvo_items_crafted = stmt.column_int(2);
		salvo_npcs_killed = stmt.column_int(3);
		salvo_playtime = stmt.column_int(4);

		// O que ja foi contado em memoria antes da carga continua valendo.
		total_kills += salvo_kills;
		total_deaths += salvo_deaths;
		total_items_crafted += salvo_items_crafted;
		total_npcs_killed += salvo_npcs_killed;
		total_playtime += salvo_playtime;

		carregado = true;
		return true;
	}

	void load_stats() {
		carregar_do_banco();
	}

	void save_stats() {
		if(!carregar_do_banco()) return;

		int d_kills = total_kills - salvo_kills;
		int d_deaths = total_deaths - salvo_deaths;
		int d_crafted = total_items_crafted - salvo_items_crafted;
		int d_npcs = total_npcs_killed - salvo_npcs_killed;
		int d_playtime = total_playtime - salvo_playtime;
		if(d_kills == 0 && d_deaths == 0 && d_crafted == 0 && d_npcs == 0 && d_playtime == 0) return;

		string hoje = datetime_now().substr(0, 10);

		sqlite3statement@ inserir = bancoJogo.prepare("INSERT OR IGNORE INTO server_statistics (date) VALUES (?);");
		if(@inserir == null) {
			debug_log("STATS: erro ao preparar linha do dia: " + bancoJogo.get_last_error_text());
			return;
		}
		inserir.bind_text(1, hoje);
		inserir.step();

		sqlite3statement@ somar = bancoJogo.prepare("UPDATE server_statistics SET total_kills = COALESCE(total_kills, 0) + ?, total_deaths = COALESCE(total_deaths, 0) + ?, items_crafted = COALESCE(items_crafted, 0) + ?, npcs_killed = COALESCE(npcs_killed, 0) + ?, playtime_minutes = COALESCE(playtime_minutes, 0) + ?, last_updated = CURRENT_TIMESTAMP WHERE date = ?;");
		if(@somar == null) {
			debug_log("STATS: erro ao preparar gravacao: " + bancoJogo.get_last_error_text());
			return;
		}
		somar.bind_int(1, d_kills);
		somar.bind_int(2, d_deaths);
		somar.bind_int(3, d_crafted);
		somar.bind_int(4, d_npcs);
		somar.bind_int(5, d_playtime);
		somar.bind_text(6, hoje);

		if(somar.step() != SQLITE_DONE) {
			debug_log("STATS: erro ao gravar estatisticas: " + bancoJogo.get_last_error_text());
			return;
		}

		salvo_kills = total_kills;
		salvo_deaths = total_deaths;
		salvo_items_crafted = total_items_crafted;
		salvo_npcs_killed = total_npcs_killed;
		salvo_playtime = total_playtime;
	}

	void register_kill(string killer, string victim) {
		total_kills++;
		debug_log("STATS: " + killer + " matou " + victim);
	}

	void register_death(string player) {
		total_deaths++;
	}

	void register_craft(string player, string item) {
		total_items_crafted++;
	}

	void register_npc_kill(string player) {
		total_npcs_killed++;
	}

	string get_server_stats() {
		carregar_do_banco();
		string stats = "=== ESTATÍSTICAS DO SERVIDOR ===\n";
		stats += "Total de Kills: " + total_kills + "\n";
		stats += "Total de Deaths: " + total_deaths + "\n";
		stats += "Items Craftados: " + total_items_crafted + "\n";
		stats += "NPCs Mortos: " + total_npcs_killed + "\n";
		stats += "Tempo Total de Jogo: " + total_playtime + " minutos\n";
		return stats;
	}
}

statistics server_stats;

// Importacao unica do stats.dat: os totais antigos viram a linha de
// 1970-01-01 em server_statistics (INSERT OR IGNORE) e o arquivo e aposentado.
void estatisticas_importar_arquivo_legado() {
	string content;
	if(!globais_ler_arquivo("stats.dat", content)) return;

	int kills = 0;
	int deaths = 0;
	int crafted = 0;
	int npcs = 0;
	int playtime = 0;

	string[] lines = content.replace("\r", "").split("\n");
	for(uint i = 0; i < lines.length(); i++) {
		string[] parts = lines[i].split(":");
		if(parts.length() < 2) continue;

		string chave = parts[0].trim_whitespace();
		int valor = parse_int(parts[1].trim_whitespace());
		if(chave == "total_kills") kills = valor;
		else if(chave == "total_deaths") deaths = valor;
		else if(chave == "total_items_crafted") crafted = valor;
		else if(chave == "total_npcs_killed") npcs = valor;
		else if(chave == "total_playtime") playtime = valor;
	}

	sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR IGNORE INTO server_statistics (date, total_kills, total_deaths, items_crafted, npcs_killed, playtime_minutes) VALUES ('1970-01-01', ?, ?, ?, ?, ?);");
	if(@stmt == null) {
		debug_log("STATS: erro ao importar stats.dat: " + bancoJogo.get_last_error_text());
		return;
	}
	stmt.bind_int(1, kills);
	stmt.bind_int(2, deaths);
	stmt.bind_int(3, crafted);
	stmt.bind_int(4, npcs);
	stmt.bind_int(5, playtime);

	if(stmt.step() != SQLITE_DONE) {
		debug_log("STATS: erro ao importar stats.dat: " + bancoJogo.get_last_error_text());
		return;
	}

	debug_log("STATS MIGRACAO: stats.dat importado para server_statistics");
	globais_arquivar_legado("stats.dat");
}

class time_system {
	int current_hour = 12;
	int current_minute = 0;
	int day_number = 1;
	timer tick_timer;
	int tick_rate = 1000;

	time_system() {
		tick_timer.restart();
	}

	void update() {
		if(tick_timer.elapsed >= tick_rate) {
			tick_timer.restart();
			advance_time(1);
		}
	}

	void advance_time(int minutes) {
		current_minute += minutes;

		if(current_minute >= 60) {
			current_hour += current_minute / 60;
			current_minute = current_minute % 60;
		}

		if(current_hour >= 24) {
			day_number += current_hour / 24;
			current_hour = current_hour % 24;

			on_new_day();
		}

		if(current_minute == 0) {
			broadcast_time();
		}
	}

	void on_new_day() {
		debug_log("TIME: Novo dia começou - Dia " + day_number);

		for(uint i = 0; i < players.length(); i++) {
			send_reliable_text(players[i].peer_id, "msg2 Um novo dia começou! Dia " + day_number, 0);
		}
	}

	void broadcast_time() {
		string period = current_hour < 12 ? "AM" : "PM";
		string display_hour = current_hour == 0 ? "12" : (current_hour > 12 ? "" + (current_hour - 12) : "" + current_hour);

		for(uint i = 0; i < players.length(); i++) {
			send_reliable_text(players[i].peer_id, "time " + display_hour + ":00 " + period, 0);
		}
	}

	bool is_night() {
		return (current_hour >= 20 || current_hour < 6);
	}

	bool is_day() {
		return !is_night();
	}

	string get_time_string() {
		string h = current_hour < 10 ? "0" + current_hour : "" + current_hour;
		string m = current_minute < 10 ? "0" + current_minute : "" + current_minute;
		return h + ":" + m;
	}
}

time_system game_time;

class team {
	string name;
	string[] members;
	string leader;
	int max_members = 8;

	team(string team_name, string team_leader) {
		name = team_name;
		leader = team_leader;
		members.insert_last(team_leader);
	}

	bool add_member(string player_name) {
		if(int(members.length()) >= max_members) return false;
		if(is_member(player_name)) return false;

		members.insert_last(player_name);
		return true;
	}

	bool remove_member(string player_name) {
		for(uint i = 0; i < members.length(); i++) {
			if(members[i] == player_name) {
				members.remove_at(i);
				return true;
			}
		}
		return false;
	}

	bool is_member(string player_name) {
		for(uint i = 0; i < members.length(); i++) {
			if(members[i] == player_name) return true;
		}
		return false;
	}

	string get_members_list() {
		return join(members, ", ");
	}
}

team@[] teams;

bool are_teammates(string player1, string player2) {
	for(uint i = 0; i < teams.length(); i++) {
		if(teams[i].is_member(player1) && teams[i].is_member(player2)) {
			return true;
		}
	}
	return false;
}

void team_chat(string sender, string message) {
	for(uint i = 0; i < teams.length(); i++) {
		if(teams[i].is_member(sender)) {
			for(uint j = 0; j < teams[i].members.length(); j++) {
				int player_index = get_player_index_from(teams[i].members[j]);
				if(player_index > -1) {
					send_reliable_text(players[player_index].peer_id, "teamchat [" + sender + "]: " + message, 0);
				}
			}
			break;
		}
	}
}

class game_disabled_zone {
	int minx, maxx, miny, maxy;
	string map;
	bool disable_pvp;
	bool disable_items;
	bool disable_commands;
	string message;

	game_disabled_zone(int mx, int Mx, int my, int My, string m, string msg = "Zona segura") {
		minx = mx; maxx = Mx;
		miny = my; maxy = My;
		map = m;
		message = msg;
		disable_pvp = true;
		disable_items = false;
		disable_commands = false;
	}

	bool is_inside(int x, int y, string player_map) {
		if(player_map != map) return false;
		return (x >= minx && x <= maxx && y >= miny && y <= maxy);
	}
}

game_disabled_zone@[] game_disabled_zones;

void init_disabled_zones() {
	game_disabled_zone@ zona_test = game_disabled_zone(0, 50, 0, 50, "test", "Zona Segura - Test");
	zona_test.disable_pvp = true;
	zona_test.disable_items = false;
	zona_test.disable_commands = false;
	game_disabled_zones.insert_last(zona_test);

	game_disabled_zone@ zona_hospital = game_disabled_zone(0, 30, 0, 30, "hospital", "Zona Segura - Hospital");
	zona_hospital.disable_pvp = true;
	game_disabled_zones.insert_last(zona_hospital);

	game_disabled_zone@ zona_delegacia = game_disabled_zone(0, 25, 0, 25, "delegacia", "Zona Segura - Delegacia");
	zona_delegacia.disable_pvp = true;
	game_disabled_zones.insert_last(zona_delegacia);

	debug_log("ZONES: " + game_disabled_zones.length() + " zonas desabilitadas inicializadas");
}

bool is_in_disabled_zone(int player_index) {
	for(uint i = 0; i < game_disabled_zones.length(); i++) {
		if(game_disabled_zones[i].is_inside(players[player_index].x, players[player_index].y, players[player_index].map)) {
			return true;
		}
	}
	return false;
}

void magnetic_item_pull(int player_index, int radius = 5) {
	if(!players[player_index].inv_item_exists("imã")) return;

	int px = players[player_index].x;
	int py = players[player_index].y;
	string pmap = players[player_index].map;

	for(uint i = 0; i < objs.length(); i++) {
		if(objs[i].map != pmap) continue;
		if(!objs[i].obtainable) continue;

		int distance = int(abs(objs[i].x - px) + abs(objs[i].y - py));

		if(distance <= radius && distance > 0) {
			if(objs[i].x < px) objs[i].x++;
			else if(objs[i].x > px) objs[i].x--;

			if(objs[i].y < py) objs[i].y++;
			else if(objs[i].y > py) objs[i].y--;

			if(objs[i].x == px && objs[i].y == py) {
				objs[i].get(player_index);
				objs[i].delete = true;
			}
		}
	}
}

// ganhaxp() e check_level_up() migraram para leveling.nvgt, que preserva a
// assinatura e acrescenta reencarnacao, XP de equipe, XP de guilda e persistencia.
// subir_nivel() la dentro mantem settitle() e a conquista "level".
