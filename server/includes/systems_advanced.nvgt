
string[] load_banned_players() {
	string[] banned;
	file f;
	if(f.open("banidos.dat", "rb")) {
		string content = f.read();
		f.close();
		banned = content.split("\r\n");
	}
	return banned;
}

bool is_player_banned(string charname) {
	string[] banned = load_banned_players();
	for(uint i = 0; i < banned.length(); i++) {
		if(banned[i].lower() == charname.lower()) {
			return true;
		}
	}
	return false;
}

void ban_player(string charname, string reason = "Violação das regras") {
	file f;
	if(f.open("banidos.dat", "ab")) {
		f.write(charname + "\r\n");
		f.close();
		debug_log("BAN: " + charname + " - Razão: " + reason);
	}
}

void unban_player(string charname) {
	string[] banned = load_banned_players();
	string[] new_list;

	for(uint i = 0; i < banned.length(); i++) {
		if(banned[i].lower() != charname.lower()) {
			new_list.insert_last(banned[i]);
		}
	}

	file f;
	if(f.open("banidos.dat", "wb")) {
		f.write(join(new_list, "\r\n"));
		f.close();
		debug_log("UNBAN: " + charname);
	}
}

int calculate_combat_damage(int player_index, int base_damage) {
	if(player_index < 0 || player_index >= int(players.length())) {
		return base_damage;
	}

	int final_damage = base_damage;

	string equipped_weapon = get_equipped_item_in_slot(players[player_index], EQUIP_SLOT_WEAPON);
	if(equipped_weapon != "" && equipped_weapon != "soco") {
		final_damage += int(base_damage * 0.10);
	}

	if(players[player_index].inv_item_number("anel_de_força") > 0) {
		final_damage += int(final_damage * 0.1);
	}

	if(players[player_index].inv_item_number("luvas_de_combate") > 0) {
		final_damage += int(final_damage * 0.15);
	}

	if(players[player_index].inv_item_number("amuleto_de_poder") > 0) {
		final_damage += int(final_damage * 0.2);
	}

	if(random(1, 100) <= 5) {
		final_damage = final_damage * 2;
		send_reliable_text(players[player_index].peer_id, "msg2 CRÍTICO!", 0);
	}

	return final_damage;
}

int calculate_damage_reduction(int player_index, int incoming_damage) {
	double reduction = 0.0;

	reduction += players[player_index].clothing_protection / 100.0;

	if(players[player_index].colete_aprova_de_balas > 0) {
		reduction += 0.3;
	}

	if(players[player_index].capacetepolicia > 0) {
		reduction += 0.1;
	}

	if(players[player_index].casacopeles > 0) {
		reduction += 0.15;
	}

	if(reduction > 0.9) reduction = 0.9;

	int reduced_damage = int(incoming_damage * (1.0 - reduction));
	return reduced_damage;
}

class statistics {
	int total_kills = 0;
	int total_deaths = 0;
	int total_items_crafted = 0;
	int total_npcs_killed = 0;
	int total_playtime = 0;

	dictionary player_stats;

	statistics() {
		load_stats();
	}

	void load_stats() {
		file f;
		if(f.open("server/stats.dat", "rb")) {
			string content = f.read();
			f.close();

			string[] lines = content.split("\r\n");
			for(uint i = 0; i < lines.length(); i++) {
				if(lines[i].find(":") > -1) {
					string[] parts = lines[i].split(":");
					if(parts[0] == "total_kills") total_kills = string_to_number(parts[1]);
					else if(parts[0] == "total_deaths") total_deaths = string_to_number(parts[1]);
					else if(parts[0] == "total_items_crafted") total_items_crafted = string_to_number(parts[1]);
					else if(parts[0] == "total_npcs_killed") total_npcs_killed = string_to_number(parts[1]);
					else if(parts[0] == "total_playtime") total_playtime = string_to_number(parts[1]);
				}
			}
		}
	}

	void save_stats() {
		file f;
		if(f.open("server/stats.dat", "wb")) {
			string content = "total_kills:" + total_kills + "\r\n";
			content += "total_deaths:" + total_deaths + "\r\n";
			content += "total_items_crafted:" + total_items_crafted + "\r\n";
			content += "total_npcs_killed:" + total_npcs_killed + "\r\n";
			content += "total_playtime:" + total_playtime + "\r\n";
			f.write(content);
			f.close();
		}
	}

	void register_kill(string killer, string victim) {
		total_kills++;
		debug_log("STATS: " + killer + " matou " + victim);
	}

	void register_death(string player) {
		total_deaths++;
	}

	void register_craft(string player, string item) {
		total_items_crafted++;
	}

	void register_npc_kill(string player) {
		total_npcs_killed++;
	}

	string get_server_stats() {
		string stats = "=== ESTATÍSTICAS DO SERVIDOR ===\n";
		stats += "Total de Kills: " + total_kills + "\n";
		stats += "Total de Deaths: " + total_deaths + "\n";
		stats += "Items Craftados: " + total_items_crafted + "\n";
		stats += "NPCs Mortos: " + total_npcs_killed + "\n";
		stats += "Tempo Total de Jogo: " + total_playtime + " minutos\n";
		return stats;
	}
}

statistics server_stats;

class time_system {
	int current_hour = 12;
	int current_minute = 0;
	int day_number = 1;
	timer tick_timer;
	int tick_rate = 1000;

	time_system() {
		tick_timer.restart();
	}

	void update() {
		if(tick_timer.elapsed >= tick_rate) {
			tick_timer.restart();
			advance_time(1);
		}
	}

	void advance_time(int minutes) {
		current_minute += minutes;

		if(current_minute >= 60) {
			current_hour += current_minute / 60;
			current_minute = current_minute % 60;
		}

		if(current_hour >= 24) {
			day_number += current_hour / 24;
			current_hour = current_hour % 24;

			on_new_day();
		}

		if(current_minute == 0) {
			broadcast_time();
		}
	}

	void on_new_day() {
		debug_log("TIME: Novo dia começou - Dia " + day_number);

		for(uint i = 0; i < players.length(); i++) {
			send_reliable_text(players[i].peer_id, "msg2 Um novo dia começou! Dia " + day_number, 0);
		}
	}

	void broadcast_time() {
		string period = current_hour < 12 ? "AM" : "PM";
		string display_hour = current_hour == 0 ? "12" : (current_hour > 12 ? "" + (current_hour - 12) : "" + current_hour);

		for(uint i = 0; i < players.length(); i++) {
			send_reliable_text(players[i].peer_id, "time " + display_hour + ":00 " + period, 0);
		}
	}

	bool is_night() {
		return (current_hour >= 20 || current_hour < 6);
	}

	bool is_day() {
		return !is_night();
	}

	string get_time_string() {
		string h = current_hour < 10 ? "0" + current_hour : "" + current_hour;
		string m = current_minute < 10 ? "0" + current_minute : "" + current_minute;
		return h + ":" + m;
	}
}

time_system game_time;

class team {
	string name;
	string[] members;
	string leader;
	int max_members = 8;

	team(string team_name, string team_leader) {
		name = team_name;
		leader = team_leader;
		members.insert_last(team_leader);
	}

	bool add_member(string player_name) {
		if(int(members.length()) >= max_members) return false;
		if(is_member(player_name)) return false;

		members.insert_last(player_name);
		return true;
	}

	bool remove_member(string player_name) {
		for(uint i = 0; i < members.length(); i++) {
			if(members[i] == player_name) {
				members.remove_at(i);
				return true;
			}
		}
		return false;
	}

	bool is_member(string player_name) {
		for(uint i = 0; i < members.length(); i++) {
			if(members[i] == player_name) return true;
		}
		return false;
	}

	string get_members_list() {
		return join(members, ", ");
	}
}

team@[] teams;

bool are_teammates(string player1, string player2) {
	for(uint i = 0; i < teams.length(); i++) {
		if(teams[i].is_member(player1) && teams[i].is_member(player2)) {
			return true;
		}
	}
	return false;
}

void team_chat(string sender, string message) {
	for(uint i = 0; i < teams.length(); i++) {
		if(teams[i].is_member(sender)) {
			for(uint j = 0; j < teams[i].members.length(); j++) {
				int player_index = get_player_index_from(teams[i].members[j]);
				if(player_index > -1) {
					send_reliable_text(players[player_index].peer_id, "teamchat [" + sender + "]: " + message, 0);
				}
			}
			break;
		}
	}
}

class game_disabled_zone {
	int minx, maxx, miny, maxy;
	string map;
	bool disable_pvp;
	bool disable_items;
	bool disable_commands;
	string message;

	game_disabled_zone(int mx, int Mx, int my, int My, string m, string msg = "Zona segura") {
		minx = mx; maxx = Mx;
		miny = my; maxy = My;
		map = m;
		message = msg;
		disable_pvp = true;
		disable_items = false;
		disable_commands = false;
	}

	bool is_inside(int x, int y, string player_map) {
		if(player_map != map) return false;
		return (x >= minx && x <= maxx && y >= miny && y <= maxy);
	}
}

game_disabled_zone@[] game_disabled_zones;

void init_disabled_zones() {
	game_disabled_zone@ zona_test = game_disabled_zone(0, 50, 0, 50, "test", "Zona Segura - Test");
	zona_test.disable_pvp = true;
	zona_test.disable_items = false;
	zona_test.disable_commands = false;
	game_disabled_zones.insert_last(zona_test);

	game_disabled_zone@ zona_hospital = game_disabled_zone(0, 30, 0, 30, "hospital", "Zona Segura - Hospital");
	zona_hospital.disable_pvp = true;
	game_disabled_zones.insert_last(zona_hospital);

	game_disabled_zone@ zona_delegacia = game_disabled_zone(0, 25, 0, 25, "delegacia", "Zona Segura - Delegacia");
	zona_delegacia.disable_pvp = true;
	game_disabled_zones.insert_last(zona_delegacia);

	debug_log("ZONES: " + game_disabled_zones.length() + " zonas desabilitadas inicializadas");
}

bool is_in_disabled_zone(int player_index) {
	for(uint i = 0; i < game_disabled_zones.length(); i++) {
		if(game_disabled_zones[i].is_inside(players[player_index].x, players[player_index].y, players[player_index].map)) {
			return true;
		}
	}
	return false;
}

void magnetic_item_pull(int player_index, int radius = 5) {
	if(!players[player_index].inv_item_exists("imã")) return;

	int px = players[player_index].x;
	int py = players[player_index].y;
	string pmap = players[player_index].map;

	for(uint i = 0; i < objs.length(); i++) {
		if(objs[i].map != pmap) continue;
		if(!objs[i].obtainable) continue;

		int distance = int(abs(objs[i].x - px) + abs(objs[i].y - py));

		if(distance <= radius && distance > 0) {
			if(objs[i].x < px) objs[i].x++;
			else if(objs[i].x > px) objs[i].x--;

			if(objs[i].y < py) objs[i].y++;
			else if(objs[i].y > py) objs[i].y--;

			if(objs[i].x == px && objs[i].y == py) {
				objs[i].get(player_index);
				objs[i].delete = true;
			}
		}
	}
}

