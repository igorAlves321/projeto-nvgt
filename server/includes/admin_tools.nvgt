
const int ADMIN_TOOL_MIN_RANK = 5;
const int LANTERNA_RANGE = 15;
const int DETECTOR_RANGE = 20;

void admin_toggle_lanterna(int player_index) {
    if(player_index < 0 || player_index >= int(players.length())) return;

    player@ p = @players[player_index];

    if(p.rank < ADMIN_TOOL_MIN_RANK && !p.dev && !p.admin) {
        send_reliable_text(p.peer_id, "say Você não tem permissao para usar a lanterna.", 0);
        return;
    }

    bool lanterna_on = p.item_active == "lanterna";

    if(lanterna_on) {
        p.item_active = "";
        send_reliable_text(p.peer_id, "ps lanterna_off.ogg", 0);
        send_reliable_text(p.peer_id, "say Lanterna desligada.", 0);

        broadcast_to_map_except(p.map_name, "sound lanterna_off.ogg " + p.x + " " + p.y, p.peer_id);

        debug_log("[LANTERNA] Admin " + p.name + " desligou a lanterna em " + p.map_name);
    }
    else {
        p.item_active = "lanterna";
        send_reliable_text(p.peer_id, "ps lanterna_on.ogg", 0);
        send_reliable_text(p.peer_id, "say Lanterna ligada. Iluminando area.", 0);

        broadcast_to_map_except(p.map_name, "sound lanterna_on.ogg " + p.x + " " + p.y, p.peer_id);

        debug_log("[LANTERNA] Admin " + p.name + " ligou a lanterna em " + p.map_name);
    }
}

void admin_lanterna_pulse(int player_index) {
    if(player_index < 0 || player_index >= int(players.length())) return;

    player@ p = @players[player_index];

    if(p.item_active != "lanterna") return;

    for(uint i = 0; i < players.length(); i++) {
        if(!players[i].is_logged_in) continue;
        if(players[i].map_name != p.map_name) continue;
        if(players[i].peer_id == p.peer_id) continue;

        int dx = players[i].x - p.x;
        int dy = players[i].y - p.y;
        double dist = sqrt(double(dx * dx + dy * dy));

        if(dist <= LANTERNA_RANGE) {
            send_reliable_text(players[i].peer_id, "sound2d lanterna_pulse.ogg " + p.x + " " + p.y, 0);
        }
    }
}

void admin_use_detector(int player_index) {
    if(player_index < 0 || player_index >= int(players.length())) return;

    player@ p = @players[player_index];

    if(p.rank < ADMIN_TOOL_MIN_RANK && !p.dev && !p.admin) {
        send_reliable_text(p.peer_id, "say Você não tem permissao para usar o detector.", 0);
        return;
    }

    send_reliable_text(p.peer_id, "ps detector_scan.ogg", 0);

    string results = "";
    int found_count = 0;

    for(uint i = 0; i < players.length(); i++) {
        if(!players[i].is_logged_in) continue;
        if(players[i].map_name != p.map_name) continue;
        if(players[i].peer_id == p.peer_id) continue;

        int dx = players[i].x - p.x;
        int dy = players[i].y - p.y;
        double dist = sqrt(double(dx * dx + dy * dy));

        if(dist <= DETECTOR_RANGE) {
            if(players[i].invisible || players[i].inv_item_exists("pocao_invisibilidade")) {
                results += "Jogador invisivel detectado: " + players[i].charname + " em (" + players[i].x + ", " + players[i].y + "). ";
                found_count++;
                send_reliable_text(p.peer_id, "ps detector_bip.ogg", 0);
            }

            if(players[i].crouched) {
                results += "Jogador agachado: " + players[i].charname + " em (" + players[i].x + ", " + players[i].y + "). ";
                found_count++;
            }
        }
    }

    string[] map_drops = get_drops_in_map(p.map);
    for(uint di = 0; di < map_drops.length(); di++) {
        drop_entity@ d = get_drop(map_drops[di]);
        if(d is null) continue;
        d.update_state();
        if(d.state == DROP_STATE_EXPIRED || d.state == DROP_STATE_PICKED) continue;

        int ddx = d.x - p.x;
        int ddy = d.y - p.y;
        double ddist = sqrt(double(ddx * ddx + ddy * ddy));
        if(ddist > DETECTOR_RANGE) continue;

        results += "Drop detectado: " + d.item_id + " x" + d.quantity + " em (" + d.x + ", " + d.y + "). ";
        found_count++;
    }

    for(uint i = 0; i < players.length(); i++) {
        if(!players[i].is_logged_in) continue;
        if(players[i].map_name != p.map_name) continue;

        if(players[i].x < -1000 || players[i].x > 10000 ||
           players[i].y < -1000 || players[i].y > 10000) {
            results += "Anomalia de posicao: " + players[i].charname + " em posicao suspeita (" + players[i].x + ", " + players[i].y + "). ";
            found_count++;
            send_reliable_text(p.peer_id, "ps detector_anomaly.ogg", 0);
        }

        int speed_dx = players[i].x - players[i].last_valid_x;
        int speed_dy = players[i].y - players[i].last_valid_y;
        double speed_dist = sqrt(double(speed_dx * speed_dx + speed_dy * speed_dy));
        double elapsed_seconds = double(players[i].last_move_time.elapsed) / 1000.0;
        if(elapsed_seconds < 0.05) elapsed_seconds = 0.05;
        double speed_estimate = speed_dist / elapsed_seconds;
        double suspicious_limit = players[i].MAX_WALK_SPEED * 1.8;
        if(suspicious_limit < 20.0) suspicious_limit = 20.0;

        if(players[i].violation_count >= 3 || (speed_dist > 0.0 && speed_estimate > suspicious_limit)) {
            results += "Velocidade suspeita: " + players[i].charname + " (" + speed_estimate + " tiles/s, violacoes: " + players[i].violation_count + "). ";
            found_count++;
            send_reliable_text(p.peer_id, "ps detector_anomaly.ogg", 0);
        }
    }

    if(found_count == 0) {
        send_reliable_text(p.peer_id, "say Varredura completa. Nenhuma anomalia ou objeto oculto detectado no raio de " + DETECTOR_RANGE + " metros.", 0);
    }
    else {
        send_reliable_text(p.peer_id, "say Varredura completa. " + found_count + " deteccao(oes): " + results, 0);
    }

    debug_log("[DETECTOR] Admin " + p.name + " usou detector em " + p.map_name + ": " + found_count + " deteccoes");
}

void handle_admin_lanterna_command(uint64 peer_id) {
    player@ p = get_player_by_peer(peer_id);
    if(p is null) return;

    int player_index = get_player_index_from(p.name);
    admin_toggle_lanterna(player_index);
}

void handle_admin_detector_command(uint64 peer_id) {
    player@ p = get_player_by_peer(peer_id);
    if(p is null) return;

    int player_index = get_player_index_from(p.name);
    admin_use_detector(player_index);
}

void broadcast_to_map_except(string map_name, string message, uint64 except_peer) {
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].map_name == map_name && players[i].peer_id != except_peer && players[i].is_logged_in) {
            send_reliable_text(players[i].peer_id, message, 0);
        }
    }
}
