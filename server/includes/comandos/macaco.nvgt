// macaco.nvgt - Sistema de Macaco do EVM Server (convertido de BGT)
// Conversão: BGT → NVGT

macaco@[] macacos;

class macaco {
	int x, y, asom = 4000;
	uint tiros = 1;
	int vida = 1800;
	string golpeado;
	string map;
	timer macacotimer, tsom;
	timer tempoatirar;
	int macacotime = 370;
	bool modofugir = false;
	
	macaco(int cx, int cy, string cmap) {
		x = cx;
		y = cy;
		map = cmap;
	}
}

void macacoloop() {
	for (uint i = 0; i < macacos.length(); i++) {
		// Sistema de morte
		if (macacos[i].vida <= 0) {
			net.send_packet(0, "play m_macaco.ogg " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
			string golp = macacos[i].golpeado;
			// net.send_reliable(0, "msg2 " + golp + "; ;matou um; ;macaco;!", 3);
			int xx = get_player_index_from(golp);
			if (xx > -1) {
				players[xx].inv_add_item("corpo_de_macaco", 1);
				ganhaxp(players[xx].charname, random(5, 10));
			}
			macacos.remove_at(i);
			break;
		}
		
		// Sons periódicos
		if (macacos[i].tsom.elapsed >= macacos[i].asom + random(1000, 2000)) {
			macacos[i].tsom.restart();
			string ss = "macaco" + random(1, 3) + ".ogg";
			net.send_packet(0, "play " + ss + " " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
		}
		
		// Sistema de movimento e combate
		if (macacos[i].macacotimer.elapsed >= macacos[i].macacotime) {
			macacos[i].macacotimer.restart();
			
			for (uint i2 = 0; i2 < players.length(); i2++) {
				// Sistema de movimento - seguir jogador
				if (macacos[i].x > players[i2].x + 1 && players[i2].insz == false && players[i2].map == macacos[i].map && players[i2].newbie == false && players[i2].afk == false && players[i2].pacifico == 0 && macacos[i].modofugir == false) {
					macacos[i].x--;
					string ss = get_tile_at(macacos[i].x, macacos[i].y, macacos[i].map);
					net.send_packet(0, "play " + ss + " " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
					macacos[i].macacotimer.restart();
					break;
				}
				else if (macacos[i].x < players[i2].x - 1 && players[i2].insz == false && macacos[i].map == players[i2].map && players[i2].afk == false && players[i2].pacifico == 0 && players[i2].newbie == false && macacos[i].modofugir == false) {
					macacos[i].x++;
					string ss = get_tile_at(macacos[i].x, macacos[i].y, macacos[i].map);
					net.send_packet(0, "play " + ss + " " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
					macacos[i].macacotimer.restart();
					break;
				}
				
				// Sistema de ataque (dano baixo)
				if (get_macaco_distance(macacos[i], players[i2]) > -1 && get_macaco_distance(macacos[i], players[i2]) <= 2 && players[i2].afk == false && players[i2].pacifico == 0 && players[i2].newbie == false && macacos[i].tempoatirar.elapsed >= 500 && macacos[i].tiros > 0 && players[i2].insz == false) {
					macacos[i].tempoatirar.restart();
					net.send_packet(0, "play macacobater1.ogg " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
					int r = refletir(i2, "macaco", macacos[i].x, macacos[i].y, random(50, 100));
					if (r > 0) {
						macacos[i].vida -= r;
						macacos[i].golpeado = players[i2].charname;
						break;
					}
					players[i2].health -= random(50, 100);
					net.send_packet(0, "inithurt " + players[i2].voice + " " + players[i2].x + " " + players[i2].y, players[i2].map);
					players[i2].lasthit = "macaco";
					macacos[i].tiros--;
					break;
				}
				
				// Reset de tiros
				if (macacos[i].tiros <= 0) {
					macacos[i].tiros = 1;
					macacos[i].tempoatirar.restart();
				}
			}
			
			// Sistema de busca por frutas (IA especial)
			for (uint za = 0; za < objs.length(); za++) {
				string[] frutas = {"banana", "maçã", "figo", "morango", "goiaba", "pera", "jabuticaba", "caqui", "amora"};
				bool eh_fruta = false;
				for (uint f = 0; f < frutas.length(); f++) {
					if (objs[za].item == frutas[f]) {
						eh_fruta = true;
						break;
					}
				}
				
				if (eh_fruta && macacos[i].map == objs[za].map) {
					// Movimento em direção à fruta
					if (macacos[i].y < objs[za].y) {
						macacos[i].y++;
						string ss = get_tile_at(macacos[i].x, macacos[i].y, macacos[i].map);
						net.send_packet(0, "play " + ss + " " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
						break;
					}
					else if (macacos[i].y > objs[za].y) {
						macacos[i].y--;
						string ss = get_tile_at(macacos[i].x, macacos[i].y, macacos[i].map);
						net.send_packet(0, "play " + ss + " " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
						break;
					}
					else if (macacos[i].x < objs[za].x) {
						macacos[i].x++;
						string ss = get_tile_at(macacos[i].x, macacos[i].y, macacos[i].map);
						net.send_packet(0, "play " + ss + " " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
						break;
					}
					else if (macacos[i].x > objs[za].x) {
						macacos[i].x--;
						string ss = get_tile_at(macacos[i].x, macacos[i].y, macacos[i].map);
						net.send_packet(0, "play " + ss + " " + macacos[i].x + " " + macacos[i].y + " " + macacos[i].map, macacos[i].map);
						break;
					}
					// Comer fruta (mesmo local)
					else if (macacos[i].x == objs[za].x && macacos[i].y == objs[za].y) {
						macacos[i].y += 10;
						if (macacos[i].y > 20) macacos[i].y = 20;
						objs[za].obtainable = false;
						objs[za].delete = true;
						objloop();
						break;
					}
				}
			}
		}
	}
}

void spawn_macaco(int x, int y, string map) {
	if (!pvp) return;
	macaco c(x, y, map);
	macacos.insert_last(c);
}
