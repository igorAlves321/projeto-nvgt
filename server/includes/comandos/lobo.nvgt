// lobo.nvgt - Sistema de Lobo do EVM Server (convertido de BGT)
// Conversão: BGT → NVGT

lobo@[] lobos;

class lobo {
	int x, y, ladoandar = 2;
	uint tiros = 1;
	int vida = random(3000, 3300);
	string golpeado;
	string map;
	timer lobotimer;
	timer tempoatirar;
	timer tsom;
	int asom = 4000;
	int lobotime = 290;
	
	lobo(int cx, int cy, string cmap) {
		x = cx;
		y = cy;
		map = cmap;
	}
}

// Calcula distância entre lobo e jogador
int get_lobo_distance(lobo@ l, player@ p) {
	if (l.map != p.map) return -1;
	return get_distance(l.x, p.x, l.y, p.y);
}

void loboloop() {
	for (uint i = 0; i < lobos.length(); i++) {
		// Sistema de morte
		if (lobos[i].vida <= 0) {
			net.send_packet(0, "play m_lobo.ogg " + lobos[i].x + " " + lobos[i].y, lobos[i].map);
			string golp = lobos[i].golpeado;
			
			if (golp.find("magnet_") > -1) {
				golp = golp.replace("magnet_", "");
				send_reliable(0, "msg2 um; ;lobo; ;morreu no; ;item_magnético; ;de; ;" + golp + ";!", 3);
			} else {
				send_reliable(0, "msg2 " + golp + "; ;matou um; ;lobo;!", 3);
			}
			
			int xx = get_player_index_from(golp);
			if (xx > -1) {
				players[xx].inv_add_item("corpo_de_lobo", 1);
				ganhaxp(players[xx].charname, random(20, 30));
				
				// 🆕 INTEGRAÇÃO: Atualizar quests e achievements
				quest_update_kill(players[xx].charname, "lobo");
				update_achievement_progress(players[xx].charname, "kills", 1);
			}
			lobos.remove_at(i);
			break;
		}
		
		// Sons periódicos (nervoso)
		if (lobos[i].tsom.elapsed >= lobos[i].asom + random(1000, 3200)) {
			lobos[i].tsom.restart();
			string ss = "lobonervoso" + random(1, 5) + ".ogg";
			net.send_packet(0, "play " + ss + " " + lobos[i].x + " " + lobos[i].y, lobos[i].map);
		}
		
		// Sistema de movimento e combate
		if (lobos[i].lobotimer.elapsed >= lobos[i].lobotime) {
			lobos[i].lobotimer.restart();
			
			for (uint i2 = 0; i2 < players.length(); i2++) {
				// Movimento - seguir jogador (apenas no chão y<=1)
				if (lobos[i].x > players[i2].x + 2 && players[i2].insz == false && players[i2].map == lobos[i].map && players[i2].newbie == false && players[i2].afk == false && players[i2].pacifico == 0 && lobos[i].y <= 1) {
					lobos[i].x -= 2;
					string ss = get_tile_at(lobos[i].x, lobos[i].y, lobos[i].map);
					net.send_packet(0, "play " + ss + "step" + random(1, 5) + ".ogg " + lobos[i].x + " " + lobos[i].y, lobos[i].map);
					lobos[i].lobotimer.restart();
					break;
				}
				else if (lobos[i].x < players[i2].x - 2 && players[i2].insz == false && lobos[i].map == players[i2].map && players[i2].afk == false && players[i2].pacifico == 0 && players[i2].newbie == false && lobos[i].y <= 1) {
					lobos[i].x += 2;
					string ss = get_tile_at(lobos[i].x, lobos[i].y, lobos[i].map);
					net.send_packet(0, "play " + ss + "step" + random(1, 5) + ".ogg " + lobos[i].x + " " + lobos[i].y, lobos[i].map);
					lobos[i].lobotimer.restart();
					break;
				}
				
				// Sistema de ataque (dano 300-500)
				if (get_lobo_distance(lobos[i], players[i2]) > -1 && get_lobo_distance(lobos[i], players[i2]) <= 2 && players[i2].afk == false && players[i2].pacifico == 0 && players[i2].newbie == false && lobos[i].tempoatirar.elapsed >= 500 && lobos[i].tiros > 0) {
					lobos[i].tempoatirar.restart();
					net.send_packet(0, "play lobobater.ogg " + lobos[i].x + " " + lobos[i].y, lobos[i].map);
					
					// Verificar reflexão de dano
					int dano = random(300, 500);
					int r = refletir(i2, "lobo", lobos[i].x, lobos[i].y, dano);
					if (r > 0) {
						lobos[i].vida -= r;
						lobos[i].golpeado = players[i2].charname;
						break;
					}
					
					players[i2].health -= dano;
					net.send_packet(0, "inithurt " + players[i2].voice + " " + players[i2].x + " " + players[i2].y, players[i2].map);
					players[i2].lasthit = "lobo";
					lobos[i].tiros--;
					break;
				}
				
				// Reset de tiros
				if (lobos[i].tiros <= 0) {
					lobos[i].tiros = 1;
					lobos[i].tempoatirar.restart();
				}
			}
		}
	}
	netloop();
}

void spawn_lobo(int x, int y, string map) {
	if (!pvp) return;
	lobo l(x, y, map);
	lobos.insert_last(l);
}
