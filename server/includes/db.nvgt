// db.nvgt - Sistema de Inventário (Database)
// Convertido de BGT para NVGT
// Wrapper para dictionary que armazena itens do inventário (string → double)

class db {
	dictionary data;

	db() {
		// Construtor vazio, dictionary já é inicializado
	}

	// Verifica se um item existe no inventário
	bool exists(string itemname) {
		return data.exists(itemname);
	}

	// Obtém a quantidade de um item
	bool get(string itemname, double &out value) {
		return data.get(itemname, value);
	}

	// Define a quantidade de um item
	void set(string itemname, double value) {
		data.set(itemname, value);
	}

	// Remove um item do inventário
	bool delete(string itemname) {
		return data.delete(itemname);
	}

	// Verifica se o inventário está vazio
	bool is_empty() {
		return data.is_empty();
	}

	// Remove todos os itens do inventário
	void delete_all() {
		data.delete_all();
	}

	// Obtém lista de todos os nomes de itens
	string[]@ get_keys() {
		return data.get_keys();
	}

	// Ordena/organiza itens (implementação básica)
	// Em BGT isso era db12, aqui vamos fazer uma implementação simples
	void sort(string itemname, int range) {
		// Esta função no BGT parecia organizar itens em slots
		// Por enquanto mantemos a funcionalidade básica
		// Se precisar de lógica específica, será implementada depois
	}

	// Retorna o número de itens diferentes no inventário
	uint size() {
		return data.size();
	}

	// Serializa o inventário para string (para salvar)
	string serialize() {
		return data.serialize();
	}

	// Limpa e carrega de uma string serializada
	void load_from_string(string serialized_data) {
		dictionary@ temp = deserialize(serialized_data);
		if (@temp != null) {
			data.delete_all();
			string[]@ keys = temp.get_keys();
			for (uint i = 0; i < keys.length(); i++) {
				double value;
				temp.get(keys[i], value);
				data.set(keys[i], value);
			}
		}
	}

	// Retorna a quantidade de um item (atalho)
	double get_amount(string itemname) {
		if (!exists(itemname)) {
			return 0;
		}
		double amount;
		get(itemname, amount);
		return amount;
	}

	// Adiciona quantidade a um item existente ou cria novo
	void add(string itemname, double amount) {
		if (exists(itemname)) {
			double current;
			get(itemname, current);
			set(itemname, current + amount);
		} else {
			set(itemname, amount);
		}
	}

	// Remove quantidade de um item (retorna false se não tiver o suficiente)
	bool remove(string itemname, double amount) {
		if (!exists(itemname)) {
			return false;
		}
		double current;
		get(itemname, current);
		if (current < amount) {
			return false;
		}
		double new_amount = current - amount;
		if (new_amount <= 0) {
			delete(itemname);
		} else {
			set(itemname, new_amount);
		}
		return true;
	}
}
