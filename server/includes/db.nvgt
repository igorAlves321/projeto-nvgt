
class db {
	dictionary data;

	db() {
	}

	bool exists(string itemname) {
		return data.exists(itemname);
	}

	bool get(string itemname, double &out value) {
		return data.get(itemname, value);
	}

	bool get(string itemname, int &out value) {
		double temp = 0;
		bool res = data.get(itemname, temp);
		value = int(temp);
		return res;
	}

	void set(string itemname, double value) {
		data.set(itemname, value);
	}

	bool delete(string itemname) {
		return data.delete(itemname);
	}

	bool is_empty() {
		return data.is_empty();
	}

	void delete_all() {
		data.delete_all();
	}

	string[]@ get_keys() {
		return data.get_keys();
	}

	void sort(string itemname, int range) {
	}

	uint size() {
		return data.size();
	}

	string serialize() {
		return data.serialize();
	}

	void load_from_string(string serialized_data) {
		dictionary@ temp = deserialize(serialized_data);
		if (@temp != null) {
			data.delete_all();
			string[]@ keys = temp.get_keys();
			for (uint i = 0; i < keys.length(); i++) {
				double value;
				temp.get(keys[i], value);
				data.set(keys[i], value);
			}
		}
	}

	double get_amount(string itemname) {
		if (!exists(itemname)) {
			return 0;
		}
		double amount;
		get(itemname, amount);
		return amount;
	}

	void add(string itemname, double amount) {
		if (exists(itemname)) {
			double current;
			get(itemname, current);
			set(itemname, current + amount);
		} else {
			set(itemname, amount);
		}
	}

	bool remove(string itemname, double amount) {
		if (!exists(itemname)) {
			return false;
		}
		double current;
		get(itemname, current);
		if (current < amount) {
			return false;
		}
		double new_amount = current - amount;
		if (new_amount <= 0) {
			delete(itemname);
		} else {
			set(itemname, new_amount);
		}
		return true;
	}
}
