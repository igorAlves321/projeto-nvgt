void cmd_sendmap(int player_index, string target_name, string map_name) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "sendmap", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "sendmap", "Nome de jogador inválido!");
		return;
	}
	if(!is_valid_map_name(map_name)) {
		send_admin_error(player_index, "sendmap", "Nome de mapa inválido!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "sendmap", "Jogador não encontrado!");
		return;
	}
	int map_index = get_map_index_from(map_name);
	if(map_index == -1) {
		send_admin_error(player_index, "sendmap", "Mapa não encontrado!");
		return;
	}

	teleport_player(target, map_name, 0, 0, 0);
	send_reliable_text(players[target].peer_id, "msg2 Você foi enviado para " + map_name, 0);
	send_reliable_text(players[player_index].peer_id, "msg2 " + target_name + " enviado para " + map_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " enviou " + target_name + " para " + map_name);
}

void cmd_dar(int player_index, string target_name, string item_name, int quantity = 1) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "dar", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "dar", "Nome de jogador inválido!");
		return;
	}
	if(!is_valid_item_name(item_name)) {
		send_admin_error(player_index, "dar", "Nome de item inválido!");
		return;
	}
	if(quantity < 1 || quantity > ADMIN_MAX_ITEM_QTY) {
		send_admin_error(player_index, "dar", "Quantidade invalida!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "dar", "Jogador não encontrado!");
		return;
	}

	add_item_to_player(target, item_name, quantity);
	send_reliable_text(players[target].peer_id, "msg2 Você recebeu " + quantity + "x " + item_name, 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Dado " + quantity + "x " + item_name + " para " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " deu " + quantity + "x " + item_name + " para " + target_name);
}

void cmd_remover(int player_index, string target_name, string item_name, int quantity = 1) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "remover", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "remover", "Nome de jogador inválido!");
		return;
	}
	if(!is_valid_item_name(item_name)) {
		send_admin_error(player_index, "remover", "Nome de item inválido!");
		return;
	}
	if(quantity < 1 || quantity > ADMIN_MAX_ITEM_QTY) {
		send_admin_error(player_index, "remover", "Quantidade invalida!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "remover", "Jogador não encontrado!");
		return;
	}

	remove_item_from_player(target, item_name, quantity);
	send_reliable_text(players[target].peer_id, "msg2 Removido " + quantity + "x " + item_name, 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Removido " + quantity + "x " + item_name + " de " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " removeu " + quantity + "x " + item_name + " de " + target_name);
}

void cmd_dare(int player_index, string target_name, int amount) {
	if(!is_admin(player_index)) {
		send_admin_error(player_index, "dare", "Você não tem permissao!");
		return;
	}
	if(!is_valid_player_name(target_name)) {
		send_admin_error(player_index, "dare", "Nome de jogador inválido!");
		return;
	}
	if(amount < 1 || amount > ADMIN_MAX_GOLD) {
		send_admin_error(player_index, "dare", "Quantidade invalida!");
		return;
	}

	int target = get_player_index_from(target_name);
	if(target == -1) {
		send_admin_error(player_index, "dare", "Jogador não encontrado!");
		return;
	}

	players[target].money += amount;
	send_reliable_text(players[target].peer_id, "msg2 Você recebeu $" + amount + " creditos!", 0);
	send_reliable_text(players[player_index].peer_id, "msg2 Dado $" + amount + " creditos para " + target_name, 0);
	debug_log("ADMIN: " + players[player_index].charname + " deu $" + amount + " para " + target_name);
}

