void send_unreliable(uint64 peer_id, string packet, int channel = 0) {
    packet = normalize_network_packet_text(packet);
    string encrypted = encrypt_packet(packet);

    if(peer_id == 0) {
        for(uint i = 0; i < connected_peers.length(); i++) {
            server_net.send(connected_peers[i], encrypted, channel, false);
        }
        return;
    }

    server_net.send(peer_id, encrypted, channel, false);
}

string[] msgadm_array;

void msgadm(string message) {
    msgadm_array.push_back(message);
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].admin_status) {
            send_reliable_text(players[i].peer_id, "msg [ADM] " + message);
        }
    }
}

void eadm(string admin_name, string message, int level) {
    debug_log("EADM: [" + admin_name + "] " + message);
}

void log(string category, string message) {
    debug_log(category + ": " + message);
}

void ganhaxp(string player_name, int exp_amount, int gold_amount) {
    int index = get_player_index_from(player_name);
    if(index >= 0) ganhaxp(index, exp_amount, gold_amount);
}

void ganhaxp(string player_name, int exp_amount) {
    ganhaxp(player_name, exp_amount, 0);
}

void apply_doublexp(string player_name, int amount) {
    int index = get_player_index_from(player_name);
    if(index < 0) return;
    players[index].exp += amount * 2;
    players[index].xp += amount * 2;
    check_level_up(index);
    send_reliable_text(players[index].peer_id,
        "msg2 Você ganhou +" + (amount * 2) + " XP (Dobrado)!", 0);
    debug_log("DOUBLEXP: " + player_name + " ganhou " + (amount * 2) + " XP");
}

void ge(string playername, double amount) {
    int index = get_player_index_from(playername);
    if (index > -1) {
        players[index].creditos += amount;
        send_reliable_text(players[index].peer_id, "msg2 Você recebeu " + amount + " créditos!", 0);
        debug_log("GE: " + playername + " recebeu " + amount + " créditos");
    }
}

void gc(string playername, double amount) {
    int index = get_player_index_from(playername);
    if (index > -1) {
        players[index].inv_add_item("coins", int(amount));
        send_reliable_text(players[index].peer_id, "msg2 Você recebeu " + amount + " moedas!", 0);
        debug_log("GC: " + playername + " recebeu " + amount + " moedas");
    }
}

void write_transfer_log(string name, string filename, string text) {
    if(name == "" || filename == "" || text == "") return;
    string player_dir = "players/" + name;
    if(!directory_exists(player_dir)) {
        directory_create(player_dir);
    }

    file log_file;
    if(!log_file.open(player_dir + "/" + filename, "a")) {
        debug_log("TRANSFER: falha ao abrir log de transferência para " + name);
        return;
    }
    log_file.write(text);
    log_file.close();
}

void save_transfer(string origin, string destination, string itemname, double amount) {
    save_transfer(origin, destination, itemname, "", amount);
}

void save_transfer(string origin, string destination, string itemname, string info, double amount) {
    if(origin == "" || destination == "") return;

    string stamp = DATE_DAY + "." + DATE_MONTH + "." + DATE_YEAR;
    string time_text = TIME_HOUR + "." + TIME_MINUTE;
    string log_name = "transferences_" + stamp + ".log";
    string suffix = info == "" ? "" : " " + info;

    string send_info = origin + " el " + stamp + " a las " + time_text + " transfirió " + amount + " " + itemname + " para " + destination + suffix + "\r\n";
    string receive_info = destination + " el " + stamp + " a las " + time_text + " recibió " + amount + " " + itemname + " de " + origin + suffix + "\r\n";

    write_transfer_log(origin, log_name, send_info);
    write_transfer_log(destination, log_name, receive_info);
    log_action(origin, "transfer", send_info, "", 0, 0, 0, info, destination, itemname);
}

npc@ get_npc_by_flat_index(int npc_index) {
    if(npc_index < 0) return null;

    int flat_index = 0;
    for(uint m = 0; m < server_maps.length(); m++) {
        int npc_count = int(server_maps[m].npcs.length());
        if(npc_index < flat_index + npc_count) {
            int local_index = npc_index - flat_index;
            if(local_index < 0 || local_index >= npc_count) return null;
            return server_maps[m].npcs[local_index];
        }
        flat_index += npc_count;
    }
    return null;
}

void die(int npc_index) {
    npc@ n = get_npc_by_flat_index(npc_index);
    if(n is null) return;
    if(n.morreu) return;

    n.vida = 0;
    n.die();
}

void attack(int npc_index, int target_player) {
    npc@ n = get_npc_by_flat_index(npc_index);
    if(n is null) return;
    if(target_player < 0 || target_player >= int(players.length())) return;
    if(players[target_player].map != n.map) return;
    if(players[target_player].afk || players[target_player].pacifico == 1 || players[target_player].health <= 0) return;

    n.p_index = target_player;
    n.attack();
}

void move(int npc_index, int direction) {
    npc@ n = get_npc_by_flat_index(npc_index);
    if(n is null) return;

    int nx = n.x;
    int ny = n.y;

    if(direction == 0) ny--;
    else if(direction == 1) ny++;
    else if(direction == 2) nx--;
    else if(direction == 3) nx++;
    else return;

    if(!is_walkable(nx, ny, n.map)) return;

    n.x = nx;
    n.y = ny;
    server_broadcast("npc_move " + n.id + " " + n.x + " " + n.y, n.map);
}
bool exists_player_in_my_map(int npc_index) {
    npc@ n = get_npc_by_flat_index(npc_index);
    if(n is null) return false;
    return n.exists_player_in_my_map();
}
int select_player_to_attack(int npc_index) {
    npc@ n = get_npc_by_flat_index(npc_index);
    if(n is null) return -1;
    return n.select_player_to_attack();
}

int change_player(int npc_index, int exclude = -1) {
    npc@ n = get_npc_by_flat_index(npc_index);
    if(n is null) return -1;
    return n.change_player(exclude);
}

void change_player(int npc_index) {
    change_player(npc_index, -1);
}

bool exists_player_in_my_map(string map_name) {
    if(map_name == "") return false;
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].map != map_name) continue;
        if(players[i].afk) continue;
        if(players[i].pacifico == 1) continue;
        if(players[i].newbie) continue;
        if(players[i].health <= 0) continue;
        return true;
    }
    return false;
}

double round(double value) {
    return double(int(value + 0.5));
}

string[] nvgt_split_fixed(string str, string delimiter, int max_parts) {
    string[] result;

    if(delimiter == "") {
        result.insert_last(str);
        return result;
    }

    if(max_parts <= 0) {
        return str.split(delimiter);
    }

    int start = 0;
    int pieces = 0;

    while(pieces < max_parts - 1) {
        int pos = str.find(delimiter, start);
        if(pos < 0) break;

        result.insert_last(str.substr(start, pos - start));
        start = pos + delimiter.length();
        pieces++;
    }

    result.insert_last(str.substr(start));
    return result;
}

string trim(string str) {
    if(str.length() == 0) return "";

    uint start = 0;
    while(start < str.length() && (str[start] == ' ' || str[start] == '\t' || str[start] == '\r' || str[start] == '\n')) {
        start++;
    }

    if(start == str.length()) return "";

    uint end = str.length() - 1;
    while(end > start && (str[end] == ' ' || str[end] == '\t' || str[end] == '\r' || str[end] == '\n')) {
        end--;
    }

    return str.substr(start, (end - start) + 1);
}

int get_bomba_distance(maxbomba@ bomb, player@ p) {
    if(bomb.map != p.map) return -1;
    int dx = int(abs(bomb.x - p.x));
    int dy = int(abs(bomb.y - p.y));
    return int(sqrt(double(dx*dx + dy*dy)));
}

bool item_take(int player_index, string item_name, int quantity) {
    if(player_index < 0 || player_index >= int(players.length())) return false;

    int current_quantity = players[player_index].inv_item_number(item_name);
    if(current_quantity < quantity) {
        debug_log("ITEM_TAKE FALHOU: " + players[player_index].charname + " não tem " + quantity + "x " + item_name + " (tem apenas " + current_quantity + ")");
        return false;
    }

    players[player_index].inv_remove_item(item_name, quantity);
    debug_log("ITEM_TAKE: " + players[player_index].charname + " removeu " + quantity + "x " + item_name);
    return true;
}

bool item_give(int player_index, string item_name, int quantity) {
    if(player_index < 0 || player_index >= int(players.length())) return false;

    players[player_index].inv_add_item(item_name, quantity);
    debug_log("ITEM_GIVE: " + players[player_index].charname + " recebeu " + quantity + "x " + item_name);
    return true;
}

