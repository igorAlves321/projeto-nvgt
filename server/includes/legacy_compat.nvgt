    string desc = "";
    if(location_descriptions.get(key, desc)) {
        return desc;
    }
    return "Localização: " + map + " (" + x + ", " + y + ")";
}

string getdesc(string item_name) {
    string desc = "";
    if(item_descriptions.get(item_name, desc)) {
        return desc;
    }
    return "Item: " + item_name;
}

