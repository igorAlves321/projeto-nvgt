
banheiro@[] banheiros;

class banheiro {
	int x, y, descarga = 0;
	bool vasoaberto = false;
	string map;

	banheiro(int bx, int by, string bmap) {
		x = bx;
		y = by;
		map = bmap;
	}

	banheiro(int bx, int by) {
		x = bx;
		y = by;
		map = "";
	}
}

void colocar_banheiro(int x, int y, string mapa) {
	banheiro b(x, y, mapa);
	banheiros.insert_last(b);
}
