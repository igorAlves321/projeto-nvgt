// banheiro.nvgt - Sistema de Banheiros do EVM Server (convertido de BGT)
// Conversão: BGT → NVGT

banheiro@[] banheiros;

class banheiro {
	int x, y, descarga = 0;
	bool vasoaberto = false;
	string map;
	
	banheiro(int bx, int by, string bmap) {
		x = bx;
		y = by;
		map = bmap;
	}
}

void colocar_banheiro(int x, int y, string mapa) {
	banheiro b(x, y, mapa);
	banheiros.insert_last(b);
}
