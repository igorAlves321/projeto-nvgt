bool handle_progression_player_command(uint64 peer_id, player@ player, int player_index, string command, string cmd, string[] parts) {
    if(cmd == "/quests" || cmd == "quests") {
        cmd_quests(player_index);
        return true;
    }

    if((cmd == "/questinfo" || cmd == "questinfo") && parts.length() >= 2) {
        int quest_id = 0;
        if(!try_parse_int_token(parts[1], quest_id)) {
            reject_invalid_network_packet(peer_id, "process_player_command:questinfo_id", command);
            return true;
        }
        cmd_questinfo(player_index, quest_id);
        return true;
    }

    if((cmd == "/acceptquest" || cmd == "acceptquest") && parts.length() >= 2) {
        int quest_id = 0;
        if(!try_parse_int_token(parts[1], quest_id)) {
            reject_invalid_network_packet(peer_id, "process_player_command:acceptquest_id", command);
            return true;
        }
        cmd_acceptquest(player_index, quest_id);
        return true;
    }

    if((cmd == "/abandonquest" || cmd == "abandonquest") && parts.length() >= 2) {
        int quest_id = 0;
        if(!try_parse_int_token(parts[1], quest_id)) {
            reject_invalid_network_packet(peer_id, "process_player_command:abandonquest_id", command);
            return true;
        }
        cmd_abandonquest(player_index, quest_id);
        return true;
    }

    if((cmd == "/completequest" || cmd == "completequest") && parts.length() >= 2) {
        int quest_id = 0;
        if(!try_parse_int_token(parts[1], quest_id)) {
            reject_invalid_network_packet(peer_id, "process_player_command:completequest_id", command);
            return true;
        }
        cmd_completequest(player_index, quest_id);
        return true;
    }

    if(cmd == "/availablequests" || cmd == "availablequests") {
        cmd_availablequests(player_index);
        return true;
    }

    if(cmd == "/dungeons" || cmd == "dungeons") {
        string[] no_args;
        cmd_dungeons(player_index, no_args);
        return true;
    }

    if(cmd == "/dungeoninfo" || cmd == "dungeoninfo") {
        if(parts.length() < 2) {
            send_reliable_text(peer_id, "say Uso: /dungeoninfo <id>", 0);
            return true;
        }
        string[] d_args = {parts[1]};
        cmd_dungeoninfo(player_index, d_args);
        return true;
    }

    if(cmd == "/createdungeon" || cmd == "createdungeon") {
        if(parts.length() < 2) {
            send_reliable_text(peer_id, "say Uso: /createdungeon <id>", 0);
            return true;
        }
        string[] d_args = {parts[1]};
        cmd_createdungeon(player_index, d_args);
        return true;
    }

    if(cmd == "/joindungeon" || cmd == "joindungeon") {
        if(parts.length() < 2) {
            send_reliable_text(peer_id, "say Uso: /joindungeon <instance_id>", 0);
            return true;
        }
        string[] d_args = {parts[1]};
        cmd_joindungeon(player_index, d_args);
        return true;
    }

    if(cmd == "/ready" || cmd == "ready") {
        string[] no_args;
        cmd_ready(player_index, no_args);
        return true;
    }

    if(cmd == "/leavedungeon" || cmd == "leavedungeon") {
        string[] no_args;
        cmd_leavedungeon(player_index, no_args);
        return true;
    }

    if(cmd == "/achievements" || cmd == "achievements" || cmd == "/conquistas" || cmd == "conquistas") {
        string filter = (parts.length() >= 2) ? parts[1] : "all";
        cmd_achievements(player_index, filter);
        return true;
    }

    if((cmd == "/achievementinfo" || cmd == "achievementinfo") && parts.length() >= 2) {
        int ach_id = 0;
        if(!try_parse_int_token(parts[1], ach_id)) {
            reject_invalid_network_packet(peer_id, "process_player_command:achievementinfo_id", command);
            return true;
        }
        cmd_achievementinfo(player_index, ach_id);
        return true;
    }

    if(cmd == "/titles" || cmd == "titles" || cmd == "/titulos" || cmd == "titulos") {
        cmd_titles(player_index);
        return true;
    }

    if((cmd == "/settitle" || cmd == "settitle") && parts.length() >= 2) {
        string title = parts[1];
        for(uint i = 2; i < parts.length(); i++) {
            title += " " + parts[i];
        }
        cmd_settitle(player_index, title);
        return true;
    }

    if(cmd == "/removetitle" || cmd == "removetitle") {
        cmd_removetitle(player_index);
        return true;
    }

    if(cmd == "/daily" || cmd == "daily" || cmd == "/diario" || cmd == "diario") {
        cmd_daily_status(player_index);
        return true;
    }

    if(cmd == "/claimdaily" || cmd == "claimdaily" || cmd == "/coletardiario" || cmd == "coletardiario") {
        cmd_claim_daily(player_index);
        return true;
    }

    if(cmd == "/spin" || cmd == "spin" || cmd == "/roleta" || cmd == "roleta") {
        cmd_spin_wheel(player_index);
        return true;
    }

    if(cmd == "/box" || cmd == "box" || cmd == "/caixa" || cmd == "caixa") {
        cmd_mystery_box(player_index);
        return true;
    }

    if(cmd == "/comprarcasa" || cmd == "comprarcasa") {
        cmd_comprarcasa(player_index);
        return true;
    }

    if(cmd == "/trancar" || cmd == "trancar") {
        cmd_toggle_lock(player_index);
        return true;
    }

    if(cmd == "/bau" || cmd == "bau") {
        if(parts.length() < 4) {
            send_reliable_text(peer_id, "say Uso: /bau <guardar|retirar> <item> <quantidade>", 0);
            return true;
        }
        int bau_qty = 0;
        if(!try_parse_int_token(parts[3], bau_qty) || bau_qty <= 0) {
            send_reliable_text(peer_id, "say Quantidade invalida.", 0);
            return true;
        }
        if(parts[1] == "guardar") cmd_guardar_bau(player_index, parts[2], bau_qty);
        else if(parts[1] == "retirar") cmd_retirar_bau(player_index, parts[2], bau_qty);
        else send_reliable_text(peer_id, "say Uso: /bau <guardar|retirar> <item> <quantidade>", 0);
        return true;
    }

    if(cmd == "/events" || cmd == "events") {
        string[] no_args;
        cmd_events(player_index, no_args);
        return true;
    }

    if((cmd == "/eventinfo" || cmd == "eventinfo") && parts.length() >= 2) {
        string[] ev_args = {parts[1]};
        cmd_eventinfo(player_index, ev_args);
        return true;
    }

    if((cmd == "/registerevent" || cmd == "registerevent") && parts.length() >= 2) {
        string[] ev_args = {parts[1]};
        cmd_registerevent(player_index, ev_args);
        return true;
    }

    if((cmd == "/startevent" || cmd == "startevent") && parts.length() >= 2) {
        if(!has_role(player.charname, "admin") && !has_role(player.charname, "dev")) {
            send_reliable_text(peer_id, "say Você não tem permissao para iniciar eventos.", 0);
            return true;
        }
        string[] ev_args = {parts[1]};
        cmd_startevent(player_index, ev_args);
        return true;
    }

    if((cmd == "/endevent" || cmd == "endevent") && parts.length() >= 2) {
        if(!has_role(player.charname, "admin") && !has_role(player.charname, "dev")) {
            send_reliable_text(peer_id, "say Você não tem permissao para finalizar eventos.", 0);
            return true;
        }
        string[] ev_args = {parts[1]};
        cmd_endevent(player_index, ev_args);
        return true;
    }

    return false;
}
