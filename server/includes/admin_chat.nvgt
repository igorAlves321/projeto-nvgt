// admin_chat.nvgt - Sistema de Chat Administrativo Adicional
// Nota: A função eadm() já existe em voids.nvgt, então usamos ela

// ============================================================
// Comando /adminchat ou /ac - Enviar mensagem no chat admin
// ============================================================
void cmd_adminchat(int sender_index, string message) {
    if(sender_index < 0 || sender_index >= int(players.length())) return;
    
    // Verificar se quem envia é staff
    bool is_staff = has_role(players[sender_index].charname, "dev") || 
                    has_role(players[sender_index].charname, "admin") || 
                    has_role(players[sender_index].charname, "mod");
    
    if(!is_staff) {
        send_reliable_text(players[sender_index].peer_id, "msg Você não tem permissão para usar o chat admin.", 0);
        return;
    }
    
    if(message.length() == 0) {
        send_reliable_text(players[sender_index].peer_id, "msg Uso: /ac <mensagem>", 0);
        return;
    }
    
    // Formatar e enviar mensagem usando eadm() existente
    string formatted_msg = "[ADMIN] " + players[sender_index].charname + ": " + message;
    eadm(formatted_msg);
}

// ============================================================
// Notificação de sistema para admins (sem autor)
// ============================================================
void notify_admins(string message, string sound = "notify5.ogg") {
    eadm("[SISTEMA] " + message, sound);
}

