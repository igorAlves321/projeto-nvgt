// shared_globals.nvgt - Variáveis globais compartilhadas do servidor EVM
// Para evitar problemas com extern, declaramos as variáveis globais aqui

// Plugin SQLite necessário
#pragma plugin nvgt_sqlite
#include "sqlite3constants.nvgt"

// Variáveis globais do banco de dados
sqlite3@ bancoJogo;
bool database_initialized = false;

// Variáveis globais do servidor
bool server_running = false;
bool game_frozen = false;
int connected_count = 0;

// Variáveis de estado do jogo (para comandos admin)
bool special_xp_enabled = false;
bool pvp_enabled = true;
bool mines_enabled = true;

// Threads assíncronas para operações pesadas
bool async_save_running = false;
bool async_backup_running = false;

// Configurações do servidor (já definidas em server.nvgt)
// const int SERVER_PORT = 9317;
// const int MAX_PLAYERS = 100;
// const string DATABASE_FILE = "server/database/evm.db";
