
#include "globals.nvgt"

enum dungeon_difficulty {
    DIFFICULTY_NORMAL,
    DIFFICULTY_HARD,
    DIFFICULTY_HEROIC
}

enum dungeon_instance_state {
    INSTANCE_WAITING,
    INSTANCE_ACTIVE,
    INSTANCE_COMPLETED,
    INSTANCE_FAILED,
    INSTANCE_EXPIRED
}

class dungeon_wave {
    int wave_number;
    string[] enemies;
    int[] enemy_counts;
    int[] enemy_levels;
    int delay_seconds;
    string special_event;

    dungeon_wave() {
        wave_number = 1;
        delay_seconds = 5;
    }
}

class dungeon_boss_encounter {
    string boss_name;
    int boss_level;
    int boss_hp;
    int boss_damage;
    string[] abilities;
    int guaranteed_gold;
    int guaranteed_xp;

    dungeon_boss_encounter() {
        boss_level = 1;
        boss_hp = 10000;
        boss_damage = 100;
        guaranteed_gold = 1000;
        guaranteed_xp = 5000;
    }
}

class dungeon_checkpoint {
    int wave_number;
    float x, y, z;
    bool activated;

    dungeon_checkpoint() {
        wave_number = 0;
        activated = false;
    }
}

class dungeon_definition {
    int id;
    string name;
    string description;
    int required_level;
    int min_players;
    int max_players;
    dungeon_difficulty difficulty;
    int time_limit_minutes;
    int daily_entry_limit;

    int base_gold_reward;
    int base_xp_reward;

    dungeon_wave@[] waves;

    dungeon_boss_encounter@ final_boss;

    dungeon_checkpoint@[] checkpoints;

    dungeon_definition() {
        id = 0;
        required_level = 1;
        min_players = 1;
        max_players = 5;
        difficulty = DIFFICULTY_NORMAL;
        time_limit_minutes = 30;
        daily_entry_limit = 3;
        base_gold_reward = 500;
        base_xp_reward = 1000;
    }

    int get_gold_reward() {
        float multiplier = 1.0;
        switch (difficulty) {
            case DIFFICULTY_HARD: multiplier = 1.5; break;
            case DIFFICULTY_HEROIC: multiplier = 2.0; break;
        }
        return int(base_gold_reward * multiplier);
    }

    int get_xp_reward() {
        float multiplier = 1.0;
        switch (difficulty) {
            case DIFFICULTY_HARD: multiplier = 1.5; break;
            case DIFFICULTY_HEROIC: multiplier = 2.0; break;
        }
        return int(base_xp_reward * multiplier);
    }
}

class dungeon_participant {
    string player_name;
    int damage_dealt;
    int healing_done;
    int deaths;
    bool is_ready;

    dungeon_participant(string name) {
        player_name = name;
        damage_dealt = 0;
        healing_done = 0;
        deaths = 0;
        is_ready = false;
    }
}

class dungeon_instance {
    int instance_id;
    dungeon_definition@ definition;
    dungeon_instance_state state;
    dungeon_difficulty difficulty;

    dungeon_participant@[] participants;
    string party_leader;

    int current_wave;
    int enemies_remaining;
    int total_enemies_killed;
    timer start_time;
    timer wave_timer;
    dungeon_checkpoint@ last_checkpoint;

    int completion_time_seconds;
    bool bonus_objective_completed;

    // Ponto onde as ondas nascem: a posicao do lider quando a dungeon comeca.
    string mapa_spawn = "";
    int spawn_x = 0;
    int spawn_y = 0;
    // Intervalo entre o fim de uma onda e o inicio da seguinte.
    bool proxima_onda_pendente = false;
    int proxima_onda = 0;
    timer proxima_onda_timer;
    bool chefe_vivo = false;
    bool monstros_limpos = false;

    dungeon_instance() {
        instance_id = 0;
        state = INSTANCE_WAITING;
        difficulty = DIFFICULTY_NORMAL;
        current_wave = 0;
        enemies_remaining = 0;
        total_enemies_killed = 0;
        completion_time_seconds = 0;
        bonus_objective_completed = false;
    }

    bool add_participant(string player_name) {
        if (int(participants.length()) >= definition.max_players) {
            return false;
        }

        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                return false;
            }
        }

        dungeon_participant@ dp = dungeon_participant(player_name);
        participants.insert_last(dp);

        if (participants.length() == 1) {
            party_leader = player_name;
        }

        return true;
    }

    void remove_participant(string player_name) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                participants.remove_at(i);
                break;
            }
        }

        if (party_leader == player_name && participants.length() > 0) {
            party_leader = participants[0].player_name;
            broadcast("Novo lider: " + party_leader);
        }
    }

    bool all_ready() {
        if (participants.length() < uint(definition.min_players)) {
            return false;
        }

        for (uint i = 0; i < participants.length(); i++) {
            if (!participants[i].is_ready) {
                return false;
            }
        }
        return true;
    }

    void start() {
        // As ondas nascem em volta do lider (ou do primeiro participante online).
        int ancora = get_player_index_from(party_leader);
        for (uint i = 0; i < participants.length() && ancora < 0; i++) {
            ancora = get_player_index_from(participants[i].player_name);
        }
        if (ancora < 0 || get_map_index_from(players[ancora].map) < 0) {
            fail("Nenhum participante presente.");
            return;
        }

        mapa_spawn = players[ancora].map;
        spawn_x = players[ancora].x;
        spawn_y = players[ancora].y;

        state = INSTANCE_ACTIVE;
        current_wave = 1;
        start_time.restart();
        broadcast("Dungeon iniciada! Prepare-se!");
        start_wave(1);
    }

    // Cria um inimigo real (monstruo) ligado a esta instancia. O dano e a morte
    // dele voltam para ca por dungeon_registrar_dano / dungeon_monstro_morreu.
    void spawn_inimigo(string tipo, int vida, int dano_min, int dano_max, bool chefe) {
        int mi = get_map_index_from(mapa_spawn);
        if (mi < 0) return;

        int afastamento = random(DUNGEON_SPAWN_DIST_MIN, DUNGEON_SPAWN_DIST_MAX);
        int ex = (random(0, 1) == 0) ? spawn_x - afastamento : spawn_x + afastamento;
        if (ex < 0) ex = spawn_x + afastamento;
        if (server_maps[mi].max_x > 0 && ex > server_maps[mi].max_x) ex = spawn_x - afastamento;
        if (ex < 0) ex = 0;

        monstruo@ m = spawn_monstruo_especial(ex, spawn_y, mapa_spawn, tipo, vida, dano_min, dano_max);
        m.dungeon_instance_id = instance_id;
        m.dungeon_chefe = chefe;
        m.anunciar_morte = false;
    }

    void start_wave(int wave_num) {
        if (wave_num > int(definition.waves.length())) {
            spawn_final_boss();
            return;
        }

        current_wave = wave_num;
        dungeon_wave@ wave = definition.waves[wave_num - 1];

        broadcast("Wave " + wave_num + " de " + definition.waves.length() + "!");

        enemies_remaining = 0;
        for (uint i = 0; i < wave.enemy_counts.length(); i++) {
            enemies_remaining += wave.enemy_counts[i];
        }

        wave_timer.restart();

        for (uint i = 0; i < wave.enemies.length(); i++) {
            string enemy_type = wave.enemies[i];
            int count = wave.enemy_counts[i];
            int level = wave.enemy_levels[i];
            if (level < 1) level = 1;

            broadcast("Apareceram " + count + "x " + enemy_type + " (Nivel " + level + ")");

            for (int n = 0; n < count; n++) {
                spawn_inimigo(enemy_type, level * DUNGEON_VIDA_POR_NIVEL,
                    level * DUNGEON_DANO_MIN_POR_NIVEL, level * DUNGEON_DANO_MAX_POR_NIVEL, false);
            }
        }

        if (enemies_remaining <= 0) {
            wave_completed();
        }
    }

    void enemy_killed(string enemy_type) {
        if (state != INSTANCE_ACTIVE) return;

        enemies_remaining--;
        total_enemies_killed++;

        if (enemies_remaining <= 0) {
            wave_completed();
        } else {
            broadcast(enemy_type + " derrotado. Restam " + enemies_remaining + ".");
        }
    }

    void wave_completed() {
        broadcast("[OK] Wave " + current_wave + " completa!");

        for (uint i = 0; i < definition.checkpoints.length(); i++) {
            if (definition.checkpoints[i].wave_number == current_wave) {
                activate_checkpoint(definition.checkpoints[i]);
                break;
            }
        }

        if (current_wave < int(definition.waves.length())) {
            int espera = definition.waves[current_wave].delay_seconds;
            if (espera < 1) espera = 1;
            broadcast("Proxima wave em " + espera + " segundos...");
            proxima_onda = current_wave + 1;
            proxima_onda_pendente = true;
            proxima_onda_timer.restart();
        } else {
            spawn_final_boss();
        }
    }

    // Chamado por dungeons_loop(): dispara a onda agendada em wave_completed().
    void atualizar_ondas() {
        if (state != INSTANCE_ACTIVE || !proxima_onda_pendente) return;
        if (proxima_onda < 1 || proxima_onda > int(definition.waves.length())) {
            proxima_onda_pendente = false;
            return;
        }

        int espera = definition.waves[proxima_onda - 1].delay_seconds;
        if (espera < 1) espera = 1;
        if (proxima_onda_timer.elapsed < espera * 1000) return;

        proxima_onda_pendente = false;
        start_wave(proxima_onda);
    }

    bool algum_participante_online() {
        for (uint i = 0; i < participants.length(); i++) {
            if (get_player_index_from(participants[i].player_name) > -1) return true;
        }
        return false;
    }

    void activate_checkpoint(dungeon_checkpoint@ cp) {
        cp.activated = true;
        @last_checkpoint = cp;
        broadcast("Checkpoint ativado! Se morrerem, ressurgirao aqui.");
    }

    void spawn_final_boss() {
        if (definition.final_boss is null) {
            complete();
            return;
        }

        broadcast("BOSS FINAL: " + definition.final_boss.boss_name);
        broadcast("Nivel: " + definition.final_boss.boss_level);
        broadcast("HP: " + definition.final_boss.boss_hp);

        chefe_vivo = true;
        spawn_inimigo(definition.final_boss.boss_name, definition.final_boss.boss_hp,
            definition.final_boss.boss_damage * DUNGEON_CHEFE_DANO_FATOR_MIN,
            definition.final_boss.boss_damage * DUNGEON_CHEFE_DANO_FATOR_MAX, true);
    }

    void boss_defeated() {
        if (state != INSTANCE_ACTIVE || !chefe_vivo) return;
        chefe_vivo = false;
        broadcast("Boss derrotado!");
        complete();
    }

    void complete() {
        if (state != INSTANCE_ACTIVE) return;
        state = INSTANCE_COMPLETED;
        completion_time_seconds = start_time.elapsed / 1000;

        broadcast("DUNGEON COMPLETA!");
        broadcast("Tempo: " + (completion_time_seconds / 60) + "m " + (completion_time_seconds % 60) + "s");

        distribute_rewards();
    }

    void fail(string reason) {
        state = INSTANCE_FAILED;
        proxima_onda_pendente = false;
        chefe_vivo = false;
        broadcast("DUNGEON FALHOU: " + reason);
    }

    void distribute_rewards() {
        int gold = definition.get_gold_reward();
        int xp = definition.get_xp_reward();

        if (completion_time_seconds < definition.time_limit_minutes * 60 / 2) {
            gold = int(gold * 1.5);
            xp = int(xp * 1.5);
            broadcast("Bonus de velocidade! +50% recompensas!");
        }

        loot_premio@[] premios_conclusao = dungeon_loot_carregar(definition.id, LOOT_ORIGEM_CONCLUSAO);
        loot_premio@[] premios_chefe;
        if (definition.final_boss !is null) {
            premios_chefe = dungeon_loot_carregar(definition.id, LOOT_ORIGEM_CHEFE);
        }

        for (uint i = 0; i < participants.length(); i++) {
            int pidx = get_player_index_from(participants[i].player_name);
            if (pidx < 0) continue;

            players[pidx].gold += gold;
            players[pidx].saldo = players[pidx].gold;
            ganhaxp(pidx, xp, 0);

            string msg = "=== RECOMPENSAS ===\n";
            msg += "Gold: " + gold + "\n";
            msg += "XP: " + xp + "\n";

            string itens = loot_entregar_premios(players[pidx], premios_conclusao);
            if (itens != "") {
                msg += "\nITENS:\n" + itens;
            }

            if (definition.final_boss !is null) {
                players[pidx].gold += definition.final_boss.guaranteed_gold;
                players[pidx].saldo = players[pidx].gold;
                if (definition.final_boss.guaranteed_xp > 0) ganhaxp(pidx, definition.final_boss.guaranteed_xp, 0);

                msg += "\nLOOT DO BOSS:\n";
                msg += "Gold: " + definition.final_boss.guaranteed_gold + "\n";
                msg += "XP: " + definition.final_boss.guaranteed_xp + "\n";
                msg += loot_entregar_premios(players[pidx], premios_chefe);
            }

            dungeon_send_to_player(pidx, msg);
        }
    }

    void broadcast(string message) {
        for (uint i = 0; i < participants.length(); i++) {
            dungeon_send_to_player_name(participants[i].player_name, message);
        }
    }

    bool check_timeout() {
        if (state != INSTANCE_ACTIVE) return false;

        if (start_time.elapsed >= definition.time_limit_minutes * 60 * 1000) {
            fail("Tempo esgotado!");
            return true;
        }
        return false;
    }
}

dungeon_definition@[] dungeon_templates;
dictionary dungeon_by_id;

dungeon_instance@[] active_instances;
int next_instance_id = 1;

dictionary player_daily_entries;

// Atributos dos inimigos das ondas, por nivel, na escala dos monstros comuns.
const int DUNGEON_VIDA_POR_NIVEL = 500;
const int DUNGEON_DANO_MIN_POR_NIVEL = 40;
const int DUNGEON_DANO_MAX_POR_NIVEL = 80;
const int DUNGEON_CHEFE_DANO_FATOR_MIN = 5;
const int DUNGEON_CHEFE_DANO_FATOR_MAX = 10;
const int DUNGEON_SPAWN_DIST_MIN = 4;
const int DUNGEON_SPAWN_DIST_MAX = 12;

// ---------------------------------------------------------------------
// Ligacao com o combate. Os inimigos das ondas e o chefe final sao monstruos
// de monstruos_global marcados com dungeon_instance_id; monstruo_global_loop()
// chama as duas funcoes abaixo quando sofrem dano e quando morrem.
// ---------------------------------------------------------------------

void dungeon_registrar_dano(int instance_id, string autor, int dano) {
    if (autor == "" || dano <= 0) return;
    dungeon_instance@ inst = get_instance(instance_id);
    if (inst is null) return;

    for (uint i = 0; i < inst.participants.length(); i++) {
        if (inst.participants[i].player_name == autor) {
            inst.participants[i].damage_dealt += dano;
            return;
        }
    }
}

void dungeon_monstro_morreu(int instance_id, string tipo, bool chefe) {
    dungeon_instance@ inst = get_instance(instance_id);
    if (inst is null) return;

    if (chefe) inst.boss_defeated();
    else inst.enemy_killed(tipo);
}

// Tira do mundo o que sobrou de uma instancia encerrada. Nao remove do array
// (quem remove e monstruo_global_loop): desliga o vinculo e zera a vida.
void dungeon_limpar_monstros(int instance_id) {
    if (instance_id <= 0) return;
    for (uint i = 0; i < monstruos_global.length(); i++) {
        if (monstruos_global[i].dungeon_instance_id != instance_id) continue;
        monstruos_global[i].dungeon_instance_id = 0;
        monstruos_global[i].vida = 0;
        monstruos_global[i].vida_registrada = 0;
        monstruos_global[i].morreu = true;
    }
}

void init_dungeons_system() {
    dungeon_templates.resize(0);
    dungeon_by_id.delete_all();
    active_instances.resize(0);
    player_daily_entries.delete_all();

    create_default_dungeons();
    init_dungeon_loot();
    load_dungeons_data();
}

// ---------------------------------------------------------------------
// Loot das dungeons no SQLite (tabela dungeon_loot). origem = 'conclusao'
// (itens de quem completa) ou 'chefe' (drops do boss final). O codigo so faz
// a carga inicial com a tabela vazia; em runtime os premios sao lidos do banco.
// ---------------------------------------------------------------------

void criar_tabela_dungeon_loot() {
    if(!database_initialized || bancoJogo is null) {
        debug_log("ERRO: criar_tabela_dungeon_loot - Banco não inicializado");
        return;
    }

    string create_dungeon_loot = """
        CREATE TABLE IF NOT EXISTS dungeon_loot (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            dungeon_id INTEGER NOT NULL,
            origem TEXT NOT NULL DEFAULT 'conclusao',
            item_name TEXT NOT NULL,
            qty_min INTEGER DEFAULT 1,
            qty_max INTEGER DEFAULT 1,
            chance REAL DEFAULT 1.0,
            UNIQUE(dungeon_id, origem, item_name)
        );
    """;

    if(bancoJogo.execute(create_dungeon_loot) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela dungeon_loot: " + bancoJogo.get_last_error_text());
    }
}

bool dungeon_loot_inserir(int dungeon_id, string origem, string item_name, string exibicao, int qty_min, int qty_max, double chance) {
    if(!database_initialized || bancoJogo is null) return false;

    ensure_item_in_catalog(item_name, exibicao);

    sqlite3statement@ stmt = bancoJogo.prepare("INSERT OR IGNORE INTO dungeon_loot (dungeon_id, origem, item_name, qty_min, qty_max, chance) VALUES (?, ?, ?, ?, ?, ?);");
    if(@stmt == null) {
        debug_log("ERRO ao preparar dungeon_loot_inserir: " + bancoJogo.get_last_error_text());
        return false;
    }

    stmt.bind_int(1, dungeon_id);
    stmt.bind_text(2, origem);
    stmt.bind_text(3, item_name);
    stmt.bind_int(4, qty_min);
    stmt.bind_int(5, qty_max);
    stmt.bind_double(6, chance);

    return (stmt.step() == SQLITE_DONE);
}

int seed_dungeon_loot() {
    int semeados = 0;

    // Caverna dos Goblins
    if(dungeon_loot_inserir(1, LOOT_ORIGEM_CONCLUSAO, "pocao_vida", "Poção de vida", 3, 3, 1.0)) semeados++;
    if(dungeon_loot_inserir(1, LOOT_ORIGEM_CHEFE, "espada_de_ferro", "Espada de ferro", 1, 1, 0.3)) semeados++;
    if(dungeon_loot_inserir(1, LOOT_ORIGEM_CHEFE, "colete", "Colete", 1, 1, 0.15)) semeados++;

    // Fortaleza dos Mortos-Vivos
    if(dungeon_loot_inserir(2, LOOT_ORIGEM_CONCLUSAO, "pocao_vida_maior", "Poção de vida maior", 5, 5, 1.0)) semeados++;
    if(dungeon_loot_inserir(2, LOOT_ORIGEM_CONCLUSAO, "mana", "Mana", 5, 5, 1.0)) semeados++;
    if(dungeon_loot_inserir(2, LOOT_ORIGEM_CHEFE, "cajado_do_lich", "Cajado do Lich", 1, 1, 0.2)) semeados++;
    if(dungeon_loot_inserir(2, LOOT_ORIGEM_CHEFE, "orbe_das_sombras", "Orbe das Sombras", 1, 1, 0.15)) semeados++;
    if(dungeon_loot_inserir(2, LOOT_ORIGEM_CHEFE, "manto_espectral", "Manto Espectral", 1, 1, 0.25)) semeados++;

    // Templo do Fogo Eterno
    if(dungeon_loot_inserir(3, LOOT_ORIGEM_CONCLUSAO, "pocao_vida_total", "Poção de vida total", 10, 10, 1.0)) semeados++;
    if(dungeon_loot_inserir(3, LOOT_ORIGEM_CONCLUSAO, "mana", "Mana", 10, 10, 1.0)) semeados++;
    if(dungeon_loot_inserir(3, LOOT_ORIGEM_CONCLUSAO, "fragmento_de_fogo", "Fragmento de Fogo", 1, 1, 1.0)) semeados++;
    if(dungeon_loot_inserir(3, LOOT_ORIGEM_CHEFE, "espada_lendaria", "Espada lendária", 1, 1, 0.1)) semeados++;
    if(dungeon_loot_inserir(3, LOOT_ORIGEM_CHEFE, "armadura_de_chamas", "Armadura de Chamas", 1, 1, 0.15)) semeados++;
    if(dungeon_loot_inserir(3, LOOT_ORIGEM_CHEFE, "anel_do_fogo_eterno", "Anel do Fogo Eterno", 1, 1, 0.2)) semeados++;
    if(dungeon_loot_inserir(3, LOOT_ORIGEM_CHEFE, "elmo_igneo", "Elmo Ígneo", 1, 1, 0.25)) semeados++;

    return semeados;
}

void init_dungeon_loot() {
    criar_tabela_dungeon_loot();

    int total = loot_contar_linhas("dungeon_loot");
    if(total == 0) {
        int semeados = seed_dungeon_loot();
        debug_log("DUNGEONS: tabela dungeon_loot vazia, " + semeados + " premios semeados");
    } else {
        debug_log("DUNGEONS: " + total + " premios registrados em dungeon_loot");
    }

    loot_sincronizar_catalogo_itens("dungeon_loot");
}

loot_premio@[] dungeon_loot_carregar(int dungeon_id, string origem) {
    loot_premio@[] premios;
    if(!database_initialized || bancoJogo is null) return premios;

    sqlite3statement@ stmt = bancoJogo.prepare("SELECT item_name, qty_min, qty_max, chance FROM dungeon_loot WHERE dungeon_id = ? AND origem = ? ORDER BY chance DESC, id;");
    if(@stmt == null) return premios;

    stmt.bind_int(1, dungeon_id);
    stmt.bind_text(2, origem);

    while(stmt.step() == SQLITE_ROW) {
        premios.insert_last(loot_ler_premio(stmt));
    }

    return premios;
}

void create_default_dungeons() {
    {
        dungeon_definition@ d = dungeon_definition();
        d.id = 1;
        d.name = "Caverna dos Goblins";
        d.description = "Uma caverna infestada de goblins agressivos.";
        d.required_level = 5;
        d.min_players = 1;
        d.max_players = 3;
        d.difficulty = DIFFICULTY_NORMAL;
        d.time_limit_minutes = 20;
        d.daily_entry_limit = 5;
        d.base_gold_reward = 500;
        d.base_xp_reward = 1000;

        dungeon_wave@ w1 = dungeon_wave();
        w1.wave_number = 1;
        w1.enemies = {"Goblin Guerreiro"};
        w1.enemy_counts = {5};
        w1.enemy_levels = {5};
        w1.delay_seconds = 5;
        d.waves.insert_last(w1);

        dungeon_wave@ w2 = dungeon_wave();
        w2.wave_number = 2;
        w2.enemies = {"Goblin Guerreiro", "Goblin Arqueiro"};
        w2.enemy_counts = {4, 3};
        w2.enemy_levels = {5, 6};
        w2.delay_seconds = 10;
        d.waves.insert_last(w2);

        dungeon_wave@ w3 = dungeon_wave();
        w3.wave_number = 3;
        w3.enemies = {"Goblin Xama"};
        w3.enemy_counts = {2};
        w3.enemy_levels = {7};
        w3.delay_seconds = 10;
        d.waves.insert_last(w3);

        dungeon_boss_encounter@ boss = dungeon_boss_encounter();
        boss.boss_name = "Chefe Goblin";
        boss.boss_level = 8;
        boss.boss_hp = 5000;
        boss.boss_damage = 80;
        boss.abilities = {"Grito de Guerra", "Invocar Goblins"};
        boss.guaranteed_gold = 300;
        boss.guaranteed_xp = 800;
        @d.final_boss = boss;

        dungeon_checkpoint@ cp = dungeon_checkpoint();
        cp.wave_number = 2;
        d.checkpoints.insert_last(cp);


        add_dungeon(d);
    }

    {
        dungeon_definition@ d = dungeon_definition();
        d.id = 2;
        d.name = "Fortaleza dos Mortos-Vivos";
        d.description = "Uma fortaleza amaldicoada repleta de mortos-vivos.";
        d.required_level = 12;
        d.min_players = 3;
        d.max_players = 5;
        d.difficulty = DIFFICULTY_HARD;
        d.time_limit_minutes = 30;
        d.daily_entry_limit = 3;
        d.base_gold_reward = 1500;
        d.base_xp_reward = 3000;

        for (int i = 1; i <= 5; i++) {
            dungeon_wave@ w = dungeon_wave();
            w.wave_number = i;
            w.enemies = {"Esqueleto Guerreiro", "Zumbi"};
            w.enemy_counts = {3 + i, 2 + i};
            w.enemy_levels = {12 + i, 11 + i};
            w.delay_seconds = 15;
            d.waves.insert_last(w);
        }

        dungeon_boss_encounter@ boss = dungeon_boss_encounter();
        boss.boss_name = "Lich Anciao";
        boss.boss_level = 15;
        boss.boss_hp = 15000;
        boss.boss_damage = 200;
        boss.abilities = {"Explosao Sombria", "Drenar Vida", "Invocar Esqueletos"};
        boss.guaranteed_gold = 1000;
        boss.guaranteed_xp = 2500;
        @d.final_boss = boss;

        dungeon_checkpoint@ cp1 = dungeon_checkpoint();
        cp1.wave_number = 3;
        d.checkpoints.insert_last(cp1);


        add_dungeon(d);
    }

    {
        dungeon_definition@ d = dungeon_definition();
        d.id = 3;
        d.name = "Templo do Fogo Eterno";
        d.description = "Um templo ancestral onde o fogo nunca se apaga.";
        d.required_level = 20;
        d.min_players = 5;
        d.max_players = 5;
        d.difficulty = DIFFICULTY_HEROIC;
        d.time_limit_minutes = 45;
        d.daily_entry_limit = 2;
        d.base_gold_reward = 3000;
        d.base_xp_reward = 6000;

        for (int i = 1; i <= 7; i++) {
            dungeon_wave@ w = dungeon_wave();
            w.wave_number = i;
            w.enemies = {"Elemental de Fogo", "Cultista do Fogo"};
            w.enemy_counts = {4 + i, 3 + i};
            w.enemy_levels = {20 + i, 19 + i};
            w.delay_seconds = 20;
            d.waves.insert_last(w);
        }

        dungeon_boss_encounter@ boss = dungeon_boss_encounter();
        boss.boss_name = "Senhor do Fogo";
        boss.boss_level = 25;
        boss.boss_hp = 50000;
        boss.boss_damage = 400;
        boss.abilities = {"Meteoro", "Circulo de Fogo", "Invocar Elementais", "Explosao Ignea"};
        boss.guaranteed_gold = 2500;
        boss.guaranteed_xp = 5000;
        @d.final_boss = boss;

        dungeon_checkpoint@ cp1 = dungeon_checkpoint();
        cp1.wave_number = 3;
        d.checkpoints.insert_last(cp1);

        dungeon_checkpoint@ cp2 = dungeon_checkpoint();
        cp2.wave_number = 5;
        d.checkpoints.insert_last(cp2);


        add_dungeon(d);
    }
}

void add_dungeon(dungeon_definition@ d) {
    dungeon_templates.insert_last(d);
    dungeon_by_id.set("" + d.id, @d);
}

dungeon_definition@ get_dungeon_template(int id) {
    dungeon_definition@ d;
    if (dungeon_by_id.get("" + id, @d)) {
        return d;
    }
    return null;
}

void dungeon_send_to_player(int client_index, const string&in message) {
    if(client_index < 0 || client_index >= int(players.length())) return;
    if(players[client_index] is null) return;
    string m = message.replace("\n", "; ");
    send_reliable_text(players[client_index].peer_id, "msg2 ;" + m + ";", 0);
}

void dungeon_send_to_player_name(const string&in player_name, const string&in message) {
    int idx = get_player_index_from(player_name);
    if(idx < 0) return;
    dungeon_send_to_player(idx, message);
}

dungeon_instance@ get_player_instance(const string&in player_name) {
    for(uint i = 0; i < active_instances.length(); i++) {
        dungeon_instance@ inst = active_instances[i];
        if(inst is null) continue;
        for(uint j = 0; j < inst.participants.length(); j++) {
            if(inst.participants[j].player_name == player_name) return inst;
        }
    }
    return null;
}

void cmd_dungeons(int client_index, string[] args) {
    string msg = "=== DUNGEONS DISPONIVEIS ===\n\n";

    for (uint i = 0; i < dungeon_templates.length(); i++) {
        dungeon_definition@ d = dungeon_templates[i];

        msg += "[" + d.id + "] " + d.name + "\n";
        msg += "Nivel: " + d.required_level + " | ";

        switch (d.difficulty) {
            case DIFFICULTY_NORMAL: msg += "Normal"; break;
            case DIFFICULTY_HARD: msg += "Dificil"; break;
            case DIFFICULTY_HEROIC: msg += "Heroico"; break;
        }

        msg += "\n";
        msg += "Jogadores: " + d.min_players + "-" + d.max_players + "\n";
        msg += "Tempo limite: " + d.time_limit_minutes + " minutos\n";
        msg += "Entradas diarias: " + d.daily_entry_limit + "\n";
        msg += "---\n";
    }

    msg += "\nUse /dungeoninfo <id> para detalhes.";
    dungeon_send_to_player(client_index, msg);
}

void cmd_dungeoninfo(int client_index, string[] args) {
    if (args.length() < 1) {
        dungeon_send_to_player(client_index, "Use: /dungeoninfo <id>");
        return;
    }

    int id = string_to_number(args[0]);
    dungeon_definition@ d = get_dungeon_template(id);

    if (d is null) {
        dungeon_send_to_player(client_index, "Dungeon não encontrada.");
        return;
    }

    string msg = "=== " + d.name + " ===\n\n";
    msg += d.description + "\n\n";
    msg += "Nivel requerido: " + d.required_level + "\n";
    msg += "Jogadores: " + d.min_players + "-" + d.max_players + "\n";
    msg += "Dificuldade: ";

    switch (d.difficulty) {
        case DIFFICULTY_NORMAL: msg += "Normal\n"; break;
        case DIFFICULTY_HARD: msg += "Dificil\n"; break;
        case DIFFICULTY_HEROIC: msg += "Heroico\n"; break;
    }

    msg += "Tempo limite: " + d.time_limit_minutes + " minutos\n";
    msg += "Entradas diarias: " + d.daily_entry_limit + "\n\n";

    msg += "RECOMPENSAS:\n";
    msg += "Gold: " + d.get_gold_reward() + "\n";
    msg += "XP: " + d.get_xp_reward() + "\n";

    loot_premio@[] premios_conclusao = dungeon_loot_carregar(d.id, LOOT_ORIGEM_CONCLUSAO);
    if (premios_conclusao.length() > 0) {
        msg += "\nItens da conclusao:\n";
        msg += loot_descrever_premios(premios_conclusao);
    }

    msg += "\nWaves: " + d.waves.length() + "\n";

    if (d.final_boss !is null) {
        msg += "\nBOSS FINAL:\n";
        msg += d.final_boss.boss_name + " (Nivel " + d.final_boss.boss_level + ")\n";
        msg += "HP: " + d.final_boss.boss_hp + "\n";

        loot_premio@[] premios_chefe = dungeon_loot_carregar(d.id, LOOT_ORIGEM_CHEFE);
        if (premios_chefe.length() > 0) {
            msg += "Loot do boss:\n";
            msg += loot_descrever_premios(premios_chefe);
        }
    }

    dungeon_send_to_player(client_index, msg);
}

void cmd_createdungeon(int client_index, string[] args) {
    if (args.length() < 1) {
        dungeon_send_to_player(client_index, "Use: /createdungeon <id>");
        return;
    }
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) return;

    int id = string_to_number(args[0]);
    dungeon_definition@ template = get_dungeon_template(id);

    if (template is null) {
        dungeon_send_to_player(client_index, "Dungeon não encontrada.");
        return;
    }

    player@ p = players[client_index];
    if(p.level < template.required_level) {
        dungeon_send_to_player(client_index, "Nivel insuficiente. Requer nivel " + template.required_level + ".");
        return;
    }

    dungeon_instance@ existing = get_player_instance(p.charname);
    if(existing !is null) {
        dungeon_send_to_player(client_index, "Você ja esta em uma instancia de dungeon.");
        return;
    }

    dungeon_instance@ instance = dungeon_instance();
    instance.instance_id = next_instance_id++;
    @instance.definition = template;
    instance.difficulty = template.difficulty;
    instance.add_participant(p.charname);

    active_instances.insert_last(instance);

    dungeon_send_to_player(client_index, "Dungeon criada! ID da instancia: " + instance.instance_id);
    dungeon_send_to_player(client_index, "Use /joindungeon " + instance.instance_id + " para convidar outros.");
    dungeon_send_to_player(client_index, "Use /ready quando todos estiverem prontos.");
}

void cmd_joindungeon(int client_index, string[] args) {
    if (args.length() < 1) {
        dungeon_send_to_player(client_index, "Use: /joindungeon <instance_id>");
        return;
    }
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) return;

    int instance_id = string_to_number(args[0]);
    dungeon_instance@ instance = get_instance(instance_id);

    if (instance is null) {
        dungeon_send_to_player(client_index, "Instancia não encontrada.");
        return;
    }

    if (instance.state != INSTANCE_WAITING) {
        dungeon_send_to_player(client_index, "Esta dungeon ja comecou.");
        return;
    }

    player@ p = players[client_index];
    if(p.level < instance.definition.required_level) {
        dungeon_send_to_player(client_index, "Nivel insuficiente para esta dungeon.");
        return;
    }

    if(get_player_instance(p.charname) !is null) {
        dungeon_send_to_player(client_index, "Você ja esta em uma instancia de dungeon.");
        return;
    }

    if (instance.add_participant(p.charname)) {
        instance.broadcast(p.charname + " entrou na dungeon!");
        dungeon_send_to_player(client_index, "Você entrou na dungeon. Use /ready quando estiver pronto.");
    } else {
        dungeon_send_to_player(client_index, "Não foi possível entrar (dungeon cheia ou ja participante).");
    }
}

void cmd_ready(int client_index, string[] args) {
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) return;
    string player_name = players[client_index].charname;
    dungeon_instance@ instance = get_player_instance(player_name);

    if (instance is null) {
        dungeon_send_to_player(client_index, "Você não esta em nenhuma dungeon.");
        return;
    }

    for (uint i = 0; i < instance.participants.length(); i++) {
        if (instance.participants[i].player_name == player_name) {
            instance.participants[i].is_ready = true;
            instance.broadcast(player_name + " esta pronto!");
            break;
        }
    }

    if (instance.all_ready()) {
        instance.start();
    }
}

void cmd_leavedungeon(int client_index, string[] args) {
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) return;
    string player_name = players[client_index].charname;
    dungeon_instance@ instance = get_player_instance(player_name);

    if (instance is null) {
        dungeon_send_to_player(client_index, "Você não esta em nenhuma dungeon.");
        return;
    }

    instance.remove_participant(player_name);
    dungeon_send_to_player(client_index, "Você saiu da dungeon.");
    instance.broadcast(player_name + " saiu da dungeon.");

    if(instance.participants.length() == 0) {
        instance.state = INSTANCE_EXPIRED;
    }
}

dungeon_instance@ get_instance(int instance_id) {
    for (uint i = 0; i < active_instances.length(); i++) {
        if (active_instances[i].instance_id == instance_id) {
            return active_instances[i];
        }
    }
    return null;
}

void dungeons_loop() {
    for (int i = int(active_instances.length()) - 1; i >= 0; i--) {
        dungeon_instance@ inst = active_instances[i];

        inst.check_timeout();

        if (inst.state == INSTANCE_ACTIVE) {
            if (!inst.algum_participante_online()) {
                inst.fail("Nenhum participante presente.");
            } else {
                inst.atualizar_ondas();
            }
        }

        if (inst.state == INSTANCE_COMPLETED || inst.state == INSTANCE_FAILED || inst.state == INSTANCE_EXPIRED) {
            if (!inst.monstros_limpos) {
                inst.monstros_limpos = true;
                dungeon_limpar_monstros(inst.instance_id);
            }

            if (inst.state == INSTANCE_EXPIRED || inst.start_time.elapsed >= 5 * 60 * 1000) {
                active_instances.remove_at(i);
            }
        }
    }

}

