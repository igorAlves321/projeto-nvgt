// ========================================
// SISTEMA DE DUNGEONS - FASE 5
// ========================================
// Sistema completo de dungeons instanciadas com
// requisitos de party, nÃ­veis de dificuldade, ondas,
// bosses finais e limite diÃ¡rio

#include "globals.nvgt"

// ========================================
// ENUMS
// ========================================

enum dungeon_difficulty {
    DIFFICULTY_NORMAL,    // Solo ou 2-3 jogadores
    DIFFICULTY_HARD,      // 3-4 jogadores recomendado
    DIFFICULTY_HEROIC     // 5 jogadores recomendado
}

enum dungeon_instance_state {
    INSTANCE_WAITING,     // Aguardando jogadores
    INSTANCE_ACTIVE,      // Em progresso
    INSTANCE_COMPLETED,   // Completada
    INSTANCE_FAILED,      // Falhou
    INSTANCE_EXPIRED      // Tempo esgotado
}

// ========================================
// CLASSES
// ========================================

class dungeon_wave {
    int wave_number;
    string[] enemies;        // Tipos de inimigos
    int[] enemy_counts;      // Quantidade de cada tipo
    int[] enemy_levels;      // NÃ­vel de cada tipo
    int delay_seconds;       // Delay antes desta wave
    string special_event;    // Evento especial (opcional)
    
    dungeon_wave() {
        wave_number = 1;
        delay_seconds = 5;
    }
}

class dungeon_boss_encounter {
    string boss_name;
    int boss_level;
    int boss_hp;
    int boss_damage;
    string[] abilities;
    dictionary loot;         // item_name -> drop_chance
    int guaranteed_gold;
    int guaranteed_xp;
    
    dungeon_boss_encounter() {
        boss_level = 1;
        boss_hp = 10000;
        boss_damage = 100;
        guaranteed_gold = 1000;
        guaranteed_xp = 5000;
    }
}

class dungeon_checkpoint {
    int wave_number;         // Wave onde ocorre o checkpoint
    float x, y, z;          // PosiÃ§Ã£o do checkpoint
    bool activated;
    
    dungeon_checkpoint() {
        wave_number = 0;
        activated = false;
    }
}

class dungeon_definition {
    int id;
    string name;
    string description;
    int required_level;
    int min_players;
    int max_players;
    dungeon_difficulty difficulty;
    int time_limit_minutes;
    int daily_entry_limit;
    
    // Recompensas por dificuldade
    int base_gold_reward;
    int base_xp_reward;
    dictionary completion_items;  // item_name -> quantity
    
    // Ondas
    dungeon_wave@[] waves;
    
    // Boss final
    dungeon_boss_encounter@ final_boss;
    
    // Checkpoints
    dungeon_checkpoint@[] checkpoints;
    
    dungeon_definition() {
        id = 0;
        required_level = 1;
        min_players = 1;
        max_players = 5;
        difficulty = DIFFICULTY_NORMAL;
        time_limit_minutes = 30;
        daily_entry_limit = 3;
        base_gold_reward = 500;
        base_xp_reward = 1000;
    }
    
    // Calcula recompensas baseado em dificuldade
    int get_gold_reward() {
        float multiplier = 1.0;
        switch (difficulty) {
            case DIFFICULTY_HARD: multiplier = 1.5; break;
            case DIFFICULTY_HEROIC: multiplier = 2.0; break;
        }
        return int(base_gold_reward * multiplier);
    }
    
    int get_xp_reward() {
        float multiplier = 1.0;
        switch (difficulty) {
            case DIFFICULTY_HARD: multiplier = 1.5; break;
            case DIFFICULTY_HEROIC: multiplier = 2.0; break;
        }
        return int(base_xp_reward * multiplier);
    }
}

class dungeon_participant {
    string player_name;
    int damage_dealt;
    int healing_done;
    int deaths;
    bool is_ready;
    
    dungeon_participant(string name) {
        player_name = name;
        damage_dealt = 0;
        healing_done = 0;
        deaths = 0;
        is_ready = false;
    }
}

class dungeon_instance {
    int instance_id;
    dungeon_definition@ definition;
    dungeon_instance_state state;
    dungeon_difficulty difficulty;
    
    // Participantes
    dungeon_participant@[] participants;
    string party_leader;
    
    // Progresso
    int current_wave;
    int enemies_remaining;
    int total_enemies_killed;
    timer start_time;
    timer wave_timer;
    dungeon_checkpoint@ last_checkpoint;
    
    // EstatÃ­sticas
    int completion_time_seconds;
    bool bonus_objective_completed;
    
    dungeon_instance() {
        instance_id = 0;
        state = INSTANCE_WAITING;
        difficulty = DIFFICULTY_NORMAL;
        current_wave = 0;
        enemies_remaining = 0;
        total_enemies_killed = 0;
        completion_time_seconds = 0;
        bonus_objective_completed = false;
    }
    
    // Adiciona participante
    bool add_participant(string player_name) {
        // Verifica limite de jogadores
        if (int(participants.length()) >= definition.max_players) {
            return false;
        }
        
        // Verifica se jÃ¡ existe
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                return false;
            }
        }
        
        dungeon_participant@ dp = dungeon_participant(player_name);
        participants.insert_last(dp);
        
        // Primeiro jogador Ã© o lÃ­der
        if (participants.length() == 1) {
            party_leader = player_name;
        }
        
        return true;
    }
    
    // Remove participante
    void remove_participant(string player_name) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                participants.remove_at(i);
                break;
            }
        }
        
        // Se lÃ­der saiu, escolhe novo
        if (party_leader == player_name && participants.length() > 0) {
            party_leader = participants[0].player_name;
            broadcast("Novo lÃ­der: " + party_leader);
        }
    }
    
    // Verifica se todos estÃ£o prontos
    bool all_ready() {
        if (participants.length() < uint(definition.min_players)) {
            return false;
        }
        
        for (uint i = 0; i < participants.length(); i++) {
            if (!participants[i].is_ready) {
                return false;
            }
        }
        return true;
    }
    
    // Inicia a dungeon
    void start() {
        state = INSTANCE_ACTIVE;
        current_wave = 1;
        start_time.restart();
        broadcast("ðŸ° Dungeon iniciada! Prepare-se!");
        start_wave(1);
    }
    
    // Inicia uma wave
    void start_wave(int wave_num) {
        if (wave_num > int(definition.waves.length())) {
            // Todas as waves completas, spawna boss final
            spawn_final_boss();
            return;
        }
        
        current_wave = wave_num;
        dungeon_wave@ wave = definition.waves[wave_num - 1];
        
        broadcast("âš”ï¸ Wave " + wave_num + " de " + definition.waves.length() + "!");
        
        // Conta inimigos totais
        enemies_remaining = 0;
        for (uint i = 0; i < wave.enemy_counts.length(); i++) {
            enemies_remaining += wave.enemy_counts[i];
        }
        
        wave_timer.restart();
        
        // Spawna inimigos
        for (uint i = 0; i < wave.enemies.length(); i++) {
            string enemy_type = wave.enemies[i];
            int count = wave.enemy_counts[i];
            int level = wave.enemy_levels[i];
            
            broadcast("Spawnando " + count + "x " + enemy_type + " (NÃ­vel " + level + ")");
            // Aqui implementaria o spawn real dos inimigos
        }
    }
    
    // Enemy morto
    void enemy_killed(string enemy_type) {
        enemies_remaining--;
        total_enemies_killed++;
        
        // Verifica se wave completa
        if (enemies_remaining <= 0) {
            wave_completed();
        }
    }
    
    // Wave completa
    void wave_completed() {
        broadcast("âœ… Wave " + current_wave + " completa!");
        
        // Verifica checkpoint
        for (uint i = 0; i < definition.checkpoints.length(); i++) {
            if (definition.checkpoints[i].wave_number == current_wave) {
                activate_checkpoint(definition.checkpoints[i]);
                break;
            }
        }
        
        // Aguarda antes da prÃ³xima wave
        if (current_wave < int(definition.waves.length())) {
            broadcast("PrÃ³xima wave em 10 segundos...");
            // Timer para prÃ³xima wave
        } else {
            // Ãšltima wave, spawna boss
            spawn_final_boss();
        }
    }
    
    // Ativa checkpoint
    void activate_checkpoint(dungeon_checkpoint@ cp) {
        cp.activated = true;
        @last_checkpoint = cp;
        broadcast("ðŸ’¾ Checkpoint ativado! Se morrerem, ressurgirÃ£o aqui.");
    }
    
    // Spawna boss final
    void spawn_final_boss() {
        if (definition.final_boss is null) {
            // Sem boss, dungeon completa
            complete();
            return;
        }
        
        broadcast("âš ï¸âš ï¸âš ï¸ BOSS FINAL: " + definition.final_boss.boss_name + " âš ï¸âš ï¸âš ï¸");
        broadcast("NÃ­vel: " + definition.final_boss.boss_level);
        broadcast("HP: " + definition.final_boss.boss_hp);
        
        // Implementaria spawn do boss aqui
    }
    
    // Boss derrotado
    void boss_defeated() {
        broadcast("ðŸŽ‰ Boss derrotado!");
        complete();
    }
    
    // Completa dungeon
    void complete() {
        state = INSTANCE_COMPLETED;
        completion_time_seconds = start_time.elapsed / 1000;
        
        broadcast("ðŸ†ðŸ†ðŸ† DUNGEON COMPLETA! ðŸ†ðŸ†ðŸ†");
        broadcast("Tempo: " + (completion_time_seconds / 60) + "m " + (completion_time_seconds % 60) + "s");
        
        // Distribui recompensas
        distribute_rewards();
    }
    
    // Falha na dungeon
    void fail(string reason) {
        state = INSTANCE_FAILED;
        broadcast("ðŸ’€ DUNGEON FALHOU: " + reason);
    }
    
    // Distribui recompensas
    void distribute_rewards() {
        int gold = definition.get_gold_reward();
        int xp = definition.get_xp_reward();
        
        // BÃ´nus por tempo
        if (completion_time_seconds < definition.time_limit_minutes * 60 / 2) {
            gold = int(gold * 1.5);
            xp = int(xp * 1.5);
            broadcast("âš¡ BÃ´nus de velocidade! +50% recompensas!");
        }
        
        for (uint i = 0; i < participants.length(); i++) {
            int pidx = get_player_index_from(participants[i].player_name);
            if (pidx < 0) continue;

            players[pidx].gold += gold;
            players[pidx].saldo = players[pidx].gold;
            ganhaxp(pidx, xp, 0);

            string msg = "=== RECOMPENSAS ===\n";
            msg += "Gold: " + gold + "\n";
            msg += "XP: " + xp + "\n";
            
            // Itens de conclusÃ£o
            string[] items = definition.completion_items.get_keys();
            if (items.length() > 0) {
                msg += "\nITENS:\n";
                for (uint j = 0; j < items.length(); j++) {
                    int qty;
                    definition.completion_items.get(items[j], qty);
                    msg += "- " + items[j] + " x" + qty + "\n";
                    if(qty > 0) add_item_with_sync(players[pidx], items[j], qty);
                }
            }
            
            // Loot do boss
            if (definition.final_boss !is null) {
                msg += "\nLOOT DO BOSS:\n";
                msg += "Gold: " + definition.final_boss.guaranteed_gold + "\n";
                msg += "XP: " + definition.final_boss.guaranteed_xp + "\n";
                
                string[] boss_items = definition.final_boss.loot.get_keys();
                for (uint j = 0; j < boss_items.length(); j++) {
                    float chance;
                    definition.final_boss.loot.get(boss_items[j], chance);
                    
                    float roll = random(0, 100) / 100.0;
                    if (roll <= chance) {
                        msg += "- " + boss_items[j] + " (DROPPED!)\n";
                    }
                }
            }
            
            dungeon_send_to_player(pidx, msg);
        }
    }
    
    // Broadcast para participantes
    void broadcast(string message) {
        for (uint i = 0; i < participants.length(); i++) {
            dungeon_send_to_player_name(participants[i].player_name, message);
        }
    }
    
    // Verifica timeout
    bool check_timeout() {
        if (state != INSTANCE_ACTIVE) return false;
        
        if (start_time.elapsed >= definition.time_limit_minutes * 60 * 1000) {
            fail("Tempo esgotado!");
            return true;
        }
        return false;
    }
}

// ========================================
// SISTEMA GLOBAL DE DUNGEONS
// ========================================

dungeon_definition@[] dungeon_templates;
dictionary dungeon_by_id;

dungeon_instance@[] active_instances;
int next_instance_id = 1;

// Tracking diÃ¡rio de entradas por jogador
dictionary player_daily_entries;  // player_name -> { dungeon_id -> entry_count }

// Inicializa sistema de dungeons
void init_dungeons_system() {
    dungeon_templates.resize(0);
    dungeon_by_id.delete_all();
    active_instances.resize(0);
    player_daily_entries.delete_all();
    
    create_default_dungeons();
    load_dungeons_data();
}

