
#include "globals.nvgt"

enum dungeon_difficulty {
    DIFFICULTY_NORMAL,
    DIFFICULTY_HARD,
    DIFFICULTY_HEROIC
}

enum dungeon_instance_state {
    INSTANCE_WAITING,
    INSTANCE_ACTIVE,
    INSTANCE_COMPLETED,
    INSTANCE_FAILED,
    INSTANCE_EXPIRED
}

class dungeon_wave {
    int wave_number;
    string[] enemies;
    int[] enemy_counts;
    int[] enemy_levels;
    int delay_seconds;
    string special_event;

    dungeon_wave() {
        wave_number = 1;
        delay_seconds = 5;
    }
}

class dungeon_boss_encounter {
    string boss_name;
    int boss_level;
    int boss_hp;
    int boss_damage;
    string[] abilities;
    dictionary loot;
    int guaranteed_gold;
    int guaranteed_xp;

    dungeon_boss_encounter() {
        boss_level = 1;
        boss_hp = 10000;
        boss_damage = 100;
        guaranteed_gold = 1000;
        guaranteed_xp = 5000;
    }
}

class dungeon_checkpoint {
    int wave_number;
    float x, y, z;
    bool activated;

    dungeon_checkpoint() {
        wave_number = 0;
        activated = false;
    }
}

class dungeon_definition {
    int id;
    string name;
    string description;
    int required_level;
    int min_players;
    int max_players;
    dungeon_difficulty difficulty;
    int time_limit_minutes;
    int daily_entry_limit;

    int base_gold_reward;
    int base_xp_reward;
    dictionary completion_items;

    dungeon_wave@[] waves;

    dungeon_boss_encounter@ final_boss;

    dungeon_checkpoint@[] checkpoints;

    dungeon_definition() {
        id = 0;
        required_level = 1;
        min_players = 1;
        max_players = 5;
        difficulty = DIFFICULTY_NORMAL;
        time_limit_minutes = 30;
        daily_entry_limit = 3;
        base_gold_reward = 500;
        base_xp_reward = 1000;
    }

    int get_gold_reward() {
        float multiplier = 1.0;
        switch (difficulty) {
            case DIFFICULTY_HARD: multiplier = 1.5; break;
            case DIFFICULTY_HEROIC: multiplier = 2.0; break;
        }
        return int(base_gold_reward * multiplier);
    }

    int get_xp_reward() {
        float multiplier = 1.0;
        switch (difficulty) {
            case DIFFICULTY_HARD: multiplier = 1.5; break;
            case DIFFICULTY_HEROIC: multiplier = 2.0; break;
        }
        return int(base_xp_reward * multiplier);
    }
}

class dungeon_participant {
    string player_name;
    int damage_dealt;
    int healing_done;
    int deaths;
    bool is_ready;

    dungeon_participant(string name) {
        player_name = name;
        damage_dealt = 0;
        healing_done = 0;
        deaths = 0;
        is_ready = false;
    }
}

class dungeon_instance {
    int instance_id;
    dungeon_definition@ definition;
    dungeon_instance_state state;
    dungeon_difficulty difficulty;

    dungeon_participant@[] participants;
    string party_leader;

    int current_wave;
    int enemies_remaining;
    int total_enemies_killed;
    timer start_time;
    timer wave_timer;
    dungeon_checkpoint@ last_checkpoint;

    int completion_time_seconds;
    bool bonus_objective_completed;

    dungeon_instance() {
        instance_id = 0;
        state = INSTANCE_WAITING;
        difficulty = DIFFICULTY_NORMAL;
        current_wave = 0;
        enemies_remaining = 0;
        total_enemies_killed = 0;
        completion_time_seconds = 0;
        bonus_objective_completed = false;
    }

    bool add_participant(string player_name) {
        if (int(participants.length()) >= definition.max_players) {
            return false;
        }

        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                return false;
            }
        }

        dungeon_participant@ dp = dungeon_participant(player_name);
        participants.insert_last(dp);

        if (participants.length() == 1) {
            party_leader = player_name;
        }

        return true;
    }

    void remove_participant(string player_name) {
        for (uint i = 0; i < participants.length(); i++) {
            if (participants[i].player_name == player_name) {
                participants.remove_at(i);
                break;
            }
        }

        if (party_leader == player_name && participants.length() > 0) {
            party_leader = participants[0].player_name;
            broadcast("Novo lider: " + party_leader);
        }
    }

    bool all_ready() {
        if (participants.length() < uint(definition.min_players)) {
            return false;
        }

        for (uint i = 0; i < participants.length(); i++) {
            if (!participants[i].is_ready) {
                return false;
            }
        }
        return true;
    }

    void start() {
        state = INSTANCE_ACTIVE;
        current_wave = 1;
        start_time.restart();
        broadcast("Dungeon iniciada! Prepare-se!");
        start_wave(1);
    }

    void start_wave(int wave_num) {
        if (wave_num > int(definition.waves.length())) {
            spawn_final_boss();
            return;
        }

        current_wave = wave_num;
        dungeon_wave@ wave = definition.waves[wave_num - 1];

        broadcast("Wave " + wave_num + " de " + definition.waves.length() + "!");

        enemies_remaining = 0;
        for (uint i = 0; i < wave.enemy_counts.length(); i++) {
            enemies_remaining += wave.enemy_counts[i];
        }

        wave_timer.restart();

        for (uint i = 0; i < wave.enemies.length(); i++) {
            string enemy_type = wave.enemies[i];
            int count = wave.enemy_counts[i];
            int level = wave.enemy_levels[i];

            broadcast("Spawnando " + count + "x " + enemy_type + " (Nivel " + level + ")");
        }
    }

    void enemy_killed(string enemy_type) {
        enemies_remaining--;
        total_enemies_killed++;

        if (enemies_remaining <= 0) {
            wave_completed();
        }
    }

    void wave_completed() {
        broadcast("[OK] Wave " + current_wave + " completa!");

        for (uint i = 0; i < definition.checkpoints.length(); i++) {
            if (definition.checkpoints[i].wave_number == current_wave) {
                activate_checkpoint(definition.checkpoints[i]);
                break;
            }
        }

        if (current_wave < int(definition.waves.length())) {
            broadcast("Proxima wave em 10 segundos...");
        } else {
            spawn_final_boss();
        }
    }

    void activate_checkpoint(dungeon_checkpoint@ cp) {
        cp.activated = true;
        @last_checkpoint = cp;
        broadcast("Checkpoint ativado! Se morrerem, ressurgirao aqui.");
    }

    void spawn_final_boss() {
        if (definition.final_boss is null) {
            complete();
            return;
        }

        broadcast("BOSS FINAL: " + definition.final_boss.boss_name);
        broadcast("Nivel: " + definition.final_boss.boss_level);
        broadcast("HP: " + definition.final_boss.boss_hp);

    }

    void boss_defeated() {
        broadcast("Boss derrotado!");
        complete();
    }

    void complete() {
        state = INSTANCE_COMPLETED;
        completion_time_seconds = start_time.elapsed / 1000;

        broadcast("DUNGEON COMPLETA!");
        broadcast("Tempo: " + (completion_time_seconds / 60) + "m " + (completion_time_seconds % 60) + "s");

        distribute_rewards();
    }

    void fail(string reason) {
        state = INSTANCE_FAILED;
        broadcast("DUNGEON FALHOU: " + reason);
    }

    void distribute_rewards() {
        int gold = definition.get_gold_reward();
        int xp = definition.get_xp_reward();

        if (completion_time_seconds < definition.time_limit_minutes * 60 / 2) {
            gold = int(gold * 1.5);
            xp = int(xp * 1.5);
            broadcast("Bonus de velocidade! +50% recompensas!");
        }

        for (uint i = 0; i < participants.length(); i++) {
            int pidx = get_player_index_from(participants[i].player_name);
            if (pidx < 0) continue;

            players[pidx].gold += gold;
            players[pidx].saldo = players[pidx].gold;
            ganhaxp(pidx, xp, 0);

            string msg = "=== RECOMPENSAS ===\n";
            msg += "Gold: " + gold + "\n";
            msg += "XP: " + xp + "\n";

            string[] items = definition.completion_items.get_keys();
            if (items.length() > 0) {
                msg += "\nITENS:\n";
                for (uint j = 0; j < items.length(); j++) {
                    int qty;
                    definition.completion_items.get(items[j], qty);
                    msg += "- " + items[j] + " x" + qty + "\n";
                    if(qty > 0) add_item_with_sync(players[pidx], items[j], qty);
                }
            }

            if (definition.final_boss !is null) {
                msg += "\nLOOT DO BOSS:\n";
                msg += "Gold: " + definition.final_boss.guaranteed_gold + "\n";
                msg += "XP: " + definition.final_boss.guaranteed_xp + "\n";

                string[] boss_items = definition.final_boss.loot.get_keys();
                for (uint j = 0; j < boss_items.length(); j++) {
                    float chance;
                    definition.final_boss.loot.get(boss_items[j], chance);

                    float roll = random(0, 100) / 100.0;
                    if (roll <= chance) {
                        msg += "- " + boss_items[j] + " (DROPPED!)\n";
                    }
                }
            }

            dungeon_send_to_player(pidx, msg);
        }
    }

    void broadcast(string message) {
        for (uint i = 0; i < participants.length(); i++) {
            dungeon_send_to_player_name(participants[i].player_name, message);
        }
    }

    bool check_timeout() {
        if (state != INSTANCE_ACTIVE) return false;

        if (start_time.elapsed >= definition.time_limit_minutes * 60 * 1000) {
            fail("Tempo esgotado!");
            return true;
        }
        return false;
    }
}

dungeon_definition@[] dungeon_templates;
dictionary dungeon_by_id;

dungeon_instance@[] active_instances;
int next_instance_id = 1;

dictionary player_daily_entries;

void init_dungeons_system() {
    dungeon_templates.resize(0);
    dungeon_by_id.delete_all();
    active_instances.resize(0);
    player_daily_entries.delete_all();

    create_default_dungeons();
    load_dungeons_data();
}

void create_default_dungeons() {
    {
        dungeon_definition@ d = dungeon_definition();
        d.id = 1;
        d.name = "Caverna dos Goblins";
        d.description = "Uma caverna infestada de goblins agressivos.";
        d.required_level = 5;
        d.min_players = 1;
        d.max_players = 3;
        d.difficulty = DIFFICULTY_NORMAL;
        d.time_limit_minutes = 20;
        d.daily_entry_limit = 5;
        d.base_gold_reward = 500;
        d.base_xp_reward = 1000;

        dungeon_wave@ w1 = dungeon_wave();
        w1.wave_number = 1;
        w1.enemies = {"Goblin Guerreiro"};
        w1.enemy_counts = {5};
        w1.enemy_levels = {5};
        w1.delay_seconds = 5;
        d.waves.insert_last(w1);

        dungeon_wave@ w2 = dungeon_wave();
        w2.wave_number = 2;
        w2.enemies = {"Goblin Guerreiro", "Goblin Arqueiro"};
        w2.enemy_counts = {4, 3};
        w2.enemy_levels = {5, 6};
        w2.delay_seconds = 10;
        d.waves.insert_last(w2);

        dungeon_wave@ w3 = dungeon_wave();
        w3.wave_number = 3;
        w3.enemies = {"Goblin Xama"};
        w3.enemy_counts = {2};
        w3.enemy_levels = {7};
        w3.delay_seconds = 10;
        d.waves.insert_last(w3);

        dungeon_boss_encounter@ boss = dungeon_boss_encounter();
        boss.boss_name = "Chefe Goblin";
        boss.boss_level = 8;
        boss.boss_hp = 5000;
        boss.boss_damage = 80;
        boss.abilities = {"Grito de Guerra", "Invocar Goblins"};
        boss.guaranteed_gold = 300;
        boss.guaranteed_xp = 800;
        boss.loot.set("Espada Goblin", 0.3);
        boss.loot.set("Armadura de Couro Reforcado", 0.15);
        @d.final_boss = boss;

        dungeon_checkpoint@ cp = dungeon_checkpoint();
        cp.wave_number = 2;
        d.checkpoints.insert_last(cp);

        d.completion_items.set("Pocao de Vida", 3);

        add_dungeon(d);
    }

    {
        dungeon_definition@ d = dungeon_definition();
        d.id = 2;
        d.name = "Fortaleza dos Mortos-Vivos";
        d.description = "Uma fortaleza amaldicoada repleta de mortos-vivos.";
        d.required_level = 12;
        d.min_players = 3;
        d.max_players = 5;
        d.difficulty = DIFFICULTY_HARD;
        d.time_limit_minutes = 30;
        d.daily_entry_limit = 3;
        d.base_gold_reward = 1500;
        d.base_xp_reward = 3000;

        for (int i = 1; i <= 5; i++) {
            dungeon_wave@ w = dungeon_wave();
            w.wave_number = i;
            w.enemies = {"Esqueleto Guerreiro", "Zumbi"};
            w.enemy_counts = {3 + i, 2 + i};
            w.enemy_levels = {12 + i, 11 + i};
            w.delay_seconds = 15;
            d.waves.insert_last(w);
        }

        dungeon_boss_encounter@ boss = dungeon_boss_encounter();
        boss.boss_name = "Lich Anciao";
        boss.boss_level = 15;
        boss.boss_hp = 15000;
        boss.boss_damage = 200;
        boss.abilities = {"Explosao Sombria", "Drenar Vida", "Invocar Esqueletos"};
        boss.guaranteed_gold = 1000;
        boss.guaranteed_xp = 2500;
        boss.loot.set("Cajado do Lich", 0.2);
        boss.loot.set("Orbe das Sombras", 0.15);
        boss.loot.set("Manto Espectral", 0.25);
        @d.final_boss = boss;

        dungeon_checkpoint@ cp1 = dungeon_checkpoint();
        cp1.wave_number = 3;
        d.checkpoints.insert_last(cp1);

        d.completion_items.set("Pocao de Vida Superior", 5);
        d.completion_items.set("Pocao de Mana", 5);

        add_dungeon(d);
