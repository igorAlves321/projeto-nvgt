        d.completion_items.set("Pocao de Vida Suprema", 10);
        d.completion_items.set("Pocao de Mana Suprema", 10);
        d.completion_items.set("Fragmento de Fogo", 1);

        add_dungeon(d);
    }
}

void add_dungeon(dungeon_definition@ d) {
    dungeon_templates.insert_last(d);
    dungeon_by_id.set("" + d.id, @d);
}

dungeon_definition@ get_dungeon_template(int id) {
    dungeon_definition@ d;
    if (dungeon_by_id.get("" + id, @d)) {
        return d;
    }
    return null;
}

void dungeon_send_to_player(int client_index, const string&in message) {
    if(client_index < 0 || client_index >= int(players.length())) return;
    if(players[client_index] is null) return;
    string m = message.replace("\n", "; ");
    send_reliable_text(players[client_index].peer_id, "msg2 ;" + m + ";", 0);
}

void dungeon_send_to_player_name(const string&in player_name, const string&in message) {
    int idx = get_player_index_from(player_name);
    if(idx < 0) return;
    dungeon_send_to_player(idx, message);
}

dungeon_instance@ get_player_instance(const string&in player_name) {
    for(uint i = 0; i < active_instances.length(); i++) {
        dungeon_instance@ inst = active_instances[i];
        if(inst is null) continue;
        for(uint j = 0; j < inst.participants.length(); j++) {
            if(inst.participants[j].player_name == player_name) return inst;
        }
    }
    return null;
}

void cmd_dungeons(int client_index, string[] args) {
    string msg = "=== DUNGEONS DISPONIVEIS ===\n\n";

    for (uint i = 0; i < dungeon_templates.length(); i++) {
        dungeon_definition@ d = dungeon_templates[i];

        msg += "[" + d.id + "] " + d.name + "\n";
        msg += "Nivel: " + d.required_level + " | ";

        switch (d.difficulty) {
            case DIFFICULTY_NORMAL: msg += "Normal"; break;
            case DIFFICULTY_HARD: msg += "Dificil"; break;
            case DIFFICULTY_HEROIC: msg += "Heroico"; break;
        }

        msg += "\n";
        msg += "Jogadores: " + d.min_players + "-" + d.max_players + "\n";
        msg += "Tempo limite: " + d.time_limit_minutes + " minutos\n";
        msg += "Entradas diarias: " + d.daily_entry_limit + "\n";
        msg += "---\n";
    }

    msg += "\nUse /dungeoninfo <id> para detalhes.";
    dungeon_send_to_player(client_index, msg);
}

void cmd_dungeoninfo(int client_index, string[] args) {
    if (args.length() < 1) {
        dungeon_send_to_player(client_index, "Use: /dungeoninfo <id>");
        return;
    }

    int id = string_to_number(args[0]);
    dungeon_definition@ d = get_dungeon_template(id);

    if (d is null) {
        dungeon_send_to_player(client_index, "Dungeon não encontrada.");
        return;
    }

    string msg = "=== " + d.name + " ===\n\n";
    msg += d.description + "\n\n";
    msg += "Nivel requerido: " + d.required_level + "\n";
    msg += "Jogadores: " + d.min_players + "-" + d.max_players + "\n";
    msg += "Dificuldade: ";

    switch (d.difficulty) {
        case DIFFICULTY_NORMAL: msg += "Normal\n"; break;
        case DIFFICULTY_HARD: msg += "Dificil\n"; break;
        case DIFFICULTY_HEROIC: msg += "Heroico\n"; break;
    }

    msg += "Tempo limite: " + d.time_limit_minutes + " minutos\n";
    msg += "Entradas diarias: " + d.daily_entry_limit + "\n\n";

    msg += "RECOMPENSAS:\n";
    msg += "Gold: " + d.get_gold_reward() + "\n";
    msg += "XP: " + d.get_xp_reward() + "\n";

    if (d.completion_items.get_keys().length() > 0) {
        msg += "\nItens garantidos:\n";
        string[] items = d.completion_items.get_keys();
        for (uint i = 0; i < items.length(); i++) {
            int qty;
            d.completion_items.get(items[i], qty);
            msg += "- " + items[i] + " x" + qty + "\n";
        }
    }

    msg += "\nWaves: " + d.waves.length() + "\n";

    if (d.final_boss !is null) {
        msg += "\nBOSS FINAL:\n";
        msg += d.final_boss.boss_name + " (Nivel " + d.final_boss.boss_level + ")\n";
        msg += "HP: " + d.final_boss.boss_hp + "\n";
    }

    dungeon_send_to_player(client_index, msg);
}

void cmd_createdungeon(int client_index, string[] args) {
    if (args.length() < 1) {
        dungeon_send_to_player(client_index, "Use: /createdungeon <id>");
        return;
    }
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) return;

    int id = string_to_number(args[0]);
    dungeon_definition@ template = get_dungeon_template(id);

    if (template is null) {
        dungeon_send_to_player(client_index, "Dungeon não encontrada.");
        return;
    }

    player@ p = players[client_index];
    if(p.level < template.required_level) {
        dungeon_send_to_player(client_index, "Nivel insuficiente. Requer nivel " + template.required_level + ".");
        return;
    }

    dungeon_instance@ existing = get_player_instance(p.charname);
    if(existing !is null) {
        dungeon_send_to_player(client_index, "Você ja esta em uma instancia de dungeon.");
        return;
    }

    dungeon_instance@ instance = dungeon_instance();
    instance.instance_id = next_instance_id++;
    @instance.definition = template;
    instance.difficulty = template.difficulty;
    instance.add_participant(p.charname);

    active_instances.insert_last(instance);

    dungeon_send_to_player(client_index, "Dungeon criada! ID da instancia: " + instance.instance_id);
    dungeon_send_to_player(client_index, "Use /joindungeon " + instance.instance_id + " para convidar outros.");
    dungeon_send_to_player(client_index, "Use /ready quando todos estiverem prontos.");
}

void cmd_joindungeon(int client_index, string[] args) {
    if (args.length() < 1) {
        dungeon_send_to_player(client_index, "Use: /joindungeon <instance_id>");
        return;
    }
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) return;

    int instance_id = string_to_number(args[0]);
    dungeon_instance@ instance = get_instance(instance_id);

    if (instance is null) {
        dungeon_send_to_player(client_index, "Instancia não encontrada.");
        return;
    }

    if (instance.state != INSTANCE_WAITING) {
        dungeon_send_to_player(client_index, "Esta dungeon ja comecou.");
        return;
    }

    player@ p = players[client_index];
    if(p.level < instance.definition.required_level) {
        dungeon_send_to_player(client_index, "Nivel insuficiente para esta dungeon.");
        return;
    }

    if(get_player_instance(p.charname) !is null) {
        dungeon_send_to_player(client_index, "Você ja esta em uma instancia de dungeon.");
        return;
    }

    if (instance.add_participant(p.charname)) {
        instance.broadcast(p.charname + " entrou na dungeon!");
        dungeon_send_to_player(client_index, "Você entrou na dungeon. Use /ready quando estiver pronto.");
    } else {
        dungeon_send_to_player(client_index, "Não foi possível entrar (dungeon cheia ou ja participante).");
    }
}

void cmd_ready(int client_index, string[] args) {
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) return;
    string player_name = players[client_index].charname;
    dungeon_instance@ instance = get_player_instance(player_name);

    if (instance is null) {
        dungeon_send_to_player(client_index, "Você não esta em nenhuma dungeon.");
        return;
    }

    for (uint i = 0; i < instance.participants.length(); i++) {
        if (instance.participants[i].player_name == player_name) {
            instance.participants[i].is_ready = true;
            instance.broadcast(player_name + " esta pronto!");
            break;
        }
    }

    if (instance.all_ready()) {
        instance.start();
    }
}

void cmd_leavedungeon(int client_index, string[] args) {
    if (client_index < 0 || client_index >= int(players.length()) || players[client_index] is null) return;
    string player_name = players[client_index].charname;
    dungeon_instance@ instance = get_player_instance(player_name);

    if (instance is null) {
        dungeon_send_to_player(client_index, "Você não esta em nenhuma dungeon.");
        return;
    }

    instance.remove_participant(player_name);
    dungeon_send_to_player(client_index, "Você saiu da dungeon.");
    instance.broadcast(player_name + " saiu da dungeon.");

    if(instance.participants.length() == 0) {
        instance.state = INSTANCE_EXPIRED;
    }
}

dungeon_instance@ get_instance(int instance_id) {
    for (uint i = 0; i < active_instances.length(); i++) {
        if (active_instances[i].instance_id == instance_id) {
            return active_instances[i];
        }
    }
    return null;
}

void dungeons_loop() {
    for (int i = int(active_instances.length()) - 1; i >= 0; i--) {
        dungeon_instance@ inst = active_instances[i];

        if (inst.check_timeout()) {
            continue;
        }

        if (inst.state == INSTANCE_COMPLETED || inst.state == INSTANCE_FAILED) {
            if (inst.start_time.elapsed >= 5 * 60 * 1000) {
                active_instances.remove_at(i);
            }
        }
    }

}

