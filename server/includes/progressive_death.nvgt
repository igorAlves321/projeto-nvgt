// progressive_death.nvgt - Sistema de Morte Progressiva
// Convertido para NVGT
// Gerencia morte lenta do jogador com causas específicas

// Processar morte progressiva do jogador
void process_progressive_death(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) {
		return;
	}
	
	// Verificar se está em morte progressiva
	if(players[player_index].progressive_death == 0) {
		return;
	}
	
	// Reduzir vida gradualmente
	if(players[player_index].tdeath.elapsed >= players[player_index].death_time) {
		players[player_index].tdeath.restart();
		
		// Perder vida baseado no índice de morte
		double damage_per_tick = players[player_index].death_life;
		players[player_index].health -= damage_per_tick;
		
		// Notificar jogador sobre a condição
		if(players[player_index].health > 0) {
			string msg = "Você está ";
			
			switch(players[player_index].death_index) {
				case 1:
					msg += "sangrando";
					break;
				case 2:
					msg += "envenenado";
					break;
				case 3:
					msg += "queimando internamente";
					break;
				case 4:
					msg += "sufocando";
					break;
				case 5:
					msg += "congelando";
					break;
				default:
					msg += "morrendo lentamente";
					break;
			}
			
			msg += "! Vida restante: " + players[player_index].health;
			
			send_reliable(players[player_index].peer_id, "msg2 " + msg, 0);
		}
		
		// Jogador morreu
		if(players[player_index].health <= 0) {
			players[player_index].health = 0;
			players[player_index].progressive_death = 0;
			
			// Informar causa da morte
			string death_msg = "Você morreu";
			if(players[player_index].death_reason != "") {
				death_msg += " de " + players[player_index].death_reason;
			}
			
			send_reliable(players[player_index].peer_id, "msg2 " + death_msg, 0);
			
			// Processar morte (será chamado externamente)
			// process_player_death(player_index);
		}
	}
}

// Iniciar morte progressiva
void start_progressive_death(int player_index, int death_type, double damage_per_tick, 
	int tick_time_ms = 1000, string reason = "") {
	
	if(player_index < 0 || player_index >= int(players.length())) {
		return;
	}
	
	players[player_index].progressive_death = 1;
	players[player_index].death_index = death_type;
	players[player_index].death_life = damage_per_tick;
	players[player_index].death_time = tick_time_ms;
	players[player_index].death_reason = reason;
	players[player_index].tdeath.restart();
	
	// Mensagem inicial
	string msg = "Você começou a ";
	switch(death_type) {
		case 1:
			msg += "sangrar! Procure ajuda rápido!";
			break;
		case 2:
			msg += "sentir os efeitos do veneno!";
			break;
		case 3:
			msg += "queimar por dentro!";
			break;
		case 4:
			msg += "sufocar!";
			break;
		case 5:
			msg += "congelar!";
			break;
		default:
			msg += "morrer lentamente!";
			break;
	}
	
	send_reliable(players[player_index].peer_id, "msg2 " + msg, 0);
}

// Parar morte progressiva (curado)
void stop_progressive_death(int player_index) {
	if(player_index < 0 || player_index >= int(players.length())) {
		return;
	}
	
	if(players[player_index].progressive_death == 1) {
		players[player_index].progressive_death = 0;
		players[player_index].death_index = -1;
		players[player_index].death_reason = "";
		
		send_reliable(players[player_index].peer_id, 
			"msg2 Você foi curado da condição fatal!", 0);
	}
}

// Loop de morte progressiva (chamar no loop principal)
void progressive_death_loop() {
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].progressive_death == 1) {
			process_progressive_death(i);
		}
	}
}

// Tipos de morte progressiva
const int DEATH_TYPE_BLEEDING = 1;      // Sangrando
const int DEATH_TYPE_POISON = 2;        // Envenenado
const int DEATH_TYPE_BURNING = 3;       // Queimando
const int DEATH_TYPE_SUFFOCATING = 4;   // Sufocando
const int DEATH_TYPE_FREEZING = 5;      // Congelando
