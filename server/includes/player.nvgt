	player(uint id, string name, string pver, string bannable_id) {
		// Inicializar todos os timers
		tcongelar.force(0);
		tcongelar.pause();
		tppeixe.force(0);
		tppeixe.pause();
		tsugando.force(0);
		tsugando.pause();
		tmveloz.force(0);
		tmveloz.pause();
		tmcampo.force(0);
		tmcampo.pause();
		tmchuva.force(0);
		tmchuva.pause();
		tmcampo2.force(0);
		tmcampo2.pause();
		tmeteoro.force(0);
		tmeteoro.pause();
		tmflutuar.force(0);
		tmflutuar.pause();
		tmpulo.force(0);
		tmpulo.pause();
		tmagia.force(0);
		tmagia.pause();
		tminvs.force(0);
		tminvs.pause();
		thack.force(0);
		thack.pause();
		tlutar.force(0);
		tlutar.pause();
		tmaquina.force(0);
		tmaquina.pause();
		tparalisado.force(0);
		tparalisado.pause();
		carregandotaser.force(0);
		carregandotaser.pause();
		tempodentrotrem.force(0);
		tempodentrotrem.pause();
		tempovoandoaviao.force(0);
		teletimer.force(30000);
		casttimer.force(30000);
		omtimer.force(60000);
		// ondatempo.force(60000); // TODO: definir essa variável
		tempofogo.force(500);
		
		peer_id = id;
		charname = name;
		this.name = name; // Alias para charname
		nonomemapa = "temporária_" + name;
		version = pver;
		computer_id = bannable_id;

		// Inicializar campos de compatibilidade com o servidor
		is_logged_in = false;
		is_admin = false;
		level = 1;
		exp = 0;
		gold = 100;
		hp = 100;
		max_hp = 100;
		mp = 50;
		max_mp = 50;
		race = "humano";
		map_name = "test"; // Mudado para test durante desenvolvimento
		x = 0;
		y = 0;
		z = 0;
		
		// 🆕 Inicializar propriedades adicionais
		active = true;
		rank = 0;  // 0=normal, 5=admin
		// inventory já é inicializado automaticamente como dictionary vazio
		last_activity.restart();
		last_move_time.force(0);
		last_move_time.pause();
		last_valid_x = x;
		last_valid_y = y;
		violation_count = 0;
		last_seq = 0;
	}
	
	// NVGT: Método renomeado para evitar conflito com campo is_admin
	bool check_admin() {
		bool is_adm = this.dev || this.admin;
		
		// Atualizar rank automaticamente
		if(is_adm && this.rank < 5) {
			this.rank = 5;  // Admin tem rank 5
		}
		
		return is_adm;
	}

