	player(uint id, string name, string pver, string bannable_id) {
		// Inicializar todos os timers
		tcongelar.force(0);
		tcongelar.pause();
		tppeixe.force(0);
		tppeixe.pause();
		tsugando.force(0);
		tsugando.pause();
		tmveloz.force(0);
		tmveloz.pause();
		tmcampo.force(0);
		tmcampo.pause();
		tmchuva.force(0);
		tmchuva.pause();
		tmcampo2.force(0);
		tmcampo2.pause();
		tmeteoro.force(0);
		tmeteoro.pause();
		tmflutuar.force(0);
		tmflutuar.pause();
		tmpulo.force(0);
		tmpulo.pause();
		tmagia.force(0);
		tmagia.pause();
		tminvs.force(0);
		tminvs.pause();
		thack.force(0);
		thack.pause();
		tlutar.force(0);
		tlutar.pause();
		tmaquina.force(0);
		tmaquina.pause();
		tparalisado.force(0);
		tparalisado.pause();
		carregandotaser.force(0);
		carregandotaser.pause();
		tempodentrotrem.force(0);
		tempodentrotrem.pause();
		tempovoandoaviao.force(0);
		teletimer.force(30000);
		casttimer.force(30000);
		omtimer.force(60000);
		// ondatempo.force(60000); // TODO: definir essa variável
		tempofogo.force(500);
		
		peer_id = id;
		charname = name;
		this.name = name; // Alias para charname
		nonomemapa = "temporária_" + name;
		version = pver;
		computer_id = bannable_id;

		// Inicializar campos de compatibilidade com o servidor
		is_logged_in = false;
		is_admin = false;
		level = 1;
		exp = 0;
		gold = 100;
		hp = 100;
		max_hp = 100;
		mp = 50;
		max_mp = 50;
		race = "humano";
		map_name = "escola";
		x = 0;
		y = 0;
		z = 0;
	}
	
	// NVGT: Método renomeado para evitar conflito com campo is_admin
	bool check_admin() {
		return this.dev || this.admin;
	}

	// Enviar mensagem para o jogador usando networking NVGT
	void send_message(string message) {
		send_reliable(this.peer_id, message);
	}

	// Salvar dados do jogador
	void save_player_data() {
		save_player_to_database(this);
	}
	
	void inv_add_item(string itemname, int itemvalue, bool enviar = true) {
		string content = inv;
		string[] peramitors = content.split("\r\n");
		string[] values;
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos > -1) {
				values.insert_at(i, peramitors[i].substr(eq_pos + 1));
				peramitors[i] = peramitors[i].substr(0, eq_pos);
			}
		}
		
		if (inv_item_exists(itemname)) {
			int orgval;
			int item_index = inv_item(itemname);
			if (item_index > -1) {
				orgval = string_to_number(values[item_index]);
			} else {
				return;
			}
			
			if (orgval + itemvalue < 1) {
				inv_delete_item(itemname);
				if (itemname.find("mm") == -1 && itemname.find("comida") == -1 && itemname != "mina" && itemname != "xp") {
					// net.send_reliable(peer_id, itemvalue + " " + itemname, 4);
				}
			} else {
				values[item_index] = string(orgval + itemvalue);
				string tempinv;
				for (uint i = 0; i < peramitors.length(); i++) {
					tempinv += peramitors[i] + "=" + values[i] + "\r\n";
				}
				inv = tempinv;
			}
		} else {
			if (itemvalue > 0) {
				inv += itemname + "=" + itemvalue + "\r\n";
				if (itemname.find("mm") == -1 && itemname.find("comida") == -1 && itemname != "mina" && itemname != "xp") {
					// net.send_reliable(peer_id, itemvalue + " " + itemname, 4);
				}
			}
		}
		
		if (enviar == true) {
			// net.send_reliable(peer_id, "inv " + inv, 0);
			string[] invsec;
			if (inv_item_number("vara_de_pesca") > 0) invsec.push_back("vara_de_pesca");
			if (inv_item_number("dardo") > 0) invsec.push_back("dardo");
			if (inv_item_number("dardo_envenenado") > 0) invsec.push_back("dardo_envenenado");
			if (inv_item_number("fita_explosiva") > 0) invsec.push_back("fita_explosiva");
			if (invsec.length() > 0) {
				// net.send_reliable(peer_id, "invsec " + linear(invsec), 0);
			}
		}
	}
	
	bool inv_item_exists(string itemname) {
		string content = inv;
		string[] peramitors = content.split("\r\n");
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos > -1) {
				string item = peramitors[i].substr(0, eq_pos);
				if (item == itemname) {
					return true;
				}
			}
		}
		return false;
	}
	
	int inv_item_number(string itemname) {
		string content = inv;
		string[] peramitors = content.split("\r\n");
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos > -1) {
				string item = peramitors[i].substr(0, eq_pos);
				if (item == itemname) {
					string value = peramitors[i].substr(eq_pos + 1);
					return string_to_number(value);
				}
			}
		}
		return 0;
	}
	
	int inv_item(string itemname) {
		string content = inv;
		string[] peramitors = content.split("\r\n");
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos > -1) {
				string item = peramitors[i].substr(0, eq_pos);
				if (item == itemname) {
					return i;
				}
			}
		}
		return -1;
	}
	
	void inv_delete_item(string itemname) {
		string content = inv;
		string[] peramitors = content.split("\r\n");
		
		for (uint i = 0; i < peramitors.length(); i++) {
			int eq_pos = peramitors[i].find("=");
			if (eq_pos > -1) {
				string item = peramitors[i].substr(0, eq_pos);
				if (item == itemname) {
					string value = peramitors[i].substr(eq_pos + 1);
					inv = inv.replace(itemname + "=" + value + "\r\n", "");
					break;
				}
			}
		}
	}
	
	bool has_muted(string name) {
		string[] m = muted.split("\r\n");
		for (uint i = 0; i < m.length(); i++) {
			if (m[i] == name) {
				return true;
			}
		}
		return false;
	}
	
	void add_muted(string name) {
		muted += "\r\n" + name;
		write_to(charname, "muted.usr", muted);
	}
	
	bool remove_muted(string name) {
		string[] m = muted.split("\r\n");
		string newmuted;
		bool succeeded = false;
		for (uint i = 0; i < m.length(); i++) {
			if (m[i] != name)
				newmuted += "\r\n" + m[i];
			else
				succeeded = true;
		}
		muted = newmuted;
		write_to(charname, "muted.usr", muted);
		return succeeded;
	}
}

void spawn_player(uint id, string name, string vers, string thebanid) {
	player player1(id, name, vers, thebanid);
	players.push_back(player1);
}

double get_player_distance(player@ p1, player@ p2) {
	if (p1.map != p2.map) return -1;
	int dx, dy;
	if (p1.x <= p2.x) dx = p2.x - p1.x;
	else dx = p1.x - p2.x;
	if (p1.y <= p2.y) dy = p2.y - p1.y;
	else dy = p1.y - p2.y;
	return dx + dy;
}

double get_bala_y_distance(bullet@ p1, player@ p2) {
	if (p1.mapname != p2.map) return -1;
	int dy;
	if (p1.y <= p2.y) dy = p2.y - p1.y;
	else dy = p1.y - p2.y;
	return dy;
}

// Funções auxiliares de player
player@ get_player_by_name(string name) {
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].name == name || players[i].charname == name) {
			return players[i];
		}
	}
	return null;
}

player@ get_player_by_id(uint64 peer_id) {
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].peer_id == peer_id) {
			return players[i];
		}
	}
	return null;
}

// Sobrecarga para string (converte para uint64)
player@ get_player_by_id(string peer_id_str) {
	uint64 peer_id = string_to_number(peer_id_str);
	return get_player_by_id(peer_id);
}

player@[] get_players_in_map(string map_name) {
	player@[] result;
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].map_name == map_name) {
			result.push_back(players[i]);
		}
	}
	return result;
}

int get_player_index_from(string name) {
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].name == name || players[i].charname == name) {
			return int(i);
		}
	}
	return -1;
}
