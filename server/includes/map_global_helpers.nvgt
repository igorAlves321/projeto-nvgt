double get_distance(int x1, int y1, int x2, int y2) {
    int dx = x2 - x1;
    int dy = y2 - y1;
    return sqrt(double(dx * dx + dy * dy));
}

int get_damage(int base_damage, int distance, int max_range = 20) {
    if(distance <= 0) return base_damage;
    if(distance >= max_range) return 0;

    double damage_ratio = 1.0 - (double(distance) / double(max_range));
    return int(base_damage * damage_ratio);
}

mutex map_global_mutex;

map@[] server_maps;

string get_map_filename(string map_input) {
	string normalized = map_input.replace("\\", "/");
	string[] parts = normalized.split("/");
	string file_name = parts.length() > 0 ? parts[parts.length() - 1] : normalized;
	if(file_name.find(".map") == -1) file_name += ".map";
	return file_name;
}

string resolve_map_path(string map_input) {
	string file_name = get_map_filename(map_input);
	string path_local = "maps/" + file_name;
	if(file_exists(path_local)) return path_local;
	string path_server = "server/maps/" + file_name;
	if(file_exists(path_server)) return path_server;
	return path_local;
}

void cleanup_expired_items_task() {
    map_global_mutex.lock();

    int total_removed = 0;
    int maps_processed = 0;

    for(uint map_idx = 0; map_idx < server_maps.length(); map_idx++) {
        map@ current_map = server_maps[map_idx];
        if(current_map is null) continue;

        for(int obj_idx = int(current_map.objs.length()) - 1; obj_idx >= 0; obj_idx--) {
            obj@ item = current_map.objs[obj_idx];
            if(item is null) {
                current_map.objs.remove_at(obj_idx);
                total_removed++;
                continue;
            }

            bool is_expired = false;
            if(item.time_out > 0 && item.ttime_out.elapsed >= item.time_out) {
                is_expired = true;
            }
            if(item.taked) {
                is_expired = true;
            }
            if(item.delete) {
                is_expired = true;
            }

            if(is_expired) {
                current_map.objs.remove_at(obj_idx);
                total_removed++;
            }
        }

        maps_processed++;
    }

    if(total_removed > 0) {
        debug_log("[CLEANUP] Removidos " + total_removed + " itens expirados de " + maps_processed + " mapas");
    }

    map_global_mutex.unlock();
}
