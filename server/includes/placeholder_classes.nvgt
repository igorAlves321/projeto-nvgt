	int danoquedara = 0; // Dano que dará
	int danoquerecibira = 0; // Dano que receberá
	int distanciaataques = 5; // Distância de ataques
	timer respawn_timer;
	
	npc_data() {}
}

// Monstros
class monstruo {
	int x, y;
	int vida = 100;
	int tiros = 0; // Contador de tiros
	string map, name;
	string golpeado = "";
	string asom = ""; // Som de ataque
	bool morreu = false;
	timer tmorreu, tsom;
	timer monstruotimer; // Timer geral
	int monstruotime = 1000; // Tempo em ms
	timer tempoatirar; // Timer para atirar
	timer trespawn; // Timer de respawn
	
	monstruo(int x, int y, string mapname) {
		this.x = x; this.y = y;
		this.map = mapname;
		this.vida = 100;
	}
}

class monstruo_data {
	int x, y;
	int id = 0; // ID do monstro
	string map;
	int trespawn = 0; // Tempo de respawn
	timer respawn_timer;
	
	monstruo_data() {}
	
	monstruo_data(int mx, int my) {
		this.x = mx;
		this.y = my;
	}
}

// Zonas de morte
class death {
	int minx, maxx, miny, maxy;
	int damage;
	int item_cantity = 0; // Quantidade de item necessária
	string item_required = "", require_item = ""; // Item necessário
	string item = ""; // Item associado
	bool instant_death;
	int time = 1000; // Tempo em ms entre danos
	string reason = ""; // Razão da morte
	bool enable_progressive_death = true; // Morte progressiva habilitada
	int life = 100; // Vida da zona de morte

	death(int minx, int maxx, int miny, int maxy, int damage, string item_required, bool instant) {
		this.minx = minx; this.maxx = maxx;
		this.miny = miny; this.maxy = maxy;
		this.damage = damage;
		this.item_required = item_required;
		this.require_item = item_required;
		this.instant_death = instant;
	}

	// Construtor alternativo com 11 parâmetros (do arquivo de mapa)
	death(int p1, int p2, int p3, int p4, int p5, int p6, int p7, string s1, string s2, int p8, int p9) {
		this.minx = p1; this.maxx = p2;
		this.miny = p3; this.maxy = p4;
		this.damage = p5;
		this.item_required = s1;
		this.require_item = s1;
		this.instant_death = (p6 != 0);
		this.time = p7;
		this.reason = s2;
		this.enable_progressive_death = (p8 != 0);
		this.life = p9;
	}
}

// Zonas de extração
class extract {
	int minx, maxx, miny, maxy;
	string name;

	extract(int minx, int maxx, int miny, int maxy, string name) {
		this.minx = minx; this.maxx = maxx;
		this.miny = miny; this.maxy = maxy;
		this.name = name;
	}

	// Construtor alternativo com 10 parâmetros (do arquivo de mapa)
	extract(int p1, int p2, int p3, int p4, int p5, int p6, int p7, string s1, string s2, string s3) {
		this.minx = p1; this.maxx = p2;
		this.miny = p3; this.maxy = p4;
		this.name = s1; // Usar primeiro string como nome
		// Parâmetros extras (p5, p6, p7, s2, s3) podem ser usados para funcionalidades futuras
	}
}

// Jaulas (cages)
class jaula {
	int x, y;
	int dueno = -1; // Dono da jaula (player index)
	int vida = 1000; // Vida da jaula
	string map;
	
	jaula(int x, int y, string mapname) {
		this.x = x; this.y = y;
		this.map = mapname;
	}
}

// Cachorros de mascota (pet dogs)
class cachorromascota {
	int x, y;
	int mapindex = -1; // Índice do mapa
	string map, nome;

	cachorromascota(int x, int y, string nome, string mapname) {
		this.x = x; this.y = y;
		this.nome = nome;
		this.map = mapname;
	}

	string getdesc() {
		return "Cachorro " + nome + " em " + x + "," + y;
	}
}

// Terremotos (earthquakes)
class earthquake {
	int x, y;
	int minx, maxx, miny, maxy;
	string map, earthquake_sound = ""; // Som do terremoto
	int intensity = 5, owner = -1; // Intensidade e dono
	int duration = 10000; // Duração em ms
	bool active = false; // Se está ativo
	timer t, damagetimer; // Timers
	
	earthquake(int minx, int maxx, int miny, int maxy, int intensity, string mapname) {
		this.minx = minx; this.maxx = maxx;
		this.miny = miny; this.maxy = maxy;
		this.intensity = intensity;
		this.map = mapname;
	}
}
