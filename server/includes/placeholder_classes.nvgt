// Classes _data para respawn (faltam nos arquivos originais)
class obj_data {
	int x, y;
	string map, itemname;
	string sound_get = ""; // Som ao pegar
	int amount = 1; // Quantidade do item
	bool disable_respawn = false; // Sem respawn
	int time_respawn = 0; // Tempo de respawn
	int time_out = 0; // Timeout do item
	timer trespawn; // Timer de respawn (CORRIGIDO: era int)
	int x_data = 0; // Dados extras
	timer respawn_timer;

	obj_data() {}

	// Construtor completo para criar obj_data de obj coletado
	obj_data(int ox, int oy, int otimeout, bool odisable, int oamount, string oitemname, string omap, string osound, int otrespawn) {
		x = ox;
		y = oy;
		time_out = otimeout;
		disable_respawn = odisable;
		amount = oamount;
		itemname = oitemname;
		map = omap;
		sound_get = osound;
		time_respawn = otrespawn;
	}
}

class wall_data {
	int x, y;
	int minx, maxx, miny, maxy; // Área da parede
	string map, name;
	int vida = 600000; // Vida atual
	int respawn = 0; // Tempo de respawn em segundos
	string sound_fall = ""; // Som ao cair
	string sound_wall = ""; // Som de impacto
	bool enableitems = false; // Se deixa items
	string[] items; // Items que deixa
	timer respawn_timer;
	int trespawn = 0; // Tempo de respawn em ms

	wall_data() {}

	// Construtor para wallLoop (aceita int trespawn_ms)
	wall_data(int wx, int wminy, int wmaxy, int wvida, int trespawn_ms, bool wenable, string[] witems, string wname, string wsound_wall, string wsound_fall) {
		x = wx;
		miny = wminy;
		maxy = wmaxy;
		vida = wvida;
		trespawn = trespawn_ms;
		enableitems = wenable;
		items = witems;
		name = wname;
		sound_wall = wsound_wall;
		sound_fall = wsound_fall;
	}
}

// Árvores
class arbol {
	int x, y;
	int minx, maxx, miny, maxy;
	int vida;
	int vida_inicial = 100; // Vida inicial para respawn
	string map, name;
	string golpeado = "";
	bool morreu = false, morrendo = false, nasceu = true;
	bool enableitems = false; // Se deixa items ao morrer
	string[] items; // Items que deixa
	timer tmorreu, trespawn;
	
	arbol(int x, int y, int minx, int maxx, int miny, int maxy, string name, string map_name, string mapname) {
		this.x = x; this.y = y;
		this.minx = minx; this.maxx = maxx;
		this.miny = miny; this.maxy = maxy;
		this.name = name;
		this.map = mapname;
		this.vida = 100;
		this.vida_inicial = 100;
	}

	// Construtor alternativo para arboldataloop (aceita int trespawn_ms)
	arbol(int ax, int aminy, int amaxy, int avida, int trespawn_ms, bool aenable, string[] aitems, string aname, string amap) {
		this.x = ax;
		this.miny = aminy;
		this.maxy = amaxy;
		this.vida = avida;
		this.vida_inicial = avida;
		// trespawn seria configurado aqui se fosse necessário (ignorado por ora)
		this.enableitems = aenable;
		this.items = aitems;
		this.name = aname;
		this.map = amap;
	}
}

class arbol_data {
	int x, y;
	int minx, maxx, miny, maxy;
	int vida = 100; // Vida da árvore
	string map, name;
	timer respawn; // Timer de respawn
	bool enableitems = false; // Se deixa items
	string[] items; // Items que deixa
	timer respawn_timer;
	int trespawn = 0; // Tempo de respawn em ms (era timer mas é usado como int)

	arbol_data() {}

	// Construtor completo (aceita int trespawn_ms para tempo de respawn)
	arbol_data(int ax, int aminy, int amaxy, int avida, int trespawn_ms, bool aenable, string[] aitems, string aname) {
		x = ax;
		miny = aminy;
		maxy = amaxy;
		vida = avida;
		trespawn = trespawn_ms;
		enableitems = aenable;
		items = aitems;
		name = aname;
	}
}

// NPCs
class npc {
	int x, y;
	int id = 0; // ID único do NPC
	int x_inicial = 0, y_inicial = 0; // Posição inicial X e Y
	int vida = 100;
	int p_index = -1; // Índice do jogador alvo
	bool enablerespawn = true; // Respawn habilitado
	bool enablebombs = false; // Se pode usar bombas
	int mapindex = -1; // Índice do mapa
	string asesino = ""; // Quem matou o NPC
	string nombrenpc = ""; // Nome do NPC
	string impactosbala = ""; // Som de impacto de bala
	string impactos = ""; // Som de impactos gerais
	int danoquerecibira = 0; // Dano que irá receber
	int distanciaataques = 5; // Distância de ataque
	int tiempoparacaminar = 5000; // Configuração de tempo (ms)
	int tiempoparaatacar = 3000; // Configuração de tempo (ms)
	int tiempodelossonidos = 10000; // Configuração de tempo (ms)
	string map, name;
	string golpeado = "";
	bool morreu = false, morrendo = false, nasceu = true;
	timer tmorreu, tandar, tatirar, tsom;
	timer ttiempodelossonidos, ttiempoparacaminar, ttiempoparaatacar;
	string[] sonidosnervioso; // Sons nervosos
	
	timer update_player; // Timer para atualizar jogador alvo
	bool exists_player_in_my_map() { return false; } // Verifica se jogador alvo existe no mapa
	int select_player_to_attack() { return -1; } // Seleciona jogador para atacar
	void move() { } // Move o NPC
	void attack() { } // Ataca o jogador alvo
	int change_player(int current_index) { return -1; } // Muda de jogador alvo
	void die() { } // NPC morre

	npc(int x, int y, string tiponpc, string name, string charname, string voice,
	    string team, string items, string weapon, string enemy, string map_name,
	    string grito, string boas_vindas, string morte, string ataque,
	    int vida, int velocidade, int velocidadetiro, string mapa, string weapon2,
	    int distance, int maxx, string sound, int dist_grito) {
		this.x = x; this.y = y;
		this.name = name;
		this.map = mapa;
		this.vida = vida;
		this.nombrenpc = tiponpc;
		this.distanciaataques = distance;
	}

	// Construtor alternativo com muitos parâmetros int (do arquivo de mapa)
	npc(int p1, int p2, int p3, int p4, int p5, int p6, int p7, int p8, int p9, int p10, int p11,
	    string s1, string s2, string s3, string s4, string s5, string s6,
	    int p12, int p13, int p14, string s7, string s8, int p15, int p16, string s9, int p17) {
		this.x = p1; this.y = p2;
		this.name = s1;
		this.map = s7;
		this.vida = p12;
		this.nombrenpc = s2;
		this.distanciaataques = p15;
		// Outros parâmetros podem ser mapeados conforme necessário
	}
}

