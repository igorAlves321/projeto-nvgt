// readable_time.nvgt - Conversão de tempo legível
// Convertido de readable_time.bgt para NVGT
// Converte milissegundos em strings legíveis (ex: "2 dias, 3 horas e 15 minutos")

string ms_to_readable_time(double ms) {
	if(ms <= 0) return "no time at all";
	
	uint dias, horas, minutos, semanas, meses, segundos;
	
	segundos = ms / 1000;
	minutos = segundos / 60;
	segundos %= 60;
	horas = minutos / 60;
	minutos %= 60;
	dias = horas / 24;
	horas %= 24;
	dias = round(dias);
	semanas = dias / 7;
	dias %= 7;
	semanas = round(semanas);
	meses = semanas / 4;
	semanas %= 4;
	meses = round(meses);
	
	string ret = "";
	
	if(meses > 0) {
		string m = meses > 1 ? "meses" : "mês";
		ret += meses + " " + m + ", ";
	}
	
	if(semanas > 0) {
		string w = semanas > 1 ? "semanas" : "semana";
		ret += semanas + " " + w + ", ";
	}
	
	if(dias > 0) {
		string d = dias > 1 ? "días" : "día";
		ret += dias + " " + d;
	}
	
	if(dias > 0 && (horas > 0 || minutos > 0 || segundos > 0)) {
		ret += ", ";
	}
	
	if(horas > 0) {
		string h = horas > 1 ? "horas" : "hora";
		ret += horas + " " + h;
	}
	
	if(horas > 0 && (minutos > 0 || segundos > 0)) {
		ret += ", ";
	}
	
	if(minutos > 0) {
		string m = minutos > 1 ? "minutos" : "minuto";
		ret += minutos + " " + m;
	}
	
	if(minutos > 0 && segundos > 0) {
		ret += ", ";
	}
	
	if(segundos > 0) {
		string s = segundos > 1 ? "segundos" : "segundo";
		ret += segundos + " " + s;
	}
	
	// Formatar corretamente com "e" antes do último item
	string[] ret2 = ret.split(", ");
	if(ret2.length() > 1) {
		int slength = ret2[ret2.length() - 1].length();
		ret = ret.substr(0, ret.length() - (slength + 2));
		ret += " e ";
		ret += ret2[ret2.length() - 1];
	}
	
	return ret;
}

// Função auxiliar para tempo em português
string tempo_decorrido(double ms) {
	return ms_to_readable_time(ms);
}

// Função para formato curto (ex: "2d 3h 15m")
string ms_to_short_time(double ms) {
	if(ms <= 0) return "0s";
	
	uint dias, horas, minutos, semanas, segundos;
	
	segundos = ms / 1000;
	minutos = segundos / 60;
	segundos %= 60;
	horas = minutos / 60;
	minutos %= 60;
	dias = horas / 24;
	horas %= 24;
	semanas = dias / 7;
	dias %= 7;
	
	string ret = "";
	
	if(semanas > 0) ret += semanas + "w ";
	if(dias > 0) ret += dias + "d ";
	if(horas > 0) ret += horas + "h ";
	if(minutos > 0) ret += minutos + "m ";
	if(segundos > 0) ret += segundos + "s";
	
	return ret.trim();
}
