
class ip_locale {
	ip_locale() {
		reset();
	}

	void reset() {
		active = false;
		requested = false;
		raw_data = "";
		ip_query = "AUTO";
		ip_address = "";
		country_code = "";
		country_name = "";
		state = "";
		city = "";
		zipcode = "";
		latitude = "";
		longitude = "";
		time_zone = "";
	}

	void set_ip(string ip = "AUTO") {
		reset();
		ip_query = ip;
		active = true;
	}

	bool request() {
		if (requested == false && active == true) {
			if (ip_query == "AUTO") {
				raw_data = url_get(IP_LOCALE_PHP_URL + "?ApiKey=" + IP_LOCALE_API_KEY);
			}
			else {
				raw_data = url_get(IP_LOCALE_PHP_URL + "?ApiKey=" + IP_LOCALE_API_KEY + "&ip=" + ip_query);
			}

			string error_check_raw = raw_data.lower();
			if (error_check_raw.find("error") > -1 || get_last_error() < 0) {
				return false;
			}

			string[] data = raw_data.split(";", false);
			if (data.length() < 10) return false;

			ip_address = data[1];
			country_code = data[2];
			country_name = data[3];
			state = data[4];
			city = data[5];
			zipcode = data[6];
			latitude = data[7];
			longitude = data[8];
			time_zone = data[9];
			active = true;
			requested = true;
			return true;
		}
		else {
			return false;
		}
	}

	string get_ip_address() {
		if (active && requested) return ip_address;
		else return "";
	}

	string get_country_code() {
		if (active && requested) return country_code;
		else return "";
	}

	string get_country_name() {
		if (active && requested) return country_name;
		else return "";
	}

	string get_state() {
		if (active && requested) return state;
		else return "";
	}

	string get_city() {
		if (active && requested) return city;
		else return "";
	}

	string get_zipcode() {
		if (active && requested) return zipcode;
		else return "";
	}

	string get_latitude() {
		if (active && requested) return latitude;
		else return "";
	}

	string get_longitude() {
		if (active && requested) return longitude;
		else return "";
	}

	string get_time_zone() {
		if (active && requested) return time_zone;
		else return "";
	}

	private string raw_data;
	private bool requested;
	private bool active;
	private string ip_query;
	private string ip_address;
	private string country_code;
	private string country_name;
	private string state;
	private string city;
	private string zipcode;
	private string latitude;
	private string longitude;
	private string time_zone;
}
