
const int MAX_INVENTORY_SLOTS = 50;
const float INVENTORY_BROADCAST_RANGE = 20.0;
const uint INVENTORY_JSON_MAX_MESSAGE_CHARS = 4096;

class inventory_slot {
    int slot_index;
    string item_name;
    int quantity;

    inventory_slot() {
        slot_index = -1;
        item_name = "";
        quantity = 0;
    }

    inventory_slot(int idx, string name, int qty) {
        slot_index = idx;
        item_name = name;
        quantity = qty;
    }
}

string inventory_to_json(player@ p) {
    if(@p == null) return "{\"slots\":[]}";

    string json = "{\"type\":\"inv_sync\",\"slots\":[";
    string[] item_names = p.inv.get_keys();

    bool first = true;
    for(uint i = 0; i < item_names.length(); i++) {
        int quantity = 0;
        p.inv.get(item_names[i], quantity);

        if(!first) json += ",";
        first = false;

        json += "{\"slot\":" + i + ",";
        json += "\"item\":\"" + item_names[i] + "\",";
        json += "\"qty\":" + quantity + "}";
    }

    json += "]}";
    return json;
}

string create_inv_update_json(int slot, string item_name, int quantity) {
    string json = "{\"type\":\"inv_update\",";
    json += "\"slot\":" + slot + ",";
    json += "\"item\":\"" + item_name + "\",";
    json += "\"qty\":" + quantity + "}";
    return json;
}

string create_inv_result_json(bool success, string reason = "", string message = "") {
    string json = "{\"type\":\"inv_result\",";
    json += "\"status\":\"" + (success ? "ok" : "error") + "\"";
    if(reason != "") {
        json += ",\"reason\":\"" + reason + "\"";
    }
    if(message != "") {
        json += ",\"message\":\"" + message + "\"";
    }
    json += "}";
    return json;
}

string create_inv_broadcast_pickup_json(string player_name, string item_name, int x, int y, int quantity) {
    string json = "{\"type\":\"inv_broadcast_pickup\",";
    json += "\"player\":\"" + player_name + "\",";
    json += "\"item\":\"" + item_name + "\",";
    json += "\"qty\":" + quantity + ",";
    json += "\"x\":" + x + ",";
    json += "\"y\":" + y + "}";
    return json;
}

string create_inv_broadcast_drop_json(string player_name, string item_name, int x, int y, int quantity) {
    string json = "{\"type\":\"inv_broadcast_drop\",";
    json += "\"player\":\"" + player_name + "\",";
    json += "\"item\":\"" + item_name + "\",";
    json += "\"qty\":" + quantity + ",";
    json += "\"x\":" + x + ",";
    json += "\"y\":" + y + "}";
    return json;
}

void broadcast_inventory_change(player@ source, string message, float range = INVENTORY_BROADCAST_RANGE) {
    if(@source == null) return;

    for(uint i = 0; i < players.length(); i++) {
        player@ target = players[i];

        if(@target == null) continue;
        if(!target.is_logged_in) continue;
        if(target.peer_id == 0) continue;
        if(target.name == source.name) continue;
        if(target.map != source.map) continue;

        float dx = target.x - source.x;
        float dy = target.y - source.y;
        float distance = sqrt(dx * dx + dy * dy);

        if(distance <= range) {
            send_reliable_text(target.peer_id, message, 0);
        }
    }
}

void handle_inv_request_sync(player@ p) {
    if(@p == null) return;

    debug_log("[INV_SYNC] " + p.name + " solicitou sincronizacao completa");

    string json_inventory = inventory_to_json(p);
    send_reliable_text(p.peer_id, json_inventory, 0);

    debug_log("  [OK] Inventario enviado: " + p.inv.get_keys().length() + " tipos de itens");
}

void handle_inv_use_json(player@ p, int slot) {
    if(@p == null) return;

    debug_log("[INV_USE_JSON] " + p.name + " usando slot " + slot);

    string[] item_names = p.inv.get_keys();

    if(slot < 0 || slot >= int(item_names.length())) {
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Slot inválido"), 0);
        return;
    }

    string item_name = item_names[slot];
    int quantity = 0;
    p.inv.get(item_name, quantity);

    if(quantity <= 0) {
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Item esgotado"), 0);
        return;
    }

    int player_index = get_player_index_from(p.charname);
    if(player_index < 0) {
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Jogador inválido"), 0);
        return;
    }

    bool used = use_item(player_index, item_name);
    if(!used) {
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Não foi possível usar este item"), 0);
        return;
    }

    int updated_quantity = 0;
    if(p.inv.exists(item_name)) {
        p.inv.get(item_name, updated_quantity);
    }

    send_reliable_text(p.peer_id, inventory_to_json(p), 0);
    send_reliable_text(p.peer_id, create_inv_result_json(true), 0);

    debug_log("INV_USE_JSON: item usado via consumables: " + item_name + " (restam " + updated_quantity + ")");
}

void handle_inv_move_json(player@ p, int from_slot, int to_slot) {
    if(@p == null) return;

    debug_log("[INV_MOVE_JSON] " + p.name + " movendo " + from_slot + " -> " + to_slot);

    string[] item_names = p.inv.get_keys();

    if(from_slot < 0 || from_slot >= int(item_names.length())) {
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Slot origem inválido"), 0);
        return;
    }

    send_reliable_text(p.peer_id, create_inv_result_json(true), 0);

    debug_log("  [OK] Movimento confirmado (sistema de slots simplificado)");
}

void handle_inv_drop_json(player@ p, int slot, int quantity) {
    if(@p == null) return;

    debug_log("[INV_DROP_JSON] " + p.name + " dropando slot " + slot + " x" + quantity);

    string[] item_names = p.inv.get_keys();

    if(slot < 0 || slot >= int(item_names.length())) {
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Slot inválido"), 0);
        return;
    }

    string item_name = item_names[slot];
    int current = 0;
    p.inv.get(item_name, current);

    if(current < quantity) {
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Quantidade insuficiente"), 0);
        return;
    }

    current -= quantity;
    if(current > 0) {
        p.inv.set(item_name, current);
    } else {
        p.inv.delete(item_name);
    }

    string drop_id = spawn_drop(item_name, quantity, p.map, p.x, p.y, p.peer_id);
    if(drop_id == "") {
        p.inv.set(item_name, current + quantity);
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Falha ao criar drop no chao"), 0);
        return;
    }

    string update_msg = create_inv_update_json(slot, current > 0 ? item_name : "", current);
    send_reliable_text(p.peer_id, update_msg, 0);

    send_reliable_text(p.peer_id, create_inv_result_json(true), 0);

    string broadcast_msg = create_inv_broadcast_drop_json(p.name, item_name, p.x, p.y, quantity);
    broadcast_inventory_change(p, broadcast_msg);

    save_player_to_database(p);

    debug_log("  [OK] Item dropado: " + item_name + " x" + quantity);
}

string json_get_type(string json) {
    int type_pos = json.find("\"type\":");
    if(type_pos < 0) return "";

    int quote1 = json.find("\"", type_pos + 7);
    if(quote1 < 0) return "";

    int quote2 = json.find("\"", quote1 + 1);
    if(quote2 < 0) return "";

    return json.substr(quote1 + 1, quote2 - quote1 - 1);
}

int json_get_int(string json, string field) {
    string search = "\"" + field + "\":";
    int pos = json.find(search);
    if(pos < 0) return -1;

    int start = pos + search.length();
    int end = start;

    while(end < int(json.length())) {
        string c = json.substr(end, 1);
        if(c >= "0" && c <= "9") {
            end++;
        } else {
            break;
        }
    }

    if(end == start) return -1;
    return parse_int(json.substr(start, end - start));
}

void dispatch_inventory_json(player@ p, string json_message) {
    if(@p == null) return;

    string payload = json_message.trim_whitespace();
    if(payload == "") {
        network_log_invalid_payload(p, "dispatch_inventory_json", "payload vazio", json_message);
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Dados invalidos"), 0);
        return;
    }
    if(payload.length() > INVENTORY_JSON_MAX_MESSAGE_CHARS) {
        network_log_invalid_payload(p, "dispatch_inventory_json", "payload acima do limite", json_message);
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Dados invalidos"), 0);
        return;
    }
    if(payload.substr(0, 1) != "{" || payload.substr(payload.length() - 1, 1) != "}") {
        network_log_invalid_payload(p, "dispatch_inventory_json", "json malformado", json_message);
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Dados invalidos"), 0);
        return;
    }
    if(payload.find("\"type\"") < 0) {
        network_log_invalid_payload(p, "dispatch_inventory_json", "campo type ausente", json_message);
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Dados invalidos"), 0);
        return;
    }

    string msg_type = json_get_type(payload);
    if(msg_type == "") {
        network_log_invalid_payload(p, "dispatch_inventory_json", "type vazio", json_message);
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Dados invalidos"), 0);
        return;
    }

    if(msg_type == "inv_request_sync") {
        handle_inv_request_sync(p);
    }
    else if(msg_type == "inv_use") {
        int slot = json_get_int(payload, "slot");
        if(slot < 0 || slot >= MAX_INVENTORY_SLOTS) {
            network_log_invalid_payload(p, "dispatch_inventory_json", "slot inválido em inv_use", json_message);
            send_reliable_text(p.peer_id, create_inv_result_json(false, "Slot inválido"), 0);
            return;
        }
        handle_inv_use_json(p, slot);
    }
    else if(msg_type == "inv_move") {
        int from = json_get_int(payload, "from");
        int to = json_get_int(payload, "to");
        if(from < 0 || from >= MAX_INVENTORY_SLOTS || to < 0 || to >= MAX_INVENTORY_SLOTS) {
            network_log_invalid_payload(p, "dispatch_inventory_json", "from/to invalidos em inv_move", json_message);
            send_reliable_text(p.peer_id, create_inv_result_json(false, "Slots invalidos"), 0);
            return;
        }
        handle_inv_move_json(p, from, to);
    }
    else if(msg_type == "inv_drop") {
        int slot = json_get_int(payload, "slot");
        int quantity = json_get_int(payload, "quantity");
        if(slot < 0 || slot >= MAX_INVENTORY_SLOTS) {
            network_log_invalid_payload(p, "dispatch_inventory_json", "slot inválido em inv_drop", json_message);
            send_reliable_text(p.peer_id, create_inv_result_json(false, "Slot inválido"), 0);
            return;
        }
        if(quantity <= 0 || quantity > 9999) {
            network_log_invalid_payload(p, "dispatch_inventory_json", "quantity invalida em inv_drop", json_message);
            send_reliable_text(p.peer_id, create_inv_result_json(false, "Quantidade invalida"), 0);
            return;
        }
        handle_inv_drop_json(p, slot, quantity);
    }
    else {
        debug_log("Tipo de mensagem JSON desconhecido: " + msg_type);
        send_reliable_text(p.peer_id, create_inv_result_json(false, "Tipo de mensagem desconhecido"), 0);
    }
}

bool is_valid_slot(player@ p, int slot) {
    if(@p == null) return false;
    string[] items = p.inv.get_keys();
    return slot >= 0 && slot < int(items.length());
}

bool add_item_with_sync(player@ p, string item_name, int quantity) {
    if(@p == null) return false;

    int current = 0;
    bool exists = p.inv.exists(item_name);

    if(exists) {
        p.inv.get(item_name, current);
    }

    p.inv.set(item_name, current + quantity);

    string[] items = p.inv.get_keys();
    for(uint i = 0; i < items.length(); i++) {
        if(items[i] == item_name) {
            int new_qty = 0;
            p.inv.get(item_name, new_qty);
            string update = create_inv_update_json(i, item_name, new_qty);
            send_reliable_text(p.peer_id, update, 0);
            break;
        }
    }

    save_player_to_database(p);

    return true;
}

bool remove_item_with_sync(player@ p, string item_name, int quantity) {
    if(@p == null) return false;

    if(!p.inv.exists(item_name)) return false;

    int current = 0;
    p.inv.get(item_name, current);

    if(current < quantity) return false;

    string[] items = p.inv.get_keys();
    int slot = -1;
    for(uint i = 0; i < items.length(); i++) {
        if(items[i] == item_name) {
            slot = i;
            break;
        }
    }

    current -= quantity;
    if(current > 0) {
        p.inv.set(item_name, current);
    } else {
        p.inv.delete(item_name);
    }

    if(slot >= 0) {
        string update = create_inv_update_json(slot, current > 0 ? item_name : "", current);
        send_reliable_text(p.peer_id, update, 0);
    }

    save_player_to_database(p);

    return true;
}
