// ============================================================
// SISTEMA DE INVENTÁRIO COM SINCRONIZAÇÃO REALTIME (JSON)
// ============================================================
// ✅ Epic 1 Task 5: Sistema de Inventário + Sincronização Realtime
//
// Implementa protocolo JSON para operações de inventário com:
// - Sincronização completa (inv_request_sync → inv_sync)
// - Atualizações incrementais (inv_update)
// - Respostas padronizadas (inv_result)
// - Broadcasts para players próximos
// - Persistência automática no banco de dados
//
// Protocolo JSON:
// Cliente → Servidor:
//   {"type":"inv_request_sync"}
//   {"type":"inv_use","slot":3}
//   {"type":"inv_move","from":0,"to":5}
//   {"type":"inv_drop","slot":2,"quantity":1}
//
// Servidor → Cliente:
//   {"type":"inv_sync","slots":[...]}
//   {"type":"inv_update","slot":3,"item_name":"","quantity":0}
//   {"type":"inv_result","status":"ok|error","reason":""}
//   {"type":"inv_broadcast_pickup","player":"João","item":"espada","x":10,"y":20}

// ============================================================
// CONSTANTES
// ============================================================

const int MAX_INVENTORY_SLOTS = 50;  // Número máximo de slots por jogador
const float INVENTORY_BROADCAST_RANGE = 20.0;  // Alcance para broadcasts (metros)

// ============================================================
// ESTRUTURAS DE DADOS
// ============================================================

// Slot de inventário (usado para serialização JSON)
class inventory_slot {
    int slot_index;
    string item_name;
    int quantity;

    inventory_slot() {
        slot_index = -1;
        item_name = "";
        quantity = 0;
    }

    inventory_slot(int idx, string name, int qty) {
        slot_index = idx;
        item_name = name;
        quantity = qty;
    }
}

// ============================================================
// FUNÇÕES DE SERIALIZAÇÃO JSON
// ============================================================

// Converter inventário do jogador para JSON
string inventory_to_json(player@ p) {
    if(@p == null) return "{\"slots\":[]}";

    string json = "{\"type\":\"inv_sync\",\"slots\":[";
    string[] item_names = p.inv.get_keys();

    bool first = true;
    for(uint i = 0; i < item_names.length(); i++) {
        int quantity = 0;
        p.inv.get(item_names[i], quantity);

        if(!first) json += ",";
        first = false;

        // Cada slot: {"slot":index, "item":"nome", "qty":quantidade}
        json += "{\"slot\":" + i + ",";
        json += "\"item\":\"" + item_names[i] + "\",";
        json += "\"qty\":" + quantity + "}";
    }

    json += "]}";
    return json;
}

// Criar mensagem de atualização incremental
string create_inv_update_json(int slot, string item_name, int quantity) {
    string json = "{\"type\":\"inv_update\",";
    json += "\"slot\":" + slot + ",";
    json += "\"item\":\"" + item_name + "\",";
    json += "\"qty\":" + quantity + "}";
    return json;
}

// Criar mensagem de resultado
string create_inv_result_json(bool success, string reason = "") {
    string json = "{\"type\":\"inv_result\",";
    json += "\"status\":\"" + (success ? "ok" : "error") + "\"";
    if(reason != "") {
        json += ",\"reason\":\"" + reason + "\"";
    }
    json += "}";
    return json;
}

// Criar mensagem de broadcast de pickup
string create_inv_broadcast_pickup_json(string player_name, string item_name, int x, int y, int quantity) {
    string json = "{\"type\":\"inv_broadcast_pickup\",";
    json += "\"player\":\"" + player_name + "\",";
    json += "\"item\":\"" + item_name + "\",";
    json += "\"qty\":" + quantity + ",";
    json += "\"x\":" + x + ",";
    json += "\"y\":" + y + "}";
    return json;
}

// Criar mensagem de broadcast de drop
string create_inv_broadcast_drop_json(string player_name, string item_name, int x, int y, int quantity) {
    string json = "{\"type\":\"inv_broadcast_drop\",";
    json += "\"player\":\"" + player_name + "\",";
    json += "\"item\":\"" + item_name + "\",";
    json += "\"qty\":" + quantity + ",";
    json += "\"x\":" + x + ",";
    json += "\"y\":" + y + "}";
    return json;
}

// ============================================================
// FUNÇÕES DE BROADCAST
// ============================================================

// Enviar broadcast para players próximos
void broadcast_inventory_change(player@ source, string message, float range = INVENTORY_BROADCAST_RANGE) {
    if(@source == null) return;

    // Iterar sobre todos os jogadores
    for(uint i = 0; i < players.length(); i++) {
        player@ target = players[i];

        // Validações
        if(@target == null) continue;
        if(!target.is_logged_in) continue;
        if(target.peer_id == 0) continue;
        if(target.name == source.name) continue;  // Não enviar para si mesmo
        if(target.map != source.map) continue;  // Mesmo mapa

        // Calcular distância
        float dx = target.x - source.x;
        float dy = target.y - source.y;
        float distance = sqrt(dx * dx + dy * dy);

        // Enviar se estiver dentro do alcance
        if(distance <= range) {
            send_reliable(target.peer_id, message, 0);
        }
    }
}

// ============================================================
// HANDLERS DE PROTOCOLO JSON
// ============================================================

// Handler: Sincronização completa do inventário
void handle_inv_request_sync(player@ p) {
    if(@p == null) return;

    debug_log("📦 INV_SYNC: " + p.name + " solicitou sincronização completa");

    // Enviar inventário completo em JSON
    string json_inventory = inventory_to_json(p);
    send_reliable(p.peer_id, json_inventory, 0);

    debug_log("  ✓ Inventário enviado: " + p.inv.get_keys().length() + " tipos de itens");
}

// Handler: Usar item (versão JSON)
void handle_inv_use_json(player@ p, int slot) {
    if(@p == null) return;

    debug_log("💊 INV_USE_JSON: " + p.name + " usando slot " + slot);

    // Obter item no slot (simplificado - usar índice do array de keys)
    string[] item_names = p.inv.get_keys();

    if(slot < 0 || slot >= int(item_names.length())) {
        send_reliable(p.peer_id, create_inv_result_json(false, "Slot inválido"), 0);
        return;
    }

    string item_name = item_names[slot];
    int quantity = 0;
    p.inv.get(item_name, quantity);

    if(quantity <= 0) {
        send_reliable(p.peer_id, create_inv_result_json(false, "Item esgotado"), 0);
        return;
    }

    // TODO: Aplicar efeito do item (cura, buff, etc.)
    // Por enquanto, apenas remove 1 unidade
    quantity--;

    if(quantity > 0) {
        p.inv.set(item_name, quantity);
    } else {
        p.inv.delete(item_name);
    }

    // Atualização incremental
    string update_msg = create_inv_update_json(slot, quantity > 0 ? item_name : "", quantity);
    send_reliable(p.peer_id, update_msg, 0);

    // Resultado de sucesso
    send_reliable(p.peer_id, create_inv_result_json(true), 0);

    // Salvar no banco
    save_player_to_database(p);

    debug_log("  ✓ Item usado: " + item_name + " (restam " + quantity + ")");
}

// Handler: Mover item entre slots
void handle_inv_move_json(player@ p, int from_slot, int to_slot) {
    if(@p == null) return;

    debug_log("🔄 INV_MOVE_JSON: " + p.name + " movendo " + from_slot + " → " + to_slot);

    string[] item_names = p.inv.get_keys();

    if(from_slot < 0 || from_slot >= int(item_names.length())) {
        send_reliable(p.peer_id, create_inv_result_json(false, "Slot origem inválido"), 0);
        return;
    }

    // NOTA: Movimento real de slots requer sistema de slots fixos
    // Por enquanto, apenas confirma a operação
    send_reliable(p.peer_id, create_inv_result_json(true), 0);

    debug_log("  ✓ Movimento confirmado (sistema de slots simplificado)");
}

// Handler: Dropar item
void handle_inv_drop_json(player@ p, int slot, int quantity) {
    if(@p == null) return;

    debug_log("📤 INV_DROP_JSON: " + p.name + " dropando slot " + slot + " x" + quantity);

    string[] item_names = p.inv.get_keys();

    if(slot < 0 || slot >= int(item_names.length())) {
        send_reliable(p.peer_id, create_inv_result_json(false, "Slot inválido"), 0);
        return;
    }

    string item_name = item_names[slot];
    int current = 0;
    p.inv.get(item_name, current);

    if(current < quantity) {
        send_reliable(p.peer_id, create_inv_result_json(false, "Quantidade insuficiente"), 0);
        return;
    }

    // Remover do inventário
    current -= quantity;
    if(current > 0) {
        p.inv.set(item_name, current);
    } else {
        p.inv.delete(item_name);
    }

    // TODO: Criar objeto no chão (requer sistema de itens dropados)

    // Atualização incremental
    string update_msg = create_inv_update_json(slot, current > 0 ? item_name : "", current);
    send_reliable(p.peer_id, update_msg, 0);

    // Resultado de sucesso
    send_reliable(p.peer_id, create_inv_result_json(true), 0);

    // Broadcast para players próximos
    string broadcast_msg = create_inv_broadcast_drop_json(p.name, item_name, p.x, p.y, quantity);
    broadcast_inventory_change(p, broadcast_msg);

    // Salvar no banco
    save_player_to_database(p);

    debug_log("  ✓ Item dropado: " + item_name + " x" + quantity);
}

// ============================================================
// DISPATCHER DE MENSAGENS JSON
// ============================================================

// Parser simples de JSON (extrai campos básicos)
string json_get_type(string json) {
    // Extrair tipo: "type":"inv_use" → inv_use
    int type_pos = json.find("\"type\":");
    if(type_pos < 0) return "";

    int quote1 = json.find("\"", type_pos + 7);
    if(quote1 < 0) return "";

    int quote2 = json.find("\"", quote1 + 1);
    if(quote2 < 0) return "";

    return json.substr(quote1 + 1, quote2 - quote1 - 1);
}

int json_get_int(string json, string field) {
    // Extrair inteiro: "slot":3 → 3
    string search = "\"" + field + "\":";
    int pos = json.find(search);
    if(pos < 0) return -1;

    int start = pos + search.length();
    int end = start;

    // Encontrar fim do número
    while(end < int(json.length())) {
        string c = json.substr(end, 1);
        if(c >= "0" && c <= "9") {
            end++;
        } else {
            break;
        }
    }

    if(end == start) return -1;
    return parse_int(json.substr(start, end - start));
}

// Dispatcher principal para mensagens JSON de inventário
void dispatch_inventory_json(player@ p, string json_message) {
    if(@p == null) return;

    string msg_type = json_get_type(json_message);

    if(msg_type == "inv_request_sync") {
        handle_inv_request_sync(p);
    }
    else if(msg_type == "inv_use") {
        int slot = json_get_int(json_message, "slot");
        handle_inv_use_json(p, slot);
    }
    else if(msg_type == "inv_move") {
        int from = json_get_int(json_message, "from");
        int to = json_get_int(json_message, "to");
        handle_inv_move_json(p, from, to);
    }
    else if(msg_type == "inv_drop") {
        int slot = json_get_int(json_message, "slot");
        int quantity = json_get_int(json_message, "quantity");
        if(quantity <= 0) quantity = 1;
        handle_inv_drop_json(p, slot, quantity);
    }
    else {
        debug_log("⚠️ Tipo de mensagem JSON desconhecido: " + msg_type);
        send_reliable(p.peer_id, create_inv_result_json(false, "Unknown message type"), 0);
    }
}

// ============================================================
// FUNÇÕES AUXILIARES
// ============================================================

// Validar slot
bool is_valid_slot(player@ p, int slot) {
    if(@p == null) return false;
    string[] items = p.inv.get_keys();
    return slot >= 0 && slot < int(items.length());
}

// Adicionar item ao inventário (com sincronização automática)
bool add_item_with_sync(player@ p, string item_name, int quantity) {
    if(@p == null) return false;

    int current = 0;
    bool exists = p.inv.exists(item_name);

    if(exists) {
        p.inv.get(item_name, current);
    }

    p.inv.set(item_name, current + quantity);

    // Sincronização automática
    string[] items = p.inv.get_keys();
    for(uint i = 0; i < items.length(); i++) {
        if(items[i] == item_name) {
            int new_qty = 0;
            p.inv.get(item_name, new_qty);
            string update = create_inv_update_json(i, item_name, new_qty);
            send_reliable(p.peer_id, update, 0);
            break;
        }
    }

    // Salvar no banco
    save_player_to_database(p);

    return true;
}

// Remover item do inventário (com sincronização automática)
bool remove_item_with_sync(player@ p, string item_name, int quantity) {
    if(@p == null) return false;

    if(!p.inv.exists(item_name)) return false;

    int current = 0;
    p.inv.get(item_name, current);

    if(current < quantity) return false;

    // Encontrar slot antes de remover
    string[] items = p.inv.get_keys();
    int slot = -1;
    for(uint i = 0; i < items.length(); i++) {
        if(items[i] == item_name) {
            slot = i;
            break;
        }
    }

    current -= quantity;
    if(current > 0) {
        p.inv.set(item_name, current);
    } else {
        p.inv.delete(item_name);
    }

    // Sincronização automática
    if(slot >= 0) {
        string update = create_inv_update_json(slot, current > 0 ? item_name : "", current);
        send_reliable(p.peer_id, update, 0);
    }

    // Salvar no banco
    save_player_to_database(p);

    return true;
}
