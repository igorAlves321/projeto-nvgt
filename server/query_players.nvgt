#pragma plugin nvgt_sqlite
#include "sqlite3constants.nvgt"

void main() {
    // Abre o banco (MESMO caminho que o servidor usa)
    sqlite3 db("database/ig.db");
    
    // Conta total de jogadores
    sqlite3statement@ stmt_count = db.prepare("SELECT COUNT(*) FROM players;");
    int total = 0;
    
    if(stmt_count.step() == SQLITE_ROW) {
        total = stmt_count.column_int(0);
    }
    
    screen_reader_speak("Total de contas: " + total, true);
    
    // Lista os jogadores
    sqlite3statement@ stmt_list = db.prepare("SELECT username, email, level, gold FROM players LIMIT 10;");
    
    string resultado = "BANCO DE DADOS - JOGADORES CADASTRADOS\n\n";
    resultado += "Total de contas: " + total + "\n\n";
    
    if(total > 0) {
        resultado += "Primeiros 10 jogadores:\n";
        resultado += "â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•\n\n";
        
        int count = 1;
        while(stmt_list.step() == SQLITE_ROW) {
            string username = stmt_list.column_text(0);
            string email = stmt_list.column_text(1);
            int level = stmt_list.column_int(2);
            int gold = stmt_list.column_int(3);
            
            resultado += count + ". " + username + "\n";
            resultado += "   Email: " + email + "\n";
            resultado += "   Level: " + level + " | Gold: " + gold + "\n\n";
            count++;
        }
    } else {
        resultado += "âš ï¸ Nenhum jogador cadastrado ainda.\n";
        resultado += "O banco está vazio (mas funcional).\n";
    }
    
    alert("Jogadores no Banco", resultado);
}


