// Inicialização do banco de dados
bool init_database() {
    debug_log("Inicializando banco de dados SQLite");
    
    // Criar diretório database se não existir
    if(!directory_exists("database")) {
        debug_log("Criando diretório database/");
        directory_create("database");
    }
    
    // Usar caminho relativo correto
    string db_path = "database/ig.db";
    debug_log("Abrindo banco de dados: " + db_path);
    
    @bancoJogo = sqlite3();
    if(@bancoJogo == null) {
        debug_log("ERRO: Não foi possível criar instância sqlite3");
        return false;
    }
    
    int result = bancoJogo.open(db_path);
    debug_log("Resultado do open(): " + result + " (SQLITE_OK=" + SQLITE_OK + ")");
    
    if(result != SQLITE_OK) {
        debug_log("ERRO: Não foi possível abrir banco de dados: " + bancoJogo.get_last_error_text());
        return false;
    }
    
    debug_log("Banco de dados aberto com sucesso, criando tabelas...");
    
    // Criar tabelas se não existirem
    create_database_tables();
    
    database_initialized = true;
    debug_log("Banco de dados inicializado com sucesso");
    
    // [OK] Criar tabela de cargos/permissoes (depois de database_initialized = true)
    create_roles_table();
    
    // [OK] Migracao SQL: Inicializar tabela de banimentos
    init_bans_table();
    migrate_legacy_bans(); // Migra banidos.dat e tempbans.usr para SQLite
    
    return true;
}

// Criar estrutura do banco de dados
void create_database_tables() {
    // [OK] Epic 1 Task 2: Tabela de jogadores expandida com todos os dados necessarios
    string create_players = """
        CREATE TABLE IF NOT EXISTS players (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            password_salt TEXT DEFAULT '',
            email TEXT,
            gender INTEGER DEFAULT 0,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            last_login DATETIME,

            -- Dados do jogo
            level INTEGER DEFAULT 1,
            experience INTEGER DEFAULT 0,
            xp_requerida INTEGER DEFAULT 100,
            gold INTEGER DEFAULT 100,
            hp INTEGER DEFAULT 100,
            max_hp INTEGER DEFAULT 100,
            mp INTEGER DEFAULT 50,
            max_mp INTEGER DEFAULT 50,
            race TEXT DEFAULT 'humano',

            -- Localização
            map_name TEXT DEFAULT 'test',
            x INTEGER DEFAULT 0,
            y INTEGER DEFAULT 0,
            z INTEGER DEFAULT 0,

            -- Status
            is_admin BOOLEAN DEFAULT FALSE,
            is_banned BOOLEAN DEFAULT FALSE,
            is_online BOOLEAN DEFAULT FALSE,
            last_activity DATETIME DEFAULT CURRENT_TIMESTAMP,

            -- Inventário e Equipamentos (JSON serializado)
            inventory TEXT DEFAULT '{}',
            equipment TEXT DEFAULT '{}',

            -- Estatísticas de jogo
            play_time INTEGER DEFAULT 0,
            deaths INTEGER DEFAULT 0,
            kills INTEGER DEFAULT 0,
            matou INTEGER DEFAULT 0,
            arena_wins INTEGER DEFAULT 0,
            arena_kills INTEGER DEFAULT 0,
            reencarnacoes INTEGER DEFAULT 0,

            -- Economia
            stryx REAL DEFAULT 0,
            creditos REAL DEFAULT 0,
            saldo REAL DEFAULT 100,
            gcoins INTEGER DEFAULT 0,
            greais INTEGER DEFAULT 0,

            -- Sistema de Bounty
            bounty_on_head INTEGER DEFAULT 0,
            bounty_value INTEGER DEFAULT 0,
            bounty_owner TEXT DEFAULT '',

            -- Título e Rank
            title TEXT DEFAULT '',
            rank INTEGER DEFAULT 0,

            -- Status/Condições
            stamina INTEGER DEFAULT 100,
            fome INTEGER DEFAULT 0,
            sanity REAL DEFAULT 100.0,
            radiation INTEGER DEFAULT 0,

            -- Configurações do Jogador
            voice_id TEXT DEFAULT 'default',
            idioma_chat TEXT DEFAULT 'pt',

            -- IDs Sociais
            guild_id INTEGER DEFAULT 0,
            party_id INTEGER DEFAULT 0
        );
    """;
    
    // Tabela de logs do servidor
    string create_logs = """
        CREATE TABLE IF NOT EXISTS server_logs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
            level TEXT NOT NULL,  -- INFO, WARNING, ERROR, DEBUG
            category TEXT NOT NULL,  -- NETWORK, PLAYER, GAME, SYSTEM
            message TEXT NOT NULL,
            player_id INTEGER,
            additional_data TEXT,
            FOREIGN KEY (player_id) REFERENCES players(id)
        );
    """;
    
    // Tabela de sessões ativas
    string create_sessions = """
        CREATE TABLE IF NOT EXISTS player_sessions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            player_id INTEGER NOT NULL,
            peer_id TEXT NOT NULL,
            login_time DATETIME DEFAULT CURRENT_TIMESTAMP,
            last_activity DATETIME DEFAULT CURRENT_TIMESTAMP,
            ip_address TEXT,
            is_active BOOLEAN DEFAULT TRUE,
            FOREIGN KEY (player_id) REFERENCES players(id)
        );
    """;
    
    // Tabela de configurações do servidor
    string create_config = """
        CREATE TABLE IF NOT EXISTS server_config (
            key TEXT PRIMARY KEY,
            value TEXT NOT NULL,
            description TEXT,
            last_modified DATETIME DEFAULT CURRENT_TIMESTAMP
        );
    """;
    
    // Executar criação das tabelas
    if(bancoJogo.execute(create_players) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela players: " + bancoJogo.get_last_error_text());
    }
    
    if(bancoJogo.execute(create_logs) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela server_logs: " + bancoJogo.get_last_error_text());
    }
    
    if(bancoJogo.execute(create_sessions) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela player_sessions: " + bancoJogo.get_last_error_text());
    }
    
    if(bancoJogo.execute(create_config) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela server_config: " + bancoJogo.get_last_error_text());
    }
    
    // Criar tabela de inventário inicial
    string create_initial_inv = """
        CREATE TABLE IF NOT EXISTS initial_inventory (
            item_name TEXT PRIMARY KEY,
            quantity INTEGER DEFAULT 1
        );
    """;
    
    if(bancoJogo.execute(create_initial_inv) != SQLITE_OK) {
        debug_log("ERRO ao criar tabela initial_inventory: " + bancoJogo.get_last_error_text());
    }
    
    // Popular com itens padrão se estiver vazia
    populate_initial_inventory();
    
    debug_log("Tabelas do banco de dados criadas/verificadas");
    
    // Migrar banco de dados se necessário (adicionar colunas faltantes)
    migrate_database();
}

// Função de migração para adicionar colunas faltantes em bancos existentes
void migrate_database() {
    // Lista de colunas que podem estar faltando em bancos antigos
    string[][] migrations = {
        // {nome_coluna, tipo, valor_default}
        {"password_salt", "TEXT", "''"},
        {"stryx", "REAL", "0"},
        {"creditos", "REAL", "0"},
        {"saldo", "REAL", "100"},
        {"gcoins", "INTEGER", "0"},
        {"greais", "INTEGER", "0"},
        {"xp_requerida", "INTEGER", "100"},
        {"matou", "INTEGER", "0"},
        {"reencarnacoes", "INTEGER", "0"},
        {"stamina", "INTEGER", "100"},
        {"fome", "INTEGER", "0"},
        {"sanity", "REAL", "100.0"},
        {"radiation", "INTEGER", "0"},
        {"voice_id", "TEXT", "'default'"},
        {"idioma_chat", "TEXT", "'pt'"},
        {"guild_id", "INTEGER", "0"},
        {"party_id", "INTEGER", "0"},
        {"bounty_on_head", "INTEGER", "0"},
        {"bounty_value", "INTEGER", "0"},
        {"bounty_owner", "TEXT", "''"},
        {"title", "TEXT", "''"},
        {"rank", "INTEGER", "0"},
        {"arena_wins", "INTEGER", "0"},
        {"arena_kills", "INTEGER", "0"},
        {"kills", "INTEGER", "0"},
        {"deaths", "INTEGER", "0"},
        {"play_time", "INTEGER", "0"}
    };
    
    int migrations_applied = 0;
    
    for(uint i = 0; i < migrations.length(); i++) {
        string col_name = migrations[i][0];
        string col_type = migrations[i][1];
        string col_default = migrations[i][2];
        
        // Tentar adicionar a coluna - se já existir, vai falhar silenciosamente
        string alter_query = "ALTER TABLE players ADD COLUMN " + col_name + " " + col_type + " DEFAULT " + col_default + ";";
        
        // Executar sem verificar erro (coluna já existente gera erro, mas é OK)
        int result = bancoJogo.execute(alter_query);
        if(result == SQLITE_OK) {
            debug_log("MIGRACAO: Coluna '" + col_name + "' adicionada a tabela players");
            migrations_applied++;
        }
        // Se falhar é porque já existe, não precisa logar
    }
    
    if(migrations_applied > 0) {
        debug_log("MIGRACAO: " + migrations_applied + " colunas adicionadas ao banco de dados");
    }
}

// Popular tabela initial_inventory com itens padrão se estiver vazia
void populate_initial_inventory() {
    // Primeiro, limpar a tabela para garantir que está atualizada
    bancoJogo.execute("DELETE FROM initial_inventory;");
    
    debug_log("Populando tabela initial_inventory com itens padrão...");
    
    // Itens iniciais padrão (Start Kit)
    // 1 faca para defesa básica
    bancoJogo.execute("INSERT OR IGNORE INTO initial_inventory VALUES ('faca', 1);");
    // 200 reais para economia inicial
    bancoJogo.execute("INSERT OR IGNORE INTO initial_inventory VALUES ('reais', 200);");
    
    debug_log("[OK] Inventario inicial configurado: 1 faca, 200 reais");
}

// Logging no banco de dados (thread-safe)
void log_to_database(string level, string category, string message, int player_id = -1, string additional_data = "") {
    if(!database_initialized) return;
    
    // Implementação de threading
    async<void>(log_to_database_async, level, category, message, player_id, additional_data);
}

void log_to_database_async(string level, string category, string message, int player_id, string additional_data) {
    if(!database_initialized) return;
    
    string query = """
        INSERT INTO server_logs (level, category, message, player_id, additional_data)
        VALUES (?, ?, ?, ?, ?);
    """;
    
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt != null) {
        stmt.bind_text(1, level);
        stmt.bind_text(2, category);
        stmt.bind_text(3, message);
        
        if(player_id > 0) {
            stmt.bind_int(4, player_id);
        } else {
            stmt.bind_null(4);
        }
        
        stmt.bind_text(5, additional_data);
        
        if(stmt.step() != SQLITE_DONE) {
            debug_log("ERRO ao inserir log no banco: " + bancoJogo.get_last_error_text());
        }
    }
}

// Salvar dados do jogador no banco (async)
void save_player_to_database(player@ player) {
    if(!database_initialized || player is null) return;
    
    // 1. Salvar dados básicos (Stats, Posição) - async
    string save_name = player.charname;
    if(save_name == "") save_name = player.name;
    if(save_name == "") return;

    async<void>(save_player_to_database_async, save_name, player.player_level, player.exp,
                player.gold, player.hp, player.max_hp, player.mp, player.max_mp,
                player.race, player.map_name, player.x, player.y, player.z,
                player.admin_status, player.sexo);
    
    // 2. [OK] Salvar o Inventario Dinamico (IMPORTANTE!)
    // Isso garante que itens ganhos/perdidos durante o jogo sejam persistidos
    save_player_inventory_to_db(player);
    save_player_equipment_to_db(player);
}

void save_player_to_database_async(string name, int level, int exp, int gold, 
                                   int hp, int max_hp, int mp, int max_mp,
                                   string race, string map_name, int x, int y, int z,
                                   bool is_admin, int gender) {
    if(!database_initialized) return;

    int guild_id = 0;
    for(uint i = 0; i < active_guilds.length(); i++) {
        if(active_guilds[i] !is null && active_guilds[i].is_member(name)) {
            guild_id = int(i) + 1; // índice 1-based persistido no DB
            break;
        }
    }

    int party_id = 0;
    for(uint i = 0; i < active_parties.length(); i++) {
        if(active_parties[i] !is null && active_parties[i].is_member(name)) {
            party_id = int(i) + 1; // índice 1-based persistido no DB
            break;
        }
    }
    
    string query = """
        UPDATE players SET 
            level = ?, experience = ?, gold = ?, hp = ?, max_hp = ?,
            mp = ?, max_mp = ?, race = ?, map_name = ?, x = ?, y = ?, z = ?,
            is_admin = ?, gender = ?, guild_id = ?, party_id = ?, last_activity = CURRENT_TIMESTAMP
        WHERE username = ?;
    """;
    
    sqlite3statement@ stmt = bancoJogo.prepare(query);
    if(@stmt != null) {
        stmt.bind_int(1, level);
        stmt.bind_int(2, exp);
        stmt.bind_int(3, gold);
        stmt.bind_int(4, hp);
        stmt.bind_int(5, max_hp);
        stmt.bind_int(6, mp);
        stmt.bind_int(7, max_mp);
        stmt.bind_text(8, race);
        stmt.bind_text(9, map_name);
        stmt.bind_int(10, x);
        stmt.bind_int(11, y);
        stmt.bind_int(12, z);
        stmt.bind_int(13, is_admin ? 1 : 0);
        stmt.bind_int(14, gender);
        stmt.bind_int(15, guild_id);
        stmt.bind_int(16, party_id);
        stmt.bind_text(17, name);
        
        if(stmt.step() != SQLITE_DONE) {
            debug_log("ERRO ao salvar jogador no banco: " + bancoJogo.get_last_error_text());
        } else {
            debug_log("Jogador " + name + " salvo no banco de dados");
        }
    }
}

// Backup automático do banco (async)
void perform_database_backup() {
    if(async_backup_running) {
        debug_log("Backup já está em andamento, ignorando");
        return;
    }
    
    async_backup_running = true;
    // Implementação de threading
    async<void>(perform_database_backup_async);
}

void perform_database_backup_async() {
    debug_log("Iniciando backup automático do banco de dados");
    
    string backup_timestamp = datetime_now();
    backup_timestamp.replace_this(":", "_");
    backup_timestamp.replace_this(" ", "_");

    string backup_dir = "backups";
    string backup_file = backup_dir + "/evm_backup_" + backup_timestamp + ".db";
    
    // Criar diretório se não existir
    if(!directory_exists(backup_dir)) {
        directory_create(backup_dir);
    }
    
    string backup_sql = "VACUUM main INTO '" + backup_file + "';";
    if(bancoJogo.execute(backup_sql) == SQLITE_OK) {
        debug_log("Backup realizado com sucesso: " + backup_file);
        log_to_database("INFO", "SYSTEM", "Backup automático realizado", -1, backup_file);
    } else {
        debug_log("ERRO no backup: " + bancoJogo.get_last_error_text());
        log_to_database("ERROR", "SYSTEM", "Falha no backup automático", -1, bancoJogo.get_last_error_text());
    }
    
    async_backup_running = false;
}

// ============================================================================
// FUNCOES DE REBOOT/RESTART DO SERVIDOR (igual ao BGT)
// ============================================================================

// Salvar preferências e dados antes de reiniciar
void writeprefs(bool force_save = false) {
    debug_log("[SAVE] Salvando preferencias e dados de todos os jogadores...");
    
    for(uint i = 0; i < players.length(); i++) {
        if(@players[i] != null && players[i].name != "") {
            save_player_to_database(players[i]);
        }
    }
    
    debug_log("[SAVE] Todos os jogadores salvos");
}

// Reiniciar servidor imediatamente (igual ao BGT rebootfast)
void rebootfast() {
    debug_log("[REBOOT] REBOOT RAPIDO iniciado!");
    
    // Salvar todos os dados
    writeprefs(true);
    
    // Avisar clientes com som e mensagem antes do restart imediato
    send_reliable_text(0, "ps menuenter.ogg", 0);
    send_reliable_text(0, "msgnormal Reiniciando servidor agora!", 0);
    wait(700);

    // Avisar clientes para reiniciar
    send_reliable_text(0, "reiniciar", 0);
    
    wait(150);
    
    debug_log("[DEBUG] SCRIPT_COMPILED=" + (SCRIPT_COMPILED ? "true" : "false"));
    debug_log("[DEBUG] SCRIPT_EXECUTABLE=" + SCRIPT_EXECUTABLE);
    debug_log("[DEBUG] SCRIPT_CURRENT_FILE=" + SCRIPT_CURRENT_FILE);
    
    // Criar um batch file para reiniciar o servidor
    string bat_content = "@echo off\r\n";
    bat_content += "echo Aguardando servidor encerrar...\r\n";
    bat_content += "timeout /t 2 /nobreak > nul\r\n";
    bat_content += "echo Reiniciando servidor...\r\n";
    
    if(SCRIPT_COMPILED) {
        // Servidor compilado - executar diretamente
        bat_content += "start \"Servidor EVM\" \"" + SCRIPT_EXECUTABLE + "\"\r\n";
    } else {
        // Rodando do source - passar o arquivo nvgt
        bat_content += "start \"Servidor EVM\" \"" + SCRIPT_EXECUTABLE + "\" \"" + SCRIPT_CURRENT_FILE + "\"\r\n";
    }
    
    file f;
    if(f.open("restart_server.bat", "w")) {
        f.write(bat_content);
        f.close();
        debug_log("[DEBUG] Batch de restart criado");
    }
    
    // Iniciar o batch em background e sair
    // Usando urlopen como alternativa se run não funcionar
    debug_log("[DEBUG] Executando batch de restart...");
    
    // Tentar iniciar com cmd/start primeiro (mais confiável no Windows)
    bool started = run("cmd.exe", "/c start \"\" restart_server.bat", false, false);
    debug_log("[DEBUG] run() retornou: " + (started ? "true" : "false"));
    
    if(!started) {
        // Alternativa: executar o batch diretamente
        started = run("restart_server.bat", "", false, false);
        debug_log("[DEBUG] cmd.exe retornou: " + (started ? "true" : "false"));
    }
    
    debug_log("[DEBUG] Encerrando servidor atual...");
    exit();
}

// Reiniciar com countdown de 15 segundos (mais rápido)
void reboot_countdown() {
    debug_log("[REBOOT] REBOOT COM COUNTDOWN iniciado!");
    
    // 1. Salvar todos os dados PRIMEIRO (antes de qualquer aviso)
    writeprefs(true);
    
    // Avisar 15 segundos (usando som que certamente existe)
    send_reliable_text(0, "ps menuenter.ogg", 0); // Som de alerta
    send_reliable_text(0, "msgnormal [ALERTA] Reiniciando servidor em 15 segundos!", 0);
    wait(5000);
    
    // Avisar 10 segundos
    send_reliable_text(0, "ps menuenter.ogg", 0);
    send_reliable_text(0, "msgnormal [ALERTA] Reiniciando em 10 segundos!", 0);
    wait(5000);
    
    // Avisar 5 segundos
    send_reliable_text(0, "ps menuenter.ogg", 0);
    send_reliable_text(0, "msgnormal [ALERTA] Reiniciando em 5 segundos!", 0);
    wait(3000);
    
    // Contagem final: 2, 1
    send_reliable_text(0, "ps menuenter.ogg", 0);
    send_reliable_text(0, "msgnormal 2...", 0);
    wait(1000);
    
    send_reliable_text(0, "ps menuenter.ogg", 0);
    send_reliable_text(0, "msgnormal 1...", 0);
    wait(1000);
    
    // Reiniciar!
    send_reliable_text(0, "msgnormal [REBOOT] Reiniciando agora!", 0);
    rebootfast();
}

// Auto-save de todos os jogadores (async)
void auto_save_all_players() {
    if(async_save_running) {
        debug_log("Auto-save já está em andamento, ignorando");
        return;
    }
    
    async_save_running = true;
    // Implementação de threading
    async<void>(auto_save_all_players_async);
}

void auto_save_all_players_async() {
    debug_log("Iniciando auto-save de todos os jogadores");
    
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].is_logged_in) {
            save_player_to_database(players[i]);
            wait(10); // Pequena pausa entre saves para não sobrecarregar
        }
    }
    
    debug_log("Auto-save concluído para " + get_online_players().length() + " jogadores");
    log_to_database("INFO", "GAME", "Auto-save concluído", -1, "" + get_online_players().length() + " jogadores");
    
    async_save_running = false;
    last_save.restart();
}

// Funções auxiliares para jogadores (implementação básica)
player@ get_player_by_peer(uint64 peer_id) {
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].peer_id == peer_id) {
            return players[i];
        }
    }
    return null;
}

uint64 get_player_peer_id(player@ p) {
    if(p is null) return 0;
    return p.peer_id;
}

void update_all_players() {
    for(uint i = 0; i < players.length(); i++) {
        if(players[i] is null) continue;
        if(!players[i].is_logged_in) continue;

        try {
            players[i].playerloop();
        }
        catch {
            string player_name = players[i].name;
            if(player_name == "") player_name = players[i].charname;
            debug_log(
                "ERRO em playerloop para '" + player_name + "': " +
                get_exception_info() + " (" + get_exception_file() + ":" + get_exception_line() + ")"
            );
        }
    }
}

void remove_player(uint64 peer_id) {
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].peer_id == peer_id) {
            clear_all_buffs(players[i]);
            // Notificar outros jogadores no mesmo mapa
            int mapindex = players[i].mapindex;
            string charname = players[i].charname;
            
            if(mapindex >= 0 && mapindex < int(server_maps.length())) {
                server_maps[mapindex].send_to_others(peer_id, 0, 
                    "remove_player_from_map " + charname, true);
            }
            
            players.erase(i);
            break;
        }
    }
}

string[] get_online_players() {
    string[] online_list;
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].is_logged_in) {
            string online_name = players[i].charname != "" ? players[i].charname : players[i].name;
            online_list.push_back(online_name);
        }
    }
    return online_list;
}

// Broadcast mensagem para todos os jogadores em um mapa específico
void broadcast_to_map(string map_name, string message, uint64 exclude_peer = 0) {
    for(uint i = 0; i < players.length(); i++) {
        if(players[i].map_name == map_name && players[i].peer_id != exclude_peer) {
            send_reliable_text(players[i].peer_id, message, 0);
        }
    }
}

string[] split_non_empty_tokens(const string&in text) {
    string[] raw = text.split(" ");
    string[] tokens;
    for(uint i = 0; i < raw.length(); i++) {
        string t = raw[i].trim_whitespace();
        if(t != "") tokens.insert_last(t);
    }
    return tokens;
}

bool is_safe_packet_text(const string&in text) {
    if(text == "") return false;
    for(uint i = 0; i < text.length(); i++) {
        string ch = text.substr(i, 1);
        if(ch == "") return false;
        uint8 code = character_to_ascii(ch);
        if(code < 32 && code != 9 && code != 10 && code != 13) return false;
    }
    return true;
}

bool try_parse_int_token(const string&in token, int &out value) {
    string t = token.trim_whitespace();
    if(t == "") return false;

    uint start = 0;
    if(t[0] == '-' || t[0] == '+') {
        if(t.length() == 1) return false;
        start = 1;
    }

    for(uint i = start; i < t.length(); i++) {
        if(t[i] < '0' || t[i] > '9') return false;
    }

    value = parse_int(t);
    return true;
}

bool try_parse_float_token(const string&in token, double &out value) {
    string t = token.trim_whitespace();
    if(t == "") return false;

    uint start = 0;
    bool has_digit = false;
    bool has_dot = false;

    if(t[0] == '-' || t[0] == '+') {
        if(t.length() == 1) return false;
        start = 1;
    }

    for(uint i = start; i < t.length(); i++) {
        if(t[i] >= '0' && t[i] <= '9') {
            has_digit = true;
            continue;
        }
        if(t[i] == '.' && !has_dot) {
            has_dot = true;
            continue;
        }
        return false;
    }

    if(!has_digit) return false;
    value = parse_float(t);
    return true;
}

void reject_invalid_network_packet(uint64 peer_id, const string&in context, const string&in payload, bool disconnect_peer = false) {
    string safe_payload = payload;
    if(safe_payload.length() > MAX_NETWORK_LOG_PACKET_CHARS) {
        safe_payload = safe_payload.substr(0, MAX_NETWORK_LOG_PACKET_CHARS) + "... [TRUNCADO]";
    }
    debug_log("Pacote inválido [" + context + "] peer=" + peer_id + " payload=" + safe_payload);
    send_reliable_text(peer_id, "say Pacote inválido.", 0);
    if(disconnect_peer) force_disconnect_and_cleanup(peer_id, true);
}

bool is_valid_travel_destination(const string&in ticket_type, const string&in destination_map) {
    if(ticket_type == "passagema") {
        return destination_map == "ciudad_de_arduam" ||
               destination_map == "ciudad_de_stalwalquer" ||
               destination_map == "ciudad_de_san_ángel" ||
               destination_map == "ciudad_scorpion" ||
               destination_map == "ciudad_tornair";
    }
    if(ticket_type == "passagemb") {
        return destination_map == "estación_abandonada" ||
               destination_map == "reserva_de_la_estación" ||
               destination_map == "ciudad_lesnói" ||
               destination_map == "ciudad_telaman" ||
               destination_map == "pueblo_de_zaragoza";
    }
    if(ticket_type == "passagemo") {
        return destination_map == "playa";
    }
    return false;
}

int get_travel_ticket_price(const string&in ticket_type) {
    if(ticket_type == "passagema") return 500;
    if(ticket_type == "passagemb") return 250;
    if(ticket_type == "passagemo") return 150;
    return 0;
}

string get_default_travel_destination(const string&in ticket_type) {
    if(ticket_type == "passagemo") return "playa";
    return "";
}

string get_travel_transport_name(const string&in ticket_type) {
    if(ticket_type == "passagema") return "avião";
    if(ticket_type == "passagemb") return "trem";
    if(ticket_type == "passagemo") return "ônibus";
    return "transporte";
}

void handle_travel_ticket(int player_index, const string&in ticket_type, const string&in destination_arg) {
    if(player_index < 0 || player_index >= int(players.length())) return;

    string destination_map = destination_arg;
    if(destination_map == "") destination_map = get_default_travel_destination(ticket_type);

    int price = get_travel_ticket_price(ticket_type);
    if(price <= 0 || !is_valid_travel_destination(ticket_type, destination_map)) {
        send_reliable_text(players[player_index].peer_id, "msg2 ;Destino de passagem invalido.;", 0);
        return;
    }

    if(get_map_index_from(destination_map) < 0) {
        send_reliable_text(players[player_index].peer_id, "msg2 ;O destino escolhido ainda nao esta disponivel.;", 0);
        return;
    }

    if(players[player_index].afk || players[player_index].paralisado || players[player_index].paralisado2 || game_frozen) {
        send_reliable_text(players[player_index].peer_id, "msg2 ;Você não pode viajar agora.;", 0);
        return;
    }

    if(players[player_index].inv_item_number("reais") < price) {
        send_reliable_text(players[player_index].peer_id, "msg2 ;Você não tem reais suficientes para comprar esta passagem.;", 0);
        return;
    }

    players[player_index].inv_add_item("reais", -price, true);
    players[player_index].jaandou = 0;
    players[player_index].javoou = 0;
    players[player_index].noaviao = ticket_type == "passagema" ? 1 : 0;
    players[player_index].notrem = ticket_type == "passagemb" ? 1 : 0;
    players[player_index].maptraveltimer.restart();

    changemap(destination_map, player_index, 1, 0);
    send_reliable_text(players[player_index].peer_id, "msg2 ;Você compra a passagem de " + get_travel_transport_name(ticket_type) + " e chega ao destino.;", 0);
}

#include "includes/player_command_progression.nvgt"

// Processamento de comando de jogador
void process_player_command(uint64 peer_id, string command) {
    player@ player = get_player_by_peer(peer_id);
    if(player is null) {
        debug_log("Comando recebido de peer desconhecido: " + peer_id);
        return;
    }
    
    command = command.trim_whitespace();
    set_event_message(command);
    if(command == "") return;

    // Protocolo moderno (PREFIXO:payload) - delega para dispatcher novo
    if(is_modern_network_message(command)) {
        process_network_message(peer_id, command);
        return;
    }

    // Log do comando
    log_to_database("INFO", "PLAYER", "Comando: " + command, 0, player.name);
    
    // [OK] Task 1.5.3: Handler de Builder Mode (add_line::)
    // Formato: add_line::<dados_do_elemento>
    if(command.find("add_line::") == 0) {
        string element_data = command.substr(10);  // Remove "add_line::"
        req_builder_create_element(player, element_data);
        return;
    }

    // Undo do último elemento de builder
    // Formato: undo_last::<linha_original>
    if(command.find("undo_last::") == 0) {
        string line_hint = command.substr(11); // Remove "undo_last::"
        builder_undo_last_element(player, line_hint);
        return;
    }
    
    // [OK] Task 1.5.3: Handler de salvamento de mapa
    if(command == "/savemap" || command == "savemap") {
        map@ current_map = builder_get_player_map(player);
        builder_save_map(player, current_map);
        return;
    }
    
    // [OK] Task 1.5.3: Handler de atualizacao de mapa
    if(command == "/mapupdate" || command == "mapupdate") {
        builder_update_map(player);
        return;
    }

    // Compatibilidade Builder (BGT/NVGT): /mapupdate <mapa>
    if(command.find("/mapupdate ") == 0) {
        string[] parsed_update = split_non_empty_tokens(command);
        if(parsed_update.length() >= 2) {
            builder_update_map(player, parsed_update[1]);
        } else {
            builder_update_map(player);
        }
        return;
    }

    // Compatibilidade Builder: /rawdata <mapa> (tratado como atualização de mapa)
    if(command.find("/rawdata") == 0 || command.find("rawdata") == 0) {
        string[] parsed_raw = split_non_empty_tokens(command);
        if(parsed_raw.length() >= 2) {
            builder_update_map(player, parsed_raw[1]);
        } else {
            builder_update_map(player);
        }
        return;
    }

    // Criação de novo mapa: /newmap <nome> <largura> <altura> [som_piso]
    if(command.find("/newmap ") == 0 || command.find("newmap ") == 0) {
        string[] parsed_newmap = split_non_empty_tokens(command);
        if(parsed_newmap.length() < 4) {
            send_reliable_text(peer_id, "say Uso: /newmap <nome> <largura> <altura> [som_piso]", 0);
            return;
        }

        string map_name = parsed_newmap[1];
        int map_width = parse_int(parsed_newmap[2]);
        int map_height = parse_int(parsed_newmap[3]);
        string floor_sound = parsed_newmap.length() >= 5 ? parsed_newmap[4] : "1";
        builder_create_new_map(player, map_name, map_width, map_height, floor_sound);
        return;
    }

    // Remoção de mapa: /delmap <nome>
    if(command.find("/delmap ") == 0 || command.find("delmap ") == 0) {
        string[] parsed_delmap = split_non_empty_tokens(command);
        if(parsed_delmap.length() < 2) {
            send_reliable_text(peer_id, "say Uso: /delmap <nome>", 0);
            return;
        }
        builder_delete_map(player, parsed_delmap[1]);
        return;
    }
    
    // Verificar se o jogo está congelado
    if(game_frozen && !player.admin_status) {
        send_reliable_text(peer_id, "say Jogo temporariamente congelado. Aguarde.");
        return;
    }
    
    // ===== HEARTBEAT - Manter conexão viva =====
    // Cliente envia a cada 5 segundos para evitar timeout
    if(command == "heartbeat") {
        player.last_activity.restart();  // Atualiza timer de atividade
        // Não precisa responder - apenas registra atividade
        return;
    }
    
    // ===== BOUNTY MENU FLOW (compatibilidade com cliente legado) =====
    // 1) bounty_menu -> abre menu de jogadores elegiveis
    // 2) bounty_select_player <nome> -> solicita valor
    // 3) bounty value <valor> -> registra recompensa
    if(command == "bounty_menu") {
        int player_index = get_player_index_from(player.name);
        if(player_index < 0 || player.afk) return;

        string[] menu_items;
        for(uint i = 0; i < players.length(); i++) {
            if(int(i) == player_index) continue;
            if(players[i].peer_id == 0) continue;
            if(players[i].invs == 1) continue;
            if(players[i].bounty_on_head == 1) continue;

            string display_name = players[i].charname + " (Nivel " + int(players[i].level) + ")";
            menu_items.insert_last(display_name + "=" + players[i].charname);
        }

        if(menu_items.length() == 0) {
            send_reliable_text(peer_id, "msg2 ;Não ha jogadores disponiveis para colocar recompensa.;", 0);
            return;
        }

        string[] menu_sounds = {"menumove.ogg", "menuitem.ogg", "menuaccept.ogg", "menuback.ogg"};
        string packet = "servermenu ;Escolha o jogador para colocar recompensa:|bounty_select_player|0|" + linear(menu_items) + "|" + linear(menu_sounds);
        send_reliable_text(peer_id, packet, 0);
        return;
    }

    string[] bounty_parts = split_non_empty_tokens(command);
    if(bounty_parts.length() >= 2 && bounty_parts[0].lower() == "bounty_select_player") {
        int player_index = get_player_index_from(player.name);
        if(player_index < 0) return;

        string target_name = bounty_parts[1];
        int target_index = get_player_index_from(target_name);
        if(target_index < 0) {
            send_reliable_text(peer_id, "msg2 ;Jogador não encontrado.;", 0);
            return;
        }
        if(target_index == player_index) {
            send_reliable_text(peer_id, "msg2 ;Você não pode colocar recompensa em si mesmo.;", 0);
            return;
        }
        if(players[target_index].bounty_on_head == 1) {
            send_reliable_text(peer_id, "msg2 ;Este jogador ja possui uma recompensa ativa.;", 0);
            return;
        }
        if(players[target_index].pacifico == 1) {
            send_reliable_text(peer_id, "msg2 ;Este jogador está em modo pacifico e não pode receber recompensa.;", 0);
            return;
        }
        if(players[target_index].newbie) {
            send_reliable_text(peer_id, "msg2 ;Este jogador e novato e não pode receber recompensa.;", 0);
            return;
        }

        players[player_index].bounty_target = target_name;
        send_reliable_text(peer_id, "mtext ;Digite o valor da recompensa (minimo 100 moedas):|bounty value| |0", 0);
        return;
    }

    if(bounty_parts.length() >= 3 && bounty_parts[0].lower() == "bounty" && bounty_parts[1].lower() == "value") {
        int player_index = get_player_index_from(player.name);
        if(player_index < 0) return;

        if(players[player_index].bounty_target == "") {
            send_reliable_text(peer_id, "msg2 ;Nenhum alvo de recompensa selecionado.;", 0);
            return;
        }

        int bounty_value = 0;
        if(!try_parse_int_token(bounty_parts[2], bounty_value)) {
            send_reliable_text(peer_id, "msg2 ;Valor de recompensa inválido.;", 0);
            return;
        }

        int target_index = get_player_index_from(players[player_index].bounty_target);
        if(target_index < 0) {
            send_reliable_text(peer_id, "msg2 ;O jogador alvo desconectou.;", 0);
            return;
        }

        if(set_bounty(target_index, player_index, bounty_value)) {
            send_reliable_text(peer_id, "msg2 ;Recompensa colocada com sucesso!;", 0);
        }
        return;
    }

    // Usar sistema de comandos avançado
    if(!process_command(player, command)) {
        // Fallback para comandos básicos se não processado
        string[] parts = split_non_empty_tokens(command);
        if(parts.length() == 0) return;

        string cmd = parts[0].lower();
        
        // Obter índice do jogador para comandos que usam player_index
        int player_index = get_player_index_from(player.name);
        if(player_index < 0) return;

        if(cmd == "portallist") {
            getportal(player_index);
            return;
        }

        if(cmd == "usetele" && parts.length() == 4) {
            int destination_x = 0;
            int destination_y = 0;
            if(!try_parse_int_token(parts[2], destination_x) || !try_parse_int_token(parts[3], destination_y)) {
                reject_invalid_network_packet(peer_id, "process_player_command:usetele_xy", command);
                return;
            }

            string destination_map = parts[1];
            int current_map_index = get_map_index_from(player.map);
            int destination_map_index = get_map_index_from(destination_map);
            if(current_map_index < 0 || destination_map_index < 0) {
                send_reliable_text(peer_id, "msg2 ;Destino de portal invalido.;", 0);
                return;
            }

            if(players[player_index].inv_item_number("portal_de_luz") <= 0) {
                send_reliable_text(peer_id, "msg2 ;Você precisa de um portal de luz para fazer isso.;", 0);
                return;
            }

            if(player.afk || player.paralisado || player.paralisado2 || game_frozen) {
                send_reliable_text(peer_id, "msg2 ;Você não pode abrir um portal agora.;", 0);
                return;
            }

            if(server_maps[current_map_index].is_disabled("portal_de_luz")) {
                send_reliable_text(peer_id, "msg2 ;Portais de luz estão desativados neste mapa.;", 0);
                return;
            }

            if(players[player_index].teletimer.elapsed < 30000) {
                send_reliable_text(peer_id, "msg2 ;Aguarde para abrir outro portal.;", 0);
                return;
            }

            players[player_index].teletimer.restart();
            spawn_portal(player_index, player.x, player.y, player.map, destination_map, destination_x, destination_y);
            return;
        }

        if(cmd == "passagema" || cmd == "passagemb" || cmd == "passagemo") {
            string ticket_destination = parts.length() >= 2 ? parts[1] : "";
            handle_travel_ticket(player_index, cmd, ticket_destination);
            return;
        }

        // [OK] Phase 1: Zone Interaction Handler (zsa)
        if(cmd == "zsa") {
             // Reconstruct message from parts (excluding "zsa")
             string zsa_msg = "";
             if(parts.length() > 1) {
                 zsa_msg = command.substr(4); // "zsa " is 4 chars
             }
             process_zone_interaction(player_index, zsa_msg);
             return;
        }

        // [OK] Chat Administrativo - Comando adm (tecla D no cliente)
        if(cmd == "adm") {
            // Verificar se é staff
            bool is_staff = has_role(player.charname, "dev") || 
                            has_role(player.charname, "admin") || 
                            has_role(player.charname, "mod");
            
            if(is_staff && parts.length() > 1) {
                string message = command.substr(4);  // Remove "adm "
                string cargo = get_player_rank(player.charname, "");  // Pegar cargo (dev/admin/mod)
                string formatted_msg = cargo + " " + player.charname + ": " + message;
                eadm(formatted_msg);  // Usa assinatura de 2 params (msg, sound com default)
            }
            return;
        }

        // ===== COMANDO DE MOVIMENTO DO JOGADOR (Task 4) =====
        // Formato aceito: 
        //   move X Y           (3 partes - posição apenas)
        //   move step_sound X Y (4 partes - com som de passo)
        if(cmd == "move" && (parts.length() == 3 || parts.length() == 4)) {
            int new_x, new_y;
            string step_sound = "";
            
            if(parts.length() == 3) {
                // Formato: move X Y
                if(!try_parse_int_token(parts[1], new_x) || !try_parse_int_token(parts[2], new_y)) {
                    reject_invalid_network_packet(peer_id, "process_player_command:move_xy", command);
                    return;
                }
            } else {
                // Formato: move step_sound X Y
                step_sound = parts[1];
                if(!try_parse_int_token(parts[2], new_x) || !try_parse_int_token(parts[3], new_y)) {
                    reject_invalid_network_packet(peer_id, "process_player_command:move_step_xy", command);
                    return;
                }
            }
            
            // Validar jogador não está paralisado ou AFK
            if(player.paralisado || player.paralisado2 || player.afk) {
                send_reliable_text(peer_id, "msg2 ;Você não pode se mover agora.;", 0);
                return;
            }
            
            // Validar movimento não é muito grande (anti-cheat)
            if(!is_valid_movement(player.x, player.y, new_x, new_y, 10)) {
                debug_log("[WARN] Movimento inválido detectado para " + player.name + ": (" + player.x + "," + player.y + ") -> (" + new_x + "," + new_y + ")");
                send_reliable_text(peer_id, "move " + player.x + " " + player.y, 0); // Corrigir posição do cliente
                return;
            }
            
            // Verificar se a posição é caminhável (validação de colisão)
            if(!is_walkable(new_x, new_y, player.map_name)) {
                // Posição bloqueada - não mover
                send_reliable_text(peer_id, "move " + player.x + " " + player.y, 0); // Corrigir posição do cliente
                return;
            }
            
            // Obter tipo do tile para sons de passos (usa o enviado pelo cliente ou detecta)
            string tile_type = step_sound != "" ? step_sound : get_tile_at(new_x, new_y, player.map_name);
            
            // Usar a função move() da classe player (inclui toda a lógica de minas, zonas de morte, etc.)
            player.move(tile_type, new_x, new_y, 0);
            
            debug_log("[MOVE] " + player.name + " -> (" + new_x + ", " + new_y + ") [" + tile_type + "]");
            return;
        }
        
        // ===== COMANDO DE MOVIMENTO DURANTE SALTO/QUEDA (move2) =====
        // Formato: move2 X Y (atualiza posição com validação anti-cheat)
        if(cmd == "move2" && parts.length() == 3) {
            int new_x = 0;
            int new_y = 0;
            if(!try_parse_int_token(parts[1], new_x) || !try_parse_int_token(parts[2], new_y)) {
                reject_invalid_network_packet(peer_id, "process_player_command:move2_xy", command);
                return;
            }
            
            // [OK] ANTI-CHEAT: Validar movimento contra speedhack/teleporte
            if(!validate_movement(player, new_x, new_y)) {
                // Movimento invalido - enviar correção
                send_position_correction(player);
                return;
            }
            
            // Atualizar posição do jogador (durante salto/queda)
            player.x = new_x;
            player.y = new_y;
            
            // Broadcast para outros jogadores
            broadcast_to_map(player.map_name, "pp " + player.name + " " + new_x + " " + new_y, peer_id);
            return;
        }
        
        // ===== COMANDO DE ATERRISSAGEM (land) =====
        // Formato: land [altura_queda] (altura é opcional)
        if(cmd == "land") {
            int fall_height = 0;
            if(parts.length() >= 2) {
                if(!try_parse_int_token(parts[1], fall_height)) {
                    reject_invalid_network_packet(peer_id, "process_player_command:land_height", command);
                    return;
                }
            }
            // Por enquanto apenas log, pode implementar dano de queda depois
            if(fall_height >= 20) {
                debug_log("[LAND] " + player.name + " aterrissou de altura " + fall_height);
            }
            return;
        }
        
        // ===== COMANDO DE SALTO (jump) =====
        // Formato: jump [som.ogg]
        // Notifica outros jogadores que este jogador pulou
        if(cmd == "jump") {
            string jump_sound = (parts.length() >= 2) ? parts[1] : "jump.ogg";
            // Broadcast som de salto para outros jogadores no mapa
            broadcast_to_map(player.map_name, "play " + jump_sound + " " + player.x + " " + player.y, peer_id);
            return;
        }
        
        // ===== COMANDO DE SOM BROADCAST (draw) =====
        // Formato: draw som.ogg
        // Toca um som para outros jogadores no mesmo mapa
        if(cmd == "draw" && parts.length() >= 2) {
            string sound_file = parts[1];
            // Broadcast som para outros jogadores no mapa
            broadcast_to_map(player.map_name, "play " + sound_file + " " + player.x + " " + player.y, peer_id);
            return;
        }
        
        // ===== COMANDO DE SELECAO DE ARMA =====
        // Formato: select_weapon <indice>
        if(cmd == "select_weapon" && parts.length() >= 2) {
            int weapon_index = 0;
            if(!try_parse_int_token(parts[1], weapon_index)) {
                reject_invalid_network_packet(peer_id, "process_player_command:select_weapon_index", command);
                return;
            }
            player.weapon_index = weapon_index;
            return;
        }

        // ===== COMANDO DE TIRO (LEGADO BGT/NVGT) =====
        // Formato: a <weapon_index>
        if(cmd == "a" && parts.length() >= 2) {
            if(!pvp) return;

            int weapon_index = 0;
            if(!try_parse_int_token(parts[1], weapon_index)) {
                reject_invalid_network_packet(peer_id, "process_player_command:shoot_weapon_index", command);
                return;
            }
            if(weapon_index < 0 || weapon_index >= int(weapons_list.length())) {
                return;
            }

            weapon@ w = weapons_list[weapon_index];
            if(w is null) return;

            if(w.degradation_point > 0 && weapon_index > 0) {
                int degrade_roll = random(1, int(w.degradation_point));
                if(degrade_roll == int(w.degradation_point)) {
                    player.manage_degradation(w.name, 0.1);
                }
            }

            string shot_sound = w.sound_shoot;
            if(shot_sound != "" && !shot_sound.ends_with(".ogg")) {
                shot_sound += ".ogg";
            }
            if(shot_sound != "") {
                broadcast_to_map(player.map_name, "play " + shot_sound + " " + player.x + " " + player.y, peer_id);
            }

            int bullet_weapon_id = weapon_index + 1;
            int bullet_damage = int(w.damage);
            int bullet_range = int(w.distance);
            if(bullet_range <= 0) bullet_range = 500;
            if(bullet_damage <= 0) bullet_damage = 1;
            spawn_bullet(
                bullet_damage,
                bullet_range,
                player.x,
                player.y,
                player.lado,
                player.charname,
                bullet_weapon_id,
                player.map_name,
                20,
                shot_sound
            );
            return;
        }

        // ===== COMANDO DE RECARGA (LEGADO BGT/NVGT) =====
        // Formato: carregar <som_reload.ogg> <ammo_item> <quantidade>
        if(cmd == "carregar" && parts.length() >= 4) {
            string reload_sound = parts[1];
            string ammo_item = parts[2];
            int ammo_quantity = 0;

            if(ammo_item.trim_whitespace() == "" || !try_parse_int_token(parts[3], ammo_quantity) || ammo_quantity <= 0) {
                reject_invalid_network_packet(peer_id, "process_player_command:carregar_payload", command);
                return;
            }

            if(!remove_item_with_sync(player, ammo_item, ammo_quantity)) {
                send_reliable_text(peer_id, "say Falha ao recarregar: faltam itens de municao.", 0);
                return;
            }

            if(reload_sound != "") {
                broadcast_to_map(player.map_name, "play " + reload_sound + " " + player.x + " " + player.y, peer_id);
            }
            return;
        }

        // ===== COMANDO DE SOM SOCIAL (playsocial) =====
        // Formato: playsocial som.ogg
        // Toca um som para outros jogadores no mesmo mapa (usado ao fechar inventário, etc.)
        if(cmd == "playsocial" && parts.length() >= 2) {
            string sound_file = parts[1];
            // Broadcast som para outros jogadores no mapa (usando send_packet10 como no BGT)
            send_packet10(0, player.charname, player.charname, sound_file + " " + player.x + " " + player.y, player.map_name);
            return;
        }
        
        // ===== COMANDOS DE CONFIGURACAO (IMPLEMENTADOS) =====
        
        // setvoice - Configurar voz/narrador preferido
        if(cmd == "setvoice" && parts.length() >= 2) {
            string voice_name = parts[1];
            player.voice_id = voice_name;
            save_player_to_database(player);
            debug_log("[VOICE] Jogador " + player.name + " configurou voz: " + voice_name);
            // Não precisa responder - cliente já sabe
            return;
        }

        // uitem <item> - Compatibilidade com cliente BGT/NVGT (uso de item sem barra)
        if(cmd == "uitem" && parts.length() >= 2) {
            string item_name = command.substr(6).trim_whitespace(); // remove "uitem "

            // Compatibilidade antiga: "uitem r2" era usado para verificar hora
            if(item_name == "r2") {
                string[] empty_args;
                cmd_checktime(player, empty_args);
                return;
            }

            if(item_name == "mina" && !mines_enabled) {
                send_reliable_text(peer_id, "msgnormal Utilizacao de minas está desativada no momento.", 0);
                return;
            }

            // Fluxo atual de consumíveis
            use_item(player_index, item_name);
            return;
        }

        // Crafting: craft/forjar <item>
        if((cmd == "craft" || cmd == "/craft" || cmd == "forjar" || cmd == "/forjar") && parts.length() >= 2) {
            int item_start = command.find(parts[1]);
            if(item_start < 0) {
                reject_invalid_network_packet(peer_id, "process_player_command:craft_item_start", command);
                return;
            }
            string item_name = command.substr(item_start).trim_whitespace();
            if(item_name == "") {
                send_reliable_text(peer_id, "say Uso: /craft <item>", 0);
                return;
            }
            crafting_system.craft(player_index, item_name);
            return;
        }

        // Crafting: recipes [item]
        if(cmd == "recipes" || cmd == "/recipes") {
            string output = "";
            if(parts.length() >= 2) {
                output = crafting_system.show_recipe(parts[1].trim_whitespace());
            } else {
                output = crafting_system.list_all_recipes();
            }

            string[] lines = output.split("\n");
            for(uint i = 0; i < lines.length(); i++) {
                if(lines[i].trim_whitespace() != "") {
                    send_reliable_text(peer_id, "say " + lines[i], 0);
                }
            }
            return;
        }

        // Crafting: cancraft <item>
        if((cmd == "cancraft" || cmd == "/cancraft") && parts.length() >= 2) {
            string item_name = parts[1].trim_whitespace();
            if(item_name == "") {
                send_reliable_text(peer_id, "say Uso: /cancraft <item>", 0);
                return;
            }
            bool can = crafting_system.can_craft(player_index, item_name);
            if(can) send_reliable_text(peer_id, "say Você pode criar " + item_name + ".", 0);
            else send_reliable_text(peer_id, "say Você não pode criar " + item_name + " agora.", 0);
            return;
        }

        // Veiculos: entrar/sair/abastecer
        if(cmd == "entrar" || cmd == "/entrar") {
            string vtype = parts.length() >= 2 ? parts[1].trim_whitespace() : "";
            cmd_entrar(player_index, vtype);
            return;
        }
        if(cmd == "sair" || cmd == "/sair") {
            if(player.vehicle_type != "") {
                cmd_sair(player_index);
                return;
            }
        }
        if(cmd == "abastecer" || cmd == "/abastecer") {
            int qtd = 1;
            if(parts.length() >= 2) {
                if(!try_parse_int_token(parts[1], qtd)) {
                    send_reliable_text(peer_id, "say Quantidade invalida.", 0);
                    return;
                }
            }
            cmd_abastecer(player_index, qtd);
            return;
        }

        // Conversão de moedas (compatibilidade com menu cliente)
        // Regras iguais ao BGT: quantidade 1 é muito baixa, validar saldo do inventário
        if(cmd == "reaisparaeuro" && parts.length() >= 2) {
            int conversao = 0;
            if(!try_parse_int_token(parts[1], conversao)) {
                reject_invalid_network_packet(peer_id, "process_player_command:reaisparaeuro", command);
                return;
            }
            if(conversao <= 0) return;

            if(conversao == 1) {
                send_reliable_text(peer_id, "msgnormal Quantidade muito baixa para ser convertida.", 0);
                return;
            }

            if(player.inv_item_number("reais") >= conversao) {
                player.inv_add_item("reais", -conversao, true);
                player.inv_add_item("euro", conversao * 10, true);
                send_reliable_text(peer_id, "msgnormal Conversao de reais para euros feita com sucesso.", 0);
                save_player_to_database(player);
            } else {
                send_reliable_text(peer_id, "msgnormal Você não tem reais suficientes para fazer está conversao.", 0);
            }
            return;
        }

        if(cmd == "europarareais" && parts.length() >= 2) {
            int conversao = 0;
            if(!try_parse_int_token(parts[1], conversao)) {
                reject_invalid_network_packet(peer_id, "process_player_command:europarareais", command);
                return;
            }
            if(conversao <= 0) return;

            if(conversao == 1) {
                send_reliable_text(peer_id, "msgnormal Quantidade muito baixa para ser convertida.", 0);
                return;
            }

            if(player.inv_item_number("euro") >= conversao) {
                player.inv_add_item("euro", -conversao, true);
                player.inv_add_item("reais", conversao * 2, true);
                send_reliable_text(peer_id, "msgnormal Conversao de euros para reais feita com sucesso.", 0);
                save_player_to_database(player);
            } else {
                send_reliable_text(peer_id, "msgnormal Você não tem euros suficientes para converter.", 0);
            }
            return;
        }

        // /amina - Ativa/desativa uso de minas (compatibilidade menu admin)
        if(cmd == "amina" || cmd == "/amina") {
            if(!check_is_admin(player.charname) && !check_is_mod(player.charname) && !has_role(player.charname, "dev")) {
                send_reliable_text(peer_id, "say Você não tem permissao para usar este comando.", 0);
                return;
            }

            mines_enabled = !mines_enabled;
            if(mines_enabled) {
                send_reliable_text(0, "msgnormal Utilizacao de minas ativada.", 0);
                debug_log("ADMIN: " + player.charname + " ativou minas.");
            } else {
                send_reliable_text(0, "msgnormal Utilizacao de minas desativada.", 0);
                debug_log("ADMIN: " + player.charname + " desativou minas.");
            }
            return;
        }
        
        // hits - Toggle sons de impacto
        if(cmd == "hits") {
            player.ouvirhits = !player.ouvirhits;
            save_player_to_database(player);
            string status = player.ouvirhits ? "ativados" : "desativados";
            debug_log("[IMPACT] Jogador " + player.name + " - sons de impacto " + status);
            send_reliable_text(peer_id, "say Sons de impacto " + status, 0);
            return;
        }
        
        // idiomachat - Configurar idioma do chat
        if(cmd == "idiomachat" && parts.length() >= 2) {
            string language = parts[1];
            player.idiomachat = language;
            save_player_to_database(player);
            debug_log("[LANG] Jogador " + player.name + " configurou idioma: " + language);
            send_reliable_text(peer_id, "say Idioma do chat configurado: " + language, 0);
            return;
        }
        
        // dpassos - Desativar sons de passos
        if(cmd == "dpassos") {
            player.ouvirpassos = (player.ouvirpassos == 0) ? 1 : 0;
            save_player_to_database(player);
            string status = (player.ouvirpassos == 0) ? "desativados" : "ativados";
            debug_log("[STEPS] Jogador " + player.name + " - sons de passos " + status);
            send_reliable_text(peer_id, "say Sons de passos " + status, 0);
            return;
        }
        
        // ndor - Não ouvir mensagens de dor
        if(cmd == "ndor") {
            player.mdor = (player.mdor == 0) ? 1 : 0;
            save_player_to_database(player);
            string status = (player.mdor == 0) ? "ativadas" : "desativadas";
            debug_log("[PAIN] Jogador " + player.name + " - mensagens de dor " + status);
            send_reliable_text(peer_id, "say Mensagens de dor " + status, 0);
            return;
        }
        
        // nnivel - Não avisar subida de nivel
        if(cmd == "nnivel") {
            player.avisanivel = (player.avisanivel == 0) ? 1 : 0;
            save_player_to_database(player);
            string status = (player.avisanivel == 0) ? "ativados" : "desativados";
            debug_log("[LEVEL] Jogador " + player.name + " - avisos de nivel " + status);
            send_reliable_text(peer_id, "say Avisos de nivel " + status, 0);
            return;
        }
        
        // setsexo - Alterar genero do personagem (0=masculino, 1=feminino)
        if(cmd == "setsexo" && parts.length() > 1) {
            int new_sexo = 0;
            if(!try_parse_int_token(parts[1], new_sexo)) {
                send_reliable_text(peer_id, "say Uso: /setsexo 0 (masculino) ou /setsexo 1 (feminino)", 0);
                return;
            }
            if(new_sexo != 0 && new_sexo != 1) {
                send_reliable_text(peer_id, "say Uso: /setsexo 0 (masculino) ou /setsexo 1 (feminino)", 0);
                return;
            }
            player.sexo = new_sexo;
            player.sexo2 = (new_sexo == 0) ? "o" : "a";
            save_player_to_database(player);
            string genero = (new_sexo == 0) ? "masculino" : "feminino";
            send_reliable_text(peer_id, "say Seu genero foi alterado para " + genero + ".", 0);
            debug_log("Jogador " + player.name + " alterou genero para " + genero);
            return;
        }
        
        // getversion - Retornar versao do servidor
        if(cmd == "getversion") {
            send_reliable_text(peer_id, "version " + server_version, 0);
            debug_log("[INFO] Jogador " + player.name + " solicitou versão: " + server_version);
            return;
        }

        // uptime - Retornar tempo online do servidor (F1)
        if(cmd == "uptime") {
            uint64 uptime_ms = server_uptime.elapsed;
            int total_seconds = int(uptime_ms / 1000);
            int days = total_seconds / 86400;
            int hours = (total_seconds % 86400) / 3600;
            int minutes = (total_seconds % 3600) / 60;
            int seconds = total_seconds % 60;

            string uptime_msg = "Tempo online do servidor: ";
            if(days > 0) uptime_msg += days + " dia" + (days > 1 ? "s" : "") + ", ";
            if(hours > 0) uptime_msg += hours + " hora" + (hours > 1 ? "s" : "") + ", ";
            if(minutes > 0) uptime_msg += minutes + " minuto" + (minutes > 1 ? "s" : "") + ", ";
            uptime_msg += seconds + " segundo" + (seconds > 1 ? "s" : "");

            send_reliable_text(peer_id, "say " + uptime_msg, 0);
            debug_log("[UPTIME] " + player.name + " verificou uptime: " + days + "d " + hours + "h " + minutes + "m " + seconds + "s");
            return;
        }

        // getmotd - Retornar mensagem do dia (F2)
        if(cmd == "getmotd") {
            string motd = "Bem-vindo ao servidor IG! Versao " + server_version;
            send_reliable_text(peer_id, "say " + motd, 0);
            debug_log("[MOTD] " + player.name + " solicitou MOTD");
            return;
        }

        // ===== [OK] TASK 2.2: SISTEMA DE STANCE (AGACHAR/SENTAR) =====
        
        // crouched::on/off - Sistema de agachar (Shift+Space no cliente BGT)
        if(cmd == "crouched" && parts.length() >= 2) {
            string action = parts[1];
            if(action == "on") {
                player.crouched = true;
                debug_log("[CROUCH] " + player.name + " agachou");
                // Broadcast para outros jogadores no mesmo mapa
                broadcast_to_map(player.map_name, "crouched " + player.name + " on", peer_id);
            }
            else if(action == "off") {
                player.crouched = false;
                debug_log("[STAND] " + player.name + " levantou (de agachado)");
                broadcast_to_map(player.map_name, "crouched " + player.name + " off", peer_id);
            }
            return;
        }
        
        // Sistema alternativo: crouched::on e crouched::off (formato BGT original)
        if(command.find("crouched::") == 0) {
            string action = command.substr(10);  // Remove "crouched::"
            if(action == "on") {
                player.crouched = true;
                debug_log("[CROUCH] " + player.name + " agachou");
                broadcast_to_map(player.map_name, "crouched " + player.name + " on", peer_id);
            }
            else if(action == "off") {
                player.crouched = false;
                debug_log("[STAND] " + player.name + " levantou (de agachado)");
                broadcast_to_map(player.map_name, "crouched " + player.name + " off", peer_id);
            }
            return;
        }
        
        // sentar/levantar - Sistema de sentar (Z no cliente)
        // Cliente envia som "centar.ogg" ou "levantar.ogg" para sincronizar
        if(cmd == "sentar" || cmd == "sit") {
            if(!player.centado) {
                player.centado = true;
                debug_log("[SIT] " + player.name + " sentou");
                // Broadcast som de sentar para outros jogadores
                broadcast_to_map(player.map_name, "sound centar.ogg " + player.x + " " + player.y, peer_id);
            }
            return;
        }
        
        if(cmd == "levantar" || cmd == "stand") {
            if(player.centado) {
                player.centado = false;
                debug_log("[STAND] " + player.name + " levantou (de sentado)");
                broadcast_to_map(player.map_name, "sound levantar.ogg " + player.x + " " + player.y, peer_id);
            }
            return;
        }
        
        // Handler de som que também sincroniza estado (compatibilidade BGT)
        // Cliente envia: sound centar.ogg ou sound levantar.ogg
        if(cmd == "sound" && parts.length() >= 2) {
            string sound_name = parts[1];
            if(sound_name == "centar.ogg") {
                player.centado = true;
                debug_log("[SIT] " + player.name + " sentou (via som)");
            }
            else if(sound_name == "levantar.ogg") {
                player.centado = false;
                debug_log("[STAND] " + player.name + " levantou (via som)");
            }
            // Broadcast o som para outros jogadores
            int sound_x = player.x;
            int sound_y = player.y;
            if(parts.length() >= 3 && !try_parse_int_token(parts[2], sound_x)) {
                reject_invalid_network_packet(peer_id, "process_player_command:sound_x", command);
                return;
            }
            if(parts.length() >= 4 && !try_parse_int_token(parts[3], sound_y)) {
                reject_invalid_network_packet(peer_id, "process_player_command:sound_y", command);
                return;
            }
            broadcast_to_map(player.map_name, "sound " + sound_name + " " + sound_x + " " + sound_y, peer_id);
            return;
        }
        
        // ===== SISTEMA DE OBSERVAR JOGADOR (WATCH/SPECTATE) =====
        // olhar <jogador> - Começar a observar outro jogador
        if(cmd == "olhar" && parts.length() > 1) {
            // Verificar se é admin ou tem permissão
            if(!player.check_admin()) {
                send_reliable_text(peer_id, "say Você não tem permissao para observar jogadores.", 0);
                return;
            }
            
            string target_name = parts[1];
            
            // Se já está observando, parar primeiro
            if(player.watching == 1) {
                player.stop_watch();
            }
            
            // Iniciar observação
            player.watch_player(target_name);
            
            // Notificar outros admins
            eadm(player.charname + " está observando " + target_name + ".", "notifi10.ogg");
            debug_log("[WATCH] " + player.name + " comecou a observar " + target_name);
            return;
        }
        
        // volhar - Parar de observar
        if(cmd == "volhar") {
            if(player.watching == 1) {
                string was_watching = player.w_name;
                player.stop_watch();
                eadm(player.charname + " parou de observar " + was_watching + ".", "notifi10.ogg");
                debug_log("[WATCH] " + player.name + " parou de observar " + was_watching);
            }
            return;
        }

        // ===== FIM DOS COMANDOS DE CONFIGURACAO =====

        // ping - Responder ao ping do cliente
        if(cmd == "ping") {
            send_reliable_text(peer_id, "pong", 0);
            debug_log("[PING] Ping respondido para " + player.name);
            return;
        }
        
        // getplayers - Lista de todos jogadores online (tecla F5)
        if(cmd == "getplayers") {
            if(player.afk) return;
            
            string bell = "|";
            string bell2 = "||";
            string data = "";
            
            for(uint i = 0; i < players.length(); i++) {
                // Admin vê todos, outros não veem invisíveis
                if(player.check_admin() || players[i].invs != 1) {
                    // Usar get_player_rank_by_index para obter patente dinâmica (considera roles)
                    string rank = get_player_rank_by_index(i);
                    data += players[i].charname + bell + rank + bell + players[i].seestatus + bell2;
                }
            }
            
            send_reliable_text(peer_id, "listplayers " + data, 0);
            debug_log("[PLAYERS] " + player.name + " solicitou lista de jogadores (" + players.length() + " online)");
            return;
        }
        
        // ============================================================================
        // J1-J4: Informações de jogadores (F1-F4 no menu de jogadores)
        // ============================================================================
        
        // j1 - Ver localização do jogador (F1)
        if(cmd == "j1" && parts.length() > 1) {
            string target_name = parts[1];
            int id = get_player_index_from(target_name);
            
            if(id > -1) {
                string map_name = players[id].map;
                send_reliable_text(peer_id, "msg2 " + players[id].charname + " ;está em; ;" + map_name + ";.", 0);
                debug_log("[WHERE] " + player.name + " verificou localizacao de " + target_name + ": " + map_name);
            } else {
                send_reliable_text(peer_id, "say Jogador não encontrado.", 0);
            }
            return;
        }
        
        // j2 - Ver nível e patente do jogador (F2)
        if(cmd == "j2" && parts.length() > 1) {
            string target_name = parts[1];
            int id = get_player_index_from(target_name);
            
            if(id > -1) {
                // Usar get_player_rank_by_index para obter patente dinâmica (considera roles admin)
                string title_text = get_player_rank_by_index(id);
                send_reliable_text(peer_id, "msg2 " + players[id].charname + " ;está no nível; " + players[id].level + ", ;e na patente; ;" + title_text + ";.", 0);
                debug_log("[LEVEL] " + player.name + " verificou nivel de " + target_name + ": Lv" + players[id].level);
            } else {
                send_reliable_text(peer_id, "say Jogador não encontrado.", 0);
            }
            return;
        }
        
        // j3 - Ver quantas pessoas o jogador matou (F3)
        if(cmd == "j3" && parts.length() > 1) {
            string target_name = parts[1];
            int id = get_player_index_from(target_name);
            
            if(id > -1) {
                string m = "";
                int kills = players[id].matou;
                
                if(kills == 0) {
                    m = players[id].charname + " ;ainda não matou ninguém;";
                } else if(kills == 1) {
                    m = players[id].charname + " ;matou; 1 ;pessoa;";
                } else {
                    m = players[id].charname + " ;matou; " + kills + " ;pessoas;";
                }
                
                send_reliable_text(peer_id, "msg2 " + m + ".", 0);
                debug_log("[KILLS] " + player.name + " verificou kills de " + target_name + ": " + kills);
            } else {
                send_reliable_text(peer_id, "say Jogador não encontrado.", 0);
            }
            return;
        }
        
        // j4 - Ver em qual chat o jogador está (F4)
        if(cmd == "j4" && parts.length() > 1) {
            string target_name = parts[1];
            int id = get_player_index_from(target_name);
            
            if(id > -1) {
                string chat_name = players[id].idiomachat;
                if(chat_name == "" || chat_name == "Desativado") {
                    send_reliable_text(peer_id, "msg2 " + players[id].charname + " ;está com o chat desativado;.", 0);
                } else {
                    send_reliable_text(peer_id, "msg2 " + players[id].charname + " ;está no chat; ;" + chat_name + ";.", 0);
                }
                debug_log("[CHAT] " + player.name + " verificou chat de " + target_name + ": " + chat_name);
            } else {
                send_reliable_text(peer_id, "say Jogador não encontrado.", 0);
            }
            return;
        }
        
        // healthcheck - Retornar HP/MP do jogador (tecla S)
        if(cmd == "healthcheck") {
            string health_msg = player.hp + "/" + player.max_hp;
            send_reliable_text(peer_id, "say " + health_msg, 0);
            debug_log("[HP] " + player.name + " verificou saude: HP=" + player.hp + "/" + player.max_hp);
            return;
        }
        
        // turn - Rotação do jogador (Shift + setas)
        if(cmd == "turn" && parts.length() > 1) {
            int new_facing = 0;
            if(!try_parse_int_token(parts[1], new_facing)) {
                reject_invalid_network_packet(peer_id, "process_player_command:turn_facing", command);
                return;
            }
            player.facing = new_facing;
            // Notificar outros jogadores no mapa sobre a rotação
            // (silencioso - não precisa responder ao cliente)
            return;
        }
        
        // lc - Level Check - Retornar nível e estatísticas (tecla V)
        if(cmd == "lc") {
            // Determinar sufixo baseado no sexo (0=masculino, 1=feminino)
            string sufixo = (player.sexo == 0) ? "o" : "a";
            
            // Usar função centralizada para obter patente (considera roles admin + título por kills)
            string patente = get_player_rank(player.charname, player.title);
            
            // Construir mensagem (UTF-8 normal)
            string stats_msg = "Você está no nível; " + int(player.level);
            
            // Adicionar remorte se > 0
            if(player.reencarnou > 0) {
                stats_msg += ", ;no remorte; " + player.reencarnou;
            }
            
            // Adicionar patente
            stats_msg += " ;e na patente; ;" + patente + ";. ;";
            
            // Estatísticas
            stats_msg += "Você está com; ;" + int(player.nsede) + "% ;de sede;, ";
            stats_msg += int(player.nfome) + "% ;de fome;, ";
            
            // Cansaço (stamina invertido)
            int cansaco = 100 - player.stamina;
            if(cansaco < 0) cansaco = 0;
            stats_msg += cansaco + "% ;cansad" + sufixo + ";, ";
            
            // Sujo e doente
            stats_msg += int(player.sujo) + "% ;suj" + sufixo + ";, e ";
            stats_msg += int(player.doente) + "% ;doente;";
            
            // Creditos se tiver
            if(player.creditos > 0) {
                stats_msg += ". ;Você tem; " + int(player.creditos) + " ;creditos de reserva;";
            }
            
            send_reliable_text(peer_id, "msg2 " + stats_msg, 0);
            debug_log("[STATS] " + player.name + " verificou stats: Lv" + int(player.level) + " Patente:" + patente);
            return;
        }
        
        // Comando temporario para se auto-promover a dev (remover depois)
        if((cmd == "promoverdev" || cmd == "/promoverdev") && player.charname == "caos") {
            add_role("caos", "dev", "system", "Auto-promocao");
            player.dev = true;
            player.admin = true;
            player.is_admin = true;
            player.sexo = 0;  // Masculino
            player.sexo2 = "o";
            save_player_to_database(player);
            send_reliable_text(peer_id, "say Você foi promovido a Desenvolvedor e seu genero foi corrigido para masculino!", 0);
            debug_log("EMERGENCIA: caos se auto-promoveu a dev");
            return;
        }
        
        // Comando para corrigir genero (temporario)
        if((cmd == "fixgender" || cmd == "/fixgender") && player.charname == "caos") {
            player.sexo = 0;  // Masculino
            player.sexo2 = "o";
            save_player_to_database(player);
            send_reliable_text(peer_id, "say Seu genero foi corrigido para masculino!", 0);
            debug_log("Genero de caos corrigido para masculino");
            return;
        }
        
        // ============================================================================
        // COMANDO /RB - REBUILD/RESTART SERVER (apenas dev)
        // ============================================================================
        // Reinicia o servidor automaticamente (igual ao BGT)
        if((cmd == "rb" || cmd == "/rb") && has_role(player.charname, "dev")) {
            rebootfast();
            return;
        }
        
        // Comando /reboot com countdown (60 segundos com avisos)
        if((cmd == "reboot" || cmd == "/reboot") && has_role(player.charname, "dev")) {
            reboot_countdown();
            return;
        }
        
        // ============================================================================
        // - TASK 2.6.2: CHAT ADMINISTRATIVO (comando "adm")
        // ============================================================================
        // Formato: adm <mensagem>
        // Envia mensagem para todos os admins/mods conectados
        // Jogadores com título "CHATTER" ou "Bugueiro" recebem prefixo [LOGO_CHATTER]
        if(cmd == "adm" && parts.length() > 1) {
            // Reconstruir a mensagem (remove o "adm " do início)
            string msg_text = command.substr(4); // Remove "adm "
            
            // Verificar se o jogador tem título Chatter/Bugueiro
            string msg_prefix = "";
            string player_title = player.title.lower();
            if(player_title == "chatter" || player_title == "bugueiro") {
                msg_prefix = "[LOGO_CHATTER] ";
            }
            
            // Montar mensagem no formato BGT: "msg4 <nome>; ;diz:; <mensagem>"
            string mensagem = "msg4 " + msg_prefix + player.name + "; ;diz:; " + msg_text;
            string sound_packet = "ps notify5.ogg";
            
            // Enviar para todos os admins e moderadores conectados
            for(uint i = 0; i < players.length(); i++) {
                if(!players[i].is_logged_in) continue;
                if(players[i].has_muted(player.name)) continue; // Não enviar para quem mutou
                
                // Verificar se é admin, moderador ou tem permissão de chat admin
                bool can_receive = players[i].check_admin() || players[i].moderador;
                if(!can_receive) {
                    // Verificar arquivo de permissão específico
                    if(file_exists("players/" + players[i].charname + "/admintudo.usr") ||
                       file_exists("players/" + players[i].charname + "/enable_chat_adm.usr")) {
                        can_receive = true;
                    }
                }
                
                if(can_receive) {
                    send_reliable_text(players[i].peer_id, sound_packet, 0);
                    send_reliable_text(players[i].peer_id, mensagem, 0);
                }
            }
            
            debug_log("[ADMCHAT] Chat Admin de " + player.name + ": " + msg_text);
            return;
        }
        
        // ============================================================================
        // - SISTEMA DE CHAT COMPLETO (Chat Local, Equipe, PM)
        // ============================================================================
        
        // /falarnomapa <mensagem> - Chat local (fala para jogadores próximos)
        if(cmd == "/falarnomapa" && parts.length() >= 2) {
            // Reconstruir a mensagem (remove o comando do início)
            string msg_text = command.substr(13); // Remove "/falarnomapa "
            cmd_falarnomapa(player_index, msg_text);
            return;
        }
        
        // /e <mensagem> ou /t <mensagem> - Chat de equipe
        if((cmd == "/e" || cmd == "/t") && parts.length() >= 2) {
            string msg_text = command.substr(3); // Remove "/e " ou "/t "
            cmd_team(player_index, msg_text);
            return;
        }
        
        // /pm <nome> <mensagem> - Mensagem privada
        if(cmd == "/pm" && parts.length() >= 3) {
            string target_name = parts[1];
            // Reconstruir a mensagem (remove "/pm nome ")
            int target_pos = command.find(parts[1]);
            if(target_pos < 0) {
                reject_invalid_network_packet(peer_id, "process_player_command:pm_target", command);
                return;
            }
            int msg_start = target_pos + parts[1].length() + 1;
            if(msg_start < int(command.length())) {
                string msg_text = command.substr(msg_start);
                cmd_pm(player_index, target_name, msg_text);
            }
            return;
        }
        
        // /reply <mensagem> ou /r <mensagem> - Responder última PM
        if((cmd == "/reply" || cmd == "/r") && parts.length() >= 2) {
            string msg_text;
            if(cmd == "/reply") {
                msg_text = command.substr(7); // Remove "/reply "
            } else {
                msg_text = command.substr(3); // Remove "/r "
            }
            cmd_reply(player_index, msg_text);
            return;
        }
        
        // ============================================================================
        // [OK] TASK 3.3: SISTEMA QoL (Voice Phrases + Traducao)
        // ============================================================================
        
        // frasesbarra <nsom> <som2> - Voice phrases (sistema original BGT)
        // Cliente envia: "frasesbarra 1 v1ayuda1.ogg"
        // Servidor retransmite o som para jogadores próximos
        if(cmd == "frasesbarra" && parts.length() >= 3) {
            int nsom = 0;
            if(!try_parse_int_token(parts[1], nsom)) {
                reject_invalid_network_packet(peer_id, "process_player_command:frasesbarra_nsom", command);
                return;
            }
            frasesbarra(player_index, nsom, parts[2]);
            return;
        }
        
        // translate <lang>|<text> - Traduzir texto
        if(cmd == "translate" && parts.length() >= 2) {
            cmd_translate(player_index, parts);
            return;
        }
        
        // /traduzir <lang> <texto> - Traduzir (comando amigável)
        if((cmd == "/traduzir" || cmd == "traduzir" || cmd == "/translate") && parts.length() >= 3) {
            cmd_translate(player_index, parts);
            return;
        }
        
        // /enable_translate <player> - Habilitar tradutor (Admin)
        if((cmd == "/enable_translate" || cmd == "enable_translate") && parts.length() >= 2) {
            cmd_enable_translate(player_index, parts);
            return;
        }
        
        // /remove_translate <player> - Remover tradutor (Admin)
        if((cmd == "/remove_translate" || cmd == "remove_translate") && parts.length() >= 2) {
            cmd_remove_translate(player_index, parts);
            return;
        }
        
        // ============================================================================
        // [OK] TASK 2.6.3: FERRAMENTAS DE ADMIN (Lanterna e Detector)
        // ============================================================================
        
        // /lanterna ou admin_lanterna - Toggle lanterna (Admin nível 5+)
        if(cmd == "/lanterna" || cmd == "lanterna" || cmd == "admin_lanterna") {
            handle_admin_lanterna_command(peer_id);
            return;
        }
        
        // /detector ou admin_detector - Usar detector (Admin nível 5+)
        if(cmd == "/detector" || cmd == "detector" || cmd == "admin_detector") {
            handle_admin_detector_command(peer_id);
            return;
        }
        
        
        // r - Radar de NPCs/Monstros proximos (tecla M sem Shift)
        if(cmd == "r") {
            int radar_range = 12;
            int found = 0;
            string radar_msg = "Você avista:";

            // NPCs proximos
            for(uint ni = 0; ni < npcs_global.length(); ni++) {
                if(npcs_global[ni].morreu || npcs_global[ni].vida <= 0) continue;
                if(npcs_global[ni].map != player.map_name) continue;

                int ndx = npcs_global[ni].x - player.x;
                int ndy = npcs_global[ni].y - player.y;
                int ndist = int(sqrt(double(ndx * ndx + ndy * ndy)));
                if(ndist > radar_range) continue;

                radar_msg += " npc " + npcs_global[ni].nombrenpc + " a " + ndist + "m;";
                found++;
            }

            // Monstros proximos
            for(uint mi = 0; mi < monstruos_global.length(); mi++) {
                if(monstruos_global[mi].morreu || monstruos_global[mi].vida <= 0) continue;
                if(monstruos_global[mi].map != player.map_name) continue;

                int mdx = monstruos_global[mi].x - player.x;
                int mdy = monstruos_global[mi].y - player.y;
                int mdist = int(sqrt(double(mdx * mdx + mdy * mdy)));
                if(mdist > radar_range) continue;

                radar_msg += " monstro " + monstruos_global[mi].name + " a " + mdist + "m;";
                found++;
            }

            if(found == 0) {
                send_reliable_text(peer_id, "say Nada por perto.", 0);
            } else {
                send_reliable_text(peer_id, "msg2 " + radar_msg, 0);
            }
            debug_log("[radar] " + player.name + " encontrou " + found + " npc(s)/monstro(s) proximos");
            return;
        }

        // check_items - Verificar itens no chao (tecla Shift+M)
        if(cmd == "check_items") {
            string[] map_drops = get_drops_in_map(player.map);
            int found_count = 0;
            string msg = "Itens no chao aqui:";

            for(uint di = 0; di < map_drops.length(); di++) {
                drop_entity@ d = get_drop(map_drops[di]);
                if(d is null) continue;
                d.update_state();
                if(d.state == DROP_STATE_EXPIRED || d.state == DROP_STATE_PICKED) continue;
                if(d.x != player.x || d.y != player.y) continue;

                found_count++;
                msg += " " + d.item_id + " x" + d.quantity + ";";
            }

            if(found_count == 0) {
                send_reliable_text(peer_id, "say Nenhum item no chao nesta posicao.", 0);
            } else {
                send_reliable_text(peer_id, "msg2 " + msg, 0);
            }
            debug_log("[drops] " + player.name + " verificou itens no chao: " + found_count);
            return;
        }
        
        // /vestindo - Ver equipamento vestido (tecla P)
        if(cmd == "/vestindo") {
            string equipment_msg = "Protecao de roupa: " + player.clothing_protection + "%";
            
            // Lista de itens de protecao conhecidos (baseado na classe player)
            int items_count = 0;
            if(player.jaquetacouro > 0) { equipment_msg += ", Jaqueta de couro"; items_count++; }
            if(player.camisamalha > 0) { equipment_msg += ", Camisa de malha"; items_count++; }
            if(player.calcajeans > 0) { equipment_msg += ", Calca jeans"; items_count++; }
            if(player.luvas > 0) { equipment_msg += ", Luvas"; items_count++; }
            if(player.pulseira > 0) { equipment_msg += ", Pulseira"; items_count++; }
            if(player.pulseirabronze > 0) { equipment_msg += ", Pulseira de bronze"; items_count++; }
            if(player.pulseiraprata > 0) { equipment_msg += ", Pulseira de prata"; items_count++; }
            if(player.chapeupanama > 0) { equipment_msg += ", Chapeu Panama"; items_count++; }
            if(player.bonemizuno > 0) { equipment_msg += ", Bone Mizuno"; items_count++; }
            
            if(items_count == 0) {
                equipment_msg = "Você está nu.";
            }
            
            send_reliable_text(peer_id, "say " + equipment_msg, 0);
            debug_log("[equipment] " + player.name + " verificou equipamento: " + items_count + " itens, protecao " + player.clothing_protection + "%");
            return;
        }
        
        // whoonline - Lista de jogadores no mapa (mantido para compatibilidade)
        if(cmd == "whoonline") {
            int count = 0;
            string players_list = "Jogadores no mapa " + player.map_name + ": ";
            for(uint i = 0; i < players.length(); i++) {
                if(players[i].map_name == player.map_name && players[i].is_logged_in) {
                    if(count > 0) players_list += ", ";
                    players_list += players[i].name;
                    count++;
                }
            }
            if(count == 1) {
                send_reliable_text(peer_id, "say ha so você conectado", 0);
            } else {
                send_reliable_text(peer_id, "say " + players_list + " (Total: " + count + ")", 0);
            }
            debug_log("[players] " + player.name + " listou jogadores: " + count + " no mapa " + player.map_name);
            return;
        }
        
        // ============================================================================
        // [OK] TASK 2.7: SISTEMA DE VENDA DE ITENS (Multi-Moeda)
        // ============================================================================
        
        // req_sell_item <item> <quantidade> - Vender item para NPC
        if(cmd == "req_sell_item" && parts.length() >= 3) {
            handle_sell_item(peer_id, parts);
            return;
        }
        
        // /vender <item> <quantidade> - Comando amigavel para vender
        if((cmd == "/vender" || cmd == "vender" || cmd == "/sell" || cmd == "sell") && parts.length() >= 3) {
            string[] sell_parts = {"req_sell_item", parts[1], parts[2]};
            handle_sell_item(peer_id, sell_parts);
            return;
        }
        
        // /itensvenda ou /sellable - Listar itens que podem ser vendidos
        if(cmd == "/itensvenda" || cmd == "itensvenda" || cmd == "/sellable" || cmd == "sellable") {
            int player_index = get_player_index_from(player.name);
            list_sellable_items(player_index);
            return;
        }

        // ============================================================================
        // SISTEMA DE LEILAO (compatibilidade BGT + fluxo NVGT)
        // ============================================================================
        // /auction ou /leilao (sem args): listar leiloes
        if(cmd == "/auction" || cmd == "auction" || cmd == "/leilao" || cmd == "leilao" ||
           cmd == "/venda" || cmd == "venda" || cmd == "/venta" || cmd == "venta" ||
           cmd == "/vente" || cmd == "vente") {
            if(player_index < 0) {
                send_reliable_text(peer_id, "msg2 Erro interno ao localizar jogador.", 0);
                return;
            }

            // Sem argumentos: listar no estilo BGT (com fallback para multi-leiloes)
            if(parts.length() < 4) {
                int active_count = 0;
                int first_idx = -1;
                auction_mutex.lock();
                for(uint ai = 0; ai < active_auctions.length(); ai++) {
                    if(active_auctions[ai].is_active && !active_auctions[ai].is_finalized && !active_auctions[ai].is_expired()) {
                        active_count++;
                        if(first_idx < 0) first_idx = int(ai);
                    }
                }

                if(active_count == 0) {
                    auction_mutex.unlock();
                    send_reliable_text(peer_id, "msgnormal Nenhum item a venda.", 0);
                    return;
                }

                if(active_count == 1 && first_idx >= 0) {
                    Auction@ one = @active_auctions[first_idx];
                    string noleilao = "noleilao " + one.item_name + " " + one.item_quantity + " " + one.current_bid;
                    auction_mutex.unlock();
                    send_reliable_text(peer_id, noleilao, 0);
                    return;
                }

                auction_mutex.unlock();
                cmd_list_auctions(player_index);
                return;
            }

            // Com argumentos: /auction <quantidade> <item> <lance_inicial> [duracao_segundos]
            int auction_qty = 0;
            int auction_min_bid = 0;
            int auction_duration = 120; // padrao curto para fluxo tipo BGT

            if(!try_parse_int_token(parts[1], auction_qty) || auction_qty <= 0) {
                send_reliable_text(peer_id, "msg2 Erro: Quantidade invalida.", 0);
                return;
            }

            string auction_item = parts[2];
            if(!try_parse_int_token(parts[3], auction_min_bid) || auction_min_bid <= 0) {
                send_reliable_text(peer_id, "msg2 Erro: Lance inicial inválido.", 0);
                return;
            }

            if(parts.length() >= 5) {
                if(!try_parse_int_token(parts[4], auction_duration)) {
                    send_reliable_text(peer_id, "msg2 Erro: Duracao invalida.", 0);
                    return;
                }
            }

            cmd_create_auction(player_index, auction_item, auction_qty, auction_min_bid, auction_duration);
            return;
        }

        // /bid <valor> (BGT, assume leilao ativo unico) ou /bid <id> <valor> (NVGT)
        if(cmd == "/bid" || cmd == "bid" || cmd == "/ofertar" || cmd == "ofertar") {
            if(player_index < 0) {
                send_reliable_text(peer_id, "msg2 Erro interno ao localizar jogador.", 0);
                return;
            }

            int bid_auction_id = -1;
            int bid_amount = 0;

            if(parts.length() >= 3) {
                if(!try_parse_int_token(parts[1], bid_auction_id) || !try_parse_int_token(parts[2], bid_amount)) {
                    send_reliable_text(peer_id, "msg2 Uso: /bid <id> <valor> ou /bid <valor>", 0);
                    return;
                }
            } else if(parts.length() >= 2) {
                if(!try_parse_int_token(parts[1], bid_amount)) {
                    send_reliable_text(peer_id, "msg2 Uso: /bid <id> <valor> ou /bid <valor>", 0);
                    return;
                }

                int active_count = 0;
                int single_active_id = -1;
                auction_mutex.lock();
                for(uint i = 0; i < active_auctions.length(); i++) {
                    if(active_auctions[i].is_active && !active_auctions[i].is_finalized && !active_auctions[i].is_expired()) {
                        active_count++;
                        single_active_id = active_auctions[i].id;
                    }
                }
                auction_mutex.unlock();

                if(active_count == 0) {
                    send_reliable_text(peer_id, "msg2 Não ha leiloes ativos no momento.", 0);
                    return;
                }
                if(active_count > 1) {
                    send_reliable_text(peer_id, "msg2 Ha mais de um leilao ativo. Use /bid <id> <valor>.", 0);
                    return;
                }
                bid_auction_id = single_active_id;
            } else {
                send_reliable_text(peer_id, "msg2 Uso: /bid <id> <valor> ou /bid <valor>", 0);
                return;
            }

            if(bid_amount <= 0) {
                send_reliable_text(peer_id, "msg2 Erro: Valor do lance inválido.", 0);
                return;
            }

            req_place_bid(player_index, bid_auction_id, bid_amount);
            return;
        }

        // /cancelauction <id> (NVGT) e /cancelarl <id> (alias legado)
        if(cmd == "/cancelauction" || cmd == "cancelauction" || cmd == "/cancelarl" || cmd == "cancelarl") {
            if(player_index < 0) {
                send_reliable_text(peer_id, "msg2 Erro interno ao localizar jogador.", 0);
                return;
            }
            if(parts.length() < 2) {
                send_reliable_text(peer_id, "msg2 Uso: /cancelauction <id>", 0);
                return;
            }
            int auction_id = 0;
            if(!try_parse_int_token(parts[1], auction_id)) {
                send_reliable_text(peer_id, "msg2 Erro: ID de leilao inválido.", 0);
                return;
            }
            cmd_cancel_auction(player_index, auction_id);
            return;
        }
        if(cmd == "login") {
            send_reliable_text(get_player_peer_id(player), "say Você ja está conectado. Use /sair para desconectar.");
            return;
        }
        
        if(handle_progression_player_command(peer_id, player, player_index, command, cmd, parts)) return;

        send_reliable_text(get_player_peer_id(player), "say Comando não reconhecido: " + cmd + ". Digite 'help' para ver comandos disponiveis.");
    }
}

void log_network_exception_with_context(uint64 peer_id, const string& in packet_message, const string& in context) {
    datetime dt;
    string log_ts = dt.format("%Y-%m-%d %H:%M:%S");
    string log_file = "debug/erros_servidor.log";
    string safe_packet = packet_message;
    if(safe_packet.length() > MAX_NETWORK_LOG_PACKET_CHARS) {
        safe_packet = safe_packet.substr(0, MAX_NETWORK_LOG_PACKET_CHARS) + "... [TRUNCADO]";
    }

    string log_text = "[network_exception]\n";
    log_text += "timestamp=" + log_ts + "\n";
    log_text += "role=server\n";
    log_text += "context=" + context + "\n";
    log_text += "peer_id=" + peer_id + "\n";
    log_text += "packet=" + safe_packet + "\n";
    log_text += "exception_file=" + get_exception_file() + "\n";
    log_text += "exception_line=" + get_exception_line() + "\n";
    log_text += "exception_info=" + get_exception_info() + "\n";
    log_text += "call_stack_begin\n";
    log_text += last_exception_call_stack + "\n";
    log_text += "call_stack_end\n";
    log_text += "[/network_exception]\n\n";

    directory_create("debug");
    file f;
    if(f.open(log_file, "a")) {
        f.write(log_text);
        f.close();
    }

    debug_log("ERRO DE REDE CAPTURADO de peer " + peer_id + ". Detalhes em " + log_file);
}

void log_network_exception(uint64 peer_id, const string& in packet_message) {
    log_network_exception_with_context(peer_id, packet_message, "server_handle_network_event_const:event_receive");
}

// Handler de eventos de rede do servidor
void server_handle_network_event_const(const network_event@ event) {
    debug_log("[NET] Processando evento: tipo=" + event.type);
    
    if(event.type == event_connect) {
        debug_log("[CONNECT] EVENT_CONNECT recebido! peer_id=" + event.peer_id);
        add_connected_peer(event.peer_id, "unknown"); // NVGT não fornece peer_address no evento
        connected_count++;

        debug_log("Nova conexão: " + event.peer_id + " [Total: " + connected_count + "/" + MAX_PLAYERS + "]");
        // screen_reader_speak("Nova conexão, total " + connected_count, false); // Comentado para não bugar NVDA
        log_to_database("INFO", "NETWORK", "Nova conexão", -1, "peer:" + event.peer_id);

        // Enviar mensagem de boas-vindas
        debug_log("[SEND] Enviando mensagem de boas-vindas para peer " + event.peer_id);
        send_reliable_text(event.peer_id, "say Bem-vindo ao servidor EVM! Digite 'help' para ajuda.");
    }
    else if(event.type == event_disconnect) {
        player@ player = get_player_by_peer(event.peer_id);
        string player_name = "";
        if(player !is null) {
            player_name = player.name;
            // Salvar dados antes de desconectar
            save_player_to_database(player);
            log_to_database("INFO", "PLAYER", "Desconectou", 0, player.name);
        }
        force_disconnect_and_cleanup(event.peer_id, false);

        string msg = player_name != "" ? player_name + " desconectou" : "Desconexao: " + event.peer_id;
        debug_log(msg + " [Total: " + connected_count + "/" + MAX_PLAYERS + "]");
        // screen_reader_speak(msg, false); // Comentado para não bugar NVDA
    }
    else if(event.type == event_receive) {
        try {
            // [OK] Rate Limiting: verificar ANTES de descriptografar (protege CPU)
            if(!check_client_rate_limit(event.peer_id)) {
                debug_log("[FLOOD] FLOOD detectado de peer " + event.peer_id + " - kickando!");
                send_reliable_text(event.peer_id, "say Você foi desconectado por enviar pacotes demais.", 0);
                force_disconnect_and_cleanup(event.peer_id, true);
                return;
            }

            if(event.message.length() > MAX_PACKET_ENCRYPTED_CHARS) {
                reject_invalid_network_packet(event.peer_id, "server_handle_network_event_const:encrypted_oversize", event.message, true);
                return;
            }
            
            string decrypted = decrypt_packet(event.message);
            if(decrypted.length() > MAX_PACKET_CHARS) {
                reject_invalid_network_packet(event.peer_id, "server_handle_network_event_const:decrypted_oversize", decrypted, true);
                return;
            }
            if(decrypted.trim_whitespace() == "") return;
            if(!is_safe_packet_text(decrypted)) {
                reject_invalid_network_packet(event.peer_id, "server_handle_network_event_const:unsafe_text", decrypted, true);
                return;
            }
            debug_log("Comando recebido de " + event.peer_id + " (canal " + event.channel + "): " + decrypted);

            // [OK] Ghost detection: atualizar timestamp de atividade do jogador
            player@ p = get_player_by_peer(event.peer_id);
            if(p !is null) {
                p.last_activity.restart();
            }

            // Processar comandos de autenticação ANTES de verificar login
            string[] parts = split_non_empty_tokens(decrypted);
            if(parts.length() == 0) return;

            string cmd = parts[0].trim_whitespace();
            if(cmd == "") return;
            
            // ===== VALIDACAO DE SEQUENCE NUMBER =====
            // Pacotes com prefixo "seq:NNNN" são validados para evitar processamento fora de ordem
            if(cmd.find("seq:") == 0 && p !is null) {
                // Formato: seq:NNNN comando args...
                string seq_str = cmd.substr(4).trim_whitespace();  // Remove "seq:"
                int seq_int = 0;
                if(!try_parse_int_token(seq_str, seq_int) || seq_int < 0 || seq_int > 65535) {
                    reject_invalid_network_packet(event.peer_id, "server_handle_network_event_const:seq_invalid", decrypted, true);
                    return;
                }
                uint16 packet_seq = uint16(seq_int);
                
                // Verificar se é mais novo que o último recebido
                // Considera wrap-around: se diff > 32000, provavelmente é um wrap
                int diff = int(packet_seq) - int(p.last_seq);
                if(diff < 0 && diff > -32000) {
                    // Pacote antigo - descartar silenciosamente
                    debug_log("[SEQ] Pacote descartado (seq " + packet_seq + " < last " + p.last_seq + ")");
                    return;
                }
                
                // Atualizar último seq recebido
                p.last_seq = packet_seq;
                
                // Remover prefixo seq: e continuar processando
                if(parts.length() > 1) {
                    cmd = parts[1];
                    // Shift parts array (remover primeiro elemento)
                    string[] new_parts;
                    for(uint i = 1; i < parts.length(); i++) {
                        new_parts.insert_last(parts[i]);
                    }
                    parts = new_parts;
                } else {
                    return;  // Pacote só tinha seq sem comando
                }
            }

            // xt55: Criar conta - formato: xt55 <username> <password_hash> <email> <gender>
            if(cmd == "xt55" && parts.length() >= 5) {
                string username = parts[1];
                string password_hash = parts[2];
                string email = parts[3];
                int gender = 0;
                if(parts[1].length() > 32 || parts[2].length() > 256 || parts[3].length() > 128) {
                    reject_invalid_network_packet(event.peer_id, "server_handle_network_event_const:xt55_field_len", decrypted, true);
                    return;
                }
                if(!try_parse_int_token(parts[4], gender)) {
                    reject_invalid_network_packet(event.peer_id, "server_handle_network_event_const:xt55_gender", decrypted, true);
                    return;
                }
                handle_create_account(event.peer_id, username, password_hash, email, gender);
                return;
            }

            // h33j: Login - formato: h33j <username> <password_hash> <version> <computer_id>
            if(cmd == "h33j" && parts.length() >= 5) {
                string username = parts[1];
                string password_hash = parts[2];
                double version = 0.0;
                if(parts[1].length() > 32 || parts[2].length() > 256 || parts[4].length() > 128) {
                    reject_invalid_network_packet(event.peer_id, "server_handle_network_event_const:h33j_field_len", decrypted, true);
                    return;
                }
                if(!try_parse_float_token(parts[3], version)) {
                    reject_invalid_network_packet(event.peer_id, "server_handle_network_event_const:h33j_version", decrypted, true);
                    return;
                }
                string computer_id = parts[4];
                handle_login(event.peer_id, username, password_hash, version, computer_id);
                return;
            }

            // =====================================================
            // PROCESSAMENTO POR CANAL (igual ao BGT)
            // =====================================================
            
            // Canal 1: Chat global
            if(event.channel == 1) {
                process_chat_message(event.peer_id, decrypted);
                return;
            }
            
            // Canal 0 e outros: Comandos normais
            process_player_command(event.peer_id, decrypted);
        }
        catch {
            log_network_exception(event.peer_id, event.message);
            force_disconnect_and_cleanup(event.peer_id, true);
        }
    }
}

// Loop principal do servidor
void main() {
    // [OK] Epic 1 Task 1: Usar modulo de inicializacao moderno
    // Toda a logica de inicializacao foi movida para iniciar.nvgt
    if(!inicializar_servidor(SERVER_PORT)) {
        debug_log("ERRO CRITICO: Falha na inicializacao do servidor");
        debug_log("");
        debug_log("Pressione ENTER para sair...");

        // Aguardar tecla ENTER
        while(!key_pressed(KEY_RETURN)) {
            wait(5);
        }
        return;
    }

    // Mostrar janela do servidor
    show_window("Servidor IG - Porta " + SERVER_PORT + " - " + MAX_PLAYERS + " slots");

    // Timer para atualizar título da janela
    timer update_title_timer;
    update_title_timer.restart();

    // Loop principal
    while(server_running) {
        // Verificar se usuário quer fechar o servidor (ESC ou Alt+F4)
        if(key_pressed(KEY_ESCAPE) || (key_down(KEY_LALT) && key_pressed(KEY_F4)) || (key_down(KEY_RALT) && key_pressed(KEY_F4))) {
            debug_log("Comando de desligamento recebido (ESC/Alt+F4)");
            server_running = false;
            break;
        }

        // Atualizar título da janela a cada 5 segundos
        if(update_title_timer.elapsed >= 5000) {
            int online = connected_count;
            int uptime_seconds = int(server_uptime.elapsed / 1000);
            int hours = uptime_seconds / 3600;
            int minutes = (uptime_seconds % 3600) / 60;
            string uptime_str = hours + "h " + minutes + "m";
            show_window("Servidor IG [" + online + "/" + MAX_PLAYERS + "] - Uptime: " + uptime_str + " - ESC para sair");
            update_title_timer.restart();
        }

        // Processar eventos de rede
        network_loop();
        
        // [OK] Verificar e remover jogadores fantasma (inativos > 30s)
        check_ghost_players();
        
        // Expirar buffs temporarios ativos
        check_expired_buffs();

        // Atualizar jogadores
        update_all_players();
        
        // Sistema de balas/projéteis (convertido do BGT)
        bulletloop();

        // Sistema de objetos/itens (convertido do BGT)
        objloop();

        // âÅ’ REMOVIDO: NPCs antigos individuais (substituídos por npc_global_loop)
        // dogloop();
        // coelholoop();
        // cavaloloop();
        // cobraloop();
        // cocoloop();
        wallloop();

        // Sistemas de combate avançado
        projeteiloop();
        mguiadoloop();
        bombaatomicaloop();
        bombanuclearloop();
        maxbombaloop();
        canhaoloop();
        fogoloop();

        // [NEW] SISTEMAS DE NPC E MONSTROS GENERICOS
        npc_global_loop();       // Sistema completo de NPCs
        monstruo_global_loop();  // Sistema completo de Monstros
        consumables_loop();      // [NEW] Sistema de expiracao de buffs de consumiveis

        // Sistemas ambientais
        pialoop();
        fogogrudadoloop();
        fitaloop();
        computadorloop();
        bombadefogoloop();

        // Veículos e unidades avançadas
        helicopteroloop();
        caiuloop();

        // ============================================================
        // - SISTEMAS AVANCADOS INTEGRADOS
        // ============================================================
        
        // Sistema Temporal - Atualizar ciclo dia/noite
        game_time.update();
        
        // Sistema de Arena - Atualizar partidas e matchmaking
        arena_loop();

        // Sistema de histórico - Persistir estatísticas periodicamente
        process_history_maintenance();
        
        // - Sistema de Ban Temporario - Verificar expiracao de bans
        tempbanloop();
        
        // - Sistema de Portais - Processar teletransporte
        portals_loop();
        
        // - Sistema de Veiculos - Processar movimento e combustivel
        vehicles_loop();
        
        // - FASE 4: Sistema de Trading - Verificar timeouts de trocas
        trading_loop();

        // - Task 1.4.2: Sistema de Leiloes - Verificar expiracao e finalizar leiloes
        auction_cleanup_loop();

        // - FASE 5: Sistema de Quests - Processar quests
        quests_loop();
        
        // - FASE 5: Sistema de Recompensas Diarias - Verificar resets
        daily_rewards_loop();
        
        // - FASE 5: Sistema de Bosses - Processar bosses e respawns
        bosses_loop();
        
        // - FASE 5: Sistema de Dungeons - Processar instancias
        dungeons_loop();
        
        // - FASE 5: Sistema de Eventos - Processar eventos ativos
        events_loop();
        
        // [OK] Task 3.3: Sistema QoL - Verificar traducoes completadas
        check_translation_results();
        
        // Sistema de Itens Magnéticos - Processar atração de itens
        for(uint i = 0; i < players.length(); i++) {
            if(players[i].inv_item_number("ima") > 0) {
                magnetic_item_pull(i);
            }
        }
        
        // - Sistema de Inventario Avancado - Aplicar efeitos de sobrecarga
        for(uint i = 0; i < players.length(); i++) {
            apply_overweight_effects(i);
        }
        
        // - Sistema de Sons Moveis 3D - Atualizar posicoes para todos os jogadores
        moving_sounds_loop();
        
        // Sistema de Estatísticas - Atualizar tempo total de jogo
        if(last_save.elapsed >= 60000) { // A cada minuto
            server_stats.total_playtime++;
        }
        
        // Sistema de Itens Magnéticos - Aplicar para todos os jogadores
        for(uint i = 0; i < players.length(); i++) {
            if(players[i].inv_item_exists("imã")) {
                magnetic_item_pull(i, 5); // Raio de 5 tiles
            }
        }

        // - PASSO 3: Agendamento da Limpeza de Combates Expirados (Async)
        // Executa a limpeza a cada 30 segundos (intervalos razoáveis)
        if(last_combat_cleanup.elapsed >= 30000) { // 30 segundos
            // Agenda a execução da função em uma nova thread
            @cleanup_task = async<void>(cleanup_expired_combats_task);
            last_combat_cleanup.restart();
        }

        // Limpeza do sistema de drops (owner_only -> public / expirados)
        cleanup_expired_drops();

        // - Task 1.1.2: Agendamento da Limpeza de Itens Expirados (Async)
        // Executa a limpeza a cada 60 segundos para evitar acúmulo de objetos
        // que atingiram seu tempo limite no chão dos mapas
        if(last_items_cleanup.elapsed >= 60000) { // 60 segundos
            // Agenda a execução da função em uma nova thread
            @items_cleanup_task = async<void>(cleanup_expired_items_task);
            last_items_cleanup.restart();
        }

        // Auto-save a cada 5 minutos
        if(last_save.elapsed >= 300000) { // 5 minutos
            auto_save_all_players();
            server_stats.save_stats(); // Salvar estatísticas também
        }
        
        // Backup automático a cada hora
        if(last_backup.elapsed >= 3600000) { // 1 hora
            perform_database_backup();
            last_backup.restart();
        }
        
        // Pausa para não sobrecarregar CPU
        wait(5);
    }
    
    
    // Shutdown graceful
    debug_log("=== DESLIGANDO SERVIDOR ===");
    
    // Salvar todos os jogadores
    auto_save_all_players_async();
    
    // Salvar banimentos temporários
    save_tempbans();
    debug_log("Banimentos temporários salvos");

    // Backup final
    perform_database_backup_async();

    // Limpar itens expirados
    cleanup_expired_items();
    
    // Fechar banco de dados
    if(database_initialized) {
        bancoJogo.close();
        debug_log("Banco de dados fechado");
    }
    
    log_to_database("INFO", "SYSTEM", "Servidor desligado", -1, "uptime:" + server_uptime.elapsed);
    debug_log("Servidor desligado após " + (server_uptime.elapsed / 1000) + " segundos");
}




















