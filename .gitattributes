# Arquivos de mídia (tratados como binários)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav binary
*.ogg binary
*.mp3 binary

# Arquivos de texto com controle de final de linha
*.txt text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.map text eol=crlf
*.lang text eol=lf
*.nvgt text eol=crlf
*.py text eol=lf
