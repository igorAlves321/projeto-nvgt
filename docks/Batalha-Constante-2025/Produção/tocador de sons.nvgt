#include "speech.nvgt"
pack p;

void main(){
	show_window("tocador de som");
	p.open("sounds.dat", PACK_OPEN_MODE_READ);
	@sound_default_pack = @p;
	string[] @nomes = p.list_files();
	int contador = -1;
	bool play = false;
	while(!key_pressed(KEY_ESCAPE)){
		wait(5);
		if(key_pressed(KEY_DOWN)){
			contador++;
			if(contador >= nomes.size()){
				contador = 0;
			}
			play = true;
		}
		else if(key_pressed(KEY_UP)){
			contador--;
			if(contador < 0){
				contador = nomes.size() - 1;
			}
			play = true;
		}
		else if(key_pressed(KEY_RETURN)){
		play = true;
		}
		if(play){
			tocar_som(nomes[contador]);
			play = false;
		}
	}
	p.close();
}
void tocar_som(string nome){
	sound s;
	s.load(nome);
	if(!s.active){
		alert("Erro ao carregar o som " + nome, "");
		return;
	}
	s.play();
	while(s.playing && !key_pressed(KEY_ESCAPE)){
		wait(5);
	}
	s.close();
}