#include "speech.nvgt"
#include "conta.nvgt"
#include "form.nvgt"

void setUpExistingAccount() {
    audio_form text;
    text.create_window("Batalha Constante");
    wait(50);
    Conta conta;
    conta.jogador = text.create_input_box("Dijite o nome da conta:", "");
    conta.senha = text.create_input_box("Dijite a senha do personagem:", password_mask = " * ");
//Botões para recuperar e configurar a conta.
    int botaoRecuperarSenha = text.create_button("Esqueceu a senha?");
    int botaoConfigurarConta = text.create_button("Configurar conta");
    array<int> inputs = {conta.jogador, conta.senha, botaoRecuperarSenha, botaoConfigurarConta};
    int indiceFoco = 0;
    text.focus(inputs[indiceFoco]);
    while(true) {
        wait(5);
        text.monitor();

        if(text.is_pressed(botaoConfigurarConta)) {
            wait(500);
            speak("Conta configurada!");
            wait(500);
            break;
        }


        if(key_pressed(KEY_ESCAPE)) {
            speak("Cancelado");
            break;
        }
    }
}