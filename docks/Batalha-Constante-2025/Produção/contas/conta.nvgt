#include "speech.nvgt"
#include "form.nvgt"

class Conta {
    int jogador;
    int email;
    int senha;
    int senhaDois;
    string id;
}

void criar_conta() {
    audio_form text;
    text.create_window("Batalha Constante");
    wait(50);
    Conta conta;
    conta.jogador = text.create_input_box("Informe o nome de seu novo personagem", "");
    conta.email = text.create_input_box("Informe o e-mail de seu personagem", "");
    conta.senha = text.create_input_box("Informe a senha de seu personagem, ela deve ter no mínimo 8 caracteres e não pode conter espaços: ", password_mask = " *");
    conta.senhaDois = text.create_input_box("Repita a senha novamente.", password_mask = " *");

//Botão para criar a conta
    int botaoCriarConta = text.create_button("&Criar Conta");
    array<int> inputs = {conta.email, conta.jogador, conta.email, conta.senha, botaoCriarConta};
    int indiceFoco = 0;
    text.focus(inputs[indiceFoco]);
    
    while(true) {
        wait(5);
        text.monitor();

        if(text.is_pressed(botaoCriarConta)) {
            indiceFoco++;
            if(indiceFoco >= inputs.length()) {
                // Validando os campos.
                string emailStr = text.get_text(conta.email);
                string senhaStr = text.get_text(conta.senha);
                string senhaDoisStr = text.get_text(conta.senhaDois);
                if(emailStr == "" || string_contains(emailStr, "@", 1) <4) {
                    wait(2500);
                    speak("E-mail em branco ou inválido.");
                    wait(5000);
                    indiceFoco = 2; // Focar novamente no campo de e-mail
                    text.focus(inputs[indiceFoco]);
                } else if(senhaStr!=senhaDoisStr || senhaStr.length() <8) {
                    wait(5000);
                    speak("As senhas dijitadas não são vválidas");
                    indiceFoco = 3;
                    text.focus(inputs[indiceFoco]);
                } else {
                    speak("Conta criada com sucesso!");
                    // Aqui você pode adicionar a lógica para criar a conta de fato.
                    break;
                }
            } else {
                text.focus(inputs[indiceFoco]);
            }
        }
        
        if(key_pressed(KEY_ESCAPE)) {
            speak("Cancelado");
            break;
        }
    }
}
