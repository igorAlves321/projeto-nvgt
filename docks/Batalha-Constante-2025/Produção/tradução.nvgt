#include"speech.nvgt"
#include"../Comuns/diversos.nvgt"
#include"tradução class.nvgt"
Traducao t;
void main() {
show_window("teste");
t.setarArquivo("lang.lang");
wait(500);
timer analizando;
timer tExecutando;
string final;
int quantidadeExecucoes = 0;
analizando.restart();
while(analizando.elapsed < 10000) {
tExecutando.restart();
t.busca("Olá, meu nome é %1 e eu tenho %2 anos.\0\0 \0\0Sabe %1, eu não gosto de ir à escola. E você?", ({"Dalison", "26", "Jeniffer"}));
final += tExecutando.elapsed + "\r\n";
quantidadeExecucoes++;
}
final = "Quantidade de execuções: " + quantidadeExecucoes+".\r\n" + final;
file f;
f.open("log.log", "wb");
f.write(final);
f.close();
}
