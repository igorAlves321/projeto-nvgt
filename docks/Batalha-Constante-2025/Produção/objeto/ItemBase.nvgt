enum tipo_objetos {
objeto_nenhum = 0,
objeto_jogador,
objeto_npc,
objeto_item,
objeto_itemGrupado,
objeto_itemSimples
};

class ItemBase {
string nome;
int x;
int y;
int z;
int tipo;
int peso;

void reset() {
this.x = 1;
this.y = 0;
this.z = 0;
this.nome = "";
this.tipo = objeto_nenhum;
this.peso = 0;
}

ItemBase() {
this.reset();
}

ItemBase(string nome, int x, int y, int z, int tipo) {
this.nome = nome;
this.x = x;
this.y = y;
this.z = z;
this.tipo = tipo;
}
}
