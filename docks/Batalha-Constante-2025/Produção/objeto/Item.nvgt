#include"speech.nvgt"
#include"ItemBase.nvgt"
class Item: ItemBase {
timer tempoCaindo;
int velocidadeCair;
Item(string nome, int x, int y, int z, int velocidadeCair) {
this.velocidadeCair = velocidadeCair;
super(nome, x, y, z, objeto_item);
}

void caindo() {
if(tempoCaindo.elapsed >= velocidadeCair && y > 0) {
tempoCaindo.restart();
y--;
speak("caindo...");
if(y <=0) {
y = 0;
tempoCaindo.force(0);
tempoCaindo.pause();
}
}
}
}
