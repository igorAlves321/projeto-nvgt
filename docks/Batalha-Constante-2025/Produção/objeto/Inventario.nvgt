enum tipo_objeto_inventario {
item_simples = 0,
item_grupado
}

class Inventario {
ItemInventario@[] itens;
void add(json_object@ obj) {
if(@obj == null) return;
if(obj["tipo"] == item_simples) {
if(obj["quantidade"] == 1) { // adicionar no inventário
ItemInventario item;
item.tipo = item_simples;
item.nome = obj["nome"];
item.quantidade = 1;
item.id = obj["id"];
itens.insert_last(item);
} else { // Removendo item
int id = buscaItemUsandoId(obj["id"]);
if(id > -1) itens.remove_at(id);
}
} else {
//Item grupado
int id = buscaItemUsandoNome(obj["nome"]);
if(id < 0) {
ItemInventario item;
item.nome = obj["nome"];
item.quantidade = obj["quantidade"];
item.tipo = item_grupado;
itens.insert_last(item);
} else {
// Adicionando ou removendo dependendo da quantidade
double valorTotal = itens[id].quantidade + obj["quantidade"];
if(valorTotal <=0 ) {
itens.remove_at(id);
} else {
itens[id].quantidade = valorTotal;
}
}
}
}

string geraTXT() {
json_array jArray;
for(int i = 0; i < itens.length(); i++) {
json_object obj;
try {
obj["nome"] = itens[i].nome;
obj["quantidade"] = itens[i].quantidade;
obj["tipo"] = itens[i].tipo;
obj["id"] = itens[i].id;
jArray.add(obj);
} catch {
alert("Erro ao adicionar item no json: " + get_exception_info(), "");
}
}
return jArray.stringify();
}
int buscaItemUsandoId(int id) {
for(int i = 0; i < itens.length(); i++) {
if(itens[i].id == id) return i;
}
return -1;
}

int buscaItemUsandoNome(string& in nome) {
for(int i = 0; i < itens.length(); i++) {
if(itens[i].nome == nome) return i;
}
return -1;
}
}

class ItemInventario {
double quantidade;
string nome;
int tipo;
int id;
ItemInventario() {
reset();
}
void reset() {
nome = "";
quantidade = 1;
tipo = item_grupado;
id = -1;
}
}
