#include"speech.nvgt"
#include"../Comuns/diversos.nvgt"
#include"tradução class.nvgt"
Traducao t;

void main() {
	show_window("teste");
	speak("carregando arquivo...");
	timer analizando;
	t.setarArquivo("español.lang");
	analizando.pause();
	speak("arquivo carregado. "+analizando.elapsed);
	analizando.force(0);
	analizando.pause();
	while(true){
		wait(5);
		if(key_pressed(KEY_RETURN)){
			string chave = input_box("Janela", "Digite uma para pegar");
			if(chave.empty()) continue;
			analizando.restart();
			int quantidade = 0;
			while(analizando.elapsed <10000){
				t.busca(chave);
				quantidade ++;
			}
			speak("quantidade: "+quantidade);
		}
	}
}