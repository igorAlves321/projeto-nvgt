#include "submenu.nvgt"
#include "form.nvgt"
#include "../../Produção/contas/conta.nvgt"
#include "../../Produção/contas/configurar_conta.nvgt"

void menuPrincipal() {
show_window("Batalha Constante");
Submenu mainMenu;

int indexMenuPerfil = mainMenu.addMenu("Perfil");
int indexMenuConfig = mainMenu.addMenu("Configurações");
int indexMenuAtualizacoes = mainMenu.addMenu("Checar Atualizações");

mainMenu.addItem(indexMenuPerfil, "Login", "login");
mainMenu.addItem(indexMenuPerfil, "Configurar Conta", "configurar_conta");
mainMenu.addItem(indexMenuPerfil, "Criar Nova Conta", "criar_conta");

audio_form mainMenuForm;
mainMenuForm.create_window("Ajustar Volume e Menu Principal");

conf.controleVolumeSliderMenu = mainMenuForm.create_slider("&Volume da Música", retornarVolumeDeValor(conf.volumeMusica), 0, 100);
mainMenuForm.set_event_callback(conf.controleVolumeSliderMenu, on_control_event_callback(@conf.tratarEventosForm));
mainMenuForm.focus(conf.controleVolumeSliderMenu);

mainMenu.display("Menu Principal");

bool submenuAtivo = false;
int menuEvent;

while (true) {
wait(5);

if (!submenuAtivo) {
mainMenuForm.monitor();

int volumeAtual = mainMenuForm.get_slider(conf.controleVolumeSliderMenu);
if (conf.volumeMusica != retornarVolumeDePorcentagem(volumeAtual)) {
conf.volumeMusica = retornarVolumeDePorcentagem(volumeAtual);
somMusica.volume = conf.volumeMusica;
}

if (key_released(KEY_LALT)) {
submenuAtivo = true;
mainMenu.display("Menu Principal");
}
}

if (submenuAtivo) {
menuEvent = mainMenu.monitorInput();

if (menuEvent != NoAction) {
handleMenuEvent(menuEvent, submenuAtivo, mainMenu);
}
}

if (key_pressed(KEY_ESCAPE)) {
estadoJogo = jogo_fechando;
break;
}
}
teclasLoop();
}

void handleMenuEvent(int event, bool &submenuAtivo, Submenu &mainMenu) {
switch (event) {
case MoveUp:
case KEY_UP:
mainMenu.navigateMenu(-1);
speak(mainMenu.getSpeechOutput());
break;
case MoveDown:
case KEY_DOWN:
mainMenu.navigateMenu(1);
speak(mainMenu.getSpeechOutput());
break;
case Select:
case KEY_RETURN:
if (mainMenu.menuList[mainMenu.currentMenuIndex].name == "Perfil") {
abrirMenuPerfil();
} else if (mainMenu.menuList[mainMenu.currentMenuIndex].name == "Configurações") {
conf.mostrar();
} else if (mainMenu.menuList[mainMenu.currentMenuIndex].name == "Checar Atualizações") {
checarAtualizacoes();
}
break;
case CloseMenu:
case KEY_ESCAPE:
//speak("Fechando o menu principal.");
submenuAtivo = false;
break;
default:
break;
}
}

void abrirMenuPerfil() {
show_window("Menu de Perfil");
Submenu perfilMenu;

int indexLogin = perfilMenu.addMenu("Login");
int indexConfigurarConta = perfilMenu.addMenu("Configurar Conta");
int indexCriarConta = perfilMenu.addMenu("Criar Nova Conta");

perfilMenu.addItem(indexLogin, "Login", "login");
perfilMenu.addItem(indexConfigurarConta, "Configurar Conta", "configurar_conta");
perfilMenu.addItem(indexCriarConta, "Criar Nova Conta", "criar_conta");

perfilMenu.display("Menu de Perfil");

bool perfilAtivo = true;
int perfilEvent;

while (perfilAtivo) {
wait(5);
perfilEvent = perfilMenu.monitorInput();

if (perfilEvent != NoAction) {
handlePerfilEvent(perfilEvent, perfilMenu, perfilAtivo);
}
}
}

void handlePerfilEvent(int event, Submenu &perfilMenu, bool &perfilAtivo) {
switch (event) {
case MoveUp:
case KEY_UP:
perfilMenu.navigateMenu(-1);
speak(perfilMenu.getSpeechOutput());
break;
case MoveDown:
case KEY_DOWN:
perfilMenu.navigateMenu(1);
speak(perfilMenu.getSpeechOutput());
break;
case Select:
case KEY_RETURN: {
string selectedItemId = perfilMenu.getSelectedItemId();
if (selectedItemId == "login") {
speak("Iniciando login...");
} else if (selectedItemId == "configurar_conta") {
speak("Configurando conta...");
setUpExistingAccount();
} else if (selectedItemId == "criar_conta") {
speak("Criando nova conta...");
criar_conta();
}
break;
}
case CloseMenu:
case KEY_ESCAPE:
speak("Fechando menu de perfil.");
perfilAtivo = false;
break;
default:
break;
}
}

void checarAtualizacoes() {
speak("Verificando por atualizações...");
wait(1000);
speak("Nenhuma atualização encontrada.");
}

void teclasLoop() {
while (true) {
wait(5);
if ((keyboard_modifiers & KEYMOD_ALT) > 0 && key_pressed(KEY_F4) || estadoJogo == jogo_fechando) {
estadoJogo = jogo_fechando;
break;
}
}
conf.salva();
somMusica.stop();
somMusica.close();
poolSons.play_stationary("portas/1fechar.ogg", false);
wait(1000);
packSons.close();
@sound_default_pack = null;
exit(0);
}

double retornarVolumeDePorcentagem(int valor) {
return (valor - 100);
}

int retornarVolumeDeValor(double valor) {
return (valor + 100);
}
