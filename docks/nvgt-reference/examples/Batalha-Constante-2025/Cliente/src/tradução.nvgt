class Traducao {
private dictionary traducoes;
bool setarArquivo(string arquivo) {
if(!file_exists(arquivo)) return false;
file f;
f.open(arquivo, "rb");
string[] linhas = f.read().split("\r\n", false);
f.close();
for(int i = 0; i < linhas.size(); i++) {
if(string_contains(linhas[i], "=", 1) <0) continue;
string[] dividido = linhas[i].split("=", false);
this.traducoes.set(dividido[0], dividido[1]);
}
return this.traducoes.size() > 0;
}
string busca(const string &in frase, string[]@ &in args = null) {
string valor;
this.traducoes.get(frase, valor);
if(!valor.is_empty()) {
return this.traduz_parte(valor, args);
}
string[] lista = frase.split("\0\0", false);
string resultado;
for(int i = 0; i < lista.length(); i++) {
resultado += this.traduz_parte(lista[i], args);
}
return resultado;
}
private string traduz_parte(string &in original, string[]@ &in args) {
if(original.length() < 1) return original;
if(!this.traducoes.exists(original)) {
return original;
}
string valor;
this.traducoes.get(original, valor);
        if (@args != null) {
            int quantidadeSubstituida = traduz_args(valor, args);
if(quantidadeSubstituida > 0) {
args.remove_range(0, quantidadeSubstituida);
        }
}
        return valor;
    }
private int traduz_args(string & valor, const string[]@ args) {
int quantidade = 0;
        for (int i = 0; i < args.length(); i++) {
string casa = "%" + (i + 1);
if(string_contains(valor, casa, 1) > -1) {
            valor = valor.replace(casa, args[i]);
quantidade++;
        }
}
return quantidade;
    }
}
