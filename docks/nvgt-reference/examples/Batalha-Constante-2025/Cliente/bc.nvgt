#include"../comuns/diversos.nvgt"
#include"speech.nvgt"
#include"form.nvgt"
#include"src/testando.nvgt"
#include "src/configurações.nvgt"
#include "../comuns/ini.nvgt"
#include "bgt_compat.nvgt" //Não usem funções dessa script, é apenas para compatibilidade com o Ini
#include"../Comuns/diversos.nvgt"
#include"src/tradução.nvgt"
#include"sound_pool.nvgt"
int estadoJogo = jogo_iniciando;

audio_form form; //Objeto global da classe audio_form
Traducao t;
const string janelaBc = "Batalha Constante";
sound_pool poolSons;
sound somMusica;
instance batalhaConstanteExe;
int main(){
show_window(janelaBc);
conf.carrega();
if(batalhaConstanteExe.is_already_running){
alert(janelaBc, "O jogo já está em execução.", true, MESSAGE_BOX_ERROR);
return 1;
}
if(!file_exists("sounds.dat")){
//verificar por o sounds, se não tiver, chama uma função futura de atualização de sons
}
if(!packSons.open("sounds.dat", PACK_OPEN_MODE_READ)){
alert(janelaBc, "Erro ao abrir o arquivo de sons. O jogo será encerrado.", true, MESSAGE_BOX_ERROR);
return 1; //erro
}
@sound_default_pack = @packSons;
poolSons.play_stationary("portas/1abrir.ogg", false);
bool carregou = somMusica.load("músicas/m"+random(1, 5)+".ogg");
if(!carregou){
alert(janelaBc, "Erro ao carregar a música do menu. O jogo será encerrado.", true, MESSAGE_BOX_ERROR);
return 1;
}
somMusica.volume = conf.volumeMusica;
somMusica.play_looped();
async<void>(teclasLoop);
menuPrincipal();
return 0;
}