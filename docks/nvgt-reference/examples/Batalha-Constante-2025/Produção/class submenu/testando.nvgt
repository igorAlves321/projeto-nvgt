#include "menu.nvgt"
#include "speech.nvgt"

int processMenuEvent(int event); // Corrigindo tipo de retorno
int main() {
    show_window("Testando");
    Submenu mainMenu;

    int perfilMenuIndex = mainMenu.addMenu("&Perfil");
    int configMenuIndex = mainMenu.addMenu("&Configurações");
    int checkUpdateIndex = mainMenu.addMenu("Checar &Atualização");
    int exitIndex = mainMenu.addMenu("&Sair");

    mainMenu.addItem(perfilMenuIndex, "&Login", "login");
    mainMenu.addItem(perfilMenuIndex, "&Criar Conta", "criarConta");

    mainMenu.addItem(configMenuIndex, "&Salvar Dados", "salvarDados");
    mainMenu.addItem(configMenuIndex, "&Idioma", "idioma");

    mainMenu.addItem(checkUpdateIndex, "Checar Atualização", "checarAtualizacao");
    mainMenu.addItem(exitIndex, "Sair", "sair");

    int menuEvent;
    while (true) {
        wait(5);
        if (mainMenu.isActive) {
            menuEvent = mainMenu.monitorInput();
            if (menuEvent != NoAction) {
                processMenuEvent(menuEvent);
            }
        } else {
            if (key_released(KEY_LALT)) {
                speak("ALT pressed. Displaying main menu.");
                mainMenu.display("Menu Principal");
            }
        }

        if (key_pressed(KEY_ENTER)) {
            speak("Enter pressed, opening submenu.");
            // Aqui, navega para submenu com Enter
            mainMenu.openSubmenu();
        }

        if (key_pressed(KEY_ESCAPE)) {
            speak("Exiting program.");
            break;
        }
    }
    return 0;
}

int processMenuEvent(int event) {
    switch (event) {
        case Select:
            if (event == "login") {
                speak("Login selecionado.");
            } else if (event == "criarConta") {
                speak("Criar Conta selecionado.");
            } else if (event == "salvarDados") {
                speak("Salvar Dados selecionado.");
            } else if (event == "idioma") {
                speak("Idioma selecionado.");
            } else if (event == "checarAtualizacao") {
                speak("Checando por atualização.");
            } else if (event == "sair") {
                speak("Saindo do menu.");
                exit(0);
            }
            break;
        case MainMenuState:
            break;
        case SubMenuState:
            break;
        default:
            break;
    }
    return 0;
}
