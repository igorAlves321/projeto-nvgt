/*
Configurações do jogo. O diálogo, e funções de carregar e salvar
*/
Config conf; //Objeto global da classe config
const string caminhoConfig = "config.ini"; //Caminho do arquivo de configurações
pack packSons;
class Config:ini{
	//class de cconfigurações já erdando a class ini
	string idioma = "Português-Br", dispositivoEntrada = "padrão", dispositivoSaida = "padrão";
	bool verificarAtualizacoesInicio  = true, interromperMensagens = false, falarForaJanela = false, confirmarAoSair = true, reprodusirLogInicio = true, usarCtrlDireito = false, salvarLogs = true;
	int vozEscolhida = 1, escutarNotificacoesConexoes = 0; //0 não escutar, 1 amigos, 2 todos
	bool nivel = false, Grunhidos = true, passos = true, sonsItens = true, sonsBalasBarreiras = true;
	bool audiosEquipe = true, permitirSalvarAudios = false;
	private audio_form form, formGeral, formPersonagem, formNotificacoes, formAudio, formVoz;
	private int listaGuias, guiaGeral, guiaPersonagem, guiaNotificacoes, guiaAudio, guiaVoz;
	private int botaoSalvar, botaoFechar, botaoRestaurarPadrao;
	private int listaIdiomas, aoSairCheckbox, verificarAtualizacoesCheckbox, reprodusirLogInicioCheckbox;
	private int listaVozes, ctrlDireitoCheckbox, salvarLogsCheckbox;
	private int escutarNotificacoesLista, nivelCheckbox, GrunhidosCheckbox, passosCheckbox, sonsItensCheckbox, sonsBalasBarreirasCheckbox;
	private int audiosEquipeCheckbox, permitirSalvarAudiosCheckbox;
	private int dispositivoEntradaLista, dispositivoSaidaLista;
	private int interromperMensagensCheckbox, falarForaJanelaCheckbox;
	private int guiaAtual = 1;
	int volumeMusica = -10;
	int controleVolumeSliderMenu;
	Config(){
		super();
	}
	void salva() {
		if (!section_exists("General")) create_section("General");
		set_string("General", "Language", idioma);
		set_bool("General", "ConfirmExit", confirmarAoSair);
		set_bool("General", "CheckUpdatesOnStart", verificarAtualizacoesInicio);
		set_bool("General", "PlayLogoOnStart", reprodusirLogInicio);

		if (!section_exists("PlayerProfile")) create_section("PlayerProfile");
		set_int("PlayerProfile", "Voice", vozEscolhida);
		set_bool("PlayerProfile", "UseRightCtrl", usarCtrlDireito);
		set_bool("PlayerProfile", "SaveLogs", salvarLogs);

		if (!section_exists("Notifications")) create_section("Notifications");
		set_int("Notifications", "ListenToConnections", escutarNotificacoesConexoes);
		set_bool("Notifications", "LevelUpSound", nivel);
		set_bool("Notifications", "Grunts", Grunhidos);
		set_bool("Notifications", "FootstepsSounds", passos);
		set_bool("Notifications", "ItemSounds", sonsItens);
		set_bool("Notifications", "BulletBarrierSounds", sonsBalasBarreiras);
		set_bool("Notifications", "TeamAudios", audiosEquipe);
		set_bool("Notifications", "AllowSavingAudios", permitirSalvarAudios);

		if (!section_exists("Audio")) create_section("Audio");
		set_string("Audio", "InputDevice", dispositivoEntrada);
		set_string("Audio", "OutputDevice", dispositivoSaida);

		if (!section_exists("VoiceOptions")) create_section("VoiceOptions");
		set_bool("VoiceOptions", "InterruptMessages", interromperMensagens);
		set_bool("VoiceOptions", "SpeakOutsideWindow", falarForaJanela);

		save(caminhoConfig, true);
	}

	void carrega() {
		if (file_exists(caminhoConfig)) {
			load(caminhoConfig);

			idioma = get_string("General", "Language", "Português-Br");
			confirmarAoSair = get_bool("General", "ConfirmExit", true);
			verificarAtualizacoesInicio = get_bool("General", "CheckUpdatesOnStart", true);
			reprodusirLogInicio = get_bool("General", "PlayLogoOnStart", true);

			vozEscolhida = get_int("PlayerProfile", "Voice", 1);
			usarCtrlDireito = get_bool("PlayerProfile", "UseRightCtrl", false);
			salvarLogs = get_bool("PlayerProfile", "SaveLogs", true);

			escutarNotificacoesConexoes = get_int("Notifications", "ListenToConnections", 0);
			nivel = get_bool("Notifications", "LevelUpSound", false);
			Grunhidos = get_bool("Notifications", "Grunts", true);
			passos = get_bool("Notifications", "FootstepsSounds", true);
			sonsItens = get_bool("Notifications", "ItemSounds", true);
			sonsBalasBarreiras = get_bool("Notifications", "BulletBarrierSounds", true);
			audiosEquipe = get_bool("Notifications", "TeamAudios", true);
			permitirSalvarAudios = get_bool("Notifications", "AllowSavingAudios", false);

			dispositivoEntrada = get_string("Audio", "InputDevice", "padrão");
			dispositivoSaida = get_string("Audio", "OutputDevice", "padrão");

			interromperMensagens = get_bool("VoiceOptions", "InterruptMessages", false);
			falarForaJanela = get_bool("VoiceOptions", "SpeakOutsideWindow", false);
		}
		else 
			save(caminhoConfig, true);
	}
	void mostrar(){
		// diálogo de configurações
		form.reset();
		formGeral.reset();
		formPersonagem.reset();
		formNotificacoes.reset();
		formAudio.reset();
		formVoz.reset();
		form.create_window(t.busca("Configurações"), false, true);
		listaGuias = form.create_tab_panel(t.busca("Lista de guias"));
		form.set_event_callback(listaGuias, on_control_event_callback(@this.tratarEventosForm));
		form.add_list_item(listaGuias, "Preferências Gerais");
		form.add_list_item(listaGuias, "Perfil do Jogador");
		form.add_list_item(listaGuias, "Sons e Notificações");
		form.add_list_item(listaGuias, "Som e Volume");
		form.add_list_item(listaGuias, "Opções de Voz");
		guiaGeral = form.create_subform("Preferências Gerais", formGeral);
		guiaPersonagem = form.create_subform("Perfil do Jogador", formPersonagem);
		form.set_state(guiaPersonagem, true, false);
		guiaNotificacoes = form.create_subform("Sons e Notificações", formNotificacoes);
		form.set_state(guiaNotificacoes, true, false);
		guiaAudio = form.create_subform("Som e Volume", formAudio);
		form.set_state(guiaAudio, true, false);
		guiaVoz = form.create_subform("Opções de Voz", formVoz);
		form.set_state(guiaVoz, true, false);
		botaoSalvar = form.create_button("&Salvar", primary = true);
		botaoFechar = form.create_button("&Fechar", cancel = true);
		botaoRestaurarPadrao = form.create_button("&Restaurar configurações para os padrões");
		form.focus(listaGuias);
		adicionarGuiasGeral();
		adicionarGuiasPersonagem();
		adicionarGuiasNotificacoes();
		adicionarGuiasAudio();
		adicionarGuiasVoz();
		form.set_subform(guiaGeral, formGeral);
		form.focus(guiaPersonagem);
		while(true){
			wait(5);
			form.monitor();
			if(form.is_pressed(botaoFechar)){
				break;
			}
			else if(form.is_pressed(botaoSalvar)){
				getDados();
				speak(t.busca("Configurações salvas com sucesso."));
				break;
			}
			else if(form.is_pressed(botaoRestaurarPadrao)){
				restaurarPadrao();
				break;
			}
		}
	}
	private void getDados(){
		idioma = formGeral.get_list_item(listaIdiomas, formGeral.get_list_position(listaIdiomas));
		confirmarAoSair = formGeral.is_checked(aoSairCheckbox);
		verificarAtualizacoesInicio = formGeral.is_checked(verificarAtualizacoesCheckbox);
		reprodusirLogInicio = formGeral.is_checked(reprodusirLogInicioCheckbox);
		vozEscolhida = formPersonagem.get_list_position(listaVozes);
		usarCtrlDireito = formPersonagem.is_checked(ctrlDireitoCheckbox);
		salvarLogs = formPersonagem.is_checked(salvarLogsCheckbox);
		escutarNotificacoesConexoes = formNotificacoes.get_list_position(escutarNotificacoesLista);
		nivel = formNotificacoes.is_checked(nivelCheckbox);
		Grunhidos = formNotificacoes.is_checked(GrunhidosCheckbox);
		passos = formNotificacoes.is_checked(passosCheckbox);
		sonsItens = formNotificacoes.is_checked(sonsItensCheckbox);
		sonsBalasBarreiras = formNotificacoes.is_checked(sonsBalasBarreirasCheckbox);
		audiosEquipe = formNotificacoes.is_checked(audiosEquipeCheckbox);
		permitirSalvarAudios = formNotificacoes.is_checked(permitirSalvarAudiosCheckbox);
		dispositivoEntrada = formAudio.get_list_item(dispositivoEntradaLista, formAudio.get_list_position(dispositivoEntradaLista));
		dispositivoSaida = formAudio.get_list_item(dispositivoSaidaLista, formAudio.get_list_position(dispositivoSaidaLista));
		interromperMensagens = formVoz.is_checked(interromperMensagensCheckbox);
		falarForaJanela = formVoz.is_checked(falarForaJanelaCheckbox);
		salva();
	}
	private void restaurarPadrao(){
		speak(t.busca("Restaurando configurações para os padrões..."));
		if(file_exists(caminhoConfig))
			file_delete(caminhoConfig);
		carrega();
	}
	private void adicionarGuiasGeral() {
		formGeral.active = true;
		listaIdiomas = formGeral.create_list(t.busca("&Idioma"));
		string[]@ idiomas = find_files("lang/*.lang");
		for(uint i = 0; i < idiomas.length(); i++) {
			string idiomaTratado = idiomas[i];
			//tirar o "lang" do nome
			idiomaTratado = idiomaTratado.substr(0, idiomaTratado.length() - 5);
			formGeral.add_list_item(listaIdiomas, idiomaTratado);
			if(idiomaTratado == this.idioma)
				formGeral.set_list_position(listaIdiomas, i);
		}
		aoSairCheckbox = formGeral.create_checkbox(t.busca("&Confirmação ao sair"), confirmarAoSair);
		verificarAtualizacoesCheckbox = formGeral.create_checkbox(t.busca("&Verificar por atualização ao iniciar"), verificarAtualizacoesInicio);
		reprodusirLogInicioCheckbox = formGeral.create_checkbox(t.busca("&Reproduzir o logo na inicialização"), reprodusirLogInicio);
	}
	private void adicionarGuiasPersonagem() {
		formPersonagem.active = true;
		listaVozes = formPersonagem.create_list(t.busca("&Voz"));
		ctrlDireitoCheckbox = formPersonagem.create_checkbox(t.busca("Usar &CTRL direito para disparar"), usarCtrlDireito);
		salvarLogsCheckbox = formPersonagem.create_checkbox(t.busca("Salvar &logs"), salvarLogs);
	}
	private void adicionarGuiasNotificacoes() {
		formNotificacoes.active = true;
		escutarNotificacoesLista = formNotificacoes.create_list(t.busca("Escutar notificações de conexões"));
		formNotificacoes.add_list_item(escutarNotificacoesLista, t.busca("Nenhuma"));
		formNotificacoes.add_list_item(escutarNotificacoesLista, t.busca("Somente amigos"));
		formNotificacoes.add_list_item(escutarNotificacoesLista, t.busca("Todos"));
		formNotificacoes.set_list_position(escutarNotificacoesLista, escutarNotificacoesConexoes);
		nivelCheckbox = formNotificacoes.create_checkbox(t.busca("Houvir subida de &nível"), nivel);
		GrunhidosCheckbox = formNotificacoes.create_checkbox(t.busca("Grunhidos"), Grunhidos);
		passosCheckbox = formNotificacoes.create_checkbox(t.busca("&Passos de outros jogadores"), passos);
		sonsItensCheckbox = formNotificacoes.create_checkbox(t.busca("Sons de &itens"), sonsItens);
		sonsBalasBarreirasCheckbox = formNotificacoes.create_checkbox(t.busca("Sons de &balas em barreiras"), sonsBalasBarreiras);
		audiosEquipeCheckbox = formNotificacoes.create_checkbox(t.busca("Áudios da &equipe"), audiosEquipe);
		permitirSalvarAudiosCheckbox = formNotificacoes.create_checkbox(t.busca("Permitir que outros jogadores salvem seus áudios"), permitirSalvarAudios);
	}
	private void adicionarGuiasAudio() {
		formAudio.active = true;
		dispositivoEntradaLista = formAudio.create_list(t.busca("Dispositivo de &entrada"));
		dispositivoSaidaLista = formAudio.create_list(t.busca("Dispositivo de &saída"));
		string[]@ dispositivosEntrada = get_sound_input_devices();
		string[]@ dispositivosSaida = get_sound_output_devices();
		for(uint i = 0; i < dispositivosEntrada.length(); i++) {
			formAudio.add_list_item(dispositivoEntradaLista, dispositivosEntrada[i]);
		}
		for(uint i = 0; i < dispositivosSaida.length(); i++) {
			formAudio.add_list_item(dispositivoSaidaLista, dispositivosSaida[i]);
		}
		formAudio.set_list_position(dispositivoEntradaLista, dispositivosEntrada.find(dispositivoEntrada));
		formAudio.set_list_position(dispositivoSaidaLista, dispositivosSaida.find(dispositivoSaida));		
	}
	private void adicionarGuiasVoz() {
		formVoz.active = true;
		listaVozes = formVoz.create_list(t.busca("&Lista de vozes"));
		formVoz.add_list_item(listaVozes, "Leitor de tela");
		
		interromperMensagensCheckbox = formVoz.create_checkbox(t.busca("&Interromper mensagens anteriores"), interromperMensagens);
		falarForaJanelaCheckbox = formVoz.create_checkbox(t.busca("&Falar em outras janelas"), falarForaJanela);
	}
	int tratarEventosForm(audio_form@ formRecebido, int controle, control_event_type evento, dictionary@ parametros){
		if(evento == event_list_cursor){
			if(controle == listaGuias){
				int posicao = formRecebido.get_list_position(controle);
				posicao++; //começa em 0 e os controles são depois da lista
				if(posicao == guiaAtual) return 0;
				formRecebido.set_state(guiaAtual, false, false);
				guiaAtual = posicao;
				formRecebido.set_state(posicao, false, true);
			}
		}
		else if(evento == event_slider){
			if(controle == controleVolumeSliderMenu){
				somMusica.volume = retornarVolumeDePorcentagem(formRecebido.get_slider(controle));
			}
		}
		return 0;
	}
}
