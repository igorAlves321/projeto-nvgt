#include"Inventario.nvgt"
#include"speech.nvgt"

Inventario inv;
void main() {
show_window("Testando inventário.");
wait(1000);
geraDados();
string txtInventario = inv.geraTXT();
clipboard_set_text(txtInventario);
json_array@ teste = parse_json(txtInventario);
speak("Quantidade de itens deserializados: %0".format(teste.size()));
int contador = -1;
while(true) {
wait(5);
if(key_pressed(KEY_ESCAPE)) exit();
if(key_pressed(KEY_DOWN) && contador < inv.itens.length() -1) {
contador++;
speak("%0, %1".format(inv.itens[contador].nome, inv.itens[contador].quantidade));
}
if(key_pressed(KEY_UP) && contador > 0) {
contador--;
speak("%0, %1".format(inv.itens[contador].nome, inv.itens[contador].quantidade));
}
}
}

void geraDados() {
json_object obj;
obj["nome"] = "ak47";
obj["quantidade"] = 1;
obj["tipo"] = item_simples;
obj["id"] = 2;
inv.add(obj);
obj["id"] = 3;
inv.add(obj);
obj["id"] = -1;
obj["tipo"] = item_grupado;
obj["nome"] = "7.62mm";
obj["quantidade"] = 1000;
inv.add(obj);
obj["quantidade"] = 9000;
inv.add(obj);
//obj["quantidade"] = -1;
//inv.add(obj);
}
