		// Verificações finais

		if(bounty_value < 1000){

			send_reliable(players[index].peer_id, "msg2 ;"+pu.get_value("O valor mínimo da recompensa é de 1000 reais.")+";", 0);

			return;

		}

		if(players[index].inv_item_number("reais") < bounty_value){

			send_reliable(players[index].peer_id, "msg2 ;"+pu.get_value("Você não tem reais suficientes para esta recompensa.")+";", 0);

			return;

		}

		if(target_index < 0){

			send_reliable(players[index].peer_id, "msg2 ;"+pu.get_value("O jogador alvo desconectou.")+";", 0);

			return;

		}

		if(players[target_index].bounty_on_head == 1){

			send_reliable(players[index].peer_id, "msg2 ;"+pu.get_value("Este jogador já possui uma recompensa ativa.")+";", 0);

			return;

		}

		

		// Ativa a recompensa

		players[index].inv_add_item("reais", -bounty_value);

		players[index].bounty_active = 1;

		players[index].bounty_target = target_name;

		

		players[target_index].bounty_on_head = 1;

		players[target_index].bounty_value = bounty_value;

		players[target_index].bounty_owner = players[index].charname;

		players[target_index].bounty_online_time = 0;

		

		// Atualiza título do alvo

		settitle(target_index);

		

