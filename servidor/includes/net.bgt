}

else if(parsed[0]=="delete_item"&&parsed.length()>1){

for(int x=0; x<item_in_invs.length(); x++){

if(item_in_invs[x].name==parsed[1]){

item_in_invs.remove_at(x);

save_items();

eadm(players[index].charname+" ;"+pu.get_value("eliminou o item chamado")+" "+parsed[1]+".", "notify5.ogg", 150, true);

break;

}

}

}

}

}

}



// Bounty system timer logic - deve ser executado no final do loop

for(int i=0; i<players.length(); i++){

	if(players[i].bounty_on_head == 1){

		// Só conta tempo se o jogador não está AFK nem pacifista

		if(!players[i].afk && players[i].pacifico == 0){

			players[i].bounty_online_time += 50; // Incrementa baseado no ciclo do loop

			

			// Verifica se chegou aos 30 minutos (1.800.000ms)

			if(players[i].bounty_online_time >= 1800000){

				// Recompensa expira - jogador alvo recebe o valor

				players[i].inv_add_item("reais", players[i].bounty_value);

				

				// Limpa a recompensa do alvo

				int bounty_value = players[i].bounty_value;

				string bounty_owner = players[i].bounty_owner;

				players[i].bounty_on_head = 0;

				players[i].bounty_value = 0;

				players[i].bounty_owner = "";

				players[i].bounty_online_time = 0;

				

				// Limpa a recompensa ativa do dono

				int owner_index = get_player_index_from(bounty_owner);

				if(owner_index >= 0){

					players[owner_index].bounty_active = 0;

					players[owner_index].bounty_target = "";

				}

				

				// Atualiza título

				settitle(i);

				

				// Mensagem global e som

				send_reliable(0, "msgconexoes "+pu.get_value("A recompensa de ")+bounty_value+pu.get_value(" reais na cabeça de ")+players[i].charname+pu.get_value(" expirou! O jogador sobreviveu e recebeu o valor."), 0);

				send_reliable(0, "ps notice.ogg", 0);

			}

		}

	}

}

}