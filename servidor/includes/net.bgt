send_weapons(x, true);

}

eadm(players[index].charname+" ;"+pu.get_value("eliminou a arma chamada")+" "+parsed[1]+".", "notify5.ogg", 150, true);

deleted=false;

}

}

else if(parsed[0]=="new_clothe"&&parsed.length()>9){

