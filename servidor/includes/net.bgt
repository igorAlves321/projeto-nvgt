for(int x=0; x<clothes.length(); x++){

final+=clothes[x].name+"\r\n";

}

send_reliable(players[index].peer_id, "list_clothes "+final, 0);

}

else if(parsed[0]=="delete_clothe"&&parsed.length()>1){

int find=get_clothing_index(parsed[1]);

if(find>-1){

for(int x=0; x<players.length(); x++){

int find2=players[x].body_parts.find(clothes[find].body_part);

if(find2>-1) players[x].body_parts.remove_at(find2);

clothes[find].remove(x);

}

clothes.remove_at(find);

save_clothes();

load_clothes(true);

for(int x=0; x<players.length(); x++){

for(int x2=0; x2<players[x].clothing.length(); x2++){

if(get_clothing_index(players[x].clothing[x2])<0){

players[x].clothing.remove_at(x2);

}

}

}

eadm(players[index].charname+" ;"+pu.get_value("eliminou a peça de roupa chamada")+" "+parsed[1]+".", "notify5.ogg", 150, true);

}

}

else if(parsed[0]=="newitem"&&parsed.length()>13){

string nameitem=string_to_lower_case(parsed[1]);

for(int x=0; x<item_in_invs.length(); x++){

if(string_to_lower_case(item_in_invs[x].name)==nameitem){

return;

}

}

create_item(parsed[1], parsed[2], parsed[3], parsed[4], parsed[5], string_to_number(parsed[6]), string_to_number(parsed[7]), string_to_number(parsed[8]), string_to_number(parsed[9]), string_to_number(parsed[10]), string_to_number(parsed[11]), string_to_number(parsed[12]), string_to_number(parsed[13]), string_to_number(parsed[14]));

save_items();

eadm(players[index].charname+pu.get_value(" criou o seguinte item: ")+nameitem+".", "notify5.ogg", 150, true);

}

else if(parsed[0]=="list_items"){

