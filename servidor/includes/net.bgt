			double ganhar=random(10, 100)*value;

			players[index].inv_add_item("reais",ganhar);

			string msgg=string_replace(parsed[1], "corpo_de_", "", false);

			send_reliable(players[index].peer_id, "msg2 "+pu.get_value("Você enterra")+"; "+value+" ;"+pu.get_value("corpo_de_")+msgg+";. ;"+pu.get_value("Ótimo trabalho!")+"; +"+ganhar+" "+pu.get_value("reais."), 0);

		}

