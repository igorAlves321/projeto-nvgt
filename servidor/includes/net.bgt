}

}

	else if(event.type==event_receive and event.channel==4){

		int index=get_player_index(event.peer_id);

		string[] parsed=string_split(get_event_message()," ",true);

		if(index>-1&&index<players.length){

			if(parsed[0]=="a"&&pvp&&parsed.length()>1){

				/*if(is_cheating(index, 25)) eadm(players[index].charname+" ;aparentemente está usando cheat engine, favor de corroborar esta informação.;", "notify54.ogg");

				players[index].tpackets.restart();*/

				int windex=string_to_number(parsed[1]);

				double degradation_value, absolute_degradation;

				if(weapons[windex].degradation_point>0) {

					degradation_value=random(1, weapons[windex].degradation_point);

					absolute_degradation =weapons[windex].degradation_point;

				}

				if(degradation_value== absolute_degradation && windex>0) {

					players[index].manage_degradation(weapons[windex].name, 0.1);

				}

				weapons[windex].shoot(index, windex, players[index].lado);

				server_maps[players[index].mapindex].send_to_others(players[index].peer_id, 4, "f "+weapons[windex].sound_shoot+".ogg", players[index].x, players[index].y, 20, true);

			}

		}

	}

else if(event.type==event_receive and event.channel==13){

int index=get_player_index(event.peer_id);

string[] parsed=string_split(get_event_message(), "::", true);

if(index>-1&&index<players.length){

if(parsed[0]=="list_degrades"){

string[] data, keys=players[index].degradation.get_keys();

double value;

data.insert_at(0, ";"+pu.get_value("Este é o nível atual de desgaste de suas armas.")+";");

for(int x=0; x<keys.length(); x++){

if(players[index].inv_item_number(keys[x])>0){

int windex=get_weapon_index(keys[x]);

if(windex>-1){

players[index].degradation.get(keys[x], value);

data.insert_last(";"+keys[x]+";, "+value+"%");

}

}

}

if(data.length()==1){

send_reliable(players[index].peer_id, "msg2 ;"+pu.get_value("Ao perceber que está tentando verificar o desgaste de uma arma que nem sequer possui, você começa a se sentir bastante estúpido")+players[index].sexo2+".;", 0);

return;

}

send_reliable(players[index].peer_id, "menuleitura "+linear(data), 0);

}

if(parsed[0]=="kill_stats"){

