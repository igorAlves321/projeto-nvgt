	if(event.type==event_disconnect){

		int index=get_player_index(event.peer_id);

		if(index>-1){

			if(ar.is_open==1){

				ar.remove_player_from(index);

			}

			if(players[index].invs==0 && !players[index].is_admin()) {

				send_reliable(0, "msgconexoes "+players[index].charname+pu.get_value(" perdeu a conexão com o jogo."), 0);

