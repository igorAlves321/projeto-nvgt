f.close();

load_craft_file();

eadm(players[index].charname+" ;"+pu.get_value("adicionou um crafteo novo à lista de crafteos possíveis. para vê-lo, favor revisar na opção ver crafteos no celular.")+";", "notify5.ogg", 150, true);

}

