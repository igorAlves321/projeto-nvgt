for(int x=0; x<players.length(); x++){

send_weapons(x);

}

eadm(players[index].charname+" ;"+pu.get_value("criou uma arma, o nome é:")+" "+parsed[1]+". ;"+pu.get_value("É recomendável testar seu funcionamento.")+";", "notify5.ogg", 150, true);

}

else if(parsed[0]=="list_weapons"){

