			send_reliable(players[index].peer_id, "msg2 ;"+pu.get_value("Você não pode colocar recompensa em si mesmo.")+";", 0);

			return;

		}

		if(target_index < 0){

			send_reliable(players[index].peer_id, "msg2 ;"+pu.get_value("Jogador não encontrado ou desconectado.")+";", 0);

			return;

		}

		if(players[target_index].bounty_on_head == 1){

			send_reliable(players[index].peer_id, "msg2 ;"+pu.get_value("Este jogador já possui uma recompensa ativa.")+";", 0);

			return;

		}

		

		// Solicita o valor da recompensa

