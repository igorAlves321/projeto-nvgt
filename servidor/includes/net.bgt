eadm(players[index].charname+" ;"+pu.get_value("eliminou o crafteo dos itens")+" "+parsed[1]+" ;"+pu.get_value("e")+" "+parsed[2]+".", "notify5.ogg", 150, true);

}

}

if(parsed[0]=="create_weapon"&&parsed.length()>21){

file f;

