f.open("crafting.db", "r");

lines=delinear(f.read());

f.close();

for(int x=0; x<lines.length(); x++){

string[] data=string_split(lines[x], "=", false);

if(data.length()>1){

string[] itemname1=string_split(data[0], ".", false);

string[] itemname2=string_split(data[1], ".", false);

