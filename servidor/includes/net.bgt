return;

}

lines.insert_last(parsed[1]+"="+parsed[2]+"="+parsed[3]+"="+parsed[4]+"="+parsed[5]+"="+parsed[6]+"="+parsed[7]+"="+parsed[8]+"="+parsed[9]);

