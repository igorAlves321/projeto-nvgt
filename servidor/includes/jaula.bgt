//jaula
jaula@[] jaulas;
class jaula{
int x, y;
string golpeado, dueno;
string map;
double vida=100000000;
jaula(int cx, int cy, string cmap, string dueno2, double vida2){
x=cx;
y=cy;
map=cmap;
dueno=dueno2;
vida=vida2;
}
}
void jaulaloop(){
for(uint i=0; i<jaulas.length(); i++){
if(jaulas[i].vida<=0){
int mapindex=get_map_index_from(jaulas[i].map);
string golp=jaulas[i].golpeado;
int index=get_player_index_from(jaulas[i].dueno);
if(index>-1){
send_reliable(players[index].peer_id, "msg2 ;¡Tu jaula fue derribada!;", 0);
}
index=get_player_index_from(golp);
if(index>-1){
players[index].inv_add_item("mgerems", 14242639);
players[index].inv_add_item("elementales", 494233);
ganhaxp(players[index].charname, random(15000000, 25000000));
}
for(uint i2=0; i2<cachorromascotas.length(); i2++){
if(cachorromascotas[i2].map=="jaula_del_cachorro_de_"+jaulas[i].dueno){
cachorromascotas[i2].map=jaulas[i].map;
cachorromascotas[i2].x=jaulas[i].x;
cachorromascotas[i2].y=jaulas[i].y;
cachorromascotas[i2].amarrado=0;
}
}
for(uint i2=0; i2<players.length(); i2++){
if(players[i2].map=="jaula_del_cachorro_de_"+jaulas[i].dueno){
changemap(jaulas[i].map, i2, jaulas[i].x, jaulas[i].y);
}
}
file_delete("maps/jaula_del_cachorro_de_"+jaulas[i].dueno+".map");
remove_map("jaula_del_cachorro_de_"+jaulas[i].dueno);
if(mapindex>-1){
server_maps[mapindex].remove_line("z:"+jaulas[i].x+":"+jaulas[i].x+":"+jaulas[i].y+":"+jaulas[i].y+":Una jaula plateada.");
save_map(server_maps[mapindex].name);
server_maps[mapindex].send_packet(0,"play m_tripode.ogg", jaulas[i].x, jaulas[i].y);
}
insert_map(jaulas[i].map);
update2(jaulas[i].map);
file_delete("players/"+jaulas[i].dueno+"/jaula.usr");
jaulas.remove_at(i);
}
}
}

void spawn_jaula(int x, int y, string map, string dueno, double vida){
jaula c(x, y, map, dueno, vida);
jaulas.insert_last(c);
}

void install_jaula(int x, int y, string map, string dueno, double vida =100000000){
	int index =get_player_index_from(dueno);
	if(index>-1) {
		if(string_contains(map, "isla_privada_de_", 1)<0) {
			send_reliable(players[index].peer_id, "msg2 ;por una extraña razón no puedes hacer esto...", 0);
			return;
		}
	}
	int mapindex=get_map_index_from(map);
	file f;
	for(uint i=0; i<jaulas.length(); i++){
		if(jaulas[i].map==map){
			send_reliable(players[index].peer_id, "msg2 ya hay una jaula puesta en este lugar!", 0);
			return;
		}
	}
	if(file_exists("players/"+dueno+"/jaula.usr")){
		send_reliable(players[index].peer_id, "msg2 pero tú ya tienes una jaula!", 0);
		return;
	}
	else{
		if(mapindex>-1){
			server_maps[mapindex].mapdata.insert_last("z:"+x+":"+x+":"+y+":"+y+":Una jaula plateada.");
			save_map(server_maps[mapindex].name);
		}
		insert_map(map);
		update2(map);
		server_maps[mapindex].send_packet(0, "play metal4hardland.ogg", players[index].x, players[index].y);
		players[index].inv_add_item("jaula_para_el_perro", -1);
		f.open("players/"+dueno+"/jaula.usr", "w");
		f.write("");
		f.close();
	}
	string mapname="jaula_del_cachorro_de_"+dueno;
	f.open("plantillas/jaula.map", "r");
	string[] lines = delinear(f.read());
	f.close();
	lines.remove_at(0);
	string wtext ="map:"+mapname;
	string travelpoint ="tp:1:1:0:0:"+x+":"+y+":salidajaula:Sales de la jaula.";
	lines.insert_at(0, wtext);
	lines.insert_last(travelpoint);
	wtext =linear(lines);
	f.open("maps/"+mapname+".map", "w");
	f.write(wtext);
	f.close();
	spawn_jaula(x, y, map, dueno, vida);
	insert_map(mapname);
}

void cargarjaulas(){
file tb;
if(!tb.open("jaulas.usr", "r")){
return;
}
string tbdata=tb.read();
tb.close();
if(tbdata==""){
return;
}
string[] tjaulas=string_split(tbdata, "\r\n", false);
if(tjaulas.length()>0){
for(uint i=0; i<tjaulas.length(); i++){
string[] parsed=string_split(tjaulas[i], "=", false);
spawn_jaula(string_to_number(parsed[0]), string_to_number(parsed[1]), parsed[2], parsed[3], string_to_number(parsed[4]));
}
}
return;
}

void salvarjaulas(){
string final;
for(uint i=0; i<jaulas.length(); i++){
final+=jaulas[i].x+"="+jaulas[i].y+"="+jaulas[i].map+"="+jaulas[i].dueno+"="+jaulas[i].vida+"\r\n";
}
file f;
f.open("jaulas.usr", "w");
f.write(final);
f.close();
}
