clothe@[] clothes;
class clothe{
string body_part, name, sound_draw, sound_remove, description;
int show_all, enable_degradation;
double degradation, protection;
clothe(string name2, string body_part2, string description2, string sound_draw2, string sound_remove2, int show_all2, int enable_degradation2, double degradation2, double protection2){
this.name=name2;
this.body_part=body_part2;
this.description=description2;
this.sound_draw=sound_draw2;
this.sound_remove=sound_remove2;
this.show_all=show_all2;
this.enable_degradation=enable_degradation2;
this.degradation=degradation2;
this.protection=protection2*0.01;
}
int put(int index){
int  find=players[index].clothing.find(this.name);
if(find>-1){
return 0;
}
find=players[index].body_parts.find(this.body_part);
if(find>-1){
return 1;
}
else{
players[index].clothing.insert_last(this.name);
players[index].body_parts.insert_last(this.body_part);
players[index].clothing_protection+=this.protection;
find=get_clothing_index(this.name);
if(players[index].clothing_indexs.find(find)<0) players[index].clothing_indexs.insert_last(find);
if(string_contains(this.name, "reloj", 1)>-1||string_contains(this.name, "watch", 1)>-1){
players[index].relogio=1;
}
if(string_contains(this.name, "paracaídas", 1)>-1){
players[index].have_parachute=1;
}
return 2;
}
}
int remove(int index){
int find_c_i, find=players[index].clothing.find(this.name);
if(find<0){
return 0;
}
else{
players[index].clothing.remove_at(find);
find=players[index].body_parts.find(this.body_part);
if(find>-1) players[index].body_parts.remove_at(find);
players[index].clothing_protection-=this.protection;
find=get_clothing_index(this.name);
find_c_i=players[index].clothing_indexs.find(find);
if(find_c_i>-1) players[index].clothing_indexs.remove_at(find_c_i);
if(string_contains(this.name, "reloj", 1)>-1){
players[index].relogio=0;
}
if(string_contains(this.name, "paracaídas", 1)>-1){
players[index].have_parachute=0;
}
return 1;
}
}
}
int get_clothing_index(string name){
for(int x=0; x<clothes.length(); x++){
if(clothes[x].name==name){
return x;
}
}
return -1;
}
void load_clothes(bool resize=false){
file f;
if(resize==true){
clothes.resize(0);
}
if(!f.open("clothes.db", "r")){
return;
}
else{
string content=f.read();
f.close();
if(content==""){
return;
}
else{
string[] lines=delinear(content);
for(int x=0; x<lines.length(); x++){
string[] data=string_split(lines[x], "=", true);
if(data.length()>8){
clothe c(data[0], data[1], data[2], data[3], data[4], string_to_number(data[5]), string_to_number(data[6]), string_to_number(data[7]), string_to_number(data[8]));
clothes.insert_last(c);
}
}
}
}
}
void save_clothes(){
file f;
string final;
for(int x=0; x<clothes.length(); x++){
final+=clothes[x].name+"="+clothes[x].body_part+"="+clothes[x].description+"="+clothes[x].sound_draw+"="+clothes[x].sound_remove+"="+clothes[x].show_all+"="+clothes[x].enable_degradation+"="+clothes[x].degradation+"="+(clothes[x].protection/0.01)+"\r\n";
}
f.open("clothes.db", "w");
f.write(final);
f.close();
}
int clothe_exists(string name){
file f;
if(!f.open("clothes.db", "r")){
return -1;
}
else{
string content=f.read();
f.close();
if(content==""){
return -2;
}
else{
string[] lines=delinear(content);
for(int x=0; x<lines.length(); x++){
string[] data=string_split(lines[x], "=", true);
if(data[0]==name){
return 1;
}
}
}
}
return -3;
}

bool has_clothe(int cindex, int index){
int find=players[index].clothing_indexs.find(cindex);
if(find>-1){
return true;
}
return false;
}