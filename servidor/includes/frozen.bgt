class congelar{
int minx, maxx, miny, maxy;
congelar(int min_x, int max_x, int min_y, int max_y){
this.minx=min_x;
this.maxx=max_x;
this.miny=min_y;
this.maxy=max_y;
}
}
class asfixiar{
int minx, maxx, miny, maxy;
asfixiar(int min_x, int max_x, int min_y, int max_y){
this.minx=min_x;
this.maxx=max_x;
this.miny=min_y;
this.maxy=max_y;
}
}
class death{
int minx, maxx, miny, maxy, time, enable_progressive_death, require_item;
double life, item_cantity;
string reason, item;
death(int min_x, int max_x, int min_y, int max_y, int time2, int enable_progressive_death2, double life2, string reason2, string item2, int require_item2, double item_cantity2){
this.minx=min_x;
this.maxx=max_x;
this.miny=min_y;
this.maxy=max_y;
this.time=time2;
this.enable_progressive_death=enable_progressive_death2;
this.life=life2;
this.reason=reason2;
this.item=item2;
this.require_item=require_item2;
this.item_cantity=item_cantity2;
}
}
