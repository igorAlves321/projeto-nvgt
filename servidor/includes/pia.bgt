//Pias
class pia{
	int x, y;
	bool aberta=false;
	timer fechar, fechando;
	string map;
	pia(int bx, int by, string map) {
		x=bx;
		y=by;
		fechar.force(0);
		fechar.pause();
		fechando.force(0);
		fechando.pause();
		this.map =map;
	}

