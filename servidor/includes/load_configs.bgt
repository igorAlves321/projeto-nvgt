void load_configs(int index){
file f;
if(index>-1){
f.open("players/"+players[index].charname+"/configs.ini","rb");
dictionary@ sd=deserialize(f.read());
f.close();
sd.get("sexo", players[index].sexo);
if(sd.exists("nomesequipe")){
string nequipe;
sd.get("nomesequipe", nequipe);
players[index].nomesequipe=string_split(nequipe, "\r\n", false);
}
if(sd.exists("title")) {
sd.get("title", players[index].title);
}
if(sd.exists("relogio")) {
sd.get("relogio", players[index].relogio);
}
if(sd.exists("parachute")) {
sd.get("parachute", players[index].have_parachute);
}
if(sd.exists("clothing")){
string clothing;
sd.get("clothing", clothing);
if(clothing=="")players[index].clothing.resize(0);
else players[index].clothing=delinear(clothing);
for(int x=0; x<players[index].clothing.length(); x++){
int find=get_clothing_index(players[index].clothing[x]);
if(find<0){
players[index].clothing.remove_at(x);
}
else{
players[index].clothing_indexs.insert_last(find);
players[index].clothing_protection+=clothes[find].protection;
}
}
}
if(sd.exists("body_parts")){
string body_parts;
sd.get("body_parts", body_parts);
if(body_parts=="")players[index].body_parts.resize(0);
else players[index].body_parts=delinear(body_parts);
}
if(sd.exists("married")){
sd.get("married", players[index].whomarried);
}
if(sd.exists("parabatai")){
sd.get("parabatai", players[index].whoparabatai);
}
if(sd.exists("elemental_energy")){
sd.get("elemental_energy", players[index].elemental_energy);
}
if(sd.exists("l_es_v")){
sd.get("l_es_v", players[index].l_es_v);
}
if(sd.exists("l_en_v")){
sd.get("l_en_v", players[index].l_en_v);
}
if(sd.exists("l_fr_v")){
sd.get("l_fr_v", players[index].l_fr_v);
}
if(sd.exists("l_pt_v")){
sd.get("l_pt_v", players[index].l_pt_v);
}
if(sd.exists("avisafangelical")){
sd.get("avisafangelical", players[index].avisafangelical);
}
if(sd.exists("avisanivel")){
sd.get("avisanivel", players[index].avisanivel);
}
if(sd.exists("avisaserver")){
sd.get("avisaserver", players[index].avisaserver);
}
if(sd.exists("avisaxp")){
sd.get("avisaxp", players[index].avisaxp);
}
if(sd.exists("arank")){
sd.get("arank", players[index].arank);
}
if(sd.exists("avisarcg")){
sd.get("avisarcg", players[index].avisarcg);
}
if(sd.exists("dequipo")){
sd.get("dequipo", players[index].dequipo);
}
if(sd.exists("aitem")){
sd.get("aitem", players[index].aitem);
}
if(sd.exists("dpm")){
sd.get("dpm", players[index].dpm);
}
sd.get("reply", players[index].replyname);
if(players[index].nomesequipe.length()==0)players[index].nomesequipe.insert_last(players[index].charname);
if(sd.exists("map")){
sd.get("map", players[index].map);
players[index].mapindex=get_map_index_from(players[index].map);
if(players[index].mapindex<0){
changemap("parque", index, 1, 0);
}
}
if(sd.exists("validated_name")) sd.get("validated_name", players[index].validated_name);
if(sd.exists("needs_to_change")) sd.get("needs_to_change", players[index].needs_to_change);
sd.get("silenciado", players[index].silenciado);
sd.get("temposilencio", players[index].temposilencio);
if(sd.exists("tsilencio")) {
double tsilencio;
sd.get("tsilencio", tsilencio);
players[index].tsilencio.force(tsilencio);
}
if(sd.exists("antispam")) {
sd.get("antispam", players[index].antispam);
}
if(sd.exists("antispam_time")) {
sd.get("antispam_time", players[index].antispam_time);
}
if(sd.exists("total_messages")) {
sd.get("total_messages", players[index].total_messages);
}
sd.get("bebida", players[index].caverna);
if(sd.exists("tbebida")){
double tbebida;
sd.get("tbebida", tbebida);
players[index].tcaverna.force(tbebida);
}
if(sd.exists("caverna_time")) sd.get("caverna_time", players[index].caverna_time);
if(sd.exists("amethyst")) sd.get("amethyst", players[index].amethyst);
if(sd.exists("tamethyst")){
double tamethyst;
sd.get("tamethyst", tamethyst);
players[index].tamethyst.force(tamethyst);
}
if(sd.exists("amethyst_time")) sd.get("amethyst_time", players[index].amethyst_time);
if(sd.exists("afktime")){
sd.get("afktime", players[index].afktime);
players[index].afkreturntimer.force(players[index].afktime);
}
if(sd.exists("muted")){
sd.get("muted", players[index].muted);
}
if(sd.exists("paralisado")){
sd.get("paralisado", players[index].paralisado);
}
if(sd.exists("health")){
sd.get("health", players[index].health);
}
if(sd.exists("xp")){
sd.get("xp", players[index].xp);
}
if(sd.exists("level")){
sd.get("level", players[index].level);
}
if(sd.exists("fangelical")){
sd.get("fangelical", players[index].fangelical);
}
if(sd.exists("nsede")){
sd.get("nsede", players[index].nsede);
}
if(sd.exists("nfome")){
sd.get("nfome", players[index].nfome);
}
if(sd.exists("nurina")){
sd.get("nurina", players[index].nurina);
}
if(sd.exists("ncoco")){
sd.get("ncoco", players[index].ncoco);
}
if(sd.exists("sujo")){
sd.get("sujo", players[index].sujo);
}
sd.get("trueno", players[index].trueno);
sd.get("ameteoro", players[index].ameteoro);
sd.get("antimina", players[index].antimina);
sd.get("protegido", players[index].protegido);
double ttrueno, tprotegido, tantimina, tameteoro, tmeteoro, tiempometeoro;
sd.get("ttrueno", ttrueno);
players[index].tmveloz2.force(ttrueno);
if(players[index].trueno==1) send_reliable(players[index].peer_id,"aveloz",0);
sd.get("tameteoro", tameteoro);
players[index].tameteoro.force(tameteoro);
sd.get("tiempometeoro", players[index].tiempometeoro);
sd.get("tmeteoro", tmeteoro);
players[index].tmeteoro.force(tmeteoro);
sd.get("tantimina", tantimina);
players[index].tantimina.force(tantimina);
sd.get("tprotegido", tprotegido);
players[index].tprotegido.force(tprotegido);
if(sd.exists("sanity")){
sd.get("sanity", players[index].sanity);
}
if(sd.exists("payment")){
sd.get("payment", players[index].payment);
}
if(sd.exists("payed")){
sd.get("payed", players[index].payed);
}
if(sd.exists("have_island")){
sd.get("have_island", players[index].have_island);
}
if(sd.exists("celestiums")){
sd.get("celestiums", players[index].celestiums);
}
if(sd.exists("creditos")){
sd.get("creditos", players[index].creditos);
}
// Compatibilidade com versões anteriores que usavam 'esmeraldas'
else if(sd.exists("esmeraldas")){
sd.get("esmeraldas", players[index].creditos);
}
if(sd.exists("pacifico")){
sd.get("pacifico", players[index].pacifico);
}
if(sd.exists("lregras")){
sd.get("lregras", players[index].lregras);
}
if(sd.exists("invs")){
sd.get("invs", players[index].invs);
}
if(players[index].invs==1) send_reliable(0,"playerbeep "+players[index].charname+" 0", 0);
if(sd.exists("anillodegradacion")){
sd.get("anillodegradacion", players[index].anillodegradacion);
}
if(sd.exists("vitalidaddegradacion")){
sd.get("vitalidaddegradacion", players[index].vitalidaddegradacion);
}
if(sd.exists("vitalidad_time")){
sd.get("vitalidad_time", players[index].vitalidad_time);
}
if(sd.exists("maxhealth")){
sd.get("maxhealth", players[index].maxhealth);
}
if(sd.exists("healthfixed")){
sd.get("healthfixed", players[index].healthfixed);
}
if(sd.exists("nbaculo")){
sd.get("nbaculo", players[index].nbaculo);
}
if(sd.exists("saludfangelical")){
sd.get("saludfangelical", players[index].saludfangelical);
}
if(sd.exists("baculofangelical")){
sd.get("baculofangelical", players[index].baculofangelical);
}
if(sd.exists("baculotiempo")){
sd.get("baculotiempo", players[index].baculotiempo);
}
if(sd.exists("cantidadcachorros")){
sd.get("cantidadcachorros", players[index].cantidadcachorros);
}
if(sd.exists("mapavoltar")){
sd.get("mapavoltar", players[index].mapavoltar);
}
if(sd.exists("premapa")){
sd.get("premapa", players[index].premapa);
}
if(sd.exists("preteam")){
string nequipe;
sd.get("preteam", nequipe);
players[index].preteam=string_split(nequipe, "\r\n", false);
}
if(sd.exists("prex")){
sd.get("prex", players[index].prex);
}
if(sd.exists("prey")){
sd.get("prey", players[index].prey);
}
if(sd.exists("tempoprision")){
sd.get("tempoprision", players[index].tempoprision);
}
if(sd.exists("saldo")){
sd.get("saldo", players[index].saldo);
}
// Carregar contadores de kills para o sistema de patentes
if(sd.exists("kills")){
sd.get("kills", players[index].kills);
}
if(sd.exists("matou")){
sd.get("matou", players[index].matou);
}
if(file_exists("players/"+players[index].charname+"/status.usr")) {
f.open("players/"+players[index].charname+"/status.usr", "r");
	string status=f.read();
f.close();
if(status.length()>1024){
status.resize(1024);
f.open("players/"+players[index].charname+"/status.usr", "w");
f.write(status);
f.close();
}
players[index].seestatus=status;
}
}
}
