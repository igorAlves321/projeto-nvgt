class obj{
string itemname, map, sound_get, tile;
int x, y, time_out, disable_respawn, time_respawn;
double amount;
bool taked=false;
timer ttime_out, trespawn, tfall;
obj(int x, int y, int time_out, int disable_respawn, double amount, string itemname, string map, string sound_get, int time_respawn=0){
this.x=x;
this.y=y;
this.time_out=time_out;
this.disable_respawn=disable_respawn;
this.amount=amount;
this.itemname=itemname;
this.map=map;
this.sound_get=sound_get;
this.time_respawn=time_respawn;
}
void get(int index){
players[index].inv_add_item(this.itemname, this.amount);
send_packet(0, "play "+this.sound_get+".ogg", players[index].x, players[index].y, players[index].mapindex);
taked =true;
}
}
class obj_data{
string itemname, map, sound_get, x_data;
int y, time_out, disable_respawn, time_respawn;
double amount;
timer ttime_out, trespawn;
obj_data(string x_data2, int y, int time_out, int disable_respawn, double amount, string itemname, string map, string sound_get, int time_respawn=0){
this.x_data=x_data2;
this.y=y;
this.time_out=time_out;
this.disable_respawn=disable_respawn;
this.amount=amount;
this.itemname=itemname;
this.map=map;
this.sound_get=sound_get;
this.time_respawn=time_respawn;
}
}
bool obj_exists(string name, string map){
int mapindex=get_map_index_from(map);
for (int i=0; i<server_maps[mapindex].objs.length(); i++){
if (server_maps[mapindex].objs[i].itemname==name)
return true;
}
return false;
}

void spawn_obj(string coors_x, int y, int time_out, int disable_respawn, double amount, string name, string map, string sound_get, int time_respawn=0){
int mapindex=get_map_index_from(map);
if(mapindex>-1){
int x1, x2;
string[] data=string_split(coors_x, ",", false);
if(data.length()==1){
obj o(string_to_number(data[0]), y, time_out, disable_respawn, amount, name, map, sound_get, time_respawn);
server_maps[mapindex].objs.insert_last(o);
}
else if(data.length()>1){
obj o(random(string_to_number(data[0]), string_to_number(data[1])), y, time_out, disable_respawn, amount, name, map, sound_get, time_respawn);
server_maps[mapindex].objs.insert_last(o);
}
}
}

int get_item_index(string name, int mapindex){
	for(int x=0; x<server_maps[mapindex].objs.length(); x++){
		if(string_to_lower_case(server_maps[mapindex].objs[x].itemname)==string_to_lower_case(name)) return x;
	}
	return -1;
}