void settitle(int index) {
	if(file_exists("players/"+players[index].charname+"/cheater.usr")) {
		players[index].title ="Cheater";
		return;
	}
	if(players[index].afk==true) players[index].title="Ausente";
			else if(players[index].pacifico==1&&players[index].afk==false) players[index].title="pacifico";
			else if(players[index].pacifico==0&&players[index].afk==false&&players[index].newbie==true) players[index].title="Novat"+players[index].sexo2+"";		else if(players[index].level<=200&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="soldado";		else if(players[index].level>200 and players[index].level<=1000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="cabo";		else if(players[index].level>1000 and players[index].level<=2000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="sargento";			else if(players[index].level>2000 and players[index].level<=3000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
					players[index].title="subtenente";			else if(players[index].level>3000 and players[index].level<=4000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="tenente";			else if(players[index].level>4000 and players[index].level<=5000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
					players[index].title="capitao";			else if(players[index].level>5000 and players[index].level<=6000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
					players[index].title="major";			else if(players[index].level>6000 and players[index].level<=7000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
					players[index].title="tenente_coronel";			else if(players[index].level>7000 and players[index].level<=10000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="coronel";			else if(players[index].level>10000 and players[index].level<=12000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="general_de_brigada";			else if(players[index].level>12000 and players[index].level<=16000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="general_de_divisao";			else if(players[index].level>16000 and players[index].level<=20000&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="general_de_exercito";			else if(players[index].level>=20000 and players[index].level<=30001&&players[index].newbie==false&&players[index].pacifico==0&&players[index].afk==false)
			players[index].title="marechal";
}
