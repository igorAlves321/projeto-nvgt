				if(players[index2].map=="templop2" && players[index2].x>=201 && players[index2].x<=205 && players[index2].y==103) {
					if(players[index2].inv_item_number("reais")<2000000000 || players[index2].inv_item_number("dólares")<500000000 || players[index2].stryx<1000) {
						send_reliable(players[index2].peer_id, "msg2 ;Tu parabatai no tiene lo necesario para pagar el precio de esta decisión...;", 0);
						return;
					}
					string title ="¿Estás seguro que deseas romper la sagrada alianza del parabatai?";
					string packet ="parabatai_remove";
					string[] options={"Si=send_question", "No=no"};
					string[] soundsmenu={"menuopcion.ogg", "menuenter3.ogg", "menuopen2.ogg"};
					send_menu(index, title, packet, 0, options, soundsmenu);
				}
			}
			else send_reliable(players[index].peer_id, "msg2 ;Tu parabatai no se encuentra presente en esta dimensión...;", 0);
		}
		else return;
	}
	netloop();
}

