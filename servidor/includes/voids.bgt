bool is_incorrect(string message){
	message=string_to_lower_case(message);
	string[] filter;
	filter.insert_last(" ");
	filter.insert_last("�");
	filter.insert_last("~");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("\"");
	filter.insert_last("!");
	filter.insert_last("#");
	filter.insert_last("$");
	filter.insert_last("%");
	filter.insert_last("�");
	filter.insert_last("*");
	filter.insert_last("");
	filter.insert_last("");
	filter.insert_last("+");
	filter.insert_last("{");
	filter.insert_last("}");
	filter.insert_last("`");
	filter.insert_last("^");
	filter.insert_last("|");
	filter.insert_last("<");
	filter.insert_last(">");
	filter.insert_last(":");
	filter.insert_last("�");
	filter.insert_last("\\");
	filter.insert_last(",");
	filter.insert_last(";");
	filter.insert_last("[");
	filter.insert_last("]");
	filter.insert_last("�");
	filter.insert_last("=");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	filter.insert_last("�");
	for(int counter=0; counter<filter.length(); counter++){
		string banned=filter[counter];
		if(string_contains(message, filter[counter], 1)>-1){
			return true;
		}
	}
	return false;
}
bool igual(string n1, string n2){
	if(string_to_lower_case(n1)==string_to_lower_case(n2))return true;
	return false;
}
void log(string text, string name){
file f;
f.open(name+".log", "a");
f.write(text+"\r\n");
f.close();
}
void save_transfer(string origin, string destination, string itemname, double cantity) {
	int year, mounth, day, hour, minute;
	year =DATE_YEAR;
	month =DATE_MONTH;
	day =DATE_DAY;
	hour =TIME_HOUR;
	minute =TIME_MINUTE;
	string send_info =origin+" "+"el"+" "+day+"."+month+"."+year+" "+"a las"+" "+hour+"."+minute+" "+"transfiri�"+" "+cantity+" "+itemname+" "+"para"+" "+destination+"\r\n";
	string receive_info =destination+" "+"el"+" "+day+"."+month+"."+year+" "+"a las"+" "+hour+"."+minute+" "+"recibi�"+" "+cantity+" "+itemname+" "+"de"+" "+origin+"\r\n";
	string log_name ="transferences_"+day+"."+month+"."+year+".log";
	if(origin !="" && destination !="") {
		write_transfer_log(origin, log_name, send_info);
		write_transfer_log(destination, log_name, receive_info);
	}
}

void save_transfer(string origin, string destination, string itemname, string info, double cantity) {
	int year, mounth, day, hour, minute;
	year =DATE_YEAR;
	month =DATE_MONTH;
	day =DATE_DAY;
	hour =TIME_HOUR;
	minute =TIME_MINUTE;
	string send_info =origin+" "+"el"+" "+day+"."+month+"."+year+" "+"a las"+" "+hour+"."+minute+" "+"transfiri�"+" "+cantity+" "+itemname+" "+"para"+" "+destination+" "+info+"\r\n";
	string receive_info =destination+" "+"el"+" "+day+"."+month+"."+year+" "+"a las"+" "+hour+"."+minute+" "+"recibi�"+" "+cantity+" "+itemname+" "+"de"+" "+origin+" "+info+"\r\n";
	string log_name ="transferences_"+day+"."+month+"."+year+".log";
	if(origin !="" && destination !="") {
		write_transfer_log(origin, log_name, send_info);
		write_transfer_log(destination, log_name, receive_info);
	}
}

bool is_unbannable(string name){
file f;
f.open("unbannables.txt", "r");
string text=f.read();
f.close();
string[] names=string_split(text, "\r\n", false);
for(uint i=0; i<names.length(); i++){
if(name==names[i]){
return true;
}
}
return false;
}
bool is_enable_dev_commands(string name){
file f;
f.open("dev_commands.txt", "r");
string text=f.read();
f.close();
string[] names=string_split(text, "\r\n", false);
int find=names.find(name);
if(find>-1){
return true;
}
return false;
}
bool is_enable_command(string name, string command){
file f;
f.open("commands/"+command+".txt", "r");
string[] a=delinear(f.read());
f.close();
int find=a.find(name);
if(find>-1){
return true;
}
return false;
}

void eadm(string msg, string soundfile="notify7.ogg", double pitch=100, bool save=false){
	if(save){
		msgadm.insert_last(msg);
		file f;
		f.open("servidor.msgadm","a");
		f.write(msg+"\r\n");
		f.close();
	}
	for(uint i=0;i<players.length();i++){
		if(players[i].is_admin()||players[i].is_mod()){
			send_reliable(players[i].peer_id, "ps2 "+soundfile+" "+pitch, 0);
			send_reliable(players[i].peer_id, "msg4 "+msg, 0);
		}
	}
}
void eagle_message(string msg, string text_to_save){
	file f;
	f.open("eagle_messages.db", "a");
	f.write(string_replace(text_to_save, ";", "", true)+"\r\n");
	f.close();
	for(uint i=0;i<players.length();i++){
		if(players[i].is_admin()||players[i].is_mod()){
			send_reliable(players[i].peer_id, "ps bot126.ogg", 0);
			send_reliable(players[i].peer_id, "msg4 "+msg, 0);
		}
	}
}

void enviar_error_de_juego(int index, string[] parsed){
	string msg=string_replace(get_event_message(), parsed[0]+" ", "", false);
	if(msg.length()<120) {
		send_reliable(players[index].peer_id, "msg2 ;El mensaje es muy corto, su reporte debe tener un m�nimo de 120 caracteres.;", 0);
	}
	else{
		if(!directory_exists("bugs")) directory_create("bugs");
		file f;
		f.open("bugs/error_de_"+players[index].charname+".txt", "a");
		f.write("Error: "+msg+"\r\n");
		f.close();
		send_reliable(players[index].peer_id, "msg2 ;�Error reportado!;", 0);
		eadm("Error reportado por "+players[index].charname+": "+msg, "notify7.ogg", 100, true);
	}
}

void morreu(int index, string[] parsed){
	send_reliable(0, "msgmuerte "+players[index].charname+"; ;morreu; ;"+string_replace(get_event_message(), parsed[0]+" ", "", false), 3);
	changemap("portal_espiritual", index, 1, 0);
	players[index].health=players[index].maxhealth;
	players[index].centado=false;
	if(players[index].inv_item_number("areia_da_montanha")>0){
		players[index].inv_add_item("areia_da_montanha", -1);
		send_reliable(players[index].peer_id, "ps notify_died.ogg", 0);
	}
	if(players[index].cloaked){
		players[index].cloaked=false;
		players[index].cloakhiding=false;
		send_reliable(players[index].peer_id,"stopcloak",0);
		send_packet(0, "play spell_cloak_powerdown.ogg", players[index].x, players[index].y, players[index].mapindex);
	}
	players[index].envenenado=false;
	players[index].nveneno=0;
	players[index].nparalisado=0;
	players[index].paralisado=false;
	players[index].tparalisado.force(0);
	players[index].tparalisado.pause();
	players[index].afking=false;
	players[index].afk=false;
	send_reliable(players[index].peer_id, "fimnovato", 0);
	if(players[index].invs==0){
		send_reliable(0,"playerbeep "+players[index].charname+" 1",0);
		players[index].bipar=1;
	}
	if(gamestopped==false)send_reliable(players[index].peer_id,"startmoving",0);
}

void give(int index, string[] parsed){
	int i2=get_player_index_from(parsed[1]);
	if(i2>-1){
		double amount=string_to_number(parsed[3]);
		if(players[index].naoitens==1){
			send_reliable(players[index].peer_id,"msgnormal Voc� n�o pode dar itens.",0);
		}
		else if(players[index].is_admin()){
			eadm(players[index].charname+" est� intentando darle items a "+players[i2].charname, "noud.ogg", 50);
		}
		else if (parsed[2]=="paquete_militar"||parsed[2]=="paquete_m�dico_militar"){
			return;
		}
		else if (parsed[2]=="sobre_con_sello_con_forma_de_espiral_de_fuego"){
			send_reliable(event.peer_id, "msgnormal N�o, voc� n�o pode dar ese item!",0);
		}
		else{
			if(amount<=players[index].inv_item_number(parsed[2]) and amount>0){
				players[index].inv_add_item(parsed[2],0-amount);
				if(players[index].inv_item_number(parsed[2])==0) retirar(index, parsed[2], false);
				players[i2].inv_add_item(parsed[2],amount);
				send_reliable(players[i2].peer_id,"msglhedeu "+players[index].charname+" "+amount+" "+parsed[2],0);
				send_reliable(players[index].peer_id,"msgvoc�deu "+amount+" "+parsed[2]+" "+players[i2].charname,0);
				send_packet(0, "play gift.ogg", players[i2].x, players[i2].y, players[i2].mapindex);
				save_transfer(players[index].charname, players[i2].charname, parsed[2], amount);
			}
			else{
				send_reliable(players[index].peer_id,"msgvoc�n�otem", 0);
			}
		}
	}
	else{
		send_reliable(players[index].peer_id,"msgjogadorn�oencontrado",0);
	}
}

void drop(int index, double cantity, string itemname){
	bool player_is_admin =false;
	if(excluded_items.find(itemname)>-1) {
		send_reliable(players[index].peer_id, "msg2 ;No puedes hacer esto...;", 0);
		return;
	}
	if(file_exists("players/"+players[index].charname+"/admintudo.usr")) player_is_admin =true;
	string msga=string_replace(get_event_message(), "zsa ", "", false);
	if(cantity<=players[index].inv_item_number(itemname) and cantity>0){
		bool tem=false;
		if(players[index].naoitens==1) send_reliable(players[index].peer_id,"msgnormal Voc� n�o pode soltar itens.",0);
		else if(itemname=="")return;
		else{
			players[index].inv_add_item(itemname,0-cantity);
			if(players[index].inv_item_number(itemname)==0) retirar(index, itemname, false);
			if(string_contains(itemname, "tarjeta_navide�a_", 1)>-1 || string_contains(itemname, "tarjeta_de_navidad", 1)>-1) {
				if(players[index].map=="parque" && string_contains(get_zone_at(players[index].x, players[index].y, players[index].map), "m�gicamente lo que hera un gran �rbol, ahora se ha convertido en un gran fuego sagrado, el cual purifica los buenos deseos y todo aquello que es arrojado en �l.", 1)>-1) {
					int item_index =desc.find(itemname);
					players[index].inv_add_item(itemname, -1);
					players[index].inv_add_item("d�lares", 10000);
					send_packet(0, "play fire2.ogg", players[index].x, players[index].y, players[index].mapindex);
					send_reliable(players[index].peer_id, "msg2 ;depositas los deseos de los tuyos, y a cambio recives la bendici�n y la purificaci�n del fuego eterno.;", 0);
					if(item_index>-1) {
						desc.remove_at(item_index);
						save_descs();
					}
					for(int i=0; i<players.length(); i++) {
						ganhaxp(players[i].charname, random(1000000, 4000000));
					}
				}
				return;
			}
			if(tem==false){
				spawn_obj(players[index].x, players[index].y, 30000, 1, cantity, itemname, players[index].map, "get"+itemname);
			}
		}
		if(player_is_admin) {
			eadm(players[index].charname+" tir� "+cantity+" "+itemname+" en el mapa "+players[index].map, "notify7.ogg", 100, true);
		}
	}
}


void whoonline(int index){
	int onthis=0;
	int onother=0;
	string sendmes;
	for (uint i=0; i<players.length(); i++){
		if(players[i].map==players[index].map&&players[i].afk==false&&players[i].invs==0)onthis+=1;
		else if(players[i].map!=players[index].map&&players[i].afk==false&&players[i].invs==0)onother+=1;
	}
	if (onother>0&&onthis>0)sendmes=(onthis+onother)+" ;online.; "+onthis+" ;aqui;, "+onother+" ;em outro lugar.;";
	else if(onthis<=0&&onother>0)sendmes=onother+" ;online.; "+onother+" ;em outro lugar.;";
	else if (onother==0&&onthis>1)sendmes=(onthis+onother)+" ;online.; "+onthis+" ;aqui;.";
	else if (onother==0&&onthis==1){
		for(uint i=0;i<players.length();i++){
			if(players[i].map==players[index].map&&players[i].invs==0&&players[i].afk==false)sendmes=";Apenas; "+players[i].title+" "+players[i].charname+" ;no jogo.;";
		}
	}
	send_reliable(players[index].peer_id, "msg2 "+sendmes,0);
}

