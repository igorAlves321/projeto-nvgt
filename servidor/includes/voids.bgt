return;
}
int mapindex=get_map_index_from("planeta_aquaphil");
if(mapindex>-1){
file f;
int coor;
if(islands==0) coor=islands+100;
else coor=islands*200+100;
islands++;
int min_coor=coor+1, max_coor=coor+99, final_coor=coor+100;
