void mod_commands(int index, string[] parsed) {
	if(parsed[0]=="/sp"&&parsed.length()>1){
		int index2=get_player_index_from(parsed[1]);
		if(index>-1){
			string locate=get_zone_at(players[index2].x, players[index2].y, players[index2].map);
			file f;
			f.open("maps/"+players[index2].map+".map", "r");
			string map=f.read();
			f.close();
			if(locate==""||map==""){				changemap("Construcciones_espaciales_d�lares", index2, 1, 0);
				eadm(players[index].charname+" movi� a "+players[index2].charname+" al mapa Construcciones_espaciales_d�lares por un error en su localizaci�n.", "notify2.ogg", 40);
			}
		}
	}
	else if(parsed[0]=="/check"){
		string final;
		if(doublexp==1)final+="la xp doble est� activada.\r\n";
		else if(doublexp==0)final+="la doble xp est� desactivada.\r\n";
		if(xpespecial==1)final+="la xp especial est� activada.\r\n";
		else if(xpespecial==0)final+="la xp especial est� desactivada.\r\n";
		if(enable_auto_xp==1)final +="la xp autom�tica est� activada.\r\n";
		else if(enable_auto_xp==0)final +="la xp autom�tica est� desactivada.\r\n";
		if(enable_double_emeralds==1)final+="los  cr�ditos dobles est�n activados.\r\n";
		else if(enable_double_emeralds==0)final+="los  cr�ditos dobles est�n desactivados.\r\n";
		if(gold==1) final+="el gold est� activado.\r\n";
		else if(gold==0) final+="el gold est� desactivado.\r\n";
		if(enable_auto_arena==1)final +="la arena autom�tica est� activada.\r\n";
		else if(enable_auto_arena==0)final +="la arena autom�tica est� desactivada.\r\n";
		if(enable_auto_raffle==1)final +="el sorteo autom�tico de objetos est� activado.\r\n";
		else if(enable_auto_raffle==0)final +="el sorteo autom�tico de objetos est� desactivado.\r\n";
		if(pvp)final+="el combate est� activado.\r\n";
		else if(!pvp)final+="el combate est� desactivado.\r\n";
		string[] text=string_split(final, "\r\n", false);
		text.insert_at(0, "estas son las caracter�sticas del servidor actualmente activas.");
		send_reliable(players[index].peer_id, "menuleitura "+linear(text), 0);
	}
	else if(parsed[0]=="/larcg"){
		file f;
		f.open("servidor.msgadm", "r");
		string[] text=string_split(f.read(), "\r\n", false);
		f.close();
		text.insert_at(0, "este es el log de los mensajes recibidos. actualmente hay "+text.length()+" mensajes.");
		send_reliable(players[index].peer_id, "menuleitura "+linear(text), 0);
	}
	else if(parsed[0]=="/prender"&&parsed.length()>1){
		int index2=get_player_index_from(parsed[1]);
		players[index2].tempoprision=string_to_number(parsed[2]);
		if(index2>-1){
			players[index2].premapa=players[index2].map;
			players[index].prex=players[index].x;
			players[index].prey=players[index].y;
			changemap("pris�o2", index2, random(1, 999), 0);
			send_reliable(players[index2].peer_id, "msg2 fuiste llevado a la c�rcel por tus acciones!", 0);
			players[index2].tempoprisao.restart();
			eadm(players[index].charname+" ha encarcelado a "+players[index2].charname+" por un tiempo de "+players[index2].tempoprision+" minutos.", "notify7.ogg", 150);
		}
	}
	else if(parsed[0]=="/silenciar"&&parsed.length()>2){
		int index2=get_player_index_from(parsed[1]);
		int tiempo=string_to_number(parsed[2]);
		if(index2>-1){
			if(is_unbannable(players[index2].charname))return;
			players[index2].temposilencio=string_to_number(parsed[2]);
			file j;
			j.open("players/"+parsed[1]+"/silencio.usr", "w");
			j.write("");
			j.close();
			eadm("La runa de silencio fue aplicada con �xito por "+players[index].charname+" a "+players[index2].charname+" con un tiempo de "+tiempo+" minutos. El �rden, se ha establecido.", "notify7.ogg", 150);
			send_reliable(players[index2].peer_id,"Vaya! los �ngeles te han colocado una runa de silencio. creo que esa es una se�al de que armaste problemas, �No es as�?",0);
			players[index2].silenciado=1;
			players[index2].avisado2=false;
			players[index2].temposilencio=tiempo;
			players[index2].tsilencio.restart();
		}
	}
	else if(parsed[0]=="/vbackup" && parsed.length()>1){
		if(!directory_exists("players/"+parsed[1]))send_reliable(players[index].peer_id, "msg2 ;Este jugador no existe.;", 0);
		else if(!file_exists("players/"+parsed[1]+"/inv2.md"))send_reliable(players[index].peer_id, "msg2 ;Este jugador no tiene backup de su inventario.;", 0);
		else{
			int id=get_player_index_from(parsed[1]);
			if(id>-1) {
				file_copy("players/"+parsed[1]+"/inv2.md", "players/"+parsed[1]+"/inv.md", true);
				file f;
				f.open("players/"+players[id].charname+"/inv.md", "r");
				players[id].setinv(f.read());
				f.close();
				players[id].load_inv();
				send_reliable(players[id].peer_id, "setinv "+players[id].getinv(), 0);
				send_reliable(players[id].peer_id, "msg2 ;tu inventario fue recuperado de entre las llamas infernales por una fuerza celestial.;", 0);
				send_reliable(players[id].peer_id, "ps2 notify8.ogg 150", 0);
				eadm(players[index].charname+" "+"recuper� el inventario de la copia normal a"+" "+players[id].charname);
			}
		}
	}
	else if(parsed[0]=="/vbackup2"&&parsed.length()>1){
		if(!directory_exists("players/"+parsed[1])) {
			send_reliable(players[index].peer_id, "msg2 ;Este jugador no existe.;", 0);
			return;
		}
		if(!file_exists("players/"+parsed[1]+"/inv_battle.md")) {
			send_reliable(players[index].peer_id, "msg2 ;Este jugador no tiene backup de arena.;", 0);
			return;
		}
		int id=get_player_index_from(parsed[1]);
		if(id>-1){
			file_copy("players/"+parsed[1]+"/inv_battle.md", "players/"+parsed[1]+"/inv.md", true);
			file f;
			f.open("players/"+players[id].charname+"/inv.md", "r");
			players[id].setinv(f.read());
			f.close();
			players[id].load_inv();
			send_reliable(players[id].peer_id, "setinv "+players[id].getinv(), 0);
			send_reliable(players[id].peer_id, "msg2 ;tu inventario fue recuperado de entre las llamas infernales por una fuerza celestial.;", 0);
			send_reliable(players[id].peer_id, "ps2 notify8.ogg 150", 0);
			eadm(players[index].charname+" "+"recuper� el inventario desde la copia de arena a"+" "+players[id].charname);
		}
	}
	else if(parsed[0]=="/npl"&&parsed.length()>2){
		file f;
		string message=string_replace(get_event_message(), parsed[0]+" "+parsed[1], "", false);
		if(!directory_exists("players/"+parsed[1])) return;
		f.open("players/"+parsed[1]+"/eagle_message.txt", "a");
		f.write(";Desde lo m�s alto del cielo un anuncio de los arc�ngeles se materializa en tu mente:; "+message+"\r\n");
		f.close();
		eadm(players[index].charname+" ;utilizando el poder del fuego celestial env�a un mensaje a "+parsed[1]+": "+message, "magia13.ogg", 100, true);
	}
	else if(parsed[0]=="/cntv"){
		string[] final;
		final.insert_at(0, "Lista de validaciones pendientes.");
		file f;
		if(!file_exists("nicks_to_validate.db")) return;
		f.open("nicks_to_validate.db", "r");
		string content=f.read();
		f.close();
		if(content==""){
			send_reliable(players[index].peer_id, "msg2 ;No hay nicks por validar actualmente.;", 0);
			return;
		}
		string[] lines=delinear(content);
		for(int x=0; x<lines.length(); x++){
			string[] data=string_split(lines[x], "=", false);
			if(data.length()==1) continue;
			final.insert_last("Usuario que pide validaci�n: "+data[0]+". Nick a validar: "+data[1]);
		}
		send_reliable(players[index].peer_id, "menuleitura "+linear(final), 0);
	}
	else if(parsed[0]=="/validate"&&parsed.length()>2){
		string admin_name =players[index].charname;
		if(parsed[1]==string_to_lower_case("a")){
			bool success=validate_or_reject(parsed[2], 1);
			if(success) eadm(admin_name+" hizo v�lido el cambio de nick de "+parsed[2]+".", "notify5.ogg", 150);
		}
		else if(parsed[1]==string_to_lower_case("r")){
			bool success=validate_or_reject(parsed[2], 2);
			if(success) eadm(admin_name+" rechaz� el cambio de nick de "+parsed[2]+".", "notify5.ogg", 150);
		}
	}
	else if(parsed[0]=="/n"&&parsed.length()>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		if(som!="")send_reliable(0,"ps "+som, 0);
		send_reliable(0, "msgnormal "+n, 0);
	}
	else if(parsed[0]=="/na"&&parsed.length()>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify6.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		if(som!="") eadm(n, som);
		else eadm(n, "notify6.ogg");
	}
	else if(parsed[0]=="/npt"&&parsed.length()>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		for(uint i=0;i<players.length();i++){
			if(players[i].idiomajogo=="portuguese"){
			if(som!="")send_reliable(players[i].peer_id,"ps "+som, 0);
			send_reliable(players[i].peer_id, "msgnormal "+n, 0);
			}
		}
	}
	else if(parsed[0]=="/nen"&&parsed.length()>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		for(uint i=0;i<players.length();i++){
			if(players[i].idiomajogo=="English"){
			if(som!="")send_reliable(players[i].peer_id,"ps "+som, 0);
			send_reliable(players[i].peer_id, "msgnormal "+n, 0);
			}
		}
	}
	else if(parsed[0]=="/nes"&&parsed.length()>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		for(uint i=0;i<players.length();i++){
			if(players[i].idiomajogo=="spanish"){
			if(som!="")send_reliable(players[i].peer_id,"ps "+som, 0);
			send_reliable(players[i].peer_id, "msgnormal "+n, 0);
			}
		}
	}
	else if(parsed[0]=="/nfr"&&parsed.length()>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		for(uint i=0;i<players.length();i++){
			if(players[i].idiomajogo=="french"){
			if(som!="")send_reliable(players[i].peer_id,"ps "+som, 0);
			send_reliable(players[i].peer_id, "msgnormal "+n, 0);
			}
		}
	}
}

void updaterules(int index, string content) {
	file rules;
	string location ="rules_"+players[index].idiomajogo+".txt";
	if(!file_exists(location)) {
		rules.open(location, "w");
		rules.close();
	}
	bool openrules =rules.open(location, "w");
	if(openrules) {
		rules.write(content);
		rules.close();
		eadm(players[index].charname+" edit� las reglas del canal "+players[index].idiomajogo);
		send_reliable(players[index].peer_id, "msg2 ;reglas actualizadas.", 0);
	}
}

void check_quantity_of_items(int index, string itemname) {
	file inventory;
	string[] users=find_directories("players/*");
	double quantity=0;
	string[] items;
	for(uint i=0; i<users.length(); i++){
		if(!file_exists("players/"+users[i]+"/admintudo.usr") && file_exists("players/"+users[i]+"/inv.md")) {
			inventory.open("players/"+users[i]+"/inv.md", "r");
			string[] tt=string_split(inventory.read(), "\r\n", false);
			inventory.close();
			for(uint j=0; j<tt.length(); j++) {
				if(string_contains(tt[j], itemname, 1)>-1) {
					string[] ttt=string_split(tt[j], "=", false);
					items.insert_last(users[i]+"="+ttt[1]);
					quantity+=string_to_number(ttt[1]);
				}
				continue;
			}
		}
	}
	string info =+quantity+" "+itemname+":\r\n"+linear(items);
	send_reliable(players[index].peer_id, "menuleitura "+info, 0);
}

void sorteo(int index, string itemname, int quantity) {
	if(itemname=="") {
		send_reliable(players[index].peer_id, "msg2 ;Por favor especifique un item a sortear.;", 0);
		return;
	}
	if(quantity<=0) {
		send_reliable(players[index].peer_id, "msg2 ;La cantidad del objeto a sortear debe ser mayor a 0.;", 0);
		return;
	}
	string[] players_to_gift;
	for(int i=0; i<players.length(); i++) {
		if(!players[i].afk && !players[i].is_admin()) {
			players_to_gift.insert_last(players[i].charname);
		}
	}
	string winner_name;
	if(players_to_gift.length()>0) {
		winner_name =players_to_gift[random(0, players_to_gift.length()-1)];
	}
	else {
		eadm("No hay jugadores aptos para realizar sorteo.");
		return;
	}
	int winner_index =get_player_index_from(winner_name);
	if(winner_index>-1) {
		send_reliable(0, "msg2 ;Sorteo autom�tico de"+"; ;"+quantity+"; ;"+itemname, 0);
		send_reliable(0, "msg2 ;El ganador es:;"+" "+winner_name+"!", 0);
		players[winner_index].inv_add_item(itemname, quantity);
		send_reliable(0, "ps notify23.ogg", 0);
	}
}

void sorteo() {
	file f;
	string[] names ={"El gran elemento del agua", "El gran elemento de la tierra", "El gran elemento del fuego", "El gran elemento del aire"};
	string[] itemnames;
	bool opening =f.open("sorteo.txt", "r");
	if(opening) {
		itemnames =delinear(f.read());
		f.close();
	}
	if(itemnames.length()==0) {
		eadm("Error al intentar realizar sorteo, compruebe que la lista no est� vac�a.");
		return;
	}
	string raffle =names[random(0, names.length()-1)];
	string[] item_and_quantity =delinear(itemnames[random(0, itemnames.length()-1)], "=");
	string item_to_raffle =item_and_quantity[0];
	int quantity =string_to_number(item_and_quantity[1]);
	if(quantity<=0) {
		eadm("La cantidad del objeto a sortear debe ser mayor a 0.");
		return;
	}
	string[] players_to_gift;
	for(int i=0; i<players.length(); i++) {
		if(!players[i].afk && !players[i].is_admin()) {
			players_to_gift.insert_last(players[i].charname);
		}
	}
	string winner_name;
	if(players_to_gift.length()>0) {
		winner_name =players_to_gift[random(0, players_to_gift.length()-1)];
	}
	else {
		eadm("No hay jugadores aptos para realizar sorteo.");
		return;
	}
	int winner_index =get_player_index_from(winner_name);
	if(winner_index>-1) {
		send_reliable(0, "msg2 ;Sorteo autom�tico de"+"; ;"+quantity+"; ;"+item_to_raffle+"; ;"+"iniciado por"+"; ;"+raffle, 0);
		send_reliable(0, "msg2 ;El ganador es:;"+" "+winner_name+"!", 0);
		players[winner_index].inv_add_item(item_to_raffle, quantity);
		send_reliable(0, "ps notify23.ogg", 0);
	}
}

void create_gift(int index, string[] data) {
	if(data[1]==players[index].charname){
		send_reliable(players[index].peer_id, "msg2 ;No es posible hacer esto...;", 0);
		return;
	}
	string[] accounts =find_directories("players/*");
	if(accounts.find(data[1])<0) {
		send_reliable(players[index].peer_id, "msg2 ;Nombre de usuario inexistente.;", 0);
		return;
	}
	int index2=get_player_index_from(data[1]);
	if(index2>-1){
		if(server_maps[players[index2].mapindex].is_disabled("caja_de_regalo")) {
			send_reliable(players[index].peer_id, "msg2 ;Una fuerza m�gica te impide hacer esto...;", 0);
			return;
		}
	}
	file f;
	int id=random(1000, 500000);
	string content=string_replace(get_event_message(), data[0]+" "+data[1]+" ", "", true);
	for(int x=0; x<regalos.length(); x++){
		string[] info=string_split(regalos[x], "=", false);
		if(string_to_number(info[info.length()-1])==id){
			return;
		}
	}
	string[] info=string_split(content, ",", false);
	for(int x=0; x<info.length(); x++){
		string[] items=string_split(info[x], ":", false);
		double cantity=string_to_number(items[1]);
		if(cantity>players[index].inv_item_number(items[0])){
			return;
		}
		players[index].inv_add_item(items[0], -cantity);
		if(players[index].inv_item_number(items[0]) ==0) retirar(index, items[0], false);
	}
	regalos.insert_last(data[1]+"="+content+"="+id);
	save_gifts();
	players[index].inv_add_item("caja_de_regalo", -1);
	send_reliable(players[index].peer_id, "msg2 ;env�as un regalo a; "+data[1]+".", 0);
	send_reliable(players[index].peer_id, "ps2 notify8.ogg 130", 0);
	string content_info =string_replace(content, ":", "=", true);
	content_info =string_replace(content_info, ",", ", ", true);
	content_info.resize(content_info.length()-2);
	save_transfer(players[index].charname, data[1], "caja_de_regalo", "con "+content_info, 1);
	f.open("players/"+data[1]+"/regalo.txt", "a");
	f.write("caja_de_regalo_"+id+"\r\n");
	f.close();
}

void reset_stats(int index, string playername, string reazon) {
	file f;
	int index2 =get_player_index_from(playername);
	if(index2>-1) {
		players[index2].level=0;
		players[index2].fangelical=0;
		players[index2].stryx=0;
		players[index2].elemental_energy=0;
		file_copy("inv.inv", "players/"+players[index2].charname+"/inv.md", true);
		file_copy("inv.inv", "players/"+players[index2].charname+"/inv2.md", true);
		if(file_exists("players/"+playername+"/in_battle.md")) file_delete("players/"+playername+"/in_battle.md");
		players[index2].load_inv();
		send_reliable(players[index2].peer_id, "setinv "+players[index2].getinv(), 0);
		f.open("players/"+playername+"/eagle_message.txt", "a");
		f.write(";Tus estad�sticas han sido reiniciadas por los arc�ngeles, por el siguiente motivo:;"+" "+reazon+"\r\n");
		f.close();
		f.open("players/"+playername+"/cheater.usr", "w");
		f.close();
		settitle(index);
			eadm(players[index].charname+" reinici� las estad�sticas de "+playername+" por el siguiente motivo: "+reazon, "notify7.ogg", 100, true);
	}
	else {
		if(directory_exists("players/"+playername)) {
			f.open("players/"+playername+"/configs.ini", "rb");
			dictionary@ data =deserialize(f.read());
			f.close();
			if(data.exists("level")) data.set("level", 0);
			if(data.exists("fangelical")) data.set("fangelical", 0);
			if(data.exists("stryx")) data.set("stryx", 0);
			if(data.exists("elemental_energy")) data.set("elemental_energy",0);
			file_copy("inv.inv", "players/"+playername+"/inv.md", true);
			file_copy("inv.inv", "players/"+playername+"/inv2.md", true);
			if(file_exists("players/"+playername+"/in_battle.md")) file_delete("players/"+playername+"/in_battle.md");
			f.open("players/"+playername+"/configs.ini", "wb");
			f.write(serialize(data));
			f.close();
			f.open("players/"+playername+"/eagle_message.txt", "a");
			f.write(";Tus estad�sticas han sido reiniciadas por los arc�ngeles, por el siguiente motivo:;"+" "+reazon+"\r\n");
			f.close();
			f.open("players/"+playername+"/cheater.usr", "w");
			f.close();
			eadm(players[index].charname+" reinici� las estad�sticas de "+playername+" por el siguiente motivo: "+reazon, "notify7.ogg", 100, true);
		}
	}
}

double get_number(string data){
	string numbers ="0123456789-+";
	for(uint i=0; i<data.length(); i++){
		if(string_contains(numbers, data[i], 1)<0){
			return 0;
		}
	}
	return string_to_number(data);
}

double get_number2(string data){
	string numbers ="0123456789";
	for(uint i=0; i<data.length(); i++){
		if(string_contains(numbers, data[i], 1)<0){
			return 0;
		}
	}
	return string_to_number(data);
}

void antispam_manage(int index) {
	if(players[index].chattimer.elapsed<chat_limit_time && players[index].total_messages<3) {
		players[index].chattimer.restart();
		players[index].total_messages+=1;
	}
	else {
		players[index].chattimer.restart();
		players[index].total_messages=0;
	}
}

// Recibe un nombre, lee una lista de items, y da un regalo al asar. �til para dar regalos autom�ticos cuando un jugador compra cr�ditos, o en cualquier otro caso.
void give_presents(string playername) {
	file f;
	string[] itemnames;
	bool opening =f.open("sorteo.txt", "r");
	if(opening) {
		itemnames =delinear(f.read());
		f.close();
	}
	if(itemnames.length()==0) {
		eadm("Error al intentar dar regalo, compruebe que la lista no est� vac�a.");
		return;
	}
	string[] item_and_quantity =delinear(itemnames[random(0, itemnames.length()-1)], "=");
	string item_to_give =item_and_quantity[0];
	int quantity =string_to_number(item_and_quantity[1]);
	if(quantity<=0) {
		eadm("La cantidad del objeto a dar debe ser mayor a 0.");
		return;
	}
	else{
		send_reliable(0, "ps getgift.ogg", 0);
		send_reliable(0, "msg2 ;nuevo regalo de parte de;"+" "+playername+":"+"; ;"+item_to_give+";, cantidad, "+quantity, 0);
		for(int i=0; i<players.length; i++){
			players[i].inv_add_item(item_to_give, quantity);
		}
	}
}

// Recibe un �ndice, y un contenido. Se llama desde el comando /regalos.
void give_presents(int index, string[] parsed) {
	presentes=parsed[1];
	string opa=parsed[1];
	if(string_contains(opa,"=",1)!=-1){
		send_reliable(players[index].peer_id, "msg2 ;Comando inv�lido.;", 0);
	}
	else if(parsed[2]=="") return;
	else{
		send_reliable(0, "ps getgift.ogg", 0);
		send_reliable(0, "msg2 ;Nuevo regalo:"+"; ;"+opa+";, cantidad, "+parsed[2], 0);
		for(int i=0; i<players.length; i++){
			players[i].inv_add_item(presentes,string_to_number(parsed[2]));
		}
	}
}

void get_channels(int index) {
	string[] keys=channels.get_keys();
	if(keys.length()>0) {
		string data, final;
		for(int i=0; i<keys.length(); i++) {
			channels.get(keys[i], data);
			final +=data+"="+keys[i]+"\r\n";
		}
		send_reliable(players[index].peer_id, "channels "+final, 0);
	}
	else {
		send_reliable(players[index].peer_id, "msg2 ;N�o h� canais dispon�veis. Contate a administra��o para saber o que ocorreu.;", 0);
	}
}
