string travelpoint1="pm2:1:1:0:120:"+min_coor+":119:planeta_aquaphil:door11close:llave_de_la_reja_de_entrada_a_la_isla_de_"+players[index].charname+":1:no puedes salir de este lugar.:llave_de_la_reja_de_entrada_a_la_isla_de_"+players[index].charname+":1:Sales de la bonita isla privada.";
string travelpoint2="pm2:1000:1000:0:120:"+max_coor+":119:planeta_aquaphil:door11close:llave_de_la_reja_de_entrada_a_la_isla_de_"+players[index].charname+":1:No puedes salir de este lugar.:llave_de_la_reja_de_entrada_a_la_isla_de_"+players[index].charname+":0:Sales de la bonita isla privada.";
string map_content=linear(server_maps[mapindex].mapdata);
map_content+="w2:"+coor+":"+final_coor+":120:120:wallfence6
z:"+min_coor+":"+max_coor+":100:119:loma de arena volcánica que lleva hacia la pequeña isla privada de "+players[index].charname+"
z:"+min_coor+":"+max_coor+":119:119:entrada a la isla privada.
pm2:"+min_coor+":"+max_coor+":119:119:1:0:isla_privada_de_"+players[index].charname+":door11open:llave_de_la_reja_de_entrada_a_la_isla_de_"+players[index].charname+":1:no puedes entrar a este lugar.:nada:0:entras a la bonita isla privada.:aah:aah
sc:"+min_coor+":"+max_coor+":100:119:deepsand";
if(map_content!="") server_maps[mapindex].mapdata=delinear(map_content);
save_map("planeta_aquaphil");
f.open("plantillas/island.map", "r");
string[] lines=delinear(f.read());
f.close();
lines.remove_at(0);
lines.insert_at(0, "map:isla_privada_de_"+players[index].charname);
lines.insert_last(extract_zone);
lines.insert_last(travelpoint1);
lines.insert_last(travelpoint2);
f.open("maps/isla_privada_de_"+players[index].charname+".map", "w");
f.write(linear(lines));
f.close();
insert_map("isla_privada_de_"+players[index].charname);
send_reliable(players[index].peer_id, "msg2 ;Desde ahora eres dueño de una pequeña pero hermosa isla privada en medio de un inmenso océano. Aquí tienes, una llave que te será útil para entrar en ella.;", 0);
writeprefs();
players[index].inv_add_item("llave_de_la_reja_de_entrada_a_la_isla_de_"+players[index].charname, 1);
players[index].inv_add_item("perla_ndired", -1000);
players[index].have_island=1;
players[index].payment=1;
sconfigs(index);
}
}

bool is_cheating(int index, int time){
	if(players[index].tpackets.elapsed<time){
		players[index].tpackets.restart();
		return true;
	}
	return false;
}
void imenu(int index){
	/*if(is_cheating(index, 400)) eadm(players[index].charname+" ;aparentemente está usando cheat engine, favor de corroborar esta información.;", "notify54.ogg");
	players[index].tpackets.restart();*/
	int mapindex=players[index].mapindex;
	string t=server_maps[mapindex].get_tile_at(players[index].x, players[index].y);
	string tt=server_maps[mapindex].get_zone_at(players[index].x, players[index].y);
	if(string_contains(t, "glass", 1)>-1){
		for(uint i=0;i<vidriosrotos.length();i++){
			vidriosrotos[i].quantoscavar--;
			send_packet(0, "play glasss2tep2.ogg", vidriosrotos[i].x, vidriosrotos[i].y, get_map_index_from(vidriosrotos[i].map));
			if(vidriosrotos[i].quantoscavar<=0){
				send_packet(0, "play glassharland.ogg", players[index].x, players[index].y, players[index].mapindex);
				spawn_obj(players[index].x, players[index].y, 30000, 1, vidriosrotos[i].quantosvidrio, "vidrio_roto", players[index].map, "getvidrio_roto");
				vidriosrotos.remove_at(i);
			}
			break;
		}
	}
	else if(string_contains(t, "snow", 1)>-1||string_contains(t, "nieve", 1)>-1){
		send_packet(0, "play snowland.ogg", players[index].x, players[index].y, players[index].mapindex);
		players[index].inv_add_item("bola_de_nieve", 1);
	}
	int extract_index=server_maps[players[index].mapindex].have_extract(players[index].x, players[index].y);
	if(extract_index>-1){
		if(server_maps[mapindex].extracts[extract_index].extracttimer.elapsed>=server_maps[mapindex].extracts[extract_index].extracttime) {
			server_maps[mapindex].extracts[extract_index].extracttimer.restart();
			server_maps[mapindex].extracts[extract_index].extract_item(index);
		}
	}
	if(mapindex>-1){
		int piaindex=server_maps[mapindex].have_handwash(players[index].x, players[index].y);
		if(piaindex>-1){
			if(server_maps[mapindex].pias[piaindex].aberta==false){
				server_maps[mapindex].send_packet(0, "play atorneira.ogg", server_maps[mapindex].pias[piaindex].x, server_maps[mapindex].pias[piaindex].y);
				server_maps[mapindex].pias[piaindex].fechando.restart();
				server_maps[mapindex].pias[piaindex].fechar.restart();
				server_maps[mapindex].send_packet(0, "play lavando_mãos.ogg", server_maps[mapindex].pias[piaindex].x, server_maps[mapindex].pias[piaindex].y);
				server_maps[mapindex].pias[piaindex].aberta=true;
				send_reliable(players[index].peer_id, "stopmoving", 0);
			}
		}
	}
	if(mapindex>-1){
		for(uint i=0; i<server_maps[mapindex].banheiros.length();i++){
			if(server_maps[mapindex].banheiros[i].x==players[index].x&&server_maps[mapindex].banheiros[i].y==players[index].y){
				if(players[index].centado==false){
					if(server_maps[mapindex].banheiros[i].vasoaberto==false){
						server_maps[mapindex].banheiros[i].vasoaberto=true;
						send_packet(0, "play avaso.ogg", players[index].x, players[index].y, players[index].mapindex);
					}
					else if(server_maps[mapindex].banheiros[i].vasoaberto==true){
						server_maps[mapindex].banheiros[i].vasoaberto=false;
						send_packet(0, "play fvaso.ogg", players[index].x, players[index].y, players[index].mapindex);
					}
					else if(tt=="Mictório."){
						if(players[index].nurina>0){
							send_reliable(players[index].peer_id, "stopmoving", 0);
							players[index].nurina-=40;
							if(players[index].nurina<0)players[index].nurina=0;
							send_packet(0, "play mijando.ogg", players[index].x, players[index].y, players[index].mapindex);
							players[index].tmaquina.restart();
							players[index].sujo+=2.5;
						}
					}
				}
				else if(players[index].centado==true){
					if(server_maps[mapindex].banheiros[i].vasoaberto==false)send_reliable(players[index].peer_id, "msgnormal Mas você está sentad"+players[index].sexo2+" na tampa do vaso!", 0);
					else{
						if(players[index].nurina>0){
							players[index].nurina-=40;
							if(players[index].nurina<0)players[index].nurina=0;
							send_packet(0, "play mijando.ogg", players[index].x, players[index].y, players[index].mapindex);
							players[index].sujo+=1.5;
						}
						else if(players[index].ncoco>0&&tt!="Mictório."){
							players[index].ncoco-=5;
							if(players[index].ncoco<0)players[index].ncoco=0;
							send_packet(0, "play cagando"+random(1, 2)+".ogg", players[index].x, players[index].y, players[index].mapindex);
							players[index].sujo+=1.5;
						}
						server_maps[mapindex].banheiros[i].descarga=1;
					}
				}
				return;
			}
		}
	}
}

void viewclothings(int index) {
	int index2, cindex, mapindex=get_map_index_from(players[index].map);
	string my_clothing, foreign_clothing;
	if(players[index].clothing.length()==0){
		my_clothing+=";estás desnud"+players[index].sexo2+".;\r\n";
	}
	else{
		my_clothing+=";estás vistiendo:; ";
	}
	for(int x=0; x<players[index].clothing.length(); x++){
		cindex=get_clothing_index(players[index].clothing[x]);
		if(cindex>-1) {
			string description = clothes[cindex].description;
			string translated_desc = translate_clothing_description(description, players[index].language);
			my_clothing+=";"+translated_desc+";\r\n";
		}
	}
	if(mapindex>-1){
		for(int x=0; x<server_maps[mapindex].mapplayers.length(); x++){
			for(int y=players[index].x-12; y<players[index].x+12; y++){
				index2=server_maps[mapindex].mapplayers[x];
				if(players[index2].x==y&&players[index2].afk==false&&players[index2].charname!=players[index].charname&&players[index2].watching==0&&players[index2].invs==0){
					if(players[index2].clothing.length()==0) foreign_clothing+=players[index2].charname+" ;está desnud"+players[index2].sexo2+".;\r\n";
					else foreign_clothing+=players[index2].charname+" ;está vistiendo:; ";
					for(int z=0; z<players[index2].clothing.length(); z++){
						cindex=get_clothing_index(players[index2].clothing[z]);
						if(cindex>-1){
							if(clothes[cindex].show_all==1) foreign_clothing+=";"+clothes[cindex].description+";\r\n";
						}
					}
				}
			}
		}
	}
	if(o_index<0) send_reliable(players[index].peer_id, "msg2 "+my_clothing+foreign_clothing, 0);
	else if(o_index>-1) send_reliable(players[o_index].peer_id, "msg2 "+my_clothing+foreign_clothing, 0);
}
void afk(int index){
	int mapindex=get_map_index_from(players[index].map);
	bool achou=false;
	if(players[index].afk&&players[index].afkreturntimer.elapsed<120000&&players[index].is_admin()==false){
		int remaining_time = (120000 - players[index].afkreturntimer.elapsed) / 1000;
		int minutes = remaining_time / 60;
		int seconds = remaining_time % 60;
		string time_msg = "";
		if(minutes > 0) {
			time_msg = string(minutes) + " minuto";
			if(minutes > 1) time_msg += "s";
			if(seconds > 0) time_msg += " e " + string(seconds) + " segundo";
		} else {
			time_msg = string(seconds) + " segundo";
		}
		if(seconds > 1) time_msg += "s";
		send_reliable(players[index].peer_id, "msg2 ;Você não pode voltar agora, poderá voltar em; "+time_msg+".;", 0);
		return;
	}
	else if(players[index].afk&&(players[index].afkreturntimer.elapsed>=60000||players[index].is_admin())){
		players[index].afkreturntimer.pause;
		players[index].afk=false;
	if(players[index].invs==1){
		send_reliable(0,"playerbeep "+players[index].charname+" 0",0);
		players[index].bipar=1;
	}
	else{
		send_reliable(0,"playerbeep "+players[index].charname+" 1",0);
	}
		if(players[index].pacifico==0) send_reliable(players[index].peer_id, "fimnovato", 0);
		players[index].afktime =0;
		send_reliable(players[index].peer_id,"startmoving",0);
		send_reliable(players[index].peer_id, "ausente0", 0);
		send_reliable(0, "ps afkoff.ogg", 0);
		send_reliable(0, "msg2 "+players[index].charname+" ;voltou.;", 0);
		if(players[index].pacifico==0) send_reliable(players[index].peer_id, "fimnovato", 0);
		players[index].bipar=1;
		settitle(index);
	}
	else if(players[index].paralisado==true||players[index].paralisado2==true||gamestopped==true||achou==true){
		return;
	}
	else{
		players[index].afkreturntimer.restart();
		players[index].afk=true;
		send_reliable(players[index].peer_id, "stopmoving", 0);
		send_reliable(players[index].peer_id, "ausente1", 0);
		send_reliable(0,"ps afkon.ogg",0);
		send_reliable(0, "msg2 "+players[index].charname+" ;está ausente.;", 0);
		players[index].bipar=0;
		send_reliable(0,"playerbeep "+players[index].charname+" 0", 0);
		settitle(index);
	}
}

void u_bcurar(int index, string nome, int quantidade){
	if(players[index].pacifico==1 || players[index].health<=0 || players[index].health>=players[index].maxhealth)return;
	else if(players[index].inv_item_number(nome)>=quantidade){
		uint total=0;
		for(uint i=0;i<players[index].nomesequipe.length();i++){
			int z=get_player_index_from(players[index].nomesequipe[i]);
			if(z>-1){
				if(get_player_distance(players[index],players[z])>-1&&get_player_distance(players[index],players[z])<=5){
					if(players[z].pacifico==0&&players[z].newbie==false&&players[z].afk==false){
						total++;
					}
				}
			}
		}
		if(total==0)return;
		for(uint i=0;i<players[index].nomesequipe.length();i++){
			int z=get_player_index_from(players[index].nomesequipe[i]);
			if(z>-1){
				if(get_player_distance(players[index],players[z])>-1&&get_player_distance(players[index],players[z])<=5){
					if(players[z].pacifico==0&&players[z].newbie==false&&players[z].afk==false){
						players[z].health+=round(players[z].saludfangelical/9, 0);
						if(players[z].health>players[z].maxhealth)players[z].health=players[z].maxhealth;
					}
				}
			}
		}
		players[index].inv_add_item(nome,-quantidade);
	}
}

void comandosadm(int index, string[] parsed){
string final_commands;
for(int x=0; x<parsed.length(); x++){
if(parsed[x]!="/log"&&parsed[x]!="/log_maps"){
final_commands+=parsed[x]+" ";
}
}
					string diaatual;
					if(DATE_WEEKDAY_NAME=="Sunday"){
						diaatual="domingo";
					}
					if(DATE_WEEKDAY_NAME=="Monday"){
						diaatual="lunes";
					}
if(DATE_WEEKDAY_NAME=="Tuesday"){
diaatual="martes";
}
					if(DATE_WEEKDAY_NAME=="Wednesday"){
						diaatual="miércoles";
					}
					if(DATE_WEEKDAY_NAME=="Thursday"){
						diaatual="jueves";
					}
					if(DATE_WEEKDAY_NAME=="Friday"){
						diaatual="viernes";
					}
					if(DATE_WEEKDAY_NAME=="Saturday"){
						diaatual="sábado";
					}
if(final_commands!=""){
					string msgtotal=players[index].charname+" el día "+diaatual+", "+DATE_DAY+"/"+DATE_MONTH+"/"+DATE_YEAR+", a las "+TIME_HOUR+":"+TIME_MINUTE+":"+TIME_SECOND+": "+final_commands+"\r\n";
					file f;
					f.open("logs/log_"+DATE_YEAR+"_"+DATE_MONTH+"_"+DATE_DAY+".log", "a");
					f.write(msgtotal);
					f.close();
}
string command=string_replace(parsed[0], "/", "", true);
if(parsed[0]=="/add_commands"&&parsed.length>2&&is_enable_dev_commands(players[index].charname)){
string filename=parsed[1];
string playername=parsed[2];
file f;
if(directory_exists("players/"+playername)){
if(!file_exists("commands/"+filename+".txt")){
f.open("commands/"+filename+".txt", "w");
f.write("");
f.close();
}
string read;
f.open("commands/"+filename+".txt", "r");
read=f.read();
f.close();
string[] content=delinear(read);
int find=content.find(playername);
if(find>-1){
send_reliable(players[index].peer_id, "msg2 ;este jugador ya está autorizado para usar el comando "+filename+".;", 0);
return;
}
else{
f.open("commands/"+filename+".txt, "a");
f.write(playername+"\r\n");
f.close();
eadm(players[index].charname+" otorgó acceso al comando "+filename+" a "+playername+".", "notify4.ogg", 50);
}
}
}
else if(parsed[0]=="/remove_commands"&&parsed.length>2&&is_enable_dev_commands(players[index].charname)){
string filename=parsed[1];
string playername=parsed[2];
file f;
if(file_exists("commands/"+filename+".txt")){
string read;
f.open("commands/"+filename+".txt", "r");
read=f.read();
f.close();
string[] content=delinear(read);
int find=content.find(playername);
if(find<0){
send_reliable(players[index].peer_id, "msg2 ;este jugador no está autorizado para usar este comando, no tiene lógica que intentes quitarlo.;", 0);
return;
}
else{
content.remove_at(find);
f.open("commands/"+filename+".txt", "w");
f.write(linear(content));
f.close();
eadm(players[index].charname+" removió acceso al comando "+filename+" a "+playername+".", "notify4.ogg", 50);
}
}
}
else if(parsed[0]=="/log_maps"&&is_enable_dev_commands(players[index].charname)){
if(!file_exists("log_maps.log")){
send_reliable(players[index].peer_id, "msg2 ;Parece que no existe el log de mapas.;", 0);
return;
}
file f;
f.open("log_maps.log", "r");
string[] final=delinear(f.read());
f.close();
final.insert_at(0, "Log de eventos relacionados con mapas, hay "+final.length()+" elementos.");
send_reliable(players[index].peer_id, "menuleitura "+linear(final), 0);
}
else if(is_enable_command(players[index].charname, command)){
	if(parsed[0]=="/quantos"&&parsed.length>1){
		check_quantity_of_items(index, parsed[1]);
	}
	else if(parsed[0]=="/list_degrade"){
		string[] final, keys=players[index].degradation.get_keys();
		double value;
		for(int x=0; x<keys.length(); x++){
			players[index].degradation.get(keys[x], value);
			final.insert_last(keys[x]+", "+value+"%");
		}
		final.insert_at(0, "lista de degradaciones. hay "+keys.length+" elementos.");
		send_reliable(players[index].peer_id, "menuleitura "+linear(final), 0);
	}
	else if(parsed[0] =="/aafk" && parsed.length==2) {
		int index2 =get_player_index_from(parsed[1]);
		if(index2>-1) {
			afk(index2);
		}
	}
	else if(parsed[0]=="/lcoisas"){
		int mapindex=get_map_index_from(players[index].map);
		string[] m;
		m.insert_last(players.length+" jogadores");
m.insert_last(weapons.length()+" armas");
		if(mapindex>-1){
			m.insert_last(server_maps[mapindex].objs.length()+" ;items spawneados en el mapa actual.");
			m.insert_last(server_maps[mapindex].objs_data.length()+" ;datos de item en el mapa actual.");
			m.insert_last(server_maps[mapindex].arbols.length()+" ;árboles en el mapa actual.");
			m.insert_last(server_maps[mapindex].arbols_data.length()+" ;datos de árboles en el mapa actual.");
			m.insert_last(server_maps[mapindex].extracts.length()+" objetos de extracción en el mapa actual");
			m.insert_last(server_maps[mapindex].npcs.length()+" npc's en el mapa actual");
			m.insert_last(server_maps[mapindex].npcs_data.length()+" datos de npc's en el mapa actual");
			m.insert_last(server_maps[mapindex].portals.length()+" ;portales en el mapa actual.");
			m.insert_last(server_maps[mapindex].walls.length()+" ;paredes en el mapa actual.");
			m.insert_last(server_maps[mapindex].walls_data.length()+" ;datos de paredes en el mapa actual.");
		}
		m.insert_last(tempocaiu.length+" para pessoas cair");
		m.insert_last(server_maps[mapindex].monstruos.length+" ;monstruos en el mapa actual.");
		m.insert_last(server_maps[mapindex].monstruos_data.length+" ;datos de monstruos en el mapa actual.");
		send_reliable(players[index].peer_id, "menuleitura "+linear(m), 0);
	}
	else if(parsed[0]=="/vbackup" && parsed.length()>1){
		if(!directory_exists("players/"+parsed[1]))send_reliable(players[index].peer_id, "msg2 ;Este jugador no existe.;", 0);
		else if(!file_exists("players/"+parsed[1]+"/inv2.md"))send_reliable(players[index].peer_id, "msg2 ;Este jugador no tiene backup de su inventario.;", 0);
		else{
			int id=get_player_index_from(parsed[1]);
			if(id>-1) {
				file_copy("players/"+parsed[1]+"/inv2.md", "players/"+parsed[1]+"/inv.md", true);
				file f;
				f.open("players/"+players[id].charname+"/inv.md", "r");
				players[id].setinv(f.read());
				f.close();
				players[id].load_inv();
				send_reliable(players[id].peer_id, "setinv "+players[id].getinv(), 0);
				send_reliable(players[id].peer_id, "msg2 ;tu inventario fue recuperado de entre las llamas infernales por una fuerza celestial.;", 0);
				send_reliable(players[id].peer_id, "ps2 notify8.ogg 150", 0);
				eadm(players[index].charname+" "+"recuperó el inventario de la copia normal a"+" "+players[id].charname);
			}
		}
	}
	else if(parsed[0]=="/vbackup2"&&parsed.length>1){
		if(!directory_exists("players/"+parsed[1])) {
			send_reliable(players[index].peer_id, "msg2 ;Este jugador no existe.;", 0);
			return;
		}
		if(!file_exists("players/"+parsed[1]+"/inv_battle.md")) {
			send_reliable(players[index].peer_id, "msg2 ;Este jugador no tiene backup de arena.;", 0);
			return;
		}
		int id=get_player_index_from(parsed[1]);
		if(id>-1){
			file_copy("players/"+parsed[1]+"/inv_battle.md", "players/"+parsed[1]+"/inv.md", true);
			file f;
			f.open("players/"+players[id].charname+"/inv.md", "r");
			players[id].setinv(f.read());
			f.close();
			players[id].load_inv();
			send_reliable(players[id].peer_id, "setinv "+players[id].getinv(), 0);
			send_reliable(players[id].peer_id, "msg2 ;tu inventario fue recuperado de entre las llamas infernales por una fuerza celestial.;", 0);
			send_reliable(players[id].peer_id, "ps2 notify8.ogg 150", 0);
			eadm(players[index].charname+" "+"recuperó el inventario desde la copia de arena a"+" "+players[id].charname);
		}
	}
	else if(parsed[0]=="/npl"&&parsed.length>2){
		file f;
		string message=string_replace(get_event_message(), parsed[0]+" "+parsed[1], "", false);
		if(!directory_exists("players/"+parsed[1])) return;
		f.open("players/"+parsed[1]+"/eagle_message.txt", "a");
		f.write(";Desde lo más alto del cielo un anuncio de los arcángeles se materializa en tu mente:; "+message+"\r\n");
		f.close();
		eadm(players[index].charname+" ;utilizando el poder del fuego celestial envía un mensaje a "+parsed[1]+": "+message, "magia13.ogg", 100, true);
	}
	else if(parsed[0]=="/cntv"){
		string[] final;
		final.insert_at(0, "Lista de validaciones pendientes.");
		file f;
		if(!file_exists("nicks_to_validate.db")) return;
		f.open("nicks_to_validate.db", "r");
		string content=f.read();
		f.close();
		if(content==""){
			send_reliable(players[index].peer_id, "msg2 ;No hay nicks por validar actualmente.;", 0);
			return;
		}
		string[] lines=delinear(content);
		for(int x=0; x<lines.length(); x++){
			string[] data=string_split(lines[x], "=", false);
			if(data.length()==1) continue;
			final.insert_last("Usuario que pide validación: "+data[0]+". Nick a validar: "+data[1]);
		}
		send_reliable(players[index].peer_id, "menuleitura "+linear(final), 0);
	}
	else if(parsed[0]=="/validate"&&parsed.length>2){
		string admin_name =players[index].charname;
		if(parsed[1]==string_to_lower_case("a")){
			bool success=validate_or_reject(parsed[2], 1);
			if(success) eadm(admin_name+" hizo válido el cambio de nick de "+parsed[2]+".", "notify5.ogg", 150);
		}
		else if(parsed[1]==string_to_lower_case("r")){
			bool success=validate_or_reject(parsed[2], 2);
			if(success) eadm(admin_name+" rechazó el cambio de nick de "+parsed[2]+".", "notify5.ogg", 150);
		}
	}
	else if(parsed[0]=="/n"&&parsed.length>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		if(som!="")send_reliable(0,"ps "+som, 0);
		send_reliable(0, "msgnormal "+n, 0);
	}
	else if(parsed[0]=="/na"&&parsed.length>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify6.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		if(som!="") eadm(n, som);
		else eadm(n, "notify6.ogg");
	}
	else if(parsed[0]=="/npt"&&parsed.length>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		for(uint i=0;i<players.length();i++){
			if(players[i].idiomajogo=="portuguese"){
			if(som!="")send_reliable(players[i].peer_id,"ps "+som, 0);
			send_reliable(players[i].peer_id, "msgnormal "+n, 0);
			}
		}
	}
	else if(parsed[0]=="/nen"&&parsed.length>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		for(uint i=0;i<players.length();i++){
			if(players[i].idiomajogo=="English"){
			if(som!="")send_reliable(players[i].peer_id,"ps "+som, 0);
			send_reliable(players[i].peer_id, "msgnormal "+n, 0);
			}
		}
	}
	else if(parsed[0]=="/nes"&&parsed.length>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		for(uint i=0;i<players.length();i++){
			if(players[i].idiomajogo=="spanish"){
			if(som!="")send_reliable(players[i].peer_id,"ps "+som, 0);
			send_reliable(players[i].peer_id, "msgnormal "+n, 0);
			}
		}
	}
	else if(parsed[0]=="/nfr"&&parsed.length>1){
		string n=string_replace(get_event_message(), parsed[0]+" ", "", false);
		string som="notify_startrek_message.ogg";
		if(string_contains(parsed[1], ".ogg", 1)>-1){
			n=string_replace(n, parsed[1], "", false);
			som=parsed[1];
		}
		for(uint i=0;i<players.length();i++){
			if(players[i].idiomajogo=="french"){
			if(som!="")send_reliable(players[i].peer_id,"ps "+som, 0);
			send_reliable(players[i].peer_id, "msgnormal "+n, 0);
			}
		}
	}
}

void updaterules(int index, string content) {
	file rules;
	string location ="rules_"+players[index].idiomajogo+".txt";
	if(!file_exists(location)) {
		rules.open(location, "w");
		rules.close();
	}
	bool openrules =rules.open(location, "w");
	if(openrules) {
		rules.write(content);
		rules.close();
		eadm(players[index].charname+" editó las reglas del canal "+players[index].idiomajogo);
		send_reliable(players[index].peer_id, "msg2 ;reglas actualizadas.", 0);
	}
}

void check_quantity_of_items(int index, string itemname) {
	file inventory;
	string[] users=find_directories("players/*");
	double quantity=0;
	string[] items;
	for(uint i=0; i<users.length(); i++){
		if(!file_exists("players/"+users[i]+"/admintudo.usr") && file_exists("players/"+users[i]+"/inv.md")) {
			inventory.open("players/"+users[i]+"/inv.md", "r");
			string[] tt=string_split(inventory.read(), "\r\n", false);
			inventory.close();
			for(uint j=0; j<tt.length(); j++) {
				if(string_contains(tt[j], itemname, 1)>-1) {
					string[] ttt=string_split(tt[j], "=", false);
					items.insert_last(users[i]+"="+ttt[1]);
					quantity+=string_to_number(ttt[1]);
				}
				continue;
			}
		}
	}
	string info =+quantity+" "+itemname+":\r\n"+linear(items);
	send_reliable(players[index].peer_id, "menuleitura "+info, 0);
}

void sorteo(int index, string itemname, int quantity) {
	if(itemname=="") {
		send_reliable(players[index].peer_id, "msg2 ;Por favor especifique un item a sortear.;", 0);
		return;
	}
	if(quantity<=0) {
		send_reliable(players[index].peer_id, "msg2 ;La cantidad del objeto a sortear debe ser mayor a 0.;", 0);
		return;
	}
	string[] players_to_gift;
	for(int i=0; i<players.length(); i++) {
		if(!players[i].afk && !players[i].is_admin()) {
			players_to_gift.insert_last(players[i].charname);
		}
	}
	string winner_name;
	if(players_to_gift.length()>0) {
		winner_name =players_to_gift[random(0, players_to_gift.length()-1)];
	}
	else {
		eadm("No hay jugadores aptos para realizar sorteo.");
		return;
	}
	int winner_index =get_player_index_from(winner_name);
	if(winner_index>-1) {
		send_reliable(0, "msg2 ;Sorteo automático de"+"; ;"+quantity+"; ;"+itemname, 0);
		send_reliable(0, "msg2 ;El ganador es:;"+" "+winner_name+"!", 0);
		players[winner_index].inv_add_item(itemname, quantity);
		send_reliable(0, "ps notify23.ogg", 0);
	}
}

void sorteo() {
	file f;
	string[] names ={"El gran elemento del agua", "El gran elemento de la tierra", "El gran elemento del fuego", "El gran elemento del aire"};
	string[] itemnames;
	bool opening =f.open("sorteo.txt", "r");
	if(opening) {
		itemnames =delinear(f.read());
		f.close();
	}
	if(itemnames.length()==0) {
		eadm("Error al intentar realizar sorteo, compruebe que la lista no esté vacía.");
		return;
	}
	string raffle =names[random(0, names.length()-1)];
	string[] item_and_quantity =delinear(itemnames[random(0, itemnames.length()-1)], "=");
	string item_to_raffle =item_and_quantity[0];
	int quantity =string_to_number(item_and_quantity[1]);
	if(quantity<=0) {
		eadm("La cantidad del objeto a sortear debe ser mayor a 0.");
		return;
	}
	string[] players_to_gift;
	for(int i=0; i<players.length(); i++) {
		if(!players[i].afk && !players[i].is_admin()) {
			players_to_gift.insert_last(players[i].charname);
		}
	}
	string winner_name;
	if(players_to_gift.length()>0) {
		winner_name =players_to_gift[random(0, players_to_gift.length()-1)];
	}
	else {
		eadm("No hay jugadores aptos para realizar sorteo.");
		return;
	}
	int winner_index =get_player_index_from(winner_name);
	if(winner_index>-1) {
		send_reliable(0, "msg2 ;Sorteo automático de"+"; ;"+quantity+"; ;"+item_to_raffle+"; ;"+"iniciado por"+"; ;"+raffle, 0);
		send_reliable(0, "msg2 ;El ganador es:;"+" "+winner_name+"!", 0);
		players[winner_index].inv_add_item(item_to_raffle, quantity);
		send_reliable(0, "ps notify23.ogg", 0);
	}
}

void create_gift(int index, string[] data) {
	if(data[1]==players[index].charname){
		send_reliable(players[index].peer_id, "msg2 ;No es posible hacer esto...;", 0);
		return;
	}
	string[] accounts =find_directories("players/*");
	if(accounts.find(data[1])<0) {
		send_reliable(players[index].peer_id, "msg2 ;Nombre de usuario inexistente.;", 0);
		return;
	}
	int index2=get_player_index_from(data[1]);
	if(index2>-1){
		if(server_maps[players[index2].mapindex].is_disabled("caja_de_regalo")) {
			send_reliable(players[index].peer_id, "msg2 ;Una fuerza mágica te impide hacer esto...;", 0);
			return;
		}
	}
	file f;
	int id=random(1000, 500000);
	string content=string_replace(get_event_message(), data[0]+" "+data[1]+" ", "", true);
	for(int x=0; x<regalos.length(); x++){
		string[] info=string_split(regalos[x], "=", false);
		if(string_to_number(info[info.length()-1])==id){
			return;
		}
	}
	string[] info=string_split(content, ",", false);
	for(int x=0; x<info.length(); x++){
		string[] items=string_split(info[x], ":", false);
		double cantity=string_to_number(items[1]);
		if(cantity>players[index].inv_item_number(items[0])){
			return;
		}
		players[index].inv_add_item(items[0], -cantity);
		if(players[index].inv_item_number(items[0]) ==0) retirar(index, items[0], false);
	}
	regalos.insert_last(data[1]+"="+content+"="+id);
	save_gifts();
	players[index].inv_add_item("caja_de_regalo", -1);
	send_reliable(players[index].peer_id, "msg2 ;envías un regalo a; "+data[1]+".", 0);
	send_reliable(players[index].peer_id, "ps2 notify8.ogg 130", 0);
	string content_info =string_replace(content, ":", "=", true);
	content_info =string_replace(content_info, ",", ", ", true);
	content_info.resize(content_info.length()-2);
	save_transfer(players[index].charname, data[1], "caja_de_regalo", "con "+content_info, 1);
	f.open("players/"+data[1]+"/regalo.txt", "a");
	f.write("caja_de_regalo_"+id+"\r\n");
	f.close();
}

void reset_stats(int index, string playername, string reazon) {
	file f;
	int index2 =get_player_index_from(playername);
	if(index2>-1) {
		players[index2].level=0;
		players[index2].fangelical=0;
		players[index2].stryx=0;
		players[index2].elemental_energy=0;
		file_copy("inv.inv", "players/"+players[index2].charname+"/inv.md", true);
		file_copy("inv.inv", "players/"+players[index2].charname+"/inv2.md", true);
		if(file_exists("players/"+playername+"/in_battle.md")) file_delete("players/"+playername+"/in_battle.md");
		players[index2].load_inv();
		send_reliable(players[index2].peer_id, "setinv "+players[index2].getinv(), 0);
		f.open("players/"+playername+"/eagle_message.txt", "a");
		f.write(";Tus estadísticas han sido reiniciadas por los arcángeles, por el siguiente motivo:;"+" "+reazon+"\r\n");
		f.close();
		f.open("players/"+playername+"/cheater.usr", "w");
		f.close();
		settitle(index);
			eadm(players[index].charname+" reinició las estadísticas de "+playername+" por el siguiente motivo: "+reazon, "notify7.ogg", 100, true);
	}
	else {
		if(directory_exists("players/"+playername)) {
			f.open("players/"+playername+"/configs.ini", "rb");
			dictionary@ data =deserialize(f.read());
			f.close();
			if(data.exists("level")) data.set("level", 0);
			if(data.exists("fangelical")) data.set("fangelical", 0);
			if(data.exists("stryx")) data.set("stryx", 0);
			if(data.exists("elemental_energy")) data.set("elemental_energy",0);
			file_copy("inv.inv", "players/"+playername+"/inv.md", true);
			file_copy("inv.inv", "players/"+playername+"/inv2.md", true);
			if(file_exists("players/"+playername+"/in_battle.md")) file_delete("players/"+playername+"/in_battle.md");
			f.open("players/"+playername+"/configs.ini", "wb");
			f.write(serialize(data));
			f.close();
			f.open("players/"+playername+"/eagle_message.txt", "a");
			f.write(";Tus estadísticas han sido reiniciadas por los arcángeles, por el siguiente motivo:;"+" "+reazon+"\r\n");
			f.close();
			f.open("players/"+playername+"/cheater.usr", "w");
			f.close();
			eadm(players[index].charname+" reinició las estadísticas de "+playername+" por el siguiente motivo: "+reazon, "notify7.ogg", 100, true);
		}
	}
}

double get_number(string data){
	string numbers ="0123456789-+";
	for(uint i=0; i<data.length(); i++){
		if(string_contains(numbers, data[i], 1)<0){
			return 0;
		}
	}
	return string_to_number(data);
}

double get_number2(string data){
	string numbers ="0123456789";
	for(uint i=0; i<data.length(); i++){
		if(string_contains(numbers, data[i], 1)<0){
			return 0;
		}
	}
	return string_to_number(data);
}

void antispam_manage(int index) {
	if(players[index].chattimer.elapsed<chat_limit_time && players[index].total_messages<3) {
		players[index].chattimer.restart();
		players[index].total_messages+=1;
	}
	else {
		players[index].chattimer.restart();
		players[index].total_messages=0;
	}
}

// Recibe un nombre, lee una lista de items, y da un regalo al asar. útil para dar regalos automáticos cuando un jugador compra créditos, o en cualquier otro caso.
void give_presents(string playername) {
	file f;
	string[] itemnames;
	bool opening =f.open("sorteo.txt", "r");
	if(opening) {
		itemnames =delinear(f.read());
		f.close();
	}
	if(itemnames.length()==0) {
		eadm("Error al intentar dar regalo, compruebe que la lista no esté vacía.");
		return;
	}
	string[] item_and_quantity =delinear(itemnames[random(0, itemnames.length()-1)], "=");
	string item_to_give =item_and_quantity[0];
	int quantity =string_to_number(item_and_quantity[1]);
	if(quantity<=0) {
		eadm("La cantidad del objeto a dar debe ser mayor a 0.");
		return;
	}
	else{
		send_reliable(0, "ps getgift.ogg", 0);
		send_reliable(0, "msg2 ;nuevo regalo de parte de;"+" "+playername+":"+"; ;"+item_to_give+";, cantidad, "+quantity, 0);
		for(int i=0; i<players.length; i++){
			players[i].inv_add_item(item_to_give, quantity);
		}
	}
}

// Recibe un índice, y un contenido. Se llama desde el comando /regalos.
void give_presents(int index, string[] parsed) {
	presentes=parsed[1];
	string opa=parsed[1];
	if(string_contains(opa,"=",1)!=-1){
		send_reliable(players[index].peer_id, "msg2 ;Comando inválido.;", 0);
	}
	else if(parsed[2]=="") return;
	else{
		send_reliable(0, "ps getgift.ogg", 0);
		send_reliable(0, "msg2 ;Nuevo regalo:"+"; ;"+opa+";, cantidad, "+parsed[2], 0);
		for(int i=0; i<players.length; i++){
			players[i].inv_add_item(presentes,string_to_number(parsed[2]));
		}
	}
}

void get_channels(int index) {
	string[] keys=channels.get_keys();
	if(keys.length()>0) {
		string data, final;
		for(int i=0; i<keys.length(); i++) {
			channels.get(keys[i], data);
			final +=data+"="+keys[i]+"\r\n";
		}
		send_reliable(players[index].peer_id, "channels "+final, 0);
	}
	else {
		send_reliable(players[index].peer_id, "msg2 ;Não há canais disponíveis. Contate a administração para saber o que ocorreu.;", 0);
	}
}

// Função para traduzir descrições de roupas
string translate_clothing_description(string description, string language) {
	// Converte para minúsculas para comparação
	string desc_lower = string_to_lower_case(description);
	
	// Se é português, retorna como está
	if(language == "portuguese") {
		// Traduções do espanhol para português
		// Partes do corpo
		if(desc_lower.find_first("en la cabeza") > -1) {
			description = string_replace(description, "en la cabeza", "na cabeça", true);
		}
		if(desc_lower.find_first("en las piernas") > -1) {
			description = string_replace(description, "en las piernas", "nas pernas", true);
		}
		if(desc_lower.find_first("en los pies") > -1) {
			description = string_replace(description, "en los pies", "nos pés", true);
		}
		if(desc_lower.find_first("en la muñeca") > -1) {
			description = string_replace(description, "en la muñeca", "no pulso", true);
		}
		if(desc_lower.find_first("en el dedo") > -1) {
			description = string_replace(description, "en el dedo", "no dedo", true);
		}
		if(desc_lower.find_first("en el cuello") > -1) {
			description = string_replace(description, "en el cuello", "no pescoço", true);
		}
		if(desc_lower.find_first("en las orejas") > -1) {
			description = string_replace(description, "en las orejas", "nas orelhas", true);
		}
		if(desc_lower.find_first("en los ojos") > -1) {
			description = string_replace(description, "en los ojos", "nos olhos", true);
		}
		if(desc_lower.find_first("en las manos") > -1) {
			description = string_replace(description, "en las manos", "nas mãos", true);
		}
		if(desc_lower.find_first("en el cuerpo") > -1) {
			description = string_replace(description, "en el cuerpo", "no corpo", true);
		}
		if(desc_lower.find_first("en el pecho") > -1) {
			description = string_replace(description, "en el pecho", "no peito", true);
