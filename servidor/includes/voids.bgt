				if(players[index2].map=="templop2" && players[index2].x>=201 && players[index2].x<=205 && players[index2].y==103) {
					if(players[index2].inv_item_number("mgerems")<2000000000 || players[index2].inv_item_number("elementales")<500000000 || players[index2].celestiums<1000 || players[index2].fangelical<100) {
						send_reliable(players[index2].peer_id, "msg2 ;Tu parabatai no tiene lo necesario para pagar el precio de esta decisión...;", 0);
						return;
					}
					string title ="¿Estás seguro que deseas romper la sagrada alianza del parabatai?";
					string packet ="parabatai_remove";
					string[] options={"Si=send_question", "No=no"};
					string[] soundsmenu={"menuopcion.ogg", "menuenter3.ogg", "menuopen2.ogg"};
					send_menu(index, title, packet, 0, options, soundsmenu);
				}
			}
			else send_reliable(players[index].peer_id, "msg2 ;Tu parabatai no se encuentra presente en esta dimensión...;", 0);
		}
		else return;
	}
	netloop();
}

void spawn_island(int index){
if(players[index].have_island==1){
send_reliable(players[index].peer_id, "msg2 ;¡pero tu ya tienes una isla!;", 0);
return;
}
if(players[index].inv_item_number("perla_ndired")<1000){
send_reliable(players[index].peer_id, "msg2 ;no tienes lo necesario para dar el primer pago de esta isla.;", 0);
return;
}
int mapindex=get_map_index_from("planeta_aquaphil");
if(mapindex>-1){
file f;
int coor;
if(islands==0) coor=islands+100;
else coor=islands*200+100;
islands++;
int min_coor=coor+1, max_coor=coor+99, final_coor=coor+100;
