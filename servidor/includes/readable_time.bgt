//Readable time, created by Lucas Brown.
string ms_to_readable_time(double ms)
{
if(ms<=0)
return "no time at all";
uint dias, horas, minutos,semanas,meses,segundos;
segundos=ms/1000;
minutos = segundos / 60;
segundos %= 60;
horas = minutos / 60;
minutos %= 60;
dias = horas / 24;
horas %= 24;
dias=round(dias,0);
semanas = dias / 7;
dias %= 7;
semanas=round(semanas,0);
meses = semanas / 4;
semanas %= 4;
meses=round(meses,0);
string ret;
if(meses>0)
{
string m=meses>1 ? "meses" : "mes";
ret+=meses+" "+m+", ";
}
if(semanas>0)
{
string w=semanas>1 ? "semanas" : "semana";
ret+=semanas+" "+w+", ";
}
if(dias>0)
{
string d=dias>1 ? "días" : "día";
ret+=dias+" "+d;
}
if(dias>0&&(horas>0||minutos>0||segundos>0))
ret+=", ";
if(horas>0)
{
string h=horas>1 ? "horas" : "hora";
ret+=horas+" "+h;
}
if(horas>0&&(minutos>0||segundos>0))
ret+=", ";
if(minutos>0)
{
string m=minutos>1 ? "minutos" : "minuto";
ret+=minutos+" "+m;
}
if(minutos>0&&segundos>0)
ret+=", ";
if(segundos>0)
{
string s=segundos>1 ? "segundos" : "segundo";
ret+=segundos+" "+s;
}
string[] ret2=string_split(ret,", ",true);
if(ret2.length>1)
{
int slength=ret2[(ret2.length-1)].length();
ret=string_trim_right(ret,(slength+2));
ret+=" y ";
ret+=ret2[(ret2.length-1)];
}
return ret;
}
