class extract{
	int minx, maxx, miny, maxy, hmitems, attempts, initial_attempts;
	string extracting, extracted, item;
	int extracttime;
	timer extracttimer;
	extract(int min_x, int max_x, int min_y, int max_y, int howmanyitems, int attempts2, int extracttime, string item2, string sound_extracting, string sound_extracted){
		this.minx=min_x;
		this.maxx=max_x;
		this.miny=min_y;
		this.maxy=max_y;
		this.hmitems=howmanyitems;
		this.attempts=attempts2;
		this.initial_attempts=attempts2;
		this.extracttime=extracttime;
		this.item=item2;
		this.extracting=sound_extracting;
		this.extracted=sound_extracted;
	}
	void extract_item(int index){
		int mapindex=get_map_index_from(players[index].map);
		this.attempts--;
		send_packet(0, "play "+this.extracting+".ogg "+players[index].x+" "+players[index].y, players[index].map);
		if(this.attempts<=0){
			send_packet(0, "play "+this.extracted+".ogg "+players[index].x+" "+players[index].y, players[index].map);
			server_maps[mapindex].spawn_obj(players[index].x, players[index].y, 30000, 1, this.hmitems, this.item, "get"+this.item);
			this.attempts=this.initial_attempts;
		}
	}
}
