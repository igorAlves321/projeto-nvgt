				send_reliable(this.peer_id, "ps door20close.ogg", 0);
				send_reliable(this.peer_id, "msgnormal has llegado! las puertas se abren, y sales a un enorme desierto.", 0);
			}
			if(this.tmaquina.elapsed>=100000&&this.map=="cápsula_vieja"){
