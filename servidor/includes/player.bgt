				this.tmaquina.pause();
				changemap("planeta_abandonado", get_player_index_from(this.charname), 1, 25);
				send_reliable(this.peer_id, "ps tank_kill.ogg", 0);
				send_reliable(this.peer_id, "msgnormal El suelo de la cápsula está en tan mal estado, que cae, y tu con él. Solo te queda ver como la nave se aleja de nuevo.", 0);
			}
			if(this.vbomba==1&&this.tparalisado2.elapsed>=10000&&this.paralisado3==true){
				send_reliable(this.peer_id, "startmoving", 0);
				this.paralisado3=false;
				this.vbomba=0;
			}
			if(this.atpacifista&&this.atpacifistatempo.elapsed>=1000){
				this.atpacifistatempo.restart();
				this.atpacifistasegundos--;
				if(this.atpacifistasegundos<0){
					this.atpacifista=false;
					if(this.pacifico==0){
						this.pacifico=1;
						send_reliable(this.peer_id,"ininovato", 0);
						for(int x=0; x<players.length(); x++){
							if(players[x].arank==0){
								send_reliable(players[x].peer_id, "ps notify_text.ogg", 0);
								send_reliable(players[x].peer_id,"msgdepois "+this.charname+" ahora es un ser de luz!", 0);
							}
						}
						send_reliable(0, "pp "+this.charname+" "+this.pacifico, 0);
						settitle(get_player_index_from(charname));
						return;
					}
					if(this.pacifico==1){
						this.pacifico=0;
						send_reliable(this.peer_id,"fimnovato", 0);
						for(int x=0; x<players.length(); x++){
							if(players[x].arank==0){
								send_reliable(players[x].peer_id, "ps notify_text.ogg", 0);
								send_reliable(players[x].peer_id,"msgdepois "+this.charname+" se ha convertido en un ser guerrero!", 0);
							}
						}
						send_reliable(0, "pp "+this.charname+" "+this.pacifico, 0);
						settitle(get_player_index_from(charname));
						return;
					}
				}
				else send_packet10(0, this.charname, this.charname, "timebombbeep.ogg  "+this.x+" "+this.y,this.map);
			}
			/*if(this.afking){
				this.afkreturntimer.restart();
				this.afk=true;
				this.afking=false;
				send_reliable(this.peer_id,"stopmoving",0);
				send_reliable(0,"ps afkon.ogg",0);
				send_reliable(0, "msg2 Por alguna razón,;"+" "+this.charname+";ha desaparecido de esta dimensión.", 0);
				send_reliable(0,"playerbeep "+this.charname+" 0",0);
				this.bipar=0;
				settitle(get_player_index_from(charname));
			}*/
			if(this.tminvs.elapsed>=60000){
				this.cloaked=false;
				send_reliable(this.peer_id,"stopcloak",0);
				server_maps[mapindex].send_packet(0, "play spell_cloak_hide.ogg", this.x, this.y);
				if(!this.afk){
					send_reliable(0,"playerbeep "+this.charname+" 1",0);
					this.bipar=1;
				}
				this.tminvs.force(0);this.tminvs.pause();
			}
			if(this.tmagia.elapsed>=2000){
				this.x=this.vx;
				this.y=this.vy;
				send_reliable(this.peer_id,"move "+this.x+" "+this.y,0);
				send_packet(0,"upl "+this.peer_id+" "+this.x+" "        +this.y+" "+this.map,this.map);
				send_reliable(this.peer_id, "startmoving", 0);
				this.tmagia.force(0);
				this.tmagia.pause();
				this.curando=false;
			}
			if(this.tmveloz.elapsed>=50000){
				send_reliable(this.peer_id,"dveloz",0);
				server_maps[mapindex].send_packet(0, "play spell_cloak_hideoff.ogg", this.x, this.y);
				this.tmveloz.force(0);this.tmveloz.pause();
			}
			if(this.tmpulo.elapsed>=30000){
				server_maps[mapindex].send_packet(0, "play spell_superjump_off.ogg", this.x, this.y);
				send_reliable(this.peer_id,"superjumpoff",0);
				this.tmpulo.force(0);
				this.tmpulo.pause();
			}
			if(this.tmeteoro.elapsed>=600000 && this.ameteoro==0 && this.tiempometeoro==1) {
				this.tmeteoro.pause();
				this.tiempometeoro=0;
				achuva=false;
			}
			if(this.tmflutuar.elapsed>=30000&&this.magiaactiva==true){
				this.magiaactiva=false;
				server_maps[mapindex].send_packet(0, "play spell_float_off.ogg", this.x, this.y);
				send_reliable(this.peer_id,"stopfloat",0);
				this.tmflutuar.force(0);this.tmflutuar.pause();
			}
			if(this.star){
				if(this.startimer.elapsed>1000){
					this.startimer.restart();
					this.starseconds-=1;
					if(this.starseconds>0&&this.starseconds<6) send_reliable(this.peer_id,"ps starwarn.wav",0);
					if(this.starseconds==0){
						server_maps[mapindex].send_packet(0, "play staroff.ogg", this.x, this.y);
						this.star=false;
						server_maps[this.mapindex].destroy_moving_sound(this.starsoundid);
						this.starsoundid=-1;
						send_reliable(this.peer_id,"staroff",0);
					}
				}
			}
			if(this.bolhatimer.elapsed>1000){
				this.bolhatimer.restart();
				this.bolhaseconds-=1;
				if(this.bolhaseconds>0&&this.bolhaseconds<11) send_reliable(this.peer_id,"ps magia_bolhaar_acabou.ogg",0);
				if(this.bolhaseconds==0){
					server_maps[mapindex].send_packet(0, "play magia_bolhaar_acabou.ogg", this.x, this.y);
					this.bolhaar=false;
					send_reliable(this.peer_id,"bolhaaroff",0);
				}
			}
			if(this.tmbendicion.elapsed>1000){
				this.tmbendicion.restart();
				this.bendicionsegundos-=1;
				if(this.bendicionsegundos>0&&this.bendicionsegundos<11) send_reliable(this.peer_id,"ps magia_fogo.ogg",0);
				if(this.bendicionsegundos==0){
					server_maps[mapindex].send_packet(0, "play staroff.ogg", this.x, this.y);
					this.bendicion=false;
				}
			}
			if(this.calortimer.elapsed>1000){
				this.calortimer.restart();
				this.calorseconds-=1;
				if(this.calorseconds>0&&this.calorseconds<11) send_reliable(this.peer_id,"ps magia_fogo.ogg",0);
				if(this.calorseconds==0){
					server_maps[mapindex].send_packet(0, "play staroff.ogg", this.x, this.y);
					this.calor_reprimido=false;
				}
			}
			if(this.negativo>0){
				if (this.inv_item_number("mgerems")>=this.negativo){
					this.inv_add_item("mgerems", 0-this.negativo);
					this.negativo=0;
					write_to(this.charname,"negativo.usr",this.negativo);
				}
			}
			if(savetimer.elapsed>=90000) {
				savetimer.restart();
				sconfigs(get_player_index_from(this.charname));
			}
		}
		netloop();
	}
}

void spawn_player(uint id, string name, string vers, string thebanid){
	player player1(id, name, vers,thebanid);
	players.insert_last(player1);
	players[get_player_index(id)].mine_index=get_player_index(id);
}
double get_player_distance(player@ p1, player@ p2){
	if(p1.map!=p2.map) return -1;
	int dx,dy;
	if(p1.x<=p2.x) dx=p2.x-p1.x;
	else dx=p1.x-p2.x;
	if(p1.y<=p2.y) dy=p2.y-p1.y;
	else dy=p1.y-p2.y;
	return dx+dy;
}
double get_bala_y_distance(bullet@ p1, player@ p2){
	if(p1.mapname!=p2.map) return -1;
	int dy;
	if(p1.y<=p2.y) dy=p2.y-p1.y;
	else dy=p1.y-p2.y;
	return dy;
}

int get_player_index(uint id){
	for(uint i=0; i<players.length(); i++){
		if(players[i].peer_id==id)return i;
	}
	return -1;
}

int get_player_index_from(string name, bool hiddentoo=false){
	for(uint i=0; i<players.length(); i++){
		if(string_to_lower_case(players[i].charname)==string_to_lower_case(name)) return i;
	}
return -1;
}

int get_player_index_from2(string name, bool hiddentoo=false){
	for(uint i=0; i<players.length(); i++){
		if(string_to_lower_case(players[i].charname)==string_to_lower_case(name)) return i;
	}
return 0;
}

void getplayers(int index) {
	if(players[index].afk) return;
	string data;
	for(int i=0; i<players.length(); i++) {
		if(players[index].is_admin()) {
			data +=players[i].charname+bell+players[i].title+bell+players[i].seestatus+bell2;
		}
		else {
			if(players[i].invs!=1) {
				data +=players[i].charname+bell+players[i].title+bell+players[i].seestatus+bell2;
			}
		}
	}
	send_reliable(players[index].peer_id, "listplayers "+data, 0);
}

void remove_player(string playername, string map) {
	int mapindex=get_map_index_from(map);
	int peer=-1, index=get_player_index_from(playername);
	if(index>-1) peer=players[index].peer_id;
	if(mapindex>-1){
		bool encontered=server_maps[mapindex].mapplayers_db.exists(playername);
		if(encontered){
			server_maps[mapindex].mapplayers_db.delete(playername);
			server_maps[mapindex].update_players_on_map();
			if(peer>-1) server_maps[mapindex].send_packet(6, "remove_player_from_map "+playername, true);
		}
	}
}

void remove_player(int index) {
	int peer=players[index].peer_id;
	string playername =players[index].charname;
	int mapindex=get_map_index_from(players[index].map);
	if(mapindex>-1){
		bool encontered=server_maps[mapindex].mapplayers_db.exists(playername);
		if(encontered){
			server_maps[mapindex].mapplayers_db.delete(playername);
		}
		players.remove_at(index);
		server_maps[mapindex].update_players_on_map();
		server_maps[mapindex].send_packet(6, "remove_player_from_map "+playername, true);
	}
	for(int i=0; i<server_maps.length(); i++) {
		if(i!=mapindex && !server_maps[i].mapplayers_db.is_empty()) {
			server_maps[i].update_players_on_map();
		}
	}
}

void insert_player(int index, string map) {
	int peer=players[index].peer_id, mapindex=get_map_index_from(map);
	if(mapindex>-1){
		if(server_maps[mapindex].mapplayers_db.get_size()==0 && server_maps[mapindex].paused==1) {
			server_maps[mapindex].mapplayers_db.set(players[index].charname, index);
			server_maps[mapindex].update_players_on_map();
			//server_maps[mapindex].send_to_others(peer, 6, "add_player_to_map "+players[index].charname+" "+players[index].x+" "+players[index].y+" "+players[index].bipar+" "+players[index].pacifico, true);
			server_maps[mapindex].paused =0;
			return;
		}
		else {
			server_maps[mapindex].mapplayers_db.set(players[index].charname, index);
			server_maps[mapindex].update_players_on_map();
		}
	}
}

void update_general_indexes(){
	for(int x=0; x<players.length(); x++){
		players[x].mine_index=x;
	}
}
void watch_player(int index, string who){
	int n=get_player_index_from(who);
	if(n>-1&&players[index].vmap==""){
		players[index].vmap=players[index].map;
		players[index].vx=players[index].x;
		players[index].vy=players[index].y;
		players[index].vinvs=players[index].invs;
		players[index].vbipar=players[index].bipar;
		players[index].invs=1;
		players[index].bipar=0;
		players[index].watching=1;
		players[index].w_name=players[n].charname;
		if(players[n].watcher_list.find(players[index].charname)<0) players[n].watcher_list.insert_last(players[index].charname);
		server_maps[players[n].mapindex].send_packet(0, "playerbeep "+players[index].charname+" "+players[index].bipar, true);
		server_maps[players[index].mapindex].send_packet(0, "playerbeep "+players[index].charname+" "+players[index].bipar, true);
		send_reliable(players[index].peer_id, "stopmoving", 0);
		send_reliable(players[index].peer_id, "start_watch", 0);
		changemap(players[n].map, index, players[n].x, players[n].y, "moveu.ogg");
	}
}
void stop_watch(int index){
	int w_index=get_player_index_from(players[index].w_name);
	if(w_index>-1&&players[index].watching==1){
		players[index].x=players[index].vx;
		players[index].y=players[index].vy;
		players[index].invs=players[index].vinvs;
		players[index].bipar=players[index].vbipar;
		string pmap=players[index].vmap;
		players[index].vmap="";
		players[index].watching=0;
		int find=players[w_index].watcher_list.find(players[index].charname);
		if(find>-1) players[w_index].watcher_list.remove_at(find);
		players[index].w_name.resize(0);
		changemap(pmap, index, players[index].x, players[index].y, "moveu.ogg");
		server_maps[players[index].mapindex].send_packet(0, "playerbeep "+players[index].charname+" "+players[index].bipar, true);
		send_reliable(players[index].peer_id, "stop_watch", 0);
		send_reliable(players[index].peer_id, "startmoving", 0);
	}
}
void send_players(int index, bool to_others=true){
	string final="set_map_players ";
	for(int x=0; x<server_maps[players[index].mapindex].mapplayers.length(); x++){
		final+=players[server_maps[players[index].mapindex].mapplayers[x]].charname+" "+players[server_maps[players[index].mapindex].mapplayers[x]].x+" "+players[server_maps[players[index].mapindex].mapplayers[x]].y+" "+players[server_maps[players[index].mapindex].mapplayers[x]].bipar+" "+players[server_maps[players[index].mapindex].mapplayers[x]].pacifico+" "+players[server_maps[players[index].mapindex].mapplayers[x]].peer_id+"\r\n";
	}
	send_reliable(players[index].peer_id, final, 6);
	if(to_others) server_maps[players[index].mapindex].send_to_others(players[index].peer_id, 6, "add_player_to_map "+players[index].charname+" "+players[index].x+" "+players[index].y+" "+players[index].bipar+" "+players[index].pacifico+" "+players[index].peer_id, true);
}
