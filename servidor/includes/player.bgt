	void set_sanity(int s_l){
		if(s_l>=500){
			madness_level[0]=1;
			for(int i=1; i<madness_level.length(); i++){
				madness_level[i]=0;
			}
			madness.force(0);
			madness.pause();
			madness_time=600;
		}
		if(s_l<500){
			this.madness.restart();
			madness_level[0]=0;
			madness_level[1]=1;
		}
		else if(s_l<400){
			this.madness_time=300;
			madness_level[1]=0;
			madness_level[2]=1;
		}
		else if(s_l<300){
			this.madness_time=150;
			madness_level[2]=0;
			madness_level[3]=1;
		}
		else if(s_l<200){
			this.madness_time=55;
			this.madness_level[3]=0;
			this.madness_level[4]=1;
		}
		else if(s_l<100){
			this.madness_time=27;
			madness_level[4]=0;
			madness_level[5]=1;
		}
		else if(s_l<50){
			this.madness_time=8;
			madness_level[5]=0;
			madness_level[6]=1;
		}
		else if(s_l<10){
			this.madness_time=2;
			this.madness_level[6]=0;
		}
		else if(s_l<=0){			send_reliable(this.peer_id, "madness_cinematic", 0);
			this.madness.force(0);
			this.madness.pause();
			this.mad=true;
			madness_level[0]=1;
			for(int i=1; i<madness_level.length(); i++){
				madness_level[i]=0;
			}
			// Não afeta mais a fase angelical
			// this.fangelical-=random(50, 100);
			// if(this.fangelical<=0) this.fangelical=0;
		}
		this.sanity=s_l;
	}

	void load_degradation(){
		bool needs_create;
		if(!file_exists("players/"+this.charname+"/degradation.ini")){
			needs_create=true;
		}
		file f;
		f.open("players/"+this.charname+"/degradation.ini", "rb");
		@degradation=deserialize(f.read());
		f.close();
		if(degradation.is_empty()||needs_create){
			for(int x=0; x<item_in_invs.length(); x++){
				if(!degradation.exists(item_in_invs[x].name)) degradation.set(item_in_invs[x].name, 0);
			}
			for(int x=0; x<weapons.length(); x++){
				if(!degradation.exists(weapons[x].name)) degradation.set(weapons[x].name, 0);
			}
			for(int x=0; x<clothes.length(); x++){
				if(!degradation.exists(clothes[x].name)) degradation.set(clothes[x].name, 0);
			}
		}
	}

	void save_degradation(){
		file f;
		f.open("players/"+this.charname+"/degradation.ini", "wb");
		f.write(serialize(degradation));
		f.close();
	}

	void manage_degradation(string name, double cantity, bool set=false){
		if(degradation.exists(name)){
			if(!set){
				double degradation_value;
				degradation.get(name, degradation_value);
				degradation_value+=cantity;
				if(degradation_value<=0) degradation_value=0;
				if(degradation_value>=100){
					if(this.inv_item_number(name)>0){
						this.inv_add_item(name, -1);
						if(get_weapon_index(name)>-1){
							this.inv_add_item("base_pulverizada_de_"+name, 1);
							send_reliable(this.peer_id, "ps arma_quebrada.ogg", 0);
							send_reliable(this.peer_id, "msg2 ;Parece ser que tu; ;"+name+"; ;quedó completamente inutilizable...;", 0);
						}
						if(get_clothing_index(name)>-1){
							int cindex=get_clothing_index(name);
							clothes[cindex].remove(get_player_index_from(this.charname));
						}
					}
					degradation_value=0;
				}
				degradation_value=round(degradation_value, 2);
				degradation.set(name, degradation_value);
			}
			else{
				if(cantity<=0) cantity=0;
				if(cantity>=100){
					if(this.inv_item_number(name)>0){
						this.inv_add_item(name, -1);
						if(get_weapon_index(name)>-1){
							this.inv_add_item("base_pulverizada_de_"+name, 1);
							send_reliable(this.peer_id, "ps arma_quebrada.ogg", 0);
							send_reliable(this.peer_id, "msg2 ;Parece ser que tu; ;"+name+"; ;quedó completamente inutilizable...;", 0);
						}
						if(get_clothing_index(name)>-1){
							int cindex=get_clothing_index(name);
							clothes[cindex].remove(get_player_index_from(this.charname));
						}
					}
					cantity=0;
				}
				cantity=round(cantity, 2);
				degradation.set(name, cantity);
			}
		}
	}

	void create_v_m(){
		var_management v_m2 ("players/"+this.charname+"/configs.ini", this.charname);
		@v_m=v_m2;
	}

	void manage_my_langs_version(string lang, double ver){
		string lang2=string_to_lower_case(lang);
			if(lang2=="spanish"){
			l_es_v=ver;
		}
		if(lang2=="english"){
			l_en_v=ver;
		}
		if(lang2=="french"){
			l_fr_v=ver;
		}
		if(lang2=="portuguese"){
			l_pt_v=ver;
		}
	}


	bool needs_to_update(){
		string lang=string_to_lower_case(this.idiomajogo);
		if(lang=="spanish"&&l_es_v<lang_es_v){
			l_es_v=lang_es_v;
			return true;
		}
		if(lang=="english"&&l_en_v<lang_en_v) {
			l_en_v=lang_en_v;
			return true;
		}
		if(lang=="french"&&l_fr_v<lang_fr_v){
			l_fr_v=lang_fr_v;
			return true;
		}
		if(lang=="portuguese"&&l_pt_v<lang_pt_v){
			l_pt_v=lang_pt_v;
			return true;
		}
		else return false;
	}

	void check_health_info(){
		if(this.map!="portal_espiritual"){
			if(this.tfid>-1)server_maps[this.mapindex].destroy_moving_sound(this.tfid);
			if(in_portal) {
				in_portal =false;
				for(int i=0; i<server_maps[mapindex].portals.length(); i++) {
					if(server_maps[mapindex].portals[i].portalplayers.exists(this.charname)) {
						server_maps[mapindex].portals[i].portalplayers.delete(this.charname);
					}
				}
			}
			this.centado=false;
			this.nparalisado=0;
			this.paralisado=false;
			this.tparalisado.force(0);
			this.tparalisado.pause();
			if(this.cloaked){
				this.cloaked=false;
				this.cloakhiding=false;
				send_reliable(this.peer_id,"stopcloak",0);
				server_maps[this.mapindex].send_packet(0, "play spell_cloak_powerdown.ogg", this.x, this.y);
			}
			if(this.newbie==false&&this.pacifico==0)send_reliable(this.peer_id, "fimnovato", 0);
			if(this.invs==0){
				send_reliable(0,"playerbeep "+this.charname+" 1",0);
				this.bipar=1;
			}
			if(gamestopped==false)send_reliable(this.peer_id,"startmoving",0);
			if(get_player_index_from(this.lasthit)>-1){
				players[get_player_index_from(this.lasthit)].matou+=1;
				players[get_player_index_from(this.lasthit)].sanity-=random(1, 5);
				if(players[get_player_index_from(this.lasthit)].map=="arena"){
					bool killed=false;
					int fightindex=get_player_index_from(this.lasthit);
					if(fightindex>-1){
						int find=ar.fighters.find(this.charname);
						if(find>-1){
							killed=true;
						}
						if(killed){
							ar.counter_deaths++;
							ar.remove_player_from(get_player_index_from(this.charname));
							killed=false;
						}
					}
				}
			}
			else if(this.lasthit=="fogo"){
				if(this.sexo==0) send_reliable(0, "msgmuerte "+this.charname+" morreu queimada!", 3);
				else if(this.sexo==1) send_reliable(0, "msgmuerte "+this.charname+" morreu queimado!", 3);
			}
			else if(lasthit=="altura"){
				send_reliable(0, "msgmuerte "+this.charname+" ;fue presa de la gravedad, perdiendo la vida en sus garras al destrozar su columna vertebral en mil pedazos.", 3);
			}
			else if(this.lasthit==this.death_reason){
				string reason=this.death_reason;
				if(string_contains(reason, "*nick*", 1)>-1) reason=string_replace(reason, "*nick*", this.charname, true);
				if(string_contains(reason, "*g*", 1)>-1) reason=string_replace(reason, "*g*", this.sexo2, true);
				send_reliable(0, "msgmuerte "+reason, 3);
			}
			else if(string_contains(this.lasthit,"fita_",1)>-1){
				string pname=string_replace(this.lasthit,"fita_","",false);
				send_reliable(0,"msg2 fita_explosiva; ;de; "+pname+" ;matou; "+this.charname+"!", 3);
				int pid=get_player_index_from(pname);				if(pid>-1){
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
						// Verificar se o jogador atingiu o limite para o título de mercenário
						if(players[pid].matou == 10) {
							settitle(pid); // Atualiza o título quando chega a 10 jogadores mortos
							send_reliable(players[pid].peer_id, "msg2 ;Parabéns! Você recebeu a patente de Mercenário por derrotar 10 jogadores!;", 0);
						}
					}
				}
			}
			else if(this.lasthit=="enfermedad_demoniaca"){
				send_reliable(0, "msg2 "+this.charname+" morreu por la enfermedad demoniaca!", 3);
				this.demoniaca=0;
				this.tdemoniaco2.restart();
			}
			else if(this.lasthit=="sede"){
				send_reliable(0, "msg2 "+this.charname+"; ;morreu de sede!", 3);
				this.nsede=0;
				this.nfome=0;
				this.tsedefome.restart();
			}
			else if(this.lasthit=="fome"){
				send_reliable(0, "msg2 "+this.charname+"; ;morreu de fome!", 3);
				this.nsede=0;
				this.nfome=0;
				this.tsedefome.restart();
			}
			else if(string_contains(this.lasthit,"misilavion_",1)>-1){
				string pname=string_replace(this.lasthit,"misilavion_","",false);
				send_reliable(0,"msgmuerte "+this.charname+" no pudo sobrevivir a la gran explosión provocada por los misiles de "+pname+"!", 3);
				int pid=get_player_index_from(pname);
				if(pid>-1){
					pname=players[pid].charname;
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
						ganhaxp(players[pid].charname, random(30000, 100000));
					}
				}
			}
			else if(string_contains(this.lasthit,"punho_",1)>-1){
				string pname=string_replace(this.lasthit,"punho_","",false);
				send_reliable(0, "msg2 el poderoso puño de lucifer ha mandado a "+this.charname+" directo a los infiernos!", 3);
				int pid=get_player_index_from(pname);
				if(pid>-1){
					pname=players[pid].charname;
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
					}
				}
			}
			else if(string_contains(this.lasthit,"rayo_",1)>-1){
				string pname=string_replace(this.lasthit,"rayo_","",false);
				send_reliable(0, "msg2 el rayo de energía celestial invocado por "+pname+", acaba de desintegrar el cuerpo de; "+this.charname+", eliminándol"+this.sexo2+" de este planeta!", 3);
				int pid=get_player_index_from(pname);
				if(pid>-1){
					pname=players[pid].charname;
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
					}
				}
			}
			else if(string_contains(this.lasthit,"terremoto_",1)>-1){
				string pname=string_replace(this.lasthit,"terremoto_","",false);
				send_reliable(0, "msgmuerte "+this.charname+" ;no pudo sobrevivir al impacto de las ondas expansivas provenientes del terremoto invocado por; "+pname+"!", 3);
				int pid=get_player_index_from(pname);
				if(pid>-1){
					pname=players[pid].charname;
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
					}
				}
			}
			else if(string_contains(this.lasthit,"trovão_",1)>-1){
				string pname=string_replace(this.lasthit,"trovão_","",false);
				send_reliable(0, "msg2 "+this.charname+" murió a causa del impacto del rayo que cayó en su cuerpo, todo gracias a "+pname+"!", 3);
				int pid=get_player_index_from(pname);
				if(pid>-1){
					pname=players[pid].charname;
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
					}
				}
			}
			else if(string_contains(this.lasthit,"meteoro_",1)>-1){
				string pname=string_replace(this.lasthit,"meteoro_","",false);
				send_reliable(0, "msg2 "+this.charname+" ;foi atingid"+this.sexo2+" por um dos meteoros que veio de encontro à este planeta!; ;Excelente trabalho de; "+pname+".", 3);
				int pid=get_player_index_from(pname);
				if(pid>-1){
					pname=players[pid].charname;
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
					}
				}
			}
			else if(string_contains(this.lasthit,"boladefogo_",1)>-1){
				string pname=string_replace(this.lasthit,"boladefogo_","",false);
				send_reliable(0, "msg2 "+this.charname+" ;teve seu corpo consumido pelas chamas da bola de fogo de; "+pname, 3);
				int pid=get_player_index_from(pname);
				if(pid>-1){
					pname=players[pid].charname;
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
					}
				}
			}
			else if(this.lasthit=="vidrio")send_reliable(0, "msgmuerte "+this.charname+" ;decidió no vivir más en este mundo!;", 3);
			else if(string_contains(this.lasthit,"'s mina",1)>-1){
				string pname=string_replace(this.lasthit,"'s mina","",false);
				int pid=get_player_index_from(pname);
				if(pid>-1){
					pname=players[pid].charname;
					send_reliable(0, "msgmuerte "+this.charname+" ;no fue capaz de sobrevivir a la onda expansiva causada por la explosión de la mina colocada por; "+pname+".", 3);
					if(players[pid].charname!=this.charname){
						players[pid].matou+=1;
					}
				}
			}
			else if(this.lasthit!="")send_reliable(0, "msgmuerte "+this.lasthit+"; ;matou; ;"+this.charname+";!", 3);
			if(string_contains(this.map, "prisão2", 1)<0 && string_contains(this.map, "test", 1)<0 && string_contains(this.map, "isla_privada_de_", 1)<0 && is_game_disabled(this.x, this.y, this.map)==false)changemap(mapainicial, get_player_index_from(this.charname), 1, 0);
			else changemap(this.mapavoltar, get_player_index_from(this.charname), this.x, this.y);
			this.health=this.maxhealth;
			this.lasthit="";
		}
	}

