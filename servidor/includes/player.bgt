			}
			if(this.tmaquina.elapsed>=180000&&this.map=="nave_1"){
				this.tmaquina.force(0);
				this.tmaquina.pause();
				this.nave1=1;
				send_reliable(this.peer_id, "ps mnig.ogg", 0);
