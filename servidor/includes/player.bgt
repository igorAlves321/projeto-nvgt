	int have_death(int x, int y){
		for(int i=0; i<server_maps[mapindex].deaths.length(); i++){
			int minx=server_maps[mapindex].deaths[i].minx;
			int maxx=server_maps[mapindex].deaths[i].maxx;
			int miny=server_maps[mapindex].deaths[i].miny;
			int maxy=server_maps[mapindex].deaths[i].maxy;
			if(minx>x)continue;
			if(minx<=x && maxx>=x && miny<=y && maxy>=y){
				return i;
			}
		}
		return -1;
	}

	void use_spell(string spell){
		if(is_disabled("baculo", this.map)) return;
		if(spell=="viento_protector"&&this.cloaked==false){
			this.cloaked=true;
			send_reliable(this.peer_id,"startcloak",0);
			server_maps[mapindex].send_packet(0, "play spell_cloak_powerup.ogg", this.x, this.y, 20, true);
			this.cloakhiding=true;
			send_reliable(0,"playerbeep "+this.charname+" 0",0);
			this.bipar=0;
			this.tminvs.restart();
		}
		else if(spell=="meteorito_luminoso"){
			if(this.tiempometeoro==0) {
				this.tiempometeoro=1;
				this.achuva=true;
				this.tmeteoro.restart();
				for(int i=0; i<players.length(); i++){
					if(!players[i].afk && players[i].pacifico==0 && players[i].ameteoro==0 && players[i].in_arena==0 && !players[i].in_portal) {
						players[i].health=-1;
						players[i].lasthit="meteoro_"+this.charname;
						send_reliable(players[i].peer_id, "ps chuva_de_meteoros.ogg", 0);
					}
				}
			}
		}
		else if(spell=="salto_mortal"){
			send_reliable(this.peer_id,"superjumpon",0);
			server_maps[mapindex].send_packet(0, "play spell_superjump.ogg", this.x, this.y, 20, true);
			this.tmpulo.restart();
		}
		else if(spell=="salvación_celestial"){
			int index2=get_player_index_from(this.whoparabatai);
			if(index2>-1){
				changemap(this.map, index2, this.x, this.y);
				send_packet(0, "play teleporter.ogg", players[index2].x, players[index2].y, players[index2].mapindex);
				send_reliable(players[index2].peer_id, "startmoving", 0);
				players[index2].paralisado=false;
				players[index2].paralisado2=false;
				players[index2].paralisado3=false;
				telllocal(get_player_index_from(this.charname), "te defenderé con mi propia vida.");
			}
		}
		else if(spell=="salvación_del_amor"){
			int index2=get_player_index_from(this.whomarried);
			if(index2>-1){
				changemap(this.map, index2, this.x, this.y);
				send_packet(0, "play teleporter.ogg", players[index2].x, players[index2].y, players[index2].mapindex);
				send_reliable(players[index2].peer_id, "startmoving", 0);
				players[index2].paralisado=false;
				players[index2].paralisado2=false;
				players[index2].paralisado3=false;
				telllocal(get_player_index_from(this.charname), "ven a mi...");
			}
		}
		else if(spell=="respiro_acuático"){
			this.bolhaar=true;
			server_maps[mapindex].send_packet(0, "play magia_bolhaar.ogg", this.x, this.y, 20, true);
			this.bolhaseconds=30;
			this.bolhatimer.restart();
			send_reliable(this.peer_id,"bolhadearon",0);
		}
		else if(spell=="luz_de_protección"){
			this.calor_reprimido=true;
			server_maps[mapindex].send_packet(0, "play magicpnormal1.ogg", this.x, this.y, 20, true);
			this.calorseconds=30;
			this.calortimer.restart();
		}
		else if(spell=="bendición_de_diamante"){
			this.bendicion=true;
			server_maps[mapindex].send_packet(0, "play magicpnormal1.ogg", this.x, this.y, 20, true);
			this.bendicionsegundos=600;
			this.tmbendicion.restart();
		}
		else if(spell=="destello_celestial"){
			server_maps[mapindex].send_packet(0, "play magictrueno1.ogg", this.x, this.y, 20, true);
			for(uint j=0; j<players.length; j++){
				if(players[j].charname!=this.charname&&get_player_distance(this,players[j])>-1&&get_player_distance(this,players[j])<=30&&players[j].watching==0&&players[j].pacifico==0&&players[j].newbie==false&&players[j].afk==false&&!emequipe(this.charname, players[j].charname)){
					send_packet(0,"impact corpo_caindo.ogg "+players[j].x+" "+players[j].y, players[j].map);
					send_packet(0,"inithurt "+players[j].voice+" "+players[j].x+" "+players[j].y, players[j].map);
					players[j].health-=random(30000, 40000);
					players[j].lasthit="rayo_"+this.charname;
				}
			}
		}
		else if(spell=="levitación"){
			if(this.floating==false){
				if(this.magiaactiva==false){
					this.y+=5;
					this.magiaactiva=true;
					send_reliable(this.peer_id,"startfloat",0);
					send_reliable(this.peer_id,"move "+this.x+" "+this.y,0);
					server_maps[mapindex].send_packet(0, "play spell_float_on.ogg", this.x, this.y, 20, true);
					this.tmflutuar.restart();
				}
			}
		}
		else if(spell=="puño_demoníaco"){
			server_maps[mapindex].send_packet(0, "play chute.ogg", this.x, this.y, 20, true);
			for(uint j=0; j<players.length; j++){
				if(players[j].charname!=this.charname&&get_player_distance(this,players[j])>-1&&get_player_distance(this,players[j])<=15&&players[j].watching==0&&players[j].pacifico==0&&players[j].newbie==false&&players[j].afk==false&&!emequipe(this.charname, players[j].charname)){
					send_packet(0,"impact socoforte1.ogg "+players[j].x+" "+players[j].y, players[j].map);
					send_packet(0,"inithurt "+players[j].voice+" "+players[j].x+" "+players[j].y, players[j].map);
					players[j].health-=random(100000, 400000);
					players[j].lasthit="punho_"+this.charname;
				}
			}
		}
		else if(spell=="poder_subterráneo") {
			if(server_maps[mapindex].earthquakes.length()>0) {
				send_reliable(this.peer_id, "msg2 ;ya hay un terremoto causando destrozos actualmente!;", 0);
			}
			else{
				server_maps[mapindex].send_packet(0, "play magictierra1.ogg", this.x, this.y, 20, true);
				create_earthquake(this.charname, server_maps[mapindex].max_x, server_maps[mapindex].max_y, this.map);
				this.inv_add_item("alma_terrestre", -1);
			}
		}
		else if(spell=="bola_del_dragón"){
			colocar_boladefogo(this.charname, this.lado, this.map, this.x, this.y);
		}
		else if(spell=="rayo_de_venganza"){
			for(uint j=0; j<players.length; j++){
				if(players[j].charname!=this.charname&&get_player_distance(this,players[j])>-1&&get_player_distance(this,players[j])<=100&&players[j].watching==0&&players[j].pacifico==0&&players[j].newbie==false&&players[j].afk==false&&!emequipe(this.charname, players[j].charname)){
					send_packet(0,"impact trovao6.ogg "+players[j].x+" "+players[j].y, players[j].map);
					send_packet(0,"impact spell_thunder_hit.ogg "+players[j].x+" "+players[j].y, players[j].map);
					send_packet(0,"inithurt "+players[j].voice+" "+players[j].x+" "+players[j].y, players[j].map);
					players[j].health-=random(10000, 20000);
					players[j].lasthit="trovão_"+this.charname;
				}
			}
		}
	}

void spawn_playerfire(string enemy){
	playerfire pf(enemy);
	playerfires.insert_last(pf);
}

	void playerfireloop() {
		for(uint i=0; i<playerfires.length(); i++){
			if(playerfires[i].tt.elapsed>=30000){
				playerfires.remove_at(i);
				break;
			}
			if(playerfires[i].t.elapsed>=1000){
				playerfires[i].t.restart();
				string s=server_maps[mapindex].get_tile_at(this.x, this.y);
				if(string_contains(s, "water", 1)<0&&string_contains(s, "shallow", 1)<0) {
					this.health-=random(200, 400);
					this.lasthit="boladefogo_"+playerfires[i].enemy;
					this.nsede+=0.5;
					send_packet(0,"inithurt "+this.voice, this.x, this.y, this.mapindex);
				}
				else{
					send_packet(0, "play waterhardland.ogg", this.x, this.y, this.mapindex);
					playerfires.remove_at(i);
					break;
				}
			}
		}
	}

	void inv_add_item(string itemname, double itemvalue, bool enviar=true, bool anunciar=true) {
		double result=0;
		double value;
		if(inv.exists(itemname)) {
			inv.get(itemname, value);
			double orgval;
			if(value > 0) {
				orgval=value;
			}
			else {
				return;
			}
			if(orgval+itemvalue < 1) {
				inv_delete_item(itemname);
				if (string_contains(itemname,"mm",1)==0 and string_contains(itemname,"comida",1)==-1 and itemname!="mina"&&itemname!="xp")
				send_reliable(peer_id,itemvalue+" "+itemname,4);
			}
			else {
				result =(orgval+itemvalue);
				inv.set(itemname, result);
			}
		}
		else{
			if(itemvalue > 0) {
				result =itemvalue;
				inv.set(itemname, result);
				if (string_contains(itemname,"mm",1)==0 and string_contains(itemname,"comida",1)==-1 and itemname!="mina"&&itemname!="xp")
				send_reliable(peer_id, itemvalue+" "+itemname, 4);
			}
		}
		if(enviar==true){
			send_reliable(peer_id, "inv "+itemname+"="+result, 0);
		}
		if(anunciar==true&&itemvalue>0){
			if(aitem==1){
				send_reliable(peer_id, "msg2 "+itemvalue+" ;"+itemname+";.", 0);
			}
		}
		setinv(getinv());
	}

	void sort_inv(string itemname, int range) {
		if(inv.exists(itemname) && inv_item_number(itemname)>0) {
			inv.sort(itemname, range);
			setinv(getinv());
		}
		return;
	}

	bool inv_item_exists(string itemname) {
		if(inv.exists(itemname)) {
			return true;
		}
		return false;
	}

	double inv_item_number(string itemname) {
		double value;
		if(inv.exists(itemname)) {
			inv.get(itemname, value);
			return value;
		}
		return 0;
	}

	double inv_item(string itemname) {
		string[] itemnames =inv.get_keys();
		for(uint i=0; i<itemnames.length(); i++) {
			if(itemnames[i]==itemname) {
				return i;
			}
		}
		return -1;
	}

	void inv_delete_item(string itemname) {
		if(inv.exists(itemname)) {
			inv.delete(itemname);
		}
	}

	void load_inv() {
		string content;
		file f;
		f.open("players/"+this.charname+"/inv.md", "r");
		string[] playerinv =delinear(f.read());
		f.close();
		if(!inv.is_empty()) {
			inv.delete_all();
		}
		for(int i=0; i<playerinv.length(); i++) {
			if(playerinv.length()>0) {
				string[] data =string_split(playerinv[i], "=", true);
				if(data.length()==2) {
					inv.set(data[0], string_to_number(data[1]));
					continue;
				}
				else {
					if(inv.is_empty()) {
						file_copy("inv.inv", "players/"+this.charname+"/inv.md", true);
						this.load_inv();
					}
				}
			}
		}
	}

	void setinv(string content) {
		if(content.length()>0) {
			file f;
			f.open("players/"+this.charname+"/inv.md", "w");
			f.write(content);
			f.close();
		}
		else return;
	}

	string getinv() {
		string[] itemnames;
		double values;
		string final;
		if(!inv.is_empty()) {
			itemnames =inv.get_keys();
		}
		else {
			return "";
		}
		for(int i=0; i<itemnames.length(); i++) {
			inv.get(itemnames[i], values);
			final +=itemnames[i]+"="+values+"\r\n";
		}
		return final;
	}

	bool has_muted(string name)
	{
		string[] m=string_split(muted,"\r\n",false);
		for (uint i=0; i<m.length(); i++)
		{
			if (m[i]==name)
			{
				return true;
			}
		}
		return false;
	}

	void add_muted(string name)
	{
		muted+="\r\n"+name;
		write_to(charname,"muted.usr",muted);
	}

	void see_status(string name){
file sstatus;
	}

	bool remove_muted(string name) {
		string[] m=string_split(muted,"\r\n",false);
		string newmuted;
		bool succeeded;
		for (uint i=0; i<m.length(); i++) {
			if (m[i]!=name)
			newmuted+="\r\n"+m[i];
			else
			succeeded=true;
		}
		muted=newmuted;
		write_to(charname,"muted.usr",muted);
		return succeeded;
	}

	void enter_the_portal() {
		int portalindex;
		int add_portal_health =this.health/2;
		int final_portal_health =round(add_portal_health, 0);
		if(server_maps[mapindex].have_portal(this.x, this.y, portalindex)) {
			if(!in_portal && portalindex>-1) {
				in_portal =server_maps[mapindex].portals[portalindex].add_player(this.charname, final_portal_health);
				if(in_portal) {
					this.health -=final_portal_health;
					send_reliable(this.peer_id, "stopmoving", 0);
					send_reliable(this.peer_id, "msg2 ;Entras en el gran portal, rodeándote con su luz intensa. Un campo magnético se materializa, mientras ves cómo el aro luminoso que lo rodea se fortalece y se hace más grande.", 0);
				}
			}
		}
	}

	void move(string steps, int x, int y, int n=0){
		int dindex=have_death(x, y);
		if(this.paralisado==true||this.paralisado2==true||this.afk)return;
		this.x=x;
		this.y=y;
		if(this.starsoundid>-1) server_maps[this.mapindex].update_moving_sound(this.starsoundid,this.x,this.y);
		if(!this.cloakhiding && this.invs==0 && this.jumping==0 && n==0 && !is_game_disabled(this.x, this.y, this.map)){
			server_maps[mapindex].send_to_others(this.peer_id, 0, "s "+this.peer_id+" "+steps+" "+this.x+" "+this.y, true);
			}
			else {
				server_maps[mapindex].send_to_others(this.peer_id, 0, "upl "+this.peer_id+" "+this.x+" "+this.y, true);
			}
		if(this.ndeath==0&&dindex>-1){
			this.ndeath=1;
			this.tdeath.restart();
			this.death_index=dindex;
			this.death_time=server_maps[mapindex].deaths[dindex].time;
			this.death_reason=server_maps[mapindex].deaths[dindex].reason;
			this.progressive_death=server_maps[mapindex].deaths[dindex].enable_progressive_death;
			this.death_life=server_maps[mapindex].deaths[dindex].life;
		}
		else if(this.ndeath==1&&dindex<0){
			this.ndeath=0;
			this.death_index=dindex;
			this.tdeath.force(0);
			this.tdeath.pause();
			this.death_reason="";
			this.death_time=0;
			this.progressive_death=0;
		}
		int find_objects =server_maps[mapindex].have_obj(this.x, this.y);
		if(find_objects>-1) {
			send_reliable(this.peer_id, "ps cameratile.ogg", 0);
		}
		int mineindex =server_maps[mapindex].have_mine(this.x, this.y);
		if(mineindex>-1){
			if(!this.newbie&&this.pacifico==0&&this.antimina==0){
				server_maps[mapindex].mines[mineindex].active =true;
			}
		}
	}

	void playerloop(){
		if(this.conectou==1){
			if(this.tcalendar.elapsed>=1000){
				this.tcalendar.restart();
				this.time.reset();
			}
			if(this.health<=0){
				check_health_info();
			}
			if(this.elemental_energy<0){
				this.elemental_energy=0;
			}
			if(this.sanity>1000) this.sanity=1000;
			if(playerfires.length()>0)playerfireloop();
			if(this.watching==1){
				int w_index=get_player_index_from(w_name);
				if(w_index>-1){
					if(this.x!=players[w_index].x||this.y!=players[w_index].y){
						this.x=players[w_index].x;
						this.y=players[w_index].y;
						send_reliable(this.peer_id,"move "+this.x+" "+this.y,0);
					}
				}
			}
			if(this.tangelical.elapsed>=1000){
				this.tangelical.restart();
				if(this.needs_madness==0){
					this.health+=random(5000, 20000);
					this.maxhealth+=random(5000, 20000);
				}
				else{
					this.sanity+=random(2, 4);
					set_sanity(sanity);
				}
				this.angelical_limit++;
			}
			if(this.angelical_limit>=120){
				this.tangelical.force(0);
				this.tangelical.pause();
				if(this.needs_madness==1) this.needs_madness=0;
				this.angelical_limit=0;
			}
			if(string_contains(this.map, "isla_privada_de_", 1)>-1){
				string data=string_replace(this.map, "isla_privada_de_", "", true);
				int index2=get_player_index_from(data);
				if(index2>-1){
					if(players[index2].payment==0){
						send_reliable(this.peer_id, "msg2 ;la reja de entrada a esta isla tiene una barrera mágica la cuál al intentar atravezarla con tu mano hace que se graben algunas letras en tu retina: Clausurada temporalmente por falta de pago.;", 0);
						changemap("planeta_aquaphil", get_player_index_from(this.charname), 1, 110);
					}
				}
				else if(index2<0){
					int pay;
					if(!file_exists("players/"+data+"/configs.ini")) return;
					else{
						file f;
						f.open("players/"+data+"/configs.ini", "rb");
						dictionary@ sd=deserialize(f.read());
						f.close();
						if(sd.exists("payment")){
							sd.get("payment", pay);
						}
						if(pay==0){
							send_reliable(this.peer_id, "msg2 ;la reja de entrada a esta isla tiene una barrera mágica la cuál al intentar atravezarla con tu mano hace que se graben algunas letras en tu retina: Clausurada temporalmente por falta de pago.;", 0);
							changemap("planeta_aquaphil", get_player_index_from(this.charname), 1, 110);
						}
					}
				}
			}
			if(this.amethyst==1 && this.tamethyst.elapsed>=1000){
				this.tamethyst.restart();
				if(this.pacifico==0) this.amethyst_time++;
			}
			if(this.amethyst_time>=900){
				this.amethyst=0;
				this.tamethyst.force(0);
				this.tamethyst.pause();
				this.amethyst_time=0;
				server_maps[this.mapindex].send_packet(0, "play ma15.ogg", this.x, this.y);
				send_reliable(this.peer_id, "msg2 ;De forma inexplicable sientes como tu fuerza te abandona...;", 0);
			}
			if(this.sanity<500&&madness_level[0]==1){
				this.madness.restart();
				madness_level[0]=0;
				madness_level[1]=1;
			}
			if(this.sanity<400&&madness_level[1]==1){
				this.madness_time=300;
				madness_level[1]=0;
				madness_level[2]=1;
			}
			if(this.sanity<300&&madness_level[2]==1){
				this.madness_time=150;
				madness_level[2]=0;
				madness_level[3]=1;
			}
			if(this.sanity<200&&madness_level[3]==1){
				this.madness_time=55;
				this.madness_level[3]=0;
				this.madness_level[4]=1;
			}
			if(this.sanity<100&&madness_level[4]==1){
				this.madness_time=27;
				madness_level[4]=0;
				madness_level[5]=1;
			}
			if(this.sanity<50&&madness_level[5]==1){
				this.madness_time=8;
				madness_level[5]=0;
				madness_level[6]=1;
			}
			if(this.sanity<10&&madness_level[6]==1){
				this.madness_time=2;
				this.madness_level[6]=0;
			}
			if(this.sanity<=0){				send_reliable(this.peer_id, "madness_cinematic", 0);
				this.madness.force(0);
				this.madness.pause();
				this.mad=true;
				this.sanity=1000;
				this.madness_level[6]=0;
				// Não afeta mais a fase angelical
				// this.fangelical-=random(50, 100);
				// if(this.fangelical<=0) this.fangelical=0;
			}
			if(this.madness.elapsed>1000){
				this.madness.restart();
				this.madness_counter+=1;
			}
			if(this.madness_counter>=this.madness_time&&this.mad==false){
				this.madness_counter=0;
				int coor=random(this.x-15, this.x+15), steps_or_effects=random(0, 10);
				if(steps_or_effects<=5){
					string packet=madness_effects[random(0, madness_effects.length()-1)];
					if(string_contains(packet, ".ogg", 1)>-1) send_reliable(this.peer_id, "play "+packet+" "+coor+" "+this.y, 0);
					else{
						string[] voices={"De repente sientes un dolor punzante que recorre tu cráneo. Cuando este llega a su cumbre máxima unas voces te susurran algo al oído:", "Sin saber por qué, sientes un escalofrío que recorre tu espina dorsal poco a poco. De pronto, escuchas algo que gesticula algunas palabras y se reflejan en tu lóbulo temporal:", "De alguna forma, logras distinguir algunas voces desconocidas en medio de tu desorden mental:"};
						send_reliable(this.peer_id, "msg canal_local |"+voices[random(0, voices.length()-1)]+"| |"+packet+"|", 0);
						send_reliable(this.peer_id, "ps playersafe.ogg", 0);
					}
				}
				else{
					this.madness_advanced.restart();
					send_reliable(this.peer_id, "play "+server_maps[mapindex].get_tile_at(this.x, this.y)+"step"+random(1, 4)+".ogg "+coor+" "+this.y, 0);
					send_reliable(this.peer_id, "stopmoving", 0);
					send_reliable(this.peer_id, "ps cordura.ogg", 0);
				}
			}
			if(this.madness_advanced.elapsed>6400){
				send_reliable(this.peer_id, "startmoving", 0);
				this.madness_advanced.force(0);
				this.madness_advanced.pause();
			}
			if(this.teagle.elapsed>=random(6000, 9000)){
				teagle.force(0);
				teagle.pause();
				server_maps[mapindex].send_packet(0, "play bot126.ogg", this.x, this.y);
				send_reliable(this.peer_id, "msg2 ;el imponente ave te otorga un pergamino de fuego con su pico para que escribas tu petición hacia los arcángeles, luego se posa frente a ti y espera paciente.;", 0);
				this.inv_add_item("pergamino_de_fuego", 1);
				this.inv_add_item("pluma_de_diamante", 1);
				this.eagle_invoked=0;
			}
			if(this.caverna==1 && this.tcaverna.elapsed>=1000) {
				this.tcaverna.restart();
				if(this.pacifico==0) this.caverna_time++;
			}
			if(this.caverna==1 && this.caverna_time>=7200) {
				this.ncaverna=-1;
				this.caverna=0;
				send_reliable(this.peer_id, "msgnormal Sientes la fuerza divina regresándote a la normalidad...", 0);
			}
			if(this.antimina==1&&this.tantimina.elapsed>=300000){
				this.tantimina.force(0);
				this.tantimina.pause();
				this.antimina=0;
				send_reliable(this.peer_id, "msgnormal de repente, te comienzas a sentir vulnerable.", 0);
				send_packet10(0, this.charname, this.charname, "door17open.ogg "+this.x+" "+this.y, this.map);
			}
			if(this.ameteoro==1 && this.tameteoro.elapsed>=600000){
				this.tameteoro.force(0);
				this.tameteoro.pause();
				this.ameteoro=0;
				send_reliable(this.peer_id, "msg2 ;Sientes que algo extraño abandona tu cuerpo.;", 0);
				server_maps[mapindex].send_packet(0, "play appear.ogg", this.x, this.y);
			}
			if(this.trueno==1&&this.tmveloz2.elapsed>=600000){
				this.trueno=0;
				send_reliable(this.peer_id,"dveloz",0);
				send_reliable(this.peer_id, "msgnormal Sientes la energía del rayo dejando de fluir por tus venas.", 0);
				send_packet10(0, this.charname, this.charname, "trovao7.ogg "+this.x+" "+this.y, this.map);
				this.tmveloz2.force(0);
				this.tmveloz2.pause();
			}
			if(this.protegido==1&&this.tprotegido.elapsed>=60000){
				this.tprotegido.force(0);
				this.tprotegido.pause();
				this.protegido=0;
				send_reliable(this.peer_id, "msgnormal Sientes que algo extraño abandona tu cuerpo.", 0);
				send_packet10(0, this.charname, this.charname, "door17open.ogg "+this.x+" "+this.y, this.map);
			}
			if(this.y<0){
				this.y=0;
				send_reliable(this.peer_id,"move "+this.x+" "+this.y,0);
				send_packet(0,"upl "+this.peer_id+" "+this.x+" "        +this.y+" "+this.map,this.map);
			}
			else if(this.x<0){
				this.x=1;
				send_reliable(this.peer_id,"move "+this.x+" "+this.y,0);
				send_packet(0,"upl "+this.peer_id+" "+this.x+" "        +this.y+" "+this.map,this.map);
			}
			if(file_exists("players/"+this.charname+"/regalo.txt")){
				file f;
				f.open("players/"+this.charname+"/regalo.txt", "r");
				string[] lines=string_split(f.read(), "\r\n", false);
				f.close();
				for(int i=0; i<lines.length(); i++){
					this.inv_add_item(lines[i], 1);
					send_reliable(this.peer_id, "ps2 notify8.ogg 130", 0);
					}
				file_delete("players/"+this.charname+"/regalo.txt");
			}
			if(this.needs_to_change==1){
				changename(get_player_index_from(this.charname), this.validated_name);
			}
			if(file_exists("players/"+this.charname+"/eagle_message.txt")){
				file f;
				f.open("players/"+this.charname+"/eagle_message.txt", "r");
				string[] lines=delinear(f.read());
				f.close();
				for(int x=0; x<lines.length(); x++){
					send_reliable(this.peer_id, "msg4 "+lines[x], 0);
				}
				send_reliable(this.peer_id, "ps trovao7.ogg", 0);
				file_delete("players/"+this.charname+"/eagle_message.txt");
			}
			if(file_exists("players/"+this.charname+"/emeralds.txt")){
				file f;
				f.open("players/"+this.charname+"/emeralds.txt", "r");
				string[] content=string_split(f.read(), "|", false);
				f.close();
				double cantity=0;
				for(int i=0; i<content.length(); i++){
					cantity+=string_to_number(content[i]);
				}
				if(enable_double_emeralds==1) ge(this.charname, cantity*2);
				else ge(this.charname, cantity);
				file_delete("players/"+this.charname+"/emeralds.txt");
				save_transfer("sistema", this.charname, "esmeraldas", "mediante compra en sitio web", cantity);
				string text =this.charname+" hizo la compra de "+cantity+" esmeraldas el "+DATE_DAY+"."+DATE_MONTH+"."+DATE_YEAR+" a "+TIME_HOUR+"."+TIME_MINUTE+".";
				eadm(text, "notify5.ogg", 150);
				log(text, "log_compras");
			}
			if(file_exists("players/"+this.charname+"/pm.md")){
				file f;
				f.open("players/"+this.charname+"/pm.md", "r");
				string mensaje=f.read();
				f.close();
				string[] lines=string_split(mensaje, "\r\n", false);
				for(uint i=0; i<lines.length(); i++){
					send_reliable(this.peer_id, "permanent "+lines[i], 0);
					send_reliable(this.peer_id, "ps message.ogg", 0);
				}
				file_delete("players/"+this.charname+"/pm.md");
			}
			if(file_exists("mensagemaes.txt")){
				file pr;
				pr.open("mensagemaes.txt","r");
				string mensaje=pr.read();
				pr.close();
				for(uint i=0; i<players.length(); i++){
					if(!this.avisado && this.is_admin()){
						send_reliable(this.peer_id, "msg4 mensaje disponible! "+mensaje, 0);
						send_reliable(this.peer_id, "ps motd.ogg", 0);
						this.avisado=true;
						break;
					}
					if(!this.avisado && this.is_mod()){
						send_reliable(this.peer_id, "msg4 mensaje disponible! "+mensaje, 0);
						send_reliable(this.peer_id, "ps motd.ogg", 0);
						this.avisado=true;
						break;
					}
				}
			}
			if(this.tbaculo.elapsed>=this.baculotiempo&&this.nbaculo<this.baculofangelical){
				this.tbaculo.restart();
				this.nbaculo+=5;
				if(this.nbaculo>this.baculofangelical)this.nbaculo=this.baculofangelical;
			}
			if(this.nomesequipe.length()==0) this.nomesequipe.insert_last(this.charname);			// Removida a limitação baseada na fase angelical
			if(this.maxhealth>=400000&&this.in_arena==1) this.maxhealth=400000;
			if(this.maxhealth<5000)this.maxhealth=5000;
			if(this.health>this.maxhealth)this.health=this.maxhealth;
			if(this.nsede<0)this.nsede=0;
			if(this.nfome<0)this.nfome=0;
			if(this.nsede>100)this.nsede=100;
			if(this.nfome>100)this.nfome=100;
			if(this.xp<0)this.xp=0;
			this.tempotrancado=this.fichaprisao * 30000 +60000;
			if(this.tdoente.elapsed>=60000&&this.sujo>=50){
				this.tdoente.restart();
				this.doente+=10;
			}
			if(this.tdoente2.elapsed>=30000&&this.doente>0){
				this.tdoente2.restart();
				this.lasthit="doente";
				this.health-=(this.doente+100*this.doente);
			}
			if(this.protegido==0&&this.tdemoniaco.elapsed>=15000&&this.afk==false&&this.newbie==false&&this.map=="mausoleo_infernal"&&this.is_admin()==false){
				this.tdemoniaco.restart();
				this.demoniaca+=10;
			}
			if(this.protegido==0&&this.tdemoniaco.elapsed>=15000&&this.afk==false&&this.newbie==false&&this.map=="laverinto_enfermizo"&&this.is_admin()==false){
				this.tdemoniaco.restart();
				this.demoniaca+=10;
			}
			if(this.tdemoniaco2.elapsed>=30000&&this.is_admin()==false&&this.demoniaca>50){
				this.tdemoniaco2.restart();
				this.lasthit="enfermedad_demoniaca";
				this.health=-1;
			}
			if(this.tsedefome.elapsed>=20000&&this.afk==false&&this.newbie==false&&this.map=="el_infierno"&&this.is_admin()==false){
				this.tsedefome.restart();
				this.nsede+=2.5;
				if(this.nsede>89)send_reliable(this.peer_id, "ps magia_bolhaar_acabou.ogg", 0);
			}
			else if(this.tsedefome.elapsed>=60000&&this.afk==false&&this.newbie==false&&this.map!="portal_espiritual" && this.is_admin()==false){
				this.tsedefome.restart();
				this.nfome+=1;
				this.nsede+=1.5;
				if(this.nsede>89||this.nfome>89)send_reliable(this.peer_id, "ps magia_bolhaar_acabou.ogg", 0);
			}
			if(this.nsede>=100){
				this.lasthit="sede";
				this.health=-1;
			}
			if(this.nfome>=100){
				this.lasthit="fome";
				this.health=-1;
			}
			if(this.afk==false&&this.pacifico==1&&this.newbie==false&&this.tinfierno.elapsed>=10000&&this.is_admin()==false){
				this.tinfierno.restart();
				if(this.map=="el_infierno"||this.map=="arena"){
					this.pacifico=0;
					send_reliable(0, "pp "+this.charname+" "+this.pacifico, 0);
					send_reliable(this.peer_id,"ininovato", 0);
					for(int x=0; x<players.length(); x++){
						if(players[x].arank==0){
							send_reliable(players[x].peer_id,"msgdepois "+this.charname+" se ha convertido en un ser guerrero!", 0);
							send_reliable(players[x].peer_id, "ps notify_text.ogg", 0);
						}
					}
				}
			}
			if(this.lregras==0 && this.map!="el_inicio") {
				changemap("el_inicio", get_player_index_from(this.charname), 1, 0);
				send_reliable(this.peer_id, "msgtravelpoint No sabes dónde estás, solamente sabes que quieres salir de aquí cuanto antes...", 0);
			}
			if(file_exists("players/"+this.charname+"/saldo.usr")) {
				file f;
				f.open("players/"+this.charname+"/saldo.usr", "r");
				double n=string_to_number(f.read());
				f.close();
				if(n>0){
					this.saldo+=(n);
					send_reliable(this.peer_id, "ps notify_beepup.ogg", 0);
					send_reliable(this.peer_id, "msg2 Você teve o valor de; ;"+n+"; ;elementales depositados em sua conta.", 0);
					file_delete("players/"+this.charname+"/saldo.usr");
				}
			}
			if(this.healthfixed>=1&&this.tvitalidad.elapsed>=1000){
				this.tvitalidad.restart();
				this.vitalidaddegradacion++;
			}
			if(this.healthfixed>=1 && this.vitalidaddegradacion>=this.vitalidad_time){
				this.healthfixed=0;
				this.vitalidaddegradacion=0;
				this.vitalidad_time=0;
				this.maxhealth=10000;
				send_reliable(this.peer_id, "msg2 ;La vitalidad perpetua que te protegía ha llegado a su fin.;", 0);
				send_reliable(this.peer_id, "ps ma18.ogg", 0);
			}
			if(this.tsilencio.elapsed>=this.temposilencio*60000&&this.silenciado==1){
				this.silenciado=0;
				file_delete("players/"+this.charname+"/silencio.usr");
				this.temposilencio=0;
				this.tsilencio.force(0);
				this.tsilencio.pause();
				if(this.avisado2==false && this.silenciado==0){
					send_reliable(this.peer_id, "msg2 ;Parece que los ángeles te han perdonado, ahora puedes hablar sin problemas. ¡Ten cuidado a la próxima!;", 0);
					this.avisado2=true;
				}
			}
			if(this.antispam==0 && this.total_messages>=3) {
				this.antispam=1;
				this.antispam_time=10;
			}
			if(this.spamtimer.elapsed>=1000) {
				spamtimer.restart();
				if(this.antispam==1 && this.antispam_time>0) {
					this.antispam_time--;
				}
			}
			if(this.antispam==1 && this.antispam_time==0) {
				this.antispam=0;
				this.total_messages =0;
			}
			if(this.tempoprisao.elapsed>=this.tempoprision*60000&&this.map=="prisão2"){
				this.tempoprision=0;
				this.tempoprisao.force(0);
				this.tempoprisao.pause();
				changemap(this.premapa, get_player_index_from(this.charname), this.prex, this.prey);
				send_reliable(this.peer_id,"Parece que has sido liberado de tu condena. espero que hayas aprendido la lección.",0);
			}
			if(this.tmaquina.elapsed>=this.pretime&&this.changing==1){
				send_reliable(this.peer_id, "startmoving", 0);
				this.tmaquina.force(0);
				this.tmaquina.pause();
