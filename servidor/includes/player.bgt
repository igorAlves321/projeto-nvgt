				changemap(this.premapa, get_player_index_from(this.charname), this.prex, this.prey, this.presound);
				send_reliable(this.peer_id, "msg2 ;"+this.pretext+";", 0);
			}
			if(this.tmaquina.elapsed>=60000&&this.map=="cápsula_interestelar"){
				this.tmaquina.force(0);
				this.tmaquina.pause();
				this.aterrizaje=1;
				send_reliable(this.peer_id, "ps m_tripode.ogg", 0);
				send_reliable(this.peer_id, "ps door17open.ogg", 0);
