/* Marriage management module, and parabatai.
Written by Angel Reyes, angeldelosreyesfaz@gmail.com. */

void marriage_loop() {
	if(tmarried.elapsed>=tempomarried&&wedding==true) {
		int index=get_player_index_from(h);
		int index2=get_player_index_from(w);
		if(index>-1&&index2>-1) {
			players[index].whomarried=w;
			players[index2].whomarried=h;
			players[index].saludfangelical+=3000;
			players[index2].saludfangelical+=3000;
			players[index].inv_add_item("runa_dorada", 1);
			players[index2].inv_add_item("runa_dorada", 1);
			players[index].marring=false;
			players[index2].marring=false;
			w="";
			h="";
			wedding=false;
			send_packet(0, "ps prematrimonio.ogg", players[index].map);
			send_packet(0, "msg2 en este momento la boda de "+players[index].charname+" y "+players[index].whomarried+" ha comenzado dando así fe y legalidad al sagrado matrimonio entre estas 2 personas.", players[index].map);
			tmarried.force(0);
			tmarried.pause();
		}
	}
}

// parabatai
void parabatai_loop() {
	if(tparabatai.elapsed>=tempoparabatai&&parabataying==true) {
		int index=get_player_index_from(h2);
		int index2=get_player_index_from(w2);
		if(index<0||index2<0) {
			int mapindex=get_map_index_from("templop");
			if(mapindex>-1) {
				server_maps[mapindex].send_packet(0, "ps magia228.ogg", true);
				server_maps[mapindex].send_packet(0, "msg2 ;El suelo del gran templo parece temblar mientras una gran pesencia impone su poder ante todos, evocando furia.;", true);
			}
			tparabatai.force(0);
			tparabatai.pause();
			parabataying=false;
		}
		else if(index>-1&&index2>-1) {
			players[index].whoparabatai=w2;
			players[index2].whoparabatai=h2;
			players[index].saludfangelical+=10000;
			players[index2].saludfangelical+=10000;
			w2="";
			h2="";
			players[index].parabataying=false;
			players[index2].parabataying=false;
			server_maps[players[index].mapindex].send_packet(0, "play ma198.ogg", players[index].x, players[index].y);
			server_maps[players[index].mapindex].send_packet(0, "msg2 ;Por la bendición de los dioses, ¡Desde ahora; "+players[index].charname+" ;y; "+players[index2].charname+" ;están pactados para siempre!;", true);
			tparabatai.force(0);
			tparabatai.pause();
			parabataying=false;
		}
	}
}

void parabatai_confirm_remove(string playername, string send_to) {
	int index =get_player_index_from(send_to);
	if(index>-1) {
		string title =playername+" quiere deshacer la sagrada unión del parabatai. ¿Estás de acuerdo?";
		string packet ="parabatai_remove";
		string[] options={"Si=confirm_parabatai_remove", "No=decline_parabatai_remove"};
		string[] soundsmenu={"menuopcion.ogg", "menuenter3.ogg", "menuopen2.ogg"};
		send_menu(index, title, packet, 0, options, soundsmenu);
	}
}

void parabatai_remove(string player1, string player2) {
	int mapindex =get_map_index_from("templop2");
	if(mapindex>-1) {
		server_maps[mapindex].send_packet(0, "msg2 ;El suelo tiembla, y todo el recinto se sacude...;", true);
		int index =get_player_index_from(player1);
		int index2 =get_player_index_from(player2);
		if(index>-1 && index2>-1) {
			server_maps[mapindex].send_packet(0, "play trovao18.ogg", 201, 103);			players[index].saludfangelical-=10000;
			gc(player1, -1000);
			players[index].inv_add_item("reais", -2000000000);
			players[index].inv_add_item("dólares", -500000000);
			players[index].whoparabatai="";
			players[index2].saludfangelical-=10000;
			gc(player2, -1000);
			players[index2].inv_add_item("reais", -2000000000);
			players[index2].inv_add_item("dólares", -500000000);
			players[index2].whoparabatai="";
			server_maps[mapindex].send_packet(0, "msg2 ;La unión de;"+" "+player1+"; y ;"+player2+"; ;"+"se ha disuelto.", true);
		}
	}
}
