class arbol{
int x, miny, maxy, trespawn, enableitems;
double vida, vida_inicial;
timer respawn;
string items, name;
string map;
arbol(int xx, int minyy, int maxyy, double vida2, int respawn_time, int enableitems2, string items2, string name2, string map){
this.x=xx;
this.miny=minyy;
this.maxy=maxyy;
this.vida=vida2;
this.vida_inicial=vida2;
this.trespawn=respawn_time;
this.enableitems=enableitems2;
this.items=items2;
this.name=name2;
this.map =map;
}
} //end class

class arbol_data{
int x, miny, maxy, trespawn, enableitems;
double vida;
timer respawn;
string items, name;
arbol_data(int xx, int minyy, int maxyy, double vida2, int respawn_time, int enableitems2, string items2, string name2){
this.x=xx;
this.miny=minyy;
this.maxy=maxyy;
this.vida=vida2;
this.trespawn=respawn_time;
this.enableitems=enableitems2;
this.items=items2;
