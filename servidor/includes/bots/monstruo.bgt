// monstruo
class monstruo{
	int x, y, ladoandar=2;
	uint tiros=1;
	int spawntime =600000;
	int vida=400000000, vidainicial=400000000;
	string golpeado, primergolpe;
	string map;
	timer monstruotimer;
	timer tempoatirar;
	timer tsom;
	timer trespawn;
	int asom=4000;
	int monstruotime=800;
	bool golpe1=false;
	monstruo(int cx, int cy, string cmap){
		x=cx;
		y=cy;
		map=cmap;
	}
}

class monstruo_data {
	int x, y, ladoandar=2;
	int spawntime =600000;
	uint tiros=1;
	int vida=400000000, vidainicial=400000000;
	string golpeado, primergolpe;
	timer monstruotimer;
	timer tempoatirar;
	timer trespawn;
	timer tsom;
	int asom=4000;
	int monstruotime=800;
	bool golpe1=false;
	monstruo_data(int cx, int cy){
		x=cx;
		y=cy;
	}
}

void vermonstruo(int index) {
	int mapindex =get_map_index_from("isla_abandonada");
	if(mapindex>-1) {
		if(server_maps[mapindex].monstruos.length()<=0) {
			send_reliable(players[index].peer_id, "msg2 el monstruo legendario está dormido en este momento. la isla está completamente libre.", 0);
		}
		for(int i=0; i<server_maps[mapindex].monstruos.length(); i++){
			if(server_maps[mapindex].monstruos.length()>0){
				if(server_maps[mapindex].monstruos[i].golpeado!=""){
					send_reliable(players[index].peer_id, "msg2 el monstruo legendario actualmente está despierto, ubicado en el mapa "+server_maps[mapindex].monstruos[i].map+". coordenadas: "+server_maps[mapindex].monstruos[i].x+", "+server_maps[mapindex].monstruos[i].y+". su vida actual es "+server_maps[mapindex].monstruos[i].vida+". la persona que es dueña de su vitalidad es "+server_maps[mapindex].monstruos[i].golpeado+".", 0);
				}
				else if(server_maps[mapindex].monstruos[i].primergolpe==""){
					send_reliable(players[index].peer_id, "msg2 el monstruo legendario actualmente está despierto, ubicado en el mapa "+server_maps[mapindex].monstruos[i].map+". coordenadas: "+server_maps[mapindex].monstruos[i].x+", "+server_maps[mapindex].monstruos[i].y+". su vida actual es "+server_maps[mapindex].monstruos[i].vida+". actualmente nadie le ha hecho daño.", 0);
				}
			}
		}
	}
}
