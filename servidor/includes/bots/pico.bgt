//pico
pico@[] picos;
class pico{
	int x, y, ladoandar=2;
	uint tiros=1;
	string golpeado;
	string map;
	timer picotimer;
	timer tempoatirar;
	timer tsom;
	int asom=400;
	int picotime=1000;
	pico(int cx, int cy, string cmap){
		x=cx;
		y=cy;
		map=cmap;
	}
}
void picoloop(){
	for(uint i=0; i<picos.length(); i++){
		if(picos[i].tsom.elapsed>=picos[i].asom+random(1000, 3200)){
			picos[i].tsom.restart();
			send_packet(0,"play espada.ogg "+picos[i].x+" "+picos[i].y+" "+picos[i].map,picos[i].map);
		}
			for(uint i2=0; i2 < players.length(); i2++){
				if(players[i2].x==picos[i].x&&players[i2].y==picos[i].y&&players[i2].map==picos[i].map&&players[i2].afk==false&&players[i2].newbie==false&&picos[i].tempoatirar.elapsed>=600){
					picos[i].tempoatirar.restart();
			send_packet(0,"play espada_infernalhit.ogg "+picos[i].x+" "+picos[i].y+" "+picos[i].map,picos[i].map);
					players[i2].health-=random(40000, 50000);
					send_packet(0,"inithurt "+players[i2].voice+" "+players[i2].x+" "+players[i2].y, players[i2].map);
					players[i2].lasthit="pico_infernal";
					break;
				}
			}
		}
	}
void spawn_pico(int x, int y, string map){
	pico c(x, y, map);
	picos.insert_last(c);
}
