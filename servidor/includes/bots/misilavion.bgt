//misilavion
misilavion@[] misilavions;
class misilavion{
	int x;
	int y;
	string map;
	string nome;
	timer misilaviontimer;
	int misilaviontime=150;
	misilavion(int cx, int cy, string cmap, string cnome){
		x=cx;
		y=cy;
		map=cmap;
		nome=cnome;
	}
}
void misilavionloop(){
	for(uint i=0; i<misilavions.length(); i++){
		if(misilavions[i].misilaviontimer.elapsed>=misilavions[i].misilaviontime){
			for(uint i2=0; i2 < players.length(); i2++){
				if(get_misilavion_distance(misilavions[i], players[i2])>-1&&get_misilavion_distance(misilavions[i],players[i2])<=50&&players[i2].afk==false&&players[i2].pacifico==0&&misilavions[i].nome!=players[i2].charname){
					players[i2].health-=random(30000, 40000);
					send_packet(0,"play explosion.ogg "+players[i2].x+" "+players[i2].y+" "+players[i2].map,players[i2].map);
					players[i2].lasthit="misilavion_"+misilavions[i].nome;
			}
}
			misilavions.remove_at(i);
		}
	}
}
void spawn_misilavion(int x, int y, string map, string nome){
	misilavion c(x, y, map, nome);
	misilavions.insert_last(c);
	send_packet(0,"play notify_blip.ogg "+x+" "+y+" "+map,map);
}
