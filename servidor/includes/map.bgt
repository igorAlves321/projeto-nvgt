			maxx =platforms[i].max_x;
			miny =platforms[i].min_y;
			maxy =platforms[i].max_y;
			if(minx>x)continue;
			if(minx<=x && maxx>=x && miny<=y && maxy>=y && platforms[i].is_staircase) return platforms[i].is_staircase;
		}
		return false;
	}

