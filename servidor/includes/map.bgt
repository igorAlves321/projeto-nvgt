void create_tile(string type, int minx, int maxx, int miny, int maxy, string tile, string map){
int mapindex=get_map_index_from(map);
if(mapindex>-1){
platform p1(type, minx, maxx, miny, maxy, tile);
server_maps[mapindex].platforms.insert_last(p1);
}
}

void remove_tile(string type, int minx, int maxx, int miny, int maxy, string map){
int mapindex=get_map_index_from(map);
if(mapindex>-1){
int tileindex=get_tile_index_from(type, minx, maxx, miny, maxy, server_maps[mapindex].name);
if(tileindex>-1){
@server_maps[mapindex].platforms[tileindex]=null;
server_maps[mapindex].platforms.remove_at(tileindex);
}
}
}

int get_tile_index_from(string type, int minx, int maxx, int miny, int maxy, string map){
int mapindex=get_map_index_from(map);
if(mapindex>-1){
for(int x=0; x<server_maps[mapindex].platforms.length(); x++){
if(server_maps[mapindex].platforms[x].plattype==type&&server_maps[mapindex].platforms[x].min_x==minx&&server_maps[mapindex].platforms[x].max_x==maxx&&server_maps[mapindex].platforms[x].min_y==miny&&server_maps[mapindex].platforms[x].max_y==maxy){
return x;
}
}
return -1;
}
return -1;
}

int get_zone_index_from(int minx, int maxx, int miny, int maxy, string map){
int mapindex=get_map_index_from(map);
if(mapindex>-1){
for(int x=0; x<server_maps[mapindex].zones.length(); x++){
if(server_maps[mapindex].zones[x].min_x==minx&&server_maps[mapindex].zones[x].max_x==maxx&&server_maps[mapindex].zones[x].min_y==miny&&server_maps[mapindex].zones[x].max_y==maxy){
return x;
}
}
return -1;
}
return -1;
}

int get_map_index_from(string m) {
	for(int i=0; i<server_maps.length(); i++) {
		if(server_maps[i].name==m) {
			return i;
		}
	}
	return -1;
}

string linear(string[] a, string char_separator="\r\n"){
	string final;
	for(uint i=0; i<a.length(); i++)
	{
		final+=a[i]+char_separator;
	}
	return final;
}

string linear(uint[] data, string char_separator="\r\n"){
	string final;
	for(uint i=0; i<data.length(); i++)
	{
		final+=data[i]+char_separator;
	}
	return final;
}

string[] delinear(string a, string char_separator="\r\n"){
	return string_split(a, char_separator, false);
}
