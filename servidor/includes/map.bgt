				int maxx =safezones[i].max_x;
				int miny =safezones[i].min_y;
				int maxy =safezones[i].max_y;
				if(minx>x)continue;
				if(minx<=x&& maxx>=x&& miny<=y&& maxy>=y)return true;
			}
		}
	return false;
}

	void view_items(int index){
		string final;
		int items_cantity=0;
		for(int x=0; x<objs.length(); x++){
			int coor_x=objs[x].x, coor_y=objs[x].y;
			string direction_x, direction_y, name=objs[x].itemname;
			double distance_min_x=players[index].x-coor_x, distance_max_x=coor_x-players[index].x, distance_min_y=players[index].y-coor_y, distance_max_y=coor_y-players[index].y;
			if(distance_min_x<=30&&distance_min_y<=30&&distance_max_x<=30&&distance_max_y<=30){
				if(coor_x<players[index].x) direction_x=distance_min_x+" ;pasos a tu izquierda;";
				else if(coor_x>players[index].x) direction_x=distance_max_x+" ;pasos a tu derecha;";
				else if(coor_x==players[index].x) direction_x=";justo al frente de ti;";
				if(coor_y<players[index].y) direction_y=distance_min_y+" ;pasos hacia abajo;";
				else if(coor_y>players[index].y) direction_y=distance_max_y+" ;pasos hacia arriba;";
				items_cantity++;
				if(direction_x!=""&&direction_y!="") final+=";"+name+";, "+direction_y+", "+direction_x+". ";
				else if(direction_x!=""&&direction_y=="") final+=";"+name+";, "+direction_x+". ";
				else if(direction_x==""&&direction_y!="") final+=";"+name+";, "+direction_y+". ";
			}
		}
		if(items_cantity==0) final=";No hay objetos cerca de ti.;";
		send_reliable(players[index].peer_id, "msg2 "+final, 0);
	}

	void view(int index) {
		bool achou=false;
		int distance;
		int range =12;
		string a="Cerca de ti se encuentra:;";
		for(uint i=0; i<arbols.length(); i++){
			distance =get_distance(players[index].x, arbols[i].x, players[index].y, arbols[i].miny);
			if(distance<=range) {
				a+=" ;"+arbols[i].name+";, ;con; "+arbols[i].vida+" ;de vida.;";
					achou=true;
			}
		}
		for(int i=0; i<walls.length(); i++){
			distance =get_distance(players[index].x, walls[i].x, players[index].y, walls[i].miny);
			if(distance<=range) {
				a+=" ;"+walls[i].name+";, ;con; "+walls[i].vida+" ;de vida.;";
				achou=true;
			}
		}
		for(int i=0; i<npcs.length(); i++){
			distance =get_distance(players[index].x, npcs[i].x, players[index].y, npcs[i].y);
			if(distance<=range) {
				a+=" ;"+npcs[i].nombrenpc+";, ;com; "+npcs[i].vida+"; ;de vida.";
				achou=true;
			}
		}
		for(int i=0; i<portals.length(); i++) {
			distance =get_distance(players[index].x, portals[i].x, players[index].y, portals[i].y);
			if(distance<=range) {
				a+=" "+portals[i].getdesc();
				achou=true;
			}
		}
		for(int i=0;i<jaulas.length();i++){
			distance =get_distance(players[index].x, jaulas[i].x, players[index].y, jaulas[i].y);
			if(distance<=range && jaulas[i].map==this.name) {
				a+=" ;jaula de; "+jaulas[i].dueno+", ;com; "+jaulas[i].vida+"; ;de vida.";
				achou=true;
			}
		}
		for(int i=0;i<cachorromascotas.length();i++){
			distance =get_distance(players[index].x, cachorromascotas[i].x, players[index].y, cachorromascotas[i].y);
			if(distance<=range && cachorromascotas[i].mapindex==this.mapindex) {
				a +=" "+cachorromascotas[i].getdesc();
				achou=true;
			}
		}
		for(int i=0; i<monstruos.length(); i++) {
			distance =get_distance(players[index].x, monstruos[i].x, players[index].y, monstruos[i].y);
			if(distance<=range) {
				a+=" ;el monstruo legendario;, ;com; "+monstruos[i].vida+"; ;de vida.;";
				achou=true;
			}
		}
		if(achou==false)send_reliable(players[index].peer_id, "msgnormal Nada por perto.", 0);
		else if(achou==true)send_reliable(players[index].peer_id, "msg2 "+a, 0);
	}

	void send_packet(int channel, string packet, int x=-1, int y=-1, int range =20, bool reliable =true) {
		for (int i=0; i<mapplayers.length(); i++){
			if (get_distance(players[mapplayers[i]].x, x,  players[mapplayers[i]].y, y)<=range) {
				if(reliable) send_reliable(players[mapplayers[i]].peer_id, packet+" "+x+" "+y, channel);
				else send_unreliable(players[mapplayers[i]].peer_id, packet+" "+x+" "+y, channel);
			}
		}
	}

	void send_packet(int channel, string packet, bool reliable =true) {
		for (int i=0; i<mapplayers.length(); i++){
			if(reliable) send_reliable(players[mapplayers[i]].peer_id, packet, channel);
			else send_unreliable(players[mapplayers[i]].peer_id, packet, channel);
		}
	}

	void send_to_others(int peer, int channel, string packet, int x=0, int y=0, int range=20, bool reliable=false) {
		if(mapplayers.length()<=1) return;
		for (int i=0; i<mapplayers.length(); i++) {
			if(players[mapplayers[i]].peer_id !=peer) {
				if (get_distance(players[mapplayers[i]].x, x,  players[mapplayers[i]].y, y)<=range) {
					if(reliable) send_reliable(players[mapplayers[i]].peer_id, packet+" "+x+" "+y, channel);
					else send_unreliable(players[mapplayers[i]].peer_id, packet+" "+x+" "+y, channel);
				}
			}
		}
	}

	void send_to_others(int peer, int channel, string packet, bool reliable=false) {
		if(mapplayers.length()<=1) return;
		for (int i=0; i<mapplayers.length(); i++) {
			if(players[mapplayers[i]].peer_id !=peer) {
				if(reliable) send_reliable(players[mapplayers[i]].peer_id, packet, channel);
				else send_unreliable(players[mapplayers[i]].peer_id, packet, channel);
			}
		}
	}
} // end class

void spawn_maps() {
	string[] filemaps = find_files("maps/*.map");
	if(filemaps.length()>0) {
		for(int x=0; x<filemaps.length(); x++) {
			map map1(filemaps[x]);
			server_maps.insert_last(map1);
			server_maps[x].mapindex=x;
		}
	}
	else {
		alert("Info", "No hay archivos en el directorio maps. Por favor asegúrese de tener por lo menos un archivo en el directorio, y ejecute el servidor de nuevo.");
		exit();
	}
}

void save_map(string map, string content="", bool send_all=true){
file f;
int mapindex=get_map_index_from(map);
if(mapindex>-1){
for(int i=0; i<server_maps[mapindex].arbols_data.length(); i++){
server_maps[mapindex].replace_line("arbol:"+server_maps[mapindex].arbols_data[i].x+":-1:-1:"+server_maps[mapindex].arbols_data[i].vida+":"+server_maps[mapindex].arbols_data[i].trespawn+":"+server_maps[mapindex].arbols_data[i].enableitems+":"+server_maps[mapindex].arbols_data[i].items+":"+server_maps[mapindex].arbols_data[i].name, "arbol:"+server_maps[mapindex].arbols_data[i].x+":"+server_maps[mapindex].arbols_data[i].miny+":"+server_maps[mapindex].arbols_data[i].maxy+":"+server_maps[mapindex].arbols_data[i].vida+":"+server_maps[mapindex].arbols_data[i].trespawn+":"+server_maps[mapindex].arbols_data[i].enableitems+":"+server_maps[mapindex].arbols_data[i].items+":"+server_maps[mapindex].arbols_data[i].name);
}
for(int i=0; i<server_maps[mapindex].walls_data.length(); i++){
server_maps[mapindex].replace_line("wall:"+server_maps[mapindex].walls_data[i].x+":-1:-1:"+server_maps[mapindex].walls_data[i].vida+":"+server_maps[mapindex].walls_data[i].trespawn+":"+server_maps[mapindex].walls_data[i].enableitems+":"+server_maps[mapindex].walls_data[i].items+":"+server_maps[mapindex].walls_data[i].name+":"+server_maps[mapindex].walls[i].sound_wall+":"+server_maps[mapindex].walls_data[i].sound_fall, "wall:"+server_maps[mapindex].walls_data[i].x+":"+server_maps[mapindex].walls_data[i].miny+":"+server_maps[mapindex].walls_data[i].maxy+":"+server_maps[mapindex].walls_data[i].vida+":"+server_maps[mapindex].walls_data[i].trespawn+":"+server_maps[mapindex].walls_data[i].enableitems+":"+server_maps[mapindex].walls_data[i].items+":"+server_maps[mapindex].walls_data[i].name+":"+server_maps[mapindex].walls[i].sound_wall+":"+server_maps[mapindex].walls_data[i].sound_fall);
}
if(content!="") server_maps[mapindex].mapdata=delinear(content);
string mapcontent=linear(server_maps[mapindex].mapdata);
f.open("maps/"+server_maps[mapindex].name+".map", "w");
f.write(mapcontent);
f.close();
insert_map(map);
if(send_all) update(map);
}
}

void update_maps_mapindexes() {
	for(int i=0; i<server_maps.length(); i++) {
		server_maps[i].mapindex =get_map_index_from(server_maps[i].name);
	}
}

void insert_map(string m) {
	int mapindex =get_map_index_from(m);
	if(file_exists("maps/"+m+".map") && mapindex>-1) {
		map map1(m+".map");
		@server_maps[mapindex] =null;
		@server_maps[mapindex] =map1;
		server_maps[mapindex].mapindex=mapindex;
		server_maps[mapindex].update_players_on_map(false);
		return;
	}
	else {
		map map1(m+".map");
		server_maps.insert_last(map1);
		server_maps[server_maps.length()-1].mapindex =server_maps.length()-1;
	}
}

void remove_map(string m, string change_players_to ="") {
	int mapindex =get_map_index_from(m);
	if(mapindex>-1) {
		if(server_maps[mapindex].mapplayers.length()>0) {
			for(int i=server_maps[mapindex].mapplayers.length()-1; i>-1; i--) {
				if(change_players_to !="") changemap(change_players_to, server_maps[mapindex].mapplayers[i], players[server_maps[mapindex].mapplayers[i]].x, players[server_maps[mapindex].mapplayers[i]].y);
				else changemap("parque", server_maps[mapindex].mapplayers[i], 1, 0);
			}
		}
		server_maps.remove_at(mapindex);
	}
	for(int i=0; i<players.length(); i++) {
		players[i].mapindex =get_map_index_from(players[i].map);
	}
	update_maps_mapindexes();
	update_cachorros_mapindexes();
}

int have_extract(int x, int y, string mapname){
	int id=get_map_index_from(mapname);
	if(id>-1){
		int extract_id=server_maps[id].have_extract(x, y);
		if(extract_id>-1){
			return extract_id;
		}
	}
	return -1;
}

bool is_disabled(string item, string m) {
	int id =get_map_index_from(m);
	if(id>-1){
		if(server_maps[id].is_disabled(item)) {
			return true;
		}
	}
	return false;
}

