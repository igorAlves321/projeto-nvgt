		outval =server_maps[id].get_locate_at();
	}
	return outval;
}

bool get_safezone_at(int x, int y, string mapname) {
	string outval;
	int id =get_map_index_from(mapname);
	if(id>-1){
		if(server_maps[id].get_safezone_at(x, y)) {
