item_in_inv@[] item_in_invs;
class item_in_inv{
string name, audio, msg, items_to_give, map;
string[] items_to_give_player;
double xp, health, thirst, fill_thirst, hunger, fill_hunger, degradation;
int newx, newy;
item_in_inv(string name2, string items_to_give2, string audio2, string msg2, string map2, int newx2, int newy2, double xp2, double health2, double thirst2, double fill_thirst2, double hunger2, double fill_hunger2, double degradation2){
this.name=name2;
this.items_to_give=items_to_give2;
this.items_to_give_player=string_split(this.items_to_give, ",", false);
this.audio=audio2;
this.msg=msg2;
this.map=map2;
this.newx=newx2;
this.newy=newy2;
this.xp=xp2;
this.health=health2;
this.thirst=thirst2;
this.fill_thirst=fill_thirst2;
this.hunger=hunger2;
this.fill_hunger=fill_hunger2;
this.degradation=degradation2;
}
void use(int index){
if(this.map!="none"){
int mapindex=get_map_index_from(this.map);
if(mapindex>-1){
if(!is_disabled(this.name, players[index].map)||!server_maps[mapindex].is_disabled(this.name)) changemap(this.map, index, this.newx, this.newy);
}
}
if(this.audio!="none") send_packet(0, "play "+this.audio+".ogg "+players[index].x+" "+players[index].y, players[index].map);
if(this.msg!="none") send_reliable(players[index].peer_id, "msg2 ;"+this.msg+";", 0);
if(this.xp>0) ganhaxp(players[index].charname, this.xp);
if(this.health>0&&players[index].health<players[index].saludfangelical){
players[index].health+=this.health;
players[index].maxhealth+=this.health;
}
players[index].nsede+=this.thirst;
players[index].nurina+=this.fill_thirst;
if(players[index].nurina>=100)players[index].nurina=100;
players[index].nfome+=this.hunger;
players[index].ncoco+=this.fill_hunger;
if(players[index].ncoco>=100)players[index].ncoco=100;
if(this.degradation>0&&this.degradation<100){
players[index].manage_degradation(this.name, this.degradation);
}
if(this.items_to_give!="none"&&this.items_to_give_player.length()>0){
for(int x=0; x<this.items_to_give_player.length(); x++){
string[] data=string_split(this.items_to_give_player[x], ".", false);
if(data.length()>1){
string itemname=data[0];
double cantity=string_to_number(data[1]);
players[index].inv_add_item(itemname, cantity);
}
}
}
}
}
void create_item(string name, string items_to_give, string audio, string msg, string map, int newx, int newy, double xp, double health, double thirst, double fill_thirst, double hunger, double fill_hunger, double degradation){
item_in_inv i(name, items_to_give, audio, msg, map, newx, newy, xp, health, thirst, fill_thirst, hunger, fill_hunger, degradation);
item_in_invs.insert_last(i);
}
void save_items(){
file f;
string final;
for(int x=0; x<item_in_invs.length(); x++){
final+=item_in_invs[x].name+"="+item_in_invs[x].items_to_give+"="+item_in_invs[x].audio+"="+item_in_invs[x].msg+"="+item_in_invs[x].map+"="+item_in_invs[x].newx+"="+item_in_invs[x].newy+"="+item_in_invs[x].xp+"="+item_in_invs[x].health+"="+item_in_invs[x].thirst+"="+item_in_invs[x].fill_thirst+"="+item_in_invs[x].hunger+"="+item_in_invs[x].fill_hunger+"="+item_in_invs[x].degradation+"\r\n";
}
f.open("items.db", "w");
f.write(final);
f.close();
}
void load_items(){
file f;
string[] lines;
item_in_invs.resize(0);
f.open("items.db", "r");
lines=delinear(f.read());
f.close();
for(int x=0; x<lines.length(); x++){
string[] data=string_split(lines[x], "=", false);
if(data.length()>13) create_item(data[0], data[1], data[2], data[3], data[4], string_to_number(data[5]), string_to_number(data[6]), string_to_number(data[7]), string_to_number(data[8]), string_to_number(data[9]), string_to_number(data[10]), string_to_number(data[11]), string_to_number(data[12]), string_to_number(data[13]));
}
}
