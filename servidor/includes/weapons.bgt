weapon@[] weapons;
class weapon{
string sound_shoot, sound_shoot_dist, name, ammo, sound_impact, sound_impact_on_corpse;
double damage, distance, ammo_cantity, ammo_total, degradation_point;
int is_dropable;
string[] sounds_impact, sounds_impact_on_corpse;
weapon(string name2, string ammo2, string sound_shoot2, string sound_impact2, double damage2, double distance2, double ammo_cantity2, int is_dropable2, string sound_impact_on_corpse2, string sound_shoot_dist2, double ammo_total2, double degradation_point){
this.name=name2;
this.ammo=ammo2;
this.sound_shoot=sound_shoot2;
this.sound_impact=sound_impact2;
this.sounds_impact=string_split(this.sound_impact, ",", true);
this.damage=damage2;
this.distance=distance2;
this.ammo_cantity=ammo_cantity2;
this.is_dropable=is_dropable2;
this.sound_impact_on_corpse=sound_impact_on_corpse2;
this.sounds_impact_on_corpse=string_split(this.sound_impact_on_corpse, ",", false);
this.sound_shoot_dist=sound_shoot_dist2;
this.ammo_total=ammo_total2;
this.degradation_point=degradation_point;
}
void shoot(int index, int my_index, int facing){
double damage_wp=this.damage;
if(players[index].pacifico==0&&players[index].paralisado==false&&players[index].paralisado2==false&&players[index].afk==false){
if(players[index].caverna==1) damage_wp=this.damage*3;
else if(players[index].amethyst==1) damage_wp=this.damage*6;
if(this.is_dropable==1){
if(players[index].inv_item_number(this.name)<1){
return;
}
else{
players[index].inv_add_item(this.name, -this.ammo_cantity);
}
}
spawn_bullet(damage_wp, this.distance, players[index].x, players[index].y, facing, players[index].charname, my_index+1, players[index].map, 1, random(1, 7), "");
}
}
}
void create_weapon(string name, string ammo, string sound_shoot, string sound_impact, double damage, double distance, double ammo_cantity, int is_dropable, string sound_impact_on_corpse, string sound_shoot_dist, double ammo_total, double degradation_point){
weapon w(name, ammo, sound_shoot, sound_impact, damage, distance, ammo_cantity, is_dropable, sound_impact_on_corpse, sound_shoot_dist, ammo_total, degradation_point);
weapons.insert_last(w);
}
void load_weapons(){
weapons.resize(0);
file f;
string final;
string[] lines;
if(!file_exists("weapons.db")){
return;
}
else{
f.open("weapons.db", "r");
final=f.read();
f.close();
if(final==""){
return;
}
else{
lines=delinear(final);
for(int x=0; x<lines.length(); x++){
string[] data=string_split(lines[x], "=", false);
create_weapon(data[0], data[1], data[2], data[3], string_to_number(data[6]), string_to_number(data[7]), string_to_number(data[9]), string_to_number(data[15]), data[16], data[21], string_to_number(data[8]), string_to_number(data[22]));
}
}
}
}
void send_weapons(int index, bool resize=false){
if(resize==true){
send_reliable(players[index].peer_id, "reset_weapons", 0);
}
file f;
string final;
string[] lines;
if(!file_exists("weapons.db")){
return;
}
else{
f.open("weapons.db", "r");
final=f.read();
f.close();
if(final==""){
return;
}
else{
string content;
lines=delinear(final);
for(int x=0; x<lines.length(); x++){
string[] data=string_split(lines[x], "=", false);
content+=data[10]+" "+data[11]+" "+data[12]+" "+data[8]+" "+data[9]+" "+data[13]+" "+data[14]+" "+data[4]+" "+data[5]+" "+data[1]+" "+data[0]+" "+data[17]+" "+data[18]+" "+data[19]+" "+data[20]+" "+data[2]+"\r\n";
}
send_reliable(players[index].peer_id, "create_weapon "+content, 0);
}
}
}
int get_weapon_index(string name){
for(int x=0; x<weapons.length(); x++){
if(weapons[x].name==name) return x;
}
return -1;
}
