tts_voice tts;
int found_reader;

bool speak(string text, bool interrupt=true)
{
int found_reader =auto_select_screen_reader();
if(found_reader ==0)
{
if(interrupt)
tts.speak_interrupt(text);
else
tts.speak(text);
}
if(interrupt)
screen_reader_speak_interrupt(found_reader, text);
else
screen_reader_speak(found_reader, text);
return true;
}

void dlg(string message, bool interrupt)
{
speak(message, interrupt);
while(true)
{
wait(5);
if (key_pressed(KEY_LEFT) || key_pressed(KEY_RIGHT) || key_pressed(KEY_UP) || key_pressed(KEY_DOWN))
{
speak(message, interrupt);
}
if(key_pressed(KEY_C)) clipboard_copy_text(message);
if (key_pressed(KEY_RETURN) || key_pressed(KEY_ESCAPE)||key_pressed(KEY_SPACE))
{
break;
}
}
}

int auto_select_screen_reader()
{
for(int x=1; x<5; x++)
{
if(screen_reader_is_running(x))
{
return x;
}
}
return 0;
}
