void cmd_setkills(int index, string args) {
	if (!players[index].is_admin()) {
		send_reliable(players[index].peer_id, "msg2 ;Você não tem permissão para usar este comando.;", 0);
		return;
	}
	
	string[] parsed = string_split(args, " ", true);
	if (parsed.length() < 2) {
		send_reliable(players[index].peer_id, "msg2 ;Uso: /setkills [jogador] [quantidade];", 0);
		return;
	}
	
	string player_name = parsed[0];
	int kill_count;
	
	try {
		kill_count = string_to_number(parsed[1]);
	} catch(exception) {
		send_reliable(players[index].peer_id, "msg2 ;A quantidade deve ser um número válido.;", 0);
		return;
	}
	
	int target_index = get_player_index_from(player_name);
	if (target_index < 0) {
		send_reliable(players[index].peer_id, "msg2 ;Jogador não encontrado.;", 0);
		return;
	}
	
	players[target_index].kills = kill_count;
	settitle(target_index); // Atualiza o título baseado no novo valor
	
	send_reliable(players[index].peer_id, "msg2 ;Contagem de monstros mortos de " + player_name + " atualizada para " + kill_count + ".;", 0);
	eadm(players[index].charname + " definiu a contagem de monstros mortos de " + player_name + " para " + kill_count, "notify.ogg", 100);
}
