file f;
int find;
string name;
void main(){
name=input_box("", "escribe el nombre del administrador al que quieres añadir a los comandos.");
if(directory_exists("players/"+name)){
string[]a=find_files("commands/*.txt");
for(int x=0; x<a.length(); x++){
f.open("commands/"+a[x], "r");
string[]b=string_split(f.read(), "\r\n", false);
f.close();
find=b.find(name);
if(find<0){
f.open("commands/"+a[x], "a");
f.write(name+"\r\n");
f.close();
}
}
alert("", "listo.");
}
}
