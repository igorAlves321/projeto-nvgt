		for(int x=0; x<players.length(); x++){
			players[x].payment=0;
		}
	}
	if(DATE_WEEKDAY_NAME=="Sunday"&&TIME_HOUR==0&&TIME_MINUTE==0&&TIME_SECOND==0&&tevento.elapsed>=1900){
		tevento.restart();
		send_reliable(0,"ps notify.ogg",0);
		send_reliable(0, "msgnormal se han detectado reportes de asesinatos en el castillo seelfer. los directivos informan que necesitan apoyo para controlar estos eventos desafortunados. vamos, se podría obtener una gran recompensa si se auxilia a estos seres!", 0);
	}
	if(enable_auto_arena==1&&ar.is_open==0){
		ar.init();
	}
	if(enable_auto_xp==1){
		if(players.length()>=25){
			if(doublexp==0){
				doublexp=1;
				send_reliable(0,"ps notify_blip2.ogg",0);
				send_reliable(0, "msgnormal  DoubleXP ativado. Aproveite enquanto há tempo!", 0);
			}
		}
		if(players.length()<25){
			if(doublexp==1){
				doublexp=0;
				send_reliable(0,"ps notify_blip2.ogg",0);
				send_reliable(0, "msgnormal DoubleXP desativado. Em breve tem mais!", 0);
			}
		}
		if(players.length()>=50){
			if(xpespecial==0){
				xpespecial=1;
				send_reliable(0,"ps notify_blip2.ogg",0);
				send_reliable(0, "msgnormal MegaXP ativado. Aproveite enquanto há tempo!", 0);
			}
		}
		if(players.length()<50){
			if(xpespecial==1){
				xpespecial=0;
				send_reliable(0,"ps notify_blip2.ogg",0);
				send_reliable(0, "msgnormal MegaXP desativado. Em breve tem mais!", 0);
			}
		}
	}
	if(tpresentes.elapsed>=900000){
		tpresentes.restart();
		file f;
		f.open("presentes.txt", "r");
		string presentes=f.read();
		f.close();
		string[] parsed=string_split(presentes, "\r\n", false);
		string item=parsed[random(0, parsed.length()-1)];
		int cantidad=random(30, 100);
		for(uint i=0; i<players.length(); i++){
			players[i].inv_add_item(item, cantidad, true, false);
			send_reliable(players[i].peer_id, "ps menuvolta.ogg", 0);
			send_reliable(players[i].peer_id, "msg2 "+cantidad+" ;"+item+";", 0);
		}
	}
	if(prision.elapsed>=60000){
		prision.restart();
		for(int i=0; i<players.length(); i++){
			int x=get_player_index_from(players[i].charname);
			if(x>-1){
				if(players[x].map=="prisão2"){
					string[] items=players[x].inv.get_keys();
					double value;
					int itemindex=random(0, items.length()-1);
					if(itemindex>-1){
						players[x].inv.get(items[itemindex], value);
						if(value>1){
							double value_amount=random(1, value);
							if(value_amount>0){
								players[x].inv_add_item(items[itemindex], -value_amount);
								send_reliable(players[x].peer_id, "msg2 ;perdiste; "+value_amount+" ;"+items[itemindex]+"; ;por un castigo celestial.;", 0);
							}
						}
					}
				}
			}
		}
	}
	if(divulgar.elapsed>=600000){
		divulgar.restart();
		file f;
		f.open("msgsserver.txt", "r");
		string[] msgs=delinear(f.read());
		f.close();
		int frase=random(0,msgs.length()-1);
		for(int i=0; i<players.length; i++){
			if(players[i].avisaserver==1){
				send_reliable(players[i].peer_id,"msg2 "+msgs[frase],0);
				send_reliable(players[i].peer_id,"ps notifybleeps.ogg",0);
			}
		}
	}
	if(tmaps.elapsed>=2*3600000){
		tmaps.restart();
