void loops(){
	while(true) {
		wait(5);
		netloop();
		outrosloop();
	if(key_pressed(KEY_ESCAPE)){
		writeprefs(true);
		for(uint i=0;i<players.length();i++){
			sconfigs(i);
		}
		//generate_profile("debug.log");
		exit();
	}
	if(key_pressed(KEY_V)) {
		uint[] connections =net.get_peer_list();
		string info ="Total jugadores conectados: "+players.length()+".\r\n";
		info +="Total conexiones incluyendo no autenticados: "+connections.length()+".\r\n";
		info +="Partes conectadas: \r\n"+linear(connections);
		clipboard_copy_text(info);
		connections.resize(0);
		info.resize(0);
	}
for(int i=0; i<server_maps.length(); i++) {
if(server_maps[i].paused==0) {
server_maps[i].maploop();
}
}
if(wedding==true)marriage_loop();
if(parabataying==true)parabatai_loop();
if(ar.is_open==1) ar.loop();
if(tempbans.length()>0) tempbanloop();
	if(tempocaiu.length()>0)caiuloop();
	if(misilavions.length()>0&&pvp)misilavionloop();
	if(players.length()>0){
		for(int i=0; i<players.length(); i++) {
			players[i].playerloop();
		}
	}
	if(picos.length()>0&&pvp)picoloop();
	if(jaulas.length()>0)jaulaloop();
	if(cachorromascotas.length()>0) {
		for(int i=0; i<cachorromascotas.length(); i++) {
			if(cachorromascotas[i].active==1) {
				cachorromascotas[i].cachorromascotaloop();
			}
		}
	}
}
}

bool have_acount(string id){
string compare=id;
string final;
string final2;
string final3;
file f;
string[] ids ();
ids=find_directories("players/*");
for(uint i=0; i<ids.length(); i++){
if(file_exists("players/"+ids[i]+"/compid.usr")){
f.open("players/"+ids[i]+"/compid.usr", "r");
final2+=ids[i]+":"+f.read()+"\r\n";
f.close();
}
}
string[] text=string_split(final2, "\r\n", false);
string[] text2;
for(uint i2=0; i2<text.length(); i2++){
text2=string_split(text[i2], ":", false);
if(compare==text2[1]){
final+=text2[1]+"\r\n";
}
}
string[] test3=delinear(final);
if(test3.length()>1){
return true;
}
return false;
}

bool directory_copy(string name, string name2, bool replace){
if(directory_exists(name)==false){
return false;
}
else{
if(directory_exists(name2)==false)directory_create(name2);
string[] f=find_files(name+"/*");
for(uint i=0; i<f.length(); i++){
file_copy(name+"/"+f[i], name2+"/"+f[i], replace);
}
return true;
}
}
int get_gift_index(int id){
for(int x=0; x<regalos.length(); x++){
string[] data=string_split(regalos[x], "=", false);
double gift_id=string_to_number(data[data.length()-1]);
if(gift_id==id){
return x;
}
}
return -1;
}
double manage_langs_version(string lang){
string lang2=string_to_lower_case(lang);
if(lang2=="spanish"){
double old_v=lang_es_v;
lang_es_v+=0.1;
return old_v+0.1;
}
if(lang2=="english"){
double old_v=lang_en_v;
lang_en_v+=0.1;
return old_v+0.1;
}
if(lang2=="french"){
double old_v=lang_fr_v;
lang_fr_v+=0.1;
return old_v+0.1;
}
if(lang2=="portuguese"){
double old_v=lang_pt_v;
lang_pt_v+=0.1;
return old_v+0.1;
}
return -1;
}
