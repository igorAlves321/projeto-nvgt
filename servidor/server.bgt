		semleilao2=0;
	}
	if (auctiontimer2.elapsed>=auction2time and auction2==true){
		if (auctionbidder2==false){
			send_reliable(0, "msgleilãoterminado2 "+auctionwho3, 0);
			auction2=false;
			auctionitem2="";
			auctionbidder2=false;
			auctionamount2=0;
			auctionbid2=0;
			auctionwho3="";
			auctionwho4="";
		}
		else{
			int index1=get_player_index_from(auctionwho3);
			int index2=get_player_index_from(auctionwho4);
			if (index1==-1 or index2==-1){
				send_reliable(0,"msgumoumaisjogadoresdessavenda", 0);
				semleilao2=1;
				tempoleilao2.restart();
				auction2=false;
				auctionitem2="";
				auctionbidder2=false;
				auctionamount2=0;
				auctionbid2=0;
				auctionwho3="";
				auctionwho4="";
			}
			else{
				if (players[index1].inv_item_number(auctionitem2)<auctionamount2){
					auction2=false;
					auctionitem2="";
					auctionbidder2=false;
					auctionamount2=0;
					auctionbid2=0;
					auctionwho3="";
					auctionwho4="";
					send_reliable(0,"msgleilãonãoépermitido", 0);				}				else if(players[index2].inv_item_number("euro")<auctionbid2){
					auction2=false;
					auctionitem2="";
					auctionbidder2=false;
					auctionamount2=0;
					auctionbid2=0;
					auctionwho3="";
					auctionwho4="";
					send_reliable(0, "msgeurofaltandoparaoleilao", 0);
				}
				else{
					players[index2].inv_add_item("euro", 0-auctionbid2);
					players[index2].inv_add_item(auctionitem2, auctionamount2);
					players[index1].inv_add_item(auctionitem2, 0-auctionamount2);
					players[index1].inv_add_item("euro", auctionbid2);
					if(players[index1].inv_item_number(auctionitem2)==0) retirar(index1, auctionitem2);
					save_transfer(players[index1].charname, players[index2].charname, auctionitem2, "mediante subasta por valor de"+" "+auctionbid2+" "+"euros", auctionamount2);
					auction2=false;
					auctionitem2="";
					auctionbidder2=false;
					auctionamount2=0;
					auctionbid2=0;
					auctionwho3="";
					auctionwho4="";
					send_reliable(0,"ps auctionwon.ogg",0);
					send_reliable(0,"msgleilaoconcluido "+players[index2].charname,0);
					semleilao2=1;
					tempoleilao2.restart();
				}
			}
		}
	}
	if(tempoleilao.elapsed>numeroleilao&&semleilao==1){
		semleilao=0;
	}
	if (auctiontimer.elapsed>=auctiontime and auction==true){
		if (auctionbidder==false){
			send_reliable(0,"msgleilãoterminado "+auctionwho,0);
			auction=false;
			auctionitem="";
			auctionbidder=false;
			auctionamount=0;
			auctionbid=0;
			auctionwho="";
			auctionwho2="";
		}
		else{
			int index1=get_player_index_from(auctionwho);
			int index2=get_player_index_from(auctionwho2);
			if (index1==-1 or index2==-1){
				send_reliable(0,"msgumoumaisjogadoresdessavenda", 0);
				semleilao=1;
				tempoleilao.restart();
				auction=false;
				auctionitem="";
				auctionbidder=false;
				auctionamount=0;
				auctionbid=0;
				auctionwho="";
				auctionwho2="";
			}
			else{
				if (players[index1].inv_item_number(auctionitem)<auctionamount){
					auction=false;
					auctionitem="";
					auctionbidder=false;
					auctionamount=0;
					auctionbid=0;
					auctionwho="";
					auctionwho2="";
					send_reliable(0,"msgleilãonãoépermitido", 0);
				}				else if(players[index2].inv_item_number("reais")<auctionbid){
					auction=false;
					auctionitem="";
					auctionbidder=false;
					auctionamount=0;
					auctionbid=0;
					auctionwho="";
					auctionwho2="";
					send_reliable(0, "msgreaisFaltandoparaoleilão", 0);
				}
				else{
					players[index2].inv_add_item("reais",0-auctionbid);
					players[index2].inv_add_item(auctionitem, auctionamount);
					players[index1].inv_add_item(auctionitem, 0-auctionamount);
					players[index1].inv_add_item("reais", auctionbid);
					if(players[index1].inv_item_number(auctionitem)==0) retirar(index1, auctionitem);
					save_transfer(players[index1].charname, players[index2].charname, auctionitem, "mediante subasta por valor de"+" "+auctionbid+" "+"reais", auctionamount);
					auction=false;
					auctionitem="";
					auctionbidder=false;
					auctionamount=0;
					auctionbid=0;
					auctionwho="";
					auctionwho2="";
					send_reliable(0,"ps auctionwon.ogg",0);
					send_reliable(0,"msgleilaoconcluido "+players[index2].charname,0);
					semleilao=1;
					tempoleilao.restart();
				}
			}
		}
	}
	if(horatemporizador.elapsed > horatempo){
		horatemporizador.restart();
		minuto++;
		if(minuto>59){
			minuto=0;
			hora++;
			checarhora();
		}
		if(hora>23){
			hora=0;
			minuto=0;
			dia+=1;
		}
		if(dia>31){
			dia=1;
			mes+=1;
		}
		if(mes>12){
			mes=1;
			ano+=1;
		}
	}
	netloop();
}

// Si temporarily se define a true, se verifican y eliminan las cuentas temporalmente del directorio players y se deja una copia en players2. Si se pone a false, se verifican y se eliminan las cuentas que cumplan las condiciones en players2
void accounts_delete(bool temporarily=true) {
	string[] final, directories;
	string msg, path, path_save="players2";
	file f;
	int directories_deleted=0;
	if(temporarily) {
		path ="players";
	}
	else {
		path="players2";
	}
	directories =find_directories(path+"/*");
	for(int x=0; x<directories.length(); x++){
		if(file_exists(path+"/"+directories[x]+"/connected.usr")){
			calendar current_file;
			f.open(path+"/"+directories[x]+"/connected.usr", "r");
			string[] data=string_split(f.read(), ":", false);
			f.close();
			current_file.set(string_to_number(data[0]), string_to_number(data[1]), string_to_number(data[2]), string_to_number(data[3]), string_to_number(data[4]), string_to_number(data[5]));
			double diff=server_calendar.diff_months(current_file);
			if(diff>=6 && temporarily){
				directory_copy(path+"/"+directories[x], path_save+"/"+directories[x], true);
				add_connection_file(path_save+"/"+directories[x]+"/connected.usr");
				directory_delete(path+"/"+directories[x]);
				directories_deleted++;
				final.insert_last(directories[x]);
			}
			if(diff>=1 && !temporarily){
				directory_delete(path+"/"+directories[x]);
				directories_deleted++;
				final.insert_last(directories[x]);
			}
		}
	}
	if(directories_deleted>0){
		for(int x=0; x<final.length(); x++){
			if(final.length()>1 && x<final.length()-1) msg+=final[x]+", ";
			else if(final.length()>1 && x==final.length()-1) msg+="y "+final[x]+".";
			else msg =final[x]+".";
		}
		if(temporarily) {
			if(directories_deleted>1) eadm("Se eliminaron las siguientes "+directories_deleted+" cuentas temporalmente por falta de actividad: "+msg, "notify7.ogg", 150, true);
			else eadm("Se eliminó la siguiente cuenta temporalmente por falta de actividad: "+msg, "notify7.ogg", 150, true);
		}
		else {
			if(directories_deleted>1) eadm("Se eliminaron las siguientes "+directories_deleted+" cuentas de forma definitiva: "+msg, "notify7.ogg", 150, true);
			else eadm("Se eliminó la siguiente cuenta de forma definitiva: "+msg, "notify7.ogg", 150, true);
		}
	}
}

// recibe un nombre de usuario, busca en cada ruta de directorio de usuario, sea principal, o de cuentas eliminadas. Retorna: 1 si encontró el nombre en principal, 2 si lo enconró en el directorio de usuarios eliminados, o 0 si no se encontró.
int get_accounts(string playername) {
	string[] accounts, accounts2;
	accounts =find_directories("players/*");
	int encontered =accounts.find(playername);
	if(encontered>-1) {
		return 1;
	}
	accounts.resize(0);
	accounts2 =find_directories("players2/*");
	encontered =accounts2.find(playername);
	if(encontered>-1) {
		return 2;
	}
	return 0;
}

// Recibe una ruta y nombre de archivo, para añadir la fecha y hora de conexión de una cuenta.
void add_connection_file(string filename) {
	file f;
	f.open(filename, "w");
	f.write(DATE_YEAR+":"+DATE_MONTH+":"+DATE_DAY+":"+TIME_HOUR+":"+TIME_MINUTE+":"+TIME_SECOND);
	f.close();
}

void usar(int index, string nitem){
	if(is_disabled(nitem, players[index].map)){
	return;
	}
	double gift_id;
	if(string_contains(nitem, "caja_de_regalo_", 1)>-1){
		string[] data=string_split(nitem, "_", false);
		gift_id=string_to_number(data[data.length()-1]);
	}
	int gindex=get_gift_index(gift_id);
	if(gindex>-1){
		string[] data=string_split(regalos[gindex], "=", false);
		if(data.length()>1){
			string[] items=string_split(data[1], ",", false);
			for(int x=0; x<items.length(); x++){
				string[] cantity=string_split(items[x], ":", false);
				if(cantity.length()>1) players[index].inv_add_item(cantity[0], string_to_number(cantity[1]));
			}
			players[index].inv_add_item("caja_de_regalo_"+gift_id, -1);
			send_packet(0, "play acaixa.ogg", players[index].x, players[index].y, players[index].mapindex);
			regalos.remove_at(gindex);
			save_gifts();
		}
	}
	for(int x=0; x<clothes.length(); x++){
		if(nitem==clothes[x].name){
			int success=clothes[x].put(index);
			if(success==0){
				send_reliable(players[index].peer_id, "msg2 ;ya tienes puesta esta prenda.;", 0);
			}
			else if(success==1){
				send_reliable(players[index].peer_id, "msg2 ;No es recomendable que vistas muchas prendas en un mismo sitio.;", 0);
			}
			else{
				send_packet(0, "play "+clothes[x].sound_draw+".ogg", players[index].x, players[index].y, players[index].mapindex);
			}
		}
	}
	for(int x=0; x<item_in_invs.length(); x++){
		if(item_in_invs[x].name==nitem&&players[index].inv_item_number(nitem)>0){
			item_in_invs[x].use(index);
		}
	}
		if(nitem =="bomba_de_plasma" && players[index].inv_item_number(nitem)>0) {
			spawn_plasma_bomb(players[index].charname, players[index].x, players[index].y, players[index].map);
		}
		if(nitem=="mina"&&players[index].inv_item_number("mina")>0&&players[index].minatimer.elapsed>players[index].minaplacetime){
			if(minaativa==true){
				spawnmine(index, players[index].x, players[index].y, players[index].charname, players[index].map);
				players[index].minatimer.restart();
			}
			else send_reliable(players[index].peer_id, "msgnormal lo sentimos, pero las minas no están permitidas actualmente.", 0);
		}
	else if(nitem=="caja_especial_con_moño_dorado"){
		players[index].inv_add_item(players[index].charname+"_de_peluche", 1);
		players[index].inv_add_item("caja_especial_con_moño_dorado", -1);
		send_reliable(players[index].peer_id, "msg2 ;de forma mágica e inexplicable, junto a ti se materializa un perfecto clon tuyo, para luego encogerse y convertirse en un pequeño peluche muy adorable.;", 0);
		send_packet(0, "play notify_applause.ogg "+players[index].x+" "+players[index].y, players[index].map);
	}
	else if(nitem=="pergamino_sanguinolento"&&players[index].inv_item_number("pergamino_sanguinolento")>0){
		if(players[index].map!="jaula_del_cachorro_de_"+players[index].charname){
			send_reliable(players[index].peer_id, "msg2 ;Es recomendable no invocar al cachorrito aquí.;", 0);
		}
		else if(players[index].cantidadcachorros>0){
			send_reliable(players[index].peer_id, "msg2 ;No puedes hacer esto.;", 0);
		}
		else if(players[index].map=="jaula_del_cachorro_de_"+players[index].charname){
			send_reliable(players[index].peer_id, "mtext ;Nombra a tu cachorrito.;|name_puppy| |0", 0);
		}
	}
	else if(nitem=="paquete_de_comida_para_perros"&&players[index].inv_item_number("paquete_de_comida_para_perros")>0){
		for(uint i=0; i<cachorromascotas.length(); i++){
			if(cachorromascotas[i].dueno==players[index].charname&&cachorromascotas[i].comida==true){
				cachorromascotas[i].tnecesidad.force(0);
				cachorromascotas[i].tnecesidad2.force(0);
				players[index].inv_add_item("paquete_de_comida_para_perros", -1);
				ganhaxp(players[index].charname, random(3000000, 5000000));
				send_reliable(players[index].peer_id, "msg2 ;Alimentas a tu cachorrito. ¡Parece contento!;", 0);
				gc(players[index].charname, random(1, 3));
				cachorromascotas[i].comida=false;
				cachorromascotas[i].vida+=random(2000, 6000);
				break;
			}
			else if(cachorromascotas[i].dueno==players[index].charname&&cachorromascotas[i].comida==false){
				send_reliable(players[index].peer_id, "msg2 ;Parece que aún no es tiempo de hacer esto.;", 0);
			}
		}
	}
	else if(nitem=="jaula_para_el_perro"){
		install_jaula(players[index].x, players[index].y, players[index].map, players[index].charname, 100000000);
	}
	else if(nitem=="Sobre_circular_dorado"&&players[index].inv_item_number("Sobre_circular_dorado")>0){
		players[index].inv_add_item("Sobre_circular_dorado", -1, true);
		gc(players[index].charname, 1);
	}
	else if(nitem=="bebida_luminosa"&&players[index].inv_item_number("bebida_luminosa")>0){
		if(players[index].amethyst==1) players[index].amethyst=0;
		if(players[index].caverna==1) {
			send_reliable(players[index].peer_id, "msg2 ;Ya tienes esta poción haciendo efecto en ti...;", 0);
			return;
		}
		players[index].inv_add_item("bebida_luminosa", -1);
		send_reliable(players[index].peer_id, "msgnormal Sientes una fuerza divina que aumenta tu fuerza de una manera inimaginable!", 0);
		if(players[index].caverna==0)players[index].ncaverna=1;
		players[index].tcaverna.restart();
		players[index].caverna=1;
		send_packet10(0, players[index].charname, players[index].charname, "poção.ogg "+players[index].x+" "+players[index].y, players[index].map);
	}
	else if(nitem=="poción_angelical"&&players[index].inv_item_number("poción_angelical")>0){
		if(players[index].needs_madness==1) return;
		players[index].inv_add_item("poción_angelical", -1);
		players[index].tangelical.restart();
		send_packet10(0, players[index].charname, players[index].charname, "juegotomapocion.ogg "+players[index].x+" "+players[index].y, players[index].map);
	}
	else if(nitem=="poción_blanca"&&players[index].inv_item_number("poción_blanca")>0&&players[index].needs_madness==0){
		server_maps[players[index].mapindex].send_packet(0, "play magicpotion.ogg", players[index].x, players[index].y);
		players[index].needs_madness=1;
		players[index].tangelical.restart();
		send_reliable(players[index].peer_id, "msg2 ;Sientes que poco a poco tu tranquilidad mental vuelve...;", 0);
		players[index].inv_add_item("poción_blanca", -1);
	}
	else if(nitem=="polvo_de_energía"&&players[index].inv_item_number("polvo_de_energía")>=10){
		if(players[index].have_island==0) return;
		else if(players[index].payment==0) return;
		else if(players[index].map=="isla_privada_de_"+players[index].charname) return;
		int mapindex=get_map_index_from("isla_privada_de_"+players[index].charname);
		server_maps[players[index].mapindex].send_packet(0, "play ma213.ogg", players[index].x, players[index].y);
		changemap("isla_privada_de_"+players[index].charname, index, 5, 5);
		if(mapindex>-1) server_maps[mapindex].send_packet(0, "play ma213.ogg", 5, 0);
		players[index].inv_add_item("polvo_de_energía", -10);
	}
	else if(nitem=="poción_antiminas"&&players[index].inv_item_number("poción_antiminas")>0){
		if(players[index].antimina==1) {
			send_reliable(players[index].peer_id, "msg2 ;Ya tienes esta poción haciendo efecto en ti...;", 0);
			return;
		}
		players[index].inv_add_item("poción_antiminas", -1);
		send_reliable(players[index].peer_id, "msgnormal de un momento a otro, sientes una protección impresionante al tomar esta poción...", 0);
		players[index].antimina=1;
		players[index].tantimina.restart();
		send_packet10(0, players[index].charname, players[index].charname, "tomandomagia3.ogg "+players[index].x+" "+players[index].y, players[index].map);
	}
	else if(nitem=="poción_antimeteoros"&&players[index].inv_item_number("poción_antimeteoros")>0){
		if(players[index].ameteoro==1) {
			send_reliable(players[index].peer_id, "msg2 ;Ya tienes esta poción haciendo efecto en ti...;", 0);
			return;
		}
		players[index].inv_add_item("poción_antimeteoros", -1);
		send_reliable(players[index].peer_id, "msgnormal de un momento a otro, sientes algo mágico al tomar esta poción...", 0);
		players[index].ameteoro=1;
		players[index].tameteoro.restart();
		send_packet10(0, players[index].charname, players[index].charname, "tomandomagia6.ogg "+players[index].x+" "+players[index].y, players[index].map);
	}
	else if(nitem=="poción_vital"&&players[index].inv_item_number("poción_vital")>0){
		int salud=random(10000, 25000);
		players[index].maxhealth+=salud;
		players[index].health+=salud;
		send_packet10(0, players[index].charname, players[index].charname, "tomandomagia5.ogg "+players[index].x+" "+players[index].y, players[index].map);
		send_reliable(players[index].peer_id, "msg2 al tomar esta poción, sientes una gran energía que fluye por tus venas!", 0);
		players[index].inv_add_item("poción_vital", -1);
	}
	else if(nitem=="poción_del_trueno"&&players[index].inv_item_number("poción_del_trueno")>0){
		if(players[index].trueno==1) {
			send_reliable(players[index].peer_id, "msg2 ;Ya tienes esta poción haciendo efecto en ti...;", 0);
			return;
		}
		players[index].inv_add_item("poción_del_trueno", -1);
		send_reliable(players[index].peer_id, "msgnormal sientes la energía de las tormentas inundar todo tu cuerpo.", 0);
		send_reliable(players[index].peer_id,"aveloz",0);
		players[index].tmveloz2.restart();
		players[index].trueno=1;
		send_packet10(0, players[index].charname, players[index].charname, "tomandomagia2.ogg "+players[index].x+" "+players[index].y, players[index].map);
	}
	else if(nitem=="poción_de_amatista"){
		if(players[index].caverna==1) players[index].caverna=0;
		if(players[index].amethyst==1) {
			send_reliable(players[index].peer_id, "msg2 ;Ya tienes esta poción haciendo efecto en ti...;", 0);
			return;
		}
		server_maps[players[index].mapindex].send_packet(0, "play tomandomagia8.ogg", players[index].x, players[index].y);
		players[index].amethyst=1;
		players[index].tamethyst.restart();
		players[index].inv_add_item("poción_de_amatista", -1);
	}
	else if(nitem=="poción_protectora"&&players[index].inv_item_number("poción_protectora")>0){
		if(players[index].protegido==1) {
			send_reliable(players[index].peer_id, "msg2 ;Ya tienes esta poción haciendo efecto en ti...;", 0);
			return;
		}
		players[index].inv_add_item("poción_protectora", -1);
		send_reliable(players[index].peer_id, "msgnormal sientes un aura protectora que te aleja del peligro.", 0);
		players[index].protegido=1;
		players[index].tprotegido.restart();
		send_packet10(0, players[index].charname, players[index].charname, "tomandomagia4.ogg "+players[index].x+" "+players[index].y, players[index].map);
	}
	else if(nitem=="iratce"&&players[index].inv_item_number("iratce")>0){
		int vida=50000;
		if(players[index].map=="mausoleo_infernal"){
			send_reliable(players[index].peer_id, "msgnormal oh, vaya. esta runa no funciona aquí. al parecer la energía demoníaca que hay en este lugar es tan grande que evita que el iratce funcione.", 0);
			return;
		}
		if(players[index].maxhealth==players[index].saludfangelical){
			return;
		}
		players[index].maxhealth+=vida;
		players[index].health+=vida;
		players[index].inv_add_item("iratce", -1, true, false);
		players[index].inv_add_item("iratce_gastado", 1, true, false);
		send_packet10(0, players[index].charname, players[index].charname, "fire2.ogg "+players[index].x+" "+players[index].y, players[index].map);
	}
	else if(nitem=="runa_dorada"&&players[index].inv_item_number("runa_dorada")>0){
		int index1=get_player_index_from(players[index].whomarried);
		if(index1<0){
			send_reliable(players[index].peer_id, "msg2 no puedes hacer esto por un motivo mágico e inexplicable.", 0);
			return;
		}
		if(index1>-1){
			if(is_disabled("runa_dorada", players[index1].map)||is_game_disabled(players[index1].x, players[index1].y, players[index1].map)){
				send_reliable(players[index].peer_id, "msg2 ;no puedes hacer esto, algo lo impide.;", 0);
				return;
			}
			else if(players[index1].whomarried==players[index].charname){
				changemap(players[index1].map, index,players[index1].x,players[index1].y, "moveu.ogg");
				send_packet(0,"upl "+players[index].peer_id+" "+players[index].x+" "        +players[index].y+" "+players[index].map,players[index].map);
				telllocal(index, "Hola, cielo.");
				send_packet(0, "play deviant.ogg "+players[index].x+" "+players[index].y+" "+players[index].map, players[index].map);
			}
		}
	}
	else if(nitem=="r2"){
		string horastring;
		if (hora==0&&minuto==0)
		horastring="Meia noite em ponto";
		if(hora==0&&minuto>0)
		horastring="0 horas e ";
		if (hora==1&&minuto==0)
		horastring="Uma hora em ponto";
		if(hora==1&&minuto>0)
		horastring="uma hora e ";
		if (hora==2&&minuto==0)
		horastring="Duas horas em ponto";
		if(hora==2&&minuto>0)
		horastring="duas horas e ";
		if (hora>2&&minuto==0)
		horastring=hora+" horas em ponto";
		if(hora>2&&minuto>0)
		horastring=hora+" horas e ";
		if (minuto==1)
		horastring+="um minuto";
		if (minuto>1)
		horastring+=minuto+" minutos";
		if(players[index].relogio==1){
			send_packet(0,"play relogio.ogg "+players[index].x+" "+players[index].y,players[index].map);
			send_reliable(event.peer_id,"msgrelogio "+horastring+".", 0);
		}
	}
	else if(nitem=="teleportador"){
		if(players[index].is_admin()==true){
			string[] a=find_files("maps/*.map");
			string m;
			for(uint i=0;i<a.length();i++){
				if(i<a.length()&&string_contains(a[i], "mansión_de_", 1)<0) m+=a[i]+"\r\n";
			else if(i==a.length()-1) m+=a[i];
			}
			send_reliable(players[index].peer_id, "mtester "+m, 0);
		}
		else{
			send_unreliable(players[index].peer_id, "msgnormal Intentando utilizar un item divino?", 0);
		}
	}
	else if(nitem=="teletransportador"){
		if(players[index].is_builder()==true){
			string[] a=find_files("maps/*.map");
			string m;
			for(uint i=0;i<a.length();i++){
				if(i<a.length()) m+=a[i]+"\r\n";
				else if(i==a.length()-1) m+=a[i];
			}
			send_reliable(players[index].peer_id, "mtester "+m, 0);
		}
		else{
			send_unreliable(players[index].peer_id, "msgnormal Intentando utilizar un item de constructor?", 0);
		}
	}
	else if(nitem=="tlp_beta"){
		if(beta==true){
			string[] a=find_files("maps/*.map");
			string m;
			for(uint i=0;i<a.length();i++){
				if(i<a.length()&&string_contains(a[i], "mansión_de_", 1)<0) m+=a[i]+"\r\n";
				else if(i==a.length()-1) m+=a[i];
			}
			send_reliable(players[index].peer_id, "mtester "+m, 0);
		}
		else{
			return;
		}
	}
	else if(nitem=="vidrio_roto"&&players[index].inv_item_number("vidrio_roto")>0){
		if(players[index].map!="arena"||players[index].map!="área_preparativa"){
			players[index].health-=round(players[index].saludfangelical/6, 0);
			send_packet(0,"play sangra.ogg "+players[index].x+" "+players[index].y,players[index].map);
			send_packet(0,"inithurt "+players[index].voice+" "+players[index].x+" "+players[index].y, players[index].map);
			players[index].lasthit="vidrio";
		}
	}
	else if(nitem=="vitalidad_perpetua" && players[index].inv_item_number(nitem)>0) {
		if(players[index].healthfixed==0) {
			players[index].healthfixed=1;
			players[index].tvitalidad.restart();
			players[index].vitalidad_time=43200*60;			// Mantemos a saúde máxima baseada apenas no nível, não na fase angelical
			// Na inicialização do jogador, a saúde base é definida
			players[index].inv_add_item(nitem, -1);
			send_reliable(players[index].peer_id, "msg2 ;Sientes como un impulso de vida invade todo tu cuerpo.;", 0);
			server_maps[players[index].mapindex].send_packet(0, "play tomandomagia3.ogg", players[index].x, players[index].y);
			return;
		}
		else {
			if(players[index].healthfixed>0 && players[index].healthfixed<12) {
				players[index].tvitalidad.restart();
				players[index].healthfixed+=1;
				players[index].vitalidad_time+=43200*60;
				players[index].inv_add_item(nitem, -1);
				send_reliable(players[index].peer_id, "msg2 ;Sientes como un impulso de vida invade todo tu cuerpo.;", 0);
				server_maps[players[index].mapindex].send_packet(0, "play tomandomagia3.ogg", players[index].x, players[index].y);
			}
			else {
				send_reliable(players[index].peer_id, "msg2 ;Una fuerza mágica te inpide hacer esto...;", 0);
			}
		}
	}
	else if(string_contains(nitem, "libro", 1)>-1 || string_contains(nitem, "folleto", 1)>-1) {
		readbook(index, nitem);
	}
}

void retirar(int index, string nitem, bool notify=true)  {
	for(int x=0; x<clothes.length(); x++){
		if(nitem==clothes[x].name&&string_contains(nitem, "tatuaje", 1)<0){
			int find;
			int success=clothes[x].remove(index);
			if(success==0){
				if(notify)send_reliable(players[index].peer_id, "msg2 ;No tienes puesta esta prenda, ¿por qué habrías de querer quitártela?;", 0);
				//return;
			}
			else{
				send_packet(0, "play "+clothes[x].sound_remove+".ogg", players[index].x, players[index].y, players[index].mapindex);
			}
		}
	}
}

void terminar(int index, int notify=0, int save =0, bool down=false){
	if(!down) {
		net.disconnect_peer_softly(players[index].peer_id);
	}
	if(ar.is_open==1){
		ar.remove_player_from(index);
	}
	players[index].inv_add_item("pergamino_de_fuego", -players[index].inv_item_number("pergamino_de_fuego"));
	players[index].inv_add_item("pluma_de_diamante", -players[index].inv_item_number("pluma_de_diamante"));
	if(down) {
		send_reliable(0, "off "+players[index].charname+" "+notify+" 1", 0);
	}
	else {
		send_reliable(0, "off "+players[index].charname+" "+notify+" 0", 0);
	}
	if(players[index].starsoundid>-1) server_maps[players[index].mapindex].destroy_moving_sound(players[index].starsoundid);
	if(players[index].tfid>-1)server_maps[players[index].mapindex].destroy_moving_sound(players[index].tfid);
	if(players[index].watching==1){
		if(players[index].is_admin()) eadm(players[index].charname+" dejó de observar a; "+players[index].w_name+".", "notifi10.ogg");
		stop_watch(index);
	}
	if(players[index].watcher_list.length()>0){
		for(int x=0; x<players[index].watcher_list.length(); x++){
			int index2=get_player_index_from(players[index].watcher_list[x]);
			if(index2>-1){
				if(players[index2].is_admin()) eadm(players[index2].charname+" dejó de observar a; "+players[index2].w_name+".", "notifi10.ogg");
			stop_watch(index2);
			}
		}
	}
	if(players[index].bipar==0)players[index].bipar=1;
	if(players[index].vmap!=""){
		players[index].map=players[index].vmap;
		players[index].x=players[index].vx;
		players[index].y=players[index].vy;
		players[index].bipar=players[index].vbipar;
players[index].invs=players[index].vinvs;
	}
	if(save==1)sconfigs(index);
	int cachorro_index =get_cachorro_index(players[index].charname);
	if(cachorro_index>-1) cachorromascotas[cachorro_index].owner_is_online=0;
	remove_player(index);
	update_cachorros_indexes();
	update_general_indexes();
}
void frasesbarra(int index, int nsom, string nsom2){
	server_maps[players[index].mapindex].send_to_others(players[index].peer_id, 0, "play "+nsom2, players[index].x, players[index].y, 20, false);
}
void enter(int index){
	string map=players[index].map;
	string[] p1;
	int mapindex=get_map_index_from(map);
	if(mapindex>-1) p1=server_maps[mapindex].mapdata;
	else{
		send_reliable(players[index].peer_id, "msg2 ;este mapa tiene alguna falla o es inexistente, favor de contactar con los arcángeles.;", 0);
		return;
	}
	for(uint i=0; i<p1.length(); i++){
		string[] parsed=string_split(p1[i], ":", true);
		if(parsed[0]=="cpm" and parsed.length()>11){
			if(players[index].maptraveltimer.elapsed<3000&&players[index].watching==0||players[index].paralisado==true||players[index].paralisado2==true)return;
			int minx=string_to_number(parsed[1]);
			int maxx=string_to_number(parsed[2]);
			int miny=string_to_number(parsed[3]);
			int maxy=string_to_number(parsed[4]);
			int newx=string_to_number(parsed[5]);
			int newy=string_to_number(parsed[6]);
			string newmap=parsed[7];
			string text=parsed[8];
			string audiomapa=parsed[9];
			double time=string_to_number(parsed[10]);
			string text2=parsed[11];
			string newsound=parsed[12];
			string[] tmpout;
			if(minx<=players[index].x and maxx>=players[index].x and miny<=players[index].y and maxy>=players[index].y){
				if(string_contains(text, "*g*", 1)>-1) text=string_replace(text, "*g*", players[index].sexo2, true);
				if(string_contains(text, "*nick*", 1)>-1) text=string_replace(text, "*nick*", players[index].charname, true);
				if(string_contains(text2, "*g*", 1)>-1) text2=string_replace(text2, "*g*", players[index].sexo2, true);
				if(string_contains(text2, "*nick*", 1)>-1) text2=string_replace(text2, "*nick*", players[index].charname, true);
				players[index].tcongelar.restart();
				players[index].tasfixiar.restart();
				send_reliable(players[index].peer_id, "stopmoving", 0);
				send_packet(0, "play "+audiomapa+".ogg", players[index].x, players[index].y, players[index].mapindex);
				send_reliable(players[index].peer_id, "msgtravelpoint "+text, 0);
				players[index].premapa=newmap;
				players[index].presound=newsound;
				players[index].pretext=text2;
				players[index].prex=newx;
				players[index].prey=newy;
				players[index].changing=1;
				players[index].pretime=time;
				players[index].tmaquina.restart();
			}
		}
		if(parsed[0]=="pm2" and parsed.length()>13){
			if(players[index].maptraveltimer.elapsed<3000 && players[index].watching==0||players[index].paralisado==true||players[index].paralisado2==true)return;
			int minx=string_to_number(parsed[1]);
			int maxx=string_to_number(parsed[2]);
			int miny=string_to_number(parsed[3]);
			int maxy=string_to_number(parsed[4]);
			int newx=string_to_number(parsed[5]);
			int newy=string_to_number(parsed[6]);
			string newmap=parsed[7];
			string newmap2=parsed[7];
			string audiomapa=parsed[8];
			string itemrequerido=parsed[9];
			int cantrequerida=string_to_number(parsed[10]);
			string text=parsed[11];
			string itemdado=parsed[12];
			int cantdado=string_to_number(parsed[13]);
			string text2=parsed[14];
			string var_line="";
			bool can_pass, can_pass2;
			if(parsed.length>15) var_line=parsed[15];
			if(minx<=players[index].x and maxx>=players[index].x and miny<=players[index].y and maxy>=players[index].y){
				if(string_contains(text, "*g*", 1)>-1) text=string_replace(text, "*g*", players[index].sexo2, true);
				if(string_contains(text, "*nick*", 1)>-1) text=string_replace(text, "*nick*", players[index].charname, true);
				if(string_contains(text2, "*g*", 1)>-1) text2=string_replace(text2, "*g*", players[index].sexo2, true);
				if(string_contains(text2, "*nick*", 1)>-1) text2=string_replace(text2, "*nick*", players[index].charname, true);
				if(string_contains(newmap, "isla_privada_de_", 1)>-1){
					string name=string_replace(newmap, "isla_privada_de_", "", true);
					int index2=get_player_index_from(name);
					if(index2>-1){
						if(players[index2].payment==0){
							send_reliable(players[index].peer_id, "msg2 ;la reja de entrada a esta isla tiene una barrera mágica la cuál al intentar atravezarla con tu mano hace que se graben algunas letras en tu retina: Clausurada temporalmente por falta de pago.;", 0);
							return;
						}
					}
					else if(index2<0){
						int pay;
						if(!file_exists("players/"+name+"/configs.ini")) return;
						else{
							file f;
							f.open("players/"+name+"/configs.ini", "rb");
							dictionary@ sd=deserialize(f.read());
							f.close();
							if(sd.exists("payment")){
								sd.get("payment", pay);
							}
							if(pay==0){
								send_reliable(players[index].peer_id, "msg2 ;la reja de entrada a esta isla tiene una barrera mágica la cuál al intentar atravezarla con tu mano hace que se graben algunas letras en tu retina: Clausurada temporalmente por falta de pago.;", 0);
								return;
							}
						}
					}
				}
				if(players[index].maptraveltimer.elapsed>700){
					players[index].maptraveltimer.restart();
					if(var_line!=""){
						string[] content=string_split(var_line, ",", false);
						for(int x=0; x<content.length(); x++){
							string[] data=string_split(content[x], "|", false);
							if(data[0]=="var"&&data.length()>4){
								bool success=players[index].v_m.manage(data[1], data[2], data[3], string_to_bool(data[4]));
								if(!success){
									can_pass2=false;
								}
								else{
									can_pass2=true;
									if(data[2]=="-=" && data[2]=="+=") save_transfer("sistema", players[index].charname, data[1], "mediante variable en el mapa "+players[index].map, string_to_number(data[3]));
								}
							}
						}
					}
					if(itemrequerido!="none"){
						if(players[index].inv_item_number(itemrequerido)>=cantrequerida){
							can_pass=true;
						}
						else {
							can_pass =false;
						}
					}
					else {
						can_pass =true;
					}
					if(!can_pass2 && parsed.length()==15) can_pass2=true;
					if(!can_pass || !can_pass2){
						send_reliable(players[index].peer_id, "msgnormal "+text, 0);
						return;
					}
					else if(can_pass && can_pass2){
						changemap(newmap, index,newx,newy);
						send_packet(0, "play "+audiomapa+".ogg", players[index].x, players[index].y, players[index].mapindex);
						send_reliable(players[index].peer_id, "msgtravelpoint "+text2, 0);
						if(itemdado=="celestiums"){
							gc(players[index].charname, cantdado);
							save_transfer("sistema", players[index].charname, "celestiums", "mediante pm2 en el mapa "+players[index].map, cantdado);
						}
						else{
							if(cantdado!=0) {
								players[index].inv_add_item(itemdado, cantdado);
								save_transfer("sistema", players[index].charname, itemdado, "mediante pm2 en el mapa "+players[index].map, cantdado);
							}
						}
					}
					if(parsed.length()<=16){
						players[index].inv_add_item(itemrequerido, -cantrequerida);
					}
				}
			}
		}
		else if(parsed[0]=="pm" and parsed.length()>10){
			if(players[index].maptraveltimer.elapsed<300&&players[index].watching==0||players[index].paralisado==true||players[index].paralisado2==true)return;
			int minx=string_to_number(parsed[1]);
			int maxx=string_to_number(parsed[2]);
			int miny=string_to_number(parsed[3]);
			int maxy=string_to_number(parsed[4]);
			int newx=string_to_number(parsed[5]);
			int newy=string_to_number(parsed[6]);
			string newmap=parsed[7];
			string newmap2=parsed[7];
			string text=parsed[8];
			string audiomapa=parsed[9];
			string item=parsed[10];
			double cantidad=string_to_number(parsed[11]);
			double required=0;
			if(parsed.length()>12) required=string_to_number(parsed[12]);
			if(minx<=players[index].x and maxx>=players[index].x and miny<=players[index].y and maxy>=players[index].y){
				if(string_contains(text, "*g*", 1)>-1) text=string_replace(text, "*g*", players[index].sexo2, true);
				if(string_contains(text, "*nick*", 1)>-1) text=string_replace(text, "*nick*", players[index].charname, true);
				if(players[index].maptraveltimer.elapsed>700){
					players[index].maptraveltimer.restart();
					if(required>0&&players[index].inv_item_number(item)>=required){
						return;
					}
					changemap(newmap, index,newx,newy, audiomapa);
					send_packet(0, "play "+audiomapa+".ogg", players[index].x, players[index].y, players[index].mapindex);
					send_reliable(players[index].peer_id, "msgtravelpoint "+text, 0);
					if(item=="celestiums"){
						gc(players[index].charname, cantidad);
					}
					else{
						players[index].inv_add_item(item, cantidad);
					}
				}
			}
		}
		else if(parsed[0]=="newymap"&&parsed.length()>6){
			int minx=string_to_number(parsed[1]);
			int maxx=string_to_number(parsed[2]);
			int miny=string_to_number(parsed[3]);
			int maxy=string_to_number(parsed[4]);
			int newx=string_to_number(parsed[5]);
			int newy=string_to_number(parsed[6]);
			string newmap=parsed[7];
			string text=parsed[8];
			if(minx<=players[index].x&&maxx>=players[index].x&&miny<=players[index].y&&maxy>=players[index].y){
				if(string_contains(text, "*g*", 1)>-1) text=string_replace(text, "*g*", players[index].sexo2, true);
				if(string_contains(text, "*nick*", 1)>-1) text=string_replace(text, "*nick*", players[index].charname, true);
				if(newmap=="default"){
					changemap(players[index].mapavoltar, index,newx,newy);
					send_reliable(players[index].peer_id, "msgtravelpoint "+text, 0);
				}
				else if(newmap==players[index].mapavoltar){
					changemap(newmap, index,newx,newy);
					send_reliable(players[index].peer_id, "msgtravelpoint "+text, 0);
				}
			}
		}
		else if(parsed[0]=="tp"&&parsed.length()>8){
			int mapindex=get_map_index_from(players[index].map);
			if(players[index].maptraveltimer.elapsed<3000&&players[index].watching==0||players[index].paralisado==true||players[index].paralisado2==true)return;
			if(players[index].afking==true)return;
			int minx=string_to_number(parsed[1]);
			int maxx=string_to_number(parsed[2]);
			int miny=string_to_number(parsed[3]);
			int maxy=string_to_number(parsed[4]);
			int newx=string_to_number(parsed[5]);
			int newy=string_to_number(parsed[6]);
			string newmap=parsed[7];
			string newmap2=parsed[7];
			string text=parsed[8];
			string sec="";
			if(parsed.length>9) sec=parsed[9];
			string[] tmpout;
			if(minx<=players[index].x&&maxx>=players[index].x&&miny<=players[index].y&&maxy>=players[index].y){
				if(string_contains(text, "*g*", 1)>-1) text=string_replace(text, "*g*", players[index].sexo2, true);
				if(string_contains(text, "*nick*", 1)>-1) text=string_replace(text, "*nick*", players[index].charname, true);
				if(players[index].maptraveltimer.elapsed>700){
					players[index].tcongelar.restart();
					players[index].tasfixiar.restart();
					players[index].jaandou=0;
					players[index].javoou=0;
					if(string_contains(newmap,"portal_espiritual",1)>-1){
						if(players[index].mapavoltar=="sala_del_juicio")players[index].mapavoltar="camino_hogar";
						if(players[index].mapavoltar=="tumba_en_llamas")players[index].mapavoltar="mausoleo_infernal";
						else if(string_contains(players[index].mapavoltar, "quadro", 1)>-1)players[index].mapavoltar="zona_de_segurança";
						newmap=players[index].mapavoltar;
						if(string_contains(newmap, "trem_andando", 1)>-1)newmap="trem";
						if(string_contains(newmap, "avião_alto", 1)>-1)newmap="avião";
						newx=xmorrer;newy=ymorrer;
						if(newmap==players[index].mapavoltar)newy=0;
						if(newmap=="desierto")newy=11;
						if(newmap=="edificio_recreativo")newy=21;
						if(newmap=="camino_solitario")newy=250;
						if(newmap=="mar_profundo")newy=160;
						if(newmap=="mausoleo_infernal")newy=350;
						if(newmap=="ciudad_tornair")newy=100;
						else if(newmap=="ElCieloDeEstrellita")newy=10;
						else if(newmap=="ElCieloDeEstrellita")newx=501;
					}
					if(newmap=="playa"){
						if(DATE_WEEKDAY_NAME!="Saturday"){
							send_reliable(players[index].peer_id, "msgnormal hay un letrero que dice: isla en intento de control. monstruo potencialmente mortal.", 0);
							send_reliable(players[index].peer_id, "ps door17open.ogg", 0);
							return;
						}
					}
					else if(string_contains(newmap,"saldelanave",1)>-1){
						if(players[index].aterrizaje==0){
							send_reliable(players[index].peer_id, "msgnormal Am...No creo que quieras salir al vacío del espacio, y mucho menos a esta velocidad. Así que por tu bien, quédate dentro.", 0);
							return;
						}
						else{
							newmap=players[index].destino4;
							players[index].aterrizaje=0;
						}
					}
					else if(string_contains(newmap,"nuevodestino1",1)>-1){
						if(players[index].nave1==0){
							send_reliable(players[index].peer_id, "msgnormal Espera a que llegues a tu destino!", 0);
							return;
						}
						else{
							newmap=players[index].destino5;
							players[index].nave1=0;
						}
					}
					else if(string_contains(newmap,"nuevodestino2",1)>-1){
						if(players[index].capsulaestrellasapagadas==0){
							send_reliable(players[index].peer_id, "msgnormal Espera a que llegues a tu destino!", 0);
							return;
						}
						else{
							newmap=players[index].destino6;
							players[index].capsulaestrellasapagadas=0;
						}
					}
					else if(string_contains(newmap,"nuevodestino3",1)>-1){
						if(players[index].naveturisticascorpion==0){
							send_reliable(players[index].peer_id, "msgnormal Espera a que llegues a tu destino!", 0);
							return;
						}
						else{
							newmap=players[index].destino13;
							players[index].naveturisticascorpion=0;
						}
					}
					if(newmap=="salidajaula"){
						for(uint i=0; i<jaulas.length(); i++){
							if(jaulas[i].dueno==players[index].charname){
								changemap(jaulas[i].map, index, jaulas[i].x, jaulas[i].y);
							}
						}
						newmap="aeroports";
						newmap2="naotemmapa";
					}
					if(newmap!="aeroports"){
						players[index].maptraveltimer.restart();
						changemap(newmap, index,newx,newy);
					}
					if(newmap2!="naotemmapa"||newmap!="aeroporto"&&newmap2!="naotemmapa"||newmap!="aeroports"&&newmap2=="naotemmapa")send_reliable(players[index].peer_id, "msgtravelpoint "+text, 0);
					if(newmap=="cápsula_interestelar")players[index].tmaquina.restart();
					if(newmap=="nave_1")players[index].tmaquina.restart();
					if(newmap=="cápsula_estrellas_a|pagadas")players[index].tmaquina.restart();
					if(newmap=="nave_turística_scorpion")players[index].tmaquina.restart();
				}
			}
		}
		else if(parsed[0]=="ptm" and parsed.length()>8){
			if(players[index].maptraveltimer.elapsed<3000&&players[index].watching==0||players[index].paralisado==true||players[index].paralisado2==true)return;
			int minx=string_to_number(parsed[1]);
			int maxx=string_to_number(parsed[2]);
			int miny=string_to_number(parsed[3]);
			int maxy=string_to_number(parsed[4]);
			int newx=string_to_number(parsed[5]);
			int newy=string_to_number(parsed[6]);
			string newmap=parsed[7];
			string newmap2=parsed[7];
			string text=parsed[8];
			string audiomapa=parsed[9];
			string sec="";
			if(parsed.length>10) sec=parsed[10];
			string[] tmpout;
			if(minx<=players[index].x and maxx>=players[index].x and miny<=players[index].y and maxy>=players[index].y){
				if(string_contains(text, "*g*", 1)>-1) text=string_replace(text, "*g*", players[index].sexo2, true);
				if(string_contains(text, "*nick*", 1)>-1) text=string_replace(text, "*nick*", players[index].charname, true);
				players[index].tcongelar.restart();
				players[index].tasfixiar.restart();
				if(players[index].maptraveltimer.elapsed>700){
					if(newmap=="castillo_seelfer"&&players[index].map!="oficina_principal_seelfer"){
						if(DATE_WEEKDAY_NAME!="Sunday"){
							send_reliable(players[index].peer_id, "msgnormal Las puertas del castillo están cerradas con candado por dentro.", 0);
							send_reliable(players[index].peer_id, "ps door17open.ogg", 0);
							return;
						}
					}
					players[index].maptraveltimer.restart();
					players[index].jaandou=0;
					players[index].javoou=0;
					if(newmap!="aeroports") changemap(newmap, index,newx,newy, audiomapa);
					if(newmap=="aeroports") send_packet(0, "play "+audiomapa+".ogg", players[index].x, players[index].y, players[index].mapindex);
					if(newmap2!="naotemmapa"||newmap!="aeroporto"&&newmap2!="naotemmapa"||newmap!="aeroports"&&newmap2=="naotemmapa")send_reliable(players[index].peer_id, "msgtravelpoint "+text, 0);
				}
			}
		}
	}
}

void subir_nivel(int index) {
    int niveles_subidos = 0;
    if(index <=-1)
        return;

    // Simplificamos a experiência necessária para subir de nível
    players[index].xprequerida = players[index].level*100;

    while(players[index].xp>=players[index].xprequerida){
        netloop();
        double restante = players[index].xp-players[index].xprequerida;
        niveles_subidos++;
        players[index].xp=restante;
        players[index].level+=1;

        // Verifica se o jogador atingiu um múltiplo de 10 níveis
        if (players[index].level % 10 == 0) {
            // Adiciona 10 de saúde a cada 10 níveis
            players[index].maxhealth += 10;
            players[index].health += 10;
            send_reliable(players[index].peer_id, "msgnormal Você ganhou 10 pontos de saúde por atingir o nível "+players[index].level+"!", 0);
        }
        players[index].xprequerida = players[index].level*100;
    }

    // setamos el título del jugador.
    settitle(index);

    // ¿Tenemos que avisar subidas de nivel?
    if(niveles_subidos==0)
        return;

    // Avisamos sobre subidas de nível
    for(int x=0; x<players.length(); x++){
        if(players[x].avisanivel==1){
            send_reliable(players[x].peer_id, "ps notifi22.ogg", 0);
            if(niveles_subidos == 1)                send_reliable(players[x].peer_id, "msg2 "+players[index].charname+" ;subió un nivel, alcanzando así el nivel; "+players[index].level+".", 0);
            else
                send_reliable(players[x].peer_id, "msg2 "+players[index].charname+" ;subió; "+niveles_subidos+" ;niveles alcanzando así el nivel; "+players[index].level+".", 0);
        }
    }
}
void ganhaxp(string name, double xp, int moedas=0){
int index=get_player_index_from(name);
if(index<=-1)
return;
double xp_total=xp;
players[index].xp+=xp_total;
if(players[index].avisaxp==1) send_reliable(players[index].peer_id, "msg2 ;has ganado; "+xp_total+" ;xp.;", 0);
if(doublexp==1){
xp_total=xp;
players[index].xp+=xp_total;
if(players[index].avisaxp==1) send_reliable(players[index].peer_id, "msg2 ;has ganado; "+xp_total+" ;xp por la xp doble.;", 0);
}
if(players[index].bendicion){
xp_total=xp;
players[index].xp+=xp_total;
if(players[index].avisaxp==1) send_reliable(players[index].peer_id, "msg2 ;has ganado; "+xp_total+" ;xp por la bendición de diamantes.;", 0);
}
if(xpespecial==1){
xp_total=xp*6;
players[index].xp+=xp_total;
if(players[index].avisaxp==1) send_reliable(players[index].peer_id, "msg2 ;has ganado; "+xp_total+" ;xp por la xp especial.;", 0);
}
ganhaxpequipo(index, xp);
subir_nivel(index);
}

void ganhaxpequipo(int index, double xp){
	double xp_total=xp;
	for(int i=0; i<players[index].nomesequipe.length(); i++){
		if(players[index].nomesequipe[i] != players[index].charname){
			int index2=get_player_index_from(players[index].nomesequipe[i]);
			if(index2>-1) {
				if(!players[index2].afk){
					players[index2].xp+=xp_total;
					if(players[index2].avisaxp==1) send_reliable(players[index2].peer_id, "msg2 ;has ganado; "+xp_total+" ;xp.;", 0);
					if(doublexp==1){
						xp_total=xp;
						players[index2].xp+=xp_total;
						if(players[index2].avisaxp==1) send_reliable(players[index2].peer_id, "msg2 ;has ganado; "+xp_total+" ;xp por la xp doble.;", 0);
					}
					if(xpespecial==1){
						xp_total=xp*6;
						players[index2].xp+=xp_total;
						if(players[index2].avisaxp==1) send_reliable(players[index2].peer_id, "msg2 ;has ganado; "+xp_total+" ;xp por la xp especial.;", 0);
					}
					subir_nivel(index2);
				}
			}
		}
	}
}

void gc(string name, double celestiums){
	int zz=get_player_index_from(name);
	if(zz>-1){
players[zz].celestiums+=celestiums;
send_reliable(players[zz].peer_id, "msg2 has ganado "+celestiums+" celestiums.", 0);
}
}
void ge(string name, double esmeraldas){
	int index=get_player_index_from(name);
	if(index>-1){
		players[index].esmeraldas+=esmeraldas;
		send_reliable(players[index].peer_id, "msg2 Has obtenido "+esmeraldas+" esmeraldas por tu compra!", 0);
		send_reliable(players[index].peer_id, "ps notify8.ogg", 0);
	}
	if(gold==1) give_presents(name);
}

bool tjogador(string nome){
	for(uint i=0;i<players.length();i++){
		if(players[i].map==nome)return true;
	}
	return false;
}
void dar_euro(string nome, int euro, bool pacifico=true){
	int zz=get_player_index_from(nome);
	if(zz>-1){
		int r=0;
		for(uint i=0;i<players[zz].nomesequipe.length();i++){
			int z=get_player_index_from(players[zz].nomesequipe[i]);
			if(z>-1){
				if(players[z].pacifico==0&&players[z].afk==false||players[z].afk==false&&pacifico)r+=1;
			}
		}
		if(r==0)return;
		int total=(euro/r);
		for(uint i=0;i<players[zz].nomesequipe.length();i++){
			int z=get_player_index_from(players[zz].nomesequipe[i]);			if(z>-1){				if(players[z].pacifico==0&&players[z].afk==false||players[z].afk==false&&pacifico){
					players[z].inv_add_item("euro", total);
					if(gold==1){
						z=get_player_index_from(players[zz].nomesequipe[i]);
						if(z>-1){
							players[z].inv_add_item("euro", total);
							send_reliable(players[z].peer_id, "msgvocêganhamais "+total, 0);
						}
					}
				}
			}
		}
	}
}

string horareloj(){
		string horastring;
		if (hora==0&&minuto==0)
		horastring="Meia noite em ponto";
		if(hora==0&&minuto>0)
		horastring="0 horas e ";
		if (hora==1&&minuto==0)
		horastring="Uma hora em ponto";
		if(hora==1&&minuto>0)
		horastring="uma hora e ";
		if (hora==2&&minuto==0)
		horastring="Duas horas em ponto";
		if(hora==2&&minuto>0)
		horastring="duas horas e ";
		if (hora>2&&minuto==0)
		horastring=hora+" horas em ponto";
		if(hora>2&&minuto>0)
		horastring=hora+" horas e ";
		if (minuto==1)
		horastring+="um minuto";
		if (minuto>1)
		horastring+=minuto+" minutos";
return horastring;
}
void rebootfast() {
	writeprefs(true);
	send_reliable(0, "reiniciar", 0);
	net.disconnect_peer_softly(0);
	wait(500);
	if(SCRIPT_COMPILED==false){
		run(SCRIPT_EXECUTABLE, SCRIPT_CURRENT_FILE, false, false);
		exit();
	}
	else{
		run(SCRIPT_EXECUTABLE, "", false, false);
		exit();
	}
}
void reboot10(){
	send_reliable(0,"ps moveu.ogg",0);
	send_reliable(0, "msgnormal Atención, el servidor será reiniciado. Los clientes serán desconectados y reiniciados en 6 segundos.", 0);
	writeprefs(true);
	wait(5000);
	send_reliable(0, "reiniciar", 0);
	wait(1000);
	if(SCRIPT_COMPILED==false){
		run(SCRIPT_EXECUTABLE, SCRIPT_CURRENT_FILE, false, false);
		exit();
	}
	else{
		run(SCRIPT_EXECUTABLE, "", false, false);
		exit();
	}
}
