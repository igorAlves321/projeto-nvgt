void load_npcs(){
if(!file_exists("npcs.db")) return;
file f;
f.open("npcs.db", "r");
string[] lines=delinear(f.read());
f.close();
for(int i=0; i<lines.length(); i++){
string[] data=string_split(lines[i], "=", false);
if(data.length()>3){
int mapindex=get_map_index_from(data[3]), x=string_to_number(data[1]), y=string_to_number(data[2]);
double health=string_to_number(data[0]);
if(mapindex>-1){
int npcindex=server_maps[mapindex].get_npc_index(x, y);
if(npcindex>-1){
server_maps[mapindex].npcs[npcindex].vida=health;
}
}
}
}
}
void load_all_descs(){
file f;
f.open("servidor.descs", "r");
desc=delinear(f.read());
f.close();
}

void load_secondary_inventory() {
	file secondary_inv;
	string secondary_inventory_file_name ="secondary_inventory.txt";
	string[] inv_content;
	if(file_exists(secondary_inventory_file_name)) {
		secondary_inv.open(secondary_inventory_file_name, "r");
		inv_content =delinear(secondary_inv.read());
		secondary_inv.close();
		if(inv_content.length()>0) {
			secondary_inventory =inv_content;
		}
	}
	else {
		secondary_inv.open(secondary_inventory_file_name, "w");
		secondary_inv.write("celular\r\n");
		secondary_inv.close();
		load_secondary_inventory();
	}
}

bool string_to_bool(string word){
if(word=="true"){
return true;
}
if(word=="false"){
return false;
}
return false;
}
void telllocal(int index, string message){
antispam_manage(index);
if(players[index].naoitens==1){
send_reliable(players[index].peer_id, "msgestecanal", 0);
}
else if(players[index].afk&&players[index].is_admin()==false)return;
else{
for(int i=players[index].x-15;i<=players[index].x+15;i++){
for (uint i2=0;i2<players.length();i2++){
if (players[i2].x==i&&players[i2].map==players[index].map&&!players[i2].has_muted(players[index].charname)){
if(file_exists("players/"+players[index].charname+"/silencio.usr") || players[index].silenciado==1 || players[index].antispam==1){
send_reliable(players[index].peer_id, "msgnormal Por alguna razón, algo te impide hablar...", 0);
return;
}
string[] x = string_split(message, " ", true);
if(x[0] == "/me") {
x.remove_at(0);
string men = "";
for(int indice=0; indice<x.length(); indice++)
men += x[indice];
if(players[index].invs==1) send_reliable(players[i2].peer_id,"fm |"+players[index].title+"| |desconocid"+players[index].sexo2+" | "+men, 0);
else send_reliable(players[i2].peer_id,"fm |"+players[index].title+"| "+players[index].charname+"  "+men, 0);
}
else{
if(players[index].invs==1) send_reliable(players[i2].peer_id,"fm |"+players[index].title+"| |desconocid"+players[index].sexo2+" te sussurra:| "+message, 0);
else send_reliable(players[i2].peer_id,"fm |"+players[index].title+"| "+players[index].charname+" |diz:| "+message, 0);
}
if(message=="ven, sube."||message=="come on up."||message=="venha aqui."){
for(uint i=0; i<cachorromascotas.length(); i++){
if(cachorromascotas[i].dueno==players[index].charname){
if(cachorromascotas[i].map==players[index].map&&cachorromascotas[i].amarrado==0){
cachorromascotas[i].subido=true;
send_reliable(players[index].peer_id, "msg2 el cachorrito se acurruca en tus brazos.", 0);
}
}
}
}
else if(message=="vamos, baja."||message=="come on down."||message=="desça."){
for(uint i=0; i<cachorromascotas.length(); i++){
if(cachorromascotas[i].dueno==players[index].charname&&cachorromascotas[i].map==players[index].map){
cachorromascotas[i].subido=false;
send_reliable(players[index].peer_id, "msg2 el cachorrito se baja de ti y te sigue desde la distancia.", 0);
}
}
}
else if(message=="habemus sanctitas."&&players[index].eagle_invoked==0){
players[index].eagle_invoked=1;
server_maps[players[index].mapindex].send_packet(0, "play bot128.ogg", players[index].x, players[index].y);
send_reliable(players[index].peer_id, "msg2 ;con tu conjuro invocas a la majestuosa águila celestial, esperando que algún arcángel la envíe a tu llamado.;", 0);
players[index].teagle.restart();
}
}
}
}
}
}
void write_to(string name, string fn, string c){
	file f;
	f.open("players/"+name+"/"+fn, "w");
	f.write(c);
	f.close();
}

void write_transfer_log(string name, string fn, string text) {
	file log;
	log.open("players/"+name+"/"+fn, "a");
	log.write(text);
	log.close();
}

string pegartelhado(string mapa){
	file f;
	f.open("maps/"+mapa+".map", "r");
	string[] m=string_split(f.read(), "\r\n", false);
	for(uint i=0;i<m.length();i++){
		if(string_contains(m[i], "teto", 1)>-1){
			string[] mm=string_split(m[i], ":", false);
			return mm[1];
		}
	}
	return "rain4.ogg";
}
void save_npcs(){
string[] lines;
file f;
for(int x=0; x<server_maps.length(); x++){
if(server_maps[x].npcs.length()>0){
for(int y=0; y<server_maps[x].npcs.length(); y++){
if(server_maps[x].npcs[y].vidainicial>100000000&&server_maps[x].npcs[y].vida<server_maps[x].npcs[y].vidainicial){
lines.insert_last(server_maps[x].npcs[y].vida+"="+server_maps[x].npcs[y].x_inicial+"="+server_maps[x].npcs[y].y_inicial+"="+server_maps[x].name);
}
}
}
}
if(lines.length()==0&&file_exists("npcs.db")) file_delete("npcs.db");
if(lines.length()>0){
f.open("npcs.db", "w");
f.write(linear(lines));
f.close();
}
}

void writeprefs(bool complete=false){
	file pr;
	dictionary configs;
	configs.set("minuto", minuto);
	configs.set("hora", hora);
	configs.set("day", day);
	configs.set("month", month);
	configs.set("year", year);
	configs.set("timetime", timetime);
	configs.set("objtime", objtime);
	configs.set("peak", peak);
	configs.set("msalvar", msalvar);
	configs.set("islands", islands);
	configs.set("lang_es_v", lang_es_v);
	configs.set("lang_en_v", lang_en_v);
	configs.set("lang_fr_v", lang_fr_v);
	configs.set("lang_pt_v", lang_pt_v);
	configs.set("enable_auto_xp", enable_auto_xp);
	configs.set("enable_double_emeralds", enable_double_emeralds);
	configs.set("gold", gold);
	configs.set("enable_auto_raffle", enable_auto_raffle);
	configs.set("port", port);
	pr.open("servidor.configs", "wb");
	pr.write(serialize(configs));
	pr.close();
	if(complete) {
		for(int i=0; i<players.length(); i++) {
			sconfigs(i);
		}
		save_tempbans();
		salvarcachorromascotas();
		save_npcs();
		pr.open("servidor.msgadm", "w");
		pr.write(linear(msgadm));
		pr.close();
	}
}

void send_menu(int index, string title, string packet_to_send, int channel, string[] items, string[] sounds){
send_reliable(players[index].peer_id, "servermenu "+title+"|"+packet_to_send+"|"+channel+"|"+linear(items)+"|"+linear(sounds), 0);
}
void changemap(string map, int index, int x=1, int y=0, string audio="") {
	file f;
	string wtext;
	string[] mapsclient;
		int mapindex=get_map_index_from(map);
		if(mapindex<0){
			send_reliable(players[index].peer_id, "msg2 ;Oh, ¡Vaya! Parece que el mapa al que intentas ir tiene algunas fallas. Si reportas a los arcángeles se podrán solucionar lo antes posible; :)", 0);
			return;
		}
		else if(mapindex>-1){
			players[index].mapindex=mapindex;
			if(server_maps[mapindex].mapdata.length()==0){
				send_reliable(players[index].peer_id, "msg2 ;Oh, ¡Vaya! Parece que el mapa al que intentas ir tiene algunas fallas. Si reportas a los arcángeles se podrán solucionar lo antes posible; :)", 0);
				return;
			}
		}
	if (players[index].map==map) {
		players[index].move(get_tile_at(players[index].x, players[index].y, players[index].map), x, y, 1);
		if(players[index].invs==0&&audio!="") {
			send_packet(0, "play "+audio+".ogg", players[index].x, players[index].y, players[index].mapindex, 0);
			send_reliable(players[index].peer_id,"move "+players[index].x+" "+players[index].y,0);
			return;
		}
		else {
			send_reliable(players[index].peer_id,"move "+players[index].x+" "+players[index].y,0);
			return;
		}
	}
	send_reliable(players[index].peer_id, "set_map_players none", 6);
	if(!f.open("mapsclient.txt", "r"))return;
		mapsclient =string_split(f.read(), "\r\n", false);
		f.close();
		if(mapsclient.length()>0) {
			int encontered =mapsclient.find(map);
			if(encontered>-1) {
				wtext ="changemap local "+mapsclient[encontered]+" "+x+" "+y;
				remove_player(players[index].charname, players[index].map);
				players[index].map =map;
				insert_player(index, map);
				send_reliable(players[index].peer_id, wtext, 0);
				players[index].move(get_tile_at(players[index].x, players[index].y, players[index].map), x, y, 1);
			}
			else {
				remove_player(players[index].charname, players[index].map);
				players[index].map=map;
				insert_player(index, map);
				wtext =linear(server_maps[mapindex].mapdata);
				send_reliable(players[index].peer_id, "changemap "+wtext+"\r\nx:"+x+"\r\ny:"+y+"\r\n", 0);
				players[index].move(get_tile_at(players[index].x, players[index].y, players[index].map), x, y, 1);
			}
		}
		if(server_maps[mapindex].mapplayers.length()>0) send_players(index);
		if(players[index].map!="portal_espiritual"){
			players[index].mapavoltar=players[index].map;
		}
		if(players[index].watcher_list.length()>0){
			for(int x=0; x<players[index].watcher_list.length(); x++){
				int index2=get_player_index_from(players[index].watcher_list[x]);
				if(index2>-1){
					changemap(map, index2, x, y);
				}
			}
		}
		if(map=="cápsula_interestelar"){
			players[index].destino4="isla_de_rignie";
		}
		if(map=="nave_1"){
			players[index].destino5="ciudad_de_stalwalquer";
		}
		if(map=="cápsula_estrellas_apagadas"){
			players[index].destino6="estación_espacial";
		}
		if(map=="nave_turística_scorpion"){
			players[index].destino13="planeta_banjabábic";
		}
		if(map=="nave_scorpion") players[index].destino8="planeta_aquaphil";
		if(audio!=""){
			send_packet(0,"play "+audio+".ogg", players[index].x, players[index].y, players[index].mapindex, 0);
		}
		for(int x=0; x<server_maps[players[index].mapindex].msounds.length(); x++){
			 send_reliable(players[index].peer_id,"cm "+server_maps[players[index].mapindex].msounds[x].id+" "+server_maps[players[index].mapindex].msounds[x].soundloop+" "+server_maps[players[index].mapindex].msounds[x].x+" "+server_maps[players[index].mapindex].msounds[x].y+" "+server_maps[players[index].mapindex].msounds[x].map, 0);
		}
		if(is_disabled("baculo", map)){
			if(players[index].tminvs.elapsed>0){
			players[index].tminvs.force(0);
			players[index].tminvs.pause();
			players[index].cloaked=false;
			send_reliable(players[index].peer_id,"stopcloak",0);
			send_reliable(0,"playerbeep "+players[index].charname+" 1",0);
			players[index].bipar=1;
		}
		if(players[index].tmveloz.elapsed>0){
			send_reliable(players[index].peer_id,"dveloz",0);
			players[index].tmveloz.force(0);players[index].tmveloz.pause();
		}
		if(players[index].tmpulo.elapsed>0){
			send_reliable(players[index].peer_id,"superjumpoff",0);
			players[index].tmpulo.force(0);players[index].tmpulo.pause();
		}
	}
	if(players[index].map=="isla_abandonada"&&DATE_WEEKDAY_NAME!="Saturday"||players[index].map=="mar_profundo"&&DATE_WEEKDAY_NAME!="Saturday"||players[index].map=="playa"&&DATE_WEEKDAY_NAME!="Saturday"){
		changemap("ciudad_de_arduam", index, 1000, 100);
	}
	if(players[index].map=="castillo_seelfer"&&DATE_WEEKDAY_NAME!="Sunday"||players[index].map=="oficina_principal_seelfer"&&DATE_WEEKDAY_NAME!="Sunday"){
		changemap("reino_divino", index, 201, 60);
	}
	if(players[index].map=="cápsula_interestelar")players[index].tmaquina.restart();
	if(players[index].map=="nave_1")players[index].tmaquina.restart();
	if(players[index].map=="cápsula_estrellas_apagadas")players[index].tmaquina.restart();
	if(players[index].map=="cápsula_vieja")players[index].tmaquina.restart();
	if(players[index].map=="nave_scorpion")players[index].tmaquina.restart();
	if(players[index].map=="nave_turística_scorpion")players[index].tmaquina.restart();
	sconfigs(index);
}
void update(string map){
	int mapindex=get_map_index_from(map);
	if(mapindex>-1){
		for (uint i=0; i<server_maps[mapindex].mapplayers.length(); i++){
			string text=linear(server_maps[mapindex].mapdata);
			send_reliable(players[server_maps[mapindex].mapplayers[i]].peer_id, "changemap "+text+"\r\nx:"+players[server_maps[mapindex].mapplayers[i]].x+"\r\ny:"+players[server_maps[mapindex].mapplayers[i]].y+"\r\n", 0);
		}
	}
	}
void update2(string map){
	int mapindex=get_map_index_from(map);
	if(mapindex>-1){
		for (uint i=0; i<server_maps[mapindex].mapplayers.length(); i++){
			string text=linear(server_maps[mapindex].mapdata);
			send_reliable(players[server_maps[mapindex].mapplayers[i]].peer_id, "changemap2 "+text+"\r\nx:"+players[server_maps[mapindex].mapplayers[i]].x+"\r\ny:"+players[server_maps[mapindex].mapplayers[i]].y+"\r\n", 0);
		}
	}
	}

void send_packet(int channel, string packet, int x=0, int y=0, int mapindex=-1, int range =20) {
	if(mapindex>-1) {
		for (int i=0; i<server_maps[mapindex].mapplayers.length(); i++){
			if (get_distance(players[server_maps[mapindex].mapplayers[i]].x, x, players[server_maps[mapindex].mapplayers[i]].y, y)<=range) send_reliable(players[server_maps[mapindex].mapplayers[i]].peer_id, packet+" "+x+" "+y, channel);
		}
	}
}

void send_packet(int channel,string packet,string mapname){
	if(!tjogador(mapname)||mapname==mapainicial)return;
	string[] a=string_split(packet, " ", false);
	int x=0;
	for(uint i=0;i<a.length();i++){
		if(string_to_number(a[i])>0){
			x=string_to_number(a[i]);
			break;
		}
	}
	for (int i=x-20; i<=x+20; i++){
		for (uint ie4=0; ie4<players.length(); ie4++){
			if (players[ie4].x==i&&players[ie4].map==mapname) send_reliable(players[ie4].peer_id,packet,channel);
		}
	}
}

void send_packet_unreliable(int channel,int x, string packet,string mapname){
	for (int i=x-20; i<=x+20; i++){
		for (uint ie4=0; ie4<players.length(); ie4++){
			if(players[ie4].map==mapname&&players[ie4].x==i)send_unreliable(players[ie4].peer_id,packet,channel);
		}
	}
}

void send_packet3(int channel,string packet,string mapname){
	for (uint ie4=0; ie4<players.length(); ie4++){
		if (players[ie4].map==mapname) send_reliable(players[ie4].peer_id,packet,channel);
	}
}

void send_packetn(int channel,string nnome, string packet,string mapname){
	for (uint ie4=0; ie4<players.length(); ie4++){
		if (players[ie4].map==mapname&&players[ie4].charname!=nnome) send_reliable(players[ie4].peer_id,packet,channel);
	}
}

void send_packet10(uint canal, string jogador1, string jogador2, string pacote, string mapa){
	for(uint i=0;i<players.length();i++){
		if(players[i].map==mapa){
			if(players[i].charname==jogador1||players[i].charname==jogador2)send_reliable(players[i].peer_id, "ps "+pacote, 0);
			else if(players[i].charname!=jogador1&&players[i].charname!=jogador2)send_reliable(players[i].peer_id, "play "+pacote, 0);
		}
	}
}

string get_player_password(string playername){
	file passfile;
	passfile.open("players/"+playername+"/senha.usr","r");
	string ret=passfile.read();
	passfile.close();
	return ret;
}

string reset_player_password(string playername) {
	file passfile;
	string new_password =generate_key(8), pwh;
	if(new_password!="") {
		pwh =string_hash(new_password, 2, false);
		if(pwh!="") {
			passfile.open("players/"+playername+"/senha.usr","w");
			passfile.write(pwh);
			passfile.close();
		}
	}
	return new_password;
}

bool changepassword(string name, string newpassword){
	if(!file_exists("players/"+name+"/senha.usr")) return false;
	else{
		file f;
		bool ret;
		ret=f.open("players/"+name+"/senha.usr","w");
		if(!ret) return false;
		f.write(newpassword);
		f.close();
		return true;
	}
}

void change_password(string name, string oldpass, string newpass, uint id){
	if(oldpass==newpass){
		send_reliable(id,"msgnormal ;Las contraseñas son iguales, por favor escriba una contraseñadiferente.;", 0);
		return;
	}
	else if(get_player_password(name)!=oldpass){
		send_reliable(id,"msgnormal Erro: Senha atual errada.", 0);
		return;
	}
	else if(oldpass==get_player_password(name)){
		bool retthing=changepassword(name,newpass);
		if(!retthing)send_reliable(id,"msgnormal Não foi possível alterar sua senha.", 0);
		else {
			send_reliable(id, "pass_changed", 0);
			send_reliable(id, "msgnormal Sua senha foi alterada!", 0);
		}
	}
}
bool send_reliable(uint peerid, string packet, int channel){
	packet=string_encrypt(packet, NETWORK_ENCRYPTION_KEY);
	return net.send_reliable(peerid,packet,channel);
}
void send_reliablen(uint peerid, string nnome, string packet, int channel){
	for(uint i=0;i<players.length();i++){
		if(players[i].charname!=nnome)send_reliable(players[i].peer_id, packet,channel);
	}
}
string get_event_message(){
	return string_decrypt(event.message, NETWORK_ENCRYPTION_KEY);
}
bool contains_num(string str) {
	bool r=false;
	for(uint i=0; i<10; i++) {
		if (string_contains(str, ""+i, 1)!=-1) {
			r=true;
			break;
		}
	}
	return r;
}
bool contains_let(string str) {
	string l="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
	bool r=false;
	for(uint i=0; i<l.length(); i++) {
		if (string_contains(str, l[i], 1)!=-1) {
			r=true;
			break;
		}
	}
	return r;
}

string randomstring(uint length=5){
	string temp="abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	string ret;
	for(uint i=0; i<length; i++){
		ret=ret+temp[random(0,(temp.length()-1))];
	}
	return ret;
}

string generate_key(int size){
	string characters="abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
	string key;
	for(int i=0; i<size; i++){
		key+=characters[random(0, characters.length()-1)];
	}
	return key;
}
bool send_unreliable(uint peerid, string packet, int channel){
	packet=string_encrypt(packet, NETWORK_ENCRYPTION_KEY);
	return net.send_unreliable(peerid,packet,channel);
}
void checarhora(){
	string mensagem;
	if(hora==0){
		send_reliable(0,"ps coruja.ogg",0);
		int mostrar=random(0,1);
		if(mostrar==0){
			mensagem="Os últimos raios alaranjados se fazem visíveis, à medida que o Sol retorna ao horizonte.";
		}
		else if(mostrar==1){
			mensagem="A claridade do dia se desvanece aos poucos, dando lugar ao cinzento crepúsculo.";
		}
		send_reliable(0,"msgnormal "+mensagem,0);
	}
	else if(hora==6){
		send_reliable(0,"ps voar.ogg",0);
		int mostrar=random(0,1);
		if(mostrar==0){
			mensagem="Pássaros despertam e iniciam seu gorjear na distância. Um novo dia se aproxima.";
		}
		else if(mostrar==1){
			mensagem="El viento avanza hacia el este, murmurando al pasar por tu lado.";
		}
		else if(mostrar==1){
			mensagem="El sol desaparece lentamente, dejando paso a la noche.";
		}
		else if(mostrar==1){
			mensagem="O Sol deslisa de detrás do horizonte, trazendo consigo uma nova manhã.";
		}
		send_reliable(0,"msgnormal "+mensagem,0);
	}
	badalar.restart();
	nbadalar=hora;
}
