#include "speak.bgt"
string directory;
const string title ="View Users Data";

void main()
{
show_game_window(title);
while(true)
{
wait(5);
if(key_down(KEY_LMENU) && key_pressed(KEY_F4))
{
exit();
}
if(key_pressed(KEY_V))
{
view_user();
}
}
}

void view_user()
{
dictionary@ db;
file file_user;
int counter =0;
string username;
string data;
string[] players;
string[] keys;
string result;
directory =input_box("Directory", "Type the directory players:", "");
if(directory =="")
{
alert("Info", "Please specify the players directory.");
return;
}
if(directory_exists(directory))
{
speak("OK");
}
else
{
alert("Info", "This directory does not exist.");
return;
}
username =input_box("User name", "Type the player to view:", "");
if(username =="")
{
alert("Error", "Please specify the user name.");
return;
}
if(directory_exists(directory+"/"+username))
{
file_user.open(directory+"/"+username+"/configs.ini", "rb");
@db =deserialize(file_user.read());
file_user.close();
}
else{
alert("Info", "This user does not exist.");
return;
}
keys =db.get_keys();
for(int y=0; y<keys.length(); y++)
{
if(db.exists(keys[y]))
{
db.get(keys[y], data);
result +=keys[y]+"="+data+"\r\n";
counter++;
}
}
if(counter>0)
{
clipboard_copy_text(result);
speak("Done");
}
else
speak("No results found.");
}
