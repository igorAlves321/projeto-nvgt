game_disabled@[] disableds;
class game_disabled{
int minx, maxx, miny, maxy;
game_disabled(int min_x, int max_x, int min_y, int max_y){
this.minx=min_x;
this.maxx=max_x;
this.miny=min_y;
this.maxy=max_y;
}
}
bool is_disabled(int x, int y){
for(int i=0; i<disableds.length(); i++){
int minx=disableds[i].minx;
int maxx=disableds[i].maxx;
int miny=disableds[i].miny;
int maxy=disableds[i].maxy;
if(minx>x) continue;
if(minx<=x && maxx>=x && miny<=y && maxy>=y){
return true;
}
}
return false;
}