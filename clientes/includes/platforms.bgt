class platform {
	string plattype;
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string tiles;
	platform(string type, int minx, int maxx, int miny, int maxy, string tile) {
		this.plattype =type;
		this.min_x =minx;
		this.max_x =maxx;
		this.min_y =miny;
		this.max_y =maxy;
		this.tiles =tile;
	}
} // end platform

string get_tile_at(int x, int y) {
	string outval;
	int minx, maxx, miny, maxy;
	for(uint i=0; i<platforms.length(); i++) {
		minx =platforms[i].min_x;
		maxx =platforms[i].max_x;
		miny =platforms[i].min_y;
		maxy =platforms[i].max_y;
		if(minx>x)continue;
		if(minx<=x && maxx>=x && miny<=y && maxy>=y) {
			outval =platforms[i].tiles;
			continue;
		}
	}
	return outval;
}

int have_tile_at(int x, int y) {
	int minx, maxx, miny, maxy;
	for(uint i=0; i<platforms.length(); i++) {
		minx =platforms[i].min_x;
		maxx =platforms[i].max_x;
		miny =platforms[i].min_y;
		maxy =platforms[i].max_y;
		if(minx>x)continue;
		if(minx<=x && maxx>=x && miny<=y && maxy>=y) {
			return i;
		}
	}
	return -1;
}
