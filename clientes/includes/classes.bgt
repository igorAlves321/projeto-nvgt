class sc{
string[] data, lines;
int counter=-1;
void set_data(string[] search_data){
this.data=search_data;
}
int search_term(string text){
for(int x=0; x<data.length(); x++){
if(string_contains(data[x], text, 1)>-1){
lines.insert_last(data[x]);
}
}
if(lines.length()>0){
counter++;
return counter;
}
return counter;
}
int next_term(){
if(lines.length()>0&&counter<lines.length()-1){
counter++;
return counter;
}
return -1;
}
int previous_term(){
if(lines.length()>0&&counter>0){
counter--;
return counter;
}
return -1;
}
}

class telefone{
	string input(string text){
		int cursor;
		bool caiu;
		string message;
		if(text!="")speak(pu.get_value(text));
		cursor=0;
		caiu=false;
		string[] ms;
		get_characters();
		sound telefonecaiu;
		telefonecaiu.load("telefone2.ogg");
		send_unreliable(peer_id, "playsocial telefonetirandogancho.ogg", 0);
		while(true){
			mainloop();
			if(caiu==true){
				telefonecaiu.play_looped();
			}
			string char=get_characters();
			for (uint i=0; i<char.length(); i++) {
				string chars=char[i];
				if(chars!=""&&chars!="1"&&chars!="2"&&chars!="3"&&chars!="4"&&chars!="5"&&chars!="6"&&chars!="7"&&chars!="8"&&chars!="9"&&chars!="0"&&chars!="-"&&chars!="#"&&chars!="*"&&caiu==false){
					caiu=true;
				}
				else if(caiu==false){
					if(chars=="1")
					p.play_stationary("1.ogg", false);
					if(chars=="2")
					p.play_stationary("2.ogg", false);
					if(chars=="3")
					p.play_stationary("3.ogg", false);
					if(chars=="4")
					p.play_stationary("4.ogg", false);
					if(chars=="5")
					p.play_stationary("5.ogg", false);
					if(chars=="6")
					p.play_stationary("6.ogg", false);
					if(chars=="7")
					p.play_stationary("7.ogg", false);
					if(chars=="8")
					p.play_stationary("8.ogg", false);
					if(chars=="9")
					p.play_stationary("9.ogg", false);
					if(chars=="0")
					p.play_stationary("0.ogg", false);
					if(chars=="*")
					p.play_stationary("asterisco.ogg", false);
					if(chars=="#")
					p.play_stationary("#.ogg", false);
					ms.insert_at(cursor,char);
					cursor+=1;
				}
			}
			if(key_pressed(KEY_ESCAPE)){
				send_unreliable(peer_id, "playsocial telefonecolocandogancho.ogg", 0);
jatem=false;
				return "";
			}
			else if(key_pressed(KEY_RETURN)){
				if (ms.length() > 0){
					sound s;
					for (uint i=0; i<ms.length(); i++){
						message+=ms[i];
						s.load(ms[i]+".ogg");
						s.play_wait();
					}
jatem=false;

					return message;
				}
				else if (ms.length()==0){
					send_unreliable(peer_id, "playsocial telefonecolocandogancho.ogg", 0);
jatem=false;
					return "";
				}
			}
		}
		return "";
	}
}
class telefon{
	string input(string text){
		int cursor;
		bool caiu;
		string message;
		if(text!="")speak(pu.get_value(text));
		cursor=0;
		caiu=false;
		string[] ms;
		get_characters();
		sound telefonecaiu;
		telefonecaiu.load("telefone2.ogg");
		while(true){
			mainloop();
			if(caiu==true){
				telefonecaiu.play_looped();
			}
			string char=get_characters();
			for (uint i=0; i<char.length(); i++) {
				string chars=char[i];
				if(chars!=""&&chars!="1"&&chars!="2"&&chars!="3"&&chars!="4"&&chars!="5"&&chars!="6"&&chars!="7"&&chars!="8"&&chars!="9"&&chars!="0"&&chars!="-"&&chars!="#"&&chars!="*"&&caiu==false){
					caiu=true;
				}
				else if(caiu==false){
					if(chars=="1")
					p.play_stationary("1.ogg", false);
					if(chars=="2")
					p.play_stationary("2.ogg", false);
					if(chars=="3")
					p.play_stationary("3.ogg", false);
					if(chars=="4")
					p.play_stationary("4.ogg", false);
					if(chars=="5")
					p.play_stationary("5.ogg", false);
					if(chars=="6")
					p.play_stationary("6.ogg", false);
					if(chars=="7")
					p.play_stationary("7.ogg", false);
					if(chars=="8")
					p.play_stationary("8.ogg", false);
					if(chars=="9")
					p.play_stationary("9.ogg", false);
					if(chars=="0")
					p.play_stationary("0.ogg", false);
					if(chars=="*")
					p.play_stationary("asterisco.ogg", false);
					if(chars=="#")
					p.play_stationary("#.ogg", false);
					ms.insert_at(cursor,char);
					cursor+=1;
				}
			}
			if(key_pressed(KEY_ESCAPE)){
				return "";
			}
			else if(key_pressed(KEY_RETURN)){
				if (ms.length() > 0){
					sound s;
					for (uint i=0; i<ms.length(); i++){
						message+=ms[i];
						s.load(ms[i]+".ogg");
						s.play_wait();
					}
					return message;
				}
				else if (ms.length()==0){
					return "";
				}
			}
		}
		return "";
	}
}
areia_movedissa@[] areia_movedissas;
class areia_movedissa{
	int x, y, som;
	string mapa;
	bool foi=false;
	areia_movedissa(int cx, int cy, string cmapa){
		x=cx;
		y=cy;
		mapa=cmapa;
		som=p.play_2d("areia_movedissaloop.ogg", me.x, me.y, x, y, true);
	}
}
void colocar_areia_movedissa(int x, int y, string mapa){
	areia_movedissa c(x, y, mapa);
	areia_movedissas.insert_last(c);
}
void destruir_areias_movedissas(){
	for(uint i=0;i<areia_movedissas.length();i++){
		p.destroy_sound(areia_movedissas[i].som);
		areia_movedissas.remove_at(i);
	}
}
void areia_movedissaloop(){
	for(uint i=0;i<areia_movedissas.length();i++){
		if(me.x==areia_movedissas[i].x&&me.y==areia_movedissas[i].y&&areia_movedissas[i].mapa==mapname&&areia_movedissas[i].foi==false){
			sound s;
			moveable=false;
			s.load("morrendo_areia.ogg");
			send_unreliable(peer_id, "draw morrendo_areia.ogg", 0);
			s.play_wait();
			while(s.playing){
				wait(5);
				mainloop();
			}
			send_unreliable(peer_id, "morreu na areia movediça!", 0);
			areia_movedissas[i].foi=true;
			break;
		}
	}
}

