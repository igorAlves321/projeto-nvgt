void vehiculos(){
string belicos2="tanque_de_guerra\r\navión_bombardero\r\nhelicóptero_de_guerra";
string[] belicos=string_split(belicos2, "\r\n", false);
string[] div=string_split(belicos[0], bell, false);
	reset_all_forced_keys();
	key_hold ileft(KEY_LEFT,500,50);
	key_hold iright(KEY_RIGHT,500,50);
emchat=true;
speak(pu.get_value("Elige tu vehículo de preferencia."));
int contador=-1;
get_characters();
string cl;
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE)){
emchat=false;
break;
}
if(key_pressed(KEY_RETURN)&&contador>-1||key_pressed(KEY_NUMPADENTER)&&contador>-1){
p.play_stationary("menuenter3.ogg", false);
send_unreliable(event.peer_id, "conseguirvehiculo "+belicos[contador], 0);
emchat=false;
break;
}
		if(key_pressed(KEY_HOME)&&contador>0){
			contador=0;
speak(pu.get_value(belicos[contador]));
p.play_stationary("menuopcion.ogg", false);
		}
		if(key_pressed(KEY_END)&&contador<belicos.length()){
contador=belicos.length()-1;
speak(pu.get_value(belicos[contador]));
p.play_stationary("menuopcion.ogg", false);
		}
		if(ileft.pressing()&&contador>0){
				contador--;
speak(pu.get_value(belicos[contador]));
p.play_stationary("menuopcion.ogg", false);
			}
		if(iright.pressing()&&contador<belicos.length()-1){
				contador++;
speak(pu.get_value(belicos[contador]));
p.play_stationary("menuopcion.ogg", false);
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and belicos.length()>0){
int f=0;
int oc=contador;
for(uint i=contador; i<belicos.length(); i++){
if(i==contador){
continue;
}
if(belicos[i][0]==cl){
contador=i;
string msg=belicos[contador];
speak(pu.get_value(msg));
p.play_stationary("menuopcion.ogg", false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
if(f==0){
contador=0;
for(uint i=contador; i<belicos.length(); i++){
if(belicos[i][0]==cl){
contador=i;
string msg=belicos[contador];
speak(pu.get_value(msg));
p.play_stationary("menuopcion.ogg", false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
}
}
}
}
void portallist(string[] team){
	reset_all_forced_keys();
	key_hold iup(KEY_UP,500,50);
	key_hold idown(KEY_DOWN,500,50);
speak(pu.get_value("menú de la runa."));
int contador=-1;
team.remove_at(0);
get_characters();
string cl;
if(team.length()==0){
speak(pu.get_value("no hay nadie de tu equipo en línea!"));
return;
}
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE))break;
if(key_pressed(KEY_RETURN)&&contador>-1||key_pressed(KEY_NUMPADENTER)&&contador>-1){
send_unreliable(event.peer_id, "portal "+team[contador], 0);
break;
}
		if(key_pressed(KEY_HOME)&&contador>0){
			contador=0;
speak(pu.get_value(team[contador]));
p.play_stationary("aircraft_command.ogg", false);
		}
		if(key_pressed(KEY_END)&&contador<team.length()){
contador=team.length()-1;
speak(pu.get_value(team[contador]));
p.play_stationary("aircraft_command.ogg", false);
		}
		if(iup.pressing()&&contador>0){
				contador--;
speak(pu.get_value(team[contador]));
p.play_stationary("aircraft_command.ogg", false);
			}
		if(idown.pressing()&&contador<team.length()-1){
				contador++;
speak(pu.get_value(team[contador]));
p.play_stationary("aircraft_command.ogg", false);
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and team.length()>0){
int f=0;
int oc=contador;
for(uint i=contador; i<team.length(); i++){
if(i==contador){
continue;
}
if(team[i][0]==cl){
contador=i;
string msg=team[contador];
speak(pu.get_value(msg));
p.play_stationary("aircraft_command.ogg", false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
if(f==0){
contador=0;
for(uint i=contador; i<team.length(); i++){
if(team[i][0]==cl){
contador=i;
string msg=team[contador];
speak(pu.get_value(msg));
p.play_stationary("aircraft_command.ogg", false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
}
}
