void textmenu(string[] lines){
	reset_all_forced_keys();
	key_hold iup(KEY_UP,500,50);
	key_hold idown(KEY_DOWN,500,50);
	string[] parts=string_split(lines[0], "==", true);
	string packet=parts[0];
	int channel=string_to_number(parts[1]);
	string filename=parts[2];
	lines.remove_at(0);
	int counter=-1;
	get_characters();
	string cl;
	speak(pu.get_value("menú de edición."));
	while(true){
		wait(5);
		mainloop();
		if(key_pressed(KEY_ESCAPE))break;
		if(key_pressed(KEY_HOME)&&counter>0){
			counter=0;
			speak(pu.get_value(lines[counter]));
		}
		if(key_pressed(KEY_END)&&counter<lines.length()){
			counter=lines.length()-1;
			speak(pu.get_value(lines[counter]));
		}
		if(iup.pressing()&&counter>0){
			counter--;
			speak(pu.get_value(lines[counter]));
		}
		if(idown.pressing()&&counter<lines.length()-1){
			counter++;
			speak(pu.get_value(lines[counter]));
		}
		if(!shift_pressionado()){
			if(key_pressed(KEY_RETURN)&&counter>-1||key_pressed(KEY_NUMPADENTER)&&counter>-1){
				string before=lines[counter];
				string new=v.input(pu.get_value("escriba o modifique lo correspondiente."), before);
				if(new!=""){
					lines[counter]=string_replace(lines[counter], before, new, true);
					speak(pu.get_value("Línea actualizada. Para enviar el contenido al servidor pulse shift+enter."));
				}
			}
		}
		if(key_down(KEY_LCONTROL) || key_down(KEY_RMENU)) {
			if(key_pressed(KEY_A)) {
				string new =v.input(pu.get_value("Nueva línea. Por favor escriba el texto de la línea que desea agregar, y pulse enter:"));
				if(new!="") {
					lines.insert_last(new);
				}
			}
		}
		if(key_pressed(KEY_DELETE) && counter>-1) {
			setupmenu2();
			m.add_item_tts("Si", "yes");
			m.add_item_tts("No", "no");
			int mres =m.run(pu.get_value("¿Está seguro que desea borrar la línea actual? esta acción no se puede deshacer."), true);
			if(mres ==0 || m.get_item_name(mres)=="no") {
				continue;
			}
			else {
				lines.remove_at(counter);
				speak(pu.get_value("Línea eliminada."));
				counter--;
			}
		}
		if(shift_pressionado() && key_pressed(KEY_RETURN)){
			send_reliable(event.peer_id, packet+" "+filename+" "+linear(lines), channel);
		}
		cl=get_characters();
		if(cl!="" and cl!=" " and cl.length()==1 and lines.length()>0){
			int f=0;
			int oc=counter;
			for(uint i=counter; i<lines.length(); i++){
				if(i==counter){
					continue;
				}
				if(lines[i][0]==cl){
					counter=i;
					string msg=lines[counter];
					speak(pu.get_value(msg));
					copiaragora=pu.get_value(msg);
					cl="";
					f=1;
					break;
				}
			}
			if(f==0){
				counter=0;
				for(uint i=counter; i<lines.length(); i++){
					if(lines[i][0]==cl){
						counter=i;
						string msg=lines[counter];
						speak(pu.get_value(msg));
						copiaragora=pu.get_value(msg);
						cl="";
						f=1;
						break;
					}
				}
			}
		}
		if(key_down(KEY_LCONTROL)&&key_pressed(KEY_C)){
			string a;
			for(uint i=0; i<lines.length(); i++){
				a+=lines[i]+"\r\n";
			}
			clipboard_copy_text(a);
			speak(pu.get_value("copiado al portapapeles."));
		}
	}
}
void menul(string[] opcoes){
string[] div=string_split(opcoes[0], bell, false);
	reset_all_forced_keys();
	key_hold iup(KEY_UP,500,50);
	key_hold idown(KEY_DOWN,500,50);
opcoes.remove_at(0);
speak(translate_with_char(div[0], ";"));
int contador=-1;
get_characters();
string cl;
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE))break;
		if(key_pressed(KEY_HOME)&&contador>0){
			contador=0;
speak(translate_with_char(opcoes[contador], ";"));
		}
		if(key_pressed(KEY_END)&&contador<opcoes.length()){
contador=opcoes.length()-1;
speak(translate_with_char(opcoes[contador], ";"));
		}
		if(iup.pressing()&&contador>0){
				contador--;
speak(translate_with_char(opcoes[contador], ";"));
			}
		if(idown.pressing()&&contador<opcoes.length()-1){
				contador++;
speak(translate_with_char(opcoes[contador], ";"));
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and opcoes.length()>0){
int f=0;
int oc=contador;
for(uint i=contador; i<opcoes.length(); i++){
if(i==contador){
continue;
}
if(opcoes[i][0]==cl){
contador=i;
string msg=opcoes[contador];
speak(pu.get_value(msg));
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
if(f==0){
contador=0;
for(uint i=contador; i<opcoes.length(); i++){
if(opcoes[i][0]==cl){
contador=i;
string msg=opcoes[contador];
speak(pu.get_value(msg));
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
}
}
if(key_down(KEY_LCONTROL)&&key_pressed(KEY_C)){
string a;
for(uint i=0; i<opcoes.length(); i++){
a+=opcoes[i]+"\r\n";
}
clipboard_copy_text(a);
speak(pu.get_value("copiado al portapapeles."));
}
}
}
void menul2(string[] sonidos){
string[] div=string_split(sonidos[0], bell, false);
	reset_all_forced_keys();
	key_hold iup(KEY_UP,500,50);
	key_hold idown(KEY_DOWN,500,50);
	key_hold ileft(KEY_LEFT,500,50);
	key_hold iright(KEY_RIGHT,500,50);
	key_hold inext(KEY_NEXT,500,50);
	key_hold iprior(KEY_PRIOR,500,50);
	get_characters();
	string cl;
cl=get_characters();
sonidos.remove_at(0);
speak(pu.get_value(div[0]));
int contador=-1;
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE))break;
		if(cl!="" and cl!=" " and cl.length()==1 and sonidos.length()>0){
			int f=0;
			int oc=contador;
			for(uint i=contador; i<sonidos.length(); i++){
				if(i==contador){
					continue;
				}
				if(sonidos[i][0]==cl){
					contador=i;
					string msg=sonidos[contador];
	send_unreliable(peer_id,"playsocial door17open.ogg",0);
					speak(pu.get_value(msg+", "+sonidos[contador]));
					copiaragora=pu.get_value(msg+", "+sonidos[contador]);
					cl="";
					f=1;
					break;
				}
			}
			if(f==0){
				contador=0;
				for(uint i=contador; i<sonidos.length(); i++){
					if(sonidos[i][0]==cl){
						contador=i;
						string msg=sonidos[contador];
	send_unreliable(peer_id,"playsocial door17open.ogg",0);
						speak(pu.get_value(msg+", "+sonidos[contador]));
						copiaragora=pu.get_value(msg+", "+sonidos[contador]);
						cl="";
						f=1;
						break;
					}
				}
			}
		}
		if(key_pressed(KEY_HOME)&&contador>0){
			contador=0;
speak(pu.get_value(sonidos[contador]));
		}
		if(key_pressed(KEY_END)&&contador<sonidos.length()){
contador=sonidos.length()-1;
speak(pu.get_value(sonidos[contador]));
		}
if(key_pressed(KEY_PRIOR)&&contador>10){
contador-=10;
speak(pu.get_value(sonidos[contador]));
}
if(key_pressed(KEY_NEXT)&&contador<sonidos.length()-10){
contador+=10;
speak(pu.get_value(sonidos[contador]));
}
if(iprior.pressing()&&contador>10){
contador-=10;
speak(pu.get_value(sonidos[contador]));
}
if(inext.pressing()&&contador<sonidos.length()-10){
contador+=10;
speak(pu.get_value(sonidos[contador]));
}

if(ileft.pressing()&&contador>50){
contador-=50;
speak(pu.get_value(sonidos[contador]));
}
if(iright.pressing()&&contador<sonidos.length()-50){
contador+=50;
speak(pu.get_value(sonidos[contador]));
}
		if(iup.pressing()&&contador>0){
				contador--;
speak(pu.get_value(sonidos[contador]));
			}
		if(idown.pressing()&&contador<sonidos.length()-1){
				contador++;
speak(pu.get_value(sonidos[contador]));
}
if(key_pressed(KEY_RETURN)&&contador>-1)send_unreliable(peer_id, div[1]+" "+sonidos[contador], 0);
}
}
