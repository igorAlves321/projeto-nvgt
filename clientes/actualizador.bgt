#include "includes/parsed_data.bgt"
parsed_data pu;

void main(){
	bool success;
	wait(600);
	if(directory_exists("download") && COMMAND_LINE =="-update") {
		success =write_commands("download");
	}
	else {
		if(!directory_exists("download") || COMMAND_LINE =="") {
			alert("Info", pu.get_value("No se han encontrado actualizaciones actualmente."));
			exit();
		}
	}
	if(success) {
		run("actualizador.bat", "", false, false);
		exit();
	}
	if(COMMAND_LINE =="-finished") {
		if(directory_exists("leitura")) directory_delete("leitura");
		directory_delete("download");
		if(file_exists("exclude.txt")) file_delete("exclude.txt");
		if(file_exists("wget.exe")) file_delete("wget.exe");
		file_delete("actualizador.bat");
		run("Reino Elemental.exe", "", false, false);
		exit();
	}
}

bool write_commands(string directory) {
	file cmd;
	string commands ="@echo off\r\n";
	commands +="@title updater\r\n";
	commands +="xcopy "+directory+" . /c /h /e /r /q /y /exclude:download\\exclude.txt\r\n";
	commands +="start actualizador.exe -finished\r\n";
	commands +="exit";
	bool success;
	success =cmd.open("actualizador.bat", "w");
	if(success) {
		cmd.write(commands);
		cmd.close();
		return success;
	}
	return false;
}
