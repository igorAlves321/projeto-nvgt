
#pragma plugin nvgt_sqlite
#include "sqlite3constants.nvgt"

sqlite3 db;

void main() {
    file f;
    f.open("admin_info.txt", "w");
    
    if(db.open("../server/database/evm.db") != SQLITE_OK) {
        if(db.open("server/database/evm.db") != SQLITE_OK) {
             f.write("Error: Could not open database\n");
             f.close();
             return;
        }
    }
    
    // Check if user exists
    string query = "SELECT username, password_hash, password_salt FROM players WHERE username='caos';";
    sqlite3statement@ stmt = db.prepare(query);
    
    if(@stmt == null || stmt.step() != SQLITE_ROW) {
        f.write("User 'caos' not found in database.\n");
    } else {
        string hash = stmt.column_text(1);
        string salt = stmt.column_text(2);
        
        // Recover password from insecure hash (salt + "::" + password)
        string password = "";
        int sep = hash.find("::");
        if(sep > -1) {
            password = hash.substr(sep + 2);
        } else {
            // Maybe legacy hash (plain text) or just salt missing
            password = hash; 
        }
        
        f.write("User found.\n");
        f.write("Password (Likely): " + password + "\n");
        
    
    }
    
    // Check roles independent of user existence
    f.write("Checking roles for 'caos'...\n");
    string role_query = "SELECT role FROM player_roles WHERE username='caos';";
    sqlite3statement@ role_stmt = db.prepare(role_query);
    bool has_roles = false;
    f.write("Roles found: ");
    while(role_stmt.step() == SQLITE_ROW) {
        f.write(role_stmt.column_text(0) + ", ");
        has_roles = true;
    }
    f.write("\n");
    if(!has_roles) f.write("No roles found for 'caos'.\n");

    f.close();
    db.close();
}
