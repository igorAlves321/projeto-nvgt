// delete_player.nvgt - Script para deletar um jogador do banco de dados

#pragma plugin nvgt_sqlite

#include "../docks/include/bgt_compat.nvgt"
#include "../docks/include/sqlite3constants.nvgt"

sqlite3 db;

void main() {
    show_window("Deletar Jogador");
    
    string db_path = "../server/database/evm.db";
    
    if(db.open(db_path) != SQLITE_OK) {
        alert("Erro", "Erro ao abrir banco de dados: " + db.get_last_error_text());
        return;
    }
    
    // Deletar jogador caos
    string username = "caos";
    
    // Deletar da tabela players
    string query = "DELETE FROM players WHERE username = ?;";
    sqlite3statement@ stmt = db.prepare(query);
    if(@stmt != null) {
        stmt.bind_text(1, username);
        if(stmt.step() == SQLITE_DONE) {
            alert("Sucesso", "Jogador '" + username + "' deletado da tabela players!");
        } else {
            alert("Erro", "Erro ao deletar: " + db.get_last_error_text());
        }
    }
    
    // Deletar da tabela player_roles também
    string query2 = "DELETE FROM player_roles WHERE username = ?;";
    sqlite3statement@ stmt2 = db.prepare(query2);
    if(@stmt2 != null) {
        stmt2.bind_text(1, username);
        stmt2.step();
    }
    
    // Deletar inventário se existir tabela
    db.execute("DELETE FROM player_inventory WHERE player_id IN (SELECT id FROM players WHERE username = '" + username + "');");
    
    db.close();
    
    alert("Concluído", "Conta '" + username + "' foi completamente removida do banco de dados.");
}
