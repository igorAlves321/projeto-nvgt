// Teste completo das funções BGT compatíveis
// Este teste valida todas as funcionalidades do BGT original

#include "servidor/includes/db.nvgt"

void test_complete_bgt_functionality() {
	alert("Iniciando", "Teste completo das funções BGT...");
	
	// Test 1: Construtores e reset
	db test_db();
	test_db.set("test1", "value1");
	test_db.set("test2", "value2");
	
	alert("Test 1", "Antes do reset: " + test_db.get_size() + " itens");
	test_db.reset();
	alert("Test 1", "Após reset: " + test_db.get_size() + " itens");
	
	// Test 2: set com string e double
	test_db.set("player_name", "João");
	test_db.set("level", 25.5);
	test_db.set("gold", 15000.0);
	test_db.set("active", "true");
	
	string name;
	double level, gold;
	string active;
	
	bool success1 = test_db.get("player_name", name);
	bool success2 = test_db.get("level", level);
	bool success3 = test_db.get("gold", gold);
	bool success4 = test_db.get("active", active);
	
	string result2 = "Test 2 - Set/Get com tipos:\n";
	result2 += "Nome: " + name + " (" + success1 + ")\n";
	result2 += "Level: " + level + " (" + success2 + ")\n";
	result2 += "Gold: " + gold + " (" + success3 + ")\n";
	result2 += "Active: " + active + " (" + success4 + ")";
	alert("Test 2", result2);
	
	// Test 3: exists e is_empty
	string result3 = "Test 3 - Exists/Empty:\n";
	result3 += "Database vazio: " + test_db.is_empty() + "\n";
	result3 += "player_name existe: " + test_db.exists("player_name") + "\n";
	result3 += "inexistente existe: " + test_db.exists("inexistente") + "\n";
	result3 += "Tamanho atual: " + test_db.get_size();
	alert("Test 3", result3);
	
	// Test 4: get_keys e ordem
	test_db.set("item1", "sword");
	test_db.set("item2", "shield");
	test_db.set("item3", "potion");
	
	string result4 = "Test 4 - Keys e ordem:\n";
	string[]@ keys = test_db.get_keys();
	for(uint i = 0; i < keys.length(); i++) {
		result4 += i + ": " + keys[i] + " = " + test_db.get(keys[i]) + "\n";
	}
	alert("Test 4", result4);
	
	// Test 5: sort function
	alert("Test 5", "Antes do sort, item1 está na posição: " + find_key_position(test_db, "item1"));
	
	bool sort_result = test_db.sort("item1", 2); // Mover item1 2 posições para frente
	
	string result5 = "Test 5 - Sort:\n";
	result5 += "Sort bem-sucedido: " + sort_result + "\n";
	result5 += "Nova ordem:\n";
	
	string[]@ keys_after_sort = test_db.get_keys();
	for(uint i = 0; i < keys_after_sort.length(); i++) {
		result5 += i + ": " + keys_after_sort[i] + "\n";
	}
	alert("Test 5", result5);
	
	// Test 6: delete function
	bool delete_result = test_db.delete("level");
	string result6 = "Test 6 - Delete:\n";
	result6 += "Delete 'level': " + delete_result + "\n";
	result6 += "level ainda existe: " + test_db.exists("level") + "\n";
	result6 += "Tamanho após delete: " + test_db.get_size();
	alert("Test 6", result6);
	
	// Test 7: delete_all
	bool had_data = !test_db.is_empty();
	bool delete_all_result = test_db.delete_all();
	string result7 = "Test 7 - Delete All:\n";
	result7 += "Tinha dados antes: " + had_data + "\n";
	result7 += "Delete all resultado: " + delete_all_result + "\n";
	result7 += "Database vazio agora: " + test_db.is_empty() + "\n";
	result7 += "Tamanho final: " + test_db.get_size();
	alert("Test 7", result7);
	
	// Test 8: Teste de persistência com arquivo
	db file_db("persistent_test.db");
	file_db.set("persistent_key", "persistent_value");
	file_db.set("number_key", 42.5);
	
	string persistent_value;
	double number_value;
	bool persist1 = file_db.get("persistent_key", persistent_value);
	bool persist2 = file_db.get("number_key", number_value);
	
	string result8 = "Test 8 - Persistência:\n";
	result8 += "Valor persistente: " + persistent_value + " (" + persist1 + ")\n";
	result8 += "Número persistente: " + number_value + " (" + persist2 + ")";
	alert("Test 8", result8);
	
	alert("Completo", "Todos os testes BGT completados com sucesso!\nTodas as funções do BGT original foram implementadas.");
}

// Função helper para encontrar posição de uma chave
int find_key_position(db@ database, const string&in key) {
	string[]@ keys = database.get_keys();
	for(uint i = 0; i < keys.length(); i++) {
		if(keys[i] == key) {
			return i;
		}
	}
	return -1;
}

void main() {
	test_complete_bgt_functionality();
}
