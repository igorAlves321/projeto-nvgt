# NVGT Configuration for Projeto IG
# This file configures NVGT compilation and runtime options

[build]
product_name = "Projeto IG Server"
product_version = "1.0_B10"
product_identifier = "com.mxgproductions.projetoig"
windows_bundle = 1

[scripting] 
allow_multiline_strings = true
compiler_warnings = 1

[application]
# Runtime configurations will be added here as needed
