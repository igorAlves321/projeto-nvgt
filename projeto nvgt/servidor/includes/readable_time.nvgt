// Time and data parsing utilities for NVGT
// Extracted from original BGT net.bgt and adapted for NVGT

// Class to parse configuration files with key=value format
class parsed_data {
	private string[] linhas;  // keys
	private string[] valores; // values
	private string arquivo;   // file path
	private string texto;     // text content

	// Load and parse a file with key=value format
	bool set_arquivo(string arquivo) {
		valores.resize(0);
		linhas.resize(0);
		this.arquivo = arquivo;

		file langfile;
		bool abrir = langfile.open(arquivo, "r");

		if(!abrir) {
			return this.arquivo != "";
		}
		else {
			string d;
			d = langfile.read();
			langfile.close();

			string[] parseddata = string_split(d, "\r\n", false);
			if(parseddata.length < 2) {
				parseddata = string_split(d, "\n", false);
			}

			for(int i = 0; i < parseddata.length; i++) {
				if(parseddata[i].is_empty()) continue;

				string[] parseddata2 = string_split(parseddata[i], "=", false);
				if(parseddata2.length != 2) continue;
				else {
					linhas.insert_last(parseddata2[0]);
					valores.insert_last(parseddata2[1]);
				}
			}
		}
		return this.arquivo != "";
	}

	// Get value by key, returns the key itself if not found
	string get_value(string linha) {
		for(uint i = 0; i < linhas.length(); i++) {
			if(linhas[i] == linha) {
				for(uint i2 = 0; i2 < valores.length(); i2++) {
					if(i == i2) {
						return valores[i2];
					}
				}
			}
		}
		return linha;
	}
}

// Convert milliseconds to readable time format
string ms_to_readable_time(int milliseconds) {
	int total_seconds = milliseconds / 1000;
	int hours = total_seconds / 3600;
	int minutes = (total_seconds % 3600) / 60;
	int seconds = total_seconds % 60;

	string result = "";
	if(hours > 0) {
		result += hours + " hora" + (hours > 1 ? "s" : "");
		if(minutes > 0 || seconds > 0) result += ", ";
	}
	if(minutes > 0) {
		result += minutes + " minuto" + (minutes > 1 ? "s" : "");
		if(seconds > 0) result += ", ";
	}
	if(seconds > 0) {
		result += seconds + " segundo" + (seconds > 1 ? "s" : "");
	}
	
	if(result == "") result = "0 segundos";
	return result;
}

// Helper functions for data processing
string[] delinear(string content) {
	return string_split(content, "\r\n", false);
}

string linear(string[] lines) {
	string result = "";
	for(int i = 0; i < lines.length(); i++) {
		result += lines[i];
		if(i < lines.length() - 1) result += "\r\n";
	}
	return result;
}

// Get number from string with validation
double get_number2(string str) {
	return string_to_number(str);
}
