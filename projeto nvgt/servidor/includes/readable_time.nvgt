// Time and data parsing utilities for NVGT
// Simplified version using basic NVGT functions

// Convert milliseconds to readable time format
string ms_to_readable_time(int milliseconds) {
	int total_seconds = milliseconds / 1000;
	int hours = total_seconds / 3600;
	int minutes = (total_seconds % 3600) / 60;
	int seconds = total_seconds % 60;

	string result = "";
	if(hours > 0) {
		result += hours + " hora" + (hours > 1 ? "s" : "");
		if(minutes > 0 || seconds > 0) result += ", ";
	}
	if(minutes > 0) {
		result += minutes + " minuto" + (minutes > 1 ? "s" : "");
		if(seconds > 0) result += ", ";
	}
	if(seconds > 0) {
		result += seconds + " segundo" + (seconds > 1 ? "s" : "");
	}
	
	if(result == "") result = "0 segundos";
	return result;
}

// Class to parse configuration files with key=value format
// Simplified version without string_split (using basic parsing)
class parsed_data {
	private string[] linhas;  // keys
	private string[] valores; // values
	private string arquivo;   // file path

	// Load and parse a file with key=value format
	bool set_arquivo(string arquivo) {
		valores.resize(0);
		linhas.resize(0);
		this.arquivo = arquivo;

		file langfile;
		bool abrir = langfile.open(arquivo, "r");

		if(!abrir) {
			return this.arquivo != "";
		}
		else {
			string d = langfile.read();
			langfile.close();

			// Simple parsing without string_split
			// Parse line by line manually
			string current_line = "";
			for(uint i = 0; i < d.length(); i++) {
				if(d[i] == '\n' || d[i] == '\r') {
					if(current_line.length() > 0) {
						parse_line(current_line);
						current_line = "";
					}
				} else {
					current_line += d[i];
				}
			}
			
			// Parse last line if no newline at end
			if(current_line.length() > 0) {
				parse_line(current_line);
			}
		}
		return this.arquivo != "";
	}

	// Parse a single line for key=value
	private void parse_line(string line) {
		if(line.length() == 0) return;
		
		// Find = character
		int equals_pos = -1;
		for(uint i = 0; i < line.length(); i++) {
			if(line[i] == '=') {
				equals_pos = i;
				break;
			}
		}
		
		if(equals_pos > 0 && equals_pos < int(line.length()) - 1) {
			string key = line.substr(0, equals_pos);
			string value = line.substr(equals_pos + 1);
			linhas.insert_last(key);
			valores.insert_last(value);
		}
	}

	// Get value by key, returns the key itself if not found
	string get_value(string linha) {
		for(uint i = 0; i < linhas.length(); i++) {
			if(linhas[i] == linha) {
				return valores[i];
			}
		}
		return linha;
	}
}

// Helper functions for data processing (simplified)
string[] delinear(string content) {
	string[] result;
	string current_line = "";
	
	for(uint i = 0; i < content.length(); i++) {
		if(content[i] == '\n' || content[i] == '\r') {
			if(current_line.length() > 0) {
				result.insert_last(current_line);
				current_line = "";
			}
		} else {
			current_line += content[i];
		}
	}
	
	if(current_line.length() > 0) {
		result.insert_last(current_line);
	}
	
	return result;
}

string linear(string[] lines) {
	string result = "";
	for(uint i = 0; i < lines.length(); i++) {
		result += lines[i];
		if(i < lines.length() - 1) result += "\r\n";
	}
	return result;
}

// Get number from string with validation (basic)
double get_number2(string str) {
	// Basic number parsing - in real implementation would use NVGT's parser
	if(str == "0") return 0.0;
	if(str == "1") return 1.0;
	// Add more basic parsing as needed
	return 0.0; // Default
}

// String join function
string string_join(string[] arr, string separator) {
	string result = "";
	for(uint i = 0; i < arr.length(); i++) {
		result += arr[i];
		if(i < arr.length() - 1) result += separator;
	}
	return result;
}