// Enhanced request processing with monitoring integration
enhanced_network_event@ request_with_monitoring() {
    enhanced_network_event@ evt = request();
    if (@evt != null) {
        // Integrate with connection monitor
        if (evt.type == event_connect) {
            network_monitor.on_connect(evt.peer_id);
        } else if (evt.type == event_disconnect) {
            network_monitor.on_disconnect(evt.peer_id);
        } else if (evt.type == event_receive) {
            network_monitor.on_data_received(evt.peer_id, evt.message.length());
        }
    }
    return @evt;
}

// Async-enhanced network diagnostics function
void print_network_diagnostics() {
    print("=== Network Diagnostics (Thread-Safe) ===");
    print(network_manager.get_network_stats());
    
    if (@global_network_instance != null) {
        print("Global network active: " + global_network_instance.active);
        print("Global network peers: " + global_network_instance.get_peer_list().length());
    }
    
    print(network_monitor.get_connection_stats());
    
    // Add async performance stats
    print_async_performance();
}

// Async network initialization with threading
bool initialize_network_async() {
    if (!initialize_global_network()) {
        return false;
    }
    
    return network_manager.initialize_subsystem();
}

// Async cleanup with thread safety
void cleanup_network_async() {
    cleanup_async_system();
    cleanup_networking();
}