// Process network events (BGT compatible)
enhanced_network_event@ request() {
    if (@global_network_instance == null) {
        return null;
    }
    
    // For BGT compatibility, return null when no events
    // In a real implementation, this would process NVGT network events
    @current_event = null;
    return null;
}

