    if (@global_network_instance == null) {
        if (!initialize_global_network()) {
            return false;
        }
    }
    
    // Use basic NVGT network setup
    print("Setting up server on port " + port + " with max " + max_peers + " peers");
    return true; // Return success for BGT compatibility
}

