// Global network instance for BGT compatibility
network@ global_network_instance = null;

// Network connection tracking
bool network_initialized = false;

// Event tracking and message storage
string last_event_message = "";
uint64 last_event_peer = 0;
int last_event_channel = 0;
int last_event_type = 0;

// Note: event_none, event_connect, event_disconnect, event_receive are already defined globally in NVGT
// We don't need to redefine them as they cause "Name conflict" errors

// Event types for compatibility (using NVGT's existing constants)
// event_none, event_connect, event_disconnect, event_receive are available globally

// Enhanced network_event wrapper for BGT compatibility
class enhanced_network_event {
    int type = 0;
    uint64 peer_id = 0; 
    int channel = 0;
    string message = "";
    
    enhanced_network_event() {}
    
    enhanced_network_event(network_event@ evt) {
        if (@evt != null) {
            type = evt.type;
            peer_id = evt.peer_id;
            channel = evt.channel;
            message = evt.message;
        }
    }
}

// BGT compatible global functions using real NVGT networking
bool send_reliable(uint64 peer_id, const string&in data, int channel = 0) {
    if (@global_network_instance == null) {
        print("ERROR: Global network not initialized");
        return false;
    }
    
    return global_network_instance.send_reliable(peer_id, data, channel);
}

bool send_unreliable(uint64 peer_id, const string&in data, int channel = 0) {
    if (@global_network_instance == null) {
        print("ERROR: Global network not initialized");
        return false;
    }
    
    return global_network_instance.send_unreliable(peer_id, data, channel);
}

// Enhanced send function with automatic peer_id conversion for BGT compatibility
bool send_reliable(uint peer_id, const string&in data, int channel = 0) {
    return send_reliable(uint64(peer_id), data, channel);
}

bool send_unreliable(uint peer_id, const string&in data, int channel = 0) {
    return send_unreliable(uint64(peer_id), data, channel);
}

// NVGT-based network event handling with BGT compatibility
enhanced_network_event@ current_event = null;

// BGT compatible function to get current event message
string get_event_message() {
    if (@current_event != null) {
        return current_event.message;
    }
    return last_event_message;
}

// Setup server function (BGT compatible with NVGT basic API)
