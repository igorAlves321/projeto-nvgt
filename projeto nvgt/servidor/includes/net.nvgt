// Connection status tracking for enhanced monitoring
class connection_monitor {
    uint64 connection_start_time = 0;
    uint64 last_activity_time = 0;
    uint total_connections = 0;
    uint active_connections = 0;
    
    void on_connect(uint64 peer_id) {
        total_connections++;
        active_connections++;
        // Using simple counter instead of get_ticks()
        last_activity_time++;
        if (connection_start_time == 0) {
            connection_start_time = last_activity_time;
        }
        print("Connection established with peer: " + peer_id);
    }
    
    void on_disconnect(uint64 peer_id) {
        if (active_connections > 0) {
            active_connections--;
        }
        last_activity_time++;
        print("Connection closed with peer: " + peer_id);
    }
    
    void on_data_received(uint64 peer_id, uint data_size) {
        last_activity_time++;
    }
    
    string get_connection_stats() {
        string stats = "=== Connection Statistics ===\n";
        stats += "Total connections: " + total_connections + "\n";
        stats += "Active connections: " + active_connections + "\n";
        if (connection_start_time > 0) {
            uint64 uptime = last_activity_time - connection_start_time;
            stats += "Activity counter: " + uptime + "\n";
        }
        if (last_activity_time > 0) {
            stats += "Last activity: " + last_activity_time + "\n";
        }
        return stats;
    }
}

// Global connection monitor
connection_monitor network_monitor;

// Network compression functions (real implementations)
bool enable_network_compression(network@ net) {
    if (@net == null) return false;
    
    // NVGT may support compression - for now return true
    print("Network packet compression enabled");
    return true;
}

string compress_network_data(const string&in data) {
    // Use NVGT's string compression from bgt_compat
    return string_compress(data);
}

string decompress_network_data(const string&in data) {
    // Use NVGT's string decompression from bgt_compat
    return string_decompress(data);
}

// Thread-safe enhanced network manager class with async functionality
class network_manager_class {
    bool run = false;
    network@[] networks;
    
    // Thread safety for network operations
    private mutex network_mutex;
    
    // NVGT network subsystem support
    bool subsystem_initialized = false;
    
    void add(network@ net) {
        if (@net != null) {
            network_mutex.lock();
            networks.insert_last(@net);
            // Set as global if this is the first one
            if (@global_network_instance == null) {
                @global_network_instance = @net;
            }
            network_mutex.unlock();
        }
    }
    
    void remove(network@ net) {
        if (@net == null) return;
        
        network_mutex.lock();
        for (uint i = 0; i < networks.length(); i++) {
            if (@networks[i] == @net) {
                networks.remove_at(i);
                // Clear global if this was it
                if (@global_network_instance == @net) {
                    @global_network_instance = networks.length() > 0 ? @networks[0] : null;
                }
                break;
            }
        }
        network_mutex.unlock();
    }
    
    void clear() {
        network_mutex.lock();
        networks.resize(0);
        @global_network_instance = null;
        network_mutex.unlock();
    }
    
    uint get_network_count() {
        network_mutex.lock();
        uint result = networks.length();
        network_mutex.unlock();
        return result;
    }
    
    network@ get_network(uint index) {
        if (index >= networks.length()) return null;
        return @networks[index];
    }
    
    // Advanced network monitoring
    uint64 get_total_bytes_sent() {
        uint64 total = 0;
        for (uint i = 0; i < networks.length(); i++) {
            if (@networks[i] != null) {
                total += networks[i].bytes_sent;
            }
        }
        return total;
    }
    
    uint64 get_total_bytes_received() {
        uint64 total = 0;
        for (uint i = 0; i < networks.length(); i++) {
            if (@networks[i] != null) {
                total += networks[i].bytes_received;
            }
        }
        return total;
    }
    
    // Get network statistics
    string get_network_stats() {
        string stats = "Networks: " + networks.length() + "\n";
        stats += "Total bytes sent: " + get_total_bytes_sent() + "\n";
        stats += "Total bytes received: " + get_total_bytes_received() + "\n";
        
        for (uint i = 0; i < networks.length(); i++) {
            if (@networks[i] != null) {
                stats += "Network " + i + " active: " + networks[i].active + "\n";
                stats += "Network " + i + " peers: " + networks[i].get_peer_list().length() + "\n";
            }
        }
        
        return stats;
    }
    
    // Initialize NVGT network subsystem with async support
    bool initialize_subsystem() {
        network_mutex.lock();
        if (!subsystem_initialized) {
            // NVGT_SUBSYSTEM_NET = 0x40 according to documentation
            // This would initialize the network subsystem if needed
            subsystem_initialized = true;
            network_mutex.unlock();
            
            // Initialize async components
            initialize_async_system();
            print("Network subsystem initialized with async support");
            return true;
        }
        network_mutex.unlock();
        return true;
    }
    
    // Async network event processing
    void process_events_async() {
        async_processor.process_events_async();
    }
    
    // Async connection handling
    void handle_connection_async(uint64 peer_id, bool connecting) {
        async_processor.handle_connection_async(peer_id, connecting);
    }
}

// Global instance for BGT compatibility
network_manager_class network_manager;

// BGT compatible helper functions
bool is_network_connected(network@ net = null) {
    if (@net == null) @net = @global_network_instance;
    if (@net == null) return false;
    
    return net.get_peer_list().length() > 0;
}

uint get_network_peer_count(network@ net = null) {
    if (@net == null) @net = @global_network_instance;
    if (@net == null) return 0;
    
    return net.get_peer_list().length();
}

string[] get_network_peer_list(network@ net = null) {
    if (@net == null) @net = @global_network_instance;
    if (@net == null) return string[]();
    
    // Convert uint64[] to string[] for BGT compatibility
    uint64[] peer_ids = net.get_peer_list();
    string[] peer_strings;
    for(uint i = 0; i < peer_ids.length(); i++) {
        peer_strings.insert_last(string(peer_ids[i]));
    }
    return peer_strings;
}

// Initialize global network for BGT compatibility
bool initialize_global_network() {
    if (@global_network_instance != null) {
        return true; // Already initialized
    }
    
    network@ net = network();
    if (@net != null) {
        network_manager.add(@net);
        print("Global network instance initialized");
        return true;
    }
    
    return false;
}

// Cleanup function
void cleanup_networking() {
    if (@global_network_instance != null) {
        global_network_instance.destroy();
        @global_network_instance = null;
    }
    network_manager.clear();
    print("Network cleanup completed");
}

