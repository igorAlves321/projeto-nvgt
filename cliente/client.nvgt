// Função netloop() convertida de BGT para NVGT
void netloop(){
	outrosloop();
	game_event=game_network.request();
	if(game_event.type==event_disconnect&&game_event.peer_id==net_peer_id){
		speak(pu.get_value("Conexão caiu."));
		writeprefs();
		wait(400);
		reiniciar();
	}
	if(game_event.type==event_receive and game_event.channel==0 and game_event.peer_id==net_peer_id){
		string[] parsed=pegar_mensagem().split(" ");
		if(parsed[0]=="pong"){
			if(!forcepinging) pingtimer.restart();
			if(forcepinging){
				forcepinging=false;
				game_p.play_stationary("pingstop.ogg",false);
				speak(pu.get_value("O ping levou")+" "+pingtimer.elapsed+" ms.");
			}
		}
		else if(parsed[0]=="remplayer"){
			if(parsed[1]!=un)remplayer(to_number(parsed[1]));
		}
		else if(parsed[0]=="terminate"){
			reset();
			menuprincipal();
		}
		else if(parsed[0]=="dlancha"&&game_lan.nalancha==1)game_lan.sair();
		else if(parsed[0]=="upl"&&parsed.length()>4)update_player(parsed[1], to_number(parsed[2]), to_number(parsed[3]), to_number(parsed[4]));
		else if(parsed[0]=="p" and parsed.length()>=4) newplayer(parsed[1],to_number(parsed[2]),to_number(parsed[3]));
		else if(parsed[0]=="pp"&&parsed.length()>2){
			for(uint i=0;i<game_players.length();i++){
				if(game_players[i].charname==parsed[1])game_players[i].pacifico=to_number(parsed[2]);
			}
		}
		else if(parsed[0]=="playerbeep"&&parsed.length()>2){
			for(uint i=0; i<game_players.length(); i++){
				if(game_players[i].charname==parsed[1]) game_players[i].beeping=to_number(parsed[2]);
			}
		}
		else if (parsed[0]=="update_player2") update_player2(parsed[1], to_number(parsed[2]), to_number(parsed[3]), to_number(parsed[4]));
		else if(parsed[0]=="s"){
			update_player(parsed[1], to_number(parsed[2]), to_number(parsed[3]), to_number(parsed[4]));
			if (parsed[1]!=un and parsed[4]==mapname){
				string ss=get_tile_at(to_number(parsed[2]),to_number(parsed[3]));
				if(ss.substr(0,4)!="wall") p2.play_2d(ss+"step"+random(1,5)+".ogg",game_me.x,game_me.y,to_number(parsed[2]),to_number(parsed[3]),false);
			}
		}
		else if(parsed[0]=="sb"){
			update_player(parsed[1], to_number(parsed[2]), to_number(parsed[3]), to_number(parsed[4]));
			if (parsed[1]!=un&&parsed[4]==mapname){
				string ss=get_tile_at(to_number(parsed[2]),to_number(parsed[3]));
				ss=ss.replace("0", "");
				ss=ss.replace("1", "");
				ss=ss.replace("2", "");
				ss=ss.replace("3", "");
				ss=ss.replace("4", "");
				ss=ss.replace("5", "");
				ss=ss.replace("6", "");
				ss=ss.replace("7", "");
				ss=ss.replace("8", "");
				ss=ss.replace("9", "");
				ss=ss.replace("concrete", "concret");
				ss=ss.replace("deepsand", "areia");
				ss=ss.replace("sand", "areia");
				ss=ss.replace("cement", "concret");
				ss=ss.replace("gravel", "terra");
				ss=ss.replace("rocks", "terra");
				ss=ss.replace("calcada", "concret");
				ss=ss.replace("plank", "madeira");
				ss=ss.replace("wood", "madeira");
				ss=ss.replace("bridge", "madeira");
				ss=ss.replace("carpet", "madeira");
				ss=ss.replace("chair", "metal");
				ss=ss.replace("deck", "madeira");
				ss=ss.replace("shortgrass", "grama");
				ss=ss.replace("grass", "grama");
				ss=ss.replace("matos", "mato");
				ss=ss.replace("mud", "barro");
				if(ss.substr(0,4)!="wall") p2.play_2d("bicicleta"+ss+".ogg",me.x,me.y,to_number(parsed[2]),to_number(parsed[3]),false);
			}
		}
		else if(parsed[0]=="startfloat"){
			floating=true;
		}
		else if(parsed[0]=="stopfloat"){
			floating=false;
		}
		else if(parsed[0]=="startcloak"){
			cloaked=true;
		}
		else if(parsed[0]=="stopcloak"){
			cloaked=false;
		}
		else if(parsed[0]=="superjumpon") jumpheight=15;
		else if(parsed[0]=="superjumpoff") jumpheight=5;
		else if(parsed[0]=="spellslist"){
			spellmenu(pegar_mensagem().replace("spellslist ",""));
		}
		else if(parsed[0]=="stopmoving"){
			moveable=false;
		}
		else if(parsed[0]=="startmoving"){
			moveable=true;
		}
		else if(parsed[0]=="staron"){
			star=true;
		}
		else if(parsed[0]=="staroff"){
			star=false;
		}
		else if(parsed[0]=="mtester") mtester(pegar_mensagem().replace("mtester ",""));
		else if(parsed[0]=="store")store(pegar_mensagem().replace("store ",""));
		else if(parsed[0]=="changemap"){
			load_map(pegar_mensagem().replace("changemap ", ""));
			connect=true;
		}
		else if(parsed[0]=="changemap2"){
			load_map2(pegar_mensagem().replace("changemap2 ", ""));
			connect=true;
		}
		else if(parsed[0]=="invsec"&&parsed.length()>1){
			itenssecundarios.resize(0);
			itenssecundarios=pegar_mensagem().replace(parsed[0]+" ", "").split("\r\n");
			secundario();
		}
		else if(parsed[0]=="inv" and parsed.length()>=1){
			inv=pegar_mensagem().replace("inv ","");
		}
		else if(parsed[0]=="turn" and parsed.length()>=4){
			if (parsed[1]!=un and parsed[4]==mapname)
			p.play_2d("turn.ogg",me.x, me.y, to_number(parsed[2]), to_number(parsed[3]), false);
		}
		else if(parsed[0]=="rico"&&parsed.length()>3){
			if(parsed[1]!="")p.play_2d(parsed[1],me.x, me.y, to_number(parsed[2]), to_number(parsed[3]), false);
		}
		else if(parsed[0]=="spawn_obj" and parsed.length()>=5){
			if (parsed[3]==mapname)
			spawn_obj(to_number(parsed[1]),to_number(parsed[2]), parsed[4], to_number(parsed[5]));
		}
		else if(parsed[0]=="resetobjs"){
			objs.resize(0);
		}
		else if (parsed[0]=="getobj"){
			for(uint i=0;i<objs.length();i++){
				if (objs[i].x==to_number(parsed[1]) and objs[i].y==to_number(parsed[2])){
					objs.remove_at(i);
				}
			}
		}
		// Continuando com as demais condições...
		// [Nota: Esta função é muito extensa, continuarei na próxima edição]
	}
}

// Função game() convertida de BGT para NVGT
void game(){
	debug_log("🎮 Função game() iniciada!");
	speak("Entrando no jogo!");
	load_map(mapainicial);
	debug_log("✅ Mapa inicial carregado: " + mapainicial);
	speak("Você está no mapa: " + mapainicial + ". Use as setas para se mover.");
	game_net.send(net_peer_id, "setvoice "+voice, 0, true);
	if(ouvirhits==0)game_net.send(net_peer_id, "hits", 0, true);
	game_net.send(net_peer_id, "idiomachat "+idiomachat, 0, true);
	if(ouvirpassos==0)game_net.send(net_peer_id, "dpassos", 0, true);
	temponaoevoce.restart();
	if(mdor==0)game_net.send(net_peer_id, "ndor", 0, true);
	if(avisanivel==0)game_net.send(net_peer_id, "nnivel", 0, true);
	connected=true;
	game_net.send(net_peer_id, "getversion", 0, true);
	debug_log("🎮 Entrando no loop principal do jogo...");
	speak("DEBUG: Loop do jogo iniciado! Use as setas para se mover. Pressione ESC para sair.");
	int loop_count = 0;
	while(true){
		wait(5);
		loop_count++;
		if(loop_count % 100 == 0) {
			debug_log("♻️ Loop do jogo rodando... iteração " + loop_count);
		}
		
		// ===== MOVIMENTAÇÃO BÁSICA SIMPLIFICADA =====
		if(moveable && walktimer.elapsed >= walktime) {
			bool moved = false;
			
			// Movimento para ESQUERDA
			if(key_down(KEY_LEFT)) {
				facing = Left;
				me.x -= 1;
				moved = true;
				debug_log("⬅️ Moveu para esquerda: x=" + me.x);
			}
			// Movimento para DIREITA
			else if(key_down(KEY_RIGHT)) {
				facing = Right;
				me.x += 1;
				moved = true;
				debug_log("➡️ Moveu para direita: x=" + me.x);
			}
			// Movimento para BAIXO
			else if(key_down(KEY_DOWN)) {
				me.y -= 1;
				moved = true;
				debug_log("⬇️ Moveu para baixo: y=" + me.y);
			}
			// Movimento para CIMA
			else if(key_down(KEY_UP)) {
				me.y += 1;
				moved = true;
				debug_log("⬆️ Moveu para cima: y=" + me.y);
			}
			
			// Se moveu, envia para o servidor e toca som de passo
			if(moved) {
				walktimer.restart();
				game_net.send(net_peer_id, "move " + me.x + " " + me.y, 0, true);
				
				// Tocar som de passo baseado no tile
				string tile = get_tile_at(me.x, me.y);
				if(tile != "") {
					string step_sound = tile + "step" + random(1, 5) + ".ogg";
					p2.play_stationary(step_sound, false);
					debug_log("🔊 Som de passo: " + step_sound);
				}
			}
		}
		// ===== FIM DA MOVIMENTAÇÃO =====
		
		if(nandar>-1){
			int id=game_p.play_stationary("elevador.ogg", true);
			int d=-1;
			timer t;
			moveable=false;
			while(true){
				wait(5);
				// mainloop(); - removido pois não existe em NVGT
				if(t.elapsed>=100){
					t.restart();
					d=(me.y/20);
					if(nandar==0)d=me.y;
					if(d>nandar){
						me.y--;
						game_net.send(net_peer_id, "move "+me.x+" "+me.y, 0, true);
					}
					else if(d<nandar){
						me.y++;
						game_net.send(net_peer_id, "move "+me.x+" "+me.y, 0, true);
					}
					d=(me.y/20);
					if(nandar==0)d=me.y;
					if(d==nandar||mapname=="túnel"){
						nandar=-1;
						if(!ausente)moveable=true;
						p.destroy_sound(id);
						if(mapname=="túnel"){
							me.x=1;
							me.y=0;
							game_net.send(net_peer_id, "move "+me.x+" "+me.y, 0, true);
						}
						break;
					}
				}
			}
		}
		if(game_lan.nalancha==1)game_lan.loop();
		// mainloop(); - removido pois não existe em NVGT
		if(connected&&temponaoevoce.elapsed>=2000){
			if(game_maquinatempos.length()>0)maquinatempoloop();
			if(objs.length()>0)objsloop();
			if(studo==1)checkitem();
			if(game_ambientes.length()>0)ambientecheckloop();
			if(staircases.length()>0)staircasecheckloop();
			if(doors.length()>0)doorcheckloop();
			if(elevadors.length()>0)elevadorloop();
			localloop();
			if(game_areia_movedissas.length()>0)areia_movedissaloop();
			weaponcheckloop();
			secundario();
			if(gmt()!=""&&jumping==false&&pulou==1&&falling==false) pulou=0;
		}
		// Processar eventos de rede do jogo
		if(connected) {
			const network_event@ event;
			while((@event = game_net.request()) !is null && event.type != event_none) {
				if(event.type == event_disconnect) {
					debug_log("🔌 Desconectado do servidor!");
					speak("Conexão perdida.");
					reset();
					menuprincipal();
					return;
				}
				else if(event.type == event_receive) {
					// Processar comandos do servidor (será implementado depois)
				}
			}
		}
		
		// Verificar se está saindo do jogo
		if(exiting && exittimer.elapsed >= exittime) {
			debug_log("🚪 Saindo do jogo e voltando ao menu...");
			exittimer.restart();
			exiting = false;
			reset();
			menuprincipal();
			return; // Sai da função game()
		}
		
		if(key_pressed(KEY_F9) && desenvolvedordm==1){
			// Resto do código de construção de mapas...
			// [Será convertido conforme necessário]
		}
		if(key_pressed(KEY_ESCAPE)){
			debug_log("⚠️ ESC pressionado! Chamando exitmenu()");
			exitmenu();
		}
		// Log de teclas de movimento
		if(key_down(KEY_UP) || key_down(KEY_DOWN) || key_down(KEY_LEFT) || key_down(KEY_RIGHT)) {
			if(loop_count % 50 == 0) { // Log a cada 50 iterações com tecla pressionada
				debug_log("⌨️ Tecla de movimento detectada!");
			}
		}
	}
}

// Funções auxiliares convertidas de BGT para NVGT
void reset(){
	if(streamurl >= 0){
		audio_stream_primary.stop(streamurl);
		audio_stream_primary.unload(streamurl);
		streamurl = -1;
	}
	ausente=false;
	lan.nalancha=0;
	dveloz=0;
	desenvolvedordm=0;
	modera=0;
	nolhar="";
	falhou=0;
	pulou=0;
	destroy_all_doors();
	destroy_all_msounds();
	destroy_all_elevadors();
	bolhadear=false;
	connected=false;
	connect=false;
	term=false;
	exiting=false;
	objs.resize(0);
	players.resize(0);
	star=false;
	moveable=true;
	floating=false;
	jumpheight=5;
	destroy_all_sources();
	destroy_all_ambientes();
	chuvatelhado.close();
	carregandotaser.close();
	novato=0;
	map.resize(0);
	destroy_all_staircases();
	p.destroy_all();
	p2.destroy_all();
	pobjs.destroy_all();
	pcomputador.destroy_all();
	forcepinging=false;
	net_peer_id=0;
	inv="";
	apartamentoinv="";
	reset_all_forced_keys();
	floating=false;
	cloaked=false;
	mapname="";
	garbage_collect();
}

void checkloc(){
	if (get_zone_at(me.x,me.y)!=""){
		string locate=get_zone_at(me.x,me.y);
		if (locate!=currentloc){
			if (zonestatus==1)
			if(locate!=".")speak(pu.get_value(locate));
			currentloc=locate;
		}
	}
	else{
		if (currentloc!=""){
			if (zonestatus==1)
			speak(pu.get_value("Área para exploração."));
			currentloc="";
		}
	}
}

void track_thing(int x, int y){
	tracker.x=x;
	tracker.y=y;
}

void tell_where(int x, int y){
	if (me.x<=x){
		godir="direita";
		go=x-me.x;
	}
	else if (me.x>=x){
		godir="esquerda";
		go=me.x-x;
	}
	if (me.y<=y){
		godir2="acima";
		go2=y-me.y;
	}
	else if (me.y>=y){
		godir2="abaixo";
		go2=me.y-y;
	}
	speak(pu.get_value(godir)+" "+go+" "+pu.get_value("e")+" "+pu.get_value(godir2)+" "+go2);
}

