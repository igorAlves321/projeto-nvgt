void reiniciar(){
	writeprefs();
	if(SCRIPT_COMPILED==true){
		run(SCRIPT_EXECUTABLE, "reiniciar "+COMMAND_LINE, false, false);
	}
	else{
		run(SCRIPT_EXECUTABLE, SCRIPT_CURRENT_FILE, false, false);
	}
	exit();
}

// Funções de inventário convertidas de BGT para NVGT
void inv_add_item(string itemname, int itemvalue){
	string content=inv;
	string[] peramitors=content.split("\r\n");
	string[] values;
	for(uint i=0; i<peramitors.length(); i++){
		int eq_pos = peramitors[i].find("=");
		if(eq_pos >= 0) {
			values.insert_at(i, peramitors[i].substr(eq_pos+1));
			peramitors[i] = peramitors[i].substr(0, eq_pos);
		}
	}
	if(inv_item_exists(itemname)){
		int orgval;
		if(inv_item_number(itemname) > -1){
			orgval=to_number(values[inv_item_number(itemname)]);
		}
		else{
			return;
		}
		if(orgval+itemvalue < 1){
			inv_delete_item(itemname);
		}
		else{
			values[inv_item_number(itemname)]=(orgval+itemvalue);
			string tempinv;
			for(uint i=0; i<peramitors.length(); i++){
				tempinv+=peramitors[i]+"="+values[i]+"\r\n";
			}
			inv=tempinv;
		}
	}
	else{
		if(itemvalue > 0){
			inv+=itemname+"="+itemvalue+"\r\n";
		}
	}
}

bool inv_item_exists(string itemname){
	string content=inv;
	string[] peramitors=content.split("\r\n");
	string[] values;
	for(uint i=0; i<peramitors.length(); i++){
		int eq_pos = peramitors[i].find("=");
		if(eq_pos >= 0) {
			values.insert_at(i, peramitors[i].substr(eq_pos+1));
			peramitors[i] = peramitors[i].substr(0, eq_pos);
		}
	}
	for(uint i=0; i<peramitors.length(); i++){
		if(peramitors[i]==itemname){
			return true;
		}
	}
	return false;
}

int inv_item_number(string itemname){
	string content=inv;
	string[] peramitors=content.split("\r\n");
	string[] values;
	for(uint i=0; i<peramitors.length(); i++){
		int eq_pos = peramitors[i].find("=");
		if(eq_pos >= 0) {
			values.insert_at(i, peramitors[i].substr(eq_pos+1));
			peramitors[i] = peramitors[i].substr(0, eq_pos);
		}
	}
	for(uint i=0; i<peramitors.length(); i++){
		if(peramitors[i]==itemname){
			return to_number(values[i]);
		}
	}
	return 0;
}

int inv_item(string itemname){
	string content=inv;
	string[] peramitors=content.split("\r\n");
	string[] values;
	for(uint i=0; i<peramitors.length(); i++){
		int eq_pos = peramitors[i].find("=");
		if(eq_pos >= 0) {
			values.insert_at(i, peramitors[i].substr(eq_pos+1));
			peramitors[i] = peramitors[i].substr(0, eq_pos);
		}
	}
	for(uint i=0; i<peramitors.length(); i++){
		if(peramitors[i]==itemname){
			return i;
		}
	}
	return -1;
}

void inv_delete_item(string itemname){
	string content=inv;
	string[] peramitors=content.split("\r\n");
	string[] values;
	for(uint i=0; i<peramitors.length(); i++){
		int eq_pos = peramitors[i].find("=");
		if(eq_pos >= 0) {
			values.insert_at(i, peramitors[i].substr(eq_pos+1));
			peramitors[i] = peramitors[i].substr(0, eq_pos);
		}
	}
	for(uint i=0; i<peramitors.length(); i++){
		if(peramitors[i]==itemname){
			inv=inv.replace(itemname+"="+values[i]+"\r\n", "");
		}
	}
}

void give(string item){
	string char=daritem();
	if(char==""){
		speak(pu.get_value("Ninguém perto de você."));
	}
	else{
		string amount=v.input(pu.get_value("Quantos você quer dar para")+" "+char+"?");
		if (char!="" and amount!=""){
			game_net.send(net_peer_id,"give "+char+" "+item+" "+amount,0, true);
		}
	}
}

void checkitem(){
	for (uint i=0; i<objs.length(); i++){
		if (objs[i].x==me.x and objs[i].y==me.y){
			objs.remove_at(i);
			game_net.send(net_peer_id,"enter2",0, true);
		}
	}
}

void drop(string item,int amount=1){
	if(amount<0||amount>1000000000)return;
	game_net.send(net_peer_id,"drop "+amount+" "+item,0, true);
}

void auction(string item){
	int amount=to_number(v.input("Quantos?"));
	string minbid2=v.input("Quantidade mínima para a oferta deste leilão?");
	int minbid=to_number(minbid2);
	if(amount>0&&amount<1000000000&&minbid>0&&minbid<1000000000){
		game_net.send(net_peer_id,"/auction "+amount+" "+item+" "+minbid,1, true);
	}
}

void echocheck(int dir){
	string ptyle=get_tile_at(game_me.x, game_me.y);
	if(ptyle==""&&jumping==false&&pulou==0&&mapname!="túnel"&&!dcheck_flag&&!echeck_flag&&moveable){
		game_echotimer.restart();
		pulou=1;
		game_echo=false;
		game_net.send(net_peer_id, "draw caiu.ogg", 0, true);
		game_p.play_stationary("caiu.ogg", false);
		return;
	}
}