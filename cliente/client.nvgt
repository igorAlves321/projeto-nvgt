	// Sistema de canais de chat simplificado
	// Canais só aparecem na navegação quando têm mensagens
	create_add("tudo");      // Sempre existe - recebe cópia de todas as mensagens
	create_add("global");    // Chat global
	create_add("local");     // Chat local (fala no mapa)
	create_add("equipe");    // Chat de equipe
	create_add("privado");   // Mensagens privadas (PM)
	create_add("admin");     // Chat de administração
	create_add("leilão");    // Chat de leilão
	create_add("servidor");  // Mensagens do servidor (estatísticas, info, etc.)
	
	// Instalar keyhook APENAS para JAWS (não instalar para NVDA ou outros leitores!)
	// O keyhook é específico para JAWS e pode causar problemas com outros leitores
	string detected_sr = screen_reader_detect();
	if(detected_sr == "JAWS") {
		install_keyhook();
		debug_log("✓ Keyhook instalado para JAWS");
	} else if(detected_sr != "") {
		debug_log("✓ Leitor de tela detectado: " + detected_sr + " (keyhook não necessário)");
	}
	
	show_game_window(nomejogo+" - "+pu.get_value("Versão")+" "+ver);
	if(primeiravez==0){
		primeiravez=1;
		wait(500);
		string a=idiomas();
		if(a!=""){
			cmfinal="lang/"+a;
			pu.set_arquivo(cmfinal);
		}
	}
