	sons.insert_last("soco6.ogg:57");
	sons.insert_last("soco7.ogg:58");
	sons.insert_last("balaacerta.ogg:59");
	// De cara al futuro: restaurar este comportamiento
	//if(COMMAND_LINE.find("portable")>=0) portable=true;
	if(!portable){
		if (!directory_exists(prefsdir)) directory_create(prefsdir);
		pf.open(prefsdir+"/"+PREFSFILE, "rb");
	}
	else pf.open(PREFSFILE, "rb");
	readprefs();
	pu.set_arquivo(cmfinal);
	
	// ===== INICIALIZAÇÃO DE ÁUDIO COM VERIFICAÇÃO =====
	debug_log("🔊 Inicializando sistema de áudio...");
	
	// Abrir dispositivo de áudio (função não retorna bool, sempre tenta abrir)
	open_sound_device(numero_dispositivo);
	debug_log("✓ Dispositivo de áudio aberto");
	
	// Configurar volume global
	set_sound_master_volume(volumejogo);
	debug_log("✓ Volume global configurado");
	
	// Testar reprodução de som
	debug_log("🔊 Testando reprodução de som...");
	abrir(); // Chama a função que toca door1open.ogg
	wait(100); // Aguarda um pouco para o som começar
	debug_log("✓ Som de teste enviado");
	
	pf.close();
	// game_net removido - usando global 'con' agora
	idiomaschat.insert_last("Desativar chat=Desativado");
	idiomaschat.insert_last("Arabic=ar");
	idiomaschat.insert_last("English=en");
	idiomaschat.insert_last("Español=es");
	idiomaschat.insert_last("Français=fr");
	idiomaschat.insert_last("Persian=pl");
	idiomaschat.insert_last("Português=pt");
	invcat.insert_last("Tudo");
	invcat.insert_last("Armas");
	invcat.insert_last("Munições");
	invcat.insert_last("Explosivos");
	invcat.insert_last("Roupas");
	invcat.insert_last("Comidas e bebidas");
	invcat.insert_last("Documentos");
	invcat.insert_last("Preferências");
	invcat.insert_last("Corpos");
	banned=generate_computer_id(COMPUTER_ID_KEY, true);
	weapons[0]="soco";
	weapons[1]="faca";
	weapons[2]="espingarda";
	weapons[3]="glock";
	weapons[4]="desert_eagle";
	weapons[5]="arco";
