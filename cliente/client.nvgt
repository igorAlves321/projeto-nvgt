		wait(1000);
		net_logar();  // Usar net_logar() ao invés do stub
	}
	if(usalogo==0) dlgplay("logo.ogg",true,25);
	menuprincipal();
}

// ==========================================
// netloop() MOVIDA PARA includes/net.nvgt
// ==========================================
// A implementação completa da Fase 2 está em net.nvgt
// Esta versão antiga BGT foi removida para evitar conflitos

// Função game() convertida de BGT para NVGT
void game(){
	debug_log("🎮 Função game() iniciada!");
	speak("Entrando no jogo!");
	debug_log("✅ Mapa já carregado pelo servidor via changemap");
	speak("Você está no jogo.");
	
	// ===== INICIALIZAÇÃO DE TIMERS CRÍTICOS =====
	walktimer.restart();       // Timer de movimento
	jumptimer.restart();       // Timer de salto
	canijumptimer.restart();   // Timer de cooldown de salto
	falltimer.restart();       // Timer de queda
	debug_log("✅ Timers de física inicializados");
	
	// ===== RESET DE ESTADOS DE FÍSICA =====
	jumping = false;
	falling = false;
	ascending = false;
	atapex = false;
	moveable = true;
	debug_log("✅ Estados de física resetados");
	
	// ===== COMANDOS DE CONFIGURAÇÃO (AGORA IMPLEMENTADOS NO SERVIDOR) =====
	send_reliable(peer_id, "setvoice "+voice, 0);
	if(ouvirhits==0) send_reliable(peer_id, "hits", 0);
	send_reliable(peer_id, "idiomachat "+idiomachat, 0);
	if(ouvirpassos==0) send_reliable(peer_id, "dpassos", 0);
	if(mdor==0) send_reliable(peer_id, "ndor", 0);
	if(avisanivel==0) send_reliable(peer_id, "nnivel", 0);
	send_reliable(peer_id, "getversion", 0);
	
	temponaoevoce.restart();
	connected=true;
	debug_log("🎮 Entrando no loop principal do jogo...");
	debug_log("✅ connected = " + connected + " | ausente = " + ausente);
	speak("DEBUG: Loop do jogo iniciado! Use as setas para se mover. Pressione ESC para sair.");
	
	// TESTE DE SOM - Tentar tocar um som básico
	debug_log("🧪 === TESTE DE SOM ===");
	debug_log("🔊 Tentando tocar som de teste: door1open.ogg");
	int test_sound = p2.play_stationary(get_sound_path("door1open.ogg"), false);
	if(test_sound == -1) {
		debug_log("❌ SOM DE TESTE FALHOU! (retornou -1)");
	} else {
		debug_log("✅ SOM DE TESTE OK! ID: " + test_sound);
	}
	debug_log("🧪 === FIM DO TESTE ===");
	
	int loop_count = 0;
	while(true){
		wait(5);

		// ===== CORREÇÃO CRÍTICA: Atualizar eventos do Windows/OS =====
		// SEM ISSO, key_pressed() NUNCA detecta nada!
		// Ref: Doc NVGT.txt:12360 - "If it is not repeatedly called, your entire application will be disfunctional"
		refresh_window();

		// ===== CRITICAL: Update ALL sound pools =====
		// Sem isso, áudio posicional NÃO funciona!
		// Cada pool precisa saber onde o jogador (listener) está
		// ✅ CORREÇÃO: Usar me.yaw (graus 0-360) em vez de facing (índice 0-3)
		// O parâmetro rotation de update_listener_2d espera graus, não índice de direção
		p.update_listener_2d(me.x, me.y, me.yaw);
		p2.update_listener_2d(me.x, me.y, me.yaw);
		game_p.update_listener_2d(me.x, me.y, me.yaw);
		pobjs.update_listener_2d(me.x, me.y, me.yaw);
		ambientepool.update_listener_2d(me.x, me.y, me.yaw);
		sourcepool.update_listener_2d(me.x, me.y, me.yaw);  // Sons ss: do mapa
		audio.update_listener_2d(me.x, me.y, me.yaw);
		steps.update_listener_2d(me.x, me.y, me.yaw);
		shoot.update_listener_2d(me.x, me.y, me.yaw);
		bodys.update_listener_2d(me.x, me.y, me.yaw);
		walls.update_listener_2d(me.x, me.y, me.yaw);
		doors_sound.update_listener_2d(me.x, me.y, me.yaw);
		npcs.update_listener_2d(me.x, me.y, me.yaw);
		pl.update_listener_2d(me.x, me.y, me.yaw);
		// ===== END sound pool update =====

		// ===== VOICE CHAT UPDATE =====
		// Atualiza gravador (PTT) e player (cleanup de sons finalizados)
		update_voice_chat();

		// ===== MOVING SOUNDS UPDATE =====
		// Atualiza áudio posicional de sons móveis (helicópteros, veículos, etc)
		moving_sounds_loop();

		// ===== HEARTBEAT AUTOMÁTICO =====
		// Envia pacote silencioso a cada 5 segundos para manter conexão ativa
		// Permite ao servidor detectar jogadores fantasma (inativos > 30s)
		if(heartbeat_timer.elapsed >= HEARTBEAT_INTERVAL) {
			heartbeat_timer.restart();
			send_unreliable(peer_id, "heartbeat", 0);
		}

		loop_count++;
		if(loop_count % 100 == 0) {
			debug_log("♻️ Loop do jogo rodando... iteração " + loop_count);
		}
		
		// ===== ROTAÇÃO COM SHIFT + SETAS (igual ao BGT) =====
		if(key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT)) {
			if(key_pressed(KEY_UP) && moveable) {
				if(facing != Forward) {
					p.play_stationary("turn.ogg", false);
				}
				facing = Forward;
				me.yaw = 0.0;
				send_unreliable(peer_id, "turn " + facing, 0);
				debug_log("↑ Rotacionou para frente");
			}
			if(key_pressed(KEY_DOWN) && moveable) {
				if(facing != Back) {
					p.play_stationary("turn.ogg", false);
				}
				facing = Back;
				me.yaw = 180.0;
				send_unreliable(peer_id, "turn " + facing, 0);
				debug_log("↓ Rotacionou para trás");
			}
			if(key_pressed(KEY_LEFT) && moveable) {
				if(facing != Left) {
					p.play_stationary("turn.ogg", false);
				}
				facing = Left;
				me.yaw = 270.0;
				send_unreliable(peer_id, "turn " + facing, 0);
				debug_log("← Rotacionou para esquerda");
			}
			if(key_pressed(KEY_RIGHT) && moveable) {
				if(facing != Right) {
					p.play_stationary("turn.ogg", false);
				}
				facing = Right;
				me.yaw = 90.0;
				send_unreliable(peer_id, "turn " + facing, 0);
				debug_log("→ Rotacionou para direita");
			}
		}

		// ===== MOVIMENTAÇÃO LATERAL (LEFT/RIGHT = X) - igual ao BGT =====
		// No BGT: LEFT/RIGHT sem Shift movem no eixo X, não rotacionam!
		
		// DEBUG: Verificar estado das teclas de movimento
		if(loop_count % 200 == 0 && (key_down(KEY_LEFT) || key_down(KEY_RIGHT))) {
			debug_log("🎮 [MOVE DEBUG] LEFT=" + key_down(KEY_LEFT) + " RIGHT=" + key_down(KEY_RIGHT));
			debug_log("🎮 [MOVE DEBUG] G=" + key_down(KEY_G) + " RSHIFT=" + key_down(KEY_RSHIFT) + " LSHIFT=" + key_down(KEY_LSHIFT) + " F=" + key_down(KEY_F));
			debug_log("🎮 [MOVE DEBUG] moveable=" + moveable + " walktimer.elapsed=" + walktimer.elapsed + " walktime=" + walktime);
			debug_log("🎮 [MOVE DEBUG] centado=" + centado + " mapname=" + mapname + " jumping=" + jumping);
			debug_log("🎮 [MOVE DEBUG] platforms.length=" + platforms.length());
		}
		
		// ===== SISTEMA DE VELOCIDADE - CORRER COM ALT =====
		// ALT (KEY_LMENU ou KEY_RMENU) = correr (velocidade maior)
		// Baseado no código original do BGT (Projeto Ig.bgt linha 969)
		if(key_down(KEY_LMENU) && !jumping && crouched == 0 && bicicleta == 0 && camion == 0) {
			walktime = runvelocidade;  // 140ms entre passos (mais rápido)
		}
		else if(jumping) {
			walktime = jumpvelocidade;  // 100ms durante salto
		}
		else if(bicicleta == 1 && bicicletaativa == 1) {
			walktime = bicicletaveloc;  // Velocidade da bicicleta
		}
		else if(camion == 1 && camionativo == 1) {
			walktime = camionveloc;  // Velocidade do caminhão
		}
		else {
			walktime = walkvelocidade;  // 200ms normal
		}
		
		if(key_up(KEY_G) && key_up(KEY_RSHIFT) && key_up(KEY_LSHIFT) && !key_down(KEY_F)) {
			if(moveable && walktimer.elapsed >= walktime && !centado && mapname != "barco") {
				bool moved = false;
				
				// LEFT = mover para esquerda (X-1)
				if(key_down(KEY_LEFT) && abletomove_direction(Left)) {
					walktimer.restart();
					me.x -= 1;
					moved = true;
					debug_log("⬅️ Moveu para esquerda: x=" + me.x);
				}
				// RIGHT = mover para direita (X+1)
				else if(key_down(KEY_RIGHT) && abletomove_direction(Right)) {
					walktimer.restart();
					me.x += 1;
					moved = true;
					debug_log("➡️ Moveu para direita: x=" + me.x);
				}
				
				// Se moveu, verifica lama e toca som
				if(moved) {
					// Verificar tile especial (lama)
					string tile = get_tile_at(me.x, me.y);
					if(string_contains(tile, "mud", 1) > -1) {
						int vv = random(0, 1);
						if(vv == 1) {
							// Escorrega na lama - volta
							if(key_down(KEY_LEFT)) me.x += 1;
							else me.x -= 1;
						}
					}
					
					// Tocar som de passo
					playstep();
					echo = true;
					echotimer.restart();
					
					// Enviar ao servidor
					string step_sound = tile + "step" + random(1, 5) + ".ogg";
					send_reliable(peer_id, "move " + step_sound + " " + me.x + " " + me.y, 0);
					debug_log("📤 Enviado: move " + step_sound + " " + me.x + " " + me.y);
				}
			}
		}

		// ===== MOVIMENTAÇÃO ESPECIAL NO BARCO (key_pressed) =====
		if(mapname == "barco") {
			if(key_pressed(KEY_LEFT) && abletomove()) {
				me.x -= 1;
				playstep();
				echo = true;
				echotimer.restart();
			}
			if(key_pressed(KEY_RIGHT) && abletomove()) {
				me.x += 1;
				playstep();
				echo = true;
				echotimer.restart();
			}
		}

		// ===== PULO COM KEY_UP (igual ao BGT) =====
		// No BGT: KEY_UP sem Shift = pular (não mover!)
		if(key_up(KEY_LSHIFT) && key_up(KEY_RSHIFT)) {
			if(key_pressed(KEY_UP) && !jumping && !falling && key_up(KEY_G) && canijumptimer.elapsed > 50 && moveable && !floating && !floating2 && bicicleta == 0 && camion == 0 && !centado && string_contains(get_tile_at(me.x, (me.y+1)), "wall", 1) < 0) {
				sjumpcheck();
				if(abletojump2 > 0 && dmoving == false) {
					jumptimer.restart();
					p.play_stationary("jump.ogg", false);
					jumping = true;
					pulou = 1;
					ty1 = me.y;
					ty2 = me.y + jumpheight;
					ascending = true;
					send_unreliable(peer_id, "jump", 0);
					debug_log("🦘 Pulou! y=" + me.y + " -> " + ty2);
				}
			}
		}

		// ===== ✅ TASK 2.2: SISTEMA DE ECO PARA NAVEGAÇÃO =====
		if(key_pressed(KEY_E) && moveable) {
			// Acionar eco para detecção de paredes
			calculate_echo_feedback();
			debug_log("🔊 Eco acionado - yaw: " + me.yaw);
		}

		// Eco direcional (Shift+E)
		if(key_pressed(KEY_E) && (key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT)) && moveable) {
			directional_echo();
			debug_log("🧭 Eco direcional acionado");
		}

		// Eco rápido (Ctrl+E)
		if(key_pressed(KEY_E) && (key_down(KEY_LCONTROL) || key_down(KEY_RCONTROL)) && moveable) {
			quick_echo();
			debug_log("⚡ Eco rápido acionado");
		}
		// ===== FIM DO SISTEMA DE ECO =====

		// ===== ✅ TASK 2.2: SISTEMA DE STANCE (SENTAR/LEVANTAR) =====
		// Tecla Q: Sentar/Levantar (como no BGT original)
		// Nota: Agachar (Shift+Space) é processado em stance_control_loop()
		if(key_pressed(KEY_Q) && moveable && !jumping && !ausente) {
			centar();  // Função original do BGT para sentar/levantar
		}
		// ===== FIM DO SISTEMA DE STANCE =====

		if(nandar>-1){
			int id=game_p.play_stationary(get_sound_path("elevador.ogg"), true);
			int d=-1;
			timer t;
			moveable=false;
			while(true){
				wait(5);
				// mainloop(); - removido pois não existe em NVGT
				if(t.elapsed>=100){
					t.restart();
					d=(me.y/20);
					if(nandar==0)d=me.y;
					if(d>nandar){
						me.y--;
						send_reliable(peer_id, "move "+me.x+" "+me.y, 0);
					}
					else if(d<nandar){
						me.y++;
						send_reliable(peer_id, "move "+me.x+" "+me.y, 0);
					}
					d=(me.y/20);
					if(nandar==0)d=me.y;
					if(d==nandar||mapname=="túnel"){
						nandar=-1;
						if(!ausente)moveable=true;
						p.destroy_sound(id);
						if(mapname=="túnel"){
							me.x=1;
							me.y=0;
							send_reliable(peer_id, "move "+me.x+" "+me.y, 0);
						}
						break;
					}
				}
			}
		}
		if(game_lan.nalancha==1)game_lan.loop();
		// mainloop(); - removido pois não existe em NVGT
		if(connected&&temponaoevoce.elapsed>=2000){
			if(game_maquinatempos.length()>0)maquinatempoloop();
			if(objs.length()>0)objsloop();
			if(studo==1)checkitem();
			if(ambientes.length()>0)ambientecheckloop();
			if(sources.length()>0)sourcecheckloop();
			if(staircases.length()>0)staircasecheckloop();
			if(doors.length()>0)doorcheckloop();
			if(elevadors.length()>0)elevadorloop();
			localloop();
			checkloc();
			if(game_areia_movedissas.length()>0)areia_movedissaloop();
			weaponcheckloop();
			secundario();
			if(gmt()!=""&&jumping==false&&pulou==1&&falling==false) pulou=0;
			
			// ===== FÍSICA DE QUEDA =====
			// Se não há tile e não está pulando/caindo, começa a cair
			if(get_tile_at(me.x, me.y) == "" && !falling && !dmoving && !jumping && connected && moveable && !floating && !floating2) {
				falling = true;
			}
			if(falling && connected) {
				fallloop();
			}
			
			// ===== FÍSICA DE SALTO =====
			if(jumping) {
				string step;
				
				// Ápice do salto
				if(atapex && jumptimer.elapsed >= apextime) {
					jumptimer.restart();
					atapex = false;
				}
				
				// Descendo
				if(!ascending && jumptimer.elapsed >= jumptime2 && !atapex) {
					jumptimer.restart();
					me.y -= 1;
					if(me.y <= ty1) {
						me.y = ty1;
						step = get_tile_at(me.x, me.y) + "land.ogg";
						p.play_stationary(step, false);
						send_unreliable(peer_id, "move " + step + " " + me.x + " " + me.y, 0);
						send_unreliable(peer_id, "land", 0);
						jumping = false;
						canijumptimer.restart();
					}
					if(jumping) {
						checkforplatforms();
					}
				}
				
				// Subindo
				if(ascending && jumptimer.elapsed >= jumptime) {
					jumptimer.restart();
					me.y += 1;
					send_unreliable(peer_id, "move2 " + me.x + " " + me.y, 0);
					checkforwalls();
					if(me.y >= ty2) {
						ascending = false;
						jumptimer.restart();
						atapex = true;
					}
				}
			}
		}
		// Processar eventos de rede do jogo
		if(connected) {
			netloop(); // Processa todos os eventos de rede (movimentos, itens, jogadores, etc)
		}
		
		// ===== 🆕 TECLAS QUE FUNCIONAM MESMO EM MODO AUSENTE =====
		// Shift+F1 (AFK) e Shift+F2 (Pacífico) precisam funcionar SEMPRE
		// para permitir sair do modo ausente
		if(shift_pressionado()) {
			if(key_pressed(KEY_F1)) {
				send_reliable(peer_id, "/afk", 0);
			}
			if(key_pressed(KEY_F2)) {
				send_reliable(peer_id, "/pacifista", 0);
			}
		}
		
		// ===== TECLAS PRINCIPAIS DO JOGO (F1-F8, ATALHOS, ETC) =====
		// Esta é a "ponte" que ativa todos os comandos de gameplay
		// CORREÇÃO: Chamar tprincipais() sempre que não estiver ausente,
		// independente de connected (que só controla rede)
		if(!ausente && !exiting) {
			// DEBUG: Log periódico para verificar se chegamos aqui
			if(loop_count % 500 == 0) {
				debug_log("🎮 tprincipais() sendo chamado (connected=" + connected + ", ausente=" + ausente + ", exiting=" + exiting + ")");
			}
			tprincipais(); // Processa F1-F8, Shift+teclas, menus, etc.
			
			// ===== SISTEMA DE CÂMERA DE EXPLORAÇÃO (G+teclas) =====
			camera_exploration_loop();  // Processa G+setas para mover câmera
			camera_check_release();     // Reseta câmera quando G é solto
			
			// ===== ✅ TASK 2.2: SISTEMA DE POSTURA (AGACHAR/SENTAR) =====
			stance_control_loop();      // Processa Shift+Space (agachar) e Z (sentar)
			
			// ===== ✅ TASK 2.6: SISTEMA DE BEACON E RASTREAMENTO =====
			// Beacon loop (sons de outros jogadores no mapa)
			if(beaconing == 1) {
				looping = false;
				beaconloop();
			}
			
			// Rastreamento de jogador específico (F4)
			if(playertrack != "" && looping) {
				int tracked_index = get_player(playertrack);
				if(tracked_index == -1) {
					// Jogador saiu do mapa ou desconectou
					speak(pu.get_value("Rastreamento perdido."));
					looping = false;
					playertrack = "";
				}
				else if(looptimer.elapsed >= looptime) {
					looptimer.restart();
					// Tocar beacon na posição do jogador rastreado
					p.play_2d("beacon.ogg", me.x, me.y, players[tracked_index].x, players[tracked_index].y, false);
				}
			}
		} else {
			// DEBUG: Por que não está chamando tprincipais?
			if(loop_count % 500 == 0) {
				debug_log("⚠️ tprincipais() NÃO será chamado (connected=" + connected + ", ausente=" + ausente + ", exiting=" + exiting + ")");
			}
		}
		
		// Verificar se está saindo do jogo
		if(exiting && exittimer.elapsed >= exittime) {
			debug_log("🚪 Saindo do jogo e voltando ao menu...");
			exittimer.restart();
			exiting = false;
			reset();
			menuprincipal();
			return; // Sai da função game()
		}
		
		// ===== SISTEMA DE RECONEXÃO COM BACKOFF EXPONENCIAL =====
		// Quando relogin_flag é ativado, inicia espera com timer
		if(relogin_flag && !waiting_to_reconnect) {
			waiting_to_reconnect = true;
			reconnect_timer.restart();
			reconnect_attempts++;
			
			// Calcular delay com backoff exponencial: 1s, 2s, 4s, 8s, 16s, 30s (máximo)
			reconnect_delay = MIN_RECONNECT_DELAY;
			for(int i = 1; i < reconnect_attempts && reconnect_delay < MAX_RECONNECT_DELAY; i++) {
				reconnect_delay = reconnect_delay * 2;
			}
			if(reconnect_delay > MAX_RECONNECT_DELAY) {
				reconnect_delay = MAX_RECONNECT_DELAY;
			}
			
			speak("Reconectando em " + (reconnect_delay / 1000) + " segundos... (tentativa " + reconnect_attempts + ")");
			debug_log("🔄 Backoff: tentativa " + reconnect_attempts + ", delay " + reconnect_delay + "ms");
		}
		
		// Quando o timer expira, tenta reconectar
		if(waiting_to_reconnect && reconnect_timer.elapsed >= reconnect_delay) {
			waiting_to_reconnect = false;
			relogin_flag = false;
			debug_log("🔄 Tentando reconectar agora...");
			reset();
			net_logar();
			return; // Sai do loop para reconectar
		}
		
		if(key_pressed(KEY_F9) && (desenvolvedordm==1 || is_dev || is_admin || is_moderator || is_builder)){
			adminmenu();
		}
		
		// ✅ Chat Administrativo - Tecla D (como no BGT)
		// Só para desenvolvedores, admins e moderadores
		if(key_pressed(KEY_D) && !ausente && !key_down(KEY_G) && !key_down(KEY_F) && !key_down(KEY_LALT) && !key_down(KEY_RALT)) {
			if(desenvolvedordm == 1 || is_dev || is_admin || is_moderator) {
				chat_administrativo();
			}
		}
		if(key_pressed(KEY_ESCAPE)){
			debug_log("⚠️ ESC pressionado! Chamando exitmenu()");
			exitmenu();
		}

		// Atalho social: F7
		if(key_pressed(KEY_F7) && !ausente) {
			menu_social_principal();
		}
		
		// ===== TECLAS DE INFORMAÇÃO =====
		// Tecla C: Coordenadas
		if(key_pressed(KEY_C) && !ausente) {
			string coord_msg = me.x + ", " + me.y;
			speak(coord_msg);
			debug_log("📍 Coordenadas: " + coord_msg);
		}
		
		// Tecla B: Localização/Zona
		if(key_pressed(KEY_B) && !ausente) {
			speak_zone();  // Fala a descrição da zona atual
			debug_log("🗺️ B pressionado - chamando speak_zone()");
		}
		
		// Tecla S: Status de saúde
		if(key_pressed(KEY_S) && !ausente) {
			send_unreliable(peer_id, "healthcheck", 0);
			debug_log("⌨️ S pressionado - enviando 'healthcheck'");
		}
		
		// Tecla V: Ver nível e estatísticas
		if(key_pressed(KEY_V) && !ausente) {
			send_unreliable(peer_id, "lc", 0);
			debug_log("⌨️ V pressionado - enviando 'lc' (level check)");
		}
		
		// Tecla M: Radar (sem Shift) ou Check Items (com Shift)
		if(key_pressed(KEY_M) && !ausente) {
			if(shift_pressionado()) {
				send_unreliable(peer_id, "check_items", 0);
				debug_log("⌨️ Shift+M pressionado - enviando 'check_items'");
			} else {
				send_unreliable(peer_id, "r", 0);
				debug_log("⌨️ M pressionado - enviando 'r' (radar)");
			}
		}
		
		// Tecla P: Ver equipamento vestido
		if(key_pressed(KEY_P) && !ausente) {
			send_unreliable(peer_id, "/vestindo", 0);
			debug_log("⌨️ P pressionado - enviando '/vestindo'");
		}
		
		// Tecla F10: Menu de opções do jogo
		if(key_pressed(KEY_F10) && !ausente) {
			optionsmenu2();
			debug_log("⌨️ F10 pressionado - abrindo menu de opções");
		}
		
		// Tecla I é processada em tprincipais() (comandos.nvgt) para evitar dupla execução
		
		// ✅ Task 3.3: Verificar teclas de atalho para frases rápidas e tradução
		check_quick_phrase_keys();
		
		// Log de teclas de movimento
		if(key_down(KEY_UP) || key_down(KEY_DOWN) || key_down(KEY_LEFT) || key_down(KEY_RIGHT)) {
			if(loop_count % 50 == 0) { // Log a cada 50 iterações com tecla pressionada
				debug_log("⌨️ Tecla de movimento detectada!");
			}
		}
	}
}

// Funções auxiliares convertidas de BGT para NVGT
void reset(){
	if(streamurl >= 0){
		audio_stream_primary.stop(streamurl);
		audio_stream_primary.unload(streamurl);
		streamurl = -1;
	}
	ausente=false;
	lan.nalancha=0;
	dveloz=0;
	desenvolvedordm=0;
	modera=0;
	nolhar="";
	falhou=0;
	pulou=0;
	destroy_all_doors();
	destroy_all_msounds();
	destroy_all_elevadors();
	bolhadear=false;
	connected=false;
	connect=false;
	term=false;
	exiting=false;
	objs.resize(0);
	players.resize(0);
	star=false;
	moveable=true;
	floating=false;
	jumpheight=5;
	destroy_all_sources();
	destroy_all_ambientes();
	chuvatelhado.close();
	carregandotaser.close();
	novato=0;
	map.resize(0);
	destroy_all_staircases();
	p.destroy_all();
	p2.destroy_all();
	pobjs.destroy_all();
	pcomputador.destroy_all();
	forcepinging=false;
	net_peer_id=0;
	inv="";
	apartamentoinv="";
	reset_all_forced_keys();
	floating=false;
	cloaked=false;
	mapname="";
	garbage_collect();
}

void checkloc(){
	if (get_zone_at(me.x,me.y)!=""){
		string locate=get_zone_at(me.x,me.y);
		if (locate!=currentloc){
			if (zonestatus==1)
			if(locate!=".")speak(pu.get_value(locate));
			currentloc=locate;
		}
	}
	else{
		if (currentloc!=""){
			if (zonestatus==1)
			speak(pu.get_value("Área para exploração."));
			currentloc="";
		}
	}
}

void track_thing(int x, int y){
	tracker.x=x;
	tracker.y=y;
}

void tell_where(int x, int y){
	if (me.x<=x){
		godir="direita";
		go=x-me.x;
	}
	else if (me.x>=x){
		godir="esquerda";
		go=me.x-x;
	}
	if (me.y<=y){
		godir2="acima";
		go2=y-me.y;
	}
	else if (me.y>=y){
		godir2="abaixo";
		go2=me.y-y;
	}
	speak(pu.get_value(godir)+" "+go+" "+pu.get_value("e")+" "+pu.get_value(godir2)+" "+go2);
}

bool stepcheck(double val){
	return true;
}

bool movecheck(double val){
	string v=val;
	v+="=";
	if (v.find(".5=")>=0){
		return true;
	}
	else{
		return false;
	}
}

void reiniciar(){
	writeprefs();
	if(SCRIPT_COMPILED==true){
		run(SCRIPT_EXECUTABLE, "reiniciar "+COMMAND_LINE, false, false);
	}
	else{
		run(SCRIPT_EXECUTABLE, SCRIPT_CURRENT_FILE, false, false);
	}
	exit();
}

// Funções de inventário convertidas de BGT para NVGT (agora usando dictionary player_inv)
void inv_add_item(string itemname, int itemvalue){
	if(itemname == "") return;

	int current = 0;
	if(player_inv.exists(itemname)) {
		player_inv.get(itemname, current);
	}

	int new_value = current + itemvalue;

	if(new_value <= 0) {
		player_inv.delete(itemname);
	} else {
		player_inv.set(itemname, new_value);
	}
}

bool inv_item_exists(string itemname){
	return player_inv.exists(itemname);
}

int inv_item_number(string itemname){
	if(!player_inv.exists(itemname)) return 0;

	int quantity = 0;
	player_inv.get(itemname, quantity);
	return quantity;
}

int inv_item(string itemname){
	string content=inv;
	string[] peramitors=content.split("\r\n");
	string[] values;
	for(uint i=0; i<peramitors.length(); i++){
		int eq_pos = peramitors[i].find("=");
		if(eq_pos >= 0) {
			values.insert_at(i, peramitors[i].substr(eq_pos+1));
			peramitors[i] = peramitors[i].substr(0, eq_pos);
		}
	}
	for(uint i=0; i<peramitors.length(); i++){
		if(peramitors[i]==itemname){
			return i;
		}
	}
	return -1;
}

void inv_delete_item(string itemname){
	if(player_inv.exists(itemname)) {
		player_inv.delete(itemname);
	}
}

void give(string item){
	string char=daritem();
	if(char==""){
		speak(pu.get_value("Ninguém perto de você."));
	}
	else{
		string amount=v.input(pu.get_value("Quantos você quer dar para")+" "+char+"?");
		if (char!="" and amount!=""){
			send_reliable(peer_id,"give "+char+" "+item+" "+amount, 0);
		}
	}
}

void checkitem(){
	for (uint i=0; i<objs.length(); i++){
		if (objs[i].x==me.x and objs[i].y==me.y){
			objs.remove_at(i);
			send_reliable(peer_id, "PICKUP:chao", 0);
			break;
		}
	}
}

void drop(string item,int amount=1){
	if(amount < 1 || amount > 100000000000) return;
	if(!inv_item_exists(item)) return;

	send_reliable(peer_id, "DROP:" + item + "|" + amount, 0);
	debug_log("🗑️ Dropando " + amount + "x " + item);
}

void auction(string item){
	int amount=to_number(v.input("Quantos?"));
	string minbid2=v.input("Quantidade mínima para a oferta deste leilão?");
	int minbid=to_number(minbid2);
	if(amount>0&&amount<1000000000&&minbid>0&&minbid<1000000000){
		send_reliable(peer_id,"/auction "+amount+" "+item+" "+minbid, 0);
	}
}

void echocheck(int dir){
	string ptyle=get_tile_at(game_me.x, game_me.y);
	if(ptyle==""&&jumping==false&&pulou==0&&mapname!="túnel"&&!dcheck_flag&&!echeck_flag&&moveable){
		game_echotimer.restart();
		pulou=1;
		game_echo=false;
		send_reliable(peer_id, "draw caiu.ogg", 0);
		game_p.play_stationary(get_sound_path("caiu.ogg"), false);
		return;
	}
}
