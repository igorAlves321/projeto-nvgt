// Função principal convertida de BGT para NVGT
void main(){
	debug_log("🚀 CLIENTE INICIANDO...");
	// Instância para verificar se já está rodando
	instance fd(EXECUTABLE_NAME);
	debug_log("✓ Verificação de instância concluída");
	
	// Inicializar sistema de localização I18N (Necessário para mensagens de erro abaixo)
	init_localization_system();
	debug_log("✅ Sistema de localização I18N inicializado (Early Init)");

	// Verificar se SOUND_STORAGE existe (pode ser pasta ou arquivo)
	bool tem_pasta_sounds = directory_exists(SOUND_STORAGE);
	bool tem_arquivo_dat = file_exists(SOUND_STORAGE);
	
	if(!tem_pasta_sounds && !tem_arquivo_dat) {
		// Mensagem amigável informando como resolver (LOCALIZADO)
		string mensagem = LF("STARTUP_NO_SOUNDS_HEADER", SOUND_STORAGE);
		
		if(SOUND_STORAGE == "sounds") {
			mensagem += L("STARTUP_NO_SOUNDS_OPT1");
		} else {
			mensagem += LF("STARTUP_NO_SOUNDS_OPT2", SOUND_STORAGE);
		}
		
		mensagem += L("STARTUP_NO_SOUNDS_FOOTER");
		
		alert(L("STARTUP_NO_SOUNDS_TITLE"), mensagem);
		speak(L("STARTUP_SPEAK_NO_SOUNDS"));
		exit();
	}
	
	// Informar qual método de som está sendo usado
	if(tem_pasta_sounds) {
		debug_log("✓ SOUND_STORAGE verificado: usando pasta 'sounds'");
		// Se for pasta, não precisa abrir pack - os sons são carregados diretamente
		// Não configuramos sound_default_pack neste caso
	} else {
		debug_log("✓ SOUND_STORAGE verificado: usando arquivo pack '" + SOUND_STORAGE + "'");
		
		// Abrir pack de sons DIRETAMENTE (método do Batalha Constante)
		debug_log("🔧 Tentando abrir pack: " + SOUND_STORAGE);
		if(!global_sound_pack.open(SOUND_STORAGE, PACK_OPEN_MODE_READ)) {
			debug_log("❌ ERRO: Falha ao abrir " + SOUND_STORAGE);
			alert(L("STARTUP_SOUND_ERROR_TITLE"), LF("STARTUP_SOUND_ERROR_MSG", SOUND_STORAGE));
			exit();
		}
		debug_log("✅ Pack aberto com sucesso!");
		
		// Atribuir ao sound_default_pack (igual Batalha Constante)
		@sound_default_pack = @global_sound_pack;
		debug_log("✅ sound_default_pack configurado!");
		
		// Testar listando arquivos
		string[] pack_files = global_sound_pack.list_files();
		debug_log("📋 Pack contém " + pack_files.length() + " arquivos");
		if(pack_files.length() > 0) {
			debug_log("📄 Primeiros 5 arquivos:");
			for(uint i = 0; i < 5 && i < pack_files.length(); i++) {
				debug_log("   - " + pack_files[i]);
			}
		}
		
		// Chave de descriptografia
		set_sound_decryption_key(SOUND_ENCRYPTION_KEY, false);
	}
	
	// Áudio inicializado automaticamente pelo NVGT
	
	// Configurar todos os sound_pools com o pack (igual Batalha Constante)
	configure_sound_pools();
	debug_log("✅ Sound pools configurados com pack!");
	
	abrir();
	
	// Inicializar sistema de inventário
	init_inventory();
	debug_log("✅ Sistema de inventário inicializado");
	
	// Inicializar sistema QoL (Frases Rápidas + Tradução)
	init_qol_client();
	debug_log("✅ Sistema QoL inicializado");
	
	// Inicializar sistema de favoritos de armas
	init_weapon_favorites();
	debug_log("✅ Sistema de favoritos de armas inicializado");
	
	// Inicializar sistema de localização I18N (Já inicializado no início de main)
	// init_localization_system();

	// Inicializar sistema de voice chat
	init_voice_chat();
	debug_log("✅ Sistema de voice chat inicializado (HRTF ativo)");

	// Inicializar sistema de moving sounds V2
	init_moving_sounds();
	debug_log("✅ Sistema de moving sounds V2 inicializado");

	p.max_distance=30;
	bool achou=false;
	string pasta="C:/Program Files";
	if(directory_exists(pasta+" (x86)"))pasta+=" (x86)";
	string[] z=find_directories(pasta+"/*");
	for(uint i=0;i<z.length();i++){
		if(z[i].lower().find("cheat")>=0||z[i].lower().find("engine")>=0)achou=true;
	}
	if(directory_exists(DIRECTORY_TEMP+"\\Cheat Engine")){
		achou=true;
	}
	if(fd.is_already_running||achou==true){
		sair();
	}
	sons.insert_last("body1.ogg:1");
	sons.insert_last("body2.ogg:2");
	sons.insert_last("body3.ogg:3");
	sons.insert_last("body4.ogg:4");
	sons.insert_last("body5.ogg:5");
