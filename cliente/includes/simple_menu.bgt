class simple_menu{
string tittle;
string[] items, identifiers;
bool allow_esc=true, allow_enter=true, allow_space=true, allow_home_and_end=true;
int allow_keys_pressing=1;
int counter =-1;
void add_item_tts(string text, string identifier=""){
if(identifier=="") identifier=text;
items.insert_last(text);
identifiers.insert_last(identifier);
}
int monitor(string text){
speak(text);
while(true){
wait(5);
if(!connected) verificando();
if(connected) mainloop();
if(allow_esc==true&&key_pressed(KEY_ESCAPE)){
return 0;
}
if(allow_keys_pressing==0){
if(key_pressed(KEY_LEFT)&&counter>0){
counter--;
speak(items[counter]);
}
if(key_pressed(KEY_RIGHT)&&counter<items.length()-1){
counter++;
speak(items[counter]);
}
}
if(allow_keys_pressing==1){
if(left.pressing()&&counter>0){
counter--;
speak(items[counter]);
}
if(right.pressing()&&counter<items.length()-1){
counter++;
speak(items[counter]);
}
}
if(allow_enter==true&&key_pressed(KEY_RETURN)&&counter>-1||allow_enter==true&&key_pressed(KEY_NUMPADENTER)&&counter>-1||allow_space==true&&key_pressed(KEY_SPACE)&&counter>-1){
return counter;
}
if(allow_home_and_end){
if(key_pressed(KEY_HOME)&&counter>0){
counter=0;
speak(items[counter]);
}
if(key_pressed(KEY_END)&&counter<items.length()-1){
counter=items.length()-1;
speak(items[counter]);
}
}
}
return -1;
}
string get_item_name(int index){
if(identifiers.length()>0){
return identifiers[index];
}
return "";
}
}
