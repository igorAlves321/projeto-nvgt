// Menu de músicas
void musicmenu() {
	setupmenu();
	if(ausente || !player_moveable) return;
	
	game_menu.add_item(pu.get_value("Mega mix corridos força rúgida, os rapazes do rancho e mais."), "test.ogg");
	game_menu.intro_text = pu.get_value("Selecione a música que quer ouvir.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id != "back" && mres > 0) {
		game_net.send(net_peer_id, encrypt_packet("escucharmixs " + selected_id), 0, false);
	}
}

