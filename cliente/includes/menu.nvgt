// Missing function stubs that need to be converted from BGT
string daritem(){
	if(ausente||!moveable)return "";
	menusilent();
	for (int i=game_me.x-3; i<=game_me.x+3; i++){
		for (uint i2=0; i2<game_players.length(); i2++){
			if (game_players[i2].x==i&&game_players[i2].charname!=un&&game_players[i2].mapname==mapname&&game_players[i2].y==game_me.y&&game_players[i2].beeping==1){
				game_menu.add_item(game_players[i2].charname,game_players[i2].charname);
			}
		}
	}
	game_menu.intro_text = pu.get_value("Selecione o jogador que deseja");
	int mres=game_menu.run();
	if(mres==-1){
		speak(pu.get_value("Ninguém por perto."));
		return"";
	}
	else return game_menu.get_item_id(mres);
}

