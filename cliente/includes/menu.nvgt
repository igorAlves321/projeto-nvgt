// Menu de feitiços/magias
void spellmenu(string data) {
	if(dbaculo == 1) return;
	if(ausente || !player_moveable) return;
	
	string[] spells = data.split("\r\n");
	setupmenu();
	
	for(uint i = 0; i < spells.length(); i++) {
		string[] parsed = spells[i].split(":");
		if(parsed.length() > 0) {
			game_menu.add_item(pu.get_value(spells[i]), parsed[0]);
		}
	}
	
	game_menu.intro_text = pu.get_value("Escolha uma magia para lançar.");
	int mres = game_menu.run();
	
	if(mres > 0) {
		string spell = game_menu.get_item_id(mres);
		game_net.send(net_peer_id, encrypt_packet("spellcast " + spell + " " + facing), 0, false);
	}
}

// Menu genérico do servidor (recebe dados do servidor)
void menuserver(string text, string packet_to_send, int channel, string[] items, string[] sounds) {
	game_menu.reset(true);
	
	// Sons customizados
	if(sounds.length() >= 3) {
		game_menu.click_sound = sounds[0];
		game_menu.select_sound = sounds[1];
		game_menu.open_sound = sounds[2];
	}
	
	// Itens do menu
	for(uint i = 0; i < items.length(); i++) {
		string[] parsed = items[i].split("=");
		if(parsed.length() > 1) {
			string text_to_show = translate_with_char(parsed[0], ";");
			game_menu.add_item(text_to_show, parsed[1]);
		}
	}
	
	game_menu.intro_text = translate_with_char(text, ";");
	int mres = game_menu.run();
	
	if(mres > 0) {
		game_net.send(net_peer_id, encrypt_packet(packet_to_send + " " + game_menu.get_item_id(mres)), channel, false);
	}
}

// Menu normal (formato simplificado do servidor)
void mnormal(string mensagem) {
	setupmenu();
	
	string[] mmensagem = mensagem.split("\r\n");
	if(mmensagem.length() == 0) return;
	
	string[] bla = mmensagem[0].split(":");
	
	for(uint i = 1; i < mmensagem.length(); i++) {
		string[] z = mmensagem[i].split(":");
		if(z.length() >= 2) {
			game_menu.add_item(pu.get_value(z[0]), z[1]);
		}
	}
	game_menu.add_item(pu.get_value("Voltar"), "0");
	
	game_menu.intro_text = pu.get_value(bla[0]);
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id != "0") {
		game_net.send(net_peer_id, encrypt_packet(bla[1] + " " + selected_id), 0, false);
	}
}

// Menu normal 2 (usando separador alternativo)
void mnormal2(string mensagem) {
	setupmenu();
	
	string[] mmensagem = mensagem.split("\r\n");
	if(mmensagem.length() == 0) return;
	
	string[] bla = mmensagem[0].split(bell2);
	
	for(uint i = 1; i < mmensagem.length(); i++) {
		string[] z = mmensagem[i].split(bell2);
		if(z.length() >= 2) {
			game_menu.add_item(pu.get_value(z[0]), z[1]);
		}
	}
	game_menu.add_item(pu.get_value("Voltar"), "0");
	
	game_menu.intro_text = pu.get_value(bla[0]);
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id != "0") {
		game_net.send(net_peer_id, encrypt_packet(bla[1] + " " + selected_id), 0, false);
	}
}

// Menu de texto (prompt simples)
void mtext(string title, string packet_to_send, string char_separator, int channel) {
	input_form form(translate_with_char(title, ";"));
	form.add_text_field("text", pu.get_value("Digite"), "", true);
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		string text = "";
		result.get("text", text);
		if(text.length() > 0) {
			game_net.send(net_peer_id, encrypt_packet(packet_to_send + char_separator + text), channel, true);
		}
	}
}

