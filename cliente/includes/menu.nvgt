}

// Menu de serviços
void servicesmenu() {
	setupmenu();
	if(ausente || !player_moveable) return;
	
	game_menu.add_item(pu.get_value("Converta seu dinheiro."), "conversiones");
	game_menu.add_item(pu.get_value("Alterar status."), "status");
	game_menu.add_item(pu.get_value("Colocar Recompensa"), "bounty");
	game_menu.add_item(pu.get_value("Escolher chat."), "escolherchat");
	game_menu.add_item(pu.get_value("Alterar o nome."), "changename");
	game_menu.add_item(pu.get_value("Pagar o aluguel."), "pay");
	game_menu.add_item(pu.get_value("Ver tempos restantes de poções."), "times");
	game_menu.add_item(pu.get_value("Ver construções atualmente disponíveis."), "list_crafts");
	game_menu.add_item(pu.get_value("Ligar para um serviço."), "llamar");
	game_menu.add_item(pu.get_value("Gerenciar categorias."), "manage_categories");
	game_menu.add_item(pu.get_value("Alterar o nome do seu filhote."), "rnc");
	game_menu.add_item(pu.get_value("botão voltar."), "back");
	
	game_menu.intro_text = pu.get_value("Escolha o serviço que desejar.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "back") {
		celularmenu();
	}
	else if(selected_id == "conversiones") {
		convertermenu();
	}
	else if(selected_id == "status") {
		input_form form(pu.get_value("Alterar status"));
		form.add_text_field("status", pu.get_value("escreva seu novo status."), "", true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string status = "";
			result.get("status", status);
			if(status != "" && status.length() <= 4096) {
				game_net.send(net_peer_id, encrypt_packet("/setstatus " + status), 1, true);
			}
		}
	}
	else if(selected_id == "escolherchat") {
		speak(pu.get_value("Funcionalidade desativada no momento."));
	}
	else if(selected_id == "bounty") {
		game_net.send(net_peer_id, encrypt_packet("bounty_menu"), 0, true);
	}
	else if(selected_id == "changename") {
		input_form form(pu.get_value("Alterar nome"));
		form.add_text_field("name", pu.get_value("Escreva o novo nome que deseja para seu personagem."), "", true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string name = "";
			result.get("name", name);
			if(name != "" && !msginvalida(name) && name.length() < 30) {
				game_net.send(net_peer_id, encrypt_packet("change_name " + name), 0, true);
			}
		}
	}
	else if(selected_id == "pay") {
		bool confirm = simple_yes_no(pu.get_value("Deseja pagar as contas do aluguel agora?"));
		if(confirm) {
			game_net.send(net_peer_id, encrypt_packet("pay_island"), 13, true);
		}
	}
	else if(selected_id == "times") {
		game_net.send(net_peer_id, encrypt_packet("times"), 0, false);
	}
	else if(selected_id == "list_crafts") {
		game_net.send(net_peer_id, encrypt_packet("list_crafts"), 13, true);
	}
	else if(selected_id == "llamar") {
		// Sistema de telefone - usando input_form
		input_form form(pu.get_value("Ligar"));
		form.add_number_field("number", pu.get_value("Digite o número"), 0, true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			double telefonar_num = 0;
			result.get("number", telefonar_num);
			string telefonar = "" + int(telefonar_num);
			
			if(telefonar == "4376238") {
				sound s;
				s.load(get_sound_path("telefone.ogg"));
				int a = random(2, 4);
				for(int i = 0; i < a; i++) {
					s.play();
					while(s.playing) {
						// mainloop() removido - não existe em NVGT, wait() já processa eventos
						wait(5);
					}
				}
				game_net.send(net_peer_id, encrypt_packet("comida opcion"), 0, false);
			}
			else if(telefonar == "7124869") {
				sound s;
				s.load(get_sound_path("telefone.ogg"));
				int a = random(2, 4);
				for(int i = 0; i < a; i++) {
					s.play();
					while(s.playing) {
						// mainloop() removido - não existe em NVGT, wait() já processa eventos
						wait(5);
					}
				}
				game_net.send(net_peer_id, encrypt_packet("nave"), 0, false);
			}
			else if(telefonar == "3812742") {
				game_net.send(net_peer_id, encrypt_packet("arena"), 13, true);
			}
		}
	}
	else if(selected_id == "manage_categories") {
		actions_menu("inv", "menu_opcao");
	}
	else if(selected_id == "rnc") {
		game_net.send(net_peer_id, encrypt_packet("rnc"), 0, true);
	}
}

// Menu de chat
void chatmenu() {
	speak(pu.get_value("Funcionalidade desativada no momento."));
	return;

	setupmenu();
	game_menu.add_item(pu.get_value("Chat global"), "global");
	game_menu.add_item(pu.get_value("Chat regional"), "regional");
	game_menu.add_item(pu.get_value("Chat de equipe"), "team");
	game_menu.add_item(pu.get_value("Voltar"), "back");
	
	game_menu.intro_text = pu.get_value("Escolha o canal de chat.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(mres <= 0 || selected_id == "back") return;
	
	if(selected_id == "global") {
		game_net.send(net_peer_id, encrypt_packet("/setchannel global"), 1, true);
		speak(pu.get_value("Chat global selecionado"));
	}
	else if(selected_id == "regional") {
		game_net.send(net_peer_id, encrypt_packet("/setchannel regional"), 1, true);
		speak(pu.get_value("Chat regional selecionado"));
	}
	else if(selected_id == "team") {
		game_net.send(net_peer_id, encrypt_packet("/setchannel team"), 1, true);
		speak(pu.get_value("Chat de equipe selecionado"));
	}
	
	// Removed servicesmenu() call to prevent enforcing a specific navigation flow
	// User stays in game after selection, or caller handles loop.
}

