// Função de seleção de idiomas
string idiomas() {
	// Usando glob() do NVGT para listar arquivos .lang
	string[]@ soundfiles = glob("lang/*.lang");
	
	if(soundfiles.length() <= 0) {
		speak(pu.get_value("Nenhum arquivo de idioma encontrado."));
		return "";
	}
	
	setupmenu();
	for(uint i = 0; i < soundfiles.length(); i++) {
		// Extrair apenas o nome do arquivo sem o caminho e extensão
		// Normalizar separadores para garantir que string_split funcione em Windows e Linux
		string normalized_path = soundfiles[i].replace("\\", "/");
		string filename = string_split(normalized_path, "/")[-1];
		filename = filename.replace(".lang", "");
		
		// Mapear para nome amigável
		string display_name = filename;
		string lower_name = filename.lower();
		
		if(lower_name == "portuguese" || lower_name == "portugues") display_name = "Português";
		else if(lower_name == "english") display_name = "English";
		else if(lower_name == "spanish" || lower_name == "espanol") display_name = "Español";
		else if(lower_name == "french" || lower_name == "francais") display_name = "Français";
		else if(lower_name == "turkish" || lower_name == "turco") display_name = "Türkçe";
		else {
			// Capitalizar primeira letra se não for um dos conhecidos
			if(display_name.length() > 0) {
				display_name = display_name.substr(0, 1).upper() + display_name.substr(1);
			}
		}
		
		game_menu.add_item(display_name, soundfiles[i]);
	}
	game_menu.add_item(pu.get_value("Voltar"), "back");
	
	game_menu.intro_text = pu.get_value("Escolha o arquivo de idioma que deseja usar.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "back") {
		return "";
	}
	else return selected_id;
}

