// Seleção de jogador próximo para transferência de itens
string daritem(){
	if(ausente||!moveable)return "";
	menusilent();
	for (int i=game_me.x-3; i<=game_me.x+3; i++){
		for (uint i2=0; i2<game_players.length(); i2++){
			if (game_players[i2].x==i&&game_players[i2].charname!=un&&game_players[i2].mapname==mapname&&game_players[i2].y==game_me.y&&game_players[i2].beeping==1){
				game_menu.add_item(game_players[i2].charname,game_players[i2].charname);
			}
		}
	}
	game_menu.intro_text = pu.get_value("Selecione o jogador que deseja");
	int mres=game_menu.run();
	if(mres==-1){
		speak(pu.get_value("Ninguém por perto."));
		return"";
	}
	else return game_menu.get_item_id(mres);
}

string get_player_username_by_index(int index) {
	// Compatibilidade: retorna username pelo índice no array local.
	if(index >= 0 && index < game_players.length()) {
		return game_players[index].charname;
	}
	return "";
}

// Menu de voz usando as vozes disponíveis no TTS do NVGT
void voicemenu() {
	refresh_voice_list();
	string[] voices = get_voice_names();
	if(voices.length() == 0) {
		dlg(pu.get_value("Nenhuma voz disponível."));
		perfio();
		return;
	}

	int original_voice = voice;
	int original_rate = ttsrate;
	int original_tts_voice = tts.voice;
	int original_tts_rate = tts.rate;
	int candidate_voice = voice;
	if(candidate_voice < 0 || candidate_voice >= int(voices.length())) {
		candidate_voice = game_tts.voice >= 0 ? game_tts.voice : 0;
	}
	if(candidate_voice < 0 || candidate_voice >= int(voices.length())) candidate_voice = 0;
	int candidate_rate = ttsrate;
	bool saved = false;

	while(true) {
		setupmenu();
		for(uint i = 0; i < voices.length(); i++) {
			string label = voices[i];
			if(label == "") label = pu.get_value("Voz") + " " + int_to_string(int(i) + 1);
			if(int(i) == candidate_voice) label = "* " + label;
			string voice_id = "voice:" + int_to_string(int(i));
			game_menu.add_item(label, voice_id);
		}
		game_menu.add_item(pu.get_value("Testar voz"), "preview");
		game_menu.add_item(pu.get_value("Aumentar velocidade"), "rate_up");
		game_menu.add_item(pu.get_value("Diminuir velocidade"), "rate_down");
		game_menu.add_item(pu.get_value("Salvar"), "save");
		game_menu.add_item(pu.get_value("Cancelar"), "cancel");
		game_menu.intro_text = pu.get_value("Selecione uma voz e ajuste a velocidade.") + " (" + int_to_string(candidate_rate) + ")";

		int choice = game_menu.run();
		if(choice == -1) {
			break;
		}
		string selected_id = game_menu.get_item_id(choice);
		if(selected_id.length() > 6 && selected_id.substr(0, 6) == "voice:") {
			int new_voice = string_to_number(selected_id.substr(6));
			if(new_voice >= 0 && new_voice < int(voices.length())) {
				candidate_voice = new_voice;
				string selected_name = voices[candidate_voice];
				if(selected_name == "") selected_name = pu.get_value("Voz") + " " + int_to_string(candidate_voice + 1);
				speak(pu.get_value("Voz selecionada.") + " " + selected_name);
			}
			continue;
		}
		if(selected_id == "preview") {
			if(candidate_voice >= 0 && candidate_voice < int(voices.length())) {
				if(tts.voice != candidate_voice) tts.set_voice(candidate_voice);
				if(game_tts.voice != candidate_voice) game_tts.set_voice(candidate_voice);
				if(tts.rate != candidate_rate) tts.set_rate(candidate_rate);
				if(game_tts.rate != candidate_rate) game_tts.set_rate(candidate_rate);
				speak(pu.get_value("Esta é uma mensagem de teste."));
			}
			continue;
		}
		if(selected_id == "rate_up") {
			if(candidate_rate < 10) candidate_rate++;
			speak(pu.get_value("Velocidade") + ": " + int_to_string(candidate_rate));
			continue;
		}
		if(selected_id == "rate_down") {
			if(candidate_rate > -10) candidate_rate--;
			speak(pu.get_value("Velocidade") + ": " + int_to_string(candidate_rate));
			continue;
		}
		if(selected_id == "save") {
			voice = candidate_voice;
			ttsrate = candidate_rate;
			if(tts.voice != voice) tts.set_voice(voice);
			if(game_tts.voice != voice) game_tts.set_voice(voice);
			if(tts.rate != ttsrate) tts.set_rate(ttsrate);
			if(game_tts.rate != ttsrate) game_tts.set_rate(ttsrate);
			writeprefs();
			speak(pu.get_value("Voz atualizada."));
			saved = true;
			break;
		}
		if(selected_id == "cancel") {
			break;
		}
	}

	if(!saved) {
		if(original_voice >= 0 && tts.voice != original_voice) tts.set_voice(original_voice);
		if(original_voice >= 0 && game_tts.voice != original_voice) game_tts.set_voice(original_voice);
		if(tts.rate != original_tts_rate) tts.set_rate(original_tts_rate);
		if(game_tts.rate != original_tts_rate) game_tts.set_rate(original_tts_rate);
		voice = original_voice;
		ttsrate = original_rate;
	}

	perfio();
}

// Menu de slider para ajuste de volume (0-100%)
float volume_slider_menu(string title, float current_volume) {
	audio_form vol_form;
	vol_form.create_window(title, false, true);
	
	// Se o volume atual for 0 ou inválido, inicia em 50%
	if(current_volume <= 0 || current_volume > 100) current_volume = 50.0;
	
	// Criar o slider (0-100, incremento de 1, valor inicial baseado em current_volume)
	int f_slider = vol_form.create_slider(
		pu.get_value("Volume"),
		current_volume,  // Valor inicial
		0,               // Mínimo
		100,             // Máximo
		" " + pu.get_value("porcento"), // Sufixo falado ("50 porcento")
		1                // Incremento (1% por vez)
	);
	
	// Botões OK e Cancelar
	int f_ok = vol_form.create_button(pu.get_value("&Aplicar"), true);
	int f_cancel = vol_form.create_button(pu.get_value("&Cancelar"), false, true);
	
	// Foca no slider
	vol_form.focus(f_slider);
	
	// Loop de monitoramento
	while(!vol_form.is_pressed(f_cancel) && !vol_form.is_pressed(f_ok)) {
		wait(5);
		vol_form.monitor();
	}
	
	// Retorna o valor escolhido ou -1 se cancelado
	if(vol_form.is_pressed(f_ok)) {
		float new_value = vol_form.get_slider(f_slider);
		speak(pu.get_value("Volume ajustado para") + " " + int(new_value) + " " + pu.get_value("porcento"));
		return new_value;
	}
	else {
		speak(pu.get_value("Cancelado"));
		return -1; // Indica cancelamento
	}
}

// Menu de atualizações
void batualizacao(bool auto_check) {
	string latest = url_get(UPDATE_URL);
	
	// Verificar se conseguiu obter a versão do servidor
	if(latest.find("versão:") == -1) {
		if(!auto_check) {
			dlg(pu.get_value("Erro ao checar por atualizações. Os motivos podem ser que você esteja usando uma versão beta, ou o servidor não pode ser carregado."));
			menuprincipal();
		}
		return;
	}
	
	// Extrair versão do servidor
	latest = latest.replace("versão:", "");
	latest = trim_string(latest);
	
	// Se não há atualização e é checagem manual, avisar
	if((latest == ver) && (!auto_check)) {
		dlg(pu.get_value("Nenhuma atualização até o momento."));
		menuprincipal();
		return;
	}
	
	// Se há nova versão disponível
	if(latest != ver) {
		updatefound.play_wait();
		updatemenu(latest);
	}
	else if(!auto_check) {
		menuprincipal();
	}
}

// Menu de atualização quando nova versão é encontrada
void updatemenu(string vernova) {
	setupmenu();
	
	game_menu.add_item(pu.get_value("Atualizar agora"), "update");
	game_menu.add_item(pu.get_value("Depois"), "later");
	game_menu.add_item(pu.get_value("Cancelar"), "cancel");
	
	game_menu.intro_text = pu.get_value("Nova versão disponível: ") + vernova + ". " + 
	                        pu.get_value("Versão atual: ") + ver + ". " +
	                        pu.get_value("O que deseja fazer?");
	
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "update") {
		atualizarv(vernova);
	}
	else if(selected_id == "later") {
		speak(pu.get_value("Você pode atualizar depois pelo menu principal."));
		menuprincipal();
	}
	else {
		menuprincipal();
	}
}

// Realizar o download e instalação da atualização
void atualizarv(string vernova) {
	speak(pu.get_value("Iniciando o processo de atualização..."));
	
	sound updating;
	updating.load(get_sound_path("update_starting.ogg"));
	updating.play_wait();
	
	// Iniciar música de atualização em loop
	updatemus.play_looped();
	
	// Fazer download do instalador
	string status = dl_file(DOWNLOAD_URL, INSTALLER_NAME);
	
	if(status == "finished") {
		updatemus.stop();
		updatedone.play_wait();
		speak(nomejogo + " " + vernova + " " + pu.get_value("Acabou de ser baixado!"));
		wait(1000);
		
		// Executar instalador e fechar o jogo
		run(INSTALLER_NAME, "", false, false);
		exit();
	}
	else {
		updatemus.stop();
		dlg(pu.get_value("Erro ao baixar a atualização. Status: ") + status);
		menuprincipal();
	}
}

