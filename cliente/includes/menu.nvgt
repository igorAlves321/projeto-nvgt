// Sistema de menus convertido para NVGT usando classes nativas
#include "input_forms.nvgt"  // Formulários de entrada NVGT

// Instância global do menu
menu game_menu;

void menu_network_pump(menu@ m, string data) {
	if(!is_connected) return;
	netloop();
	if(heartbeat_timer.elapsed >= HEARTBEAT_INTERVAL) {
		heartbeat_timer.restart();
		send_unreliable(peer_id, "heartbeat", 0);
	}
}

// Controle de música de fundo dos menus
sound menu_music_sound;
bool menu_music_loaded = false;
string current_menu_music = "";

string int_to_string(int value) {
	return "" + value;
}

int menu_volume_to_db() {
	int vol = int(musicamenu);
	if(vol < 0) vol = 0;
	if(vol > 100) vol = 100;
	// Mapeamento mais audível: 30% não pode virar quase mudo (-70dB).
	// 0%=-100dB, 100%=0dB, com curva suave para menus.
	if(vol == 0) return -100;
	return (vol / 2) - 50;
}

void stop_menu_music_internal() {
	menu_music_sound.stop();
	menu_music_sound.close();
	menu_music_loaded = false;
	current_menu_music = "";
}

void stop_menu_music(bool immediate = true) {
	if(!menu_music_loaded) return;
	if(!immediate) {
		fade_menu_music(20);
		return;
	}
	stop_menu_music_internal();
}

void fade_menu_music(int steps = 30) {
	if(!menu_music_loaded) return;
	if(steps <= 0) {
		stop_menu_music_internal();
		return;
	}
	int start_volume = menu_music_sound.volume;
	int target_volume = -100;
	for(int i = 0; i < steps; i++) {
		int new_volume = start_volume + ((target_volume - start_volume) * (i + 1)) / steps;
		menu_music_sound.volume = new_volume;
		wait(15);
	}
	stop_menu_music_internal();
}

void start_menu_music() {
	stop_menu_music();
	string track = "m" + int_to_string(random(1, 8)) + ".ogg";
	debug_log("Tentando carregar musica: " + track);

	// Ordem de carga:
	// 1) Caminho resolvido por get_sound_path (pasta custom ou nome no pack)
	// 2) Nome direto usando sound_default_pack
	// 3) Caminhos legados em disco
	string resolved_track = get_sound_path(track);
	bool loaded = menu_music_sound.load(resolved_track);
	if(!loaded && @sound_default_pack !is null) {
		loaded = menu_music_sound.load(track, sound_default_pack);
	}
	if(!loaded) {
		loaded = menu_music_sound.load(track);
	}
	if(!loaded) {
		debug_log("Falha ao carregar '" + track + "', tentando sounds/" + track);
		loaded = menu_music_sound.load("sounds/" + track);
	}
	if(!loaded) {
		debug_log("ERRO: Não foi possível carregar musica do menu!");
		debug_log("Tentou: " + resolved_track + ", pack, " + track + " e sounds/" + track);
		return;
	}

	int volume_db = menu_volume_to_db();
	menu_music_sound.volume = volume_db;
	debug_log("🎵 Volume configurado: " + volume_db + " dB (musicamenu=" + musicamenu + "%)");
	
	menu_music_sound.play_looped();
	menu_music_loaded = true;
	current_menu_music = track;
	debug_log(" Música do menu tocando: " + track);
}

void ensure_menu_music_volume() {
	if(menu_music_loaded) {
		menu_music_sound.volume = menu_volume_to_db();
	}
}

bool prompt_login_form(const string &in title = "") {
	string form_title = title != "" ? title : pu.get_value("Conectar");

	while(true) {
		input_form form(form_title);
		form.description = pu.get_value("Informe suas credenciais e pressione enter.");
		form.add_text_field("username", pu.get_value("Digite seu nome de usuário."), net_un != "" ? net_un : un, true);
		form.add_text_field("password", pu.get_value("Digite sua senha."), net_pw, true, true);

		dictionary@ result = form.run();
		if(form.user_canceled) return false;

		string username_candidate = "";
		string password_candidate = "";
		result.get("username", username_candidate);
		result.get("password", password_candidate);

		if(msginvalida(username_candidate)) {
			dlg(pu.get_value("Nome de usuário inválido. Espaços não são aceitos."));
			continue;
		}
		if(password_candidate == "" || msginvalida(password_candidate)) {
			dlg(pu.get_value("Senha inválida. Espaços não são aceitos."));
			continue;
		}

		net_un = username_candidate;
		un = username_candidate;
		net_pw = password_candidate;
		pw = password_candidate;
		writeprefs();
		return true;
	}
	return false; // fallback
}

bool collect_account_creation_data(string &out username_out, string &out password_out, string &out email_out) {
	while(true) {
		input_form form(pu.get_value("Criar nova conta"));
		form.description = pu.get_value("Preencha os campos para criar sua conta.");
		form.add_text_field("username", pu.get_value("Digite seu nome de usuário."), "", true);
		form.add_text_field("email", pu.get_value("Digite seu e-mail."), "", true);
		form.add_text_field("password", pu.get_value("Digite sua senha (mínimo 8 caracteres)."), "", true, true);

		dictionary@ result = form.run();
		if(form.user_canceled) return false;

		string username_candidate = "";
		string email_candidate = "";
		string password_candidate = "";
		result.get("username", username_candidate);
		result.get("email", email_candidate);
		result.get("password", password_candidate);

		if(msginvalida(username_candidate)) {
			dlg(pu.get_value("Nome de usuário inválido. Espaços não são aceitos."));
			continue;
		}
		if(email_candidate == "" || email_candidate.find("@") == -1) {
			dlg(pu.get_value("E-mail em branco ou inválido."));
			continue;
		}
		if(password_candidate.length() < 8 || msginvalida(password_candidate)) {
			dlg(pu.get_value("Senha inválida. Isso pode ser porque ela contém menos de 8 caracteres, tenha símbolos especiais ou espaços."));
			continue;
		}

		username_out = username_candidate;
		email_out = email_candidate;
		password_out = password_candidate;
		return true;
	}
	return false; // fallback
}

string prompt_numeric_input(const string &in title, const string &in description, int default_value = 1) {
	while(true) {
		input_form form(title);
		form.description = description;
		form.add_number_field("value", pu.get_value("Quantidade"), default_value, true);
		dictionary@ result = form.run();
		if(form.user_canceled) return "";
		double raw_value = 0;
		if(!result.get("value", raw_value)) {
			speak(pu.get_value("Entrada inválida."));
			continue;
		}
		int final_value = int(raw_value);
		if(final_value <= 0) {
			speak(pu.get_value("Informe um número positivo."));
			continue;
		}
		return "" + final_value;
	}
	return ""; // fallback
}

// Função para configurar menu padrão (equivale ao setupmenu)
void setupmenu(bool music = false) {
	game_menu.reset(true);
	if(music) start_menu_music();
	else ensure_menu_music_volume();
	
	// Configurar pack de sons (igual Batalha Constante)
	@game_menu.pack_file = @sound_default_pack;
	
	// Configurações de som
	game_menu.click_sound = "menumove.ogg";
	game_menu.select_sound = "menuenter.ogg";
	game_menu.open_sound = "menuopen.ogg";
	game_menu.edge_sound = "menubounds.ogg"; // Som ao bater na borda
	game_menu.wrap_sound = ""; // Sem som de wrap
	game_menu.close_sound = ""; // Removido som de voltar a pedido do usuário
	
	// Configurações de comportamento
	// CORREÇÃO: wrap = false para não dar loop no menu
	game_menu.wrap = false;
	game_menu.focus_first_item = false;
	game_menu.automatic_intro = true;
	@game_menu.background_callback = menu_network_pump;
	game_menu.background_callback_data = "";
}

// Função principal para menu silencioso
void menusilent() {
	game_menu.reset(true);
	ensure_menu_music_volume();
	
	// Configurar pack de sons (igual Batalha Constante)
	@game_menu.pack_file = @sound_default_pack;
	
	game_menu.click_sound = "";
	game_menu.select_sound = "";
	game_menu.open_sound = "menuopen.ogg";
	game_menu.edge_sound = "menubounds.ogg"; // Som ao bater na borda
	game_menu.wrap_sound = "";
	game_menu.close_sound = "";
	game_menu.wrap = false; // CORREÇÃO: não dar loop
	game_menu.focus_first_item = false;
	game_menu.automatic_intro = true;
	@game_menu.background_callback = menu_network_pump;
	game_menu.background_callback_data = "";
}

// Menu principal
void menuprincipal() {
	debug_log("📋 Entrando no menu principal...");
	setupmenu(true);
	debug_log("📋 setupmenu(true) concluído");
	game_menu.add_item(pu.get_value("Conectar"), "logar");
	game_menu.add_item(pu.get_value("teste de alto-falantes"), "testspeaks");
	game_menu.add_item(pu.get_value("Configurar personagem"), "personagem");
	game_menu.add_item(pu.get_value("Criar nova conta"), "create");
	game_menu.add_item(pu.get_value("Configurações"), "options");
	game_menu.add_item(pu.get_value("Checar por atualizações"), "checar");
	game_menu.add_item(pu.get_value("Sair"), "exit");
	
	debug_log("📋 Itens do menu adicionados");
	game_menu.intro_text = pu.get_value("Menu principal");
	debug_log("📋 Chamando game_menu.run()...");
	int mres = game_menu.run();
	debug_log("📋 game_menu.run() retornou: " + mres);
	if(mres == -1) {
		debug_log("📋 Usuário cancelou menu (ESC)");
		fade_menu_music(30);
		writeprefs();
		sair();
		return;
	}
	string selected_id = game_menu.get_item_id(mres);
	debug_log("📋 Opção selecionada: " + selected_id);

	if(selected_id == "exit") {
		debug_log("📋 Usuário selecionou SAIR");
		fade_menu_music(30);
		writeprefs();
		sair();
	}
	else if(selected_id == "checar") {
		debug_log("📋 Usuário selecionou CHECAR ATUALIZAÇÕES");
		batualizacao(false);
	}
	else if(selected_id == "personagem") {
		debug_log("📋 Usuário selecionou CONFIGURAR PERSONAGEM");
		// Permite configurar credenciais (login) mesmo sem conta salva
		if(prompt_login_form(pu.get_value("Configurar personagem"))) {
			dlg(pu.get_value("Credenciais salvas com sucesso! Agora você pode conectar."));
		}
		menuprincipal();
	}
	else if(selected_id == "testspeaks") {
		debug_log("📋 Usuário selecionou TESTE DE ALTO-FALANTES");
		fade_menu_music(30);
		dlgplay("altofalante.ogg");
		menuprincipal();
	}
	else if(selected_id == "logar") {
		debug_log("📋 Usuário selecionou CONECTAR");
		// Validação: Verificar se há conta configurada
		if(net_un == "" || net_pw == "") {
			debug_log(" Conta não configurada");
			dlg(pu.get_value("Você não tem uma conta configurada. Por favor, crie uma conta primeiro em 'Criar nova conta' ou configure suas credenciais em 'Configurar personagem'."));
			menuprincipal();
			return;
		}
		debug_log("✓ Credenciais OK, iniciando conexão...");
		fade_menu_music(30);
		speak(pu.get_value("Conectando ao servidor..."));
		net_logar();
	}
	else if(selected_id == "create") {
		debug_log("📋 Usuário selecionou CRIAR CONTA");
		fade_menu_music(30);
		account_creating = true;
		net_create();
	}
	else if(selected_id == "options") {
		debug_log("📋 Usuário selecionou CONFIGURAÇÕES");
		fade_menu_music(18);
		optionsmenu();
	}
}

// Menu de seleção de jogador
string select_player(string text, bool showall = false) {
	if(mapname == "quadro") return "";
	setupmenu();
	
	// Usar array 'players' populado pelo servidor (set_map_players)
	for (uint i = 0; i < players.length(); i++) {
		if(players[i].charname == un) continue;
		if(!showall && players[i].beeping != 1) continue;
		game_menu.add_item(players[i].charname, players[i].charname);
	}
	
	game_menu.intro_text = pu.get_value(text);
	int mres = game_menu.run();
	if(mres == -1) return "";
	return game_menu.get_item_id(mres);
}

// Função auxiliar para salvamento automático de configurações
void salvar_configuracoes_automatico(audio_form@ form_geral, audio_form@ form_perfil, audio_form@ form_notificacoes,
	int fg_sidescrolling, int fg_autosave, int fg_asktoexit, int fg_fps,
	int fp_ttsrate, int fn_desconexao, int fn_nivel, int fn_mortes) {
	
	// GUIA GERAL
	sidescrolling = form_geral.is_checked(fg_sidescrolling) ? 1 : 0;
	autosave = form_geral.is_checked(fg_autosave) ? 1 : 0;
	asktoexit = form_geral.is_checked(fg_asktoexit) ? 1 : 0;
	fps = form_geral.is_checked(fg_fps) ? 1 : 0;
	
	// GUIA PERFIL
	ttsrate = int(form_perfil.get_slider(fp_ttsrate));
	game_tts.set_rate(ttsrate);
	tts.set_rate(ttsrate);
	
	// GUIA NOTIFICAÇÕES
	avisadesconectou = form_notificacoes.is_checked(fn_desconexao) ? 1 : 0;
	avisanivel = form_notificacoes.is_checked(fn_nivel) ? 1 : 0;
	ouvirmortes = form_notificacoes.is_checked(fn_mortes) ? 1 : 0;
	
	writeprefs();
	debug_log(" Configurações salvas automaticamente");
}

// Menu de configurações (Lista principal)
void optionsmenu() {
	setupmenu();
	game_menu.add_item(pu.get_value("OPT_GENERAL"), "general");
	game_menu.add_item(pu.get_value("OPT_PROFILE"), "profile");
	game_menu.add_item(pu.get_value("OPT_NOTIFICATIONS"), "notifications");
	game_menu.add_item(pu.get_value("OPT_BACK"), "back");
	
	game_menu.intro_text = pu.get_value("OPT_MAIN_TITLE");
	
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "general") {
		gerais();
		optionsmenu();
	}
	else if(selected_id == "profile") {
		perfio();
		optionsmenu();
	}
	else if(selected_id == "notifications") {
		notificacoes_menu();
		optionsmenu();
	}
	else if(selected_id == "back") {
		menuprincipal();
	}
	else {
		menuprincipal(); // Fallback
	}
}

// Menu de configurações gerais (Lista com toggles)
void gerais() {
	setupmenu();
	
	// Movimento
	if(sidescrolling == 1) game_menu.add_item(pu.get_value("OPT_MOVE_SIDE"), "side");
	else game_menu.add_item(pu.get_value("OPT_MOVE_VERT"), "side");
	
	// Auto-save
	if(autosave == 1) game_menu.add_item(pu.get_value("OPT_AUTOSAVE_ON"), "autosave");
	else game_menu.add_item(pu.get_value("OPT_AUTOSAVE_OFF"), "autosave");
	
	// Confirmar sair
	if(asktoexit == 1) game_menu.add_item(pu.get_value("OPT_CONFIRM_EXIT_ON"), "asktoexit");
	else game_menu.add_item(pu.get_value("OPT_CONFIRM_EXIT_OFF"), "asktoexit");
	
	game_menu.add_item(pu.get_value("OPT_MENU_VOLUME") + " (" + int(musicamenu) + "%)", "musicvol");
	game_menu.add_item(pu.get_value("OPT_BACK"), "back");
	
	game_menu.intro_text = pu.get_value("OPT_GENERAL");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(mres <= 0 || selected_id == "back") {
		return;
	}
	else if(selected_id == "side") {
		if(sidescrolling == 1) sidescrolling = 0;
		else sidescrolling = 1;
		writeprefs();
		gerais();
	}
	else if(selected_id == "autosave") {
		if(autosave == 1) autosave = 0;
		else autosave = 1;
		writeprefs();
		gerais();
	}
	else if(selected_id == "asktoexit") {
		if(asktoexit == 1) asktoexit = 0;
		else asktoexit = 1;
		writeprefs();
		gerais();
	}
	else if(selected_id == "musicvol") {
		float new_vol = volume_slider_menu(pu.get_value("OPT_MENU_VOLUME"), musicamenu);
		if(new_vol >= 0) {
			musicamenu = new_vol;
			ensure_menu_music_volume();
			writeprefs();
		}
		gerais();
	}
	else {
		// Fallback for unexpected selection
		gerais();
	}
}

// Menu de notificaçőes (Lista com toggles)
void notificacoes_menu() {
	setupmenu();
	
	if(avisadesconectou == 1) game_menu.add_item(pu.get_value("OPT_NOTIF_DISCONN_ON"), "disconn");
	else game_menu.add_item(pu.get_value("OPT_NOTIF_DISCONN_OFF"), "disconn");
	
	if(avisanivel == 1) game_menu.add_item(pu.get_value("OPT_NOTIF_LEVELUP_ON"), "level");
	else game_menu.add_item(pu.get_value("OPT_NOTIF_LEVELUP_OFF"), "level");
	
	if(ouvirmortes == 1) game_menu.add_item(pu.get_value("OPT_NOTIF_DEATH_ON"), "death");
	else game_menu.add_item(pu.get_value("OPT_NOTIF_DEATH_OFF"), "death");
	
	game_menu.add_item(pu.get_value("OPT_BACK"), "back");
	
	game_menu.intro_text = pu.get_value("OPT_NOTIFICATIONS");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(mres <= 0 || selected_id == "back") {
		return;
	}
	else if(selected_id == "disconn") {
		if(avisadesconectou == 1) avisadesconectou = 0;
		else avisadesconectou = 1;
		writeprefs();
		notificacoes_menu();
	}
	else if(selected_id == "level") {
		if(avisanivel == 1) avisanivel = 0;
		else avisanivel = 1;
		writeprefs();
		notificacoes_menu();
	}
	else if(selected_id == "death") {
		if(ouvirmortes == 1) ouvirmortes = 0;
		else ouvirmortes = 1;
		writeprefs();
		notificacoes_menu();
	}
}

// ANTIGO MENU DE GUIAS (Deprecado/Renomeado)
// Menu de configurações com sistema de guias (tabs) - NAVEGAÇÃO HORIZONTAL
void optionsmenu_GUI_OLD() {
	debug_log("⚙️ Abrindo menu de configurações com guias...");
	
	// Criar as subformas para cada guia
	audio_form form_geral;
	audio_form form_perfil;
	audio_form form_notificacoes;
	
	// ===== GUIA: GERAL =====
	form_geral.create_window(pu.get_value("Geral"));
	
	// Sidescrolling (checkbox)
	int fg_sidescrolling = form_geral.create_checkbox(pu.get_value("Movimento lateral (4 direções)"), sidescrolling == 1);
	
	// Autosave (checkbox)
	int fg_autosave = form_geral.create_checkbox(pu.get_value("Salvar automaticamente"), autosave == 1);
	
	// Pedir confirmação para sair (checkbox)
	int fg_asktoexit = form_geral.create_checkbox(pu.get_value("Pedir confirmação ao sair"), asktoexit == 1);
	
	// Ver FPS (checkbox)
	int fg_fps = form_geral.create_checkbox(pu.get_value("Mostrar FPS"), fps == 1);
	
	// Botão para volume da música (abre slider)
	int fg_musicvol = form_geral.create_button(pu.get_value("Volume da música do menu") + " (" + int(musicamenu) + "%)");
	
	// ===== GUIA: PERFIL =====
	form_perfil.create_window(pu.get_value("Perfil"));
	
	// Taxa de voz (slider inline) - só mostra o valor numérico
	int fp_ttsrate = form_perfil.create_slider("", ttsrate, -10, 10, "", 1);
	
	// Botão para trocar voz
	int fp_voice = form_perfil.create_button(pu.get_value("Selecionar voz"));
	
	// Botão para trocar idioma
	int fp_idioma = form_perfil.create_button(pu.get_value("Idioma"));
	
	// ===== GUIA: NOTIFICAÇÕES =====
	form_notificacoes.create_window(pu.get_value("Notificações"));
	
	// Avisar quando jogador se desconecta
	int fn_desconexao = form_notificacoes.create_checkbox(pu.get_value("Avisos de conexão e desconexão"), avisadesconectou == 1);
	
	// Avisar ao subir de nível
	int fn_nivel = form_notificacoes.create_checkbox(pu.get_value("Avisar ao subir de nível"), avisanivel == 1);
	
	// Ouvir mortes
	int fn_mortes = form_notificacoes.create_checkbox(pu.get_value("Ouvir sons de morte"), ouvirmortes == 1);
	
	// ===== FORMULÁRIO PRINCIPAL =====
	audio_form f_principal;
	f_principal.create_window(pu.get_value("Configurações"), false, true);
	
	// Tab panel para navegação LEFT/RIGHT entre guias (só o nome, sem "tab")
	int f_tabs = f_principal.create_tab_panel("");
	f_principal.add_list_item(f_tabs, pu.get_value("Geral"));
	f_principal.add_list_item(f_tabs, pu.get_value("Perfil"));
	f_principal.add_list_item(f_tabs, pu.get_value("Notificações"));
	
	// Subform que exibe o conteúdo da guia selecionada (sem prefixo "Configurações de")
	int f_conteudo = f_principal.create_subform("", @form_geral);
	
	// Apenas botão Cancelar (salvamento é automático)
	int f_cancel = f_principal.create_button(pu.get_value("&Voltar"), false, true);
	
	// Foca na lista de tabs
	f_principal.focus(f_tabs);
	
	int ultima_guia = 0;
	
	// Variáveis para detectar mudanças e salvar automaticamente
	bool alteracao_detectada = false;
	
	// Loop de monitoramento
	while(true) {
		wait(5);
		f_principal.monitor();
		
		// Verifica se mudou de guia (LEFT/RIGHT)
		int guia_atual = f_principal.get_list_position(f_tabs);
		if(guia_atual != ultima_guia) {
			// Salva automaticamente ao trocar de guia
			if(alteracao_detectada) {
				salvar_configuracoes_automatico(form_geral, form_perfil, form_notificacoes, 
					fg_sidescrolling, fg_autosave, fg_asktoexit, fg_fps,
					fp_ttsrate, fn_desconexao, fn_nivel, fn_mortes);
				alteracao_detectada = false;
			}
			
			if(guia_atual == 0) {
				f_principal.set_subform(f_conteudo, @form_geral);
			}
			else if(guia_atual == 1) {
				f_principal.set_subform(f_conteudo, @form_perfil);
			}
			else if(guia_atual == 2) {
				f_principal.set_subform(f_conteudo, @form_notificacoes);
			}
			ultima_guia = guia_atual;
		}
		
		// Detecta alterações nas configurações
		if(guia_atual == 0) {
			if(form_geral.is_checked(fg_sidescrolling) != (sidescrolling == 1) ||
			   form_geral.is_checked(fg_autosave) != (autosave == 1) ||
			   form_geral.is_checked(fg_asktoexit) != (asktoexit == 1) ||
			   form_geral.is_checked(fg_fps) != (fps == 1)) {
				alteracao_detectada = true;
			}
		}
		else if(guia_atual == 1) {
			if(int(form_perfil.get_slider(fp_ttsrate)) != ttsrate) {
				alteracao_detectada = true;
			}
		}
		else if(guia_atual == 2) {
			if(form_notificacoes.is_checked(fn_desconexao) != (avisadesconectou == 1) ||
			   form_notificacoes.is_checked(fn_nivel) != (avisanivel == 1) ||
			   form_notificacoes.is_checked(fn_mortes) != (ouvirmortes == 1)) {
				alteracao_detectada = true;
			}
		}
		
		// Botão de volume da música (abre slider)
		if(form_geral.is_pressed(fg_musicvol)) {
			float new_vol = volume_slider_menu(pu.get_value("Volume da música do menu"), musicamenu);
			if(new_vol >= 0) {
				musicamenu = new_vol;
				ensure_menu_music_volume();
				// Atualiza o texto do botão
				form_geral.set_caption(fg_musicvol, pu.get_value("Volume da música do menu") + " (" + int(musicamenu) + "%)");
			}
		}
		
		// Botão de selecionar idioma
		if(form_perfil.is_pressed(fp_idioma)) {
			string a = idiomas();
			if(a != "") {
				cmfinal = "lang/" + a;
				writeprefs();
				pu.set_arquivo(cmfinal);
				speak("Idioma alterado!");
				alteracao_detectada = false; // Já salvou
			}
		}
		
		// Voltar (salva automaticamente antes de sair)
		if(f_principal.is_pressed(f_cancel)) {
			if(alteracao_detectada) {
				salvar_configuracoes_automatico(form_geral, form_perfil, form_notificacoes, 
					fg_sidescrolling, fg_autosave, fg_asktoexit, fg_fps,
					fp_ttsrate, fn_desconexao, fn_nivel, fn_mortes);
			}
			debug_log("⚙️ Saindo das configurações");
			menuprincipal();
			return;
		}
	}
}

// Menu de Perfil (Lista)
void perfio() {
	setupmenu();
	
	game_menu.add_item(pu.get_value("OPT_VOICE_SELECT"), "voice");
	game_menu.add_item(pu.get_value("OPT_LANG_SELECT"), "lang");
	
	game_menu.add_item(pu.get_value("OPT_BACK"), "back");
	
	game_menu.intro_text = pu.get_value("OPT_PROFILE");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(mres <= 0 || selected_id == "back") {
		return;
	}
	else if(selected_id == "voice") {
		voicemenu();
		perfio();
	}
	else if(selected_id == "lang") {
		string new_lang = idiomas();
		// idiomas() retorna o caminho completo (ex: lang/English.lang)
		if(new_lang != "") {
			// Atualiza a variável global que é salva em writeprefs()
			cmfinal = new_lang; 
			
			// Carrega o novo arquivo de linguagem imediatamente
			pu.set_arquivo(cmfinal);
			
			// Salva as preferências
			writeprefs();
			
			speak(pu.get_value("Idioma alterado."));
		}
		perfio();
	}
	else {
		perfio();
	}
}

// Menu sim/não simples usando função nativa do NVGT
bool simple_yes_no(const string&in prompt) {
	menu yn_menu;
	@yn_menu.pack_file = @sound_default_pack;  // Configurar pack de sons
	yn_menu.click_sound = "menumove.ogg";
	yn_menu.select_sound = "menuenter.ogg";
	yn_menu.close_sound = "menuvolta.ogg";
	
	return yes_no(prompt, yn_menu);
}

// Menu de sair
void exitmenu() {
	if (asktoexit == 1) {
		bool should_exit = simple_yes_no(pu.get_value("Deseja sair?"));
		if (should_exit) {
			speak(pu.get_value("respaldando inventário"));
			game_net.send(1, "/g", 1, true);
			wait(1000);
			exitgame();
		}
	}
	else {
		exitgame();
	}
}

// Menu de opções do jogo (F10) - acessível durante o jogo
void optionsmenu2() {
	setupmenu();
	
	// Alterar senha
	game_menu.add_item(pu.get_value("Alterar sua senha"), "password");
	
	// Áudios (voice chat)
	if(voicechat == 0) {
		game_menu.add_item(pu.get_value("Ativar os áudios"), "audios");
	} else {
		game_menu.add_item(pu.get_value("Desativar os áudios"), "audios");
	}
	
	// Registro de áudios
	if(logaudio == 0) {
		game_menu.add_item(pu.get_value("Ativar o registro de áudios"), "logaudio");
	} else {
		game_menu.add_item(pu.get_value("Desativar o registro de áudios"), "logaudio");
	}
	
	// Registro de permanentes

	// Dispositivo de entrada (microfone)
	game_menu.add_item(pu.get_value("Selecionar microfone") + ": " + voice_input_device_label(), "voice_input");
	if(logpermanents == 0) {
		game_menu.add_item(pu.get_value("Ativar o registro de permanentes"), "logpermanents");
	} else {
		game_menu.add_item(pu.get_value("Desativar o registro de permanentes"), "logpermanents");
	}
	
	// Interrupção do leitor
	if(interrupt == 0) {
		game_menu.add_item(pu.get_value("Interrupção do leitor desativada, pressione enter para alterar"), "interrupt");
	} else {
		game_menu.add_item(pu.get_value("Interrupção do leitor ativada, pressione enter para alterar"), "interrupt");
	}
	
	// Notificações de conexões
	if(avisadesconectou == 0) {
		game_menu.add_item(pu.get_value("Notificações de conexões desativadas, pressione enter para alterar"), "avisadesconectou");
	} else {
		game_menu.add_item(pu.get_value("Notificações de conexões ativadas, pressione enter para alterar"), "avisadesconectou");
	}
	
	// Notificações de mortes
	if(ouvirmortes == 1) {
		game_menu.add_item(pu.get_value("Notificações de mortes ativadas, pressione enter para alterar"), "mortes");
	} else {
		game_menu.add_item(pu.get_value("Notificações de mortes desativadas, pressione enter para alterar"), "mortes");
	}
	
	// Reordenar buffers
	game_menu.add_item(pu.get_value("Reordenar os buffers de mensagens"), "buffers");
	
	// Alterar idioma
	game_menu.add_item(pu.get_value("Alterar seu arquivo de idioma"), "idioma");
	
	// Voltar
	game_menu.add_item(pu.get_value("Voltar"), "back");
	
	game_menu.intro_text = pu.get_value("Menu de opções do jogo.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(mres <= 0 || selected_id == "back") {
		return;
	}
	
	if(selected_id == "password") {
		// Pedir nova senha
		input_form form(pu.get_value("Alterar senha"));
		form.description = pu.get_value("Digite sua nova senha.");
		form.add_text_field("newpass", pu.get_value("Nova senha (mínimo 8 caracteres)"), "", true, true);
		form.add_text_field("confirm", pu.get_value("Confirme a nova senha"), "", true, true);
		
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string newpass = "";
			string confirm = "";
			result.get("newpass", newpass);
			result.get("confirm", confirm);
			
			if(newpass.length() < 8 || msginvalida(newpass)) {
				dlg(pu.get_value("Senha inválida. Isso pode ser porque ela contém menos de 8 caracteres, tenha símbolos especiais ou espaços."));
			} else if(newpass != confirm) {
				dlg(pu.get_value("As senhas são diferentes."));
			} else {
				add_add_item("variado", pu.get_value("Alterando senha..."));
				string newhash = string_hash(newpass, 2, false);
				send_reliable(peer_id, "/changepassword " + pwh + " " + newhash, 0);
			}
		}
		optionsmenu2();
	}
	else if(selected_id == "audios") {
		if(voicechat == 0) {
			voicechat = 1;
			speak(pu.get_value("Áudios ativados."));
		} else {
			voicechat = 0;
			speak(pu.get_value("Áudios desativados."));
		}
		writeprefs();
		optionsmenu2();
	}
	else if(selected_id == "logaudio") {
		if(logaudio == 0) {
			logaudio = 1;
			speak(pu.get_value("Registro de áudios ativado."));
		} else {
			logaudio = 0;
			speak(pu.get_value("Registro de áudios desativado."));
		}
		writeprefs();
		optionsmenu2();
	}
	else if(selected_id == "voice_input") {
		if(select_voice_input_device_menu()) {
			writeprefs();
			speak(pu.get_value("Microfone selecionado") + ": " + voice_input_device_label());
		}
		optionsmenu2();
	}
	else if(selected_id == "logpermanents") {
		if(logpermanents == 0) {
			logpermanents = 1;
			speak(pu.get_value("Registro de mensagens permanentes ativado."));
		} else {
			logpermanents = 0;
			speak(pu.get_value("Registro de mensagens permanentes desativado."));
		}
		writeprefs();
		optionsmenu2();
	}
	else if(selected_id == "interrupt") {
		if(interrupt == 0) {
			interrupt = 1;
		} else {
			interrupt = 0;
		}
		writeprefs();
		optionsmenu2();
	}
	else if(selected_id == "avisadesconectou") {
		if(avisadesconectou == 0) {
			avisadesconectou = 1;
		} else {
			avisadesconectou = 0;
		}
		writeprefs();
		optionsmenu2();
	}
	else if(selected_id == "mortes") {
		if(ouvirmortes == 0) {
			ouvirmortes = 1;
		} else {
			ouvirmortes = 0;
		}
		writeprefs();
		optionsmenu2();
	}
	else if(selected_id == "buffers") {
		buffersmenu();
	}
	else if(selected_id == "idioma") {
		select_language();
	}
}

// Menu de loja de itens
void store(string storeitems) {
	if(ausente || !player_moveable) return;
	setupmenu();
	
	string[] items = storeitems.split("\r\n");
	for (uint i = 0; i < items.length(); i++) {
		string[] item = items[i].split(" ");
		string it = item[0].replace(",", "");
		game_menu.add_item(items[i], it);
	}
	
	game_menu.intro_text = pu.get_value("Loja menu. Aqui tem") + " " + items.length() + " " + pu.get_value("itens") + ".";
	int mres = game_menu.run();
	if (mres >= 0) {
		string item_id = game_menu.get_item_id(mres);
		string amount = prompt_numeric_input(pu.get_value("Quantidade"), pu.get_value("Quanto de") + " " + item_id + "?");
		if(amount != "") {
			game_net.send(net_peer_id, encrypt_packet("/buy123321123 " + amount + " " + item_id), 1, true);
		}
	}
}

