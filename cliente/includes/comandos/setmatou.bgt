void cmd_setmatou(string&in args) {
	string[] parsed = string_split(args, " ", true);
	if (parsed.length() < 2) {
		clientmsg("Uso: /setmatou [jogador] [quantidade]");
		return;
	}
	
	string player_name = parsed[0];
	int kill_count;
	
	try {
		kill_count = string_to_number(parsed[1]);
	} catch(exception) {
		clientmsg("A quantidade deve ser um número válido.");
		return;
	}
	
	send_reliable(peer_id, "setmatou " + player_name + " " + kill_count, 0);
	clientmsg("Comando enviado para atualizar contagem de mortes para " + player_name + ".");
}
