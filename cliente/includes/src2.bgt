source2@[] source2s;
sound_pool source2pool;
class source2{
	int source2_sound, lx, rx, miny, maxy;
	double volume;
	string id, soundfile;
	source2(int source2_lx, int source2_rx, int source2_miny, int source2_maxy, string file, string sid, double source_volume){
		this.id=sid;
		this.lx=source2_lx;
		this.rx = source2_rx;
		this.miny=source2_miny;
		this.maxy= source2_maxy;
		this.soundfile=file;
		this.volume=source_volume;
		source2_sound=source2pool.play_extended_2d(soundfile, me.x, me.y, lx, miny, 0, 0, 0, 0, true, 0, 0, this.volume, 100, false, false);
		source2pool.update_sound_range_2d(source2_sound, (me.x-lx), (rx-lx), (me.y-miny), (maxy-miny));
	}
	void change_volume(int type){
		if(type==1){
			if(this.volume<0) this.volume++;
			source2pool.update_sound_start_values(this.source2_sound, 0, this.volume, 100);
			volumesources=this.volume;
		}
		else if(type==0){
			if(this.volume>-50) this.volume--;
			source2pool.update_sound_start_values(this.source2_sound, 0, this.volume, 100);
			volumesources=this.volume;
		}
	}
}

void source2checkloop(){
for (uint i=0; i<source2s.length(); i++){
source2pool.update_sound_2d(source2s[i].source2_sound, source2s[i].lx, source2s[i].miny);
source2pool.update_sound_range_2d(source2s[i].source2_sound, (me.x-source2s[i].lx), (source2s[i].rx-source2s[i].lx), (me.y-source2s[i].miny), (source2s[i].maxy-source2s[i].miny));
}
}
void destroy_all_source2s(bool delete=true){
for(uint i=0; i<source2s.length(); i++){
source2pool.destroy_sound(source2s[i].source2_sound);
}
source2s.resize(0);
}

void pause_sources2() {
for(uint i=0; i<source2s.length(); i++){
source2pool.pause_sound(source2s[i].source2_sound);
}
}

void resume_sources2() {
for(uint i=0; i<source2s.length(); i++){
source2pool.resume_sound(source2s[i].source2_sound);
}
}

void spawn_source2(int source2_lx, int source2_rx, int source2_miny, int source2_maxy, string soundfile,string id, double source_volume){
source2 source21(source2_lx, source2_rx, source2_miny, source2_maxy, soundfile, id, source_volume);
source2s.insert_last(source21);
}
