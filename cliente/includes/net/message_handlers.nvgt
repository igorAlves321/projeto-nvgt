// ==========================================
// FUNCOES AUXILIARES DE PROCESSAMENTO
// ==========================================

void process_msg(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " " + parsed[1] + " ", "");
	string[] b = a.split("|");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	
	// Mapear nomes de canal antigos (BGT) para novos
	string channel = parsed[1];
	if(channel == "canal_principal") channel = "global";
	else if(channel == "canal_local") channel = "local";
	else if(channel == "mensajes_del_equipo") channel = "equipe";
	else if(channel == "conversaciones_privadas") channel = "privado";
	else if(channel == "visiones_angelicales") channel = "admin";
	
	add_add_item(channel, m);
}

void process_msg2(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", "");
	string[] b = a.split(";");
	
	// Ajuste de escrita para mensagens de ganho de item:
	// "1 ;Peixe de olhos brancos;." -> "1 peixe de olhos brancos."
	if(b.length() == 3) {
		string qtd = b[0].trim_whitespace();
		string item_raw = b[1].trim_whitespace();
		string tail = b[2].trim_whitespace();
		if(qtd != "" && item_raw != "" && tail == ".") {
			string first_char = qtd.substr(0, 1);
			int first_code = character_to_ascii(first_char);
			if(first_code >= 48 && first_code <= 57) {
				// Garantir que quantidade e totalmente numerica
				bool only_digits = true;
				for(uint qi = 0; qi < qtd.length(); qi++) {
					int code = character_to_ascii(qtd.substr(qi, 1));
					if(code < 48 || code > 57) {
						only_digits = false;
						break;
					}
				}
				if(!only_digits) {
					for(uint i = 0; i < b.length(); i++) {
						m += pu.get_value(b[i]);
					}
					add_add_item("tudo", m);
					return;
				}
				
				int qty_int = parse_int(qtd);
				string item_text = pu.get_value(item_raw);
				if(item_text.length() > 1) {
					item_text = item_text.substr(0, 1).lower() + item_text.substr(1, item_text.length() - 1);
				} else if(item_text.length() == 1) {
					item_text = item_text.lower();
				}
				
				// Pluralizacao basica para mensagens de quantidade
				if(qty_int > 1) {
					string lower_item = item_text.lower();
					if(lower_item.length() >= 2 && lower_item.substr(lower_item.length() - 2, 2) == "ao") {
						item_text += "s";
					} else if(lower_item.length() >= 2 && lower_item.substr(lower_item.length() - 2, 2) == "al") {
						item_text = item_text.substr(0, item_text.length() - 1) + "is";
					} else if(lower_item.length() >= 2 && lower_item.substr(lower_item.length() - 2, 2) == "el") {
						item_text = item_text.substr(0, item_text.length() - 1) + "is";
					} else if(lower_item.length() >= 2 && lower_item.substr(lower_item.length() - 2, 2) == "ol") {
						item_text = item_text.substr(0, item_text.length() - 1) + "is";
					} else if(lower_item.length() >= 2 && lower_item.substr(lower_item.length() - 2, 2) == "ul") {
						item_text = item_text.substr(0, item_text.length() - 1) + "is";
					} else if(lower_item.length() >= 1 && lower_item.substr(lower_item.length() - 1, 1) != "s") {
						item_text += "s";
					}
				}
				
				m = qtd + " " + item_text + ".";
				add_add_item("tudo", m);
				return;
			}
		}
	}
	
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	add_add_item("tudo", m);  // Avisos vao pro canal "tudo"
}

void process_msg3(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", "");
	string[] b = a.split(";");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	add_add_item("equipe", m);  // Chat de equipe
}

void process_msg4(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", "");
	
	// Task 2.6.2: Detectar e processar [LOGO_CHATTER] no chat administrativo
	// Se a mensagem contem [LOGO_CHATTER], tocar som especial e adicionar prefixo "Chatter:"
	bool is_chatter = false;
	if(a.find("[LOGO_CHATTER]") != -1) {
		is_chatter = true;
		a = a.replace("[LOGO_CHATTER] ", ""); // Remove o marcador
		a = a.replace("[LOGO_CHATTER]", "");  // Remove caso nao tenha espaco
		// Tocar som especial do Chatter
		p.play_stationary("chatter_logo.ogg", false);
	}
	
	string[] b = a.split(";");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	
	// Adicionar prefixo "Chatter:" se for uma mensagem de chatter
	if(is_chatter) {
		m = "Chatter: " + m;
	}
	
	add_add_item("admin", m);  // Chat de administracao
}

void process_msg_translated(string full_msg, string[] parsed, string channel) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", "");
	string[] b = a.split(";");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	add_add_item(channel, m);
}

string translate_character_types(string text) {
	text = text.replace("ser_de_luz", pu.get_value("ser_de_luz"));
	text = text.replace("Novato", pu.get_value("Novato"));
	text = text.replace("Novata", pu.get_value("Novata"));
	text = text.replace("vampira", pu.get_value("vampira"));
	text = text.replace("vampiro", pu.get_value("vampiro"));
	text = text.replace("vampira_diurna", pu.get_value("vampira_diurna"));
	text = text.replace("vampiro_diurno", pu.get_value("vampiro_diurno"));
	text = text.replace("jefe_de_clan", pu.get_value("chefe_de_cla"));
	text = text.replace("licantropo", pu.get_value("licantropo"));
	text = text.replace("lider_de_la_manada", pu.get_value("lider_da_matilha"));
	text = text.replace("guerrera_hada", pu.get_value("guerreira_fada"));
	text = text.replace("guerrero_hada", pu.get_value("guerreiro_fada"));
	text = text.replace("bruja ", pu.get_value("bruxa "));
	text = text.replace("brujo", pu.get_value("bruxo"));
	text = text.replace("cazador", pu.get_value("cacador"));
	text = text.replace("cazadora", pu.get_value("cacadora"));
	text = text.replace("guerrera_oscurecida", pu.get_value("guerreira_obscurecida"));
	text = text.replace("guerrero_oscurecido", pu.get_value("guerreiro_obscurecido"));
	text = text.replace("demonio_menor", pu.get_value("demonio_menor"));
	text = text.replace("demonio_mayor", pu.get_value("demonio_maior"));
	text = text.replace("principe_del_infierno", pu.get_value("principe_do_inferno"));
	text = text.replace("princesa_del_infierno", pu.get_value("princesa_do_inferno"));
	return text;
}

// ============================================================================
//  SISTEMA DE CHAT COMPLETO - HANDLERS ADICIONAIS
// ============================================================================

// process_fm - Fala Mapa (Chat Local)
// Formato BGT: fm |titulo| nome |acao| mensagem
// Exemplo: fm |Guerreiro| Joao |diz:| Ola pessoal!
void process_fm(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", ""); // Remove "fm "
	
	// Separar por | e traduzir cada parte
	string[] parts = a.split("|");
	for(uint i = 0; i < parts.length(); i++) {
		// Traduzir partes conhecidas
		string part = trim_string(parts[i]);
		if(part != "") {
			m += pu.get_value(part);
			if(i < parts.length() - 1) m += " ";
		}
	}
	
	// Adicionar ao canal de chat local
	add_add_item("local", m);
}

// process_pm - Mensagem Privada
// Formato BGT: pm de/para nome: mensagem
// Exemplo: pm de Joao: Ola! ou pm para Maria: Oi!
void process_pm(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", ""); // Remove "pm "
	
	// Traduzir "de" e "para" se necessario
	if(a.length() > 3) {
		if(a.substr(0, 3) == "de ") {
			a = pu.get_value("de") + " " + a.substr(3);
		} else if(a.substr(0, 5) == "para ") {
			a = pu.get_value("para") + " " + a.substr(5);
		}
	}
	
	m = a;
	
	// Adicionar ao canal de mensagens privadas
	add_add_item("privado", m);
	
	// Tocar som de notificacao
	p.play_stationary("notify_pm.ogg", false);
}

// process_msgconexoes - Notificacao de Conexao/Desconexao
// Formato BGT: msgconexoes mensagem
void process_msgconexoes(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", ""); // Remove "msgconexoes "
	
	// Traduzir partes separadas por ;
	string[] parts = a.split(";");
	for(uint i = 0; i < parts.length(); i++) {
		m += pu.get_value(parts[i]);
	}
	
	// Adicionar ao canal "tudo" (notificacoes de conexao)
	add_add_item("tudo", m);
}

// ============================================================================
// PINFO - Menu Navegavel de Informacoes do Jogador
// Formato: pinfo_data:nome|status|banido|razao|expira|nivel|xp|hp|mapa|pos|admin|gold
// ============================================================================
void process_pinfo_data(string full_msg) {
	// Remove o prefixo "pinfo_data:"
	string raw = full_msg.substr(11);  // "pinfo_data:" tem 11 caracteres
	string[] info = raw.split("|");
	
	if(info.length() < 12) {
		speak(pu.get_value("Erro ao processar informacoes do jogador."));
		debug_log("a PINFO: dados incompletos - " + raw);
		return;
	}
	
	// Campos:
	// 0: Nome, 1: Status, 2: Banido?, 3: Razao ban, 4: Expira ban
	// 5: Nivel, 6: XP, 7: HP, 8: Mapa, 9: Posicao, 10: Admin?, 11: Ouro
	
	// Criar menu navegavel
	setupmenu();
	
	// Cabecalho
	string title = info[0] + " (" + info[1] + ")";
	
	// Itens do menu (cada um pode ser navegado individualmente)
	game_menu.add_item(pu.get_value("Nome: ") + info[0], "nome");
	game_menu.add_item(pu.get_value("Status: ") + info[1], "status");
	
	// Status de ban com destaque
	if(info[2] == "Sim") {
		game_menu.add_item(pu.get_value("as BANIDO: Sim"), "banido");
		game_menu.add_item(pu.get_value("Razão do ban: ") + info[3], "razao");
		game_menu.add_item(pu.get_value("Expira em: ") + info[4], "expira");
	} else {
		game_menu.add_item(pu.get_value("Banido: Não"), "banido");
	}
	
	// Estatisticas (se disponiveis)
	if(info[5] != "?") {
		game_menu.add_item(pu.get_value("Nivel: ") + info[5], "nivel");
	}
	if(info[6] != "?") {
		game_menu.add_item(pu.get_value("XP: ") + info[6], "xp");
	}
	if(info[7] != "?") {
		game_menu.add_item(pu.get_value("Vida: ") + info[7], "hp");
	}
	if(info[8] != "?") {
		game_menu.add_item(pu.get_value("Mapa: ") + info[8], "mapa");
	}
	if(info[9] != "?") {
		game_menu.add_item(pu.get_value("Posicao: ") + info[9], "pos");
	}
	
	// Admin e Ouro
	game_menu.add_item(pu.get_value("Administrador: ") + info[10], "admin");
	if(info[11] != "?") {
		game_menu.add_item(pu.get_value("Ouro: ") + info[11], "gold");
	}
	
	game_menu.add_item(pu.get_value("Fechar"), "fechar");
	
	game_menu.intro_text = pu.get_value("Informacoes de ") + title;
	
	// Executar menu (o jogador pode navegar pelos itens)
	int result = game_menu.run();
	
	// Nao precisa fazer nada com a selecao - e apenas informativo
	debug_log("PINFO: Menu de " + info[0] + " exibido");
}
