int abletojump2;
// staircase@[] staircases; // Already declared in globals.nvgt
bool onstaircase;
class staircase{
	bool abletojump;
	int minx, maxx, miny, maxy;
	string tile;
	int staircasesound;
	staircase(int cx, int cx2, int fminy,int fmaxy,string playsound){
		minx=cx;
		maxx=cx2;
		miny=fminy;
		maxy=fmaxy;
		tile=playsound;
		spawn_tiles(minx,maxx,miny,maxy,tile);
	}
}
void staircasecheckloop(){
	for (uint i=0; i<staircases.length(); i++){
		if (game_me.x>=staircases[i].minx&&game_me.x<=staircases[i].maxx&&game_me.y>=staircases[i].miny&&game_me.y<=staircases[i].maxy){
			onstaircase=true;
			if (game_me.y==staircases[i].maxy)staircases[i].abletojump=true;
			else staircases[i].abletojump=false;
		}
		else{
			onstaircase=false;
			staircases[i].abletojump=true;
		}
		if(key_down(KEY_UP)&&moveable&&key_down(KEY_G)==false&&key_down(KEY_LSHIFT)==false&&key_down(KEY_RSHIFT)==false&&!centado&&!key_down(KEY_F)){
			if (onstaircase==true&&walktimer.elapsed>=walkvelocidade&&game_me.y<staircases[i].maxy){
				walktimer.restart();
				game_p.play_stationary(staircases[i].tile+"step"+random(1,5)+".ogg", false);
				game_me.y+=1;
				game_net.send(net_peer_id,"move "+game_me.x+" "+game_me.y,0,true);
				if(get_tile_at(game_me.x, game_me.y).find("mud")>-1){
					int vv=random(0, 1);
					if(vv==1)game_me.y--;
				}
			}
		}
		if (key_down(KEY_DOWN)&&moveable&&key_down(KEY_G)==false&&key_down(KEY_RSHIFT)==false&&key_down(KEY_LSHIFT)==false&&!centado&&!key_down(KEY_F)){
			if (onstaircase==true&&walktimer.elapsed>=walkvelocidade&&game_me.y>staircases[i].miny){
				walktimer.restart();
				game_p.play_stationary(staircases[i].tile+"step"+random(1,5)+".ogg", false);
				game_me.y-=1;
				game_net.send(net_peer_id,"move "+game_me.x+" "+game_me.y,0,true);
				if(get_tile_at(game_me.x, game_me.y).find("mud")>-1){
					int vv=random(0, 1);
					if(vv==1)game_me.y++;
				}
			}
		}
	}
}
void spawn_staircase(int fminx, int fmaxx, int fminy, int fmaxy,string stile, string id){
	staircase_class staircase1;
	staircase1.minx = fminx;
	staircase1.maxx = fmaxx;
	staircase1.miny = fminy;
	staircase1.maxy = fmaxy;
	staircase1.tile = stile;
	staircase1.abletojump = true;
	staircases.insert_last(staircase1);
}
void destroy_all_staircases(){
	staircases.resize(0);
}
void sjumpcheck(){
	if (staircases.length()<=0)abletojump2=1;
	else{
		for (uint i=0; i<staircases.length(); i++){
			if (staircases[i].abletojump==false){
				abletojump2=0;
				break;
			}
			else if (staircases[i].abletojump==true||onstaircase==false){
				abletojump2+=1;
			}
			else if (i>=staircases.length()-1&&staircases.length()>0&&staircases[i].abletojump==true){
				abletojump2=1;
				break;
			}
			else if (i>=staircases.length()-1&&staircases.length()>0&&staircases[i].abletojump==false){
				abletojump2=0;
				break;
			}
		}
	}
}