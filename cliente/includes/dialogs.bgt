dialog@[]dialogs;
class dialog{
int x, y;
string text, filesound;
dialog(int dx, int dy, string text2, string filesound2){
x=dx;
y=dy;
text=text2;
filesound=filesound2;
}
}
void destroy_all_dialogs(){
dialogs.resize(0);
}
void spawn_dialog(int x, int y, string text, string filesound){
dialog d(x, y, text, filesound);
dialogs.insert_last(d);
}
void checkdialog(){
for(uint i=0; i<dialogs.length(); i++){
int contador=0;
if(string_contains(dialogs[i].text, "*g*", 1)>-1){
dialogs[i].text=string_replace(dialogs[i].text, "*g*", gender, true);
}
if(string_contains(dialogs[i].text, "*nick*", 1)>-1){
dialogs[i].text=string_replace(dialogs[i].text, "*nick*", un, true);
}
if(dialogs[i].x==me.x&&dialogs[i].y==me.y){
speak(pu.get_value(dialogs[i].text));
p.play_2d(dialogs[i].filesound, me.x, me.y, dialogs[i].x, dialogs[i].y, false);
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_Z)){
clipboard_copy_text(dialogs[i].text);
speak(pu.get_value(dialogs[i].text)+" "+pu.get_value("copiado al portapapeles."));
}
if(key_down(KEY_LCONTROL)&&key_pressed(KEY_T)&&enabletranslate==1){
langs_menu();
}
if(key_pressed(KEY_T)){
speak(pu.get_value(dialogs[i].text));
}
if(key_pressed(KEY_RETURN)||key_pressed(KEY_NUMPADENTER)){
break;
}
}
}
}
}
