string zoeiras(){
	string[] soundfiles=find_files("upsounds/*.ogg");
	if(soundfiles.length<=0){
		speak(pu.get_value("Nenhum arquivo encontrado na pasta uploads"));
		return -1;
	}
	setupmenu2();
	for(uint i=0; i<soundfiles.length; i++){
		m.add_item_tts(string_replace(soundfiles[i],".ogg","",true),soundfiles[i]);
	}
	int mres=m.run(pu.get_value("Escolha o arquivo de som para enviar."),true);
	if(mres<=0){
		return -1;
	}
	else return m.get_item_name(mres);
}
