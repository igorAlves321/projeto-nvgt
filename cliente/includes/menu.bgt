	}
	else return m.get_item_name(mres);
}

void telemenu(string[] maps_of_portal, bool music =false){
	if(!moveable)return;
	m.reset(true);
	if(music==true){
		m.add_music("rock"+random(1,3)+".ogg");
	}
	m.enable_numbers=true;
	m.enable_first_letter_navigation=true;
	m.click_sound="menumove.ogg";
	m.enter_sound="menuchecked.ogg";
	m.open_sound="ma135.ogg";
	m.repeat_items_at_edges=false;
	if(sidescrolling==1){
		m.enable_side_scrolling=true;
		m.enable_left_and_right=true;
	}
	else if(sidescrolling==0){
		m.enable_up_and_down=true;
		m.enable_side_scrolling=false;
	}
	m.enable_enter=true;
	m.allow_escape=true;
	m.wrap=false;
	m.enable_home_and_end=true;
	m.set_callback(clb,"");
	for(int x=0; x<maps_of_portal.length(); x++){
		string[] data =string_split(maps_of_portal[x], "=", true);
		m.add_item_tts(pu.get_value(data[0]), data[1]+" "+data[2]+" "+data[3]);
	}
	m.add_item_tts(pu.get_value("Voltar"), "back");
	int mres=m.run(pu.get_value("O portal se ilumina diante de vocÍ, e te mostra lugares distintos para onde pode ir. Qual escolher?"), true);
	if(mres==0 && m.get_item_name(mres)=="back"){
		return;
	}
	else{
		send_reliable(peer_id, "usetele "+m.get_item_name(mres), 0);
		return;
	}
}


