dynamic_menu_pro m;
simple_menu sm;

void main_menu(){
	setupmenu();
	m.add_item_tts(pu.get_value("Jogar"), "logar");
	m.add_item_tts(pu.get_value("Teste de alto-falantes"), "testspeaks");
	m.add_item_tts(pu.get_value("Configure sua conta"), "personagem");
	m.add_item_tts(pu.get_value("Criar nova conta"), "create");
	m.add_item_tts(pu.get_value("ConfiguraÁıes"), "options");
	m.add_item_tts(pu.get_value("AtualizaÁıes"), "checar");
	m.add_item_tts(pu.get_value("Sair"), "exit");
	int mres;
	switch(sidescrolling) {
		case 1:
		mres=m.run(pu.get_value("Menu principal. Escolha uma opÁ„o com as setas esquerda ou direita, e pressione enter."), true);
		break;
		default:
		mres=m.run(pu.get_value("Menu principal. Escolha uma opÁ„o com as setas para cima ou para baixo, e pressione enter."), true);
	}
	if(mres==0 || m.get_item_name(mres)=="exit"){
		writeprefs();
		m.fade_music(10);
		exit();
	}
	if(m.get_item_name(mres)=="checar") {
		m.fade_music(10);
		menuupdates();
	}
	if(m.get_item_name(mres)=="personagem"){
		m.fade_music(10);
		config_account();
	}
	if(m.get_item_name(mres)=="logar"){
		m.fade_music(10);
		game();
	}
	if(m.get_item_name(mres)=="testspeaks"){
		m.fade_music(10);
		testspeaks();
	}
	if(m.get_item_name(mres)=="create"){
		m.fade_music(10);
		creating=true;
		create();
	}
	if(m.get_item_name(mres)=="options"){
		m.fade_music(10);
		optionsmenu();
	}
}

void menuupdates(){
setupmenu3();
m.add_item_tts(pu.get_value("Verificar AtualizaÁıes do cliente"), "cliente");
m.add_item_tts(pu.get_value("Verificar AtualizaÁıes de mapas"), "maps");
m.add_item_tts(pu.get_value("Verificar atualizaÁ„o geral"), "installer");
m.add_item_tts(pu.get_value("Voltar"), "back");
int mres=m.run(pu.get_value("Menu de AtualizaÁıes."), true);
if(mres==0 || m.get_item_name(mres)=="back")main_menu();
else if(m.get_item_name(mres)=="cliente"){
checkupdate(false);
}
else if(m.get_item_name(mres)=="maps"){
checkupdatemaps(false);
}
else if(m.get_item_name(mres)=="installer"){
checkupdateinstaller(false);
}
}

void reportmenu(){
	setupmenu2();
	m.add_item_tts(pu.get_value("Invocar a ·guia celestial."), "eagle");
	m.add_item_tts(pu.get_value("Enviar um relatÛrio de mensagem."), "report");
	int mres=m.run(pu.get_value("Selecione uma opÁ„o e pressione enter."), true);
	if(mres==0) return;
	if(m.get_item_name(mres)=="eagle"){
		send_reliable(peer_id, "/falarnomapa habemus sanctitas.", 0);
	}
	else if(m.get_item_name(mres)=="report"){
		if(adds[addpos].items.length()>0){
			string text=v.input(pu.get_value("O que mais deseja mencionar sobre a mensagem a reportar?"));
			if(text!="") send_reliable(peer_id, "report "+text+" "+adds[addpos].items[adds[addpos].pos], 0);
		}
	}
}

