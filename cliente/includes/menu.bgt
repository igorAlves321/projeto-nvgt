void perfio(){
	setupmenu3();
	m.add_item_tts(pu.get_value("Escolher voz"), "voz");
	if(mdor==0)m.add_item_tts(pu.get_value("N„o ouvindo grunhidos, pressione enter para alterar"), "grunido");
	else if(mdor==1)m.add_item_tts(pu.get_value("Ouvindo grunhidos, pressione enter para alterar"), "grunido");
	if(ouvirleilao==1) m.add_item_tts(pu.get_value("Desativar NotificaÁıes de leilıes"), "vendas");
	if(ouvirleilao==0) m.add_item_tts(pu.get_value("Ativar NotificaÁıes de leilıes"), "vendas");
	m.add_item_tts(pu.get_value("Voltar"), "voltar");
	int mres=m.run(pu.get_value("opÁıes de usu·rio."), true);
	if(m.get_item_name(mres)=="voz"){
		voicemenu();
	}
	if(m.get_item_name(mres)=="mortes"){
		if(ouvirmortes==0)ouvirmortes=1;
		else if(ouvirmortes==1)ouvirmortes=0;
		readprefs();
		perfio();
	}
	else if(m.get_item_name(mres)=="grunido"){
		if(mdor==0){
			mdor=1;
		}
		else if(mdor==1){
			mdor=0;
		}
		writeprefs();
		perfio();
	}
	else if(m.get_item_name(mres)=="vendas"){
		if(ouvirleilao==0){
			ouvirleilao=1;
		}
		else if(ouvirleilao==1){
			ouvirleilao=0;
		}
		readprefs();
		perfio();
	}
	else{
		optionsmenu();
	}
}
