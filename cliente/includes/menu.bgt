send_reliable(peer_id, "getplayers", 0);
}
if(m.get_item_name(mres)=="stats"){
statsmenu();
}
if(m.get_item_name(mres)=="monster"){
send_unreliable(event.peer_id, "monster", 0);
}
if(m.get_item_name(mres)=="services"){
servicesmenu();
}
if(m.get_item_name(mres)=="transferencias"){
transferenciasmenu();
}
if(m.get_item_name(mres)=="enlace"){
string url=v.input(pu.get_value("escreva ou cole o link que quer ouvir. se quiser parar a reproduÁ„o, escreva a letra s e pressione enter."));
if(string_contains(url, "\r\n", 1)>-1){
string_replace(url, "\r\n", "", true);
}
if(url=="s"){
stream2.stop(streamurl2);
}
if(url==""){
}
else{
stream2.stop(streamurl2);
streamurl2=stream2.load(url);
stream2.play(streamurl2);
}
}
if(m.get_item_name(mres)=="bug"){
string subject =v.input(pu.get_value("Escreva o tÌtulo do problema:"));
string message =v.input(pu.get_value("Escreva o texto do seu relatÛrio, com um mÌnimo de 120 caracteres:"));
if(subject!="" && message!="") {
send_reliable(peer_id, "bug "+subject+"\r\n"+message, 0);
}
else {
speak(pu.get_value("Cancelado."));
}
}
if(m.get_item_name(mres)=="send_couple"){
string msg=v.input(pu.get_value("escreva a mensagem que enviar· para seu parceiro."));
if(msg!="") send_reliable(peer_id, "message_to_couple "+msg, 0);
}
if(m.get_item_name(mres)=="send_parabatai"){
string msg=v.input(pu.get_value("escreva a mensagem que enviar· para seu parabatai."));
if(msg!="") send_reliable(peer_id, "message_to_parabatai "+msg, 0);
}
if(m.get_item_name(mres)=="sanity"){
send_reliable(peer_id, "celular sanity", 0);
}
}
