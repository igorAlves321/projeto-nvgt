void optionsmenu(){
	setupmenu3();
	m.add_item_tts(pu.get_value("opÁıes gerais"), "gerais");
	m.add_item_tts(pu.get_value("opÁıes de perfil"), "perfio");
	m.add_item_tts(pu.get_value("alterar seu arquivo de idioma"), "idioma");
	m.add_item_tts(pu.get_value("alterar dispositivo de saÌda"), "device");
	m.add_item_tts(pu.get_value("Voltar"), "back");
	int mres=m.run(pu.get_value("Menu de ConfiguraÁıes. Escolha uma opÁ„o e pressione enter."), true);
	if(mres==0 || m.get_item_name(mres)=="back") {
		main_menu();
	}
	if(m.get_item_name(mres)=="gerais"){
		gerais();
	}
	if(m.get_item_name(mres)=="idioma"){
		select_language(false);
	}
	if(m.get_item_name(mres)=="perfio"){
		perfio();
	}
	if(m.get_item_name(mres)=="device"){
		string device_name;
		int device=select_device(device_name);
		if(device>=0){
			device_number=device;
			alert(pu.get_value("SeleÁ„o de dispositivo de saÌda"), pu.get_value("Foi selecionado o dispositivo")+" "+device_name+". "+pu.get_value("O cliente ser· reiniciado para aplicar as mudanÁas."));
			reiniciar();
		}
	}
}

void optionsmenu2(){
	setupmenu2(false);
	m.add_item_tts(pu.get_value("Alterar sua senha"), "password");
	if(voicechat==0){
		m.add_item_tts(pu.get_value("Ativar os ·udios"), "audios");
	}
	if(voicechat==1){
		m.add_item_tts(pu.get_value("Desativar os ·udios"), "audios");
	}
	if(logaudio==0){
		m.add_item_tts(pu.get_value("Ativar o registro de ·udios"), "logaudio");
	}
	if(logaudio==1){
		m.add_item_tts(pu.get_value("Desativar o registro de ·udios"), "logaudio");
	}
	if(logpermanents==0){
		m.add_item_tts(pu.get_value("Ativar o registro de permanentes"), "logpermanents");
	}
	if(logpermanents==1){
		m.add_item_tts(pu.get_value("Desativar o registro de permanentes"), "logpermanents");
	}
	if(interrupt==0){
		m.add_item_tts(pu.get_value("InterrupÁ„o do leitor desativada, pressione enter para alterar"), "interrupt");
	}
	if(interrupt==1){
		m.add_item_tts(pu.get_value("InterrupÁ„o do leitor ativada, pressione enter para alterar"), "interrupt");
	}
	if(avisadesconectou==0){
		m.add_item_tts(pu.get_value("NotificaÁıes de conexıes desativadas, pressione enter para alterar"), "avisadesconectou");
	}
	if(avisadesconectou==1){
		m.add_item_tts(pu.get_value("NotificaÁıes de conexıes ativadas, pressione enter para alterar"), "avisadesconectou");
	}
	if(ouvirmortes==1)m.add_item_tts(pu.get_value("NotificaÁıes de mortes ativadas, pressione enter para alterar"), "mortes");
	else if(ouvirmortes==0)m.add_item_tts(pu.get_value("NotificaÁıes de mortes desativadas, pressione enter para alterar"), "mortes");
	m.add_item_tts(pu.get_value("Reordenar os buffers de mensagens"), "buffers");
	m.add_item_tts(pu.get_value("alterar seu arquivo de idioma"), "idioma");
	m.add_item_tts(pu.get_value("Voltar"), "back");
	int mres=m.run(pu.get_value("Menu de opÁıes do jogo."), true);
	if(mres ==0 || m.get_item_name(mres) =="back") return;
	if(m.get_item_name(mres)=="wine"){
		togglewine();
		optionsmenu2();
	}
	if(m.get_item_name(mres)=="ad"){
		asktoexit=0;
		writeprefs();
		optionsmenu2();
	}
	if(m.get_item_name(mres)=="ae"){
		asktoexit=1;
		writeprefs();
		optionsmenu2();
	}
	if(m.get_item_name(mres)=="password"){
		string ilovecoca=v.input(pu.get_value("Digite sua nova senha."));
		if(msginvalida(ilovecoca)||ilovecoca.length()<8){
			dlg(pu.get_value("Senha inv·lida. Isso pode ser porque ela contÈm menos de 8 caracteres, tenha sÌmbolos especiais ou espaÁos."));
		}
		else{
			string ilovecocaamor=v.input(pu.get_value("Repita sua nova senha."));
			if(msginvalida(ilovecocaamor)||ilovecocaamor.length()<8){
				dlg(pu.get_value("Senha inv·lida. Isso pode ser porque ela contÈm menos de 8 caracteres, tenha sÌmbolos especiais ou espaÁos."));
			}
			else if(ilovecocaamor!=ilovecoca){
				dlg(pu.get_value("As senhas s„o diferentes."));
				optionsmenu2();
			}
			else{
				add_add_item("variado", pu.get_value("Alterando senha..."));
				ilovecoca =string_hash(ilovecocaamor, 2, false);
				temporal_pwh=ilovecoca;
				send_reliable(peer_id, "/changepassword "+pwh+" "+ilovecoca, 0);
			}
		}
	}
	if(m.get_item_name(mres)=="selidioma")origem();
	if(m.get_item_name(mres)=="interrupt"){
		if (interrupt==1) {
			interrupt=0;
		}
		else {
			interrupt=1;
		}
		optionsmenu2();
	}
	if(m.get_item_name(mres)=="audios"){
		if(voicechat==0){
			voicechat=1;
			speak(pu.get_value("·udios ativados."));
		}
		else if(voicechat==1){
			voicechat=0;
			speak(pu.get_value("·udios desativados."));
		}
		optionsmenu2();
	}
	if(m.get_item_name(mres)=="logaudio"){
		if(logaudio==0){
			logaudio=1;
			speak(pu.get_value("Registro de ·udios ativado."));
		}
		else if(logaudio==1){
			logaudio=0;
			speak(pu.get_value("Registro de ·udios desativado."));
		}
		optionsmenu2();
	}
	if(m.get_item_name(mres)=="logpermanents"){
		if(logpermanents==0){
			logpermanents=1;
			speak(pu.get_value("Registro de mensagens permanentes ativado."));
		}
		else if(logpermanents==1){
			logpermanents=0;
			speak(pu.get_value("registro de mensagens permanentes desativado."));
		}
		optionsmenu2();
	}
	if(m.get_item_name(mres)=="mortes"){
		if(ouvirmortes==0) {
			ouvirmortes=1;
		}
		else if(ouvirmortes==1) {
			ouvirmortes=0;
		}
		optionsmenu2();
	}
	if(m.get_item_name(mres)=="avisadesconectou"){
		if(avisadesconectou==0){
			avisadesconectou=1;
		}
		else if(avisadesconectou==1){
			avisadesconectou=0;
		}
		optionsmenu2();
	}
	if(m.get_item_name(mres) =="buffers") {
		buffersmenu();
	}
	if(m.get_item_name(mres)=="idioma") {
		select_language();
	}
}

void select_language(bool use_return=true) {
	string[] langfiles=find_files("lang/*.lang");
	if(langfiles.length<=0){
		dlg(pu.get_value("N„o h· arquivos de idioma na pasta lang."));
		if(use_return) return;
		else optionsmenu();
	}
	setupmenu2();
	for(uint i=0; i<langfiles.length; i++){
		m.add_item_tts(string_replace(langfiles[i], ".lang", "", true), langfiles[i]);
	}
	m.add_item_tts(pu.get_value("Voltar"), "back");
	int mres=m.run(pu.get_value("Escolha um arquivo de idioma e pressione enter."), true);
	if(mres==0 || m.get_item_name(mres)=="back"){
		if(use_return) return;
		else optionsmenu();
	}
	else {
		cmfinal ="lang/"+m.get_item_name(mres);
		pu.set_arquivo(cmfinal);
		idiomajogo=string_replace(cmfinal, "lang/", "", false);
		idiomajogo=string_replace(idiomajogo, ".lang", "", false);
		writeprefs();
		if(use_return) return;
		else optionsmenu();
	}
}

bool exitmenu(){
	bool success =false;
	if (asktoexit==1){
		setupmenu2();
		m.add_item_tts(pu.get_value("Sim"),"yes");
		m.add_item_tts(pu.get_value("N„o"),"no");
		int mres=m.run(pu.get_value("Deseja deixar esta dimens„o?"),true);
		if(mres==0) {
			success =false;
		}
		if (mres==1){
			success =true;
		}
	}
	else{
		success =true;
	}
	return success;
}

int clb(dynamic_menu_pro@ j, string dat){
	if(connected) mainloop();
	return 0;
}

void spellmenu(string data){
if(dbaculo==1)return;
	if(ausente||!moveable)return;
	string[] spells=string_split(data,"\r\n",false);
	setupmenu2();
	for(uint i=0; i<spells.length; i++){
		string[] parsed=string_split(spells[i],":",false);
		m.add_item_tts(pu.get_value(spells[i]),parsed[0]);
	}
	int mres=m.run(pu.get_value("Escolha uma magia para lanÁar."),true);
	if(mres==0) return;
	else{
		string spell=m.get_item_name(mres);
		send_unreliable(peer_id,"spellcast "+spell+" "+facing,0);
	}
}
void menuserver(string text, string packet_to_send, int channel, string[] items, string[] sounds){
	m.reset(true);
	m.enable_numbers=true;
	m.enable_first_letter_navigation=true;
	m.click_sound=sounds[0];
	m.enter_sound=sounds[1];
	m.open_sound=sounds[2];
	m.repeat_items_at_edges=false;
	if(sidescrolling==1){
		m.enable_side_scrolling=true;
		m.enable_left_and_right=true;
	}
	else if(sidescrolling==0){
		m.enable_up_and_down=true;
		m.enable_side_scrolling=false;
	}
	m.enable_enter=true;
	m.allow_escape=true;
	m.wrap=false;
	m.enable_home_and_end=true;
	m.set_callback(clb,"");
	for(uint i=0; i<items.length; i++){
		string[] parsed=string_split(items[i],"=",false);
		string text_to_show=translate_with_char(parsed[0], ";");
		if(parsed.length()>1) m.add_item_tts(text_to_show, parsed[1]);
	}
	int mres=m.run(translate_with_char(text, ";"), true);
	if(mres==0) return;
	else{
send_unreliable(peer_id, packet_to_send+" "+m.get_item_name(mres), channel);
	}
}
