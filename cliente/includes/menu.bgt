void langs_menu(){
string[] langfiles=find_files("lang/*.lang");
int contador=-1;
speak(pu.get_value("escolha o arquivo de idioma que quer atualizar."));
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE))break;
if(key_pressed(KEY_RIGHT)&&contador<langfiles.length()-1){
contador++;
string lang_file=string_replace(langfiles[contador], ".lang", "", true);
speak(pu.get_value(lang_file));
}
if(key_pressed(KEY_LEFT)&&contador>0){
contador--;
string lang_file=string_replace(langfiles[contador], ".lang", "", true);
speak(pu.get_value(lang_file));
}
if(key_pressed(KEY_RETURN)&&contador>-1||key_pressed(KEY_NUMPADENTER)&&contador>-1){
langs_menu2(langfiles[contador]);
break;
}
}
}
void langs_menu2(string lang){
file f;
int find, contador=-1, contador2=-1, actual=-1;
string content, key, updated, final, search, save;
f.open("lang/"+lang, "r");
content=f.read();
f.close();
string[] search2, lines=delinear(content);
string[] content2;
speak(pu.get_value("menu de modificaÁ„o. para atualizar um valor da traduÁ„o posicione-se na linha que desejar movendo-se com seta direita ou esquerda e pressione seta para cima ou para baixo para acessar os termos dela, depois pressione enter no termo que queira modificar. quando estiver pronto, pressione ctrl+espaÁo e seu arquivo de idioma ser· atualizado. para obter uma prÈvia de algum termo a traduzir pressione ctrl+p sobre ele. para apagar um elemento da traduÁ„o pressione delete, para adicionar um novo pressione ctrl+a."));
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE))break;
if(key_pressed(KEY_RIGHT)&&contador<lines.length()-1&&contador2==-1){
contador++;
content2=string_split(lines[contador], "=", false);
speak(pu.get_value("linha original: ")+content2[0]+" "+pu.get_value("linha que se mostrar· traduzida: ")+content2[1]);
}
if(key_pressed(KEY_LEFT)&&contador>0&&contador2==-1){
contador--;
content2=string_split(lines[contador], "=", false);
speak(pu.get_value("linha original: ")+content2[0]+" "+pu.get_value("linha que se mostrar· traduzida: ")+content2[1]);
}
if(key_pressed(KEY_HOME)&&contador>0&&contador2==-1){
contador=0;
content2=string_split(lines[contador], "=", false);
speak(pu.get_value("linha original: ")+content2[0]+" "+pu.get_value("linha que se mostrar· traduzida: ")+content2[1]);
}
if(key_pressed(KEY_END)&&contador>-1&&contador<lines.length()-1&&contador2==-1){
contador=lines.length()-1;
content2=string_split(lines[contador], "=", false);
speak(pu.get_value("linha original: ")+content2[0]+" "+pu.get_value("linha que se mostrar· traduzida: ")+content2[1]);
}
if(key_pressed(KEY_UP)&&contador>-1&&contador2<content2.length()-1){
contador2++;
speak(content2[contador2]);
}
if(key_pressed(KEY_DOWN)&&contador>-1&&contador2>-1){
contador2--;
if(contador2>-1)speak(content2[contador2]);
else speak(pu.get_value("linha original: ")+content2[0]+" "+pu.get_value("linha que se mostrar· traduzida: ")+content2[1]);
}
if(key_pressed(KEY_RETURN)&&contador2>-1||key_pressed(KEY_NUMPADENTER)&&contador2>-1){
key=content2[contador2];
updated=v.input(pu.get_value("o termo a modificar atualmente È "+key+". modifique o que vir prudente."), key);
if(updated!=""){
content2[contador2]=string_replace(content2[contador2], key, updated, true);
lines[contador]=string_replace(lines[contador], key, content2[contador2], true);
speak(pu.get_value("termo atualizado. para envi·-lo ao servidor pressione ctrl+s ou para atualiz·-lo em sua pasta de idioma local pressione ctrl+espaÁo."));
}
}
if(key_down(KEY_LCONTROL)||key_down(KEY_RCONTROL)){
if(key_pressed(KEY_B)){
if(search==""){
search=v.input(pu.get_value("escreva as palavras-chave da sua busca."));
if(search!=""){
for(uint i=0; i<lines.length(); i++){
if(string_contains(lines[i], search, 1)>-1){
final+=lines[i]+"\r\n";
}
}
search2=string_split(final, "\r\n", false);
actual++;
find=lines.find(search2[actual]);
if(find==-1){
speak(pu.get_value("este termo n„o est· disponÌvel."));
}
else{
contador=find;
content2=string_split(lines[contador], "=", false);
speak(pu.get_value("linha original: ")+content2[0]+" "+pu.get_value("linha que se mostrar· traduzida: ")+content2[1]);
}
}
}
}
if(key_pressed(KEY_P)&&contador2>-1){
speak(pu.get_value(content2[contador2]));
}
if(key_pressed(KEY_SPACE)){
f.open("lang/"+lang, "w");
f.write(linear(lines));
f.close();
pu.set_arquivo("lang/"+lang);
speak(pu.get_value("arquivo de idioma atualizado localmente."));
}
if(key_pressed(KEY_A)){
string line=v.input(pu.get_value("escreva o termo a traduzir."));
string translate=v.input(pu.get_value("escreva a traduÁ„o do termo anteriormente escrito."));
if(line!=""&&translate!=""){
lines.insert_last(line+"="+translate);
speak(pu.get_value("linha adicionada ao final da traduÁ„o."));
}
}
if(key_pressed(KEY_S)&&contador>-1){
int option=q_pro(pu.get_value("Deseja atualizar o arquivo de idioma?"));
if(option==1){
int send, directory_set, result=ftp_connect("mxgproductions.net", 21, "reino_elemental", "HFEBCgiNUH32ppOsXSSs");
if(result>0){
directory_set=ftp_directory_set("/lang");
if(directory_set>0){
send=ftp_send_as("lang/"+lang, lang);
}
}
if(result==0){
speak(pu.get_value("erro ao conectar ao servidor de envio de arquivos."));
return;
}
else if(directory_set==0){
speak(pu.get_value("erro ao estabelecer a pasta na qual ser· subido o arquivo. por favor contate algum dos desenvolvedores."));
return;
}
else if(send==0){
speak(pu.get_value("erro ao enviar o arquivo ao servidor. isso pode ser devido a que a pasta n„o foi especificada corretamente, ou que n„o se pÙde conectar ao servidor de envio de arquivos."));
return;
}
int disconnect=ftp_disconnect();
if(disconnect==0) send_reliable(event.peer_id, "update_lang_file "+lang, 16);
}
}
}
if(!shift_pressionado()&&key_pressed(KEY_TAB)){
if(search==""){
speak(pu.get_value("n„o h· nenhum termo de busca disponÌvel."));
}
else if(actual<search2.length()-1){
actual++;
find=lines.find(search2[actual]);
contador=find;
content2=string_split(lines[contador], "=", false);
speak(pu.get_value("linha original: ")+content2[0]+" "+pu.get_value("linha que se mostrar· traduzida: ")+content2[1]);
}
}
if(shift_pressionado()&&key_pressed(KEY_TAB)){
if(search==""){
speak(pu.get_value("n„o h· nenhum termo de busca disponÌvel."));
}
else if(actual>0){
actual--;
find=lines.find(search2[actual]);
contador=find;
content2=string_split(lines[contador], "=", false);
speak(pu.get_value("linha original: ")+content2[0]+" "+pu.get_value("linha que se mostrar· traduzida: ")+content2[1]);
}
}
if(key_pressed(KEY_DELETE)&&contador>-1){
if(contador<lines.length()&&lines.find(lines[contador])>-1){
int option=q_pro(pu.get_value("Realmente quer eliminar esta linha da traduÁ„o? n„o haver· forma de restaur·-la no futuro, a menos que a tenha copiado previamente e a volte a inserir."));
if(option==1){
lines.remove_at(contador);
speak(pu.get_value("linha eliminada."));
}
else{
speak(pu.get_value("cancelado."));
}
}
}
}
}
void news_menu(string[] data){
string[] info, news_categories, news_data;
int ncindex=-1, counter_data=-1;
for(int x=0; x<data.length(); x++){
string[] info_to_post=delinear(data[x], bell);
if(info_to_post.length()>1){
news_categories.insert_last(info_to_post[0]);
news_data.insert_last(info_to_post[1]);
}
}
speak(pu.get_value("NotÌcias Elementais! A informaÁ„o mais recente sobre os temas com maior relev‚ncia, sÛ ao alcance de suas m„os!"));
p.play_stationary("drawmap.ogg", false);
while(true){
	wait(5);
	mainloop();
	if(key_pressed(KEY_ESCAPE)){
		p.play_stationary("drawlunchable.ogg", false);
		break;
	}
	if(key_pressed(KEY_LEFT)&&ncindex>0){
		ncindex--;
		info=delinear(news_data[ncindex]);
		counter_data=-1;
		speak(pu.get_value(news_categories[ncindex]));
		p.play_stationary("getsandpaper.ogg", false);
	}
	if(key_pressed(KEY_RIGHT)&&ncindex<news_categories.length()-1){
		ncindex++;
		info=delinear(news_data[ncindex]);
		counter_data=-1;
		speak(pu.get_value(news_categories[ncindex]));
		p.play_stationary("getsandpaper.ogg", false);
	}
	if(ncindex>-1){
		if(key_pressed(KEY_UP)&&counter_data>0){
			counter_data--;
			speak(info[counter_data]);
		}
		if(key_pressed(KEY_DOWN)&&counter_data<info.length()-1){
			counter_data++;
			speak(info[counter_data]);
		}
		if(key_pressed(KEY_HOME)&&counter_data>0){
			counter_data=0;
			speak(info[counter_data]);
		}
		if(key_pressed(KEY_END)&&counter_data<info.length()-1){
			counter_data=info.length()-1;
			speak(info[counter_data]);
		}
	}
	if(key_pressed(KEY_RETURN)&&desenvolvedordm==1&&ncindex>-1){
		manage_news(news_categories[ncindex], news_data[ncindex]);
	}
		if(key_down(KEY_LCONTROL) || key_down(KEY_RCONTROL)){
			if(key_pressed(KEY_A) && desenvolvedordm==1){
				string name=v.input(pu.get_value("Escreva o nome da categoria que queira adicionar."));
				if(name!="") send_reliable(peer_id, "add_news_category::"+name, 13);
			}
			if(key_pressed(KEY_C) && ncindex>-1) {
				clipboard_copy_text(linear(info));
				speak(pu.get_value("Texto copiado."));
			}
		}
	if(key_pressed(KEY_DELETE)&&ncindex>-1&&desenvolvedordm==1){
	send_reliable(peer_id, "remove_news_category::"+news_categories[ncindex], 13);
	news_categories.remove_at(ncindex);
	news_data.remove_at(ncindex);
	ncindex--;
	}
}
}
void manage_news(string category, string content){
string text=content, news_data=v.input(pu.get_value("Modifique o que vir prudente. Ao terminar pressione enter para enviar a informaÁ„o atualizada ao servidor."), content);
if(news_data==text){
speak(pu.get_value("Tente modificando o texto."));
return;
}
if(news_data!="") send_reliable(peer_id, "update_news::"+category+"::"+news_data, 13);
}
void show_eagle_messages(string[] lines){
int counter=-1;
string[] data;
speak(pu.get_value("Para se deslocar entre os pergaminhos atualmente disponÌveis pressione setas direita e esquerda, para responder algum pressione ctrl+r e para ler sua mensagem pressione enter sobre ele. Tenha em conta que ao pressionar ctrl+r e enviar sua resposta esse pergaminho ficar· marcado e ser· eliminado da lista."));
while(true){
	wait(5);
	mainloop();
	if(key_pressed(KEY_ESCAPE)) break;
	if(left.pressing()&&counter>0){
		counter--;
		data=string_split(lines[counter], "=", false);
		speak(data[0]+", "+pu.get_value("enviado por")+" "+data[2]+" "+pu.get_value("‡s")+" "+data[4]+" "+pu.get_value("na data")+" "+data[3]+".");
	}
	if(right.pressing()&&counter<lines.length()-1){

counter++;
data=string_split(lines[counter], "=", false);
speak(data[0]+", "+pu.get_value("enviado por")+" "+data[2]+" "+pu.get_value("ùs")+" "+data[4]+" "+pu.get_value("na data")+" "+data[3]+".");
}
if(key_pressed(KEY_HOME)&&counter>0){
counter=0;
data=string_split(lines[counter], "=", false);
speak(data[0]+", "+pu.get_value("enviado por")+" "+data[2]+" "+pu.get_value("ùs")+" "+data[4]+" "+pu.get_value("na data")+" "+data[3]+".");
}
if(key_pressed(KEY_END)&&counter<lines.length()-1){
counter=lines.length()-1;
data=string_split(lines[counter], "=", false);
speak(data[0]+", "+pu.get_value("enviado por")+" "+data[2]+" "+pu.get_value("ùs")+" "+data[4]+" "+pu.get_value("na data")+" "+data[3]+".");
}
if((key_pressed(KEY_RETURN)||key_pressed(KEY_NUMPADENTER))&&counter>-1){
speak(data[1]);
}
if((key_down(KEY_LCONTROL)&&key_pressed(KEY_R)||key_down(KEY_LCONTROL)&&key_pressed(KEY_R))&&counter>-1){
string message=v.input(pu.get_value("Escreva sua resposta para o pergaminho selecionado."));
if(message!="") send_reliable(peer_id, "answer_to::"+data[0]+"::"+data[2]+"::"+lines[counter]+"::"+message, 13);
}
}
}

void chatmenu(){
	if(idiomaschat.length()>0) {
		setupmenu2();
	}
	else {
		speak(pu.get_value("Nùo existe nenhum canal que possa escolher em seu cliente."));
		return;
	}
	for(int i=0; i<idiomaschat.length(); i++) {
		string[] parsed=string_split(idiomaschat[i], "=", true);
		if(parsed.length()==2) {
			m.add_item_tts(pu.get_value(parsed[0]), parsed[1]);
		}
	}
	m.add_item_tts(pu.get_value("Voltar"), "back");
	int mres, position=0;
	switch(sidescrolling) {
		case 1:
		position =m.get_item_position(idiomachat);
		if(position>0) mres=m.run_extended(pu.get_value("Menu de chats. Escolha uma opùùo com as setas esquerda ou direita, e pressione enter."), true, position, false);
		else mres=m.run(pu.get_value("Menu de chats. Escolha uma opùùo com as setas esquerda ou direita, e pressione enter."), true);
		break;
		default:
		position =m.get_item_position(idiomachat);
		if(position>0) mres =m.run_extended(pu.get_value("Menu de chats. Escolha uma opùùo com as setas para cima ou para baixo, e pressione enter."), true, position, false);
		else mres=m.run(pu.get_value("Menu de chats. Escolha uma opùùo com as setas para cima ou para baixo, e pressione enter."), true);
	}
	if(mres==0 || m.get_item_name(mres)=="back"){
		return;
	}
	else {
		idiomachat =m.get_item_name(mres);
		writeprefs();
		send_reliable(peer_id, "idiomachat "+idiomachat, 0);
	}
}