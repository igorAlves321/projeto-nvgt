void servicesmenu(){
	cm();
	if(ausente||!moveable)return;
	m.add_item_tts(pu.get_value("Converta seu dinheiro."), "conversiones");
	m.add_item_tts(pu.get_value("Alterar status."), "status");
	m.add_item_tts(pu.get_value("Alterar o nome."), "changename");
	m.add_item_tts(pu.get_value("Consultar o clima de uma cidade."), "get_weather");
	m.add_item_tts(pu.get_value("Pagar o aluguel."), "pay");
	m.add_item_tts(pu.get_value("Ver tempos restantes de poÁıes."), "times");
	m.add_item_tts(pu.get_value("Ver construÁıes atualmente disponÌveis."), "list_crafts");
	m.add_item_tts(pu.get_value("Ligar para um serviÁo."), "llamar");
	m.add_item_tts(pu.get_value("Alterar o nome do seu filhote."), "rnc");
	m.add_item_tts(pu.get_value("bot„o voltar."),"back");
	int mres=m.run(pu.get_value("Escolha o serviÁo que desejar."), true);
	if(m.get_item_name(mres)=="back"){celularmenu();
	}
	else if(m.get_item_name(mres)=="conversiones"){
		converter_menu();
	}
	else if(m.get_item_name(mres)=="status"){
		string status=v.input(pu.get_value("escreva seu novo status."));
		if(status!=""&&status.length()<=4096){
			send_reliable(peer_id, "/setstatus "+status, 1);
		}
	}
	else if(m.get_item_name(mres)=="changename"){
		string name=v.input(pu.get_value("Escreva o novo nome que deseja para seu personagem."));
		if(name!=""&&!msginvalida(name)&&name.length()<30) send_reliable(peer_id, "change_name "+name, 0);
	}
	else if(m.get_item_name(mres)=="get_weather"){
		string error_code;
		string city=v.input(pu.get_value("escreva o nome da cidade cujo clima quer conhecer."));
		if(city!=""){
			weather_info w_i;
			w_i.set_city(city, error_code);
			if(error_code=="404"){
				speak(pu.get_value("erro: a cidade n„o pÙde ser encontrada."));
				return;
			}
			string text=pu.get_value("informaÁ„o atual sobre o clima de")+" "+city+": "+pu.get_value("a condiÁ„o do cÈu È")+" "+pu.get_value(w_i.get_description())+". "+pu.get_value("a temperatura atual È de")+" "+w_i.get_current_temp()+"∞C, "+pu.get_value("sendo a sensaÁ„o tÈrmica de")+" "+w_i.get_feel_like_temp()+"∞C. "+pu.get_value("as temperaturas mÌnimas esperadas por enquanto s„o de")+" "+w_i.get_temp_min()+"∞C "+pu.get_value("e as temperaturas m·ximas esperadas s„o de")+" "+w_i.get_temp_max()+"∞C. "+pu.get_value("a velocidade do vento È de aproximadamente")+" "+w_i.get_wind_speed()+" "+pu.get_value("metros por segundo.");
			int option=q_pro(pu.get_value("o resultado da sua busca est· pronto. Deseja copi·-lo para sua ·rea de transferÍncia?"));
			if(option==1){
				clipboard_copy_text(text);
				speak(pu.get_value("resultado copiado."));
			}
			else{
				add_add_item("avisos", text);
			}
		}
	}
	else if(m.get_item_name(mres)=="pay"){
		int option=q_pro(pu.get_value("Deseja pagar as contas do aluguel agora?"));
		if(option==1){
			send_reliable(peer_id, "pay_island", 13);
		}
		else{
			return;
		}
	}
	else if(m.get_item_name(mres)=="times"){
		send_unreliable(peer_id, "times", 0);
	}
	else if(m.get_item_name(mres)=="list_crafts"){
		send_reliable(peer_id, "list_crafts", 13);
	}
	else if(m.get_item_name(mres)=="llamar"){
		string telefonar=tel2.input("");
		if(telefonar=="4376238"){
			sound s;
			s.load("telefone.ogg");
			int a=random(2, 4);
			for(int i=0;i<a;i++){
				s.play();
				while(s.playing){
					mainloop();
					wait(5);
				}
			}
			send_unreliable(event.peer_id, "comida opcion", 0);
		}
		else if(telefonar=="7124869"){
			sound s;
			s.load("telefone.ogg");
			int a=random(2, 4);
			for(int i=0;i<a;i++){
				s.play();
				while(s.playing){
					mainloop();
					wait(5);
				}
			}
			send_unreliable(event.peer_id, "nave", 0);
		}
		else if(telefonar=="3812742"){
			send_reliable(peer_id, "arena", 13);
		}
	}
	else if(m.get_item_name(mres)=="rnc"){
		send_reliable(peer_id, "rnc", 0);
	}
}
