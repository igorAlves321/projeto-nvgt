void audiosmenu(){
string[] audios=find_files("audios/*.wav");
if(audios.length()==0)return;
setupmenu3();
for(uint i=0; i<audios.length(); i++){
m.add_item_tts(string_replace(audios[i], ".wav", "", true), audios[i]);
}
m.add_item_tts(pu.get_value("apagar todos os ·udios."), "delete");
int mres=m.run(pu.get_value("escolha o ·udio que deseje reproduzir."), true);
if(mres==0){
return;
}
else{
file f;
f.open("audios/"+m.get_item_name(mres), "rb");
string content=f.read();
f.close();
audio.play_stationary(content, false, true);
}
if(m.get_item_name(mres)=="delete") {
for(uint i=0; i<audios.length(); i++){
file_delete("audios/"+audios[i]);
}
speak(pu.get_value("·udios apagados."));
}
}

void permanentsmenu(){
string[] permanents=find_files("permanents/*.log");
if(permanents.length()==0)return;
setupmenu3();
inmenu=true;
for(uint i=0; i<permanents.length(); i++){
m.add_item_tts(string_replace(permanents[i], ".log", "", true), permanents[i]);
}
if(permanents.length()>0)m.add_item_tts(pu.get_value("apagar todos os permanentes."), "borrar");
int mres=m.run(pu.get_value("escolha a mensagem permanente que deseje ler."), true);
if(mres==0){
inmenu=false;
return;
}
else if(m.get_item_name(mres)=="borrar"){
string[] files=find_files("permanents/*.log");
for(uint i=0; i<files.length(); i++){
file_delete("permanents/"+files[i]);
}
speak(pu.get_value("mensagens permanentes apagadas."));
}
else{
file f;
f.open("permanents/"+m.get_item_name(mres), "r");
string content=f.read();
f.close();
int counter=-1;
string[] text=string_split(content, "\r\n", false);
for(uint i=0; i<text.length(); i++){
text[i]=string_replace(text[i], "mensaje de", pu.get_value("mensagem de"), true);
}
speak(pu.get_value("menu de leitura."));
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE)){
inmenu=false;
break;
}
if(key_pressed(KEY_HOME)&&counter>0){
counter=0;
speak(text[counter]);
}
if(key_pressed(KEY_END)&&counter<text.length()-1){
counter=text.length()-1;
speak(text[counter]);
}
if(down.pressing()&&counter<text.length()-1){
counter++;
speak(text[counter]);
}
if(up.pressing()&&counter>0){
counter--;
speak(text[counter]);
}
}
}
}
void correccionmenu(){
string[] data=map2;
data.remove_at(data.length()-1);
data.remove_at(data.length()-1);
int contador=-1, contador2=0, contador3=0;
string[]namemap=string_split(data[0], ":", false);
string[] selected, search2;
string search;
string save;
int linesaved;
string final;
int actual=-1;
int find;
speak(pu.get_value("atualmente vocÍ est· modificando o cÛdigo do seguinte mapa: ")+pu.get_value(namemap[1])+". "+pu.get_value("Para modificar uma linha pressione enter nela e para excluÌ-la pressione delete. para sair deste menu pressione escape e para se mover nele pressione setas direita ou esquerda, ou inÌcio e fim. se desejar atualizar o mapa pressione shift+enter. se o que desejar È fazer uma busca com palavras-chave para localizar um elemento do cÛdigo pressione ctrl+b, e para se mover entre os resultados pressione tab ou shift+tab. para adicionar uma linha ao final do cÛdigo pressione ctrl+a."));
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE))break;
if(!shift_pressionado()){
if(key_pressed(KEY_RETURN)&&contador>-1||key_pressed(KEY_NUMPADENTER)&&contador>-1){
string text=data[contador];
string code=v.input(pu.get_value("esta È a linha atual. se desejar copi·-la pressione ctrl+c, se desejar modific·-la mova-se com setas atÈ o ponto que desejar."), text);
if(code!=""){
data[contador]=string_replace(data[contador], text, code, false);
speak(pu.get_value("linha atualizada."));
}
}
if(key_pressed(KEY_TAB)){
if(search==""){
speak(pu.get_value("n„o h· nenhum termo de busca disponÌvel."));
}
else if(actual<search2.length()-1){
actual++;
find=data.find(search2[actual]);
contador=find;
speak(search2[actual]);
}
}
}
if(key_pressed(KEY_DELETE)&&contador>0){
save=data[contador];
linesaved=contador;
data.remove_at(contador);
speak(pu.get_value("linha excluÌda."));
contador--;
}
if(shift_pressionado()){
if(key_pressed(KEY_TAB)){
if(search==""){
speak(pu.get_value("n„o h· nenhum termo de busca disponÌvel."));
}
else if(actual>0){
actual--;
find=data.find(search2[actual]);
contador=find;
speak(search2[actual]);
}
}
if(key_pressed(KEY_RETURN)||key_pressed(KEY_NUMPADENTER)){
send_reliable(event.peer_id, "/rawdata "+linear(data), 1);
}
}
if(key_down(KEY_LCONTROL)||key_down(KEY_RCONTROL)){
if(key_pressed(KEY_A)){
string lastline=v.input(pu.get_value("escreva a linha que deseja adicionar."));
if(lastline!=""){
data.insert_last(lastline);
speak(pu.get_value("linha adicionada."));
}
}
if(key_pressed(KEY_B)){
if(search==""){
search=v.input(pu.get_value("escreva as palavras-chave da sua busca."));
if(search!=""){
for(uint i=0; i<data.length(); i++){
if(string_contains(data[i], search, 1)>-1){
final+=data[i]+"\r\n";
}
}
search2=string_split(final, "\r\n", false);
actual++;
find=data.find(search2[actual]);
if(find==-1){
speak(pu.get_value("este termo n„o est· disponÌvel no cÛdigo do mapa."));
}
else{
contador=find;
speak(search2[actual]);
}
}
}
}
if(key_pressed(KEY_Z)){
if(data.find(save)>0){
speak(pu.get_value("n„o faz sentido restaurar uma linha mais de 1 vez, te digo a sÈrio."));
}
else if(save==""){
speak(pu.get_value("olha que curioso, tentando restaurar uma linha vazia. gÍnio, sim senhor!"));
}
else{
data.insert_at(linesaved, save);
speak(pu.get_value("a linha n˙mero")+" "+linesaved+" "+pu.get_value("com o seguinte conte˙do (")+save+") "+pu.get_value("foi restaurada corretamente."));
}
}
}
if(key_pressed(KEY_HOME)&&contador>-1){
contador=0;
speak(data[contador]);
}
if(key_pressed(KEY_END)&&contador<data.length()-1){
contador=data.length()-1;
speak(data[contador]);
}
if(right.pressing()&&contador<data.length()-1){
contador++;
speak(data[contador]);
}
if(left.pressing()&&contador>0){
contador--;
speak(data[contador]);
}
}
}
