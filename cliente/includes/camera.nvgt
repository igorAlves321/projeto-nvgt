
void camera_reset() {
	camera.x = me.x;
	camera.y = me.y;
}

void camera_activate() {
	camera_reset();
	camera.active = true;
}

void camera_deactivate() {
	camera.active = false;
	camera_reset();
}

string get_camera_tile() {
	return get_tile_at(camera.x, camera.y);
}

void playcamera() {
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].x == camera.x && players[i].y == camera.y && players[i].beeping == 1) {
			p.play_extended_2d("beacon.ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
		}
	}

	string tile = get_camera_tile();

	if(tile == "") {
		p.play_2d("cameraair.ogg", me.x, me.y, camera.x, camera.y, false);
	}
	else if(tile == "hazard") {
		p.play_2d("camerahazard.ogg", me.x, me.y, camera.x, camera.y, false);
	}
	else if(string_contains(tile, "wall", 1) > -1) {
		p.play_extended_2d(tile + ".ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
	}
	else {
		p.play_extended_2d(tile + "step" + random(1, 5) + ".ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
	}
}

void playcameracustom(int x, int y) {
	string gt = get_tile_at(x, y);

	if(gt == "") {
		p.play_2d("cameraair.ogg", me.x, me.y, x, y, false);
	}
	else if(gt == "hazard") {
		p.play_2d("camerahazard.ogg", me.x, me.y, x, y, false);
	}
	else if(gt == "wall" || string_contains(gt, "wall", 1) > -1) {
		p.play_2d("camerawall.ogg", me.x, me.y, x, y, false);
	}
	else {
		p.play_2d("cameratile.ogg", me.x, me.y, x, y, false);
	}
}

void camera_exploration_loop() {
	if(!key_down(KEY_G) || ausente || dcamera == 1 || !moveable) {
		return;
	}

	if(!camera.active) {
		camera_activate();
	}

	if(key_pressed(KEY_C) && dcoordenadas == 0) {
		speak(camera.x + ", " + camera.y);
	}

	if(key_pressed(KEY_R)) {
		playcamera();
		string tile = get_camera_tile();
		string what = get_zone_at(camera.x, camera.y);

		for(uint i = 0; i < players.length(); i++) {
			if(players[i].x == camera.x && players[i].y == camera.y && players[i].beeping == 1) {
				what = players[i].charname;
				break;
			}
		}

		if(tile != "") {
			if(dcoordenadas == 0) speak(what + ", " + camera.x + ", " + camera.y);
			else speak(what);
		}
		else {
			if(dcoordenadas == 0) speak(pu.get_value("ar") + " " + what + ", " + camera.x + ", " + camera.y);
			else speak(pu.get_value("ar") + " " + what);
		}
	}

	if(!key_pressed(KEY_LEFT) && kleft.pressing() && camera.x > 0) {
		camera.x -= 1;
		playcamera();
		if(string_contains(get_camera_tile(), "wall", 1) > -1) {
			camera.x += 1;
		}
	}

	if(!key_pressed(KEY_RIGHT) && kright.pressing() && camera.x < max.x) {
		camera.x += 1;
		playcamera();
		if(string_contains(get_camera_tile(), "wall", 1) > -1) {
			camera.x -= 1;
		}
	}

	if(!key_pressed(KEY_DOWN) && kdown.pressing() && camera.y > 0) {
		camera.y -= 1;
		playcamera();
		if(string_contains(get_camera_tile(), "wall", 1) > -1) {
			camera.y += 1;
		}
	}

	if(!key_pressed(KEY_UP) && kup.pressing() && camera.y < max.y) {
		camera.y += 1;
		playcamera();
		if(string_contains(get_camera_tile(), "wall", 1) > -1) {
			camera.y -= 1;
		}
	}
}

void camera_check_release() {
	if(key_up(KEY_G) && dcamera == 0 && moveable) {
		if(camera.active) {
			camera_deactivate();
		}
		camera.x = me.x;
		camera.y = me.y;
	}
}

bool is_camera_exploring() {
	return camera.active && key_down(KEY_G);
}
