sound dlgaudio;

class dialog {
	string message;
	int x, y;
	bool active;

	dialog() {
		message = "";
		x = 0;
		y = 0;
		active = false;
	}

	dialog(string msg, int posx, int posy) {
		message = msg;
		x = posx;
		y = posy;
		active = true;
	}
}

dialog@[] dialogs;

void fade(sound@ s, int target_volume, int speed) {
	int current_volume = s.volume;
	if(current_volume > target_volume) {
		for(int v = current_volume; v > target_volume; v -= speed) {
			s.volume = v;
			wait(10);
		}
	} else {
		for(int v = current_volume; v < target_volume; v += speed) {
			s.volume = v;
			wait(10);
		}
	}
	s.volume = target_volume;
}

void spawn_dialog(string msg, int x, int y) {
	dialog d(msg, x, y);
	dialogs.push_back(d);
}

void destroy_all_dialogs() {
	dialogs.resize(0);
}

void dialog_loop() {
	for(uint i = 0; i < dialogs.length(); i++) {
		if(dialogs[i].active && me.x == dialogs[i].x && me.y == dialogs[i].y) {
			dlg(dialogs[i].message);
			dialogs[i].active = false;
		}
	}
}
