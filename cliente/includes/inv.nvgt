				counter = peramitors.length() - 1;    string content = string_decrypt(f.read(), PREFS_ENCRYPTION_KEY);

			}    f.close();

			if(counter < 0) counter = 0;

		}    string[] lines = content.split("\r\n");

		

		if(peramitors.length() == 0) {    for(uint x = 0; x < lines.length(); x++) {

			speak("Inventário vazio", true);        string[] data = lines[x].split("=");

			break;        if(data[0] == "categories" && data.length() > 1) {

		}            string[] categories = data[1].split(",");

		            for(uint y = 0; y < categories.length(); y++) {

		// NAVEGAÇÃO                if(categories[y] != "" && categories[y] != "all") {

		                    create_category(categories[y], false);

		// Seta CIMA - Item anterior                }

		if(key_pressed(KEY_UP) && counter > 0) {            }

			counter--;        }

			string invitem = pu.get_value(peramitors[counter]);        if(data[0] == "items_to_set" && data.length() > 1) {

			speak(invitem + ", " + inv_item_number(peramitors[counter]), true);            string[] items = data[1].split(",");

			p.play_stationary("soundinv.ogg", false);            for(uint y = 0; y < items.length(); y++) {

		}                string[] item_data = items[y].split(":");

		                if(item_data.length() >= 2) {

		// Seta BAIXO - Próximo item                    int cat_idx = get_category_index(item_data[1]);

		if(key_pressed(KEY_DOWN) && counter < int(peramitors.length()) - 1) {                    if(cat_idx >= 0) {

			counter++;                        inv_categories[cat_idx].add_new_item(item_data[0]);

			string invitem = pu.get_value(peramitors[counter]);                    }

			speak(invitem + ", " + inv_item_number(peramitors[counter]), true);                }

			p.play_stationary("soundinv.ogg", false);            }

		}        }

		    }

		// HOME - Primeiro item

		if(key_pressed(KEY_HOME)) {    // Garantir que categoria "all" existe

			counter = 0;    if(get_category_index("all") < 0) {

			string invitem = pu.get_value(peramitors[counter]);        inv_category@ all_cat = inv_category("all");

			speak(invitem + ", " + inv_item_number(peramitors[counter]), true);        inv_categories.insert_at(0, all_cat);

			p.play_stationary("soundinv.ogg", false);    }

		}}

		

		// END - Último item// =========================

		if(key_pressed(KEY_END)) {// MENU DE INVENTÁRIO

			counter = peramitors.length() - 1;// =========================

			string invitem = pu.get_value(peramitors[counter]);

			speak(invitem + ", " + inv_item_number(peramitors[counter]), true);void invmenu(string category, string sonido = "abrirziper.ogg") {

			p.play_stationary("soundinv.ogg", false);    reset_all_forced_keys();

		}    key_hold iup(KEY_UP, 500, 50);

		    key_hold idown(KEY_DOWN, 500, 50);

		// AÇÕES (usando funções que já existem em client.nvgt)    key_hold ileft(KEY_LEFT, 500, 50);

		    key_hold iright(KEY_RIGHT, 500, 50);

		// ESPAÇO - Usar item (TODO: implementar interact quando existir)    key_hold idell(KEY_DELETE, 500, 50);

		if(key_pressed(KEY_SPACE) && !shift_pressionado()) {

			// interact(peramitors[counter]);  // Comentado até implementar    int counter = 0;

			speak("Usando " + pu.get_value(peramitors[counter]), true);    send_unreliable(peer_id, "playsocial " + sonido, 0);

			debug_log("✋ Tentando usar: " + peramitors[counter]);

		}    // Obter itens da categoria atual

		    string[] peramitors = player_inv.get_keys();

		// SHIFT + ESPAÇO - Selecionar/Desselecionar item

		if(key_pressed(KEY_SPACE) && shift_pressionado()) {    if(peramitors.length() == 0) {

			if(item_is_selected(peramitors[counter])) {        speak(pu.get_value("Inventário vazio."));

				bool unselect = unselect_item(peramitors[counter]);        return;

				if(unselect) {    }

					speak(pu.get_value(peramitors[counter]) + " não selecionado", true);

					item_to_move = "";    // Anunciar categoria

					item_to_move_index = -1;    if(inv_categories[cindex].name == "all") {

				}        speak(pu.get_value("compartimento_geral") + " " + peramitors.length() + " " + pu.get_value("itens"));

			} else {    } else {

				bool select = select_item(peramitors[counter]);        int category_count = 0;

				if(select) {        for(uint x = 0; x < inv_categories[cindex].items_in_category.length(); x++) {

					speak(pu.get_value(peramitors[counter]) + " selecionado", true);            if(inv_item_number(inv_categories[cindex].items_in_category[x]) > 0) {

					item_to_move = peramitors[counter];                category_count++;

					item_to_move_index = counter;            }

				}        }

			}        speak(inv_categories[cindex].name + ", " + category_count + " " + pu.get_value("elementos."));

		}    }

		

		// ENTER - Dar item (usando função que já existe)    // Loop do menu

		if(key_pressed(KEY_RETURN) && !shift_pressionado() && !key_down(KEY_LCONTROL)) {    while(true) {

			give(peramitors[counter]);        wait(5);

		}

		        if(ausente || !moveable || dinventario == 1) break;

		// DELETE - Dropar item (usando função que já existe)

		if(key_pressed(KEY_DELETE)) {        // Atualizar lista de itens

			if(shift_pressionado()) {        peramitors.resize(0);

				// Shift + Delete: perguntar quantidade        string[] all_items = player_inv.get_keys();

				string stuff = v.input("Quantos desse item você quer deletar?");

				if(stuff.length() > 0 && stuff.length() < 10) {        if(cindex == 0) {

					int s = string_to_number(stuff);            // Categoria "all" - todos os itens

					if(s > 0) drop(peramitors[counter], s);            peramitors = all_items;

				}        } else {

			} else if(key_down(KEY_LCONTROL) || key_down(KEY_RCONTROL)) {            // Categoria específica - filtrar itens

				// Ctrl + Delete: dropar tudo            for(uint x = 0; x < inv_categories[cindex].items_in_category.length(); x++) {

				int s = inv_item_number(peramitors[counter]);                string item_name = inv_categories[cindex].items_in_category[x];

				drop(peramitors[counter], s);                if(inv_item_number(item_name) > 0) {

			} else {                    peramitors.insert_last(item_name);

				// Delete normal: dropar 1                }

				drop(peramitors[counter], 1);            }

			}        }

		}

		        if(peramitors.length() == 0) break;

		// ESC - Fechar inventário        if(counter >= int(peramitors.length())) counter = peramitors.length() - 1;

		if(key_pressed(KEY_ESCAPE)) {        if(counter < 0) counter = 0;

			send_unreliable(peer_id, "playsocial fecharziper.ogg", 0);

			inv_items_selected.resize(0);        // Navegação entre categorias (Left/Right)

			debug_log("📦 Inventário fechado");        if(ileft.pressing() && cavando == 0 && inv_categories.length() > 1) {

			return;            cindex--;

		}            if(cindex < 0) cindex = inv_categories.length() - 1;

	}            invmenu(inv_categories[cindex].name, "mobeziper.ogg");

}            break;

        }

// ========== INICIALIZAÇÃO ==========        if(iright.pressing() && cavando == 0 && inv_categories.length() > 1) {

            cindex++;

void init_inventory() {            if(cindex >= int(inv_categories.length())) cindex = 0;

	// Criar categoria padrão "all"            invmenu(inv_categories[cindex].name, "mobeziper.ogg");

	if(inv_categories.length() == 0) {            break;

		create_category("all", false);        }

	}

	debug_log("📦 Sistema de inventário inicializado");        // Navegação entre itens (Up/Down)

}        if(iup.pressing() && cavando == 0 && counter > 0) {
            counter--;
            p.play_stationary(soundinv, false);
            speak(pu.get_value(peramitors[counter]) + ", " + inv_item_number(peramitors[counter]));
        }
        if(idown.pressing() && cavando == 0 && counter < int(peramitors.length()) - 1) {
            counter++;
            p.play_stationary(soundinv, false);
            speak(pu.get_value(peramitors[counter]) + ", " + inv_item_number(peramitors[counter]));
        }

        // Home/End
        if(key_pressed(KEY_HOME) && peramitors.length() > 0 && cavando == 0) {
            counter = 0;
            p.play_stationary(soundinv, false);
            speak(pu.get_value(peramitors[counter]) + ", " + inv_item_number(peramitors[counter]));
        }
        if(key_pressed(KEY_END) && peramitors.length() > 0 && cavando == 0) {
            counter = peramitors.length() - 1;
            p.play_stationary(soundinv, false);
            speak(pu.get_value(peramitors[counter]) + ", " + inv_item_number(peramitors[counter]));
        }

        // Usar item (Space)
        if(key_pressed(KEY_SPACE) && peramitors.length() > 0 && counter < int(peramitors.length())) {
            interact(peramitors[counter]);
        }

        // Dar item (Enter)
        if(key_pressed(KEY_RETURN) && peramitors.length() > 0) {
            give(peramitors[counter]);
        }

        // Dropar item (Delete)
        if(idell.pressing() && droptimer.elapsed >= droptime && peramitors.length() > 0 && cavando == 0) {
            droptimer.restart();
            if(key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT)) {
                string stuff = v.input(pu.get_value("Quantos desse item você quer deletar?"));
                int amount = string_to_number(stuff);
                if(amount > 0) drop(peramitors[counter], amount);
            } else if(key_down(KEY_LCONTROL) || key_down(KEY_RCONTROL)) {
                int amount = inv_item_number(peramitors[counter]);
                drop(peramitors[counter], amount);
            } else {
                drop(peramitors[counter], 1);
            }
        }

        // Sair (Escape)
        if(key_pressed(KEY_ESCAPE) && cavando == 0) {
            send_unreliable(peer_id, "playsocial fecharziper.ogg", 0);
            copiaragora = "";
            return;
        }
    }
}

// Inicializar sistema de inventário
void init_inventory() {
    debug_log("📦 Inicializando sistema de inventário...");

    // Carregar categorias
    load_categories_and_items();

    // Garantir que categoria "all" existe
    if(inv_categories.length() == 0) {
        create_category("all", false);
    }

    debug_log("📦 Inventário inicializado com " + inv_categories.length() + " categorias");
}
