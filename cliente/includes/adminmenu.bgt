void adminmenu(){
setupmenu(false);
m.add_item_tts(pu.get_value("ativar/desativar xp especial."), "xpespecial");
m.add_item_tts(pu.get_value("ativar ou desativar combate."), "pvp");
m.add_item_tts(pu.get_value("ativar ou desativar uso de minas."), "minas");
m.add_item_tts(pu.get_value("aviso geral."), "aviso");
m.add_item_tts(pu.get_value("banir um jogador temporariamente."), "ban");
m.add_item_tts(pu.get_value("alterar a mensagem do dia no chat administrativo."), "admin");
m.add_item_tts(pu.get_value("alterar a mensagem do dia no chat espanhol."), "spanish");
m.add_item_tts(pu.get_value("alterar a mensagem do dia no chat inglês."), "english");
m.add_item_tts(pu.get_value("alterar a mensagem do dia no chat francês."), "francais");
m.add_item_tts(pu.get_value("alterar a mensagem do dia no chat português."), "portugues");
m.add_item_tts(pu.get_value("alterar a mensagem do dia no chat turco."), "turkish");
m.add_item_tts(pu.get_value("dar esmeraldas para um jogador."), "esmeraldas");
m.add_item_tts(pu.get_value("dar celestiums para um jogador."), "celestiums");
m.add_item_tts(pu.get_value("dar um item para um jogador."), "item");
m.add_item_tts(pu.get_value("dar presentes."), "regalos");
m.add_item_tts(pu.get_value("mostrar e filtrar sons do jogo."), "sounds");
m.add_item_tts(pu.get_value("silenciar um jogador."), "silenciar");
m.add_item_tts(pu.get_value("enviar um áudio para o servidor."), "audio");
m.add_item_tts(pu.get_value("traduções."), "langs");
int mres=m.run(pu.get_value("menu do administrador. escolha com cuidado a opção que desejar."), true);
if(m.get_item_name(mres)=="xpespecial"){
send_unreliable(event.peer_id, "/xps", 1);
}
if(m.get_item_name(mres)=="pvp"){
send_unreliable(event.peer_id, "/pvp", 1);
}
if(m.get_item_name(mres)=="bombas"){
send_unreliable(event.peer_id, "/abomba", 1);
}
if(m.get_item_name(mres)=="cintas"){
send_unreliable(event.peer_id, "/afita", 1);
}
if(m.get_item_name(mres)=="minas"){
send_unreliable(event.peer_id, "/amina", 1);
}
if(m.get_item_name(mres)=="aviso"){
string aviso=v.input(pu.get_value("escreva o que quer dizer pelo canal geral."));
if(aviso!=""){
send_unreliable(event.peer_id, "/n "+aviso, 1);
}
}
if(m.get_item_name(mres)=="ban"){
string player=v.input(pu.get_value("escreva o nome do jogador que deseja banir."));
if(player!=""){
int dias;
int opcion=1;
speak(pu.get_value("por quantos dias?"));
while(true){
wait(5);
mainloop();
if(right.pressing()&&opcion<1000){
opcion++;
speak(opcion);
p.play_stationary("menumove3.ogg", false);
}
else if(left.pressing()&&opcion>1){
opcion--;
speak(opcion);
p.play_stationary("menumove3.ogg", false);
}
if(key_pressed(KEY_END)&&opcion<1000){
opcion=1000;
speak(opcion);
p.play_stationary("menumove3.ogg", false);
}
if(key_pressed(KEY_HOME)&&opcion>1){
opcion=1;
speak(opcion);
p.play_stationary("menumove3.ogg", false);
}
if(key_pressed(KEY_RETURN)||key_pressed(KEY_NUMPADENTER)){
dias=opcion;
if(dias>0){
string motivo=v.input(pu.get_value("qual é o motivo do banimento?"));
if(motivo==""){
speak(pu.get_value("cancelado."));
break;
}
else{
send_unreliable(event.peer_id, "/tb "+player+" "+dias+" "+motivo, 1);
break;
}
}
}
if(key_pressed(KEY_ESCAPE)){
break;
}
}
}
}
if(m.get_item_name(mres)=="admin"){
string msg=v.input(pu.get_value("escreva a mensagem que deseja para este canal."));
if(msg!=""){
send_unreliable(event.peer_id, "/msga "+msg, 1);
}
}
if(m.get_item_name(mres)=="spanish"){
string msg=v.input(pu.get_value("escreva a mensagem que deseja para este canal."));
if(msg!=""){
send_unreliable(event.peer_id, "/msges "+msg, 1);
}
}
if(m.get_item_name(mres)=="english"){
string msg=v.input(pu.get_value("escreva a mensagem que deseja para este canal."));
if(msg!=""){
send_unreliable(event.peer_id, "/msgen "+msg, 1);
}
}
if(m.get_item_name(mres)=="francais"){
string msg=v.input(pu.get_value("escreva a mensagem que deseja para este canal."));
if(msg!=""){
send_unreliable(event.peer_id, "/msgfr "+msg, 1);
}
}
if(m.get_item_name(mres)=="portugues"){
string msg=v.input(pu.get_value("escreva a mensagem que deseja para este canal."));
if(msg!=""){
send_unreliable(event.peer_id, "/msgpt "+msg, 1);
}
}
if(m.get_item_name(mres)=="turkish"){
string msg=v.input(pu.get_value("escreva a mensagem que deseja para este canal."));
if(msg!=""){
send_unreliable(event.peer_id, "/msgtr "+msg, 1);
}
}
if(m.get_item_name(mres)=="esmeraldas"){
string player=v.input(pu.get_value("para qual jogador deseja dar esmeraldas?"));
if(player!=""){
string esmeraldas=v.input(pu.get_value("quantas?"));
if(esmeraldas!=""){
double esmeralds=string_to_number(esmeraldas);
send_unreliable(event.peer_id, "/dare "+player+" "+esmeralds, 1);
}
}
}
if(m.get_item_name(mres)=="celestiums"){
string player=v.input(pu.get_value("para qual jogador deseja dar celestiums?"));
if(player!=""){
string celestiums=v.input(pu.get_value("quantos?"));
if(celestiums!=""){
double celestiums2=string_to_number(celestiums);
send_unreliable(event.peer_id, "/darc "+player+" "+celestiums2, 1);
}
}
}
if(m.get_item_name(mres)=="item"){
string player=v.input(pu.get_value("para qual jogador deseja dar um objeto?"));
if(player!=""){
string item=v.input(pu.get_value("qual?"));
if(item!=""){
string cantidad=v.input(pu.get_value("quantos?"));
if(cantidad!=""){
double cantidad2=string_to_number(cantidad);
send_unreliable(event.peer_id, "/dar "+player+" "+item+" "+cantidad, 1);
}
}
}
}
if(m.get_item_name(mres)=="regalos"){
string item=v.input(pu.get_value("que item deseja presentear?"));
if(item!=""){
string cantidad=v.input(pu.get_value("quantos?"));
if(cantidad!=""){
double cantidad2=string_to_number(cantidad);
send_unreliable(event.peer_id, "/regalos "+item+" "+cantidad2, 1);
}
}
}
if(m.get_item_name(mres)=="sounds"){
bool empty=false, enable_first_letter=false;
string filter=v.input(pu.get_value("escreva o termo com o qual queira filtrar os sons, seja uma palavra ou uma só letra se desejar que se filtre por letra inicial."));
if(filter==""){
empty=true;
}
if(filter.length()==1){
enable_first_letter=true;
}
else if(filter.length()>1){
enable_first_letter=false;
}
if(!empty){
string sound_name=get_sound(pu.get_value("se mostram os sons especificados."), filter, enable_first_letter);
if(sound_name!=""){
clipboard_copy_text(sound_name);
speak(pu.get_value("copiado."));
}
}
}
if(m.get_item_name(mres)=="silenciar"){
string player=v.input(pu.get_value("qual jogador deseja silenciar?"));
if(player!=""){
int minutos;
int opcion=1;
speak(pu.get_value("por quantos minutos?"));
while(true){
wait(5);
mainloop();
if(right.pressing()&&opcion<1000){
opcion++;
speak(opcion);
p.play_stationary("menumove3.ogg", false);
}
else if(left.pressing()&&opcion>1){
opcion--;
speak(opcion);
p.play_stationary("menumove3.ogg", false);
}
if(key_pressed(KEY_END)&&opcion<1000){
opcion=1000;
speak(opcion);
p.play_stationary("menumove3.ogg", false);
}
if(key_pressed(KEY_HOME)&&opcion>1){
opcion=1;
speak(opcion);
p.play_stationary("menumove3.ogg", false);
}
if(key_pressed(KEY_RETURN)||key_pressed(KEY_NUMPADENTER)){
minutos=opcion;
if(minutos>0){
send_unreliable(event.peer_id, "/silenciar "+player+" "+minutos, 1);
break;
}
}
if(key_pressed(KEY_ESCAPE)){
break;
}
}
}
}
if(m.get_item_name(mres)=="audio"){
uploadfile();
}
if(m.get_item_name(mres)=="langs"){
langs_menu();
}
}