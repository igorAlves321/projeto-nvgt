    form.add_text_field("category", pu.get_value("Categoria (material, quest, currency, junk)"), "material", true);
    form.add_number_field("max_stack", pu.get_value("MÃ¡ximo empilhÃ¡vel"), 64, true);
    form.add_number_field("weight", pu.get_value("Peso (kg)"), 1, true);
    form.add_number_field("value", pu.get_value("PreÃ§o (gold)"), 5, true);
    form.add_text_field("rarity", pu.get_value("Raridade"), "common", true);
    form.add_number_field("drop_rate", pu.get_value("Taxa de drop (0.0 a 1.0)"), 1.0, true);
    
    dictionary@ result = form.run();
    if(form.user_canceled) return;
    
    string name, display, desc, category, rarity;
    double max_stack, weight, value, drop_rate;
    result.get("name", name);
    result.get("display", display);
    result.get("desc", desc);
    result.get("category", category);
    result.get("max_stack", max_stack);
    result.get("weight", weight);
    result.get("value", value);
    result.get("rarity", rarity);
    result.get("drop_rate", drop_rate);
    
    // Formato: type|name|display|desc|category|damage|defense|heal|mp|weight|value|rarity|sound|max_stack|drop_rate
    string packet = "/create_item_tool misc|" + name + "|" + display + "|" + desc + "|" + category + "|" + 
                    "0|0|0|0|" + weight + "|" + int(value) + "|" + rarity + "||" + int(max_stack) + "|" + drop_rate;
    
    send_to_server(packet, 0, true);
    speak(pu.get_value("SolicitaÃ§Ã£o enviada: ") + display);
}

// ============================================================================
// LISTAR ITENS EXISTENTES (solicita ao servidor)
// ============================================================================
void item_builder_list_items() {
    send_to_server("/list_items", 0, true);
    speak(pu.get_value("Solicitando lista de itens ao servidor..."));
}


// ============================================================================
// EDITAR ITEM EXISTENTE
// Formato: name|display|desc|type|category|damage|defense|heal|mp|weight|value|rarity|sound|max_stack|drop_rate
// ============================================================================
void item_builder_edit_item() {
    input_form form(pu.get_value("Editar Item Existente"));
    
    form.add_text_field("name", pu.get_value("ID interno do item"), "", true);
    form.add_text_field("display", pu.get_value("Nome visivel"), "", true);
    form.add_text_field("desc", pu.get_value("Descricao"), "", true);
    form.add_text_field("type", pu.get_value("Tipo (weapon, armor, consumable, misc)"), "misc", true);
    form.add_text_field("category", pu.get_value("Categoria"), "material", true);
    form.add_number_field("damage", pu.get_value("Dano"), 0, true);
    form.add_number_field("defense", pu.get_value("Defesa"), 0, true);
    form.add_number_field("heal", pu.get_value("Cura HP"), 0, true);
    form.add_number_field("mp", pu.get_value("Restaura MP"), 0, true);
    form.add_number_field("weight", pu.get_value("Peso"), 1, true);
    form.add_number_field("value", pu.get_value("Valor"), 0, true);
    form.add_text_field("rarity", pu.get_value("Raridade"), "common", true);
    form.add_text_field("sound", pu.get_value("Som (arquivo ou vazio)"), "", false);
    form.add_number_field("max_stack", pu.get_value("Maximo empilhavel"), 1, true);
    form.add_number_field("drop_rate", pu.get_value("Taxa de drop (0.0 a 1.0)"), 1.0, true);
    
    dictionary@ result = form.run();
    if(form.user_canceled) return;
    
    string name, display, desc, type, category, rarity, sound;
    double damage, defense, heal, mp, weight, value, max_stack, drop_rate;
    result.get("name", name);
    result.get("display", display);
    result.get("desc", desc);
    result.get("type", type);
    result.get("category", category);
    result.get("damage", damage);
    result.get("defense", defense);
    result.get("heal", heal);
    result.get("mp", mp);
    result.get("weight", weight);
    result.get("value", value);
    result.get("rarity", rarity);
    result.get("sound", sound);
    result.get("max_stack", max_stack);
    result.get("drop_rate", drop_rate);
    
    string data = name + "|" + display + "|" + desc + "|" + type + "|" + category + "|" +
                  int(damage) + "|" + int(defense) + "|" + int(heal) + "|" + int(mp) + "|" +
                  weight + "|" + int(value) + "|" + rarity + "|" + sound + "|" +
                  int(max_stack) + "|" + drop_rate;
    
    send_to_server("/edit_item_tool " + data, 0, true);
    speak(pu.get_value("Solicitacao de edicao enviada: ") + name);
}

// ============================================================================
// EXCLUIR ITEM EXISTENTE
// ============================================================================
void item_builder_delete_item() {
    input_form form(pu.get_value("Excluir Item Existente"));
    form.add_text_field("name", pu.get_value("ID interno do item para excluir"), "", true);
    
    dictionary@ result = form.run();
    if(form.user_canceled) return;
    
    string name;
    result.get("name", name);
    
    if(name == "") {
        speak(pu.get_value("ID do item invalido."));
        return;
    }
    
    send_to_server("/delete_item_tool " + name, 0, true);
    speak(pu.get_value("Solicitacao de exclusao enviada: ") + name);
}

// NOTA: A funÃ§Ã£o send_to_server() Ã© definida em buildermenu.nvgt


