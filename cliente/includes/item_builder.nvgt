void item_builder_armor() {
    input_form form(pu.get_value("Criar Armadura"));
    
    form.add_text_field("name", pu.get_value("ID interno (ex: iron_armor)"), "", true);
    form.add_text_field("display", pu.get_value("Nome visÃ­vel (ex: Armadura de Ferro)"), "", true);
    form.add_text_field("desc", pu.get_value("DescriÃ§Ã£o"), "Uma armadura protetora.", true);
    form.add_text_field("category", pu.get_value("Parte do corpo (head, chest, legs, boots, gloves)"), "chest", true);
    form.add_number_field("defense", pu.get_value("Defesa"), 20, true);
    form.add_number_field("weight", pu.get_value("Peso (kg)"), 5, true);
    form.add_number_field("value", pu.get_value("PreÃ§o (gold)"), 200, true);
    form.add_text_field("rarity", pu.get_value("Raridade (common, uncommon, rare, epic, legendary)"), "common", true);
    
    dictionary@ result = form.run();
    if(form.user_canceled) return;
    
    string name, display, desc, category, rarity;
    double defense, weight, value;
    result.get("name", name);
    result.get("display", display);
    result.get("desc", desc);
    result.get("category", category);
    result.get("defense", defense);
    result.get("weight", weight);
    result.get("value", value);
    result.get("rarity", rarity);
    
    // Formato: type|name|display|desc|category|damage|defense|heal|mp|weight|value|rarity|sound
    string packet = "/create_item_tool armor|" + name + "|" + display + "|" + desc + "|" + category + "|" + 
                    "0|" + int(defense) + "|0|0|" + weight + "|" + int(value) + "|" + rarity + "|";
    
    send_to_server(packet, 0, true);
    speak(pu.get_value("SolicitaÃ§Ã£o enviada: ") + display);
}

