// ============================================================================
// CONSTRUTOR DE ITENS - NVGT
// Interface visual para criação de itens sem escrever código/SQL
// Integra-se ao menu de administração (F9)
// ============================================================================

// ============================================================================
// MENU PRINCIPAL DO CONSTRUTOR DE ITENS
// ============================================================================
void item_builder_menu() {
    item_builder_request_meta();
    while(true) {
        setupmenu();
        
        // Categorias de itens
        game_menu.add_item(pu.get_value("Arma de Fogo"), "weapon_gun");
        game_menu.add_item(pu.get_value("Arma Corpo a Corpo"), "weapon_melee");
        game_menu.add_item(pu.get_value("Armadura"), "armor");
        game_menu.add_item(pu.get_value("Consumível (Poção/Comida)"), "consumable");
        game_menu.add_item(pu.get_value("Material/Loot"), "misc");
        game_menu.add_item(pu.get_value("Listar Itens Existentes"), "list");
        game_menu.add_item(pu.get_value("Editar Item Existente"), "edit");
        game_menu.add_item(pu.get_value("Excluir Item Existente"), "delete");
        game_menu.add_item(pu.get_value("Voltar"), "back");
        
        game_menu.intro_text = pu.get_value("Construtor de Itens. Selecione o tipo de item que deseja criar.");
        
        int res = game_menu.run();
        if(res < 0) return;
        
        string type = game_menu.get_item_id(res);
        if(type == "back") return;
        
        if(type == "list") {
            item_builder_list_items();
        }
        else if(type == "edit") {
            item_builder_edit_item();
        }
        else if(type == "delete") {
            item_builder_delete_item();
        }
        else if(type == "weapon_gun") {
            item_builder_weapon_gun();
        }
        else if(type == "weapon_melee") {
            item_builder_weapon_melee();
        }
        else if(type == "armor") {
            item_builder_armor();
        }
        else if(type == "consumable") {
            item_builder_consumable();
        }
        else if(type == "misc") {
            item_builder_misc();
        }
    }
}

bool item_builder_is_blank(const string&in value) {
    return value.trim_whitespace() == "";
}

bool item_builder_is_valid_identifier(const string&in value) {
    string v = value.trim_whitespace();
    if(v == "" || v.find(" ") >= 0) return false;
    for(uint i = 0; i < v.length(); i++) {
        string ch = v.substr(i, 1);
        bool is_letter = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z");
        bool is_digit = (ch >= "0" && ch <= "9");
        bool is_ok = is_letter || is_digit || ch == "_";
        if(!is_ok) return false;
    }
    return true;
}

bool item_builder_is_valid_number_string(const string&in value, bool allow_decimal) {
    string v = value.trim_whitespace();
    if(v == "") return false;
    bool has_digit = false;
    int dot_count = 0;
    for(uint i = 0; i < v.length(); i++) {
        string ch = v.substr(i, 1);
        if(ch >= "0" && ch <= "9") {
            has_digit = true;
            continue;
        }
        if(ch == "-" && i == 0) continue;
        if(allow_decimal && ch == ".") {
            dot_count++;
            if(dot_count > 1) return false;
            continue;
        }
        return false;
    }
    return has_digit;
}

bool item_builder_validate_required_field(const string&in field_name, const string&in value) {
    if(item_builder_is_blank(value)) {
        speak(pu.get_value("Campo vazio: ") + field_name, true);
        return false;
    }
    return true;
}

void item_builder_speak_invalid_field(const string&in field_name) {
    speak(pu.get_value("Dados invalidos: ") + field_name, true);
}

bool item_builder_validate_max_length(const string&in field_name, const string&in value, int max_len) {
    if(value.length() > uint(max_len)) {
        item_builder_speak_invalid_field(field_name);
        return false;
    }
    return true;
}

bool item_builder_confirm_send(const string&in label_text) {
    setupmenu();
    game_menu.add_item(pu.get_value("Sim"), "yes");
    game_menu.add_item(pu.get_value("Nao"), "no");
    game_menu.intro_text = pu.get_value("Confirmar envio: ") + label_text;
    int res = game_menu.run();
    if(res < 0) return false;
    return game_menu.get_item_id(res) == "yes";
}

dictionary@ item_builder_run_form_with_network(input_form@ form) {
    dictionary@ result = null;
    while((@result = form.monitor()) == null) {
        if(is_connected) {
            netloop();
            if(heartbeat_timer.elapsed >= HEARTBEAT_INTERVAL) {
                heartbeat_timer.restart();
                send_unreliable(peer_id, "heartbeat", 0);
            }
        }
        wait(5);
    }
    return result;
}

bool item_builder_validate_optional_int_range(const string&in field_name, const string&in value, int min_value, int max_value) {
    if(item_builder_is_blank(value)) return true;
    if(!item_builder_is_valid_number_string(value, false)) {
        item_builder_speak_invalid_field(field_name);
        return false;
    }
    int parsed = parse_int(value.trim_whitespace());
    if(parsed < min_value || parsed > max_value) {
        item_builder_speak_invalid_field(field_name);
        return false;
    }
    return true;
}

bool item_builder_validate_optional_float_range(const string&in field_name, const string&in value, double min_value, double max_value) {
    if(item_builder_is_blank(value)) return true;
    if(!item_builder_is_valid_number_string(value, true)) {
        item_builder_speak_invalid_field(field_name);
        return false;
    }
    double parsed = parse_float(value.trim_whitespace());
    if(parsed < min_value || parsed > max_value) {
        item_builder_speak_invalid_field(field_name);
        return false;
    }
    return true;
}

string[] item_builder_get_type_choices(bool include_keep_current = false) {
    string[] choices;
    if(include_keep_current) choices.insert_last(pu.get_value("Manter atual"));
    if(item_builder_meta_loaded && item_builder_types_csv != "") {
        string[] from_db;
        item_builder_fill_list_from_csv(item_builder_types_csv, from_db);
        for(uint i = 0; i < from_db.length(); i++) choices.insert_last(from_db[i]);
    } else {
        choices.insert_last("weapon");
        choices.insert_last("armor");
        choices.insert_last("consumable");
        choices.insert_last("misc");
    }
    if(choices.length() == uint(include_keep_current ? 1 : 0)) {
        choices.insert_last("weapon");
        choices.insert_last("armor");
        choices.insert_last("consumable");
        choices.insert_last("misc");
    }
    return choices;
}

string[] item_builder_get_rarity_choices(bool include_keep_current = false) {
    string[] choices;
    if(include_keep_current) choices.insert_last(pu.get_value("Manter atual"));
    if(item_builder_meta_loaded && item_builder_rarities_csv != "") {
        string[] from_db;
        item_builder_fill_list_from_csv(item_builder_rarities_csv, from_db);
        for(uint i = 0; i < from_db.length(); i++) choices.insert_last(from_db[i]);
    } else {
        choices.insert_last("common");
        choices.insert_last("uncommon");
        choices.insert_last("rare");
        choices.insert_last("epic");
        choices.insert_last("legendary");
    }
    if(choices.length() == uint(include_keep_current ? 1 : 0)) {
        choices.insert_last("common");
    }
    return choices;
}

string[] item_builder_get_category_choices(const string&in item_type, bool include_keep_current = false) {
    string[] choices;
    if(include_keep_current) choices.insert_last(pu.get_value("Manter atual"));

    string categories_csv = "";
    if(item_builder_meta_loaded) {
        if(item_type == "weapon") categories_csv = item_builder_categories_weapon_csv;
        else if(item_type == "armor") categories_csv = item_builder_categories_armor_csv;
        else if(item_type == "consumable") categories_csv = item_builder_categories_consumable_csv;
        else if(item_type == "misc") categories_csv = item_builder_categories_misc_csv;
    }

    if(categories_csv != "") {
        string[] from_db;
        item_builder_fill_list_from_csv(categories_csv, from_db);
        for(uint i = 0; i < from_db.length(); i++) choices.insert_last(from_db[i]);
    } else if(item_type == "weapon") {
        choices.insert_last("sword");
        choices.insert_last("dagger");
        choices.insert_last("axe");
        choices.insert_last("hammer");
        choices.insert_last("firearm");
    } else if(item_type == "armor") {
        choices.insert_last("head");
        choices.insert_last("chest");
        choices.insert_last("legs");
        choices.insert_last("boots");
        choices.insert_last("gloves");
    } else if(item_type == "consumable") {
        choices.insert_last("potion");
        choices.insert_last("food");
        choices.insert_last("drink");
    } else if(item_type == "misc") {
        choices.insert_last("material");
        choices.insert_last("quest");
        choices.insert_last("currency");
        choices.insert_last("junk");
    } else {
        choices.insert_last("legacy");
        choices.insert_last("material");
        choices.insert_last("potion");
        choices.insert_last("firearm");
        choices.insert_last("chest");
    }
    if(choices.length() == uint(include_keep_current ? 1 : 0)) choices.insert_last("legacy");
    return choices;
}

bool item_builder_parse_server_item_line(const string&in line, string&out item_id, string&out visual_label) {
    item_id = "";
    visual_label = "";
    if(line == "" || line.find("[") != 0) return false;

    int type_end = line.find("]");
    int dash_pos = line.find(" - ");
    if(type_end < 0 || dash_pos < 0 || dash_pos <= type_end + 2) return false;

    string item_type = line.substr(1, type_end - 1).trim_whitespace();
    item_id = line.substr(type_end + 2, dash_pos - (type_end + 2)).trim_whitespace();
    if(item_id == "") return false;

    string detail = line.substr(dash_pos + 3).trim_whitespace();
    visual_label = "%0, %1".format(item_id, item_type);
    if(detail != "") visual_label = "%0, %1".format(visual_label, detail);
    return true;
}

int item_builder_count_items_in_payload(const string&in payload) {
    string clean = payload.replace("\r", "");
    string[] lines = clean.split("\n");
    int count = 0;
    for(uint i = 0; i < lines.length(); i++) {
        string item_id = "";
        string visual_label = "";
        if(item_builder_parse_server_item_line(lines[i], item_id, visual_label)) count++;
    }
    return count;
}

// ============================================================================
// CRIADOR DE ARMA DE FOGO (formato weapons.db)
// Campos baseados no weapons.bgt original
// ============================================================================
void item_builder_weapon_gun() {
    // PARTE 1: Dados Básicos
    input_form form1(pu.get_value("Criar Arma de Fogo - Parte 1: Básico"));
    
    // ID interno (ex: ak47, glock17)
    form1.add_text_field("name", pu.get_value("ID interno (sem espaços, ex: ak47)"), "", true);
    
    // Tipo de munição (ex: 9mm, 7.62mm, .50ae)
    form1.add_text_field("ammo", pu.get_value("Tipo de munição (ex: 9mm, 7.62mm, none para melee)"), "9mm", true);
    
    // Dano e distância
    form1.add_number_field("damage", pu.get_value("Dano base"), 50, true);
    form1.add_number_field("distance", pu.get_value("Alcance (distância)"), 500, true);
    
    // Munição
    form1.add_number_field("ammo_total", pu.get_value("Munição total reserva"), 150, true);
    form1.add_number_field("ammo_cantity", pu.get_value("Munição no pente"), 30, true);
    
    dictionary@ r1 = item_builder_run_form_with_network(@form1);
    if(form1.user_canceled) return;
    
    string name, ammo;
    double damage, distance, ammo_total, ammo_cantity;
    r1.get("name", name);
    r1.get("ammo", ammo);
    r1.get("damage", damage);
    r1.get("distance", distance);
    r1.get("ammo_total", ammo_total);
    r1.get("ammo_cantity", ammo_cantity);

    if(!item_builder_validate_required_field("id", name)) return;
    if(!item_builder_validate_required_field("ammo", ammo)) return;
    if(!item_builder_is_valid_identifier(name)) {
        speak(pu.get_value("Dados invalidos: ID interno invalido."), true);
        return;
    }
    
    // PARTE 2: Velocidades e Modos
    input_form form2(pu.get_value("Criar Arma de Fogo - Parte 2: Velocidades"));
    
    form2.add_number_field("speed", pu.get_value("Velocidade de tiro (ms entre tiros)"), 500, true);
    form2.add_number_field("speed_burst", pu.get_value("Velocidade rajada (0 se não tem)"), 0, true);
    form2.add_number_field("speed_loading", pu.get_value("Tempo de recarga (ms)"), 2000, true);
    form2.add_number_field("require_ammo", pu.get_value("Requer munição? (1=sim, 0=não)"), 1, true);
    form2.add_number_field("enable_burst", pu.get_value("Tem modo rajada? (1=sim, 0=não)"), 0, true);
    form2.add_number_field("is_dropable", pu.get_value("Dropável? (1=sim, 0=não)"), 0, true);
    form2.add_number_field("ammo_cantity_descount", pu.get_value("Munição gasta por tiro"), 1, true);
    form2.add_number_field("degradation", pu.get_value("Degradação (desgaste por tiro)"), 1, true);
    
    dictionary@ r2 = item_builder_run_form_with_network(@form2);
    if(form2.user_canceled) return;
    
    double speed, speed_burst, speed_loading, require_ammo, enable_burst, is_dropable, ammo_descount, degradation;
    r2.get("speed", speed);
    r2.get("speed_burst", speed_burst);
    r2.get("speed_loading", speed_loading);
    r2.get("require_ammo", require_ammo);
    r2.get("enable_burst", enable_burst);
    r2.get("is_dropable", is_dropable);
    r2.get("ammo_cantity_descount", ammo_descount);
    r2.get("degradation", degradation);
    
    // PARTE 3: Sons
    input_form form3(pu.get_value("Criar Arma de Fogo - Parte 3: Sons"));
    
    form3.add_text_field("sound_shoot", pu.get_value("Som de tiro (ex: ak47)"), name, true);
    form3.add_text_field("sound_shoot_dist", pu.get_value("Som de tiro distante"), name + "dist", true);
    form3.add_text_field("sound_impact", pu.get_value("Sons de impacto (separados por vírgula)"), "rico1,rico2,rico3,rico4", true);
    form3.add_text_field("sound_impact_corpse", pu.get_value("Sons de impacto em corpo"), "body1,body2,body3,body4", true);
    form3.add_text_field("sound_draw", pu.get_value("Som de sacar arma"), name + "draw", true);
    form3.add_text_field("sound_reload", pu.get_value("Som de recarregar"), name + "reload", true);
    form3.add_text_field("sound_empty", pu.get_value("Som sem munição"), name + "empty", true);
    form3.add_text_field("sound_unload", pu.get_value("Som descarregar"), "0", false);
    form3.add_text_field("sound_mode1", pu.get_value("Som modo automático"), "0", false);
    form3.add_text_field("sound_mode2", pu.get_value("Som modo semi"), "0", false);
    
    dictionary@ r3 = item_builder_run_form_with_network(@form3);
    if(form3.user_canceled) return;
    
    string sound_shoot, sound_shoot_dist, sound_impact, sound_impact_corpse;
    string sound_draw, sound_reload, sound_empty, sound_unload, sound_mode1, sound_mode2;
    r3.get("sound_shoot", sound_shoot);
    r3.get("sound_shoot_dist", sound_shoot_dist);
    r3.get("sound_impact", sound_impact);
    r3.get("sound_impact_corpse", sound_impact_corpse);
    r3.get("sound_draw", sound_draw);
    r3.get("sound_reload", sound_reload);
    r3.get("sound_empty", sound_empty);
    r3.get("sound_unload", sound_unload);
    r3.get("sound_mode1", sound_mode1);
    r3.get("sound_mode2", sound_mode2);
    
    // Montar pacote no formato weapons.db
    // Formato: name=ammo=sound_shoot=sound_impact=sound_draw=sound_reload=damage=distance=ammo_total=ammo_cantity=speed=speed_burst=speed_loading=require_ammo=enable_burst=is_dropable=sound_impact_on_corpse=sound_unload=sound_mode1=sound_mode2=ammo_cantity_descount=sound_shoot_dist=degradation_point
    string weapon_data = name + "=" + ammo + "=" + sound_shoot + "=" + sound_impact + "=" + 
                         sound_draw + "=" + sound_reload + "=" + int(damage) + "=" + int(distance) + "=" + 
                         int(ammo_total) + "=" + int(ammo_cantity) + "=" + int(speed) + "=" + int(speed_burst) + "=" + 
                         int(speed_loading) + "=" + int(require_ammo) + "=" + int(enable_burst) + "=" + int(is_dropable) + "=" + 
                         sound_impact_corpse + "=" + sound_unload + "=" + sound_mode1 + "=" + sound_mode2 + "=" + 
                         int(ammo_descount) + "=" + sound_shoot_dist + "=" + degradation;
    
    // Enviar ao servidor
    string packet = "/create_weapon_tool " + weapon_data;
    send_to_server(packet, 0, true);

    string action_feedback = "";
    if(item_builder_wait_action_response(action_feedback)) {
        speak(action_feedback, true);
        add_add_item("avisos", action_feedback);
    }
}

// ============================================================================
// CRIADOR DE ARMA CORPO A CORPO
// ============================================================================
void item_builder_weapon_melee() {
    string name = "";
    string display = "";
    string desc = "Uma arma corpo a corpo.";
    string category = "sword";
    string rarity = "common";
    string sound_file = "sword_swing.wav";
    double damage = 30;
    double distance = 50;
    double weight = 2;
    double value = 100;

    while(true) {
        input_form form(pu.get_value("Criar Arma Corpo a Corpo"));
        form.add_text_field("name", pu.get_value("ID interno (ex: faca, espada)"), name, true);
        form.add_text_field("display", pu.get_value("Nome visível (ex: Espada de Ferro)"), display, true);
        form.add_text_field("desc", pu.get_value("Descrição"), desc, true);
        form.add_choice_field("category", pu.get_value("Categoria"), item_builder_get_category_choices("weapon"), true);
        form.add_number_field("damage", pu.get_value("Dano"), damage, true);
        form.add_number_field("distance", pu.get_value("Alcance (50=curto, 100=médio)"), distance, true);
        form.add_number_field("weight", pu.get_value("Peso (kg)"), weight, true);
        form.add_number_field("value", pu.get_value("Preço (gold)"), value, true);
        form.add_choice_field("rarity", pu.get_value("Raridade"), item_builder_get_rarity_choices(), true);
        form.add_text_field("sound_file", pu.get_value("Som de ataque (ex: sword_swing)"), sound_file, true);
        
        dictionary@ result = item_builder_run_form_with_network(@form);
        if(form.user_canceled) return;
        
        result.get("name", name);
        result.get("display", display);
        result.get("desc", desc);
        result.get("category", category);
        result.get("damage", damage);
        result.get("distance", distance);
        result.get("weight", weight);
        result.get("value", value);
        result.get("rarity", rarity);
        result.get("sound_file", sound_file);

        name = name.trim_whitespace();
        display = display.trim_whitespace();
        desc = desc.trim_whitespace();
        category = category.trim_whitespace();
        rarity = rarity.trim_whitespace();
        sound_file = sound_file.trim_whitespace();

        if(!item_builder_validate_required_field("id", name)) continue;
        if(!item_builder_validate_required_field("nome", display)) continue;
        if(!item_builder_validate_required_field("descricao", desc)) continue;
        if(!item_builder_validate_required_field("categoria", category)) continue;
        if(!item_builder_validate_required_field("raridade", rarity)) continue;
        if(!item_builder_is_valid_identifier(name)) { item_builder_speak_invalid_field("id"); continue; }
        if(!item_builder_validate_max_length("id", name, 64)) continue;
        if(!item_builder_validate_max_length("nome", display, 60)) continue;
        if(!item_builder_validate_max_length("descricao", desc, 240)) continue;
        if(!item_builder_validate_max_length("categoria", category, 32)) continue;
        if(!item_builder_validate_max_length("raridade", rarity, 24)) continue;
        if(!item_builder_validate_max_length("sound_file", sound_file, 120)) continue;
        if(damage < 0 || damage > 100000) { item_builder_speak_invalid_field("damage"); continue; }
        if(distance < 1 || distance > 100000) { item_builder_speak_invalid_field("distance"); continue; }
        if(weight <= 0 || weight > 10000) { item_builder_speak_invalid_field("weight"); continue; }
        if(value < 0 || value > 100000000) { item_builder_speak_invalid_field("value"); continue; }
        if(!item_builder_confirm_send(display)) continue;
        
        string packet = "/create_item_tool weapon|" + name + "|" + display + "|" + desc + "|" + category + "|" + 
                        int(damage) + "|0|0|0|" + weight + "|" + int(value) + "|" + rarity + "|" + sound_file + "|" + int(distance);
        
        send_to_server(packet, 0, true);
        string action_feedback = "";
        if(item_builder_wait_action_response(action_feedback)) {
            speak(action_feedback, true);
            add_add_item("avisos", action_feedback);
        }
        return;
    }
}

void item_builder_fill_list_from_csv(string csv, string[]&out target) {
    target.resize(0);
    string[] parts = csv.split(",");
    for(uint i = 0; i < parts.length(); i++) {
        string v = parts[i].trim_whitespace();
        if(v != "") target.insert_last(v);
    }
}

void item_builder_request_meta() {
    item_builder_meta_request_pending = true;
    item_builder_meta_response_ready = false;
    item_builder_meta_response_payload = "";
    send_to_server("/item_builder_meta", 0, true);

    timer wait_meta_timer;
    wait_meta_timer.restart();
    while(item_builder_meta_request_pending && wait_meta_timer.elapsed < 7000) {
        netloop();
        wait(5);
    }
    if(item_builder_meta_request_pending || !item_builder_meta_response_ready) {
        item_builder_meta_request_pending = false;
        return;
    }

    string payload = item_builder_meta_response_payload;
    item_builder_meta_response_ready = false;
    if(payload.find("ITEM_BUILDER_META|") != 0) return;

    string[] parts = payload.split("|");
    if(parts.length() < 7) return;

    item_builder_types_csv = parts[1].trim_whitespace();
    item_builder_rarities_csv = parts[2].trim_whitespace();
    item_builder_categories_weapon_csv = parts[3].trim_whitespace();
    item_builder_categories_armor_csv = parts[4].trim_whitespace();
    item_builder_categories_consumable_csv = parts[5].trim_whitespace();
    item_builder_categories_misc_csv = parts[6].trim_whitespace();
    item_builder_meta_loaded = true;
}

// ============================================================================
// CRIADOR DE ARMADURA
// ============================================================================
void item_builder_armor() {
    string name = "";
    string display = "";
    string desc = "Uma armadura protetora.";
    string category = "chest";
    string rarity = "common";
    double defense = 20;
    double weight = 5;
    double value = 200;

    while(true) {
        input_form form(pu.get_value("Criar Armadura"));
        form.add_text_field("name", pu.get_value("ID interno (ex: iron_armor)"), name, true);
        form.add_text_field("display", pu.get_value("Nome visível (ex: Armadura de Ferro)"), display, true);
        form.add_text_field("desc", pu.get_value("Descrição"), desc, true);
        form.add_choice_field("category", pu.get_value("Parte do corpo"), item_builder_get_category_choices("armor"), true);
        form.add_number_field("defense", pu.get_value("Defesa"), defense, true);
        form.add_number_field("weight", pu.get_value("Peso (kg)"), weight, true);
        form.add_number_field("value", pu.get_value("Preço (gold)"), value, true);
        form.add_choice_field("rarity", pu.get_value("Raridade"), item_builder_get_rarity_choices(), true);
        
        dictionary@ result = item_builder_run_form_with_network(@form);
        if(form.user_canceled) return;
        
        result.get("name", name);
        result.get("display", display);
        result.get("desc", desc);
        result.get("category", category);
        result.get("defense", defense);
        result.get("weight", weight);
        result.get("value", value);
        result.get("rarity", rarity);

        name = name.trim_whitespace();
        display = display.trim_whitespace();
        desc = desc.trim_whitespace();
        category = category.trim_whitespace();
        rarity = rarity.trim_whitespace();

        if(!item_builder_validate_required_field("id", name)) continue;
        if(!item_builder_validate_required_field("nome", display)) continue;
        if(!item_builder_validate_required_field("descricao", desc)) continue;
        if(!item_builder_validate_required_field("categoria", category)) continue;
        if(!item_builder_validate_required_field("raridade", rarity)) continue;
        if(!item_builder_is_valid_identifier(name)) { item_builder_speak_invalid_field("id"); continue; }
        if(!item_builder_validate_max_length("id", name, 64)) continue;
        if(!item_builder_validate_max_length("nome", display, 60)) continue;
        if(!item_builder_validate_max_length("descricao", desc, 240)) continue;
        if(!item_builder_validate_max_length("categoria", category, 32)) continue;
        if(!item_builder_validate_max_length("raridade", rarity, 24)) continue;
        if(defense < 0 || defense > 100000) { item_builder_speak_invalid_field("defense"); continue; }
        if(weight <= 0 || weight > 10000) { item_builder_speak_invalid_field("weight"); continue; }
        if(value < 0 || value > 100000000) { item_builder_speak_invalid_field("value"); continue; }
        if(!item_builder_confirm_send(display)) continue;
        
        string packet = "/create_item_tool armor|" + name + "|" + display + "|" + desc + "|" + category + "|" + 
                        "0|" + int(defense) + "|0|0|" + weight + "|" + int(value) + "|" + rarity + "|";
        
        send_to_server(packet, 0, true);
        string action_feedback = "";
        if(item_builder_wait_action_response(action_feedback)) {
            speak(action_feedback, true);
            add_add_item("avisos", action_feedback);
        }
        return;
    }
}

