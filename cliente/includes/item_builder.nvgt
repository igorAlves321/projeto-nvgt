// ============================================================================
// LISTAR ITENS EXISTENTES (solicita ao servidor)
// ============================================================================
void item_builder_list_items() {
    debug_log("ITEM_BUILDER: solicitando /list_items ao servidor");
    item_list_request_pending = true;
    item_list_response_ready = false;
    item_list_response_payload = "";
    send_to_server("/list_items", 0, true);
    speak(pu.get_value("Solicitando lista de itens ao servidor..."));

    timer wait_list_timer;
    wait_list_timer.restart();

    while(item_list_request_pending && wait_list_timer.elapsed < 7000) {
        netloop();
        wait(5);
    }

    if(item_list_request_pending) {
        item_list_request_pending = false;
        speak(pu.get_value("Tempo de resposta esgotado ao listar itens."));
        return;
    }

    if(item_list_response_ready) {
        item_list_response_ready = false;
        int item_count = item_builder_count_items_in_payload(item_list_response_payload);
        if(item_count > 0) {
            show_items_list_menu(item_list_response_payload);
            return;
        }

        if(item_list_response_payload.find("Nenhum item cadastrado") >= 0 || item_list_response_payload.find("(Nenhum item cadastrado)") >= 0) {
            speak(pu.get_value("Nenhum item cadastrado."));
            add_add_item("avisos", pu.get_value("Nenhum item cadastrado."));
            return;
        }

        if(item_list_response_payload != "") {
            speak(item_list_response_payload, true);
            add_add_item("avisos", item_list_response_payload);
            return;
        }
    }
}

bool item_builder_wait_list_response(string&out payload) {
    item_list_request_pending = true;
    item_list_response_ready = false;
    item_list_response_payload = "";

    send_to_server("/list_items", 0, true);
    speak(pu.get_value("Solicitando lista de itens ao servidor..."));

    timer wait_list_timer;
    wait_list_timer.restart();

    while(item_list_request_pending && wait_list_timer.elapsed < 7000) {
        netloop();
        wait(5);
    }

    if(item_list_request_pending) {
        item_list_request_pending = false;
        speak(pu.get_value("Tempo de resposta esgotado ao listar itens."));
        return false;
    }

    if(!item_list_response_ready || item_list_response_payload == "") {
        return false;
    }

    payload = item_list_response_payload;
    item_list_response_ready = false;
    return true;
}

bool item_builder_wait_action_response(string&out payload) {
    item_builder_action_request_pending = true;
    item_builder_action_response_ready = false;
    item_builder_action_response_payload = "";

    timer wait_action_timer;
    wait_action_timer.restart();

    while(item_builder_action_request_pending && wait_action_timer.elapsed < 7000) {
        netloop();
        wait(5);
    }

    if(item_builder_action_request_pending) {
        item_builder_action_request_pending = false;
        speak(pu.get_value("Tempo de resposta esgotado para a operação."));
        return false;
    }

    if(!item_builder_action_response_ready || item_builder_action_response_payload == "") {
        speak(pu.get_value("Nao foi possivel confirmar a operacao."), true);
        return false;
    }

    payload = item_builder_action_response_payload;
    item_builder_action_response_ready = false;
    return true;
}

bool item_builder_pick_item_id(string&out picked_id, string&out picked_label) {
    string payload = "";
    if(!item_builder_wait_list_response(payload)) {
        return false;
    }

    int payload_item_count = item_builder_count_items_in_payload(payload);
    if(payload_item_count <= 0) {
        if(payload.find("Nenhum item cadastrado") >= 0 || payload.find("(Nenhum item cadastrado)") >= 0) {
            speak(pu.get_value("Nenhum item cadastrado."));
        } else if(payload != "") {
            speak(payload, true);
            add_add_item("avisos", payload);
        }
        return false;
    }

    string clean = payload.replace("\r", "");
    string[] lines = clean.split("\n");

    audio_form pick_form;
    pick_form.create_window(pu.get_value("Selecionar Item"), true, false);
    int list_id = pick_form.create_list(pu.get_value("Itens"), 0, false, false);
    int ok_btn = pick_form.create_button("&ok", true);
    int cancel_btn = pick_form.create_button("&cancelar", false, true);
    pick_form.focus(list_id);

    int count = 0;
    for(uint i = 0; i < lines.length(); i++) {
        string line = lines[i];
        string item_id = "";
        string visual_label = "";
        if(!item_builder_parse_server_item_line(line, item_id, visual_label)) continue;
        if(!pick_form.add_list_item(list_id, visual_label, item_id)) continue;
        count++;
    }

    if(count <= 0) {
        speak(pu.get_value("Nenhum item cadastrado."));
        return false;
    }

    speak(pu.get_value("Selecione um item."), true);
    while(true) {
        pick_form.monitor();
        if(is_connected) {
            netloop();
            if(heartbeat_timer.elapsed >= HEARTBEAT_INTERVAL) {
                heartbeat_timer.restart();
                send_unreliable(peer_id, "heartbeat", 0);
            }
        }
        if(pick_form.is_pressed(cancel_btn)) return false;
        if(pick_form.is_pressed(ok_btn)) {
            int pos = pick_form.get_list_position(list_id);
            if(pos < 0) {
                speak(pu.get_value("Nenhum item selecionado."), true);
                continue;
            }
            picked_id = pick_form.get_list_item_id(list_id, pos);
            picked_label = pick_form.get_list_item(list_id, pos);
            return picked_id != "";
        }
        wait(5);
    }

    return false;
}


// ============================================================================
// EDITAR ITEM EXISTENTE
// Formato: name|display|desc|type|category|damage|defense|heal|mp|weight|value|rarity|sound|max_stack|drop_rate
// ============================================================================
void item_builder_edit_item() {
    string selected_id = "";
    string selected_label = "";
    if(!item_builder_pick_item_id(selected_id, selected_label)) {
        return;
    }

    string name = selected_id;
    string display = "";
    string desc = "";
    string type = "";
    string category = "";
    string damage = "";
    string defense = "";
    string heal = "";
    string mp = "";
    string weight = "";
    string value = "";
    string rarity = "";
    string sound_file = "";
    string max_stack = "";
    string drop_rate = "";

    while(true) {
        input_form form(pu.get_value("Editar Item Existente"));
        form.description = pu.get_value("Editando item: ") + selected_id + ". " + pu.get_value("Deixe vazio para manter valor atual.");

        form.add_text_field("display", pu.get_value("Nome visivel (opcional)"), display, false);
        form.add_text_field("desc", pu.get_value("Descricao (opcional)"), desc, false);
        form.add_choice_field("type", pu.get_value("Tipo"), item_builder_get_type_choices(true), false);
        form.add_choice_field("category", pu.get_value("Categoria"), item_builder_get_category_choices("all", true), false);
        form.add_text_field("damage", pu.get_value("Dano (opcional)"), damage, false);
        form.add_text_field("defense", pu.get_value("Defesa (opcional)"), defense, false);
        form.add_text_field("heal", pu.get_value("Cura HP (opcional)"), heal, false);
        form.add_text_field("mp", pu.get_value("Restaura MP (opcional)"), mp, false);
        form.add_text_field("weight", pu.get_value("Peso (opcional)"), weight, false);
        form.add_text_field("value", pu.get_value("Valor (opcional)"), value, false);
        form.add_choice_field("rarity", pu.get_value("Raridade"), item_builder_get_rarity_choices(true), false);
        form.add_text_field("sound", pu.get_value("Som (opcional)"), sound_file, false);
        form.add_text_field("max_stack", pu.get_value("Maximo empilhavel (opcional)"), max_stack, false);
        form.add_text_field("drop_rate", pu.get_value("Taxa de drop (opcional: 0.0 a 1.0)"), drop_rate, false);
        
        dictionary@ result = item_builder_run_form_with_network(@form);
        if(form.user_canceled) return;
        
        name = selected_id;
        result.get("display", display);
        result.get("desc", desc);
        result.get("type", type);
        result.get("category", category);
        result.get("damage", damage);
        result.get("defense", defense);
        result.get("heal", heal);
        result.get("mp", mp);
        result.get("weight", weight);
        result.get("value", value);
        result.get("rarity", rarity);
        result.get("sound", sound_file);
        result.get("max_stack", max_stack);
        result.get("drop_rate", drop_rate);

        display = display.trim_whitespace();
        desc = desc.trim_whitespace();
        type = type.trim_whitespace();
        category = category.trim_whitespace();
        rarity = rarity.trim_whitespace();
        sound_file = sound_file.trim_whitespace();

        if(type == pu.get_value("Manter atual")) type = "";
        if(category == pu.get_value("Manter atual")) category = "";
        if(rarity == pu.get_value("Manter atual")) rarity = "";

        if(!item_builder_is_blank(type) && type != "weapon" && type != "armor" && type != "consumable" && type != "misc") {
            item_builder_speak_invalid_field("type");
            continue;
        }
        if(!item_builder_validate_max_length("nome", display, 60)) continue;
        if(!item_builder_validate_max_length("descricao", desc, 240)) continue;
        if(!item_builder_validate_max_length("tipo", type, 16)) continue;
        if(!item_builder_validate_max_length("categoria", category, 32)) continue;
        if(!item_builder_validate_max_length("raridade", rarity, 24)) continue;
        if(!item_builder_validate_max_length("sound", sound_file, 120)) continue;
        if(!item_builder_validate_optional_int_range("damage", damage, 0, 100000)) continue;
        if(!item_builder_validate_optional_int_range("defense", defense, 0, 100000)) continue;
        if(!item_builder_validate_optional_int_range("heal", heal, 0, 100000)) continue;
        if(!item_builder_validate_optional_int_range("mp", mp, 0, 100000)) continue;
        if(!item_builder_validate_optional_int_range("value", value, 0, 100000000)) continue;
        if(!item_builder_validate_optional_int_range("max_stack", max_stack, 1, 10000)) continue;
        if(!item_builder_validate_optional_float_range("weight", weight, 0.01, 10000.0)) continue;
        if(!item_builder_validate_optional_float_range("drop_rate", drop_rate, 0.0, 1.0)) continue;
        if(!item_builder_confirm_send(item_builder_is_blank(display) ? selected_id : display)) continue;
        
        string data = name + "|" + display + "|" + desc + "|" + type + "|" + category + "|" +
                      damage + "|" + defense + "|" + heal + "|" + mp + "|" +
                      weight + "|" + value + "|" + rarity + "|" + sound_file + "|" +
                      max_stack + "|" + drop_rate;
        
        send_to_server("/edit_item_tool " + data, 0, true);
        string action_feedback = "";
        if(item_builder_wait_action_response(action_feedback)) {
            speak(action_feedback, true);
            add_add_item("avisos", action_feedback);
        }
        return;
    }
}

// ============================================================================
// EXCLUIR ITEM EXISTENTE
// ============================================================================
void item_builder_delete_item() {
    string selected_id = "";
    string selected_label = "";
    if(!item_builder_pick_item_id(selected_id, selected_label)) {
        return;
    }

    setupmenu();
    game_menu.add_item(pu.get_value("Não"), "no");
    game_menu.add_item(pu.get_value("Sim"), "yes");
    game_menu.intro_text = pu.get_value("Confirmar exclusão de: ") + selected_label;
    int confirm = game_menu.run();
    if(confirm < 0) return;
    if(game_menu.get_item_id(confirm) != "yes") return;

    send_to_server("/delete_item_tool " + selected_id, 0, true);
    string action_feedback = "";
    if(item_builder_wait_action_response(action_feedback)) {
        speak(action_feedback, true);
        add_add_item("avisos", action_feedback);
    }
}

// NOTA: A função send_to_server() é definida em buildermenu.nvgt


