// Sistema de rede modernizado para NVGT

// ============================================================================
// FLAG DE DEBUG - Descomente para ativar speaks de debug
// ============================================================================
// IMPORTANTE: Manter false em produção para evitar "speak" de pacotes de rede
const bool NET_DEBUG_SPEAKS = false;

// ============================================================================
// CANAIS DE REDE (ENet Channels)
// ============================================================================
// Cada canal pode ter suas próprias configurações de confiabilidade
enum NetChannel {
    CH_DEFAULT = 0,     // Canal padrão para mensagens gerais
    CH_CHAT = 1,        // Canal de chat (confiável)
    CH_MOVE = 2,        // Canal de movimento (pode perder pacotes)
    CH_SYSTEM = 3,      // Canal de sistema (login, logout, etc)
    CH_ACTION = 4,      // Canal de ações (ataques, uso de itens)
    CH_AUDIO = 5,       // Canal de áudio (sincronização de sons)
    CH_ADMIN = 6,       // Canal administrativo
    CH_SYNC = 7         // Canal de sincronização de estado
}

const int NET_CHANNEL_COUNT = 8;

// ============================================================================
// CONFIGURAÇÕES DE REDE
// ============================================================================
const network_event@ event;
bool encryption = true;
double idversion = 1.0;
int connecttime = 10000;
timer connecttimer;

// Chave de criptografia para pacotes (DEVE SER IGUAL AO SERVIDOR)
const string PACKET_ENCRYPTION_KEY = "evm_server_key_2024";

// Funções de criptografia/descriptografia de pacotes
string encrypt_packet(string message) {
    return string_aes_encrypt(message, PACKET_ENCRYPTION_KEY);
}

string decrypt_packet(string message) {
    return string_aes_decrypt(message, PACKET_ENCRYPTION_KEY);
}

void log_client_network_exception(const string& in context, uint64 peer_id, const string& in packet_message) {
    datetime dt;
    string log_ts = dt.format("%Y-%m-%d %H:%M:%S");
    string log_file = "debug/erros_client.log";
    string safe_packet = packet_message;
    if(safe_packet.length() > MAX_NETWORK_LOG_PACKET_CHARS) {
        safe_packet = safe_packet.substr(0, MAX_NETWORK_LOG_PACKET_CHARS) + "... [TRUNCADO]";
    }

    string log_text = "[network_exception]\n";
    log_text += "timestamp=" + log_ts + "\n";
    log_text += "role=client\n";
    log_text += "context=" + context + "\n";
    log_text += "peer_id=" + peer_id + "\n";
    log_text += "packet=" + safe_packet + "\n";
    log_text += "exception_file=" + get_exception_file() + "\n";
    log_text += "exception_line=" + get_exception_line() + "\n";
    log_text += "exception_info=" + get_exception_info() + "\n";
    log_text += "call_stack_begin\n";
    log_text += last_exception_call_stack + "\n";
    log_text += "call_stack_end\n";
    log_text += "[/network_exception]\n\n";

    directory_create("debug");
    file f;
    if(f.open(log_file, "a")) {
        f.write(log_text);
        f.close();
    }

    debug_log("ERRO DE REDE NO CLIENTE (" + context + "). Detalhes em " + log_file);
}

void net_create() {
	string username;
	string password;
	string email;
	if(!collect_account_creation_data(username, password, email)) {
		account_creating = false;
		menuprincipal();
		return;
	}

	menusilent();
	game_menu.add_item(pu.get_value("Mulher"), "0");
	game_menu.add_item(pu.get_value("Homem"), "1");
	game_menu.intro_text = pu.get_value("Você é homem ou mulher?");
	int selection = game_menu.run();
	if(selection == -1) {
		account_creating = false;
		menuprincipal();
		return;
	}

	string selected_gender = game_menu.get_item_id(selection);
	gender = selected_gender;

	speak(pu.get_value("Conectando..."));

	// Usar conexão global ao invés de criar local
	@event = null;
	con.setup_client(20, 100); // Deve coincidir com max_channels do servidor (20 canais como no BGT original)
	uint64 server_peer = con.connect(game_serveraddress, game_serverport);
	
	if(server_peer == 0) {
		dlg(pu.get_value("Erro ao conectar ao servidor"));
		account_creating = false;
		menuprincipal();
		return;
	}
	
	peer_id = server_peer; // Armazenar peer_id global
	is_connected = true;   // Marcar como conectado
	connecttimer.restart();

	while(true) {
		wait(5);

		if(key_pressed(KEY_ESCAPE)) {
			con.destroy();
			is_connected = false;
			account_creating = false;
			menuprincipal();
			return;
		}

		@event = con.request();
		if(event is null) {
			if(connecttimer.elapsed >= connecttime) {
				dlg(pu.get_value("Servidor indisponível"));
				con.destroy();
				is_connected = false;
				account_creating = false;
				menuprincipal();
				return;
			}
			continue;
		}

		if(event.type == event_connect) {
			uint64 connected_peer = event.peer_id;
			// Segurança: Enviar hash SHA-256 da senha ao invés de texto plano
			string hashed_password = hash_password(password);
			string create_msg = "xt55 " + username + " " + hashed_password + " " + email + " " + selected_gender;
			con.send(connected_peer, encrypt_packet(create_msg), 0, true); // Criptografar antes de enviar
		}
		else if(event.type == event_receive) {
			try {
				if(event.message.length() > MAX_PACKET_ENCRYPTED_CHARS) {
					log_client_network_exception("net_create:event_receive:oversize", event.peer_id, event.message);
					con.destroy();
					is_connected = false;
					account_creating = false;
					menuprincipal();
					return;
				}
				string received_msg = decrypt_packet(event.message); // Descriptografar mensagem do servidor
				if(received_msg == "created") {
					account_creating = false;
					net_un = username;
					net_pw = password; // Armazenar senha original localmente (será criptografada por writeprefs)
					un = username;
					pw = password;
					writeprefs();
					// NÃO destruir conexão - manter ativa para login
					dlg(pu.get_value("Conta criada com sucesso! Pressione enter para logar-se."));
					net_logar();
					return;
				}
				else if(received_msg.find("Erro") != -1 || received_msg.lower().find("erro") != -1) {
					dlg(pu.get_value(received_msg));
					con.destroy();
					is_connected = false;
					account_creating = false;
					menuprincipal();
					return;
				}
			}
			catch {
				log_client_network_exception("net_create:event_receive", event.peer_id, event.message);
				con.destroy();
				is_connected = false;
				account_creating = false;
				menuprincipal();
				return;
			}
		}
		else if(event.type == event_disconnect) {
			dlg(pu.get_value("Servidor indisponível"));
			con.destroy();
			is_connected = false;
			account_creating = false;
			menuprincipal();
			return;
		}
	}
}

void net_logar(bool localhost = false) {
	// Validação: Verificar se há conta configurada
	if(net_un == "" || net_pw == "") {
		dlg(pu.get_value("Você não tem uma conta configurada. Por favor, crie uma conta primeiro ou configure suas credenciais."));
		menuprincipal();
		return;
	}
	
	// Salvar preferências antes de conectar
	writeprefs();

	speak(pu.get_value("Conectando ao servidor..."));
	string target_address = game_serveraddress;
	if(localhost) {
		target_address = "localhost";
	}

	debug_log("=== INICIANDO TENTATIVA DE CONEXÃO ===");
	debug_log("Endereço: " + target_address + " Porta: " + game_serverport);
	if(NET_DEBUG_SPEAKS) speak("DEBUG: Iniciando conexão para " + target_address + " porta " + game_serverport);
	is_connected = false; // Flag global
	@event = null;
	
	debug_log("Chamando setup_client(20, 150)");
	if(NET_DEBUG_SPEAKS) speak("DEBUG: Chamando setup_client com 20 canais e 150ms timeout");
	con.setup_client(20, 150); // 20 canais como no BGT original (0-19)
	
	debug_log("Chamando connect()");
	if(NET_DEBUG_SPEAKS) speak("DEBUG: Chamando connect para " + target_address + " porta " + game_serverport);
	uint64 server_peer = con.connect(target_address, game_serverport);
	
	if(server_peer == 0) {
		dlg(pu.get_value("Erro ao conectar ao servidor"));
		reset();
		menuprincipal();
		return;
	}
	
	peer_id = server_peer; // Armazenar peer_id global
	
	debug_log("Aguardando evento de conexão... timeout=" + connecttime + "ms");
	if(NET_DEBUG_SPEAKS) speak("DEBUG: Aguardando evento de conexão");
	connecttimer.restart();

	// Criar tela de conexão com audio_form para permitir cancelamento
	audio_form conectando_form;
	conectando_form.create_window(pu.get_value("Conectando ao servidor... Pressione ESC para cancelar."), false, true);
	
	while(true) {
		wait(5);
		conectando_form.monitor(); // Processa eventos da interface
		@event = con.request(); // Poll de eventos de rede (obrigatorio para receber connect/receive/disconnect)

		if(key_pressed(KEY_ESCAPE)) {
			debug_log("Usuário cancelou a conexão");
			if(NET_DEBUG_SPEAKS) speak("DEBUG: Usuário cancelou conexão");
			con.destroy();
			is_connected = false;
			reset();
			menuprincipal();
			return;
		}

		if(event is null) {
			if(!is_connected && connecttimer.elapsed >= connecttime) {
				debug_log("TIMEOUT após " + connecttimer.elapsed + "ms - Servidor não respondeu");
				if(NET_DEBUG_SPEAKS) speak("DEBUG: Timeout - " + connecttimer.elapsed + "ms sem resposta");
				dlg(pu.get_value("Servidor fora do ar, tente novamente mais tarde."));
				con.destroy();
				is_connected = false;
				reset();
				menuprincipal();
				return;
			}
			continue;
		}

		// Ignorar event_none (tipo 0 - sem eventos)
		if(event.type == event_none) {
			if(!is_connected && connecttimer.elapsed >= connecttime) {
				debug_log("TIMEOUT após " + connecttimer.elapsed + "ms - Servidor não respondeu");
				if(NET_DEBUG_SPEAKS) speak("DEBUG: Timeout - " + connecttimer.elapsed + "ms sem resposta");
				dlg(pu.get_value("Servidor fora do ar, tente novamente mais tarde."));
				con.destroy();
				is_connected = false;
				reset();
				menuprincipal();
				return;
			}
			continue; // Aguardar eventos reais
		}

		debug_log("Evento recebido: tipo=" + event.type + ", peer_id=" + event.peer_id);
		if(NET_DEBUG_SPEAKS) speak("DEBUG: Evento recebido - tipo=" + event.type + " peer=" + event.peer_id);

		if(event.type == event_disconnect || (!is_connected && connecttimer.elapsed >= connecttime)) {
			debug_log("Evento de desconexão ou timeout");
			if(NET_DEBUG_SPEAKS) speak("DEBUG: Desconectado ou timeout");
			dlg(pu.get_value("Servidor fora do ar, tente novamente mais tarde."));
			con.destroy();
			is_connected = false;
			reset();
			menuprincipal();
			return;
		}

		if(event.type == event_connect && !is_connected) {
			debug_log("âœ… EVENT_CONNECT recebido! peer_id=" + event.peer_id);
			if(NET_DEBUG_SPEAKS) speak("DEBUG: EVENT_CONNECT recebido! Enviando credenciais");
			net_peer_id = event.peer_id;
			server_peer_id = event.peer_id;
			peer_id = int(event.peer_id);  // Atualizar peer_id global (int) para compatibilidade BGT
			// Segurança: Enviar hash SHA-256 da senha ao invés de texto plano
			string hashed_password = hash_password(net_pw);
			string login_msg = "h33j " + net_un + " " + hashed_password + " " + gversion + " " + banned;
			debug_log("Enviando credenciais: " + net_un + " (hash omitido por segurança)");
			con.send(net_peer_id, encrypt_packet(login_msg), 0, true); // Criptografar antes de enviar
			debug_log("Credenciais enviadas, aguardando resposta do servidor");
			if(NET_DEBUG_SPEAKS) speak("DEBUG: Credenciais enviadas, aguardando resposta");
			continue;
		}

		if(event.type == event_receive) {
			try {
				if(event.message.length() > MAX_PACKET_ENCRYPTED_CHARS) {
					log_client_network_exception("net_logar:event_receive:oversize", event.peer_id, event.message);
					con.destroy();
					is_connected = false;
					reset();
					menuprincipal();
					return;
				}
				string full_msg = decrypt_packet(event.message); // Descriptografar mensagem do servidor
				debug_log("ðŸ“¨ Mensagem recebida do servidor: '" + full_msg + "'");
				string[] parsed = full_msg.split(" ");

				if(parsed.length() >= 2) {
					if(parsed[0] == "x") me.x = string_to_number(parsed[1]);
					if(parsed[0] == "y") me.y = string_to_number(parsed[1]);
				}

				// Processar comando changemap (recebido APÓS loggedin)
				if(parsed.length() >= 1) {
					if(parsed[0] == "changemap") {
						debug_log("ðŸ—ºï¸ CHANGEMAP recebido - carregando mapa completo");

						// Carregar mapa com dados completos (formato: "changemap [dados]\r\nx:X\r\ny:Y\r\n")
						load_map(full_msg);

						// Extrair coordenadas do mapa carregado
						string[] ldata = delinear(full_msg);
						for(uint i = 0; i < ldata.length(); i++) {
							string[] parts = ldata[i].split(":");
							if(parts[0] == "x" && parts.length() > 1) {
								me.x = string_to_number(parts[1]);
							}
							else if(parts[0] == "y" && parts.length() > 1) {
								me.y = string_to_number(parts[1]);
							}
							else if(parts[0] == "map" && parts.length() > 1) {
								mapname = parts[1];
							}
						}

						debug_log("âœ… Mapa carregado! " + mapname + " (" + me.x + "," + me.y + ")");
						speak("Você está no mapa: " + mapname + ". Use as setas para se mover.");

						// AGORA SIM entra no loop do jogo
						game();
						debug_log("game() retornou (desconexão ou saída)");
						return;
					}
				}
				
				// Processar loggedin (aguarda changemap para entrar no jogo)
				if(full_msg.find("loggedin") != -1) {
					debug_log("ðŸŽ‰ LOGGEDIN recebido! Aguardando changemap...");
					username = net_un;
					is_connected = true;
					
					// âœ… Resetar backoff ao conectar com sucesso
					reconnect_attempts = 0;
					reconnect_delay = MIN_RECONNECT_DELAY;
					waiting_to_reconnect = false;
					
					speak(pu.get_value("Logado com sucesso! Carregando mundo..."));
					// NÃO chama game() aqui - aguarda changemap
				}
				
				// Outros comandos
				if(parsed.length() >= 1) {
					if(parsed[0] == "usarcolete") {
						salvavida = 1;
					}
					else if(parsed[0] == "updatenow") {
						dlg(pu.get_value("Erro: Você precisa da última versão para poder jogar. Por favor atualiza para a última versão em checar por atualizações."));
						con.destroy();
						is_connected = false;
						menuprincipal();
						return;
					}
				}
				
				// Processar erros
				if(full_msg.lower().find("erro") != -1) {
					dlg(pu.get_value(full_msg));
					con.destroy();
					is_connected = false;
					menuprincipal();
					return;
				}
			}
			catch {
				log_client_network_exception("net_logar:event_receive", event.peer_id, event.message);
				con.destroy();
				is_connected = false;
				reset();
				menuprincipal();
				return;
			}
		}
	}
}

// ==========================================
// NETLOOP - PROCESSAMENTO DE EVENTOS DE REDE
// ==========================================
// Processa todos os eventos de rede recebidos do servidor
// Deve ser chamado continuamente no game loop
void netloop() {
	if(!is_connected) return; // Usar flag global
	
	const network_event@ ev;
	// Processar múltiplos eventos em um frame
	while((@ev = con.request()) !is null && ev.type != event_none) { // Usar conexão global
		
		// === DESCONEXÃO ===
		if(ev.type == event_disconnect) {
			speak(pu.get_value("Conexão perdida com o servidor."));
			is_connected = false; // Atualizar flag
			reset();
			relogin_flag = true;
			return;
		}
		
		// === RECEBIMENTO DE MENSAGENS ===
		if(ev.type == event_receive) {
			try {
				if(ev.message.length() > MAX_PACKET_ENCRYPTED_CHARS) {
					log_client_network_exception("netloop:event_receive:oversize", ev.peer_id, ev.message);
					is_connected = false;
					reset();
					relogin_flag = true;
					return;
				}
				string full_msg = decrypt_packet(ev.message);
				string[] parsed = full_msg.split(" ");
				
				if(parsed.length() == 0) continue;
				
				// ===================================================
				// CANAL 0 - EVENTOS PRINCIPAIS
				// ===================================================
				if(ev.channel == 0) {
					process_channel_0(full_msg, parsed, ev);
				}
				// ===================================================
				// CANAL 1 - CHAT PRINCIPAL
				// ===================================================
				else if(ev.channel == 1) {
					process_channel_1(full_msg, parsed, ev);
				}
				// ===================================================
				// CANAL 2 - AVISOS
				// ===================================================
				else if(ev.channel == 2) {
					add_add_item("avisos", full_msg);
				}
				// ===================================================
				// CANAL 3 - MORTES
				// ===================================================
				else if(ev.channel == 3) {
					process_channel_3(full_msg, parsed, ev);
				}
				// ===================================================
				// CANAL 4 - SONS DE TIRO
				// ===================================================
				else if(ev.channel == 4) {
					process_channel_4(full_msg, parsed, ev);
				}
				// ===================================================
				// CANAL 5 - SONS DE MAPA
				// ===================================================
				else if(ev.channel == 5) {
					process_channel_5(full_msg, parsed, ev);
				}
				// ===================================================
				// CANAL 6 - INFORMAÇÕES DE JOGADORES
				// ===================================================
				else if(ev.channel == 6) {
					process_channel_6(full_msg, parsed, ev);
				}
				// ===================================================
				// CANAL 7 - ÁUDIO DE VOZ
				// ===================================================
				else if(ev.channel == 7) {
					process_channel_7(full_msg, parsed, ev);
				}
			}
			catch {
				log_client_network_exception("netloop:event_receive", ev.peer_id, ev.message);
				// Não derruba cliente; ignora somente o pacote inválido.
				continue;
			}
		}
	}
}

// ==========================================
// PROCESSADORES DE CANAIS
// ==========================================

void show_items_list_menu(string raw_list) {
	if(ausente) return;

	string clean = raw_list.replace("\r", "");
	string[] lines = clean.split("\n");

	menu im;
	@im.pack_file = @sound_default_pack;
	im.click_sound = "invmove6.ogg";
	im.select_sound = "-old-menuchecked.ogg";
	im.open_sound = "notify37.ogg";
	im.wrap = false;
	im.focus_first_item = false;

	int count = 0;
	for(uint i = 0; i < lines.length(); i++) {
		string line = lines[i];
		if(line == "" || line.length() < 2) continue;

		// Itens chegam no formato: [tipo] id - nome...
		if(line.find("[") != 0) continue;
		int type_end = line.find("]");
		int dash_pos = line.find(" - ");
		if(type_end < 0 || dash_pos < 0 || dash_pos <= type_end + 2) continue;

		string item_type = line.substr(1, type_end - 1).trim_whitespace();
		string item_id = line.substr(type_end + 2, dash_pos - (type_end + 2)).trim_whitespace();
		string detail = line.substr(dash_pos + 3).trim_whitespace();
		if(item_id == "") continue;

		string visual = "%0, %1".format(item_id, item_type);
		if(detail != "") visual = "%0, %1".format(visual, detail);
		im.add_item(visual, item_id);
		count++;
	}

	if(count <= 0) {
		speak(pu.get_value("Nenhum item cadastrado."));
		return;
	}

	im.intro_text = pu.get_value("Mostrando lista de itens. %0 cadastrados.").format(count);
	emchat = true;
	im.run();
	emchat = false;
}

void process_channel_0(string full_msg, string[] parsed, const network_event@ ev) {
	// === MOVIMENTO DE OUTROS JOGADORES (BROADCAST DO SERVIDOR) ===
	if(parsed[0] == "xt01" && parsed.length() >= 4) {
		// xt01 peer_id x y - Movimento de outro jogador
		uint64 other_peer_id = string_to_number(parsed[1]);
		int other_x = string_to_number(parsed[2]);
		int other_y = string_to_number(parsed[3]);
		
		// Atualizar posição do jogador no array local
		for(uint i = 0; i < players.length(); i++) {
			if(players[i].peer_id == other_peer_id) {
				players[i].x = other_x;
				players[i].y = other_y;
				
				// Tocar som de passo 3D do outro jogador
				string tile = get_tile_at(other_x, other_y);
				if(tile != "") {
					string step_sound = tile + "step" + random(1, 5) + ".ogg";
					p.play_2d(step_sound, me.x, me.y, other_x, other_y, false);
				}
				break;
			}
		}
		return;
	}
	
	// === GRUPO 1: GERENCIAMENTO DE JOGADORES ===
	if(parsed[0] == "pong") {
		// Calcular tempo de ping
		int ping_time = pingtimer.elapsed;
		p.play_stationary("pingend.ogg", false);
		speak("Ping: " + ping_time + " milissegundos", true);
		forcepinging = false;
		debug_log("ðŸ“ Pong recebido! Ping: " + ping_time + "ms");
	}
	else if(parsed[0] == "say" && parsed.length() > 1) {
		// Mensagem simples do servidor (falar direto)
		string message = full_msg.substr(4); // Remove "say "
		speak(message, true);
		debug_log("ðŸ’¬ Servidor disse: " + message);
	}
	else if(parsed[0] == "listplayers") {
		// Lista de todos os jogadores online (resposta ao F5/getplayers)
		string data = "";
		if(full_msg.length() > 12) {
			data = full_msg.substr(12); // Remove "listplayers "
		}
		debug_log("ðŸ“‹ Recebido listplayers, dados: '" + data + "' (len=" + data.length() + ")");
		playersmenu(data);
	}
	else if(parsed[0] == "msg2" && parsed.length() > 1) {
		// Mensagem formatada do servidor com separadores ; (formato BGT)
		// Exemplo: "Você está no nível; 5, ;e na patente; ;soldado;. ;"
		string m = "";
		// Reconstruir a mensagem inteira a partir do texto original, ignorando "msg2 "
		string a = full_msg.substr(5); 

		// Lista de itens do construtor: abrir menu dedicado com contagem
		if(a.find("=== Itens do Banco de Dados ===") >= 0) {
			if(item_list_request_pending) {
				item_list_response_payload = a;
				item_list_response_ready = true;
				item_list_request_pending = false;
				return;
			}
			show_items_list_menu(a);
			return;
		}
		// Metadados do item builder (types/rarities/categories)
		if(a.find("ITEM_BUILDER_META|") == 0) {
			if(item_builder_meta_request_pending) {
				item_builder_meta_response_payload = a;
				item_builder_meta_response_ready = true;
				item_builder_meta_request_pending = false;
			}
			return;
		}
		if(a.find("/item_builder_meta") >= 0 && item_builder_meta_request_pending) {
			item_builder_meta_response_payload = "";
			item_builder_meta_response_ready = false;
			item_builder_meta_request_pending = false;
			return;
		}
		// Feedback imediato para erros de listagem/permissao no construtor de itens
		if(a.find("/list_items") >= 0 || a.find("Erro ao listar itens") >= 0) {
			if(item_list_request_pending) {
				item_list_response_payload = a;
				item_list_response_ready = true;
				item_list_request_pending = false;
				return;
			}
			speak(a, true);
			add_add_item("avisos", a);
			return;
		}
		// Captura erros padronizados do item builder para não deixar requisições pendentes.
		if(a.find("[ERRO] /") == 0) {
			bool is_item_builder_error = (a.find("/list_items") >= 0 ||
				a.find("/create_item_tool") >= 0 ||
				a.find("/edit_item_tool") >= 0 ||
				a.find("/delete_item_tool") >= 0 ||
				a.find("/create_weapon_tool") >= 0 ||
				a.find("/ib_") >= 0 ||
				a.find("/item_builder_meta") >= 0);
			if(is_item_builder_error) {
				if(item_list_request_pending) {
					item_list_response_payload = a;
					item_list_response_ready = true;
					item_list_request_pending = false;
				}
				if(item_builder_meta_request_pending) {
					item_builder_meta_response_payload = "";
					item_builder_meta_response_ready = false;
					item_builder_meta_request_pending = false;
				}
				if(item_builder_action_request_pending) {
					item_builder_action_response_payload = a;
					item_builder_action_response_ready = true;
					item_builder_action_request_pending = false;
				}
				speak(a, true);
				add_add_item("avisos", a);
				return;
			}
		}
		if(a.find("Nenhum item cadastrado") >= 0) {
			if(item_list_request_pending) {
				item_list_response_payload = pu.get_value("Nenhum item cadastrado.");
				item_list_response_ready = true;
				item_list_request_pending = false;
				return;
			}
			speak(pu.get_value("Nenhum item cadastrado."), true);
			add_add_item("avisos", pu.get_value("Nenhum item cadastrado."));
			return;
		}
		// Feedback de create/edit/delete do item builder para fluxos com espera ativa.
		if(item_builder_action_request_pending) {
			string a_lower = a.lower();
			bool is_item_builder_action_feedback = (
				a.find("[ERRO] /create_item_tool") == 0 ||
				a.find("[ERRO] /edit_item_tool") == 0 ||
				a.find("[ERRO] /delete_item_tool") == 0 ||
				a.find("[ERRO] /create_weapon_tool") == 0 ||
				a_lower.find("item criado com sucesso") >= 0 ||
				a_lower.find("item atualizado com sucesso") >= 0 ||
				a_lower.find("item removido do catalogo") >= 0 ||
				a_lower.find("item removido do catálogo") >= 0 ||
				a_lower.find("arma criada com sucesso") >= 0
			);
			if(is_item_builder_action_feedback) {
				item_builder_action_response_payload = a;
				item_builder_action_response_ready = true;
				item_builder_action_request_pending = false;
				return;
			}
		}
		
		string[] b = a.split(";");
		for(uint i = 0; i < b.length(); i++) {
			if(b[i] != "") {
				// Tentar traduzir cada segmento
				string segment = b[i];
				string translated = pu.get_value(segment);

				// Fallback: se não houver tradução, manter texto original
				if(translated == "") translated = segment;
				m += translated;
			}
		}

		// Fallback adicional para mensagens sem separador ';'
		if(m == "") m = a;
		
		add_add_item("avisos", m);
		debug_log("ðŸ“¨ Mensagem servidor processada (msg2): " + m);
	}
	else if(parsed[0] == "inv" && parsed.length() >= 1) {
		// Atualização incremental de inventário
		debug_log("ðŸ“¦ Recebido pacote inv: " + full_msg);
		load_inv(full_msg);
		debug_log("Inventário após load_inv: " + player_inv.get_size() + " itens");
	}
	else if(parsed[0] == "setinv" && parsed.length() >= 1) {
		// Substituição completa do inventário
		debug_log("ðŸ“¦ Recebido pacote setinv: " + full_msg.substr(0, 100) + "...");
		setinv(full_msg);
		debug_log("Inventário após setinv: " + player_inv.get_size() + " itens");
	}
	else if(parsed[0] == "setconfig") {
		try {
			string payload = full_msg.length() > 10 ? full_msg.substr(10).trim_whitespace() : "";
			string[] cfg = payload.split("|");
			if(cfg.length() < 3) {
				string generic_error = pu.get_value("Erro ao sincronizar dados.");
				if(generic_error == "") generic_error = "Erro ao sincronizar dados.";
				speak(generic_error, true);
				add_add_item("avisos", generic_error);
				debug_log("Falha ao processar setconfig: payload insuficiente");
				return;
			}

			string new_idiomachat = cfg[0].trim_whitespace();
			int new_voice = string_to_number(cfg[1].trim_whitespace());
			string new_voice_id = cfg[2].trim_whitespace(); // reservado para uso futuro

			if(new_idiomachat == "" || new_voice < 0) {
				string generic_error = pu.get_value("Erro ao sincronizar dados.");
				if(generic_error == "") generic_error = "Erro ao sincronizar dados.";
				speak(generic_error, true);
				add_add_item("avisos", generic_error);
				debug_log("Falha ao processar setconfig: dados inválidos");
				return;
			}

			idiomachat = new_idiomachat;
			voice = new_voice;
			if(game_tts.voice != voice) game_tts.set_voice(voice);
			if(tts.voice != voice) tts.set_voice(voice);

			debug_log("SETCONFIG aplicado: idiomachat=" + idiomachat + ", voice=" + voice + ", voice_id=" + new_voice_id);
		}
		catch {
			string generic_error = pu.get_value("Erro ao sincronizar dados.");
			if(generic_error == "") generic_error = "Erro ao sincronizar dados.";
			speak(generic_error, true);
			add_add_item("avisos", generic_error);
			debug_log("Falha ao processar setconfig");
		}
	}
	else if(parsed[0] == "setequipment") {
		try {
			string payload = full_msg.length() > 12 ? full_msg.substr(12).trim_whitespace() : "";
			// payload vazio = sem equipamentos
			if(payload == "") {
				debug_log("SETEQUIPMENT aplicado: nenhum item equipado");
			} else {
				string[] equip_list = payload.split(",");
				if(equip_list.length() == 0) {
					string generic_error = pu.get_value("Erro ao sincronizar dados.");
					if(generic_error == "") generic_error = "Erro ao sincronizar dados.";
					speak(generic_error, true);
					add_add_item("avisos", generic_error);
					debug_log("Falha ao processar setequipment: payload inválido");
					return;
				}
				debug_log("SETEQUIPMENT aplicado: " + payload);
			}
		}
		catch {
			string generic_error = pu.get_value("Erro ao sincronizar dados.");
			if(generic_error == "") generic_error = "Erro ao sincronizar dados.";
			speak(generic_error, true);
			add_add_item("avisos", generic_error);
			debug_log("Falha ao processar setequipment");
		}
	}
	else if(parsed[0] == "remplayer" && parsed.length() > 1) {
		remplayer(parsed[1]);
	}
	else if(parsed[0] == "terminate") {
		writeprefs();
		wait(200);
		exit();
	}
	else if(parsed[0] == "upl" && parsed.length() >= 4) {
		// Formato do servidor: upl peer_id x y
		int sender_peer_id = string_to_number(parsed[1]);
		int px = string_to_number(parsed[2]);
		int py = string_to_number(parsed[3]);
		
		// Atualizar posição do jogador por peer_id (sem som)
		update_player_by_peer_id(sender_peer_id, px, py);
	}
	else if(parsed[0] == "update_player2" && parsed.length() >= 5) {
		// Formato alternativo: update_player2 name x y map
		if(parsed[1] != un && parsed[4] == mapname) {
			update_player(parsed[1], string_to_number(parsed[2]), string_to_number(parsed[3]), parsed[4]);
		}
	}
	else if(parsed[0] == "pp" && parsed.length() > 1) {
		// Jogador pacífico
		set_player_peaceful(parsed[1], true);
	}
	else if(parsed[0] == "playerbeep" && parsed.length() > 2) {
		p.play_stationary(parsed[2] + ".ogg", false);
	}
	else if(parsed[0] == "on") {
		string who = full_msg.replace(parsed[0] + " ", "");
		if(who != un && avisadesconectou == 1) {
			p.play_stationary("online.ogg", false);
			string mes = who + " " + pu.get_value("aparece com um resplendor.");
			add_add_item("notificaciones_de_conexiÐ·nes", mes);
		}
	}
	else if(parsed[0] == "off" && parsed.length() >= 3) {
		if(parsed[1] == un) {
			if(string_to_number(parsed[3]) == 1) {
				speak(pu.get_value("A conexão com este universo foi perdida..."));
				wait(400);
				reset();
				relogin_flag = true;
			}
			else {
				wait(200);
				reset();
			}
		}
		else {
			remplayer(parsed[1]);
			if(string_to_number(parsed[2]) == 1 && avisadesconectou == 1) {
				string mes = parsed[1] + " " + pu.get_value("desaparece em uma explosão de luz.");
				p.play_stationary("offline.ogg", false);
				add_add_item("notificaciones_de_conexiÐ·nes", mes);
			}
		}
	}
	
	// === GRUPO 2: MOVIMENTO E POSICIONAMENTO ===
	else if(parsed[0] == "s" && parsed.length() >= 5) {
		// Formato do servidor: s peer_id steps x y
		int sender_peer_id = string_to_number(parsed[1]);
		string step_sound = parsed[2];
		int px = string_to_number(parsed[3]);
		int py = string_to_number(parsed[4]);
		
		// Atualizar posição do jogador no array
		update_player_by_peer_id(sender_peer_id, px, py);
		
		// Tocar som do passo na posição do jogador
		if(step_sound != "" && step_sound != "0") {
			p.play_2d(step_sound + ".ogg", me.x, me.y, px, py, false);
		} else {
			p.play_2d("step.ogg", me.x, me.y, px, py, false);
		}
	}
	else if(parsed[0] == "move" && parsed.length() >= 3) {
		me.x = string_to_number(parsed[1]);
		me.y = string_to_number(parsed[2]);
	}
	// ✅ Task 2.2: Handler de rotação (yaw)
	else if(parsed[0] == "yaw" && parsed.length() >= 2) {
		me.yaw = string_to_number(parsed[1]);
		debug_log("🧭 Yaw atualizado: " + me.yaw + "°");
	}
	// âœ… Task 2.2: Handler de stance (agachar/sentar)
	else if(parsed[0] == "stance" && parsed.length() >= 2) {
		int new_stance = string_to_number(parsed[1]);
		me.stance = new_stance;

		// Feedback sonoro baseado na postura
		string stance_name = "em pé";
		string stance_sound = "stance_stand.ogg";

		if(new_stance == 1) {
			stance_name = "agachado";
			stance_sound = "stance_crouch.ogg";
		} else if(new_stance == 2) {
			stance_name = "sentado";
			stance_sound = "stance_sit.ogg";
		}

		p.play_stationary(stance_sound, false);
		speak("Agora você está " + stance_name + ".", true);
		debug_log("ðŸ§ Stance atualizado: " + stance_name + " (" + new_stance + ")");
	}
	// âœ… Task 2.2: Handler de stance de outros jogadores
	else if(parsed[0] == "player_stance" && parsed.length() >= 3) {
		// player_stance peer_id stance
		uint64 other_peer_id = string_to_number(parsed[1]);
		int other_stance = string_to_number(parsed[2]);

		// Atualizar stance do jogador no array
		for(uint i = 0; i < players.length(); i++) {
			if(players[i].peer_id == other_peer_id) {
				players[i].stance = other_stance;
				debug_log("ðŸ§ Player " + players[i].charname + " mudou stance para: " + other_stance);
				break;
			}
		}
	}
	else if(parsed[0] == "turn" && parsed.length() >= 4) {
		if(parsed[1] != un && parsed[4] == mapname) {
			p.play_2d("turn.ogg", me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
	}
	else if(parsed[0] == "jumping" && parsed.length() >= 5) {
		if(parsed[1] != un && parsed[4] == mapname) {
			p.play_2d("jump.ogg", me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
	}
	else if(parsed[0] == "land" && parsed.length() >= 6) {
		int fh = string_to_number(parsed[5]);
		if(parsed[1] != un && parsed[4] == mapname) {
			if(fh < 20) {
				p.play_2d(get_tile_at(string_to_number(parsed[2]), string_to_number(parsed[3])) + "land.ogg", 
				          me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
			}
			else {
				p.play_2d(get_tile_at(string_to_number(parsed[2]), string_to_number(parsed[3])) + "hardland.ogg", 
				          me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
			}
		}
	}
	else if(parsed[0] == "wall" && parsed.length() >= 5) {
		if(parsed[1] != un) {
			p.play_2d(parsed[4] + ".ogg", me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
	}
	else if(parsed[0] == "ataque") {
		if(facing == Right) me.x -= 5;
		if(facing == Left) me.x += 5;
		me.y += 35;
		centar();
	}
	
	// === GRUPO 5: SISTEMA DE CHAT ===
	else if(parsed[0] == "local" && parsed.length() > 1) {
		debug_log("ðŸ’¬ Chat local recebido");
		string msg = string_replace(full_msg, "local ", "", false);
		add_add_item("local", msg, true);  // Usa sistema de adds
	}
	else if(parsed[0] == "pm" && parsed.length() > 1) {
		debug_log("ðŸ’¬ PM recebido");
		string msg = string_replace(full_msg, "pm ", "", false);
		add_add_item("privado", msg, true);  // Usa sistema de adds
	}
	else if(parsed[0] == "team" && parsed.length() > 1) {
		debug_log("ðŸ’¬ Chat de equipe recebido");
		string msg = string_replace(full_msg, "team ", "", false);
		add_add_item("equipe", msg, true);  // Usa sistema de adds
	}
	else if(parsed[0] == "say" && parsed.length() > 1) {
		debug_log("ðŸ’¬ Chat global recebido");
		string msg = string_replace(full_msg, "say ", "", false);
		add_add_item("global", msg, true);  // Usa sistema de adds
	}
	else if(parsed[0] == "hablarbot" && parsed.length() > 1) {
		debug_log("ðŸ’¬ Chat NPC recebido");
		string npc_name = parsed[1];
		string msg = npc_name + " diz: " + 
					string_replace(full_msg, "hablarbot " + npc_name + " ", "", false);
		add_add_item("local", msg, true);  // Usa sistema de adds
	}
	else if(parsed[0] == "system" && parsed.length() > 1) {
		debug_log("ðŸ’¬ Mensagem de sistema recebida");
		string msg = string_replace(full_msg, "system ", "", false);
		add_add_item("servidor", msg, false);  // Usa sistema de adds
	}
	
	else if(parsed[0] == "changemap") {
		load_map(full_msg);
		connect = true;
	}
	else if(parsed[0] == "changemap2") {
		load_map(full_msg, false);
		connect = true;
	}
	
	// === GRUPO 3: INVENTÁRIO ===
	// (removido - já processado no início da função)
	
	// === GRUPO 4: ÁUDIO ===
	else if(parsed[0] == "play" && parsed.length() > 3) {
		p.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "play2" && parsed.length() > 3) {
		p.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), true);
	}
	else if(parsed[0] == "play3" && parsed.length() > 4) {
		p.play_extended_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), 
		                   0, 0, 0, 0, false, 0, 0, 0, string_to_number(parsed[4]));
	}
	else if(parsed[0] == "play4" && parsed.length() > 4) {
		p.play_stationary_extended(parsed[1], false, 0, string_to_number(parsed[2]), 
		                            string_to_number(parsed[3]), string_to_number(parsed[4]));
	}
	else if(parsed[0] == "ps" && parsed.length() >= 2) {
		p.play_stationary(parsed[1], false);
	}
	else if(parsed[0] == "ps2" && parsed.length() > 2) {
		p.play_stationary_extended(parsed[1], false, 0, 0, 0, string_to_number(parsed[2]));
	}
	else if(parsed[0] == "p2d" && parsed.length() > 3) {
		p.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "pan" && parsed.length() > 2) {
		p.play_stationary_extended(parsed[1], false, 0, string_to_number(parsed[2]), 0, 100);
	}
	else if(parsed[0] == "rs" && parsed.length() > 1) {
		for(uint i = 0; i < sons.length(); i++) {
			string[] ss = sons[i].split(":");
			if(ss[1] == parsed[1]) {
				p.play_2d(ss[0], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
				break;
			}
		}
	}
	else if(parsed[0] == "rico" && parsed.length() > 3) {
		if(parsed[1] != "") {
			p.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
	}
	else if(parsed[0] == "draw" && parsed.length() == 4) {
		p.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "pst") {
		if(somchuva != "rain4.ogg") {
			sound t;
			t.load(parsed[1]);
			string vo = "-" + random(3, 5);
			t.volume = string_to_number(vo);
			t.play();
		}
		else if(somchuva == "rain4.ogg") {
			p.play_stationary(parsed[1], false);
		}
	}
	
	// === GRUPO 5: ESTADOS DO JOGADOR ===
	else if(parsed[0] == "startfloat") floating = true;
	else if(parsed[0] == "stopfloat") floating = false;
	else if(parsed[0] == "startcloak") cloaked = true;
	else if(parsed[0] == "stopcloak") cloaked = false;
	else if(parsed[0] == "superjumpon") jumpheight = 15;
	else if(parsed[0] == "superjumpoff") jumpheight = 5;
	else if(parsed[0] == "start_watch") inansz = true;
	else if(parsed[0] == "stop_watch") {
		nolhar.resize(0);
		inansz = false;
	}
	else if(parsed[0] == "stopmoving") moveable = false;
	else if(parsed[0] == "startmoving") moveable = true;
	else if(parsed[0] == "staron") star = true;
	else if(parsed[0] == "staroff") star = false;
	else if(parsed[0] == "bolhadearon") bolhadear = true;
	else if(parsed[0] == "bolhaaroff") bolhadear = false;
	else if(parsed[0] == "fimnovato") novato = 0;
	else if(parsed[0] == "ininovato") novato = 1;
	else if(parsed[0] == "morreu") {
		afogando = 0;
		congelando = 0;
	}
	else if(parsed[0] == "usarcolete") salvavida = 1;
	else if(parsed[0] == "retirarcolete") salvavida = 0;
	else if(parsed[0] == "ausente0") ausente = false;
	else if(parsed[0] == "ausente1") ausente = true;
	// âœ… Handler para pacifico - atualiza status de jogador
	else if(parsed[0] == "pp" && parsed.length() >= 3) {
		string player_name = parsed[1];
		int pacifico_status = string_to_number(parsed[2]);
		for(uint i = 0; i < players.length(); i++) {
			if(players[i].charname == player_name) {
				players[i].pacifico = pacifico_status;
				break;
			}
		}
	}
	// ininovato/fimnovato - modo novato/proteção
	else if(parsed[0] == "ininovato") novato = 1;
	else if(parsed[0] == "fimnovato") novato = 0;
	else if(parsed[0] == "seguro") nvaicair = 1;
	else if(parsed[0] == "aveloz") dveloz = 1;
	else if(parsed[0] == "dveloz") dveloz = 0;
	
	// === GRUPO 6: CLIMA E AMBIENTE ===
	else if(parsed[0] == "chuvaativa") {
		chuvaativa = 1;
		chuva();
	}
	else if(parsed[0] == "fimchuva") {
		chuvaativa = 0;
		chuvatelhado.pause();
	}
	else if(parsed[0] == "volumechuva") {
		chuvalivre.volume = string_to_number(parsed[1]);
		chuvatelhado.volume = string_to_number(parsed[1]);
	}
	else if(parsed[0] == "addambiente") {
		destroy_all_ambientes();
		spawn_ambiente(string_to_number(parsed[1]), string_to_number(parsed[2]), 
		               string_to_number(parsed[3]), string_to_number(parsed[4]), parsed[5], "123");
	}
	else if(parsed[0] == "rsonsmo") {
		destroy_all_msounds();
	}
	else if(parsed[0] == "cm") {
		createmsound(string_to_number(parsed[1]), parsed[2], string_to_number(parsed[3]), 
		             string_to_number(parsed[4]), parsed[5]);
	}
	else if(parsed[0] == "destroymsound") {
		destroymsound(string_to_number(parsed[1]));
	}
	else if(parsed[0] == "um") {
		updatemsound(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]));
	}
	
	// === GRUPO 7: MENSAGENS ===
	else if(parsed[0] == "msg" && parsed.length() > 1) {
		process_msg(full_msg, parsed);
	}
	else if(parsed[0] == "msg2") {
		process_msg2(full_msg, parsed);
	}
	else if(parsed[0] == "msg3") {
		process_msg3(full_msg, parsed);
	}
	else if(parsed[0] == "msg4") {
		process_msg4(full_msg, parsed);
	}
	else if(parsed[0] == "msgnormal") {
		string m = full_msg.replace(parsed[0] + " ", "");
		add_add_item("avisos", pu.get_value(m));
	}
	// 🆕 CHAT LOCAL: fm |titulo| nome |ação| mensagem
	else if(parsed[0] == "fm") {
		process_fm(full_msg, parsed);
	}
	// ðŸ†• MENSAGEM PRIVADA: pm de/para nome: mensagem
	else if(parsed[0] == "pm") {
		process_pm(full_msg, parsed);
	}
	// 🆕 NOTIFICAÇÃO DE CONEXÃO: msgconexoes mensagem
	else if(parsed[0] == "msgconexoes") {
		process_msgconexoes(full_msg, parsed);
	}
	// ✅ TASK 3.3 QOL: Tradução recebida
	else if(parsed[0] == "translated") {
		string data = full_msg.replace("translated ", "");
		process_translated_message(data);
	}
	// ✅ TASK 3.3 QOL: Habilitar tradução
	else if(parsed[0] == "enabletranslate") {
		process_enable_translate();
	}
	// ✅ TASK 3.3 QOL: Desabilitar tradução
	else if(parsed[0] == "disabletranslate") {
		process_disable_translate();
	}
	
	// ✅ PINFO: Menu navegável de informações do jogador
	else if(full_msg.find("pinfo_data:") == 0) {
		process_pinfo_data(full_msg);
	}
	
	// === GRUPO 8: COMBATE ===
	else if(parsed[0] == "finalhit") {
		for(uint i = 0; i < sons.length(); i++) {
			string[] ss = sons[i].split(":");
			if(ss[1] == parsed[1]) {
				p.play_2d(ss[0], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
				if(parsed.length() > 7) {
					p.play_2d("v" + string_to_number(parsed[8]) + "dor" + random(1, 3) + ".ogg", 
					          me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
				}
				break;
			}
		}
	}
	else if(parsed[0] == "impact" && parsed.length() > 3) {
		p.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "inithurt") {
		p.play_2d("v" + string_to_number(parsed[1]) + "quejido" + random(1, 4) + ".ogg", 
		          me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	
	// === GRUPO 9: ARMAS ===
	else if(parsed[0] == "reset_weapons") {
		weapons.resize(0);
	}
	else if(parsed[0] == "create_weapon") {
		string content = full_msg.replace(parsed[0] + " ", "");
		string[] lines = content.split("\r\n");
		for(int x = 0; x < lines.length(); x++) {
			string[] data = lines[x].split(" ");
			if(get_weapon_index(data[10]) < 0) {
				create_weapon(string_to_number(data[0]), string_to_number(data[1]), string_to_number(data[2]), 
				              string_to_number(data[3]), string_to_number(data[4]), string_to_number(data[5]), 
				              string_to_number(data[6]), data[7], data[8], data[9], data[10], data[11], 
				              data[12], data[13], string_to_number(data[14]), data[15]);
			}
		}
	}
	
	// === GRUPO 10: MENUS ===
	else if(parsed[0] == "servermenu") {
		string content = full_msg.replace(parsed[0] + " ", "");
		string[] data = content.split("|");
		menuserver(data[0], data[1], string_to_number(data[2]), data[3].split("\r\n"), data[4].split("\r\n"));
	}
	else if(parsed[0] == "menutext" && parsed.length() > 1) {
		string content = full_msg.replace(parsed[0] + " ", "");
		textmenu(content.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura2" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul2(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura3" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul3(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura4" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul4(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura5" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul5(mensagem.split("\r\n"));
	}
	
	// === GRUPO 11: ADMIN ===
	else if(parsed[0] == "djogador") {
		desenvolvedordm = 1;
		is_dev = true;
		debug_log("ðŸ” Recebido djogador - desenvolvedordm=" + desenvolvedordm + " is_dev=" + is_dev);
		speak("Modo desenvolvedor ativado");
	}
	else if(parsed[0] == "ajogador") {
		is_admin = true;
		debug_log("ðŸ” Recebido ajogador - is_admin=" + is_admin);
		speak("Modo administrador ativado");
	}
	else if(parsed[0] == "mjogador") {
		modera = 1;
		is_moderator = true;
		debug_log("ðŸ” Recebido mjogador - is_moderator=" + is_moderator);
		speak("Modo moderador ativado");
	}
	else if(parsed[0] == "bjogador") {
		construye = 1;
		is_builder = true;
		debug_log("ðŸ” Recebido bjogador - is_builder=" + is_builder);
		speak("Modo construtor ativado");
	}
	else if(parsed[0] == "dmoderador") modera = 1;
	else if(parsed[0] == "dconstructor") construye = 1;
	else if(parsed[0] == "enabletranslate") enabletranslate = 1;
	else if(parsed[0] == "disabletranslate") enabletranslate = 0;
	else if(parsed[0] == "enablechatadm") enablechatadm = 1;
	else if(parsed[0] == "disablechatadm") enablechatadm = 0;
	else if(parsed[0] == "restart") {
		run("C:\\Program Files (x86)\\NVDA\\nvda_slave.exe", "launchNVDA -r", true, true);
	}
	else if(parsed[0] == "update") {
		reset();
		atualizarv();
	}
	else if(parsed[0] == "kill") {
		send_unreliable(peer_id, "close terminate", 0);
		writeprefs();
		wait(200);
		exit();
	}
	else if(parsed[0] == "reiniciar") {
		wait(1000);
		reset();
		relogin_flag = true;
	}
	else if(parsed[0] == "chutad") {
		chutad();
	}
	
	// === GRUPO 12: OUTROS ===
	else if(parsed[0] == "set_married_variable" && parsed.length() > 1) {
		married = 1;  // int, não bool
	}
	else if(parsed[0] == "set_parabatai_variable" && parsed.length() > 1) {
		parabatyed = 1;  // int, não bool
	}
	else if(parsed[0] == "setstatus") {
		string m = full_msg.replace(parsed[0] + " ", "");
		for(uint index = 0; index < players.length(); index++) {
			players[index].status = m;
		}
	}
	else if(parsed[0] == "pm" || (parsed[0] == "you" && parsed[1] == "reply:")) {
		p.play_stationary("stunstop.ogg", false);
		string mes = full_msg;
		mes = mes.replace("/reply ", "");
		mes = mes.replace("/r ", "");
		mes = mes.replace("pm de", pu.get_value("pm de"));
		mes = mes.replace("pm para", pu.get_value("pm para"));
		add_add_item("conversaciones_privadas", mes);
	}
	else if(parsed[0] == "mensaje") {
		p.play_stationary("notify8.ogg", false);
		string mes = full_msg;
		mes = mes.replace("/reply ", "");
		mes = mes.replace("/r ", "");
		mes = mes.replace("mensaje de", pu.get_value("mensagem de"));
		mes = mes.replace("mensaje para", pu.get_value("mensagem para"));
		add_add_item("conversaciones_privadas", mes);
	}
	else if(parsed[0] == "permanent") {
		string text = full_msg.replace(parsed[0] + " ", "");
		string text2 = text.replace("mensaje permanente no leído de", pu.get_value("mensagem permanente não lida de"));
		add_add_item("conversaciones_privadas", text2);
		if(logpermanents == 1) {
			if(!directory_exists("permanents")) directory_create("permanents");
			string text3 = text2.replace("mensaje permanente no leído de", "mensagem de");
			file f;
			f.open("permanents/permanent_" + DATE_YEAR + "_" + DATE_MONTH + "_" + DATE_DAY + ".log", "a");
			f.write(text3 + "\r\n");
			f.close();
		}
	}
	else if(parsed[0] == "pass_changed") {
		pwh = temporal_pwh;
		temporal_pwh = "";
		writeprefs();
	}
	else if(parsed[0] == "channels" && parsed.length() >= 2) {
		string data = full_msg.replace(parsed[0] + " ", "");
		idiomaschat = data.split("\r\n");
		chatmenu();
	}
	// === NPC ATTACK: Ataque de NPC recebido do servidor ===
	else if(parsed[0] == "npc_attack" && parsed.length() >= 4) {
		// npc_attack npc_id dano tipo
		int npc_id = string_to_number(parsed[1]);
		int dano = string_to_number(parsed[2]);
		string tipo = parsed[3]; // tipo de ataque: normal, magic, status, etc
		
		// Encontrar NPC na lista
		for(uint i = 0; i < npc_objects.length(); i++) {
			if(npc_objects[i].id == npc_id) {
				// Tocar som de ataque do NPC
				p.play_stationary("hit.ogg", false);
				
				// Adicionar mensagem ao chat
				string msg = "NPC " + npc_objects[i].name + " atacou você! Dano: " + dano;
				add_add_item("avisos", msg);
				
				// Debug log
				debug_log("âš”ï¸ NPC " + npc_objects[i].name + " (ID:" + npc_id + ") atacou! Dano: " + dano + " Tipo: " + tipo);
				
				break;
			}
		}
		return;
	}
	// === NPC MOVE: Movimento de NPC ===
	else if(parsed[0] == "npc_move" && parsed.length() >= 4) {
		int id = string_to_number(parsed[1]);
		int x = string_to_number(parsed[2]);
		int y = string_to_number(parsed[3]);
		
		for(uint i = 0; i < npc_objects.length(); i++) {
			if(npc_objects[i].id == id) {
				npc_objects[i].x = x;
				npc_objects[i].y = y;
				npc_objects[i].last_seen.restart();
				break;
			}
		}
		return;
	}
	// === NPC SPAWN: Criar novo NPC ===
	else if(parsed[0] == "npc_spawn" && parsed.length() >= 8) {
		int id = string_to_number(parsed[1]);
		string nome = parsed[2];
		int x = string_to_number(parsed[3]);
		int y = string_to_number(parsed[4]);
		int hp = string_to_number(parsed[5]);
		int max_hp = string_to_number(parsed[6]);
		
		npc_client_class novo_npc;
		novo_npc.id = id;
		novo_npc.name = nome;
		novo_npc.x = x;
		novo_npc.y = y;
		novo_npc.x_inicial = x;
		novo_npc.y_inicial = y;
		novo_npc.hp = hp;
		novo_npc.max_hp = max_hp;
		novo_npc.map = mapname;
		novo_npc.last_seen.restart();
		
		npc_objects.insert_last(novo_npc);
		debug_log("ðŸ‘¹ NPC spawned: " + nome + " ID:" + id + " em (" + x + "," + y + ")");
		return;
	}
	// === NPC DIE: NPC morreu ===
	else if(parsed[0] == "npc_die" && parsed.length() >= 2) {
		int id = string_to_number(parsed[1]);
		
		for(uint i = 0; i < npc_objects.length(); i++) {
			if(npc_objects[i].id == id) {
				debug_log("ðŸ’€ NPC morreu: " + npc_objects[i].name + " (ID:" + id + ")");
				@npc_objects[i] = null;
				npc_objects.remove_at(i);
				break;
			}
		}
		return;
	}
	// === NPC HP: Atualizar vida do NPC ===
	else if(parsed[0] == "npc_hp" && parsed.length() >= 4) {
		int id = string_to_number(parsed[1]);
		int hp = string_to_number(parsed[2]);
		int max_hp = string_to_number(parsed[3]);
		
		for(uint i = 0; i < npc_objects.length(); i++) {
			if(npc_objects[i].id == id) {
				npc_objects[i].hp = hp;
				npc_objects[i].max_hp = max_hp;
				debug_log("â¤ï¸ NPC " + npc_objects[i].name + " HP: " + hp + "/" + max_hp);
				break;
			}
		}
		return;
	}
	// === FALLBACK: Mensagem desconhecida ===
	else {
		// Compatibilidade: alguns fluxos antigos enviam "som.ogg x y" sem prefixo "play"
		// Exemplo: "abrirziper.ogg 52 0"
		if(parsed.length() == 3 && parsed[0].find(".ogg") > 0 && string_is_digits(parsed[1]) && string_is_digits(parsed[2])) {
			p.play_2d(parsed[0], me.x, me.y, string_to_number(parsed[1]), string_to_number(parsed[2]), false);
			return;
		}
		add_add_item("avisos", full_msg);
	}
}

void process_channel_1(string full_msg, string[] parsed, const network_event@ ev) {
	// Chat principal (canal ENet 1)
	string mensagem = full_msg.replace(parsed[0] + " ", "");
	mensagem = mensagem.replace("diz:", pu.get_value("diz:") + " ");
	
	// Traduzir tipos de personagem
	mensagem = translate_character_types(mensagem);
	
	string[] zumba = mensagem.split(bell);
	string m = "";
	if(zumba.length() > 1) {
		m = zumba[1];
	}
	
	if(tradutorativo == 1 && parsed[0] != un) {
		string pa = m;
		if(pa != "") m = pa;
	}
	
	m = ndicionario(m);
	add_add_item("global", zumba[0] + m, true);  // Usa "global" - add_add_item já toca o som
}

void process_channel_3(string full_msg, string[] parsed, const network_event@ ev) {
	// Canal de mortes
	if(ouvirmortes == 1 || parsed.find(un) > -1 || full_msg.lower().find(un.lower()) != -1) {
		p.play_stationary("armarockimpact.ogg", false);
		
		if(parsed[0] == "msgmortanaarena") {
			string m = parsed[1] + " " + pu.get_value("foi morta na arena por") + " " + parsed[2];
			add_add_item("avisos_de_morte", m);
		}
		else if(parsed[0] == "msgmuerte") {
			process_msg_translated(full_msg, parsed, "avisos_de_morte");
		}
		// Adicionar outros tipos de morte conforme necessário
	}
}

void process_channel_4(string full_msg, string[] parsed, const network_event@ ev) {
	// Sons de tiro
	if(parsed[0] == "f" && parsed.length() == 4) {
		shoot.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
}

void process_channel_5(string full_msg, string[] parsed, const network_event@ ev) {
	// Sons de mapa
	if(parsed[0] == "play_body" && parsed.length() > 3) {
		bodys.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "play_wall" && parsed.length() > 3) {
		walls.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "play_npc" && parsed.length() > 3) {
		npcs.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "play_step" && parsed.length() > 3) {
		steps.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "set_player_info" && parsed.length() > 1) {
		string content = full_msg.replace(parsed[0] + " ", "");
		string[] packets = content.split("|");
		for(int x = 0; x < packets.length(); x++) {
			string[] data = packets[x].split(" ");
			if(data[0] == "set_team_members" && data.length() >= 1) {
				string team_content = packets[x].replace(data[0] + " ", "");
				team_members = team_content.split("\r\n");
			}
			else if(data[0] == "set_items_for_translate" && data.length() > 1) {
				string items_content = packets[x].replace(data[0] + " ", "");
				items_for_translate = items_content.split("\r\n");
			}
			else if(data[0] == "invsec" && data.length() > 1) {
				load_secondary_inventory(packets[x]);
			}
			else if(data[0] == "djogador") {
				desenvolvedordm = 1;
				is_dev = true;
			}
			else if(data[0] == "ajogador") {
				is_admin = true;
			}
			else if(data[0] == "mjogador") {
				modera = 1;
				is_moderator = true;
			}
			else if(data[0] == "bjogador") {
				construye = 1;
				is_builder = true;
			}
			else if(data[0] == "dmoderador") modera = 1;
			else if(data[0] == "dconstructor") construye = 1;
			else if(data[0] == "enabletranslate") enabletranslate = 1;
			else if(data[0] == "set_married_variable" && data.length() > 1) {
				married = 1;
			}
			else if(data[0] == "set_parabatai_variable" && data.length() > 1) {
				parabatyed = 1;
			}
			else if(data[0] == "cm") {
				createmsound(string_to_number(data[1]), data[2], string_to_number(data[3]), 
				             string_to_number(data[4]), data[5]);
			}
			else if(data[0] == "level" && data.length() > 1) {
				for(int i = 0; i < players.length(); i++) {
					if(players[i].peer_id == peer_id) {
						players[i].level = string_to_number(data[1]);
						break;
					}
				}
			}
		}
	}
}

void process_channel_6(string full_msg, string[] parsed, const network_event@ ev) {
	// Informações de jogadores e times
	if(parsed[0] == "gender" && parsed.length() > 1) {
		gender = parsed[1];
	}
	else if(parsed[0] == "reset_all_weapons_ammo") {
		for(int x = 0; x < player_weapons.length(); x++) {
			player_weapons[x].ammo_load = 0;
		}
	}
	else if(parsed[0] == "add_team_member" && parsed.length() > 1) {
		if(team_members.find(parsed[1]) < 0) team_members.insert_last(parsed[1]);
	}
	else if(parsed[0] == "remove_team_member" && parsed.length() > 1) {
		int find = team_members.find(parsed[1]);
		if(find > -1) team_members.remove_at(find);
	}
	else if(parsed[0] == "clear_team_members") {
		team_members.resize(0);
		team_members.insert_last(un);
	}
	else if(parsed[0] == "set_team_members" && parsed.length() >= 1) {
		string content = full_msg.replace(parsed[0] + " ", "");
		team_members = content.split("\r\n");
	}
	else if(parsed[0] == "set_map_players" && parsed.length() > 1) {
		if(parsed[1] == "none") players.resize(0);
		else {
			string[] content = full_msg.replace(parsed[0] + " ", "").split("\r\n");
			for(int x = 0; x < content.length(); x++) {
				string[] data = content[x].split(" ");
				if(data.length() > 4) {
					newplayer(data[0], string_to_number(data[1]), string_to_number(data[2]), 
					          string_to_number(data[3]), string_to_number(data[4]), string_to_number(data[5]));
				}
			}
		}
	}
	else if(parsed[0] == "add_player_to_map" && parsed.length() > 1) {
		if(get_player(parsed[1]) < 0) {
			newplayer(parsed[1], string_to_number(parsed[2]), string_to_number(parsed[3]), 
			          string_to_number(parsed[4]), string_to_number(parsed[5]), string_to_number(parsed[6]));
		}
	}
	else if(parsed[0] == "remove_player_from_map" && parsed.length() > 1) {
		int find = get_player(parsed[1]);
		if(find > -1) players.remove_at(find);
	}
	else if(parsed[0] == "add_line_to_map" && parsed.length() > 1) {
		string line = full_msg.replace(parsed[0] + " ", "");
		map2.insert_at(map2.length() - 2, line);
		init_data(line);
	}
	else if(parsed[0] == "remove_line_from_map" && parsed.length() > 1) {
		string line = full_msg.replace(parsed[0] + " ", "");
		int find = map2.find(line);
		if(find > -1) map2.remove_at(find);
	}
	else if(parsed[0] == "reset_items_selected") {
		items_selected.resize(0);
	}
	else if(parsed[0] == "select_items" && parsed.length() > 1) {
		string content = full_msg.replace(parsed[0] + " ", "");
		items_selected = content.split("\r\n");
	}
	else if(parsed[0] == "show_eagle_messages" && parsed.length() > 1) {
		string content = full_msg.replace(parsed[0] + " ", "");
		show_eagle_messages(content.split("\r\n"));
	}
}

void process_channel_7(string full_msg, string[] parsed, const network_event@ ev) {
	// === NOVO SISTEMA DE VOICE CHAT (Task 1.6.1) ===
	// Mensagens de voz com posicionamento 3D HRTF
	if(full_msg.find("VOICE_PLAY|") == 0) {
		handle_voice_packet(full_msg);
		return;
	}

	// === SISTEMA LEGADO DE VOICE CHAT ===
	// Áudio de voz (antigo)
	if(parsed[0] == "map_audio" && voicechat == 1) {
		string vc = full_msg.replace(parsed[0] + " " + parsed[1] + " " + parsed[2] + " ", "");
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		audio.play_2d(vc, me.x, me.y, x, y, false, true);
	}
	else if(parsed[0] == "private_audio") {
		vc = full_msg.replace(parsed[0] + " " + parsed[1] + " ", "");
		if(voicechat == 1) {
			audio.play_stationary(vc, false, true);
			add_add_item("mensagens_de_voz", pu.get_value("mensagem de voz privada de") + " " + parsed[1] + ".");
			if(logaudio == 1) {
				saveaudio(vc);
			}
		}
	}
	else if(parsed[0] == "team_audio") {
		vc = full_msg.replace(parsed[0] + " ", "");
		if(voicechat == 1) {
			audio.play_stationary(vc, false, true);
			if(logaudio == 1) {
				saveaudio(vc);
			}
		}
	}
}

// ==========================================
// FUNÇÕES AUXILIARES DE PROCESSAMENTO
// ==========================================

void process_msg(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " " + parsed[1] + " ", "");
	string[] b = a.split("|");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	
	// Mapear nomes de canal antigos (BGT) para novos
	string channel = parsed[1];
	if(channel == "canal_principal") channel = "global";
	else if(channel == "canal_local") channel = "local";
	else if(channel == "mensajes_del_equipo") channel = "equipe";
	else if(channel == "conversaciones_privadas") channel = "privado";
	else if(channel == "visiones_angelicales") channel = "admin";
	
	add_add_item(channel, m);
}

void process_msg2(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", "");
	string[] b = a.split(";");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	add_add_item("tudo", m);  // Avisos vão pro canal "tudo"
}

void process_msg3(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", "");
	string[] b = a.split(";");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	add_add_item("equipe", m);  // Chat de equipe
}

void process_msg4(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", "");
	
	// âœ… Task 2.6.2: Detectar e processar [LOGO_CHATTER] no chat administrativo
	// Se a mensagem contém [LOGO_CHATTER], tocar som especial e adicionar prefixo "Chatter:"
	bool is_chatter = false;
	if(a.find("[LOGO_CHATTER]") != -1) {
		is_chatter = true;
		a = a.replace("[LOGO_CHATTER] ", ""); // Remove o marcador
		a = a.replace("[LOGO_CHATTER]", "");  // Remove caso não tenha espaço
		// Tocar som especial do Chatter
		p.play_stationary("chatter_logo.ogg", false);
	}
	
	string[] b = a.split(";");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	
	// Adicionar prefixo "Chatter:" se for uma mensagem de chatter
	if(is_chatter) {
		m = "Chatter: " + m;
	}
	
	add_add_item("admin", m);  // Chat de administração
}

void process_msg_translated(string full_msg, string[] parsed, string channel) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", "");
	string[] b = a.split(";");
	for(uint i = 0; i < b.length(); i++) {
		m += pu.get_value(b[i]);
	}
	add_add_item(channel, m);
}

string translate_character_types(string text) {
	text = text.replace("ser_de_luz", pu.get_value("ser_de_luz"));
	text = text.replace("Novato", pu.get_value("Novato"));
	text = text.replace("Novata", pu.get_value("Novata"));
	text = text.replace("vampira", pu.get_value("vampira"));
	text = text.replace("vampiro", pu.get_value("vampiro"));
	text = text.replace("vampira_diurna", pu.get_value("vampira_diurna"));
	text = text.replace("vampiro_diurno", pu.get_value("vampiro_diurno"));
	text = text.replace("jefe_de_clan", pu.get_value("chefe_de_clã"));
	text = text.replace("licántropo", pu.get_value("licantropo"));
	text = text.replace("líder_de_la_manada", pu.get_value("líder_da_matilha"));
	text = text.replace("guerrera_hada", pu.get_value("guerreira_fada"));
	text = text.replace("guerrero_hada", pu.get_value("guerreiro_fada"));
	text = text.replace("bruja ", pu.get_value("bruxa "));
	text = text.replace("brujo", pu.get_value("bruxo"));
	text = text.replace("cazador", pu.get_value("caçador"));
	text = text.replace("cazadora", pu.get_value("caçadora"));
	text = text.replace("guerrera_oscurecida", pu.get_value("guerreira_obscurecida"));
	text = text.replace("guerrero_oscurecido", pu.get_value("guerreiro_obscurecido"));
	text = text.replace("demonio_menor", pu.get_value("demônio_menor"));
	text = text.replace("demonio_mayor", pu.get_value("demônio_maior"));
	text = text.replace("príncipe_del_infierno", pu.get_value("príncipe_do_inferno"));
	text = text.replace("princesa_del_infierno", pu.get_value("princesa_do_inferno"));
	return text;
}

// ============================================================================
// ðŸ†• SISTEMA DE CHAT COMPLETO - HANDLERS ADICIONAIS
// ============================================================================

// process_fm - Fala Mapa (Chat Local)
// Formato BGT: fm |titulo| nome |ação| mensagem
// Exemplo: fm |Guerreiro| João |diz:| Olá pessoal!
void process_fm(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", ""); // Remove "fm "
	
	// Separar por | e traduzir cada parte
	string[] parts = a.split("|");
	for(uint i = 0; i < parts.length(); i++) {
		// Traduzir partes conhecidas
		string part = trim_string(parts[i]);
		if(part != "") {
			m += pu.get_value(part);
			if(i < parts.length() - 1) m += " ";
		}
	}
	
	// Adicionar ao canal de chat local
	add_add_item("local", m);
}

// process_pm - Mensagem Privada
// Formato BGT: pm de/para nome: mensagem
// Exemplo: pm de João: Olá! ou pm para Maria: Oi!
void process_pm(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", ""); // Remove "pm "
	
	// Traduzir "de" e "para" se necessário
	if(a.length() > 3) {
		if(a.substr(0, 3) == "de ") {
			a = pu.get_value("de") + " " + a.substr(3);
		} else if(a.substr(0, 5) == "para ") {
			a = pu.get_value("para") + " " + a.substr(5);
		}
	}
	
	m = a;
	
	// Adicionar ao canal de mensagens privadas
	add_add_item("privado", m);
	
	// Tocar som de notificação
	p.play_stationary("notify_pm.ogg", false);
}

// process_msgconexoes - Notificação de Conexão/Desconexão
// Formato BGT: msgconexoes mensagem
void process_msgconexoes(string full_msg, string[] parsed) {
	string m;
	string a = full_msg;
	a = a.replace(parsed[0] + " ", ""); // Remove "msgconexoes "
	
	// Traduzir partes separadas por ;
	string[] parts = a.split(";");
	for(uint i = 0; i < parts.length(); i++) {
		m += pu.get_value(parts[i]);
	}
	
	// Adicionar ao canal "tudo" (notificações de conexão)
	add_add_item("tudo", m);
}

// ============================================================================
// PINFO - Menu Navegável de Informações do Jogador
// Formato: pinfo_data:nome|status|banido|razao|expira|nivel|xp|hp|mapa|pos|admin|gold
// ============================================================================
void process_pinfo_data(string full_msg) {
	// Remove o prefixo "pinfo_data:"
	string raw = full_msg.substr(11);  // "pinfo_data:" tem 11 caracteres
	string[] info = raw.split("|");
	
	if(info.length() < 12) {
		speak(pu.get_value("Erro ao processar informações do jogador."));
		debug_log("âŒ PINFO: dados incompletos - " + raw);
		return;
	}
	
	// Campos:
	// 0: Nome, 1: Status, 2: Banido?, 3: Razão ban, 4: Expira ban
	// 5: Nível, 6: XP, 7: HP, 8: Mapa, 9: Posição, 10: Admin?, 11: Ouro
	
	// Criar menu navegável
	setupmenu();
	
	// Cabeçalho
	string title = info[0] + " (" + info[1] + ")";
	
	// Itens do menu (cada um pode ser navegado individualmente)
	game_menu.add_item(pu.get_value("Nome: ") + info[0], "nome");
	game_menu.add_item(pu.get_value("Status: ") + info[1], "status");
	
	// Status de ban com destaque
	if(info[2] == "Sim") {
		game_menu.add_item(pu.get_value("âš ï¸ BANIDO: Sim"), "banido");
		game_menu.add_item(pu.get_value("Razão do ban: ") + info[3], "razao");
		game_menu.add_item(pu.get_value("Expira em: ") + info[4], "expira");
	} else {
		game_menu.add_item(pu.get_value("Banido: Não"), "banido");
	}
	
	// Estatísticas (se disponíveis)
	if(info[5] != "?") {
		game_menu.add_item(pu.get_value("Nível: ") + info[5], "nivel");
	}
	if(info[6] != "?") {
		game_menu.add_item(pu.get_value("XP: ") + info[6], "xp");
	}
	if(info[7] != "?") {
		game_menu.add_item(pu.get_value("Vida: ") + info[7], "hp");
	}
	if(info[8] != "?") {
		game_menu.add_item(pu.get_value("Mapa: ") + info[8], "mapa");
	}
	if(info[9] != "?") {
		game_menu.add_item(pu.get_value("Posição: ") + info[9], "pos");
	}
	
	// Admin e Ouro
	game_menu.add_item(pu.get_value("Administrador: ") + info[10], "admin");
	if(info[11] != "?") {
		game_menu.add_item(pu.get_value("Ouro: ") + info[11], "gold");
	}
	
	game_menu.add_item(pu.get_value("Fechar"), "fechar");
	
	game_menu.intro_text = pu.get_value("Informações de ") + title;
	
	// Executar menu (o jogador pode navegar pelos itens)
	int result = game_menu.run();
	
	// Não precisa fazer nada com a seleção - é apenas informativo
	debug_log("ðŸ“‹ PINFO: Menu de " + info[0] + " exibido");
}


