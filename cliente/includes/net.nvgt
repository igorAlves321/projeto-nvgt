#include "net/msg2_handler.nvgt"
#include "net/message_handlers.nvgt"
#include "net/sync_handlers.nvgt"
#include "net/channel0_handlers.nvgt"

const bool NET_DEBUG_SPEAKS = false;

enum NetChannel {
    CH_DEFAULT = 0,
    CH_CHAT = 1,
    CH_MOVE = 2,
    CH_SYSTEM = 3,
    CH_ACTION = 4,
    CH_AUDIO = 5,
    CH_ADMIN = 6,
    CH_SYNC = 7
}

const int NET_CHANNEL_COUNT = 8;

const network_event@ event;
bool encryption = true;
double idversion = 1.0;
int connecttime = 10000;
timer connecttimer;

const string PACKET_ENCRYPTION_KEY = "evm_server_key_2024";

string encrypt_packet(string message) {
    return string_aes_encrypt(message, PACKET_ENCRYPTION_KEY);
}

string decrypt_packet(string message) {
    return string_aes_decrypt(message, PACKET_ENCRYPTION_KEY);
}

void log_client_network_exception(const string& in context, uint64 peer_id, const string& in packet_message) {
    datetime dt;
    string log_ts = dt.format("%Y-%m-%d %H:%M:%S");
    string log_file = "debug/erros_client.log";
    string safe_packet = packet_message;
    if(safe_packet.length() > MAX_NETWORK_LOG_PACKET_CHARS) {
        safe_packet = safe_packet.substr(0, MAX_NETWORK_LOG_PACKET_CHARS) + "... [TRUNCADO]";
    }

    string log_text = "[network_exception]\n";
    log_text += "timestamp=" + log_ts + "\n";
    log_text += "role=client\n";
    log_text += "context=" + context + "\n";
    log_text += "peer_id=" + peer_id + "\n";
    log_text += "packet=" + safe_packet + "\n";
    log_text += "exception_file=" + get_exception_file() + "\n";
    log_text += "exception_line=" + get_exception_line() + "\n";
    log_text += "exception_info=" + get_exception_info() + "\n";
    log_text += "call_stack_begin\n";
    log_text += last_exception_call_stack + "\n";
    log_text += "call_stack_end\n";
    log_text += "[/network_exception]\n\n";

    directory_create("debug");
    file f;
    if(f.open(log_file, "a")) {
        f.write(log_text);
        f.close();
    }

    debug_log("ERRO DE REDE NO CLIENTE (" + context + "). Detalhes em " + log_file);
}

void net_create() {
	string username;
	string password;
	string email;
	if(!collect_account_creation_data(username, password, email)) {
		account_creating = false;
		menuprincipal();
		return;
	}

	menusilent();
	game_menu.add_item(pu.get_value("Homem"), "0");
	game_menu.add_item(pu.get_value("Mulher"), "1");
	game_menu.intro_text = pu.get_value("Você é homem ou mulher?");
	int selection = game_menu.run();
	if(selection == -1) {
		account_creating = false;
		menuprincipal();
		return;
	}

	string selected_gender = game_menu.get_item_id(selection);
	gender = selected_gender;

	speak(pu.get_value("Conectando..."));

	@event = null;
	con.setup_client(20, 100);
	uint64 server_peer = con.connect(game_serveraddress, game_serverport);

	if(server_peer == 0) {
		dlg(pu.get_value("Erro ao conectar ao servidor"));
		account_creating = false;
		menuprincipal();
		return;
	}

	peer_id = server_peer;
	is_connected = true;
	connecttimer.restart();

	while(true) {
		wait(5);

		if(key_pressed(KEY_ESCAPE)) {
			con.destroy();
			is_connected = false;
			account_creating = false;
			menuprincipal();
			return;
		}

		@event = con.request();
		if(event is null) {
			if(connecttimer.elapsed >= connecttime) {
				dlg(pu.get_value("Servidor indisponivel"));
				con.destroy();
				is_connected = false;
				account_creating = false;
				menuprincipal();
				return;
			}
			continue;
		}

		if(event.type == event_connect) {
			uint64 connected_peer = event.peer_id;
			string hashed_password = hash_password(password);
			string create_msg = "xt55 " + username + " " + hashed_password + " " + email + " " + selected_gender;
			con.send(connected_peer, encrypt_packet(create_msg), 0, true);
		}
		else if(event.type == event_receive) {
			try {
				if(event.message.length() > MAX_PACKET_ENCRYPTED_CHARS) {
					log_client_network_exception("net_create:event_receive:oversize", event.peer_id, event.message);
					con.destroy();
					is_connected = false;
					account_creating = false;
					menuprincipal();
					return;
				}
				string received_msg = normalize_legacy_text(decrypt_packet(event.message));
				if(received_msg == "created") {
					account_creating = false;
					net_un = username;
					net_pw = password;
					un = username;
					pw = password;
					writeprefs();
					dlg(pu.get_value("Conta criada com sucesso! Pressione enter para logar-se."));
					net_logar();
					return;
				}
				else if(received_msg.find("Erro") != -1 || received_msg.lower().find("erro") != -1) {
					dlg(pu.get_value(received_msg));
					con.destroy();
					is_connected = false;
					account_creating = false;
					menuprincipal();
					return;
				}
			}
			catch {
				log_client_network_exception("net_create:event_receive", event.peer_id, event.message);
				con.destroy();
				is_connected = false;
				account_creating = false;
				menuprincipal();
				return;
			}
		}
		else if(event.type == event_disconnect) {
			dlg(pu.get_value("Servidor indisponivel"));
			con.destroy();
			is_connected = false;
			account_creating = false;
			menuprincipal();
			return;
		}
	}
}

void net_logar(bool localhost = false) {
	if(net_un == "" || net_pw == "") {
		dlg(pu.get_value("Você não tem uma conta configurada. Por favor, crie uma conta primeiro ou configure suas credenciais."));
		menuprincipal();
		return;
	}

	writeprefs();

	speak(pu.get_value("Conectando ao servidor..."));
	string target_address = game_serveraddress;
	if(localhost) {
		target_address = "localhost";
	}

	debug_log("=== INICIANDO TENTATIVA DE CONEXAO ===");
	debug_log("Endereco: " + target_address + " Porta: " + game_serverport);
	if(NET_DEBUG_SPEAKS) speak("DEBUG: Iniciando conexão para " + target_address + " porta " + game_serverport);
	is_connected = false;
	@event = null;

	debug_log("Chamando setup_client(20, 150)");
	if(NET_DEBUG_SPEAKS) speak("DEBUG: Chamando setup_client com 20 canais e 150ms timeout");
	con.setup_client(20, 150);

	debug_log("Chamando connect()");
	if(NET_DEBUG_SPEAKS) speak("DEBUG: Chamando connect para " + target_address + " porta " + game_serverport);
	uint64 server_peer = con.connect(target_address, game_serverport);
	uint64 expected_peer = server_peer;

	if(server_peer == 0) {
		dlg(pu.get_value("Erro ao conectar ao servidor"));
		reset();
		menuprincipal();
		return;
	}

	peer_id = server_peer;

	debug_log("Aguardando evento de conexão... timeout=" + connecttime + "ms");
	if(NET_DEBUG_SPEAKS) speak("DEBUG: Aguardando evento de conexão");
	connecttimer.restart();

	audio_form conectando_form;
	conectando_form.create_window(pu.get_value("Conectando ao servidor... Pressione ESC para cancelar."), false, true);

	while(true) {
		wait(5);
		conectando_form.monitor();
		@event = con.request();

		if(key_pressed(KEY_ESCAPE)) {
			debug_log("Usuario cancelou a conexão");
			if(NET_DEBUG_SPEAKS) speak("DEBUG: Usuario cancelou conexão");
			con.destroy();
			is_connected = false;
			reset();
			menuprincipal();
			return;
		}

		if(event is null) {
			if(!is_connected && connecttimer.elapsed >= connecttime) {
				debug_log("TIMEOUT apos " + connecttimer.elapsed + "ms - Servidor não respondeu");
				if(NET_DEBUG_SPEAKS) speak("DEBUG: Timeout - " + connecttimer.elapsed + "ms sem resposta");
				dlg(pu.get_value("Servidor fora do ar, tente novamente mais tarde."));
				con.destroy();
				is_connected = false;
				reset();
				menuprincipal();
				return;
			}
			continue;
		}

		if(event.type == event_none) {
			if(!is_connected && connecttimer.elapsed >= connecttime) {
				debug_log("TIMEOUT apos " + connecttimer.elapsed + "ms - Servidor não respondeu");
				if(NET_DEBUG_SPEAKS) speak("DEBUG: Timeout - " + connecttimer.elapsed + "ms sem resposta");
				dlg(pu.get_value("Servidor fora do ar, tente novamente mais tarde."));
				con.destroy();
				is_connected = false;
				reset();
				menuprincipal();
				return;
			}
			continue;
		}

		debug_log("Evento recebido: tipo=" + event.type + ", peer_id=" + event.peer_id);
		if(NET_DEBUG_SPEAKS) speak("DEBUG: Evento recebido - tipo=" + event.type + " peer=" + event.peer_id);

		if(event.type == event_disconnect) {
			if(event.peer_id != expected_peer) {
				debug_log("Ignorando desconexão de peer antigo durante login: " + event.peer_id + " (esperado: " + expected_peer + ")");
				continue;
			}
			debug_log("Evento de desconexão do peer atual durante login");
			if(NET_DEBUG_SPEAKS) speak("DEBUG: Desconectado do peer atual");
			dlg(pu.get_value("Servidor fora do ar, tente novamente mais tarde."));
			con.destroy();
			is_connected = false;
			reset();
			menuprincipal();
			return;
		}
		if(!is_connected && connecttimer.elapsed >= connecttime) {
			debug_log("Evento de timeout durante login");
			if(NET_DEBUG_SPEAKS) speak("DEBUG: Timeout durante login");
			dlg(pu.get_value("Servidor fora do ar, tente novamente mais tarde."));
			con.destroy();
			is_connected = false;
			reset();
			menuprincipal();
			return;
		}

		if(event.type == event_connect && !is_connected) {
			debug_log("EVENT_CONNECT recebido! peer_id=" + event.peer_id);
			if(NET_DEBUG_SPEAKS) speak("DEBUG: EVENT_CONNECT recebido! Enviando credenciais");
			expected_peer = event.peer_id;
			net_peer_id = event.peer_id;
			server_peer_id = event.peer_id;
			peer_id = int(event.peer_id);
			string hashed_password = hash_password(net_pw);
			string login_msg = "h33j " + net_un + " " + hashed_password + " " + gversion + " " + banned;
			debug_log("Enviando credenciais: " + net_un + " (hash omitido por seguranca)");
			con.send(net_peer_id, encrypt_packet(login_msg), 0, true);
			debug_log("Credenciais enviadas, aguardando resposta do servidor");
			if(NET_DEBUG_SPEAKS) speak("DEBUG: Credenciais enviadas, aguardando resposta");
			continue;
		}

		if(event.type == event_receive) {
			try {
				if(event.message.length() > MAX_PACKET_ENCRYPTED_CHARS) {
					log_client_network_exception("net_logar:event_receive:oversize", event.peer_id, event.message);
					con.destroy();
					is_connected = false;
					reset();
					menuprincipal();
					return;
				}
				string full_msg = normalize_legacy_text(decrypt_packet(event.message));
				debug_log("Mensagem recebida do servidor: '" + full_msg + "'");
				string[] parsed = full_msg.split(" ");

				if(parsed.length() >= 2) {
					if(parsed[0] == "x") me.x = string_to_number(parsed[1]);
					if(parsed[0] == "y") me.y = string_to_number(parsed[1]);
				}

				if(parsed.length() >= 1) {
					if(parsed[0] == "changemap") {
						debug_log("- CHANGEMAP recebido - carregando mapa completo");

						string map_payload = string_replace(full_msg, "changemap ", "", false);
						load_map(map_payload);

						string[] ldata = delinear(map_payload);
						for(uint i = 0; i < ldata.length(); i++) {
							string[] parts = ldata[i].split(":");
							if(parts[0] == "x" && parts.length() > 1) {
								me.x = string_to_number(parts[1]);
							}
							else if(parts[0] == "y" && parts.length() > 1) {
								me.y = string_to_number(parts[1]);
							}
							else if(parts[0] == "map" && parts.length() > 1) {
								mapname = parts[1];
							}
						}

						debug_log("Mapa carregado! " + mapname + " (" + me.x + "," + me.y + ")");
						speak("Você esta no mapa: " + mapname + ". Use as setas para se mover.");

						game();
						debug_log("game() retornou (desconexão ou saida)");
						return;
					}
				}

				if(full_msg.find("loggedin") != -1) {
					debug_log("LOGGEDIN recebido! Aguardando changemap...");
					username = net_un;
					is_connected = true;

					reconnect_attempts = 0;
					reconnect_delay = MIN_RECONNECT_DELAY;
					waiting_to_reconnect = false;
					kicked_to_menu = false;

					speak(pu.get_value("Logado com sucesso! Carregando mundo..."));
				}

				if(parsed.length() >= 1) {
					if(parsed[0] == "usarcolete") {
						salvavida = 1;
					}
					else if(parsed[0] == "updatenow") {
						dlg(pu.get_value("Erro: Você precisa da ultima versão para poder jogar. Por favor atualiza para a ultima versão em checar por atualizacoes."));
						con.destroy();
						is_connected = false;
						menuprincipal();
						return;
					}
				}

				if(full_msg.lower().find("erro") != -1) {
					dlg(pu.get_value(full_msg));
					con.destroy();
					is_connected = false;
					menuprincipal();
					return;
				}
			}
			catch {
				log_client_network_exception("net_logar:event_receive", event.peer_id, event.message);
				con.destroy();
				is_connected = false;
				reset();
				menuprincipal();
				return;
			}
		}
	}
}

void netloop() {
	if(!is_connected) return;

	const network_event@ ev;
	while((@ev = con.request()) !is null && ev.type != event_none) {
		if(@ev is null) continue;

		if(ev.type == event_disconnect) {
			speak(pu.get_value("Conexao perdida com o servidor."));
			is_connected = false;
			reset();
			if(kicked_to_menu) {
				kicked_to_menu = false;
				relogin_flag = false;
				waiting_to_reconnect = false;
				menuprincipal();
				return;
			}
			relogin_flag = true;
			return;
		}

		if(ev.type == event_receive) {
			try {
				if(ev.message.length() > MAX_PACKET_ENCRYPTED_CHARS) {
					log_client_network_exception("netloop:event_receive:oversize", ev.peer_id, ev.message);
					is_connected = false;
					reset();
					relogin_flag = true;
					return;
				}
				string full_msg = normalize_legacy_text(decrypt_packet(ev.message));
				string[] parsed = full_msg.split(" ");

				if(parsed.length() == 0) continue;

				if(ev.channel == 0) {
					process_channel_0(full_msg, parsed, ev);
				}
				else if(ev.channel == 1) {
					process_channel_1(full_msg, parsed, ev);
				}
				else if(ev.channel == 2) {
					add_add_item("avisos", full_msg);
				}
				else if(ev.channel == 3) {
					process_channel_3(full_msg, parsed, ev);
				}
				else if(ev.channel == 4) {
					process_channel_4(full_msg, parsed, ev);
				}
				else if(ev.channel == 5) {
					process_channel_5(full_msg, parsed, ev);
				}
				else if(ev.channel == 6) {
					process_channel_6(full_msg, parsed, ev);
				}
				else if(ev.channel == 7) {
					process_channel_7(full_msg, parsed, ev);
				}
			}
			catch {
				log_client_network_exception("netloop:event_receive", ev.peer_id, ev.message);
				continue;
			}
		}
	}
}

void show_items_list_menu(string raw_list) {
	if(ausente) return;

	string clean = raw_list.replace("\r", "");
	string[] lines = clean.split("\n");

	menu im;
	@im.pack_file = cast<pack_file@>(sound_default_pack);
	im.sounds_prefix = (@sound_default_pack != null) ? "" : "sounds/";
	im.click_sound = "invmove6.ogg";
	im.select_sound = "-old-menuchecked.ogg";
	im.open_sound = "notify37.ogg";
	im.wrap = false;
	im.focus_first_item = false;

	int count = 0;
	for(uint i = 0; i < lines.length(); i++) {
		string line = lines[i];
		if(line == "" || line.length() < 2) continue;

		if(line.find("[") != 0) continue;
		int type_end = line.find("]");
		int dash_pos = line.find(" - ");
		if(type_end < 0 || dash_pos < 0 || dash_pos <= type_end + 2) continue;

		string item_type = line.substr(1, type_end - 1).trim_whitespace();
		string item_id = line.substr(type_end + 2, dash_pos - (type_end + 2)).trim_whitespace();
		string detail = line.substr(dash_pos + 3).trim_whitespace();
		if(item_id == "") continue;

		string visual = "%0, %1".format(item_id, item_type);
		if(detail != "") visual = "%0, %1".format(visual, detail);
		im.add_item(visual, item_id);
		count++;
	}

	if(count <= 0) {
		speak(pu.get_value("Nenhum item cadastrado."));
		return;
	}

	im.intro_text = pu.get_value("Mostrando lista de itens. %0 cadastrados.").format(count);
	emchat = true;
	im.run();
	emchat = false;
}

bool net_json_try_get_int(const string &in json, const string &in field, int &out value) {
	string marker = "\"" + field + "\":";
	int pos = json.find(marker);
	if(pos < 0) return false;
	pos += marker.length();

	while(pos < int(json.length()) && (json.substr(pos, 1) == " " || json.substr(pos, 1) == "\t")) pos++;
	if(pos >= int(json.length())) return false;

	int end = pos;
	if(json.substr(end, 1) == "-") end++;
	while(end < int(json.length())) {
		string ch = json.substr(end, 1);
		if(ch < "0" || ch > "9") break;
		end++;
	}
	if(end <= pos) return false;

	value = string_to_number(json.substr(pos, end - pos));
	return true;
}

bool net_json_try_get_string(const string &in json, const string &in field, string &out value) {
	string marker = "\"" + field + "\":\"";
	int pos = json.find(marker);
	if(pos < 0) return false;
	pos += marker.length();

	int end = json.find("\"", pos);
	if(end < 0) return false;

	value = json.substr(pos, end - pos);
	return true;
}

void process_channel_0(string full_msg, string[] parsed, const network_event@ ev) {
	if(handle_channel0_physical_inventory(full_msg, parsed)) return;
	if(handle_channel0_remote_movement(parsed)) return;

	if(parsed[0] == "pong") {
		int ping_time = pingtimer.elapsed;
		p.play_stationary("pingend.ogg", false);
		speak("Ping: " + ping_time + " milissegundos", true);
		forcepinging = false;
		debug_log("Pong recebido! Ping: " + ping_time + "ms");
	}
	else if(parsed[0] == "say" && parsed.length() > 1) {
		string message = full_msg.substr(4);
		speak(message, true);
		debug_log(" Servidor disse: " + message);
	}
	else if(parsed[0] == "listplayers") {
		string data = "";
		if(full_msg.length() > 12) {
			data = full_msg.substr(12);
		}
		debug_log("Recebido listplayers, dados: '" + data + "' (len=" + data.length() + ")");
		playersmenu(data);
	}
	else if(parsed[0] == "store_open") {
		string store_type = "";
		if(full_msg.length() > 11) {
			store_type = full_msg.substr(11).trim_whitespace();
		}
		open_generic_store(store_type);
	}
	else if(parsed[0] == "store") {
		string store_payload = "";
		if(full_msg.length() > 6) {
			store_payload = full_msg.substr(6).trim_whitespace();
		}
		if(store_payload == "") {
			speak(pu.get_value("Nenhum item disponivel na loja."), true);
			return;
		}
		open_store(store_payload);
	}
	else if(parsed[0] == "loja_gerenciar") {
		string gerenciar_payload = "";
		if(full_msg.length() > 15) {
			gerenciar_payload = full_msg.substr(15).trim_whitespace();
		}
		manage_store(gerenciar_payload);
	}
	else if(parsed[0] == "loja_estoque" && parsed.length() > 1) {
		string estoque_resto = "";
		if(full_msg.length() > 13) {
			estoque_resto = full_msg.substr(13).trim_whitespace();
		}
		string[] estoque_pedaco = estoque_resto.split("|");
		if(estoque_pedaco.length() >= 2) {
			manage_items_on_store(estoque_pedaco[0], estoque_pedaco[1]);
		}
		else if(estoque_pedaco.length() == 1) {
			manage_items_on_store(estoque_pedaco[0], "");
		}
	}
	else if(parsed[0] == "msg2" && parsed.length() > 1) {
		process_msg2_packet(full_msg);
	}
	else if(parsed[0] == "inv" && parsed.length() >= 1) {
		debug_log("Recebido pacote inv: " + full_msg);
		load_inv(full_msg);
		debug_log("Inventario apos load_inv: " + player_inv.get_size() + " itens");
	}
	else if(parsed[0] == "setinv" && parsed.length() >= 1) {
		debug_log("Recebido pacote setinv: " + full_msg.substr(0, 100) + "...");
		setinv(full_msg);
		debug_log("Inventario apos setinv: " + player_inv.get_size() + " itens");
	}
	else if(parsed[0] == "setconfig") {
		handle_setconfig_packet(full_msg);
	}
	else if(parsed[0] == "setequipment") {
		handle_setequipment_packet(full_msg);
	}
	else if(parsed[0] == "remplayer" && parsed.length() > 1) {
		remplayer(parsed[1]);
	}
	else if(parsed[0] == "terminate") {
		writeprefs();
		wait(200);
		exit();
	}
	else if(parsed[0] == "upl" && parsed.length() >= 4) {
		int sender_peer_id = string_to_number(parsed[1]);
		int px = string_to_number(parsed[2]);
		int py = string_to_number(parsed[3]);

		update_player_by_peer_id(sender_peer_id, px, py);
	}
	else if(parsed[0] == "update_player2" && parsed.length() >= 5) {
		if(parsed[1] != un && parsed[4] == mapname) {
			update_player(parsed[1], string_to_number(parsed[2]), string_to_number(parsed[3]), parsed[4]);
		}
	}
	else if(parsed[0] == "pp" && parsed.length() > 1) {
		set_player_peaceful(parsed[1], true);
	}
	else if(parsed[0] == "playerbeep" && parsed.length() > 2) {
		p.play_stationary(parsed[2] + ".ogg", false);
	}
	else if(parsed[0] == "on") {
		string who = full_msg.replace(parsed[0] + " ", "");
		if(who != un && avisadesconectou == 1) {
			p.play_stationary("online.ogg", false);
			string mes = who + " " + pu.get_value("aparece com um resplendor.");
			add_add_item("notificaciones_de_conexines", mes);
		}
	}
	else if(parsed[0] == "off" && parsed.length() >= 4) {
		if(parsed[1] == un) {
			if(string_to_number(parsed[3]) == 1) {
				speak(pu.get_value("A conexão com este universo foi perdida..."));
				wait(400);
				reset();
				relogin_flag = true;
			}
			else {
				wait(200);
				reset();
			}
		}
		else {
			remplayer(parsed[1]);
			if(string_to_number(parsed[2]) == 1 && avisadesconectou == 1) {
				string mes = parsed[1] + " " + pu.get_value("desaparece em uma explosao de luz.");
				p.play_stationary("offline.ogg", false);
				add_add_item("notificaciones_de_conexines", mes);
			}
		}
	}

	else if(parsed[0] == "s" && parsed.length() >= 5) {
		int sender_peer_id = string_to_number(parsed[1]);
		string step_sound = parsed[2];
		int px = string_to_number(parsed[3]);
		int py = string_to_number(parsed[4]);

		update_player_by_peer_id(sender_peer_id, px, py);

		if(step_sound != "" && step_sound != "0") {
			p.play_2d(step_sound + ".ogg", me.x, me.y, px, py, false);
		} else {
			p.play_2d("step.ogg", me.x, me.y, px, py, false);
		}
	}
	else if(parsed[0] == "move" && parsed.length() >= 3) {
		me.x = string_to_number(parsed[1]);
		me.y = string_to_number(parsed[2]);
	}
	else if(parsed[0] == "yaw" && parsed.length() >= 2) {
		me.yaw = string_to_number(parsed[1]);
		debug_log(" Yaw atualizado: " + me.yaw + "");
	}
	else if(parsed[0] == "stance" && parsed.length() >= 2) {
		int new_stance = string_to_number(parsed[1]);
		me.stance = new_stance;

		string stance_name = "em pe";
		string stance_sound = "stance_stand.ogg";

		if(new_stance == 1) {
			stance_name = "agachado";
			stance_sound = "stance_crouch.ogg";
		} else if(new_stance == 2) {
			stance_name = "sentado";
			stance_sound = "stance_sit.ogg";
		}

		p.play_stationary(stance_sound, false);
		speak("Agora você esta " + stance_name + ".", true);
		debug_log(" Stance atualizado: " + stance_name + " (" + new_stance + ")");
	}
	else if(parsed[0] == "player_stance" && parsed.length() >= 3) {
		uint64 other_peer_id = string_to_number(parsed[1]);
		int other_stance = string_to_number(parsed[2]);

		for(uint i = 0; i < players.length(); i++) {
			if(players[i].peer_id == other_peer_id) {
				players[i].stance = other_stance;
				debug_log(" Player " + players[i].charname + " mudou stance para: " + other_stance);
				break;
			}
		}
	}
	else if(parsed[0] == "turn" && parsed.length() >= 5) {
		if(parsed[1] != un && parsed[4] == mapname) {
			p.play_2d("turn.ogg", me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
	}
	else if(parsed[0] == "jumping" && parsed.length() >= 5) {
		if(parsed[1] != un && parsed[4] == mapname) {
			p.play_2d("jump.ogg", me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
	}
	else if(parsed[0] == "land" && parsed.length() >= 6) {
		int fh = string_to_number(parsed[5]);
		if(parsed[1] != un && parsed[4] == mapname) {
			if(fh < 20) {
				p.play_2d(get_tile_at(string_to_number(parsed[2]), string_to_number(parsed[3])) + "land.ogg",
				          me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
			}
			else {
				p.play_2d(get_tile_at(string_to_number(parsed[2]), string_to_number(parsed[3])) + "hardland.ogg",
				          me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
			}
		}
	}
	else if(parsed[0] == "wall" && parsed.length() >= 5) {
		if(parsed[1] != un) {
			p.play_2d(parsed[4] + ".ogg", me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
	}
	else if(parsed[0] == "ataque") {
		if(facing == Right) me.x -= 5;
		if(facing == Left) me.x += 5;
		me.y += 35;
		centar();
	}

	else if(parsed[0] == "local" && parsed.length() > 1) {
		debug_log(" Chat local recebido");
		string msg = string_replace(full_msg, "local ", "", false);
		add_add_item("local", msg, true);
	}
	else if(parsed[0] == "pm" && parsed.length() > 1) {
		debug_log(" PM recebido");
		string msg = string_replace(full_msg, "pm ", "", false);
		add_add_item("privado", msg, true);
	}
	else if(parsed[0] == "team" && parsed.length() > 1) {
		debug_log(" Chat de equipe recebido");
		string msg = string_replace(full_msg, "team ", "", false);
		add_add_item("equipe", msg, true);
	}
	else if(parsed[0] == "say" && parsed.length() > 1) {
		debug_log(" Chat global recebido");
		string msg = string_replace(full_msg, "say ", "", false);
		add_add_item("global", msg, true);
	}
	else if(parsed[0] == "hablarbot" && parsed.length() > 1) {
		debug_log(" Chat NPC recebido");
		string npc_name = parsed[1];
		string msg = npc_name + " diz: " +
					string_replace(full_msg, "hablarbot " + npc_name + " ", "", false);
		add_add_item("local", msg, true);
	}
	else if(parsed[0] == "system" && parsed.length() > 1) {
		debug_log(" Mensagem de sistema recebida");
		string msg = string_replace(full_msg, "system ", "", false);
		add_add_item("servidor", msg, false);
	}

	else if(parsed[0] == "changemap") {
		string map_payload = string_replace(full_msg, "changemap ", "", false);
		load_map(map_payload);
		connect = true;
	}
	else if(parsed[0] == "changemap2") {
		string map_payload = string_replace(full_msg, "changemap2 ", "", false);
		load_map(map_payload, false);
		connect = true;
	}

	else if(handle_channel0_audio(parsed)) {
	}

	else if(parsed[0] == "startfloat") floating = true;
	else if(parsed[0] == "stopfloat") floating = false;
	else if(parsed[0] == "startcloak") cloaked = true;
	else if(parsed[0] == "stopcloak") cloaked = false;
	else if(parsed[0] == "superjumpon") jumpheight = 15;
	else if(parsed[0] == "superjumpoff") jumpheight = 5;
	else if(parsed[0] == "start_watch") inansz = true;
	else if(parsed[0] == "stop_watch") {
		nolhar.resize(0);
		inansz = false;
	}
	else if(parsed[0] == "stopmoving") moveable = false;
	else if(parsed[0] == "startmoving") moveable = true;
	else if(parsed[0] == "staron") star = true;
	else if(parsed[0] == "staroff") star = false;
	else if(parsed[0] == "bolhadearon") bolhadear = true;
	else if(parsed[0] == "bolhaaroff") bolhadear = false;
	else if(parsed[0] == "fimnovato") novato = 0;
	else if(parsed[0] == "ininovato") novato = 1;
	else if(parsed[0] == "morreu") {
		afogando = 0;
		congelando = 0;
	}
	else if(parsed[0] == "usarcolete") salvavida = 1;
	else if(parsed[0] == "retirarcolete") salvavida = 0;
	else if(parsed[0] == "ausente0") ausente = false;
	else if(parsed[0] == "ausente1") ausente = true;
	else if(parsed[0] == "pp" && parsed.length() >= 3) {
		string player_name = parsed[1];
		int pacifico_status = string_to_number(parsed[2]);
		for(uint i = 0; i < players.length(); i++) {
			if(players[i].charname == player_name) {
				players[i].pacifico = pacifico_status;
				break;
			}
		}
	}
	else if(parsed[0] == "ininovato") novato = 1;
	else if(parsed[0] == "fimnovato") novato = 0;
	else if(parsed[0] == "seguro") nvaicair = 1;
	else if(parsed[0] == "aveloz") dveloz = 1;
	else if(parsed[0] == "dveloz") dveloz = 0;

	else if(parsed[0] == "chuvaativa") {
		chuvaativa = 1;
		chuva();
	}
	else if(parsed[0] == "fimchuva") {
		chuvaativa = 0;
		chuvatelhado.pause();
	}
	else if(parsed[0] == "volumechuva" && parsed.length() >= 2) {
		chuvalivre.volume = string_to_number(parsed[1]);
		chuvatelhado.volume = string_to_number(parsed[1]);
	}
	else if(parsed[0] == "clima" && parsed.length() >= 4) {
		clima_condicao = parsed[1];
		clima_intensidade = string_to_number(parsed[2]);
		clima_audivel = parsed.length() >= 5 ? string_to_number(parsed[4]) : 1;
		chuvaativa = ((clima_condicao == "chuva" || clima_condicao == "tempestade") && clima_audivel == 1) ? 1 : 0;
		chuva();
		chuvalivre.volume = string_to_number(parsed[3]);
		chuvatelhado.volume = string_to_number(parsed[3]);
	}
	else if(parsed[0] == "addambiente" && parsed.length() >= 6) {
		destroy_all_ambientes();
		spawn_ambiente(string_to_number(parsed[1]), string_to_number(parsed[2]),
		               string_to_number(parsed[3]), string_to_number(parsed[4]), parsed[5], "123");
	}
	else if(parsed[0] == "rsonsmo") {
		destroy_all_msounds();
	}
	else if(parsed[0] == "cm" && parsed.length() >= 6) {
		createmsound(string_to_number(parsed[1]), parsed[2], string_to_number(parsed[3]),
		             string_to_number(parsed[4]), parsed[5]);
	}
	else if(parsed[0] == "destroymsound" && parsed.length() >= 2) {
		destroymsound(string_to_number(parsed[1]));
	}
	else if(parsed[0] == "um" && parsed.length() >= 4) {
		updatemsound(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]));
	}

	else if(parsed[0] == "msg" && parsed.length() > 1) {
		process_msg(full_msg, parsed);
	}
	else if(parsed[0] == "msg2") {
		process_msg2(full_msg, parsed);
	}
	else if(parsed[0] == "msg3") {
		process_msg3(full_msg, parsed);
	}
	else if(parsed[0] == "msg4") {
		process_msg4(full_msg, parsed);
	}
	else if(parsed[0] == "msgnovoleilao" && parsed.length() >= 5) {
		string m = pu.get_value("Novo item a venda por") + " " + parsed[1] + "! " + parsed[2] + " " + pu.get_value(parsed[3]) + ", " + pu.get_value("lance minimo de") + " " + parsed[4] + " reais.";
		add_add_item("leiloes", m);
	}
	else if(parsed[0] == "msgfezaoferta" && parsed.length() >= 3) {
		string m = parsed[1] + " " + pu.get_value("fez a oferta de") + " " + parsed[2] + " reais!";
		add_add_item("leiloes", m);
	}
	else if(parsed[0] == "msgaproximaoferta" && parsed.length() >= 2) {
		string m = pu.get_value("A proxima oferta deve ser de") + " " + parsed[1] + " reais.";
		add_add_item("leiloes", m);
	}
	else if(parsed[0] == "noleilao" && parsed.length() >= 4) {
		string m = pu.get_value("Na venda:") + " " + pu.get_value(parsed[1]) + ", " + pu.get_value("quantidade") + " " + parsed[2] + ", " + pu.get_value("valendo") + " " + parsed[3] + " reais.";
		add_add_item("leiloes", m);
	}
	else if(parsed[0] == "msgnormal") {
		string m = full_msg.replace(parsed[0] + " ", "");
		string ml = m.lower();
		if(ml.find("item a venda") >= 0 || ml.find("leilao") >= 0 || ml.find("oferta") >= 0) {
			add_add_item("leiloes", pu.get_value(m));
		} else {
			add_add_item("avisos", pu.get_value(m));
		}
	}
	else if(parsed[0] == "fm") {
		process_fm(full_msg, parsed);
	}
	else if(parsed[0] == "pm") {
		process_pm(full_msg, parsed);
	}
	else if(parsed[0] == "msgconexoes") {
		process_msgconexoes(full_msg, parsed);
	}
	else if(parsed[0] == "translated") {
		string data = full_msg.replace("translated ", "");
		process_translated_message(data);
	}
	else if(parsed[0] == "enabletranslate") {
		process_enable_translate();
	}
	else if(parsed[0] == "disabletranslate") {
		process_disable_translate();
	}

	else if(full_msg.find("pinfo_data:") == 0) {
		process_pinfo_data(full_msg);
	}

	else if(parsed[0] == "finalhit" && parsed.length() > 3) {
		for(uint i = 0; i < sons.length(); i++) {
			string[] ss = sons[i].split(":");
			if(ss.length() > 1 && ss[1] == parsed[1]) {
				p.play_2d(ss[0], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
				if(parsed.length() > 7) {
					p.play_2d("v" + string_to_number(parsed[8]) + "dor" + random(1, 3) + ".ogg",
					          me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
				}
				break;
			}
		}
	}
	else if(parsed[0] == "impact" && parsed.length() > 3) {
		p.play_2d(parsed[1], me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}
	else if(parsed[0] == "inithurt" && parsed.length() > 3) {
		p.play_2d("v" + string_to_number(parsed[1]) + "quejido" + random(1, 4) + ".ogg",
		          me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
	}

	else if(parsed[0] == "reset_weapons") {
		weapons.resize(0);
	}
	else if(parsed[0] == "create_weapon") {
		string content = full_msg.replace(parsed[0] + " ", "");
		string[] lines = content.split("\r\n");
		for(int x = 0; x < lines.length(); x++) {
			string[] data = lines[x].split(" ");
			if(data.length() < 16) {
				debug_log("Pacote create_weapon inválido (campos insuficientes): " + lines[x]);
				continue;
			}
			if(get_weapon_index(data[10]) < 0) {
				create_weapon(string_to_number(data[0]), string_to_number(data[1]), string_to_number(data[2]),
				              string_to_number(data[3]), string_to_number(data[4]), string_to_number(data[5]),
				              string_to_number(data[6]), data[7], data[8], data[9], data[10], data[11],
				              data[12], data[13], string_to_number(data[14]), data[15]);
			}
		}
	}

	else if(parsed[0] == "dataportal" || parsed[0] == "use_portal") {
		string content = full_msg.replace(parsed[0] + " ", "");
		telemenu(content.split("\r\n"));
	}
	else if(parsed[0] == "servermenu") {
		string content = full_msg.replace(parsed[0] + " ", "");
		string[] data = content.split("|");
		if(data.length() < 5) {
			debug_log("Pacote servermenu inválido: " + content);
		}
		else {
			menuserver(data[0], data[1], string_to_number(data[2]), data[3].split("\r\n"), data[4].split("\r\n"));
		}
	}
	else if(parsed[0] == "mtext") {
		string content = full_msg.replace(parsed[0] + " ", "");
		string[] data = content.split("|");
		if(data.length() > 3) {
			mtext(data[0], data[1], data[2], string_to_number(data[3]));
		}
	}
	else if(parsed[0] == "menutext" && parsed.length() > 1) {
		string content = full_msg.replace(parsed[0] + " ", "");
		textmenu(content.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura2" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul2(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura3" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul3(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura4" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul4(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "menuleitura5" && parsed.length() > 1) {
		string mensagem = full_msg.replace(parsed[0] + " ", "");
		menul5(mensagem.split("\r\n"));
	}
	else if(parsed[0] == "livro_abrir" && parsed.length() > 1) {
		abrir_livro(full_msg.substr(parsed[0].length() + 1));
	}
	else if(parsed[0] == "livro_lista" && parsed.length() > 1) {
		livros_lista_leitura(full_msg.substr(parsed[0].length() + 1));
	}
	else if(parsed[0] == "livro_gerenciar" && parsed.length() > 1) {
		livros_gerenciar(full_msg.substr(parsed[0].length() + 1));
	}
	else if(parsed[0] == "livro_pagina" && parsed.length() > 1) {
		livros_receber_pagina(full_msg.substr(parsed[0].length() + 1));
	}
	else if(parsed[0] == "livro_dados" && parsed.length() > 1) {
		livros_editar(full_msg.substr(parsed[0].length() + 1));
	}

	else if(parsed[0] == "djogador") {
		desenvolvedordm = 1;
		is_dev = true;
		debug_log("Recebido djogador - desenvolvedordm=" + desenvolvedordm + " is_dev=" + is_dev);
		speak("Modo desenvolvedor ativado");
	}
	else if(parsed[0] == "ajogador") {
		is_admin = true;
		debug_log("Recebido ajogador - is_admin=" + is_admin);
		speak("Modo administrador ativado");
	}
	else if(parsed[0] == "mjogador") {
		modera = 1;
		is_moderator = true;
		debug_log("Recebido mjogador - is_moderator=" + is_moderator);
		speak("Modo moderador ativado");
	}
	else if(parsed[0] == "bjogador") {
		construye = 1;
		is_builder = true;
		debug_log("Recebido bjogador - is_builder=" + is_builder);
		speak("Modo construtor ativado");
	}
	else if(parsed[0] == "dmoderador") modera = 1;
	else if(parsed[0] == "dconstructor") construye = 1;
	else if(parsed[0] == "enabletranslate") enabletranslate = 1;
	else if(parsed[0] == "disabletranslate") enabletranslate = 0;
	else if(parsed[0] == "enablechatadm") enablechatadm = 1;
	else if(parsed[0] == "disablechatadm") enablechatadm = 0;
	else if(parsed[0] == "restart") {
		run("C:\\Program Files (x86)\\NVDA\\nvda_slave.exe", "launchNVDA -r", true, true);
	}
	else if(parsed[0] == "update") {
		reset();
		atualizarv();
	}
	else if(parsed[0] == "kill") {
		send_unreliable(peer_id, "close terminate", 0);
		writeprefs();
		wait(200);
		exit();
	}
	else if(parsed[0] == "reiniciar") {
		if(file_exists(get_sound_path("reiniciando.ogg"))) {
			p.play_stationary("reiniciando.ogg", false);
		} else {
			p.play_stationary("notify8.ogg", false);
		}
		speak("Servidor reiniciando. Reconectando...");
		wait(1000);
		reset();
		relogin_flag = true;
	}
	else if(parsed[0] == "chutad") {
		chutad();
	}

	else if(parsed[0] == "set_married_variable" && parsed.length() > 1) {
		married = 1;
	}
	else if(parsed[0] == "set_parabatai_variable" && parsed.length() > 1) {
		parabatyed = 1;
	}
	else if(parsed[0] == "unset_married_variable") {
		married = 0;
	}
	else if(parsed[0] == "unset_parabatai_variable") {
		parabatyed = 0;
	}
	else if(parsed[0] == "setstatus") {
		string m = full_msg.replace(parsed[0] + " ", "");
		for(uint index = 0; index < players.length(); index++) {
			players[index].status = m;
		}
	}
	else if(parsed[0] == "pm" || (parsed[0] == "you" && parsed.length() > 1 && parsed[1] == "reply:")) {
		p.play_stationary("stunstop.ogg", false);
		string mes = full_msg;
		mes = mes.replace("/reply ", "");
		mes = mes.replace("/r ", "");
		mes = mes.replace("pm de", pu.get_value("pm de"));
		mes = mes.replace("pm para", pu.get_value("pm para"));
		add_add_item("conversaciones_privadas", mes);
	}
	else if(parsed[0] == "mensaje") {
		p.play_stationary("notify8.ogg", false);
		string mes = full_msg;
		mes = mes.replace("/reply ", "");
		mes = mes.replace("/r ", "");
		mes = mes.replace("mensaje de", pu.get_value("mensagem de"));
		mes = mes.replace("mensaje para", pu.get_value("mensagem para"));
		add_add_item("conversaciones_privadas", mes);
	}
	else if(parsed[0] == "permanent") {
		string text = full_msg.replace(parsed[0] + " ", "");
		string text2 = text.replace("mensaje permanente no leido de", pu.get_value("mensagem permanente não lida de"));
		add_add_item("conversaciones_privadas", text2);
		if(logpermanents == 1) {
			if(!directory_exists("permanents")) directory_create("permanents");
			string text3 = text2.replace("mensaje permanente no leido de", "mensagem de");
			file f;
			f.open("permanents/permanent_" + DATE_YEAR + "_" + DATE_MONTH + "_" + DATE_DAY + ".log", "a");
			f.write(text3 + "\r\n");
			f.close();
		}
	}
	else if(parsed[0] == "pass_changed") {
		if(temporal_pw != "") {
			pw = temporal_pw;
			net_pw = temporal_pw;
			pwh = hash_password(temporal_pw);
		}
		temporal_pw = "";
		temporal_pwh = "";
		writeprefs();
		dlg(pu.get_value("Senha alterada com sucesso."));
	}
	else if(parsed[0] == "channels" && parsed.length() >= 2) {
		string data = full_msg.replace(parsed[0] + " ", "");
		idiomaschat = data.split("\r\n");
		chatmenu();
	}
	else if(handle_channel0_npc(parsed)) {
		return;
	}
	else {
		if(parsed.length() >= 3 && parsed[0].find(".ogg") >= 0) {
			p.play_2d(parsed[0], me.x, me.y, string_to_number(parsed[1]), string_to_number(parsed[2]), false);
			return;
		}
		add_add_item("avisos", full_msg);
	}
}

#include "net/channel_handlers.nvgt"
