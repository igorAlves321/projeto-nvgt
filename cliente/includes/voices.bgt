int receibed;
voice_messages@[] voices;
class voice_messages
{
string voice_note;
timer live;
int time =60000;
voice_messages (string data)
{
this.voice_note =data;
}
void play_voice()
{
audio.play_stationary(this.voice_note, false, true);
}
}
void add_voice(string content)
{
receibed++;
voice_messages voice1(content);
voices.insert_last(voice1);
}

void remove_voice(int index)
{

voices.remove_at(index);
receibed--;
}

void voicesloop()
{
for(int x=0; x<voices.length(); x++)
{
if(voices[x].live.elapsed>=voices[x].time)
{
remove_voice(x);
}
}
}