timer weapontimer;

// ==================== FUNÇÕES DE DESTRUIÇÃO DE MAPA (Chamadas em mapreset) ====================
// Array global de lojas (stores não são usadas no cliente, gerenciadas via zones)
// Mantido para compatibilidade com código legado
class store_class {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string name;
}
store_class@[] stores;

void destroy_stores() {
	// Limpa o array de lojas
    // No código NVGT atual, lojas são armazenadas como zones
    // Esta função existe para compatibilidade com mapreset()
	stores.resize(0);
}

// Classe source2 - fontes de som secundárias (ambientes, música de fundo)
// Migrada de src2.bgt para NVGT
class source2 {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string sound_file;
	sound@ snd;
	bool active = false;
	int volume = 0;
	
	source2() {
		@snd = sound();
	}
	
	void stop() {
		if(snd.playing) {
			snd.stop();
		}
		active = false;
	}
	
	void destroy() {
		stop();
		@snd = null;
	}
}
source2@[] source2s;

void destroy_all_source2s(bool delete_sounds = true) {
    // Para e destrói todas as source2 (fontes de som secundárias)
	for(uint i = 0; i < source2s.length(); i++) {
		if(source2s[i] !is null) {
			if(delete_sounds) {
				source2s[i].destroy();
			} else {
				source2s[i].stop();
			}
		}
	}
	source2s.resize(0);
}

// ==================== MINIJOGOS ====================
string draw_card_label(int value) {
	if(value == 1) return "A";
	if(value == 11) return "J";
	if(value == 12) return "Q";
	if(value == 13) return "K";
	return "" + value;
}

int draw_blackjack_card() {
	int card = random(1, 13);
	if(card > 10) return 10;
	if(card == 1) return 11;
	return card;
}

int score_farkle_dice(int[] dice) {
	int score = 0;
	int[] counts(7);
	for(uint i = 0; i < dice.length(); i++) {
		if(dice[i] >= 1 && dice[i] <= 6) counts[dice[i]]++;
	}

	for(int face = 1; face <= 6; face++) {
		if(counts[face] >= 3) {
			score += (face == 1) ? 1000 : face * 100;
			counts[face] -= 3;
		}
	}
	score += counts[1] * 100;
	score += counts[5] * 50;
	return score;
}

class game_class {
	string id;

	game_class() {
		id = "";
	}

	game_class(const string&in game_id) {
		id = game_id;
	}

	void jogar() {
		if(ausente || !player_moveable) return;

		if(id == "roleta_animais") {
			string[] animals = {"cachorro", "gato", "lobo", "urso", "rato", "tubarão", "dragonsauro", "macaco"};
			int index = random(0, int(animals.length()) - 1);
			speak(pu.get_value("A roleta gira...") + " " + pu.get_value("Resultado:") + " " + pu.get_value(animals[index]) + ".");
			return;
		}

		if(id == "parouimpar") {
			string choice = input_box(pu.get_value("Par ou ímpar"), pu.get_value("Digite par ou impar."));
			choice = choice.trim_whitespace().lower();
			if(choice != "par" && choice != "impar" && choice != "ímpar") return;

			string number_text = input_box(pu.get_value("Par ou ímpar"), pu.get_value("Digite um número de 0 a 9."));
			int player_number = string_to_number(number_text);
			if(player_number < 0) player_number = 0;
			if(player_number > 9) player_number = 9;

			int house_number = random(0, 9);
			int total = player_number + house_number;
			bool even = (total % 2) == 0;
			bool player_won = (even && choice == "par") || (!even && (choice == "impar" || choice == "ímpar"));
			speak(pu.get_value("Você jogou") + " " + player_number + ". " + pu.get_value("A casa jogou") + " " + house_number + ". " + (player_won ? pu.get_value("Você venceu.") : pu.get_value("Você perdeu.")));
			return;
		}

		if(id == "blackjack") {
			int player_total = draw_blackjack_card() + draw_blackjack_card();
			int dealer_total = draw_blackjack_card() + draw_blackjack_card();
			while(player_total < 17) {
				if(!simple_yes_no(pu.get_value("Você tem") + " " + player_total + ". " + pu.get_value("Comprar outra carta?"))) break;
				player_total += draw_blackjack_card();
			}
			while(dealer_total < 17) {
				dealer_total += draw_blackjack_card();
			}

			string result;
			if(player_total > 21) result = pu.get_value("Você estourou.");
			else if(dealer_total > 21 || player_total > dealer_total) result = pu.get_value("Você venceu.");
			else if(player_total == dealer_total) result = pu.get_value("Empate.");
			else result = pu.get_value("Você perdeu.");
			speak(pu.get_value("Sua pontuação:") + " " + player_total + ". " + pu.get_value("Casa:") + " " + dealer_total + ". " + result);
			return;
		}

		if(id == "poker") {
			string choice = input_box(pu.get_value("Pedra, papel, tesoura"), pu.get_value("Digite pedra, papel ou tesoura."));
			choice = choice.trim_whitespace().lower();
			if(choice != "pedra" && choice != "papel" && choice != "tesoura") return;

			string[] choices = {"pedra", "papel", "tesoura"};
			string house = choices[random(0, 2)];
			bool draw = choice == house;
			bool won = (choice == "pedra" && house == "tesoura") || (choice == "papel" && house == "pedra") || (choice == "tesoura" && house == "papel");
			string result = draw ? pu.get_value("Empate.") : (won ? pu.get_value("Você venceu.") : pu.get_value("Você perdeu."));
			speak(pu.get_value("Você escolheu") + " " + pu.get_value(choice) + ". " + pu.get_value("A casa escolheu") + " " + pu.get_value(house) + ". " + result);
			return;
		}

		if(id == "farkle") {
			int[] dice;
			string roll_text = "";
			for(int i = 0; i < 6; i++) {
				int die = random(1, 6);
				dice.insert_last(die);
				if(roll_text != "") roll_text += ", ";
				roll_text += "" + die;
			}
			int score = score_farkle_dice(dice);
			speak(pu.get_value("Dados:") + " " + roll_text + ". " + pu.get_value("Pontuação:") + " " + score + ".");
			return;
		}

		if(id == "dadosorte") {
			string guess_text = input_box(pu.get_value("Dado da sorte"), pu.get_value("Escolha um número de 1 a 6."));
			int guess = string_to_number(guess_text);
			int die = random(1, 6);
			speak(pu.get_value("O dado caiu em") + " " + die + ". " + (guess == die ? pu.get_value("Você venceu.") : pu.get_value("Você perdeu.")));
			return;
		}
	}
};
game_class roleta_animais("roleta_animais");
game_class parouimpar("parouimpar");
game_class blackjack("blackjack");
game_class poker("poker");
game_class farkle("farkle");
game_class dadosorte("dadosorte");

// ==================== DOWNLOAD ====================
string get_parent_directory_path(string filepath) {
	if(filepath == "") return "";

	int slash_pos = filepath.find_last("/");
	int backslash_pos = filepath.find_last("\\");
	int cut = slash_pos;
	if(backslash_pos > cut) cut = backslash_pos;
	if(cut <= 0) return "";
	return filepath.substr(0, cut);
}

string dl_file(string url, string filename, bool quiet = true) {
	string target_url = url.trim_whitespace();
	string target_file = filename.trim_whitespace();

	if(target_url == "" || target_file == "") {
		return "invalid";
	}

	string parent_dir = get_parent_directory_path(target_file);
	if(parent_dir != "" && !directory_exists(parent_dir)) {
		if(!directory_create(parent_dir)) {
			return "dir_error";
		}
	}

	string data = url_get(target_url);
	if(data == "") {
		return "failed";
	}

	file f;
	if(!f.open(target_file, "wb")) {
		return "file_error";
	}
	f.write(data);
	f.close();

	if(!quiet) speak("Download concluido.");
	return "finished";
}

// ==================== LOJAS ====================
void open_generic_store(string store_type) {
	if(ausente || !player_moveable) return;

	string normalized = store_type.trim_whitespace().lower();
	if(normalized == "") normalized = "mista";

	if(normalized == "armas" || normalized == "explosivos" || normalized == "armasbertalina") {
		explosivos();
		return;
	}

	if(normalized == "lanchonete" || normalized == "bar") {
		barlanchonete();
		return;
	}

	game_net.send(net_peer_id, encrypt_packet("/store"), 0, true);
	speak(pu.get_value("Solicitando itens da loja..."), true);
}

void roupas() {
	open_generic_store("roupas");
}

void armasbertalina() {
	open_generic_store("armas");
}

void pesca() {
	open_generic_store("pesca");
}

void farmacia() {
	open_generic_store("farmacia");
}

void comprareletronicos() {
	open_generic_store("eletronicos");
}

void joalheria() {
	open_generic_store("joalheria");
}

void lanchonete() {
	open_generic_store("lanchonete");
}

// ==================== TELEFONE ====================
class telefone_class {
	string input(string prompt) {
		return input_box("Telefone", prompt);
	}
};
telefone_class tel;

string travel_ticket_menu(const string&in title, const string[]&in destinations, int price) {
	if(!player_moveable) return "";

	setupmenu();
	for(uint i = 0; i < destinations.length(); i++) {
		string label = pu.get_value(destinations[i]) + " - " + price + " " + pu.get_value("reais");
		game_menu.add_item(label, destinations[i]);
	}
	game_menu.add_item(pu.get_value("Voltar"), "back");
	game_menu.intro_text = pu.get_value(title);

	int result = game_menu.run();
	if(result < 0) return "";
	string selected_id = game_menu.get_item_id(result);
	if(selected_id == "back") return "";
	return selected_id;
}

