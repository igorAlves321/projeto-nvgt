// Sistema de zonas convertido para NVGT
class zone {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string text;
	
	zone(int minx, int maxx, int miny, int maxy, string txt) {
		this.min_x = minx;
		this.max_x = maxx;
		this.min_y = miny;
		this.max_y = maxy;
		this.text = txt;
	}
}

zone@[] zones;

string get_zone_at(int x, int y) {
	string outval;
	for(uint i=0; i<zones.length(); i++) {
		if(zones.length() > 0) {
			int minx = zones[i].min_x;
			int maxx = zones[i].max_x;
			int miny = zones[i].min_y;
			int maxy = zones[i].max_y;
			if(minx > x) continue;
			if(minx <= x && maxx >= x && miny <= y && maxy >= y) outval = zones[i].text;
		}
	}
	// Conversão de string_contains para .find()
	if(outval.find("*g*") != -1) outval = outval.replace("*g*", gender);
	if(outval.find("*nick*") != -1) outval = outval.replace("*nick*", un);
	return outval;
}

// get_zone_at function. Receive x, y coordinates and return a zone index.
int get_zone_index(int x, int y) {
	int zoneindex = -1;
	if(zones.length() > 0) {
		for(uint i=0; i<zones.length(); i++) {
			int minx = zones[i].min_x;
			int maxx = zones[i].max_x;
			int miny = zones[i].min_y;
			int maxy = zones[i].max_y;
			if(minx > x) continue;
			if(minx <= x && maxx >= x && miny <= y && maxy >= y) zoneindex = i;
		}
	}
	return zoneindex;
}

// speak_zone function. Speaks the player's current zone based on currentloc index
void speak_zone() {
	string locate;
	if(currentloc > -1 && currentloc < int(zones.length())) {
		locate = zones[currentloc].text;
		
		// Substituir variáveis na descrição da zona
		if(locate.find("*g*") != -1) {
			locate = locate.replace("*g*", gender);
		}
		if(locate.find("*nick*") != -1) {
			locate = locate.replace("*nick*", un);
		}
		
		// Permite mapas com separadores visuais na descrição da zona.
		if(locate.find("|") != -1) {
			locate = translate_with_char(locate, "|");
		}
		speak(pu.get_value(locate), true);
	} else {
		// Zona desconhecida
		speak("Você está em: zona desconhecida de " + mapname, true);
	}
}
