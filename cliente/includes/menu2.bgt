sound_pool click, boing, select, audiostele;
sound background_music;
// integer declarations
int menuposition=0;
int menuvol=100;
joystick stick;
timer sticktimer;
int new_menu(string text, string[] items, int wrap) {
background_music.load("sounds/background.wav");
// reset things
background_music.volume=menuvol;
menuposition=0;
// start the background music
background_music.play_looped();
speak(text);
while(true) {
// Down arrow keystroke
if(key_pressed(KEY_DOWN)) {
menuposition+=1;
if(menuposition==items.length()&&wrap==0) {
menuposition-=1;
boing.play_stationary("boing.ogg", false);
}
else {
click.play_stationary("click.ogg", false);
if(menuposition==items.length()&&wrap==1) {
menuposition=0;
}
}
speak(items[menuposition]);
}

// up arrow keystroke
if(key_pressed(KEY_UP)) {
menuposition-=1;
if(menuposition==-1&&wrap==0) {
menuposition+=1;
boing.play_stationary("boing.ogg", false);
}
else {
click.play_stationary("click.ogg", false);
if(menuposition==-1&&wrap==1) {
menuposition=items.length();
menuposition-=1;
}
}
speak(items[menuposition]);
}
// Joystick usage
if(stick.active==true) {
// use the down motion on a joystick to move down
if(stick.y<-50&&sticktimer.elapsed>1000) {
menuposition+=1;
if(menuposition==items.length()&&wrap==0) {
menuposition-=1;
boing.play_stationary("boing.ogg", false);
}
else {
click.play_stationary("click.ogg", false);
if(menuposition==items.length()&&wrap==1) {
menuposition=0;
}
}
speak(items[menuposition]);
sticktimer.restart();
}
if(stick.y>200&&sticktimer.elapsed>1000) {
menuposition-=1;
if(menuposition==-1&&wrap==0) {
menuposition+=1;
boing.play_stationary("boing.ogg", false);
}
else {
click.play_stationary("click.ogg", false);
if(menuposition==-1&&wrap==1) {
menuposition=items.length();
menuposition-=1;
}
}
speak(items[menuposition]);
sticktimer.restart();
}
}
else {
// just in case you put your joystick in half way through
string[] stick_list=stick.list_joysticks();
if(stick_list.length()>0) {
stick.set(0);
}
}
// Select the current item with a keyboard
if(key_pressed(KEY_RETURN)) {
select.play_stationary("select.ogg", false);
background_music.stop();
return menuposition+1;
}
// Select the current item by pressing button 1 of a joystick
if(stick.active==true) {
if(stick.button_pressed(1)) {
select.play_stationary("select.ogg", false);
background_music.stop();
return menuposition+1;
}
}
// allow the user to raise and lower the background volume with u and j
if(key_pressed(KEY_U)) {
background_music.volume=background_music.volume+10;
menuvol=background_music.volume;
}
if(key_pressed(KEY_D)) {
background_music.volume=background_music.volume-10;
menuvol=background_music.volume;
}
// allow for the user to repeat the intro message
if(key_pressed(KEY_R)) {
speak(text);
}
if(stick.active==true) {
if(stick.button_pressed(2)) {
speak(text);
}
}
// allow home and end
if(key_pressed(KEY_HOME)) {
menuposition=0;
click.play_stationary("click.ogg", false);
speak(items[menuposition]);
}
if(key_pressed(KEY_END)) {
menuposition=items.length();
menuposition-=1;
click.play_stationary("click.ogg", false);
speak(items[menuposition]);
}
// add a small pause just to not break the memory and all that
wait(10);
}
return 1;
}
