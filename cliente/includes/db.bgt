/* db module, version 1.0.
Written by Andrés Torres.
This class provides the same functionality as the bgt dictionaries, but without hash maps. Designed to handle low amounts of information, it has the advantage of preserving the order of the inserted elements, as well as the sort () function, which allows them to be reordered. */

class db {
	private string[] keys; // Saves the keys used to search in the database.
	private string [] values; // Saves the values related to each key in the database.
// Constructor. Make a call to the reset function, in case there is a trace of information
	db() {
		reset();
	}

// reset method. Clean the content of keys and values, using the array's resize method.
	void reset() {
		keys.resize(0);
		values.resize(0);
	}

// delete method. Delete a key and a value if it found them. Return true if the condition is met, false otherwise
	bool delete(string key) {
		int index =get_index_key_from(key);
		if(index>-1) {
			keys.remove_at(index);
			values.remove_at(index);
			return true;
		}
		return false;
	}

// delete_all method. Delete all existing information in the database, if you have it.
	bool delete_all() {
		if(!is_empty()) {
			reset();
			return true;
		}
		return false;
	}

// exists method. Returns true if the requested key is found, Return false otherwise.
	bool exists(string key) {
		int encontered =keys.find(key);
		if(encontered>-1) {
			return true;
		}
		return false;
	}

// is_emtpy method. Returns true if the database is empty, return false otherwise.
	bool is_empty() {
		if(keys.length()==0 && values.length()==0) {
			return true;
		}
		return false;
	}


// get method. Receive a key and write the output value to a variable of type numeric, as appropriate. Returns true if it finds the requested key, false otherwise
	bool get(string keyname, double &out keyvalue) {
			int encontered =get_index_key_from(keyname);
		if(encontered>-1) {
			keyvalue =string_to_number(values[encontered]);
			return true;
		}
		return false;
	}

// get method. Receive a key and write the output value to a variable of type string, as appropriate. Returns true if it finds the requested key, false otherwise.
	bool get(string key, string &out value) {
		int encontered =get_index_key_from(key);
		if(encontered>-1) {
			value =values[encontered];
			return true;
		}
		return false;
	}

// get_index_key_from method. Returns an index if it finds the requested key, returns -1 otherwise.
	private int get_index_key_from(string key) {
		int index =keys.find(key);
		if(index>-1) {
			return index;
		}
		return -1;
	}

// get_size method. returns the size of the database (> 0) if there is data, returns 0 otherwise.
	int get_size() {
		if(!is_empty()) {
			return keys.length();
		}
		return 0;
	}

// get_keys method. Returns an array with all the keys in the database, or an empty array otherwise.
	string[] get_keys() {
		string[] empty;
		if(!is_empty()) {
			return keys;
		}
		return empty;
	}

// sort method. Receive a key and a positive or negative integer, and move the database items if found. Use a positive number to move up, and a negative number to move down. Useful for ordering inventories in a game, for example. Returns true if it is possible to sort the elements, false otherwise.
	bool sort(string key, int range) {
		int index=get_index_key_from(key);
		int newposition;
		string key_old;
		string value_old;
		if(index>-1) {
			key_old =keys[index];
			value_old =values[index];
			newposition =index+range;
			if(newposition>=0 && newposition<keys.length()) {
				keys.remove_at(index);
				values.remove_at(index);
				keys.insert_at(newposition, key_old);
				values.insert_at(newposition, value_old);
				return true;
			}
		}
		return false;
	}

// set method. Receive a key and a numeric value as value. If it exists, the current value is replaced by the new one, otherwise a new key is added.
	void set(string key, double value) {
		int encontered =keys.find(key);
		if(encontered>-1) {
			values[encontered] =value;
			return;
		}
		else {
			keys.insert_last(key);
			values.insert_last(value);
		}
	}

// set method. Receive a key and a string value as value. If it exists, the current value is replaced by the new one, otherwise a new key is added.
	void set(string keyname, string keyvalue) {
		int encontered =keys.find(keyname);
		if(encontered>-1) {
			values[encontered] =keyvalue;
			return;
		}
		else {
			keys.insert_last(keyname);
			values.insert_last(keyvalue);
		}
	}
} // end class
