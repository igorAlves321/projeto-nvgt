void saveaudio(string content){
if(!directory_exists("audios"))directory_create("audios");
file f;
f.open("audios/audio_"+DATE_WEEKDAY_NAME+"_"+DATE_MONTH_NAME+"_"+DATE_YEAR+"_"+TIME_HOUR+"-"+TIME_MINUTE+"-"+TIME_SECOND+".wav", "wb");
f.write(content);
f.close();
}
bool directory_copy(string name, string name2, bool replace){
if(directory_exists(name)==false){
return false;
}
else{
if(directory_exists(name2)==false)directory_create(name2);
string[] f=find_files(name+"/*");
for(uint i=0; i<f.length(); i++){
file_copy(name+"/"+f[i], name2+"/"+f[i], replace);
}
return true;
}
}
bool is_pressed_application_keys(){
	if(key_down(KEY_LSHIFT)&&key_pressed(KEY_F10)||key_down(KEY_RSHIFT)&&key_pressed(KEY_F10)){
		return true;
	}
	return false;
}
bool shift_pressionado(){
	if(key_down(KEY_RSHIFT)||key_down(KEY_LSHIFT))return true;
	return false;
}
bool alt_presionado(){
if(key_down(KEY_LMENU)){
return true;
}
return false;
}

void playersmenu(string data) {
	if(data=="" || ausente)return;
	reset_all_forced_keys();
	key_hold iup(KEY_UP,500,50);
	key_hold idown(KEY_DOWN,500,50);
	get_characters();
	string cl;
	int counter=-1;
	string[] lines =string_split(data, bell2, true), names, titles, status;
	if(lines.length()>0) {
		for(int i=0; i<lines.length(); i++) {
			string[] parsed =string_split(lines[i], bell, true);
			if(parsed.length()==3) {
				names.insert_last(parsed[0]);
				titles.insert_last(parsed[1]);
				status.insert_last(parsed[2]);
			}
		}	}
	p.play_stationary("notify37.ogg", false);
	speak(pu.get_value("Mostrando lista de jogadores."));
	emchat=true;
	while(true){
		wait(5);
		mainloop();
		if(ausente)break;
		if(counter > names.length()-1)counter=names.length()-1;
		cl=get_characters();
		if(cl!=""&&cl!=" "&&cl.length()==1&&names.length()>0){
			int f=0;
			int oc=counter;
			for(uint i=counter; i<names.length(); i++){
				if(i==counter){
					continue;
				}
				if(string_to_lower_case(names[i][0])==cl||string_to_upper_case(names[i][0])==cl){
					counter=i;
					speak(names[counter]+" ("+pu.get_value(titles[counter])+"): "+status[counter]);
					p.play_stationary("invmove6.ogg", false);
					cl="";
					f=1;
					break;
				}
			}
			if(f==0){
				counter=0;
				for(uint i=counter; i<names.length(); i++){
					if(string_to_lower_case(names[i][0])==cl||string_to_upper_case(names[i][0])==cl){
						counter=i;
						speak(names[counter]+" ("+pu.get_value(titles[counter])+"): "+status[counter]);
						p.play_stationary("invmove6.ogg", false);
						cl="";
						f=1;
						break;
					}
				}
			}
		}
		if(shift_pressionado()&&names.length()>0){
			if(key_pressed(KEY_F1)&&voicechat==1){
				recording(names[counter]);
			}
		}
		if(key_pressed(KEY_HOME)&&names.length()>0){
			counter=0;
			speak(names[counter]+" ("+pu.get_value(titles[counter])+"): "+status[counter]);
			p.play_stationary("invmove6.ogg", false);
		}
		if(key_pressed(KEY_END) and names.length()>0){
			counter=names.length()-1;
			speak(names[counter]+" ("+pu.get_value(titles[counter])+"): "+status[counter]);
			p.play_stationary("invmove6.ogg", false);
		}
		if(iup.pressing()){
			if(names.length==1){
				speak(names[0]+" ("+pu.get_value(titles[0])+"): "+status[0]);
				counter=0;
			}
			else if(counter > 0){
				counter--;
				speak(names[counter]+" ("+pu.get_value(titles[counter])+"): "+status[counter]);
				p.play_stationary("invmove6.ogg", false);
			}
		}
		if(idown.pressing()){
			if(names.length==1){
				speak(names[0]+" ("+pu.get_value(titles[0])+"): "+status[0]);
				counter=0;
			}
			else if(counter < names.length()-1){
				counter++;
				speak(names[counter]+" ("+pu.get_value(titles[counter])+"): "+status[counter]);
				p.play_stationary("invmove6.ogg", false);
			}
		}
		if(key_pressed(KEY_RETURN)||key_pressed(KEY_NUMPADENTER)){
			if(counter>-1 && counter<names.length()) {
				p.play_stationary("-old-menuchecked.ogg", false);
				string msg=v.input(pu.get_value("Digite sua mensagem para")+" "+names[counter]);
				if(msg!="")send_reliable(peer_id, "/pm "+names[counter]+" "+msg, 1);
				emchat=true;
			}
		}
		if(key_down(KEY_LMENU)) {
			if(key_pressed(KEY_I) && counter>-1) send_reliable(peer_id, "/ign "+names[counter], 1);
			if(key_pressed(KEY_U) && counter>-1) send_reliable(peer_id, "/deign "+names[counter], 1);
			if(key_pressed(KEY_E) && counter>-1) send_reliable(peer_id, "/eqr "+names[counter], 1);
			if(key_pressed(KEY_D) && counter>-1) send_reliable(peer_id, "/dqr "+names[counter], 1);
			if(key_pressed(KEY_S) && counter>-1) send_reliable(peer_id, "/eqs "+names[counter], 1);
		}
		if(key_pressed(KEY_F1) && counter>-1)send_unreliable(peer_id, "j1 "+names[counter], 0);
		if(key_pressed(KEY_F2) && counter>-1)send_unreliable(peer_id, "j2 "+names[counter], 0);
		if(key_pressed(KEY_F3) && counter>-1)send_unreliable(peer_id, "j3 "+names[counter], 0);
		if(key_pressed(KEY_F4) && counter>-1)send_unreliable(peer_id, "j4 "+names[counter], 0);
		if(key_pressed(KEY_F5) && counter>-1){
			send_reliable(event.peer_id, "/wm2 "+names[counter], 1);
		}
		if(key_pressed(KEY_F6) && counter>-1){
			send_reliable(event.peer_id, "/wp "+names[counter], 1);
		}
		if(key_down(KEY_LCONTROL)||key_down(KEY_RCONTROL)){
			if(key_pressed(KEY_C) && counter>-1){
				clipboard_copy_text(names[counter]);
				speak(names[counter]+" "+pu.get_value("copiado."));
			}
			if(desenvolvedordm==1){
				if(key_pressed(KEY_Z) && counter>-1){
					nolhar=names[counter];
					send_unreliable(peer_id, "olhar "+nolhar, 0);
				}
			}
		}
		if(key_pressed(KEY_ESCAPE)){
			emchat=false;
			return;
		}
	}
}

void readprefs(){
	string content;
	string[] peramitors;
	string[] values;
	if(!portable) {
		pf.open(prefsdir+"/"+PREFSFILE, "rb");
	}
	else {
		pf.open(PREFSFILE,"rb");
	}
	content=string_decrypt(pf.read(),PREFS_ENCRYPTION_KEY);
	pf.close();
	if(content !="") {
		peramitors=string_split(content, "\r\n", true);
	}
	else {
		alert("Info", pu.get_value("No se ha podido leer el archivo de configuraciï¿½n. Al pulsar enter se generarï¿½ una configuraciï¿½n nueva."));
		writeprefs();
		readprefs();
	}
	for(uint i=0; i<peramitors.length(); i++){
		values.insert_at(i,string_replace(peramitors[i], string_left(peramitors[i], string_contains(peramitors[i], "=", 1)+1), "", true));
		peramitors[i]=string_replace(peramitors[i], "="+values[i], "", true);
	}
	if(peramitors.find("mlang")!=-1){
		mainlang=values[peramitors.find("mlang")];
	}
	if(peramitors.find("limit_rate")!=-1){
		limit_rate=values[peramitors.find("limit_rate")];
	}
	if(peramitors.find("ouvirhits")!=-1){
		ouvirhits=string_to_number(values[peramitors.find("ouvirhits")]);
	}
	if(peramitors.find("ouviremoutrasjanelas")!=-1){
		ouviremoutrasjanelas=string_to_number(values[peramitors.find("ouviremoutrasjanelas")]);
	}
	if(peramitors.find("voicechat")!=-1){
		voicechat=string_to_number(values[peramitors.find("voicechat")]);
	}
	if(peramitors.find("logaudio")!=-1){
		logaudio=string_to_number(values[peramitors.find("logaudio")]);
	}
	if(peramitors.find("logpermanents")!=-1){
		logpermanents=string_to_number(values[peramitors.find("logpermanents")]);
	}
	if(peramitors.find("logs")!=-1){
		logs=string_to_number(values[peramitors.find("logs")]);
	}
	if(peramitors.find("volumen2")!=-1){
		volumen2=string_to_number(values[peramitors.find("volumen2")]);
	}
	if(peramitors.find("volumesources")!=-1){
		volumesources=string_to_number(values[peramitors.find("volumesources")]);
	}
	if(peramitors.find("autologin")!=-1){
		autologin=string_to_number(values[peramitors.find("autologin")]);
	}
	if(peramitors.find("volumen")!=-1){
		volumen=string_to_number(values[peramitors.find("volumen")]);
	}
	if(peramitors.find("sidescrolling")!=-1){
		sidescrolling=string_to_number(values[peramitors.find("sidescrolling")]);
	}
	if(peramitors.find("musicamenu")!=-1){
		musicamenu=string_to_number(values[peramitors.find("musicamenu")]);
	}
	if(peramitors.find("idiomaorigem")!=-1){
		idiomaorigem=values[peramitors.find("idiomaorigem")];
	}
	if(peramitors.find("tradutorativo")!=-1){
		tradutorativo=string_to_number(values[peramitors.find("tradutorativo")]);
	}
	if(peramitors.find("primeiravez")!=-1){
		primeiravez=string_to_number(values[peramitors.find("primeiravez")]);
	}
	if(peramitors.find("cmfinal")!=-1){
		cmfinal=values[peramitors.find("cmfinal")];
	}
	if(peramitors.find("idiomachat")!=-1){
		idiomachat=values[peramitors.find("idiomachat")];
	}
	if(peramitors.find("idiomajogo")!=-1){
		idiomajogo=values[peramitors.find("idiomajogo")];
	}
	if(peramitors.find("msg")!=-1){
		msg=values[peramitors.find("msg")];
	}
	if(peramitors.find("atu")!=-1)atu=string_to_number(values[peramitors.find("atu")]);
	if(peramitors.find("rcontrol")!=-1)rcontrol=string_to_number(values[peramitors.find("rcontrol")]);
	if(peramitors.find("ouvirmortes")!=-1)ouvirmortes=string_to_number(values[peramitors.find("ouvirmortes")]);
	if(peramitors.find("un")!=-1){
