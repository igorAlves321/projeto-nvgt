void madness_cinematic(){
string[] content;
int harm=0, counter=-1;
sound_pool music;
timer self_harming, conversation_time;
music.play_stationary_extended("200cancion.ogg", true, 0, 0, 0, 80);
self_harming.force(0);
self_harming.pause();
string conversation="no...\r\nya no puedo mï¿½s.\r\ntodo esto se me ha ido de las manos... realmente estoy arrepentid*g*...\r\noh, no. tï¿½ no sientes arrepentimiento.=playersafe.ogg\r\ntienes una mentalidad tan enferma, que a pesar de que estï¿½s sufriendo todas estas represalias por tus actos, no dejarï¿½s de hacerlo. continuarï¿½s, y continuarï¿½s, y continuarï¿½s hasta derramar la ï¿½ltima gota de sangre, hasta agotar cualquier porcentaje de energï¿½a elemental ajena. no eres mï¿½s que una escoria, un estorbo, alguien innecesario.\r\nï¿½me escuchaste? eres alguien innecesario. no deberï¿½as de existir. deberï¿½as morir. deberï¿½as morir. deberï¿½as morir.\r\nno, no, no... no puedo mï¿½s con esto, es mï¿½s de lo que puedo soportar...=playerunsafe.ogg\r\nï¿½dï¿½jame! ï¿½solo quiero estar en paz!\r\nde pronto, un cuchillo afilado aparece en tu mano y una voz te susurra algo en el subconsciente: ï¿½salo. acaba con esto de una vez. podrï¿½s estar en paz.";
content=delinear(conversation);
while(counter<content.length()-1){
wait(5);
mainloop();
if(conversation_time.elapsed>=3000){
conversation_time.restart();
counter++;
content[counter]=string_replace(content[counter], "*g*", gender, true);
content[counter]=string_replace(content[counter], "*nick*", un, true);
string[] data=string_split(content[counter], "=", false);
if(data.length()>1) p.play_stationary(data[1], false);
else p.play_stationary("door17open.ogg", false);
add_add_item("avisos", pu.get_value(data[0]));
}
}
self_harming.restart();
while(harm<=5){
wait(5);
mainloop();
if(self_harming.elapsed>2000){
self_harming.restart();
harm++;
if(harm==1) music.destroy_all();
p.play_stationary("faca"+random(1, 3)+".ogg", false);
}
}
dialog2(pu.get_value("lo que alguna vez fue tu cuerpo ahora no es mï¿½s que un cadï¿½ver con cortadas profundas por todos lados, como si aparte de tu suicidio algï¿½n ente mï¿½s hubiera venido a acabar con tu vida. algunos ï¿½rganos son visibles y se notan sanguinolentos en exceso tal y como lo estï¿½n tus ojos, los cuï¿½les cuelgan de sus ï¿½rbitas cortados por la mitad."));
wait(200);
exitgame();
}
string get_sound(string tittle, string filter="", bool first_letter=false, bool enable_select=false){
int slot=-1;
string[] list, selecteds, checksounds;
pack_file pa;
pa.open(SOUND_STORAGE);
checksounds=pa.list_files();
if(filter!=""){
for(int x=0; x<checksounds.length(); x++){
if(first_letter==true&&checksounds[x][0]==filter[0]){
list.insert_last(checksounds[x]);
}
else if(first_letter==false&&string_contains(checksounds[x], filter, 1)>-1){
list.insert_last(checksounds[x]);
}
}
}
else{
list=pa.list_files();
}
pa.close();
int selected=0;
reset_all_forced_keys();
key_hold iup(KEY_UP,500,50);
key_hold idown(KEY_DOWN,500,50);
key_hold ileft(KEY_LEFT,500,50);
key_hold iright(KEY_RIGHT,500,50);
key_hold inext(KEY_NEXT,500,50);
key_hold iprior(KEY_PRIOR,500,50);
string cl;
speak(tittle);
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE)){
return "";
}
if(iup.pressing() && selected>0){
selected--;
p.destroy_sound(slot);
speak(list[selected]);
slot=p.play_stationary(list[selected], false);
}
if(idown.pressing() && selected<list.length()-1){
selected++;
p.destroy_sound(slot);
slot=p.play_stationary(list[selected], false);
speak(list[selected]);
}
if(iprior.pressing() && selected>10){
selected-=10;
p.destroy_sound(slot);
speak(list[selected]);
slot=p.play_stationary(list[selected], false);
}
if(inext.pressing() && selected<list.length()-10){
selected+=10;
p.destroy_sound(slot);
slot=p.play_stationary(list[selected], false);
speak(list[selected]);
}
if(ileft.pressing() && selected>50){
selected-=50;
p.destroy_sound(slot);
speak(list[selected]);
slot=p.play_stationary(list[selected], false);
}
if(iright.pressing() && selected<list.length()-50){
selected+=50;
p.destroy_sound(slot);
slot=p.play_stationary(list[selected], false);
speak(list[selected]);
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and list.length()>0){
int f=0;
int oc=selected;
for(uint i=selected; i<list.length(); i++){
if(i==selected){
continue;
}
if(list[i][0]==cl){
selected=i;
string msg=list[selected];
speak(pu.get_value(msg));
p.destroy_sound(slot);
slot=p.play_stationary(list[selected], false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
if(f==0){
selected=0;
for(uint i=selected; i<list.length(); i++){
if(list[i][0]==cl){
selected=i;
string msg=list[selected];
speak(pu.get_value(msg));
p.destroy_sound(slot);
slot=p.play_stationary(list[selected], false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
}
}
if(key_pressed(KEY_RETURN)){
p.destroy_sound(slot);
if(enable_select==false){
return list[selected];
}
else if(enable_select){
string final;
for(int x=0; x<selecteds.length(); x++){
final+=selecteds[x]+",";
}
return final;
}
}
if(shift_pressionado()==false&&key_pressed(KEY_SPACE)){
p.destroy_sound(slot);
slot=p.play_stationary(list[selected], false);
speak(list[selected]);
}
else if(enable_select==true&&shift_pressionado()&&key_pressed(KEY_SPACE)){
if(selecteds.find(list[selected])>-1){
selecteds.remove_at(selecteds.find(list[selected]));
speak(list[selected]+" "+pu.get_value("no seleccionado."));
}
else if(selecteds.find(list[selected])<0){
selecteds.insert_last(list[selected]);
speak(list[selected]+" "+pu.get_value("seleccionado."));
}
}
}
return "";
}
bool add_select(string[] items, int length, string item){
	if(items.length()>=length){
		return false;
	}
	else if(items.find(item)>-1){
		return false;
	}
	else{
		items.insert_last(item);
		return true;
	}
}
bool remove_select(string[] items, string item){
	int find=items.find(item);
	if(find<0){
		return false;
	}
	else{
		items.remove_at(find);
		return true;
	}
}
bool is_selected(string[] items_array, string item){
	int find=items_array.find(item);
	if(find>-1){
		return true;
	}
	return false;
}
int q_pro(string tittle){
setupmenu2();
m.add_item_tts(pu.get_value("sï¿½."), "si");
m.add_item_tts(pu.get_value("no."), "no");
int mres=m.run(tittle, true);
if(mres==0)return 0;
if(m.get_item_name(mres)=="si"){
return 1;
}
else if(m.get_item_name(mres)=="no"){
return 2;
}
return -1;
}
void recording(string player_destination){
