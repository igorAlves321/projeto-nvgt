}
else{
add_add_item("avisos", pu.get_value("Actualmente las coordenadas estï¿½n activadas."));
}
}
		else if(key_pressed(KEY_EQUALS)&&!ausente){
			string colocar=v.input("Entre com um comando.");
			if(colocar!="")send_reliable(peer_id, "/"+colocar, 1);
		}
		else if (key_pressed(KEY_LBRACKET)&&!ausente)addleft();
		else if(key_pressed(KEY_RBRACKET)&&!ausente)addright();
		else if(key_pressed(KEY_COMMA)&&!ausente)prevadditem();
		else if(key_pressed(KEY_PERIOD)&&!ausente)nextadditem();
		else if (key_pressed(KEY_BACKSLASH)&&!ausente){
			string colocar=v.input("Digite sua mensagem.");
			if(colocar!="") send_reliable(peer_id,"/falarnomapa "+colocar, 0);
		}
		else if(key_pressed(KEY_SLASH)&&!ausente){
			string colocar=v.input("Digite sua mensagem.");
			if(colocar!=""){
				if(string_contains(colocar, "::", 1)>-1&&desenvolvedordm==1){
					string[] z=string_split(colocar, "::", false);
					for(uint i=0;i<z.length();i++){
						send_reliable(peer_id, z[i], 1);
					}
					return;
				}
				string enviar=colocar;
				if(tradutorativo==1){
					enviar=colocar;
				}
				if(enviar!="")send_reliable(peer_id, enviar, 1);
			}
		}
	}
//if(fail.exists(weapons[selected].name))return;
}
