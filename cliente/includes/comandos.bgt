void tprincipais(){
	safeloop();
if(alt_presionado()&&ausente==false){
if(key_pressed(KEY_S)&&adds[addpos].currently_buffer=="conversaciones_privadas"){
string final;
if(adds[addpos].items.length()>9){
for(uint i=0; i<adds[addpos].items.length(); i++){
if(adds[addpos].items[i]==adds[addpos].items[adds[addpos].pos]){
final+=adds[addpos].items[i]+"\r\n";
}
}
string[] parsed=string_split(final, "\r\n", false);
if(parsed.length()>9){
string adicional=v.input(pu.get_value("si tiene algo mï¿½s que decir en su reporte, escrï¿½balo."));
send_reliable(event.peer_id, "report "+adicional+"\r\ncantidad de mensajes recibidos: "+parsed.length()+". el mensaje que es repetido de manera molesta es: "+parsed[0], 0);
}
}
}
if(key_pressed(KEY_F11)){
audio.play_stationary(vc, false, true);
}
if(key_pressed(KEY_F2)){
reportmenu();
}
	if(key_pressed(KEY_F1)){
		string name=v.input(pu.get_value("escriba el nombre de la cuenta que quiera conectar."));
		string password=v.input(pu.get_value("escriba la contraseï¿½a."));
		if(name!=""&&password!=""){
			un=name;
			pwh =string_hash(password, 2, false);
			writeprefs();
			set_window();
			send_reliable(peer_id, "close relogin", 0);
			reset();
			relogin =true;
		}
	}
}
	if(shift_pressionado()){
		if(key_pressed(KEY_N)) {
string mpar=v.input(pu.get_value("escribe el mensaje que enviarï¿½s a tu pareja."));
if(mpar!="") send_reliable(peer_id, "message_to_couple "+mpar, 0);
}
		if(key_pressed(KEY_H)) {
string mpar=v.input(pu.get_value("escribe el mensaje que enviarï¿½s a tu parabatai."));
if(mpar!="") send_reliable(peer_id, "message_to_parabatai "+mpar, 0);
}
		if(key_pressed(KEY_F1))send_unreliable(peer_id, "/afk", 0)	;
if(ausente==false){
if(key_pressed(KEY_F2))send_unreliable(peer_id, "/pacifista", 0);		else if(key_pressed(KEY_F3)){
			if(ouviremoutrasjanelas==1){
				speak(pu.get_value("Não anunciando mensagens quando estiver em outras janelas."));
				ouviremoutrasjanelas=0;
			}
			else if(ouviremoutrasjanelas==0){
				speak(pu.get_value("Ouvindo mensagens em outras janelas."));
				ouviremoutrasjanelas=1;
			}
			writeprefs();
		}
		else if(key_pressed(KEY_SLASH))send_unreliable(peer_id, "whoonline", 0);
		else if (key_pressed(KEY_RBRACKET)&&!ausente)lastadd();
		else if (key_pressed(KEY_LBRACKET)&&!ausente)firstadd();
		else if (key_pressed(KEY_COMMA))topadditem();
		else if (key_pressed(KEY_PERIOD))bottomadditem();
else if(key_pressed(KEY_V))send_unreliable(peer_id, "reencarn", 0);
		else if(key_pressed(KEY_F5)){
			if(tvolume.elapsed>=250){
				tvolume.restart();
				volumejogo=volumejogo+10;
				if(volumejogo>0)volumejogo=0;
				set_sound_master_volume(volumejogo);
				mudo=false;
			}
		}
		else if(key_pressed(KEY_F4)&&mapname!="prisï¿½o2"){
			if(tvolume.elapsed>=250){
				tvolume.restart();
				volumejogo=volumejogo-10;
				if(volumejogo<-100)volumejogo=-100;
				set_sound_master_volume(volumejogo);
				mudo=false;
			}
		}
		if(key_pressed(KEY_F6)){
			if(mudo){
				set_sound_master_volume(0);
				add_add_item("avisos", pu.get_value("Som ativado."));
				mudo=false;
			}
			else if(!mudo){
				set_sound_master_volume(-100);
				add_add_item("avisos", pu.get_value("Som desativado."));
				mudo=true;
			}
		}
if(key_pressed(KEY_A)){
audiosmenu();
}
if(key_pressed(KEY_H)&&voicechat==1) grabar_mapa();
if(key_pressed(KEY_P)&&inmenu==false){
permanentsmenu();
}
}
	}
	else{
if(key_pressed(KEY_F11)){
audio.destroy_all();
}
	if (key_pressed(KEY_F1)&&spamtimer.elapsed>=spamtime&&voicechat==1&&ausente==false){
if (recording==false){
spamtimer.restart();
r.record();
p.play_stationary("radioon.ogg",false);
recording=true;
rectimer.restart();
}
else if (recording==true){
p.play_stationary("radiooff.ogg",false);
r.stop(true,DIRECTORY_TEMP+"\\convert.ogg");
file f;
f.open(DIRECTORY_TEMP+"\\convert.ogg","rb");
if (rectimer.elapsed>=1000)
send_unreliable(peer_id,"team_audio "+f.read(),7);
f.close();
recording=false;
spamtimer.restart();
}
}
if (recording==true and rectimer.elapsed>=rectime){
p.play_stationary("radiooff.ogg",false);
r.stop(true,DIRECTORY_TEMP+"\\convert.ogg");
file f;
f.open(DIRECTORY_TEMP+"\\convert.ogg","rb");
send_unreliable(0, "team_audio "+f.read(),7);
f.close();
recording=false;
spamtimer.restart();
}
if (key_released(KEY_F1)&&recording==true&&voicechat==1&&ausente==false){
p.play_stationary("radiooff.ogg",false);
r.stop(true,DIRECTORY_TEMP+"\\convert.ogg");
file f;
f.open(DIRECTORY_TEMP+"\\convert.ogg","rb");
if (rectimer.elapsed>=1000)
send_unreliable(0,"team_audio "+f.read(),7);
f.close();
recording=false;
spamtimer.restart();
}
		else if(key_pressed(KEY_F2)&&!ausente&&forcepinging==false){
			forcepinging=true;
			p.play_stationary("pingstart.ogg",false);
			ping=true;
			send_reliable(peer_id,"ping",pingchannel);
			pingtimer.restart();
		}
		else if(key_pressed(KEY_F4)&&mapname!="portal_espiritual"&&is_disabled(me.x, me.y)==false){
			if(playertrack==""){
