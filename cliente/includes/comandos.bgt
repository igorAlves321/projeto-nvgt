void setupmenu(bool music=true){
	m.reset(true);
	if(music==true){
		m.add_music("rock"+random(1, 4)+".ogg");
	}
	m.enable_numbers=true;
	m.enable_first_letter_navigation=true;
	m.click_sound="menuopcion.ogg";
	m.enter_sound="menuenter3.ogg";
	m.repeat_items_at_edges=false;
	m.edge_sound="menuenter1.ogg";
	if(sidescrolling==1){
		m.enable_side_scrolling=true;
		m.enable_left_and_right=true;
	}
	else {
		m.enable_up_and_down=true;
		m.enable_side_scrolling=false;
	}
	m.enable_enter=true;
	m.allow_escape=true;
	m.wrap=false;
	m.enable_home_and_end=true;
	m.tab=false;
	m.set_callback(clb,"");
}

