void writeprefs() {
	if(!portable)pf.open(prefsdir+"/"+PREFSFILE, "wb");
	else pf.open(PREFSFILE,"wb");
	string fw;
	string values;
	string[] fw_keys =favorite_weapons.get_keys();
	if(fw_keys.length()>0) {
		for(int i=0; i<fw_keys.length(); i++) {
			favorite_weapons.get(fw_keys[i], values);
			fw +=fw_keys[i]+"="+values+"\r\n";
		}
	}
	string s;
	s=
"mlang="+mainlang+"
tradutorativo="+tradutorativo+"
idiomaorigem="+idiomaorigem+"
idiomachat="+idiomachat+"
idiomajogo="+idiomajogo+"
msg="+msg+"
atu="+atu+"
ouvirmortes="+ouvirmortes+"
rcontrol="+rcontrol+"
un="+un+"
pwh="+pwh+"
voice="+voice+"
volumejogo="+volumejogo+"
ttsrate="+ttsrate+"
cmfinal="+cmfinal+"
avisadesconectou="+avisadesconectou+"
ouvirhits="+ouvirhits+"
primeiravez="+primeiravez+"
device_number="+device_number+"
usalogo="+usalogo+"
atualizar="+atualizar+"
ouviremoutrasjanelas="+ouviremoutrasjanelas+"
voicechat="+voicechat+"
logaudio="+logaudio+"
logpermanents="+logpermanents+"
logs="+logs+"
autologin="+autologin+"
volumen="+volumen+"
volumen2="+volumen2+"
volumesources="+volumesources+"
sidescrolling="+sidescrolling+"
musicamenu="+musicamenu+"
beaconing="+beaconing+"
wineask="+wineask+"
interrupt="+interrupt+"
falarteclas="+falarteclas+"
escucharteclas="+escucharteclas+"
asktoexit="+asktoexit+"
avisanivel="+avisanivel+"
limit_rate="+limit_rate+"
"+fw;
	s=string_encrypt(s,PREFS_ENCRYPTION_KEY);
	pf.write(s);
	pf.close();
}
