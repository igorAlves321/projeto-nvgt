			}
			else{
				playertrack="";
				speak(pu.get_value("Nï¿½o rastreando."));
			}
		}
		else if(key_pressed(KEY_F5)){
			send_reliable(peer_id, "getplayers", 0);
		}
		else if(key_pressed(KEY_F6)&&!ausente) {
		if(idiomaschat.length()>0) chatmenu();
		else send_reliable(peer_id, "get_channels", 0);
	}
if(key_pressed(KEY_F7)&&ausente==false&&desenvolvedordm==1)adminmenu();
		if(key_pressed(KEY_F8)&&desenvolvedordm==1&&!ausente)send_unreliable(peer_id, "getmotd2", 0);
if(key_pressed(KEY_F9)&&desenvolvedordm==1&&ausente==false){
