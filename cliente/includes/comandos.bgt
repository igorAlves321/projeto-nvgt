void doorcheck(){
	for (uint i=0; i<doors.length(); i++){
		if (me.x==doors[i].dx&&me.y==doors[i].dy&&!dmoving){
			send_unreliable(peer_id,"draw "+doors[i].ds3,0);
			sound s;
			s.load(doors[i].ds3);
			s.play();
			while(s.playing){
				wait(5);
				mainloop();
			}
			dmoving=true;
			if(doors.length()==0){
				dcheck=false;
				dmoving=false;
				break;
			}
			doors[i].doorsound2=doors_sound.play_stationary(doors[i].ds2, true);
			doors[i].moving=true;
			dmoving=true;
			dcheck=false;
			send_unreliable(peer_id,"iamdmoving",0);
		}
		else if (i>=doors.length()-1){
			dcheck=false;
			break;
		}
	}
}
void elevadorcheck(){
	for(uint i=0;i<elevadors.length();i++){
		if (me.x==elevadors[i].x&&me.y==elevadors[i].y&&dmoving==false){
			elevadors[i].s=doors_sound.play_2d("elevador.ogg", me.x, me.y, elevadors[i].x, elevadors[i].y, true);
			elevadors[i].moving=true;
			emoving=true;
			echeck=false;
			moveable=false;
		}
		else if(i>=elevadors.length()-1){
			echeck=false;
			if(!ausente)moveable=true;
		}
	}
}
void testspeaks(){
double pan=0;
	key_hold ileft(KEY_LEFT,100,50);
	key_hold iright(KEY_RIGHT,100,50);
sound test;
test.load("00cancion.ogg");
test.play_looped();
speak(pu.get_value("Para verificar a posição dos seus fones de ouvido/alto-falantes, pressione as setas para direita ou esquerda. Você também pode manter essas teclas pressionadas se quiser uma verificação mais rápida."));
while(test.playing){
wait(5);
if(key_pressed(KEY_ESCAPE)){
test.stop();
main_menu();
}
if(iright.pressing()){
pan+=1.0;
test.pan=pan;
}
if(ileft.pressing()){
pan-=2.0;
test.pan=pan;
}
}
}

