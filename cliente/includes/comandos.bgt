	if(itemname=="bicicleta"){
if(bicicleta==0){
add_add_item("avisos", pu.get_value("creo que no es muy inteligente el tratar de bajarse de tu bicicleta siendo que no estï¿½s en ella."));
return;
}
else{
		send_unreliable(peer_id, "draw bicicletadraw.ogg", 0);
		p.play_stationary("bicicletadraw.ogg", false);
		bicicleta=0;
}
	}
	if(itemname=="paraquedas"&&get_tile_at(me.x, me.y)!=""&&get_zone_at(me.x, me.y)!="")paraquedas=0;
	if(itemname=="paracaï¿½das"&&get_tile_at(me.x, me.y)!=""&&get_zone_at(me.x, me.y)!="")paracaidas=0;
	send_unreliable(peer_id,"retirar "+itemname,0);
}
void outrosloop(){
/*	if(!outras&&weapons[selected].require_ammo==0||weapons[selected].name!="soco"||weapons[selected].name!="taser"&&!inv_item_exists(weapons[selected].name)){
		selected=0;
	}*/	if(olharx.elapsed>=3000){
		if(me.x<0){
			me.x=0;
			send_unreliable(peer_id, "move "+get_tile_at(me.x, me.y)+random(1, 5)+".ogg"+" "+me.x+" "+me.y,0);
		}
		else if(me.x>max.x){
			me.x=max.x;
			send_unreliable(peer_id, "move "+get_tile_at(me.x, me.y)+random(1, 5)+".ogg"+" "+me.x+" "+me.y,0);
		}
		else if(me.y<0){
			me.y=0;
			send_unreliable(peer_id, "move "+get_tile_at(me.x, me.y)+random(1, 5)+".ogg"+" "+me.x+" "+me.y,0);
		}
		else if(me.y>max.y){
			me.y=max.y;
			send_unreliable(peer_id, "move "+get_tile_at(me.x, me.y)+random(1, 5)+".ogg"+" "+me.x+" "+me.y,0);
		}
	}
	if(echotimer.elapsed>=echotime&&echo==true){
		echocheck(facing);
	}
}

