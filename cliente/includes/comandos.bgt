send_unreliable(peer_id, "private_audio "+player_destination+" "+f.read(), 7);
f.close();
recording=false;
spamtimer.restart();
}
if (key_released(KEY_F1)&&recording==true&&voicechat==1&&ausente==false){
p.play_stationary("radiooff.ogg",false);
r.stop(true,DIRECTORY_TEMP+"\\convert.ogg");
file f;
