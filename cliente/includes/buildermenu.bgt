void clothesmenu(){
setupmenu2();
m.add_item_tts(pu.get_value("criar uma roupa nova."), "newclothe");
m.add_item_tts(pu.get_value("eliminar uma roupa existente."), "deleteclothe");
int mres=m.run(pu.get_value("escolha a opção que seja de sua preferência e pressione enter."), true);
if(mres==0)buildermenu();
if(m.get_item_name(mres)=="newclothe"){
string s1=v.input(pu.get_value("escreva o nome da roupa."));
string s2=v.input(pu.get_value("escreva a parte do corpo na qual irá. tenha cuidado, já que se quiser criar mais roupas que vão na mesma parte terá que escrever exatamente igual."));
string s3=v.input(pu.get_value("escreva a descrição que terá a roupa."));
string s4=string_replace(get_sound(pu.get_value("escolha o som ao vestir a roupa.")), ".ogg", "", true);
string s5=string_replace(get_sound(pu.get_value("escolha o som ao tirar a roupa.")), ".ogg", "", true);
string s6, s7, s8;
int option=q_pro(pu.get_value("a roupa se mostrará a todos os jogadores quando estiver vestida?"));
if(option==1){
s6="1";
}
else{
s6="0";
}
option=q_pro(pu.get_value("A roupa se degradará?"));
if(option==1) s7="1";
else s7="0";
if(option==1) s8=v.input(pu.get_value("Quanta degradação se somará à roupa ao receber um tiro?"));
else s8="0";
string s9=v.input(pu.get_value("Escreva a porcentagem que se descontará do dano recebido por padrão tendo a roupa vestida. Exemplo: Se a arma tira 50000 de saúde, ao escrever 50% (sem o sinal) a antes mencionada tirará a metade do dano preestabelecido pois se descontará esse 50%."));
if(s1!=""&&s2!=""&&s3!=""&&s4!=""&&s5!=""&&s6!=""&&s7!=""&&s8!=""&&s9!=""){
send_reliable(peer_id, "new_clothe::"+s1+"::"+s2+"::"+s3+"::"+s4+"::"+s5+"::"+s6+"::"+s7+"::"+s8+"::"+s9, 13);
}
}
if(m.get_item_name(mres)=="deleteclothe"){
send_reliable(peer_id, "list_clothes", 13);
}
}
void show_clothes(string content){
int counter=-1;
string[] lines=delinear(content);
speak(pu.get_value("posicione-se na roupa que deseje eliminar e pressione tecla delete."));
while(true){
mainloop();
if(key_pressed(KEY_ESCAPE)){
break;
}
if(key_pressed(KEY_LEFT)&&counter>0){
counter--;
speak(lines[counter]);
}
if(key_pressed(KEY_RIGHT)&&counter<lines.length()-1){
counter++;
speak(lines[counter]);
}
if(key_pressed(KEY_HOME)&&counter>0){
counter=0;
speak(lines[counter]);
}
if(key_pressed(KEY_END)&&counter<lines.length()-1){
counter=lines.length()-1;
speak(lines[counter]);
}
if(key_pressed(KEY_DELETE)&&counter>-1){
send_reliable(peer_id, "delete_clothe::"+lines[counter], 13);
lines.remove_at(counter);
}
}
}
void weapons_menu(){
setupmenu2();
m.add_item_tts(pu.get_value("criar armas."), "create");
m.add_item_tts(pu.get_value("eliminar armas."), "delete");
int mres=m.run(pu.get_value("menu para gestão de armas."), true);
if(mres==0) return;
if(m.get_item_name(mres)=="create"){
string name=v.input(pu.get_value("escreva o nome da arma."));
string ammo=v.input(pu.get_value("escreva o tipo de munição (nome se é que a arma necessitará)."));
string sound_shoot=string_replace(get_sound(pu.get_value("escolha o som da arma ao disparar.")), ".ogg", "", true);
string sound_impact=v.input(pu.get_value("escreva os sons que queira que soem nas paredes ao impactar o disparo (com vírgula e sem extensão .ogg)."));
string sound_draw=string_replace(get_sound(pu.get_value("escolha o som ao pegar a arma.")), ".ogg", "", true);
string sound_reload=string_replace(get_sound(pu.get_value("escolha o som ao recarregar a arma.")), ".ogg", "", true);
double damage=string_to_number(v.input(pu.get_value("escreva o dano que fará a arma.")));
double distance=string_to_number(v.input(pu.get_value("escreva a distância máxima da bala ao ser disparada.")));
double ammo_cantity=string_to_number(v.input(pu.get_value("escreva a quantidade das balas que terá como carga máxima possível a arma.")));
double ammo_load=string_to_number(v.input(pu.get_value("escreva a quantidade de balas que pegará a arma por padrão. (este valor também será utilizado para saber que quantidade da mesma arma se descontarão se esta for arremessável.")));
double speed=string_to_number(v.input(pu.get_value("escreva a velocidade em ms da arma em modo semi automático.")));
double speed_burst=string_to_number(v.input(pu.get_value("escreva a velocidade da arma em modo automático.")));
double speed_reload=string_to_number(v.input(pu.get_value("escreva a velocidade de recarga da arma.")));
int require_ammo=q_pro(pu.get_value("Requerirá munição?"));
if(require_ammo==2){
require_ammo=0;
}
int enable_burst=q_pro(pu.get_value("Terá a possibilidade de intercambiar entre modo automático e semi automático?"));
if(enable_burst==2){
enable_burst=0;
}
int is_dropable=q_pro(pu.get_value("A arma será arremessável?"));
if(is_dropable==2){
is_dropable=0;
}
string sounds_impact_on_corpse=v.input(pu.get_value("escreva os sons que se reproduzirão quando a bala impactar em algum corpo, seja de npc ou de jogador. para que sejam os sons de sempre escreva a palavra default."));
if(sounds_impact_on_corpse=="default") sounds_impact_on_corpse="body1,body2,body3,body4,body5,body6,body7";
string sound_unload=string_replace(get_sound(pu.get_value("escolha o som que se reproduzirá quando a arma estiver descarregada.")), ".ogg", "", true);
string sound_mode1=string_replace(get_sound(pu.get_value("escolha o som que se reproduzirá ao passar ao modo automático.")), ".ogg", "", true);
string sound_mode2=string_replace(get_sound(pu.get_value("escolha o som que se reproduzirá ao passar ao modo semiautomático.")), ".ogg", "", true);
double ammo_cantity_descount=string_to_number(v.input(pu.get_value("escreva a quantidade de balas que se descontarão por disparo.")));
string sound_shoot_dist=string_replace(get_sound(pu.get_value("escolha o som que se reproduzirá ao longe quando a arma disparar.")), ".ogg", "", true);
string degradation_point =v.input(pu.get_value("Escreva o ponto de degradação da arma, o servidor fará um random entre 1 e o número que indicar. Se escrever 0, a arma não degradará em nenhum momento, útil para armas arremessáveis."), "0");
send_reliable(peer_id, "create_weapon::"+name+"::"+ammo+"::"+sound_shoot+"::"+sound_impact+"::"+sound_draw+"::"+sound_reload+"::"+damage+"::"+distance+"::"+ammo_cantity+"::"+ammo_load+"::"+speed+"::"+speed_burst+"::"+speed_reload+"::"+require_ammo+"::"+enable_burst+"::"+is_dropable+"::"+sounds_impact_on_corpse+"::"+sound_unload+"::"+sound_mode1+"::"+sound_mode2+"::"+ammo_cantity_descount+"::"+sound_shoot_dist+"::"+degradation_point, 13);
}
if(m.get_item_name(mres)=="delete"){
send_reliable(peer_id, "list_weapons", 13);
}
}
void show_weapons(string content){
int counter=-1;
string[] lines=delinear(content);
speak(pu.get_value("posicione-se na arma que deseje eliminar e pressione tecla delete."));
while(true){
mainloop();
if(key_pressed(KEY_ESCAPE)){
break;
