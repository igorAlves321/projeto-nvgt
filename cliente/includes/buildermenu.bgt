void craftmenu(){
setupmenu2();
m.add_item_tts(pu.get_value("adicionar uma nova construção."), "add");
m.add_item_tts(pu.get_value("eliminar uma construção."), "delete");
int mres=m.run(pu.get_value("menu de gestão de construções."), true);
if(m.get_item_name(mres)=="add"){
string item1=v.input(pu.get_value("escreva o primeiro item que se necessitará para consumar a construção e sua quantidade separados por um ponto. por exemplo, item.1."));
string item2=v.input(pu.get_value("escreva o segundo item que se necessitará para consumar a construção e sua quantidade separados por um ponto. por exemplo, item.1."));
string item_gived=v.input(pu.get_value("escreva os nomes dos itens que se darão ao terminar a construção e sua quantidade separados por um ponto. por exemplo, item.1,item2.2."));
string sound_crafted=string_replace(get_sound(pu.get_value("escolha o som que se reproduzirá no momento de terminar a construção.")), ".ogg", "", true);
string sounds_crafting=string_replace(get_sound(pu.get_value("escolha os sons que se reproduzirão ao dar alt+c para construir o item. para selecioná-los, pressione shift+espaço sobre eles."), "", false, true), ".ogg", "", true);
string attempts_min_range=v.input(pu.get_value("escreva o número mínimo de tentativas que se terão que dar para que a construção seja efetiva. (se randomizará)."));
string attempts_max_range=v.input(pu.get_value("escreva o número máximo de tentativas que se terão que dar para que a construção seja efetiva. (se randomizará)."));
string msg=v.input(pu.get_value("escreva a mensagem que aparecerá ao terminar a construção."));
if(item1!=""&&item2!=""&&item_gived!=""&&sound_crafted!=""&&sounds_crafting!=""&&attempts_min_range!=""&&attempts_max_range!=""&&msg!=""){
send_reliable(peer_id, "add_craft::"+item1+"="+item2+"="+item_gived+"="+sound_crafted+"="+sounds_crafting+"="+attempts_min_range+"="+attempts_max_range+"="+msg, 13);
}
}
if(m.get_item_name(mres)=="delete"){
string items=v.input(pu.get_value("escreva os itens da construção que quer eliminar separados por vírgula e sem espaço."));
string[] data=string_split(items, ",", false);
if(data.length()==2) send_reliable(peer_id, "delete_craft::"+data[0]+"::"+data[1], 13);
}
}
void itemsmenu(){
setupmenu2();
m.add_item_tts(pu.get_value("criar item."), "create");
m.add_item_tts(pu.get_value("eliminar item."), "delete");
int mres=m.run(pu.get_value("escolha o que corresponda."), true);
if(mres==0) buildermenu();
if(m.get_item_name(mres)=="create"){
dlg(pu.get_value("atenção. se se desejar que o item não faça certas coisas tais como alterar de mapa, reproduzir som, mandar uma mensagem, etc, escreva a palavra none. assim como quanto à xp, a saúde entre outros valores numéricos, escreva unicamente o número 0."));
string name=v.input(pu.get_value("escreva o nome do item a criar."));
string items_to_give=v.input(pu.get_value("escreva os itens separados por vírgula (e quantidade por ponto) que dará/tirará o item ao dar espaço nele."));
string audio=string_replace(get_sound(pu.get_value("escolha o som que se reproduzirá ao dar espaço no item.")), ".ogg", "", true);
string msg=v.input(pu.get_value("escreva a mensagem que soltará o item ao dar espaço sobre ele."));
string map=v.input(pu.get_value("escreva o nome do mapa ao qual o teletransportará o item."));
string newx=v.input(pu.get_value("escreva a coordenada x de aparição ao se teletransportar."));
string newy=v.input(pu.get_value("escreva a coordenada y de aparição ao se teletransportar."));
string xp=v.input(pu.get_value("escreva a quantidade de xp que ganhará o jogador ao dar espaço sobre o item."));
string health=v.input(pu.get_value("escreva a quantidade de vida que subirá o item ao dar espaço sobre ele."));
string thirst=v.input(pu.get_value("escreva a quantidade de sede que dará/tirará o item."));
string fill_thirst=v.input(pu.get_value("escreva a quantidade que se somará ao que está cheio do personagem quanto a líquidos ao usar o item."));
string hunger=v.input(pu.get_value("escreva a quantidade de fome que dará/tirará o item."));
string fill_hunger=v.input(pu.get_value("escreva a quantidade que se somará ao que está cheio do personagem quanto a comida ao usar o item."));
double degradation=string_to_number(v.input(pu.get_value("escreva degradação que se adicionará ao item ao pressionar espaço sobre ele. o número deve ser maior que 0 ou menor que 100 (se permitem pontos decimais).")));
if(name!=""&&items_to_give!=""&&audio!=""&&msg!=""&&map!=""&&newx!=""&&newy!=""&&xp!=""&&health!=""&&thirst!=""&&fill_thirst!=""&&hunger!=""&&fill_hunger!=""){
send_reliable(peer_id, "newitem::"+name+"::"+items_to_give+"::"+audio+"::"+msg+"::"+map+"::"+newx+"::"+newy+"::"+xp+"::"+health+"::"+thirst+"::"+fill_thirst+"::"+hunger+"::"+fill_hunger+"::"+degradation, 13);
}
}
if(m.get_item_name(mres)=="delete"){
send_reliable(peer_id, "/list_items", 0);
}
}

void show_items(string content){
int counter=-1;
string[] lines=delinear(content);
speak(pu.get_value("posicione-se no item que deseje eliminar e pressione tecla delete."));
while(true){
mainloop();
if(key_pressed(KEY_ESCAPE)){
break;
}
if(key_pressed(KEY_LEFT)&&counter>0){
counter--;
speak(lines[counter]);
}
if(key_pressed(KEY_RIGHT)&&counter<lines.length()-1){
counter++;
speak(lines[counter]);
}
if(key_pressed(KEY_HOME)&&counter>0){
counter=0;
speak(lines[counter]);
}
if(key_pressed(KEY_END)&&counter<lines.length()-1){
counter=lines.length()-1;
speak(lines[counter]);
}
if(key_pressed(KEY_DELETE)&&counter>-1){
send_reliable(peer_id, "delete_item::"+lines[counter], 13);
lines.remove_at(counter);
}
}
}

void booksmenu() {
	setupmenu2();
	m.add_item_tts(pu.get_value("criar um livro"), "createbook");
	m.add_item_tts(pu.get_value("atualizar, renomear, ou eliminar um livro"), "managebook");
	m.add_item_tts(pu.get_value("Voltar"), "back");
	int mres=m.run(pu.get_value("Menu de gestão de livros, por favor use com cuidado."), true);
	if(mres==0 || m.get_item_name(mres) =="back") {
		buildermenu();
	}
	if(m.get_item_name(mres) =="createbook") {
		string title =v.input(pu.get_value("escreva o título do livro:"));
		string description =v.input(pu.get_value("escreva a descrição do livro:"));
		string bookname =v.input(pu.get_value("escreva o nome do livro no servidor, pode usar o mesmo título como referência, sem espaços, usando sublinhados ou hífens como separadores de palavras:"));
		string bookmusic=v.input(pu.get_value("escreva o nome do som que se reproduzirá quando o jogador ler o livro:"));
		string book_data =v.input(pu.get_value("escreva aqui o conteúdo do seu livro, lembre que as páginas devem ir separadas mediante a etiqueta page:"));
		if(title !="" && description !="" && bookname !="" && bookmusic !="" && book_data !="") {
			string final =bookname+" "+"title="+title+"\r\n"+"description="+description+"\r\n"+"music="+bookmusic+"\r\n"+book_data;
			send_reliable(peer_id, "/createbook "+final, 1);
		}
		else {
			speak(pu.get_value("por alguma razão não é possível criar o livro. Por favor verifique a informação e volte a tentar."));
		}
	}
	if(m.get_item_name(mres) =="managebook") {
		send_reliable(peer_id, "/listbooks", 1);
	}
}

void show_books(string content) {
	int counter=-1;
	string[] lines=delinear(content);
	speak(pu.get_value("posicione-se sobre um livro e pressione: enter para atualizá-lo, alt+r para renomeá-lo, ou delete para eliminá-lo."));
	while(true){
		mainloop();
		if(key_pressed(KEY_ESCAPE)){
			booksmenu();
			break;
		}
		if(key_pressed(KEY_LEFT)&&counter>0){
			counter--;
			speak(lines[counter]);
		}
		if(key_pressed(KEY_RIGHT)&&counter<lines.length()-1){
			counter++;
			speak(lines[counter]);
		}
		if(key_pressed(KEY_HOME)&&counter>0){
			counter=0;
			speak(lines[counter]);
		}
		if(key_pressed(KEY_END)&&counter<lines.length()-1){
			counter=lines.length()-1;
			speak(lines[counter]);
		}
		if(key_pressed(KEY_DELETE) || key_pressed(KEY_DECIMAL)) {
			if(counter>=0) {
				setupmenu2();
				m.add_item_tts(pu.get_value("Sim"), "yes");
				m.add_item_tts(pu.get_value("Não"), "no");
				int confirmdelete =m.run(pu.get_value("Pergunta: Tem certeza que deseja eliminar este livro? esta operação não pode ser desfeita."), true);
				if(m.get_item_name(confirmdelete)=="yes") {
					send_reliable(peer_id, "/delbook "+lines[counter], 1);
					booksmenu();
					break;
				}
				else {
					booksmenu();
					break;
				}
			}
		}
		if(key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER)) {
			if(counter>=0) {
				send_reliable(peer_id, "/getbook "+lines[counter], 1);
				break;
			}
		}
		if(key_down(KEY_LMENU) && key_pressed(KEY_R)) {
			if(counter>=0) {
				string newname =v.input("Nome:", lines[counter]);
				send_reliable(peer_id, "/renamebook "+lines[counter]+" "+newname, 1);
				booksmenu();
				break;
			}
		}
	}
}

void updatebook(string bookname, string data) {
	while(true) {
		wait(5);
		mainloop();
		if(data!="") {
			string bookdata =v.input(pu.get_value("escreva ou cole o texto do livro que deseja atualizar:"), data);
			if(bookdata !="") {
				send_reliable(peer_id, "/updatebook "+bookname+" "+bookdata, 1);
				booksmenu();
				break;
			}
			else {
				booksmenu();
				break;
			}
		}
	}
}

void portalsmenu() {
	setupmenu2();
	m.add_item_tts(pu.get_value("adicionar um destino ao portal"), "add_portal_destination");
	m.add_item_tts(pu.get_value("atualizar ou eliminar destinos de portais"), "manageportals");
	m.add_item_tts(pu.get_value("Voltar"), "back");
	int mres=m.run(pu.get_value("Menu de gestão de portais, por favor use com cuidado."), true);
	if(mres==0 || m.get_item_name(mres) =="back") {
		buildermenu();
	}
	if(m.get_item_name(mres) =="add_portal_destination") {
		string portaltitle =v.input(pu.get_value("escreva o nome com o qual o jogador verá o destino:"));
		string portalmap =v.input(pu.get_value("escreva o mapa de destino:"));
		string destination_x =v.input(pu.get_value("escreva a coordenada x de destino do portal:"));
		string destination_y =v.input(pu.get_value("escreva a coordenada y de destino do portal:"));
		if(portaltitle !="" && portalmap !="" && destination_x !="" && destination_y !="") {
			string final =portaltitle+"="+portalmap+"="+destination_x+"="+destination_y+"\r\n";
			send_reliable(peer_id, "/add_portal_destination "+final, 1);
		}
		else {
			speak(pu.get_value("por alguma razão não é possível adicionar o destino ao portal. Por favor verifique a informação e volte a tentar."));
		}
	}
	if(m.get_item_name(mres) =="manageportals") {
		send_reliable(peer_id, "/getportal", 1);
	}
}

void updateportal(string data) {
	while(true) {
		wait(5);
		mainloop();
		if(data!="") {
			string portaldata =v.input(pu.get_value("escreva ou cole o texto do portal que deseja atualizar:"), data);
			if(portaldata !="") {
				send_reliable(peer_id, "/updateportal "+portaldata, 1);
				portalsmenu();
				break;
			}
			else {
				portalsmenu();
				break;
			}
		}
	}
}
