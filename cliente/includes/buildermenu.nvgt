// Desfazer última criação
void builder_undo_last() {
	// Verificar se há algo para desfazer
	if(map2.length() == 0) {
		speak(pu.get_value("BUILDER_UNDO_EMPTY"));
		return;
	}
	
	// Obter a última linha adicionada ao mapa
	string last_line = map2[map2.length() - 1];
	
	// Extrair o tipo de elemento da última linha
	string[] parts = string_split(last_line, ":");
	if(parts.length() == 0) {
		speak(pu.get_value("Erro ao processar última criação."));
		return;
	}
	
	string element_type = parts[0];
	
	// Mapear tipos legíveis
	string element_name = "";
	if(element_type == "w") element_name = pu.get_value("BUILDER_WALL");
	else if(element_type == "w2") element_name = pu.get_value("BUILDER_ADVANCED_WALL");
	else if(element_type == "wall") element_name = pu.get_value("BUILDER_LIVING_WALL");
	else if(element_type == "p") element_name = pu.get_value("BUILDER_PLATFORM");
	else if(element_type == "tp") element_name = pu.get_value("BUILDER_PASSAGE");
	else if(element_type == "timed_passage") element_name = pu.get_value("BUILDER_TIMED_PASSAGE");
	else if(element_type == "mapgate") element_name = pu.get_value("BUILDER_MAPGATE");
	else if(element_type == "mapgate_item") element_name = pu.get_value("BUILDER_MAPGATE_ITEM1");
	else if(element_type == "mapgate_multi") element_name = pu.get_value("BUILDER_MAPGATE_ITEM2");
	else if(element_type == "dr") element_name = pu.get_value("BUILDER_DOOR");
	else if(element_type == "elv") element_name = pu.get_value("BUILDER_ELEVATOR");
	else if(element_type == "sc") element_name = pu.get_value("BUILDER_STAIR");
	else if(element_type == "z") element_name = pu.get_value("BUILDER_ZONE");
	else if(element_type == "sz") element_name = pu.get_value("BUILDER_SAFE_ZONE");
	else if(element_type == "item") element_name = pu.get_value("BUILDER_RESPAWN_ITEMS");
	else if(element_type == "npc") element_name = pu.get_value("BUILDER_BOTS");
	else if(element_type == "ss") element_name = pu.get_value("BUILDER_AMBIENT_SOUND");
	else if(element_type == "ss2") element_name = pu.get_value("BUILDER_MAP_MUSIC");
	else if(element_type == "txt") element_name = pu.get_value("BUILDER_TEXT");
	else if(element_type == "dlg") element_name = pu.get_value("BUILDER_DIALOG");
	else if(element_type == "arbol") element_name = pu.get_value("BUILDER_TREE");
	else if(element_type == "am") element_name = pu.get_value("BUILDER_QUICKSAND");
	else if(element_type == "ex") element_name = pu.get_value("BUILDER_EXTRACT_ZONE");
	else if(element_type == "death") element_name = pu.get_value("BUILDER_DEATH_AREA");
	else if(element_type == "disable_game") element_name = pu.get_value("BUILDER_ANTIGAME");
	else if(element_type == "rt") element_name = pu.get_value("BUILDER_TOILET");
	else if(element_type == "lv") element_name = pu.get_value("BUILDER_SINK");
	else if(element_type == "dv") element_name = pu.get_value("BUILDER_DISABLE");
	else if(element_type == "darmas") element_name = pu.get_value("BUILDER_DISABLE_WEAPON");
	else if(element_type == "url") element_name = pu.get_value("BUILDER_ADD_URL");
	else if(element_type == "where") element_name = pu.get_value("BUILDER_LOCATION");
	else if(element_type == "newymap") element_name = pu.get_value("BUILDER_NEW_YMAP");
	else if(element_type == "teto") element_name = pu.get_value("teto");
	else element_name = element_type;
	
	// Confirmar desfazer
	bool confirm = simple_yes_no(pu.get_value("BUILDER_UNDO_CONFIRM") + element_name + "?");
	
	if(!confirm) {
		speak(pu.get_value("Operação cancelada."));
		return;
	}
	
	// Remover última linha do array local
	map2.remove_at(map2.length() - 1);
	
	// Enviar comando ao servidor para remover
	send_to_server("undo_last::" + last_line, 13, true);
	
	speak(pu.get_value("BUILDER_UNDO_DONE") + element_name);
	
	// Oferecer opção de continuar desfazendo
	if(map2.length() > 0) {
		bool continue_undo = simple_yes_no(pu.get_value("BUILDER_UNDO_MORE"));
		if(continue_undo) {
			builder_undo_last(); // Recursivo
		}
	}
	else {
		speak(pu.get_value("BUILDER_UNDO_EMPTY"));
	}
}

