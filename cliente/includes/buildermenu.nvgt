	game_menu.add_item(pu.get_value("BUILDER_LIVING_WALL"), "walls_life");
	game_menu.add_item(pu.get_value("BUILDER_PASSAGE"), "travelpoint");
	game_menu.add_item(pu.get_value("BUILDER_TIMED_PASSAGE"), "cpm");
	game_menu.add_item(pu.get_value("BUILDER_PLATFORM"), "platform");
	game_menu.add_item(pu.get_value("BUILDER_MAPGATE"), "portamapa");
	game_menu.add_item(pu.get_value("BUILDER_MAPGATE_ITEM1"), "pm");
	game_menu.add_item(pu.get_value("BUILDER_MAPGATE_ITEM2"), "pm2");
	game_menu.add_item(pu.get_value("BUILDER_DOOR"), "door");
	game_menu.add_item(pu.get_value("BUILDER_FULL_DOOR"), "door2");
	game_menu.add_item(pu.get_value("BUILDER_CLOTHES"), "clothes");
	game_menu.add_item(pu.get_value("BUILDER_TEXT"), "texto");
	game_menu.add_item(pu.get_value("BUILDER_STORES"), "stores");
	game_menu.add_item(pu.get_value("BUILDER_ZONE"), "zone");
	game_menu.add_item(pu.get_value("BUILDER_EXTRACT_ZONE"), "extract");
	game_menu.add_item(pu.get_value("BUILDER_SAFE_ZONE"), "safezone");
	game_menu.add_item(pu.get_value("BUILDER_ADVANCED_OPTS"), "correccion");
	game_menu.add_item(pu.get_value("BUILDER_CLOSE"), "closemenu");
	
	game_menu.intro_text = pu.get_value("BUILDER_INTRO");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "closemenu" || mres == -1) {
		return;
	}
	
	// Processar seleção
	process_builder_selection(selected_id);
}

// Processa seleção do menu de builder
void process_builder_selection(string selected_id) {
	if(selected_id == "retrete") {
		builder_create_toilet();
	}
	else if(selected_id == "lavabo") {
		builder_create_sink();
	}
	else if(selected_id == "respawnitems") {
		builder_create_respawn_items();
	}
	else if(selected_id == "extract") {
		builder_create_extraction_zone();
	}
	else if(selected_id == "bots") {
		builder_create_bot();
	}
	else if(selected_id == "ambient2" || selected_id == "ambient") {
		builder_create_ambient_sound();
	}
	else if(selected_id == "ambient3") {
		builder_create_map_music();
	}
	else if(selected_id == "where") {
		builder_set_location();
	}
	else if(selected_id == "newymap") {
		builder_create_respawn_coords();
	}
	else if(selected_id == "zone") {
		builder_create_zone();
	}
	else if(selected_id == "craft") {
		craftmenu();
	}
	else if(selected_id == "newmap") {
		builder_create_new_map();
	}
	else if(selected_id == "mapupdate") {
		builder_update_map();
	}
	else if(selected_id == "desativar_lluvia") {
		send_to_server("add_line::teto:none", 13, true);
	}
	else if(selected_id == "desativar") {
		builder_disable_element();
	}
	else if(selected_id == "darmas") {
		builder_disable_weapon();
	}
	else if(selected_id == "undo") {
		builder_undo_last();
	}
	else if(selected_id == "platform") {
		builder_create_platform();
	}
	else if(selected_id == "weapons") {
		weapons_menu();
	}
	else if(selected_id == "quicksand") {
		builder_create_quicksand();
	}
	else if(selected_id == "door2" || selected_id == "door") {
		builder_create_door(selected_id == "door2");
	}
	else if(selected_id == "cpm") {
		builder_create_timed_passage();
	}
	else if(selected_id == "travelpoint") {
		builder_create_passage();
	}
	else if(selected_id == "portamapa") {
		builder_create_mapgate();
	}
	else if(selected_id == "pm") {
		builder_create_mapgate_item1();
	}
	else if(selected_id == "pm2") {
		builder_create_mapgate_item2();
	}
	else if(selected_id == "elevator") {
		builder_create_elevator();
	}
	else if(selected_id == "stores") {
		stores_building_menu();
	}
	else if(selected_id == "texto") {
		builder_create_text();
	}
	else if(selected_id == "dialog") {
		builder_create_dialog();
	}
	else if(selected_id == "safezone") {
		builder_create_safezone();
	}
	else if(selected_id == "antigame") {
		builder_create_antigame_area();
	}
	else if(selected_id == "deaths") {
		builder_create_death_area();
	}
	else if(selected_id == "add_url") {
		builder_add_url();
	}
	else if(selected_id == "items") {
		itemsmenu();
	}
	else if(selected_id == "clothes") {
		clothesmenu();
	}
	else if(selected_id == "stair") {
		builder_create_stair();
	}
	else if(selected_id == "arbol") {
		builder_create_tree();
	}
	else if(selected_id == "walls_life") {
		builder_create_wall_with_life();
	}
	else if(selected_id == "wall") {
		builder_create_wall();
	}
	else if(selected_id == "wall2") {
		builder_create_advanced_wall();
	}
	else if(selected_id == "getmap") {
		send_to_server("/rawmap", 1, false);
	}
	else if(selected_id == "delete") {
		builder_delete_map();
	}
	else if(selected_id == "booksmenu") {
		booksmenu();
	}
	else if(selected_id == "portalsmenu") {
		portalsmenu();
	}
	else if(selected_id == "correccion") {
		correccionmenu();
	}
}

// Helper para enviar ao servidor
void send_to_server(string packet, int channel, bool reliable) {
	if(!is_connected) {
		debug_log("send_to_server bloqueado: sem conexão ativa. pacote='" + packet + "'");
		speak(pu.get_value("Sem conexão com o servidor."), true);
		return;
	}

	debug_log("send_to_server: tentando enviar '" + packet + "' canal=" + channel + " reliable=" + reliable);
	bool ok = false;
	if(reliable) {
		ok = game_client.send_reliable(packet, channel);
	}
	else {
		ok = game_client.send_unreliable(packet, channel);
	}
	if(!ok) {
		debug_log("send_to_server falhou: canal=" + channel + " reliable=" + reliable + " erro=" + game_client.get_last_error());
	}
	else {
		debug_log("send_to_server: envio ok");
	}
}

// ===== FUNÇÕES DE CRIAÇÃO DE ELEMENTOS =====

// Criar vaso sanitário
void builder_create_toilet() {
	input_form form(pu.get_value("BUILDER_TOILET_TITLE"));
	form.add_number_field("x", pu.get_value("BUILDER_X_COORD"), 0, true);
	form.add_number_field("y", pu.get_value("BUILDER_Y_COORD"), 0, true);
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x, y;
		result.get("x", x);
		result.get("y", y);
		if(x > 0 && y > 0) {
			string data = "rt:" + int(x) + ":" + int(y);
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

// Criar pia
void builder_create_sink() {
	input_form form(pu.get_value("BUILDER_SINK_TITLE"));
	form.add_number_field("x", pu.get_value("BUILDER_X_COORD"), 0, true);
	form.add_number_field("y", pu.get_value("BUILDER_Y_COORD"), 0, true);
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x, y;
		result.get("x", x);
		result.get("y", y);
		if(x > 0 && y > 0) {
			string data = "lv:" + int(x) + ":" + int(y);
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

// Criar itens respawnáveis
void builder_create_respawn_items() {
	input_form form(pu.get_value("BUILDER_RESPAWN_TITLE"));
	form.add_text_field("item", pu.get_value("BUILDER_ITEM_NAME"), "", true);
	form.add_number_field("qty", pu.get_value("BUILDER_QTY"), 1, true);
	form.add_number_field("x", pu.get_value("BUILDER_X_COORD"), 0, true);
	form.add_number_field("y", pu.get_value("BUILDER_Y_COORD"), 0, true);
	form.add_number_field("disappear_time", pu.get_value("BUILDER_DISAPPEAR_TIME"), 30000, true);
	form.add_text_field("sound", pu.get_value("BUILDER_SOUND_COLLECT"), "", true);
	form.add_number_field("respawn_time", pu.get_value("BUILDER_RESPAWN_TIME"), 60000, true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		string item, sound_name;
		double qty, x, y, disappear_time, respawn_time;
		result.get("item", item);
		result.get("qty", qty);
		result.get("x", x);
		result.get("y", y);
		result.get("disappear_time", disappear_time);
		result.get("sound", sound_name);
		result.get("respawn_time", respawn_time);
		
		if(item != "" && qty > 0 && x > 0 && y > 0) {
			string data = "item:" + int(x) + ":" + int(y) + ":" + int(disappear_time) + ":0:" + 
			              int(qty) + ":" + item + ":" + sound_name + ":" + int(respawn_time);
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

// Criar zona de extração
void builder_create_extraction_zone() {
	input_form form(pu.get_value("BUILDER_EXTRACT_TITLE"));
	form.add_number_field("x1", pu.get_value("BUILDER_X_MIN"), 0, true);
	form.add_number_field("x2", pu.get_value("BUILDER_X_MAX"), 0, true);
	form.add_number_field("y1", pu.get_value("BUILDER_Y_MIN"), 0, true);
	form.add_number_field("y2", pu.get_value("BUILDER_Y_MAX"), 0, true);
	form.add_number_field("qty", pu.get_value("BUILDER_QTY"), 1, true);
	form.add_number_field("presses", pu.get_value("BUILDER_PRESSES"), 1, true);
	form.add_number_field("speed", pu.get_value("BUILDER_SPEED"), 90, true);
	form.add_text_field("item", pu.get_value("BUILDER_ITEM_NAME"), "", true);
	form.add_text_field("sound_press", pu.get_value("BUILDER_SOUND_PRESS"), "", true);
	form.add_text_field("sound_spawn", pu.get_value("BUILDER_SOUND_SPAWN"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x1, x2, y1, y2, qty, presses, speed;
		string item, sound_press, sound_spawn;
		result.get("x1", x1); result.get("x2", x2);
		result.get("y1", y1); result.get("y2", y2);
		result.get("qty", qty); result.get("presses", presses); result.get("speed", speed);
		result.get("item", item); result.get("sound_press", sound_press); result.get("sound_spawn", sound_spawn);
		
		if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0 && item != "") {
			string data = "ex:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" +
			              int(qty) + ":" + int(presses) + ":" + int(speed) + ":" + item + ":" +
			              sound_press + ":" + sound_spawn;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

// Criar bot (NPC)
void builder_create_bot() {
	bool confirm = simple_yes_no(pu.get_value("BUILDER_BOT_WARNING"));
	
	if(!confirm) return;
	
	// Form complexo para criação de bot
	input_form form(pu.get_value("Criar Bot - Parte 1"));
	form.description = pu.get_value("Preencha os dados básicos do bot.");
	form.add_number_field("x", pu.get_value("coordenada x onde aparecerá."), 0, true);
	form.add_number_field("y", pu.get_value("coordenada y onde aparecerá."), 0, true);
	form.add_number_field("vida", pu.get_value("Quanta vida terá?"), 100, true);
	form.add_number_field("xp", pu.get_value("Quanta xp dará ao matá-lo?"), 10, true);
	form.add_number_field("attack_dist", pu.get_value("Distância mínima de ataque?"), 3, true);
	form.add_number_field("damage_received", pu.get_value("Dano que receberá (0 = padrão arma)."), 0, true);
	form.add_number_field("damage_dealt", pu.get_value("Dano que fará."), 10, true);
	form.add_number_field("mirror_damage", pu.get_value("Dano do espelho refletor?"), 5, true);
	
	dictionary@ result = form.run();
	if(form.user_canceled) return;
	
	double x, y, vida, xp, attack_dist, damage_received, damage_dealt, mirror_damage;
	result.get("x", x); result.get("y", y); result.get("vida", vida); result.get("xp", xp);
	result.get("attack_dist", attack_dist); result.get("damage_received", damage_received);
	result.get("damage_dealt", damage_dealt); result.get("mirror_damage", mirror_damage);
	
	// Form parte 2
	input_form form2(pu.get_value("Criar Bot - Parte 2"));
	form2.add_number_field("attack_time", pu.get_value("Tempo entre ataques (ms)."), 1000, true);
	form2.add_number_field("walk_time", pu.get_value("Tempo entre passos (ms)."), 200, true);
	form2.add_number_field("calm_time", pu.get_value("Tempo entre sons calmos (ms)."), 5000, true);
	form2.add_text_field("items", pu.get_value("Itens ao morrer (item.4,item2.5)."), "", true);
	form2.add_text_field("attack_sounds", pu.get_value("Sons de ataque (separados por vírgula)."), "", true);
	form2.add_text_field("calm_sounds", pu.get_value("Sons calmos (sem .ogg, vírgulas)."), "", true);
	form2.add_text_field("death_sound", pu.get_value("Som de morte (sem .ogg)."), "", true);
	form2.add_text_field("name", pu.get_value("Nome do bot."), "", true);
	
	dictionary@ result2 = form2.run();
	if(form2.user_canceled) return;
	
	double attack_time, walk_time, calm_time;
	string items, attack_sounds, calm_sounds, death_sound, name;
	result2.get("attack_time", attack_time); result2.get("walk_time", walk_time); result2.get("calm_time", calm_time);
	result2.get("items", items); result2.get("attack_sounds", attack_sounds); result2.get("calm_sounds", calm_sounds);
	result2.get("death_sound", death_sound); result2.get("name", name);
	
	// Form parte 3
	input_form form3(pu.get_value("Criar Bot - Parte 3"));
	form3.add_text_field("death_msg", pu.get_value("Mensagem ao morrer (*g* = sexo, *nick* = nome)."), "", true);
	form3.add_number_field("respawn_time", pu.get_value("Tempo para aparecer (ms)."), 60000, true);
	form3.add_text_field("footsteps", pu.get_value("Passos (default = padrão do chão)."), "default", true);
	form3.add_number_field("x_min", pu.get_value("Coordenada x mínima para caminhar."), 0, true);
	form3.add_number_field("x_max", pu.get_value("Coordenada x máxima para caminhar."), 0, true);
	form3.add_text_field("hit_sounds", pu.get_value("Sons ao receber dano (default = padrão)."), "default", true);
	form3.add_number_field("degradation", pu.get_value("Degradação na arma do jogador."), 1, true);
	
	dictionary@ result3 = form3.run();
	if(form3.user_canceled) return;
	
	string death_msg, footsteps, hit_sounds;
	double respawn_time, x_min, x_max, degradation;
	result3.get("death_msg", death_msg); result3.get("respawn_time", respawn_time);
	result3.get("footsteps", footsteps); result3.get("x_min", x_min); result3.get("x_max", x_max);
	result3.get("hit_sounds", hit_sounds); result3.get("degradation", degradation);
	
	// Perguntas sim/não
	bool multi_respawn = simple_yes_no(pu.get_value("Respawnará mais deste bot enquanto ele estiver vivo?"));
	bool bomb_damage = simple_yes_no(pu.get_value("Será danificado por bombas?"));
	
	string s19 = multi_respawn ? "1" : "0";
	string s20 = bomb_damage ? "1" : "0";
	
	// Montar string do bot
	if(x > 0 && y > 0 && name != "") {
		string data = "npc:" + int(x) + ":" + int(y) + ":" + int(vida) + ":" + int(xp) + ":" +
		              int(attack_dist) + ":" + int(damage_received) + ":" + int(damage_dealt) + ":" +
		              int(mirror_damage) + ":" + int(attack_time) + ":" + int(walk_time) + ":" +
		              int(calm_time) + ":" + items + ":" + attack_sounds + ":" + calm_sounds + ":" +
		              death_sound + ":" + name + ":" + death_msg + ":" + int(respawn_time) + ":" +
		              s19 + ":" + s20 + ":" + footsteps + ":" + int(x_min) + ":" + int(x_max) + ":" +
		              hit_sounds + ":" + int(degradation);
		send_to_server("add_line::" + data, 13, true);
	}
}

// Criar som ambiente
void builder_create_ambient_sound() {
	input_form form(pu.get_value("Som ambiente"));
	form.add_number_field("x1", pu.get_value("Início da coordenada x"), 0, true);
	form.add_number_field("x2", pu.get_value("Fim da coordenada x"), 0, true);
	form.add_number_field("y1", pu.get_value("Início da coordenada y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim da coordenada y"), 0, true);
	form.add_text_field("sound", pu.get_value("Nome do som (com extensão .ogg)"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x1, x2, y1, y2;
		string sound_name;
		result.get("x1", x1); result.get("x2", x2);
		result.get("y1", y1); result.get("y2", y2);
		result.get("sound", sound_name);
		
		if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0 && sound_name != "") {
			string data = "ss:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" + sound_name;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

