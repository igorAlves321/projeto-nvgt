// Criar área de morte
void builder_create_death_area() {
	input_form form(pu.get_value("Área de morte"));
	form.add_number_field("x1", pu.get_value("Coordenada x mínima"), 0, true);
	form.add_number_field("x2", pu.get_value("Coordenada x máxima"), 0, true);
	form.add_number_field("y1", pu.get_value("Coordenada y mínima"), 0, true);
	form.add_number_field("y2", pu.get_value("Coordenada y máxima"), 0, true);
	form.add_number_field("time", pu.get_value("Tempo para efeito (ms)"), 1000, true);
	form.add_text_field("death_msg", pu.get_value("Mensagem de morte (*g*=sexo, *nick*=nome)"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x1, x2, y1, y2, time;
		string death_msg;
		result.get("x1", x1); result.get("x2", x2);
		result.get("y1", y1); result.get("y2", y2);
		result.get("time", time); result.get("death_msg", death_msg);
		
		bool progressive = simple_yes_no(pu.get_value("A morte será progressiva?"));
		string s6 = progressive ? "1" : "0";
		string s7 = "0";
		
		if(progressive) {
			input_form form2(pu.get_value("Dano progressivo"));
			form2.add_number_field("damage", pu.get_value("Quanta vida tirará?"), 10, true);
			dictionary@ result2 = form2.run();
			if(!form2.user_canceled) {
				double damage;
				result2.get("damage", damage);
				s7 = "" + int(damage);
			}
		}
		
		bool requires_item = simple_yes_no(pu.get_value("Requer item para evitar efeitos?"));
		string s9 = "nada";
		string s10 = "0";
		string s11 = "0";
		
		if(requires_item) {
			input_form form3(pu.get_value("Item necessário"));
			form3.add_text_field("item", pu.get_value("Nome do item"), "", true);
			form3.add_number_field("qty", pu.get_value("Quantidade"), 1, true);
			dictionary@ result3 = form3.run();
			if(!form3.user_canceled) {
				double qty;
				result3.get("item", s9);
				result3.get("qty", qty);
				s10 = "1";
				s11 = "" + int(qty);
			}
		}
		
		if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0) {
			string data = "death:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" +
			              int(time) + ":" + s6 + ":" + s7 + ":" + death_msg + ":" + s9 + ":" + s10 + ":" + s11;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

