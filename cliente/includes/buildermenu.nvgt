		speak(pu.get_value("Portamapa com item criado com sucesso!"));
	}
}

// Portamapa que requer item 2 (versão avançada com múltiplos itens)
void builder_create_mapgate_item2() {
	input_form form(pu.get_value("Portamapa com múltiplos itens - Parte 1"));
	form.description = pu.get_value("Portal que requer vários itens diferentes.");
	form.add_number_field("x1", pu.get_value("Início x"), 0, true);
	form.add_number_field("x2", pu.get_value("Fim x"), 0, true);
	form.add_number_field("y1", pu.get_value("Início y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim y"), 0, true);
	form.add_number_field("dest_x", pu.get_value("Coordenada x de destino"), 0, true);
	form.add_number_field("dest_y", pu.get_value("Coordenada y de destino"), 0, true);
	form.add_text_field("dest_map", pu.get_value("Mapa de destino"), "", true);
	
	dictionary@ result = form.run();
	if(form.user_canceled) return;
	
	double x1, x2, y1, y2, dest_x, dest_y;
	string dest_map;
	result.get("x1", x1); result.get("x2", x2);
	result.get("y1", y1); result.get("y2", y2);
	result.get("dest_x", dest_x); result.get("dest_y", dest_y);
	result.get("dest_map", dest_map);
	
	// Configurar múltiplos itens
	input_form form2(pu.get_value("Portamapa com múltiplos itens - Parte 2"));
	form2.description = pu.get_value("Liste os itens necessários (formato: item1.qty1,item2.qty2)");
	form2.add_text_field("items", pu.get_value("Itens e quantidades"), "", true);
	form2.add_text_field("message_success", pu.get_value("Mensagem de sucesso"), "", false);
	form2.add_text_field("message_fail", pu.get_value("Mensagem de falha"), "", false);
	
	dictionary@ result2 = form2.run();
	if(form2.user_canceled) return;
	
	string items, message_success, message_fail;
	result2.get("items", items);
	result2.get("message_success", message_success);
	result2.get("message_fail", message_fail);
	
	// Opções avançadas
	bool consume_items = simple_yes_no(pu.get_value("Consumir todos os itens ao atravessar?"));
	bool require_all = simple_yes_no(pu.get_value("Requer TODOS os itens (se não, requer apenas 1)?"));
	bool reset_cooldown = simple_yes_no(pu.get_value("Tem tempo de espera entre usos?"));
	
	int cooldown_time = 0;
	if(reset_cooldown) {
		input_form form3(pu.get_value("Tempo de espera"));
		form3.add_number_field("time", pu.get_value("Tempo em milissegundos"), 60000, true);
		dictionary@ result3 = form3.run();
		if(!form3.user_canceled) {
			double time;
			result3.get("time", time);
			cooldown_time = int(time);
		}
	}
	
	// Montar dados
	if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0 && dest_map != "" && items != "") {
		string data = "mapgate_multi:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" +
		              int(dest_x) + ":" + int(dest_y) + ":" + dest_map + ":" +
		              items + ":" + (consume_items ? "1" : "0") + ":" +
		              (require_all ? "1" : "0") + ":" + cooldown_time + ":" +
		              message_success + ":" + message_fail;
		
		send_to_server("add_line::" + data, 13, true);
		speak(pu.get_value("Portamapa com múltiplos itens criado com sucesso!"));
	}
}

// Placeholders para funções definidas em outros lugares
void craftmenu() {
	// Fluxo provisório: usa o construtor de itens já funcional.
	speak(pu.get_value("Abrindo construtor de itens para receitas e materiais."), true);
	item_builder_menu();
}

void weapons_menu() {
	setupmenu();
	game_menu.add_item(pu.get_value("Criar arma de fogo"), "weapon_gun");
	game_menu.add_item(pu.get_value("Criar arma corpo a corpo"), "weapon_melee");
	game_menu.add_item(pu.get_value("Voltar"), "back");
	game_menu.intro_text = pu.get_value("Menu de armas do construtor.");
	int mres = game_menu.run();
	if(mres < 0) return;
	string selected = game_menu.get_item_id(mres);
	if(selected == "weapon_gun") {
		item_builder_weapon_gun();
		return;
	}
	if(selected == "weapon_melee") {
		item_builder_weapon_melee();
		return;
	}
}

void stores_building_menu() {
	input_form form(pu.get_value("Criar Loja / Estabelecimento"));
	form.description = pu.get_value("Defina a area de balcao e o tipo da loja.");
	form.add_number_field("x1", pu.get_value("Inicio da coordenada X"), 0, true);
	form.add_number_field("x2", pu.get_value("Fim da coordenada X"), 0, true);
	form.add_number_field("y1", pu.get_value("Inicio da coordenada Y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim da coordenada Y"), 0, true);
	form.add_text_field("store_type", pu.get_value("Tipo de loja (armas, roupas, farmacia, lanchonete)"), "", true);

	dictionary@ result = form.run();
	if(form.user_canceled) return;

	double x1 = 0, x2 = 0, y1 = 0, y2 = 0;
	string store_type = "";
	result.get("x1", x1);
	result.get("x2", x2);
	result.get("y1", y1);
	result.get("y2", y2);
	result.get("store_type", store_type);
	store_type = store_type.trim_whitespace().lower();

	if(store_type == "") {
		speak(pu.get_value("Tipo de loja inválido."), true);
		return;
	}

	int minx = int(x1);
	int maxx = int(x2);
	int miny = int(y1);
	int maxy = int(y2);
	if(maxx < minx) {
		int temp = minx;
		minx = maxx;
		maxx = temp;
	}
	if(maxy < miny) {
		int temp = miny;
		miny = maxy;
		maxy = temp;
	}

	string data = "store:" + minx + ":" + maxx + ":" + miny + ":" + maxy + ":" + store_type;
	send_to_server("add_line::" + data, 13, true);
	speak(pu.get_value("Comando de criacao de loja enviado ao servidor."), true);
}

void itemsmenu() {
	item_builder_menu();
}

void clothesmenu() {
	speak(pu.get_value("Abrindo criador de armaduras e roupas."), true);
	item_builder_armor();
}

void booksmenu() {
	speak(pu.get_value("Abrindo criador de itens diversos. Use categoria livro quando aplicável."), true);
	item_builder_misc();
}

void portalsmenu() {
	input_form form(pu.get_value("Criar Portal Magico"));
	form.description = pu.get_value("Preencha os dados para criar um portal no mapa atual.");
	form.add_number_field("x", pu.get_value("Coordenada X do portal"), 0, true);
	form.add_number_field("y", pu.get_value("Coordenada Y do portal"), 0, true);
	form.add_text_field("dest_map", pu.get_value("Mapa de destino"), "", true);
	form.add_number_field("dest_x", pu.get_value("Coordenada X de destino"), 0, true);
	form.add_number_field("dest_y", pu.get_value("Coordenada Y de destino"), 0, true);

	dictionary@ result = form.run();
	if(form.user_canceled) return;

	double x = 0, y = 0, dest_x = 0, dest_y = 0;
	string dest_map = "";
	result.get("x", x);
	result.get("y", y);
	result.get("dest_x", dest_x);
	result.get("dest_y", dest_y);
	result.get("dest_map", dest_map);
	dest_map = dest_map.trim_whitespace().lower();

	if(dest_map == "") {
		speak(pu.get_value("Mapa de destino inválido."), true);
		return;
	}

	string data = "portal:" + int(x) + ":" + int(y) + ":" + dest_map + ":" + int(dest_x) + ":" + int(dest_y);
	send_to_server("add_line::" + data, 13, true);
	speak(pu.get_value("Comando de criacao de portal enviado ao servidor."), true);
}

void correccionmenu() {
	setupmenu();
	game_menu.add_item(pu.get_value("Obter código bruto do mapa"), "rawmap");
	game_menu.add_item(pu.get_value("Desfazer última alteração"), "undo");
	game_menu.add_item(pu.get_value("Remover elemento por linha"), "disable");
	game_menu.add_item(pu.get_value("Voltar"), "back");
	game_menu.intro_text = pu.get_value("Opções avançadas do construtor.");
	int mres = game_menu.run();
	if(mres < 0) return;
	string selected = game_menu.get_item_id(mres);
	if(selected == "rawmap") {
		send_to_server("/rawmap", 1, false);
		return;
	}
	if(selected == "undo") {
		builder_undo_last();
		return;
	}
	if(selected == "disable") {
		builder_disable_element();
		return;
	}
}

