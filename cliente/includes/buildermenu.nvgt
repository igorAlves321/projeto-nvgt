	form.add_number_field("y1", pu.get_value("Início da coordenada y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim da coordenada y"), 0, true);
	form.add_text_field("sound", pu.get_value("Nome da música"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x1, x2, y1, y2;
		string sound_name;
		result.get("x1", x1); result.get("x2", x2);
		result.get("y1", y1); result.get("y2", y2);
		result.get("sound", sound_name);
		
		if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0 && sound_name != "") {
			string data = "ss2:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" + sound_name;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

// Definir localização do mapa
void builder_set_location() {
	input_form form(pu.get_value("Localização"));
	form.add_text_field("location", pu.get_value("Nova localização que aparecerá ao dar F1"), "", true);
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		string location;
		result.get("location", location);
		if(location != "") {
