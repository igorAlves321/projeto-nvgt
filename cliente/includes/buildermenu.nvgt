// Definir localização do mapa
void builder_set_location() {
	input_form form(pu.get_value("Localização"));
	form.add_text_field("location", pu.get_value("Nova localização que aparecerá ao dar F1"), "", true);
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		string location;
		result.get("location", location);
		if(location != "") {
			send_to_server("add_line::where:" + location, 13, true);
		}
	}
}

// Criar coordenadas de respawn
void builder_create_respawn_coords() {
	input_form form(pu.get_value("Coordenadas de reaparecimento"));
	form.add_number_field("x1", pu.get_value("Início da coordenada x"), 0, true);
	form.add_number_field("x2", pu.get_value("Fim da coordenada x"), 0, true);
	form.add_number_field("y1", pu.get_value("Início da coordenada y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim da coordenada y"), 0, true);
	form.add_number_field("respawn_x", pu.get_value("Coordenada x de reaparecimento"), 0, true);
	form.add_number_field("respawn_y", pu.get_value("Coordenada y de reaparecimento"), 0, true);
	form.add_text_field("prev_map", pu.get_value("Mapa anterior necessário"), "", true);
	form.add_text_field("message", pu.get_value("Mensagem ao atravessar"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x1, x2, y1, y2, respawn_x, respawn_y;
		string prev_map, message;
		result.get("x1", x1); result.get("x2", x2);
		result.get("y1", y1); result.get("y2", y2);
		result.get("respawn_x", respawn_x); result.get("respawn_y", respawn_y);
		result.get("prev_map", prev_map); result.get("message", message);
		
		if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0) {
			string data = "newymap:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" +
			              int(respawn_x) + ":" + int(respawn_y) + ":" + prev_map + ":" + message;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

