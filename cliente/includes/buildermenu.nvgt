	if(!form.user_canceled) {
		double x1, x2, y1, y2;
		string sound;
		result.get("x1", x1); result.get("x2", x2);
		result.get("y1", y1); result.get("y2", y2);
		result.get("sound", sound);
		
		if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0) {
			send_to_server("add_line::w2:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" + sound, 13, true);
		}
	}
}

// Deletar mapa
void builder_delete_map() {
	input_form form(pu.get_value("Deletar mapa"));
	form.description = pu.get_value("ATENÇÃO: Isso deletará permanentemente o mapa!");
	form.add_text_field("mapname", pu.get_value("Nome do mapa a eliminar"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		string mapname;
		result.get("mapname", mapname);
		if(mapname != "") {
			bool confirm = simple_yes_no(pu.get_value("Tem certeza que deseja deletar o mapa ") + mapname + "?");
			if(confirm) {
				send_to_server("/delmap " + mapname, 1, false);
			}
		}
	}
}

// Criar passagem
void builder_create_passage() {
	input_form form(pu.get_value("Passagem"));
	form.add_number_field("x1", pu.get_value("Início x"), 0, true);
	form.add_number_field("x2", pu.get_value("Fim x"), 0, true);
	form.add_number_field("y1", pu.get_value("Início y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim y"), 0, true);
	form.add_number_field("dest_x", pu.get_value("Destino x"), 0, true);
	form.add_number_field("dest_y", pu.get_value("Destino y"), 0, true);
	form.add_text_field("dest_map", pu.get_value("Mapa de destino"), "", true);
	form.add_text_field("message", pu.get_value("Mensagem ao chegar"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x1, x2, y1, y2, dest_x, dest_y;
		string dest_map, message;
		result.get("x1", x1); result.get("x2", x2); result.get("y1", y1); result.get("y2", y2);
		result.get("dest_x", dest_x); result.get("dest_y", dest_y);
		result.get("dest_map", dest_map); result.get("message", message);
		
		if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0 && dest_map != "") {
			string data = "tp:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" +
			              int(dest_x) + ":" + int(dest_y) + ":" + dest_map + ":" + message;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

