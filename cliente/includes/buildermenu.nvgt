	form.add_number_field("life", pu.get_value("Vida da árvore"), 100, true);
	form.add_number_field("respawn_time", pu.get_value("Tempo para reaparecer (ms)"), 60000, true);
	form.add_text_field("name", pu.get_value("Nome da árvore (ao pressionar M)"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x, y1, y2, life, respawn_time;
		string name;
		result.get("x", x); result.get("y1", y1); result.get("y2", y2);
		result.get("life", life); result.get("respawn_time", respawn_time); result.get("name", name);
		
		bool spawn_items = simple_yes_no(pu.get_value("Spawnará itens ao cair?"));
		string s6 = spawn_items ? "1" : "0";
		string s7 = "nada";
		
		if(spawn_items) {
			input_form form2(pu.get_value("Itens da árvore"));
			form2.add_text_field("items", pu.get_value("Itens (item.1,item2.2)"), "", true);
			dictionary@ result2 = form2.run();
			if(!form2.user_canceled) {
				result2.get("items", s7);
			}
		}
		
		if(x > 0 && y1 > 0 && y2 > 0 && name != "") {
			string data = "arbol:" + int(x) + ":" + int(y1) + ":" + int(y2) + ":" + int(life) + ":" +
			              int(respawn_time) + ":" + s6 + ":" + s7 + ":" + name;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

// Criar parede com vida
void builder_create_wall_with_life() {
	input_form form(pu.get_value("Parede com vida"));
	form.add_number_field("x", pu.get_value("Coordenada x"), 0, true);
	form.add_number_field("y1", pu.get_value("Início y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim y"), 0, true);
	form.add_number_field("life", pu.get_value("Vida da parede"), 100, true);
	form.add_number_field("respawn_time", pu.get_value("Tempo para reaparecer"), 60000, true);
	form.add_text_field("name", pu.get_value("Nome (ao pressionar M)"), "", true);
	form.add_text_field("hit_sound", pu.get_value("Som ao chocar (sem .ogg)"), "wall", true);
	form.add_text_field("break_sound", pu.get_value("Som ao quebrar (sem .ogg)"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x, y1, y2, life, respawn_time;
		string name, hit_sound, break_sound;
		result.get("x", x); result.get("y1", y1); result.get("y2", y2);
		result.get("life", life); result.get("respawn_time", respawn_time);
		result.get("name", name); result.get("hit_sound", hit_sound); result.get("break_sound", break_sound);
		
		bool spawn_items = simple_yes_no(pu.get_value("Spawnará itens ao cair?"));
		string s6 = spawn_items ? "1" : "0";
		string s7 = "nada";
		
		if(spawn_items) {
			input_form form2(pu.get_value("Itens"));
			form2.add_text_field("items", pu.get_value("Itens (item.1,item2.2)"), "", true);
			dictionary@ result2 = form2.run();
			if(!form2.user_canceled) {
				result2.get("items", s7);
			}
		}
		
		if(x > 0 && y1 > 0 && y2 > 0) {
			string data = "wall:" + int(x) + ":" + int(y1) + ":" + int(y2) + ":" + int(life) + ":" +
			              int(respawn_time) + ":" + s6 + ":" + s7 + ":" + name + ":" + hit_sound + ":" + break_sound;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

