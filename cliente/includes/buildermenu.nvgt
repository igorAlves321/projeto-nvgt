// Deletar mapa
void builder_delete_map() {
	input_form form(pu.get_value("Deletar mapa"));
	form.description = pu.get_value("ATENÇÃO: Isso deletará permanentemente o mapa!");
	form.add_text_field("mapname", pu.get_value("Nome do mapa a eliminar"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		string mapname;
		result.get("mapname", mapname);
		if(mapname != "") {
			bool confirm = simple_yes_no(pu.get_value("Tem certeza que deseja deletar o mapa ") + mapname + "?");
			if(confirm) {
				send_to_server("/delmap " + mapname, 1, false);
			}
		}
	}
}

// Criar passagem
void builder_create_passage() {
	input_form form(pu.get_value("Passagem"));
	form.add_number_field("x1", pu.get_value("Início x"), 0, true);
	form.add_number_field("x2", pu.get_value("Fim x"), 0, true);
	form.add_number_field("y1", pu.get_value("Início y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim y"), 0, true);
	form.add_number_field("dest_x", pu.get_value("Destino x"), 0, true);
	form.add_number_field("dest_y", pu.get_value("Destino y"), 0, true);
	form.add_text_field("dest_map", pu.get_value("Mapa de destino"), "", true);
	form.add_text_field("message", pu.get_value("Mensagem ao chegar"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		double x1, x2, y1, y2, dest_x, dest_y;
		string dest_map, message;
		result.get("x1", x1); result.get("x2", x2); result.get("y1", y1); result.get("y2", y2);
		result.get("dest_x", dest_x); result.get("dest_y", dest_y);
		result.get("dest_map", dest_map); result.get("message", message);
		
		if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0 && dest_map != "") {
			string data = "tp:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" +
			              int(dest_x) + ":" + int(dest_y) + ":" + dest_map + ":" + message;
			send_to_server("add_line::" + data, 13, true);
		}
	}
}

// Passagem cronometrada (timed passage)
void builder_create_timed_passage() {
	input_form form(pu.get_value("Passagem cronometrada - Parte 1"));
	form.description = pu.get_value("Crie uma passagem que só funciona em horários específicos.");
	form.add_number_field("x1", pu.get_value("Início x"), 0, true);
	form.add_number_field("x2", pu.get_value("Fim x"), 0, true);
	form.add_number_field("y1", pu.get_value("Início y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim y"), 0, true);
	form.add_number_field("dest_x", pu.get_value("Destino x"), 0, true);
	form.add_number_field("dest_y", pu.get_value("Destino y"), 0, true);
	form.add_text_field("dest_map", pu.get_value("Mapa de destino"), "", true);
	
	dictionary@ result = form.run();
	if(form.user_canceled) return;
	
	double x1, x2, y1, y2, dest_x, dest_y;
	string dest_map;
	result.get("x1", x1); result.get("x2", x2);
	result.get("y1", y1); result.get("y2", y2);
	result.get("dest_x", dest_x); result.get("dest_y", dest_y);
	result.get("dest_map", dest_map);
	
	// Parte 2: Configuração de tempo
	input_form form2(pu.get_value("Passagem cronometrada - Parte 2"));
	form2.description = pu.get_value("Configure os horários de funcionamento.");
	form2.add_number_field("start_hour", pu.get_value("Hora de início (0-23)"), 0, true);
	form2.add_number_field("start_minute", pu.get_value("Minuto de início (0-59)"), 0, true);
	form2.add_number_field("end_hour", pu.get_value("Hora de fim (0-23)"), 23, true);
	form2.add_number_field("end_minute", pu.get_value("Minuto de fim (0-59)"), 59, true);
	form2.add_text_field("message_active", pu.get_value("Mensagem quando ativo"), "", false);
	form2.add_text_field("message_inactive", pu.get_value("Mensagem quando inativo"), "", false);
	
	dictionary@ result2 = form2.run();
	if(form2.user_canceled) return;
	
	double start_hour, start_minute, end_hour, end_minute;
	string message_active, message_inactive;
	result2.get("start_hour", start_hour); result2.get("start_minute", start_minute);
	result2.get("end_hour", end_hour); result2.get("end_minute", end_minute);
	result2.get("message_active", message_active); result2.get("message_inactive", message_inactive);
	
	// Parte 3: Configurações adicionais
	bool weekdays_only = simple_yes_no(pu.get_value("Funciona apenas em dias de semana (seg-sex)?"));
	bool weekends_only = simple_yes_no(pu.get_value("Funciona apenas em fins de semana (sáb-dom)?"));
	bool require_item = simple_yes_no(pu.get_value("Requer item para atravessar?"));
	
	string required_item = "none";
	int required_qty = 0;
	
	if(require_item) {
		input_form form3(pu.get_value("Item requerido"));
		form3.add_text_field("item", pu.get_value("Nome do item"), "", true);
		form3.add_number_field("qty", pu.get_value("Quantidade"), 1, true);
		
		dictionary@ result3 = form3.run();
		if(!form3.user_canceled) {
			double qty;
			result3.get("item", required_item);
			result3.get("qty", qty);
			required_qty = int(qty);
		}
	}
	
	// Montar dados
	if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0 && dest_map != "") {
		string weekday_flag = weekdays_only ? "1" : (weekends_only ? "2" : "0");
		
		string data = "timed_passage:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" +
		              int(dest_x) + ":" + int(dest_y) + ":" + dest_map + ":" +
		              int(start_hour) + ":" + int(start_minute) + ":" +
		              int(end_hour) + ":" + int(end_minute) + ":" +
		              weekday_flag + ":" + required_item + ":" + required_qty + ":" +
		              message_active + ":" + message_inactive;
		
		send_to_server("add_line::" + data, 13, true);
		speak(pu.get_value("Passagem cronometrada criada com sucesso!"));
	}
}

// Portamapa (mapgate) - Portal que leva a outro mapa
void builder_create_mapgate() {
	input_form form(pu.get_value("Portamapa - Parte 1"));
	form.description = pu.get_value("Crie um portal para outro mapa.");
	form.add_number_field("x1", pu.get_value("Início x"), 0, true);
	form.add_number_field("x2", pu.get_value("Fim x"), 0, true);
	form.add_number_field("y1", pu.get_value("Início y"), 0, true);
	form.add_number_field("y2", pu.get_value("Fim y"), 0, true);
	form.add_number_field("dest_x", pu.get_value("Coordenada x de destino"), 0, true);
	form.add_number_field("dest_y", pu.get_value("Coordenada y de destino"), 0, true);
	form.add_text_field("dest_map", pu.get_value("Mapa de destino"), "", true);
	
	dictionary@ result = form.run();
	if(form.user_canceled) return;
	
	double x1, x2, y1, y2, dest_x, dest_y;
	string dest_map;
	result.get("x1", x1); result.get("x2", x2);
	result.get("y1", y1); result.get("y2", y2);
	result.get("dest_x", dest_x); result.get("dest_y", dest_y);
	result.get("dest_map", dest_map);
	
	// Parte 2: Configurações
	input_form form2(pu.get_value("Portamapa - Parte 2"));
	form2.add_text_field("message", pu.get_value("Mensagem ao atravessar"), "", false);
	form2.add_text_field("sound", pu.get_value("Som ao atravessar (sem .ogg)"), "", false);
	form2.add_number_field("cooldown", pu.get_value("Tempo de espera entre usos (ms)"), 0, false);
	
	dictionary@ result2 = form2.run();
	if(form2.user_canceled) return;
	
	string message, sound_name;
	double cooldown;
	result2.get("message", message);
	result2.get("sound", sound_name);
	result2.get("cooldown", cooldown);
	
	// Restrições opcionais
	bool require_level = simple_yes_no(pu.get_value("Requer nível mínimo?"));
	int min_level = 0;
	
	if(require_level) {
		input_form form3(pu.get_value("Nível mínimo"));
		form3.add_number_field("level", pu.get_value("Nível mínimo necessário"), 1, true);
		dictionary@ result3 = form3.run();
		if(!form3.user_canceled) {
			double level;
			result3.get("level", level);
			min_level = int(level);
		}
	}
	
	bool team_only = simple_yes_no(pu.get_value("Apenas para membros de equipe?"));
	bool pvp_disabled = simple_yes_no(pu.get_value("Desabilitar PVP ao atravessar?"));
	
	// Montar dados
	if(x1 > 0 && x2 > 0 && y1 > 0 && y2 > 0 && dest_map != "") {
		string data = "mapgate:" + int(x1) + ":" + int(x2) + ":" + int(y1) + ":" + int(y2) + ":" +
		              int(dest_x) + ":" + int(dest_y) + ":" + dest_map + ":" +
		              message + ":" + sound_name + ":" + int(cooldown) + ":" +
		              min_level + ":" + (team_only ? "1" : "0") + ":" + (pvp_disabled ? "1" : "0");
		
		send_to_server("add_line::" + data, 13, true);
		speak(pu.get_value("Portamapa criado com sucesso!"));
	}
}

