// Dar item para jogador
void admin_give_item() {
	input_form form(pu.get_value("Dar item"));
	form.add_text_field("player", pu.get_value("para qual jogador deseja dar um objeto?"), "", true);
	form.add_text_field("item", pu.get_value("qual?"), "", true);
	form.add_number_field("amount", pu.get_value("quantos?"), 1, true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		string player = "";
		string item = "";
		double amount = 0;
		result.get("player", player);
		result.get("item", item);
		result.get("amount", amount);
		
		if(player != "" && item != "" && amount > 0) {
			game_net.send(net_peer_id, encrypt_packet("/dar " + player + " " + item + " " + int(amount)), 1, false);
		}
	}
}

