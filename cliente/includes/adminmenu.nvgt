// ============================================================================
// FUNÇÕES AUXILIARES
// ============================================================================

// Upload de arquivo de áudio
void uploadfile() {
    string selected_file = soundsmenu();
    
    if(selected_file == "") {
        speak(pu.get_value("Cancelado."));
        return;
    }
    
    if(!file_exists(selected_file)) {
        speak(pu.get_value("Arquivo não encontrado: ") + selected_file);
        return;
    }
    
    file f;
    if(!f.open(selected_file, "rb")) {
        speak(pu.get_value("Erro ao abrir arquivo."));
        return;
    }
    
    // Obter tamanho do arquivo
    int file_size = f.size;
    
    if(file_size > 5 * 1024 * 1024) {
        speak(pu.get_value("Arquivo muito grande. Máximo: 5 MB"));
        f.close();
        return;
    }
    
    string file_data = f.read(file_size);
    f.close();
    
    string encoded_data = string_base64_encode(file_data);
    string filename = string_split(selected_file, "/")[-1];
    
    bool confirm = simple_yes_no(pu.get_value("Enviar ") + filename + " (" + (file_size / 1024) + " KB)?");
    
    if(!confirm) {
        speak(pu.get_value("Cancelado."));
        return;
    }
    
    speak(pu.get_value("Enviando..."));
    
    int chunk_size = 8192;
    int total_chunks = (encoded_data.length() + chunk_size - 1) / chunk_size;
    
    send_to_server("/upload_start " + filename + " " + total_chunks, 1, true);
    wait(100);
    
    for(int i = 0; i < total_chunks; i++) {
        int start = i * chunk_size;
        int end = start + chunk_size;
        if(end > int(encoded_data.length())) end = encoded_data.length();
        
        string chunk = encoded_data.substr(start, end - start);
        send_to_server("/upload_chunk " + i + " " + chunk, 1, true);
        wait(50);
        
        if(i % 10 == 0) {
            speak(pu.get_value("Enviando... ") + ((i * 100) / total_chunks) + "%");
        }
    }
    
    send_to_server("/upload_finish", 1, true);
    speak(pu.get_value("Arquivo enviado!"));
}

// Menu de traduções
void langs_menu() {
    while(true) {
        setupmenu();
        
        game_menu.add_item(pu.get_value("Adicionar tradução"), "add");
        game_menu.add_item(pu.get_value("Editar tradução"), "edit");
        game_menu.add_item(pu.get_value("Listar traduções"), "list");
        game_menu.add_item(pu.get_value("Estatísticas"), "stats");
        game_menu.add_item(pu.get_value("Voltar"), "voltar");
        
        game_menu.intro_text = pu.get_value("Gerenciamento de Traduções");
        int mres = game_menu.run();
        string selected = game_menu.get_item_id(mres);
        
        if(selected == "voltar" || mres == -1) {
            return;
        }
        
        if(selected == "add") {
            langs_add_translation();
        }
        else if(selected == "edit") {
            langs_edit_translation();
        }
        else if(selected == "list") {
            send_to_server("list_translations:", 1, false);
        }
        else if(selected == "stats") {
            send_to_server("translation_stats", 1, false);
        }
    }
}

void langs_add_translation() {
    input_form form(pu.get_value("Adicionar Tradução"));
    form.add_text_field("key", pu.get_value("Chave"), "", true);
    form.add_text_field("pt", pu.get_value("Português"), "", true);
    form.add_text_field("en", pu.get_value("Inglês"), "", false);
    form.add_text_field("es", pu.get_value("Espanhol"), "", false);
    form.add_text_field("fr", pu.get_value("Francês"), "", false);
    
    dictionary@ result = form.run();
    if(!form.user_canceled) {
        string key, pt, en, es, fr;
        result.get("key", key);
        result.get("pt", pt);
        result.get("en", en);
        result.get("es", es);
        result.get("fr", fr);
        
        if(key != "" && pt != "") {
            send_to_server("add_translation:" + key + "|" + pt + "|" + en + "|" + es + "|" + fr, 1, true);
            speak(pu.get_value("Tradução adicionada!"));
        }
    }
}

void langs_edit_translation() {
    input_form form(pu.get_value("Editar Tradução"));
    form.add_text_field("key", pu.get_value("Chave da tradução"), "", true);
    
    dictionary@ result = form.run();
    if(!form.user_canceled) {
        string key;
        result.get("key", key);
        
        if(key != "") {
            input_form form2(pu.get_value("Editar: ") + key);
            form2.add_text_field("pt", pu.get_value("Português"), "", false);
            form2.add_text_field("en", pu.get_value("Inglês"), "", false);
            form2.add_text_field("es", pu.get_value("Espanhol"), "", false);
            form2.add_text_field("fr", pu.get_value("Francês"), "", false);
            
            dictionary@ result2 = form2.run();
            if(!form2.user_canceled) {
                string pt, en, es, fr;
                result2.get("pt", pt);
                result2.get("en", en);
                result2.get("es", es);
                result2.get("fr", fr);
                
                send_to_server("edit_translation:" + key + "|" + pt + "|" + en + "|" + es + "|" + fr, 1, true);
                speak(pu.get_value("Tradução atualizada!"));
            }
        }
    }
}

// Função auxiliar para obter som
string get_sound(string title, string filter, bool first_letter) {
    string pattern = first_letter ? ("sounds/" + filter + "*.ogg") : ("sounds/*" + filter + "*.ogg");
    string[]@ sound_files = glob(pattern);
    
    if(sound_files.length() == 0) {
        speak(pu.get_value("Nenhum som encontrado com: ") + filter);
        return "";
    }
    
    setupmenu();
    
    for(uint i = 0; i < sound_files.length(); i++) {
        string filename = string_split(sound_files[i], "/")[-1];
        filename = filename.replace(".ogg", "");
        game_menu.add_item(filename, sound_files[i]);
    }
    
    game_menu.intro_text = title + " - " + sound_files.length() + " encontrados";
    int mres = game_menu.run();
    
    if(mres > 0) {
        string selected = game_menu.get_item_id(mres);
        return string_split(selected, "/")[-1].replace(".ogg", "");
    }
    
    return "";
}

// soundsmenu() - já definida em menu.nvgt

// Função de confirmação simples
bool simple_yes_no(string question) {
    setupmenu();
    game_menu.add_item(pu.get_value("Sim"), "yes");
    game_menu.add_item(pu.get_value("Não"), "no");
    
    game_menu.intro_text = question;
    int mres = game_menu.run();
    string selected = game_menu.get_item_id(mres);
    
    return (selected == "yes");
}

