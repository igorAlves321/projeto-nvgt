// ============================================================================
// MENU ADMINISTRATIVO - NVGT
// Sistema de menus organizados por categorias para administradores
// ============================================================================

// menu.nvgt já é incluído pelo client.nvgt
#include "buildermenu.nvgt"
#include "item_builder.nvgt"

// Estado de observação (para toggle no menu)
bool admin_watching = false;
string admin_watching_target = "";

// Estados locais para rótulos dinâmicos no menu "Diversos"
bool admin_game_frozen = false;
bool admin_xp_especial_enabled = false;
bool admin_pvp_enabled = true;
bool admin_minas_enabled = true;

// Sons do menu administrativo
const string ADMIN_SOUND_OPEN = "menuadmin.ogg";
const string ADMIN_SOUND_CATEGORY = "menucategory.ogg";
const string ADMIN_SOUND_SELECT = "menuselect.ogg";
const string ADMIN_SOUND_BACK = "menuback.ogg";
const string ADMIN_SOUND_ERROR = "menuerror.ogg";
const string ADMIN_SOUND_SUCCESS = "menusuccess.ogg";
const string ADMIN_SOUND_WARNING = "menuerror.ogg";

// Tocar som do menu admin
void play_admin_sound(string sound_name) {
    sound s;
    if(s.load(get_sound_path(sound_name))) {
        s.play_wait();
    }
}

// ============================================================================
// MENU PRINCIPAL ADMINISTRATIVO (F9)
// ============================================================================
void adminmenu() {
    play_admin_sound(ADMIN_SOUND_OPEN);
    
    while(true) {
        setupmenu();
        
        // Categorias principais
        game_menu.add_item(pu.get_value("Construtor de Mapas"), "construtor");
        game_menu.add_item(pu.get_value("Construtor de Itens"), "item_builder");
        game_menu.add_item(pu.get_value("Gestão de Jogadores"), "jogadores");
        game_menu.add_item(pu.get_value("Diversos"), "diversos");
        
        // Categoria de desenvolvedor só aparece para devs
        if(desenvolvedordm == 1) {
            game_menu.add_item(pu.get_value("Desenvolvedor"), "dev");
        }
        
        game_menu.add_item(pu.get_value("Voltar"), "voltar");
        
        game_menu.intro_text = pu.get_value("Menu Administrativo. Escolha uma categoria.");
        int mres = game_menu.run();
        string selected = game_menu.get_item_id(mres);
        
        if(selected == "voltar" || mres == -1) {
            play_admin_sound(ADMIN_SOUND_BACK);
            return;
        }
        
        play_admin_sound(ADMIN_SOUND_CATEGORY);
        
        if(selected == "construtor") {
            admin_menu_construtor();
        }
        else if(selected == "item_builder") {
            item_builder_menu();
        }
        else if(selected == "jogadores") {
            admin_menu_jogadores();
        }
        else if(selected == "diversos") {
            admin_menu_diversos();
        }
        else if(selected == "dev") {
            admin_menu_dev();
        }
    }
}

// ============================================================================
// 1. MENU CONSTRUTOR DE MAPAS
// ============================================================================
void admin_menu_construtor() {
    // Chama diretamente o buildermenu existente
    buildermenu();
}

// ============================================================================
// 2. MENU GESTÃO DE JOGADORES
// ============================================================================
void admin_menu_jogadores() {
    while(true) {
        setupmenu();
        
        // Sanções
        game_menu.add_item(pu.get_value("Banir jogador temporariamente"), "ban_temp");
        game_menu.add_item(pu.get_value("Banir jogador permanentemente"), "ban_perm");
        game_menu.add_item(pu.get_value("Desbanir jogador"), "unban");
        game_menu.add_item(pu.get_value("Kickar jogador"), "kick");
        game_menu.add_item(pu.get_value("Silenciar jogador"), "silenciar");
        game_menu.add_item(pu.get_value("Remover silêncio"), "unsilenciar");
        
        // Prisão
        game_menu.add_item(pu.get_value("Prender jogador"), "prender");
        game_menu.add_item(pu.get_value("Soltar jogador"), "soltar");
        
        // Teleporte
        game_menu.add_item(pu.get_value("Ir até jogador"), "tp");
        game_menu.add_item(pu.get_value("Trazer jogador até você"), "tphere");
        game_menu.add_item(pu.get_value("Enviar jogador para mapa"), "sendmap");
        
        // Inventário
        game_menu.add_item(pu.get_value("Dar item para jogador"), "dar_item");
        game_menu.add_item(pu.get_value("Remover item do jogador"), "remover_item");
        game_menu.add_item(pu.get_value("Ver inventário do jogador"), "ver_inv");
        game_menu.add_item(pu.get_value("Dar créditos"), "dar_creditos");
        game_menu.add_item(pu.get_value("Dar Stryx"), "dar_stryx");
        
        // Outros
        game_menu.add_item(pu.get_value("Ver informações do jogador"), "info");
        
        // Toggle observar - muda texto baseado no estado atual
        if(admin_watching) {
            game_menu.add_item(pu.get_value("Parar de observar (") + admin_watching_target + ")", "toggle_observar");
        } else {
            game_menu.add_item(pu.get_value("Observar jogador"), "toggle_observar");
        }
        
        game_menu.add_item(pu.get_value("Voltar"), "voltar");
        
        game_menu.intro_text = pu.get_value("Gestão de Jogadores. Escolha uma ação.");
        int mres = game_menu.run();
        string selected = game_menu.get_item_id(mres);
        
        if(selected == "voltar" || mres == -1) {
            play_admin_sound(ADMIN_SOUND_BACK);
            return;
        }
        
        play_admin_sound(ADMIN_SOUND_SELECT);
        
        // Processar ações de jogadores
        process_jogadores_action(selected);
    }
}

void process_jogadores_action(string action) {
    if(action == "ban_temp") {
        admin_ban_temp();
    }
    else if(action == "ban_perm") {
        admin_ban_perm();
    }
    else if(action == "unban") {
        admin_unban();
    }
    else if(action == "kick") {
        admin_kick();
    }
    else if(action == "silenciar") {
        admin_silenciar();
    }
    else if(action == "unsilenciar") {
        admin_unsilenciar();
    }
    else if(action == "prender") {
        admin_prender();
    }
    else if(action == "soltar") {
        admin_soltar();
    }
    else if(action == "tp") {
        admin_tp();
    }
    else if(action == "tphere") {
        admin_tphere();
    }
    else if(action == "sendmap") {
        admin_sendmap();
    }
    else if(action == "dar_item") {
        admin_dar_item();
    }
    else if(action == "remover_item") {
        admin_remover_item();
    }
    else if(action == "ver_inv") {
        admin_ver_inv();
    }
    else if(action == "dar_creditos") {
        admin_dar_creditos();
    }
    else if(action == "dar_stryx") {
        admin_dar_stryx();
    }
    else if(action == "info") {
        admin_info_jogador();
    }
    else if(action == "toggle_observar") {
        admin_toggle_observar();
    }
}

// ============================================================================
// 3. MENU DIVERSOS
// ============================================================================
void admin_menu_diversos() {
    while(true) {
        setupmenu();
        
        // Servidor
        game_menu.add_item(pu.get_value("Reiniciar servidor"), "reiniciar");
        game_menu.add_item(pu.get_value(admin_game_frozen ? "Descongelar jogo" : "Congelar jogo"), "toggle_congelar");
        
        // Combate e XP
        game_menu.add_item(pu.get_value(admin_xp_especial_enabled ? "Desativar XP especial" : "Ativar XP especial"), "xp_especial");
        game_menu.add_item(pu.get_value(admin_pvp_enabled ? "Desativar PvP" : "Ativar PvP"), "pvp");
        game_menu.add_item(pu.get_value(admin_minas_enabled ? "Desativar minas" : "Ativar minas"), "minas");
        
        // Ações em jogadores
        game_menu.add_item(pu.get_value("Matar jogador"), "matar");
        game_menu.add_item(pu.get_value("Curar jogador"), "curar");
        game_menu.add_item(pu.get_value("Reviver jogador"), "reviver");
        
        // Comunicação
        game_menu.add_item(pu.get_value("Aviso global"), "aviso");
        game_menu.add_item(pu.get_value("Mensagem do dia - Admin"), "motd_admin");
        game_menu.add_item(pu.get_value("Mensagem do dia - Português"), "motd_pt");
        game_menu.add_item(pu.get_value("Mensagem do dia - Inglês"), "motd_en");
        game_menu.add_item(pu.get_value("Mensagem do dia - Espanhol"), "motd_es");
        game_menu.add_item(pu.get_value("Mensagem do dia - Francês"), "motd_fr");
        
        // Presentes
        game_menu.add_item(pu.get_value("Dar presente para todos"), "presente");
        
        game_menu.add_item(pu.get_value("Voltar"), "voltar");
        
        game_menu.intro_text = pu.get_value("Diversos. Escolha uma ação.");
        int mres = game_menu.run();
        string selected = game_menu.get_item_id(mres);
        
        if(selected == "voltar" || mres == -1) {
            play_admin_sound(ADMIN_SOUND_BACK);
            return;
        }
        
        play_admin_sound(ADMIN_SOUND_SELECT);
        
        // Processar ações diversas
        process_diversos_action(selected);
    }
}

void process_diversos_action(string action) {
    if(action == "reiniciar") {
        admin_reiniciar_servidor();
    }
    else if(action == "toggle_congelar") {
        if(admin_game_frozen) {
            send_to_server("/unfreeze", 1, false);
            speak(pu.get_value("Jogo descongelado."));
            admin_game_frozen = false;
        } else {
            send_to_server("/freeze", 1, false);
            speak(pu.get_value("Jogo congelado."));
            admin_game_frozen = true;
        }
    }
    else if(action == "xp_especial") {
        send_to_server("/xps", 1, false);
        admin_xp_especial_enabled = !admin_xp_especial_enabled;
    }
    else if(action == "pvp") {
        send_to_server("/pvp", 1, false);
        admin_pvp_enabled = !admin_pvp_enabled;
    }
    else if(action == "minas") {
        send_to_server("/amina", 1, false);
        admin_minas_enabled = !admin_minas_enabled;
    }
    else if(action == "matar") {
        admin_matar_jogador();
    }
    else if(action == "curar") {
        admin_curar_jogador();
    }
    else if(action == "reviver") {
        admin_reviver_jogador();
    }
    else if(action == "aviso") {
        admin_aviso_global();
    }
    else if(action == "motd_admin") {
        admin_set_motd("/msga", "Admin");
    }
    else if(action == "motd_pt") {
        admin_set_motd("/msgpt", "Português");
    }
    else if(action == "motd_en") {
        admin_set_motd("/msgen", "Inglês");
    }
    else if(action == "motd_es") {
        admin_set_motd("/msges", "Espanhol");
    }
    else if(action == "motd_fr") {
        admin_set_motd("/msgfr", "Francês");
    }
    else if(action == "presente") {
        admin_presente_todos();
    }
}

// ============================================================================
// 4. MENU DESENVOLVEDOR (APENAS DEVS)
// ============================================================================
void admin_menu_dev() {
    while(true) {
        setupmenu();
        
        // Sistema
        game_menu.add_item(pu.get_value("Reiniciar servidor imediatamente"), "rb");
        game_menu.add_item(pu.get_value("Fazer backup do banco"), "backup");
        game_menu.add_item(pu.get_value("Recarregar configurações"), "reload");
        
        // Debug
        game_menu.add_item(pu.get_value("Modo invisível"), "invisivel");
        game_menu.add_item(pu.get_value("Modo invencível"), "invencivel");
        game_menu.add_item(pu.get_value("Ver logs do servidor"), "logs");
        game_menu.add_item(pu.get_value("Ver estatísticas do servidor"), "stats");
        
        // Gerenciamento de cargos
        game_menu.add_item(pu.get_value("Adicionar cargo a jogador"), "add_cargo");
        game_menu.add_item(pu.get_value("Remover cargo de jogador"), "remove_cargo");
        game_menu.add_item(pu.get_value("Ver cargos de jogador"), "ver_cargos");
        game_menu.add_item(pu.get_value("Listar equipe"), "listar_equipe");
        
        // Sons e Arquivos
        game_menu.add_item(pu.get_value("Filtrar sons do jogo"), "filtrar_sons");
        game_menu.add_item(pu.get_value("Enviar áudio para servidor"), "upload_audio");
        
        // Traduções
        game_menu.add_item(pu.get_value("Gerenciar traduções"), "traducoes");
        
        // Forçar ações
        game_menu.add_item(pu.get_value("Forçar salvar todos"), "force_save");
        game_menu.add_item(pu.get_value("Forçar desconectar todos"), "force_dc");
        
        game_menu.add_item(pu.get_value("Voltar"), "voltar");
        
        game_menu.intro_text = pu.get_value("Menu de Desenvolvedor. Cuidado com as ações.");
        int mres = game_menu.run();
        string selected = game_menu.get_item_id(mres);
        
        if(selected == "voltar" || mres == -1) {
            play_admin_sound(ADMIN_SOUND_BACK);
            return;
        }
        
        play_admin_sound(ADMIN_SOUND_SELECT);
        
        // Processar ações de dev
        process_dev_action(selected);
    }
}

void process_dev_action(string action) {
    if(action == "rb") {
        bool confirm = simple_yes_no(pu.get_value("Tem certeza que deseja reiniciar o servidor AGORA?"));
        if(confirm) {
            play_admin_sound(ADMIN_SOUND_WARNING);
            send_to_server("/rb", 1, false);
            speak(pu.get_value("Reiniciando servidor..."));
        }
    }
    else if(action == "backup") {
        send_to_server("/backup", 1, false);
        play_admin_sound(ADMIN_SOUND_SUCCESS);
        speak(pu.get_value("Backup iniciado."));
    }
    else if(action == "reload") {
        send_to_server("/reload", 1, false);
        speak(pu.get_value("Configurações recarregadas."));
    }
    else if(action == "invisivel") {
        send_to_server("/invis", 1, false);
    }
    else if(action == "invencivel") {
        send_to_server("/god", 1, false);
    }
    else if(action == "logs") {
        send_to_server("/logs", 1, false);
    }
    else if(action == "stats") {
        send_to_server("/serverstats", 1, false);
    }
    else if(action == "add_cargo") {
        admin_add_cargo();
    }
    else if(action == "remove_cargo") {
        admin_remove_cargo();
    }
    else if(action == "ver_cargos") {
        admin_ver_cargos();
    }
    else if(action == "listar_equipe") {
        send_to_server("/listadmins", 1, false);
    }
    else if(action == "filtrar_sons") {
        admin_filtrar_sons();
    }
    else if(action == "upload_audio") {
        uploadfile();
    }
    else if(action == "traducoes") {
        langs_menu();
    }
    else if(action == "force_save") {
        send_to_server("/forcesave", 1, false);
        speak(pu.get_value("Salvando dados de todos os jogadores."));
    }
    else if(action == "force_dc") {
        bool confirm = simple_yes_no(pu.get_value("Isso vai desconectar TODOS os jogadores. Continuar?"));
        if(confirm) {
            send_to_server("/forcedc", 1, false);
        }
    }
}

// ============================================================================
// FUNÇÕES DE AÇÃO - GESTÃO DE JOGADORES
// ============================================================================

// Banir temporariamente
void admin_ban_temp() {
    input_form form(pu.get_value("Banir Jogador Temporariamente"));
    form.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
    form.add_number_field("days", pu.get_value("Dias de banimento"), 1, true);
    form.add_text_field("reason", pu.get_value("Motivo do banimento"), "", true);
    
    dictionary@ result = form.run();
    if(!form.user_canceled) {
        string player = "", reason = "";
        double days = 0;
        result.get("player", player);
        result.get("days", days);
        result.get("reason", reason);
        
        if(player != "" && days > 0 && reason != "") {
            send_to_server("/tb " + player + " " + int(days) + " " + reason, 1, false);
            play_admin_sound(ADMIN_SOUND_SUCCESS);
            speak(pu.get_value("Jogador banido por ") + int(days) + pu.get_value(" dias."));
        }
    }
}

// Banir permanentemente
void admin_ban_perm() {
    input_form form(pu.get_value("Banir Jogador Permanentemente"));
    form.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
    form.add_text_field("reason", pu.get_value("Motivo do banimento"), "", true);
    
    dictionary@ result = form.run();
    if(!form.user_canceled) {
        string player = "", reason = "";
        result.get("player", player);
        result.get("reason", reason);
        
        if(player != "" && reason != "") {
            bool confirm = simple_yes_no(pu.get_value("Confirma banimento PERMANENTE de ") + player + "?");
            if(confirm) {
                send_to_server("/ban " + player + " " + reason, 1, false);
                play_admin_sound(ADMIN_SOUND_SUCCESS);
                speak(pu.get_value("Jogador banido permanentemente."));
            }
        }
    }
}

// Desbanir
void admin_unban() {
    input_form form(pu.get_value("Desbanir Jogador"));
    form.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
    
    dictionary@ result = form.run();
    if(!form.user_canceled) {
        string player = "";
        result.get("player", player);
        
        if(player != "") {
            send_to_server("/unban " + player, 1, false);
            play_admin_sound(ADMIN_SOUND_SUCCESS);
            speak(pu.get_value("Jogador desbanido."));
        }
    }
}

// Kickar
void admin_kick() {
    input_form form(pu.get_value("Kickar Jogador"));
    form.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
    form.add_text_field("reason", pu.get_value("Motivo (opcional)"), "", false);
    
    dictionary@ result = form.run();
    if(!form.user_canceled) {
        string player = "", reason = "";
        result.get("player", player);
        result.get("reason", reason);
        
        if(player != "") {
            string cmd = "/kick " + player;
            if(reason != "") cmd += " " + reason;
            send_to_server(cmd, 1, false);
            play_admin_sound(ADMIN_SOUND_SUCCESS);
            speak(pu.get_value("Jogador expulso."));
        }
    }
}

// Silenciar - Com menu incremental de tempos
void admin_silenciar() {
    // Passo 1: Selecionar jogador
    input_form form_player(pu.get_value("Silenciar Jogador"));
    form_player.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
    
    dictionary@ result = form_player.run();
    if(form_player.user_canceled) return;
    
    string player = "";
    result.get("player", player);
    if(player == "") return;
    
    // Passo 2: Menu de tempos incrementais (mais acessível)
    setupmenu();
    game_menu.add_item(pu.get_value("5 Minutos"), "5");
    game_menu.add_item(pu.get_value("10 Minutos"), "10");
    game_menu.add_item(pu.get_value("20 Minutos"), "20");
    game_menu.add_item(pu.get_value("40 Minutos"), "40");
    game_menu.add_item(pu.get_value("60 Minutos (1 hora)"), "60");
    game_menu.add_item(pu.get_value("120 Minutos (2 horas)"), "120");
    game_menu.add_item(pu.get_value("1440 Minutos (24 horas)"), "1440");
    game_menu.add_item(pu.get_value("Cancelar"), "cancel");
    
    game_menu.intro_text = pu.get_value("Selecione o tempo de silêncio para ") + player + ":";
    
    int res = game_menu.run();
    if(res < 0) return;
    
    string tempo = game_menu.get_item_id(res);
    if(tempo == "cancel") return;
    
    // Enviar comando
    send_to_server("/silenciar " + player + " " + tempo, 1, true);
    play_admin_sound(ADMIN_SOUND_SUCCESS);
    speak(pu.get_value("Jogador ") + player + pu.get_value(" silenciado por ") + tempo + pu.get_value(" minutos."));
}

// Remover silêncio
void admin_unsilenciar() {
    input_form form(pu.get_value("Remover Silêncio"));
    form.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
    
    dictionary@ result = form.run();
    if(!form.user_canceled) {
        string player = "";
        result.get("player", player);
        
        if(player != "") {
            send_to_server("/unsilenciar " + player, 1, false);
            play_admin_sound(ADMIN_SOUND_SUCCESS);
            speak(pu.get_value("Silêncio removido."));
        }
    }
}

// Prender - Com menu incremental de tempos
void admin_prender() {
    // Passo 1: Selecionar jogador e motivo
    input_form form_player(pu.get_value("Prender Jogador"));
    form_player.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
    form_player.add_text_field("reason", pu.get_value("Motivo da prisão"), "", true);
    
    dictionary@ result = form_player.run();
    if(form_player.user_canceled) return;
    
    string player = "", reason = "";
    result.get("player", player);
    result.get("reason", reason);
    if(player == "" || reason == "") return;
    
    // Passo 2: Menu de tempos incrementais
    setupmenu();
    game_menu.add_item(pu.get_value("5 Minutos"), "5");
    game_menu.add_item(pu.get_value("10 Minutos"), "10");
    game_menu.add_item(pu.get_value("20 Minutos"), "20");
    game_menu.add_item(pu.get_value("30 Minutos"), "30");
    game_menu.add_item(pu.get_value("60 Minutos (1 hora)"), "60");
    game_menu.add_item(pu.get_value("120 Minutos (2 horas)"), "120");
    game_menu.add_item(pu.get_value("1440 Minutos (24 horas)"), "1440");
    game_menu.add_item(pu.get_value("Cancelar"), "cancel");
    
    game_menu.intro_text = pu.get_value("Selecione o tempo de prisão para ") + player + ":";
    
    int res = game_menu.run();
    if(res < 0) return;
    
    string tempo = game_menu.get_item_id(res);
    if(tempo == "cancel") return;
    
    // Enviar comando
    send_to_server("/prender " + player + " " + tempo + " " + reason, 1, true);
    play_admin_sound(ADMIN_SOUND_SUCCESS);
    speak(pu.get_value("Jogador ") + player + pu.get_value(" preso por ") + tempo + pu.get_value(" minutos."));
}

// Soltar
void admin_soltar() {
    input_form form(pu.get_value("Soltar Jogador"));
    form.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
    
