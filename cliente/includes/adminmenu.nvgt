// Filtrar e mostrar sons do jogo
void admin_filter_sounds() {
	input_form form(pu.get_value("Filtrar sons"));
	form.description = pu.get_value("escreva o termo com o qual queira filtrar os sons, seja uma palavra ou uma só letra se desejar que se filtre por letra inicial.");
	form.add_text_field("filter", pu.get_value("Filtro"), "", true);
	
	dictionary@ result = form.run();
	if(!form.user_canceled) {
		string filter = "";
		result.get("filter", filter);
		
		if(filter != "") {
			bool enable_first_letter = (filter.length() == 1);
			string sound_name = get_sound(pu.get_value("se mostram os sons especificados."), filter, enable_first_letter);
			
			if(sound_name != "") {
				clipboard_copy_text(sound_name);
				speak(pu.get_value("copiado."));
			}
		}
	}
}

