// Toggle Observar jogador
void admin_toggle_observar() {
    if(admin_watching) {
        // Parar de observar
        send_to_server("volhar", 0, false);
        speak(pu.get_value("Parando de observar ") + admin_watching_target);
        admin_watching = false;
        admin_watching_target = "";
    } else {
        // Começar a observar - pedir nome
        input_form form(pu.get_value("Observar Jogador"));
        form.add_text_field("player", pu.get_value("Nome do jogador"), "", true);
        
        dictionary@ result = form.run();
        if(!form.user_canceled) {
            string player = "";
            result.get("player", player);
            
            if(player != "") {
                send_to_server("olhar " + player, 0, false);
                admin_watching = true;
                admin_watching_target = player;
                speak(pu.get_value("Observando ") + player);
            }
        }
    }
}

