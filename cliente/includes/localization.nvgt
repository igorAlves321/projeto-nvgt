
string current_language_file = "lang/portuguese.lang";

bool localization_loaded = false;

bool load_language_file(const string& in filename) {
    if(pu.load(filename)) {
        current_language_file = filename;
        localization_loaded = true;
        return true;
    }

    if(filename != "lang/portuguese.lang" && pu.load("lang/portuguese.lang")) {
        current_language_file = "lang/portuguese.lang";
        localization_loaded = true;
        return true;
    }

    localization_loaded = false;
    return false;
}

bool auto_detect_language() {
    string detected_lang = "pt";

    file cfg;
    if(cfg.open("config.nvgt", "r")) {
        string content = cfg.read();
        cfg.close();

        int pos = content.find("language=");
        if(pos >= 0) {
            detected_lang = content.substr(pos + 9, 2);
        }
    }

    string lang_file;
    if(detected_lang == "pt" || detected_lang == "br") {
        lang_file = "lang/portuguese.lang";
    }
    else if(detected_lang == "en") {
        lang_file = "lang/English.lang";
    }
    else if(detected_lang == "es") {
        lang_file = "lang/spanish.lang";
    }
    else if(detected_lang == "fr") {
        lang_file = "lang/french.lang";
    }
    else {
        lang_file = "lang/portuguese.lang";
    }

    return load_language_file(lang_file);
}

string localize(const string& in key) {
    string result = pu.get_value(key);
    result = result.replace("\\n", "\n");
    return result;
}

string L(const string& in key) {
    return localize(key);
}

string localize_format(const string& in key, string[]@ args) {
    string result = localize(key);

    if(@args == null || args.length() == 0) {
        return result;
    }

    for(uint i = 0; i < args.length(); i++) {
        string placeholder = "%" + i;
        result = result.replace(placeholder, args[i]);
    }

    return result;
}

string localize_format(const string& in key, const string& in arg0) {
    string[] args = {arg0};
    return localize_format(key, args);
}

string localize_format(const string& in key, const string& in arg0, const string& in arg1) {
    string[] args = {arg0, arg1};
    return localize_format(key, args);
}

string localize_format(const string& in key, const string& in arg0, const string& in arg1, const string& in arg2) {
    string[] args = {arg0, arg1, arg2};
    return localize_format(key, args);
}

string localize_format(const string& in key, const string& in arg0, const string& in arg1, const string& in arg2, const string& in arg3) {
    string[] args = {arg0, arg1, arg2, arg3};
    return localize_format(key, args);
}

string localize_format(const string& in key, const string& in arg0, const string& in arg1, const string& in arg2, const string& in arg3, const string& in arg4) {
    string[] args = {arg0, arg1, arg2, arg3, arg4};
    return localize_format(key, args);
}

string LF(const string& in key, string[]@ args) {
    return localize_format(key, args);
}

string LF(const string& in key, const string& in arg0) {
    return localize_format(key, arg0);
}

string LF(const string& in key, const string& in arg0, const string& in arg1) {
    return localize_format(key, arg0, arg1);
}

string LF(const string& in key, const string& in arg0, const string& in arg1, const string& in arg2) {
    return localize_format(key, arg0, arg1, arg2);
}

string get_current_language() {
    return current_language_file;
}

string get_language_code() {
    if(current_language_file.find("portuguese") >= 0) return "pt";
    if(current_language_file.find("English") >= 0) return "en";
    if(current_language_file.find("spanish") >= 0) return "es";
    if(current_language_file.find("french") >= 0) return "fr";
    return "pt";
}

bool change_language(const string& in lang_code) {
    string lang_file;

    if(lang_code == "pt" || lang_code == "br" || lang_code == "portuguese") {
        lang_file = "lang/portuguese.lang";
    }
    else if(lang_code == "en" || lang_code == "english") {
        lang_file = "lang/English.lang";
    }
    else if(lang_code == "es" || lang_code == "spanish" || lang_code == "español") {
        lang_file = "lang/spanish.lang";
    }
    else if(lang_code == "fr" || lang_code == "french" || lang_code == "français") {
        lang_file = "lang/french.lang";
    }
    else {
        return false;
    }

    return load_language_file(lang_file);
}

bool has_translation(const string& in key) {
    string result = pu.get_value(key);
    return result != key;
}

void init_localization_system() {
    auto_detect_language();
}
