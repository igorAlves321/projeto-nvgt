// rotation.nvgt - Funções de rotação e cálculo geométrico
// Task 2.2: Sistema de Eco e Movimento

// ============================================
// Constantes Matemáticas
// ============================================
const double PI = 3.14159265358979323846;

// ============================================
// Funções de Conversão Angular
// ============================================

// Converte graus para radianos
double degrees_to_radians(double degrees) {
    return degrees * (PI / 180.0);
}

// Converte radianos para graus
double radians_to_degrees(double radians) {
    return radians * (180.0 / PI);
}

// Calcula theta (ângulo em radianos) a partir do yaw do jogador
// yaw_degrees: rotação do jogador em graus (0-360)
// Retorna: ângulo em radianos para uso com cos/sin
double calculate_theta(double yaw_degrees) {
    // Normalizar para 0-360
    while (yaw_degrees < 0) yaw_degrees += 360.0;
    while (yaw_degrees >= 360.0) yaw_degrees -= 360.0;

    // Converter para radianos
    return degrees_to_radians(yaw_degrees);
}

// ============================================
// Funções de Distância
// ============================================

// Calcula distância Euclidiana 2D entre dois pontos
// Fórmula: sqrt((x2 - x1)² + (y2 - y1)²)
double get_2d_distance(double x1, double y1, double x2, double y2) {
    double dx = x2 - x1;
    double dy = y2 - y1;
    return sqrt((dx * dx) + (dy * dy));
}

// Calcula distância Euclidiana 2D entre dois pontos (versão int)
double get_2d_distance(int x1, int y1, int x2, int y2) {
    return get_2d_distance(double(x1), double(y1), double(x2), double(y2));
}

// ============================================
// Funções de Direção e Vetor
// ============================================

// Calcula o componente X de um vetor unitário na direção theta
double get_direction_x(double theta) {
    return cos(theta);
}

// Calcula o componente Y de um vetor unitário na direção theta
double get_direction_y(double theta) {
    return sin(theta);
}

// Calcula ponto em uma direção a partir de origem
// x_origin, y_origin: ponto de origem
// theta: ângulo em radianos
// distance: distância do ponto
void calculate_point_at_distance(double x_origin, double y_origin, double theta, double distance, double &out x_result, double &out y_result) {
    x_result = x_origin + (distance * cos(theta));
    y_result = y_origin + (distance * sin(theta));
}

// ============================================
// Funções de Normalização de Ângulo
// ============================================

// Normaliza ângulo para faixa 0-360
double normalize_angle(double angle) {
    while (angle < 0) angle += 360.0;
    while (angle >= 360.0) angle -= 360.0;
    return angle;
}

// Calcula diferença angular considerando wrap-around
// Retorna menor diferença entre dois ângulos (-180 a +180)
double angle_difference(double angle1, double angle2) {
    double diff = angle2 - angle1;

    // Normalizar para -180 a +180
    while (diff > 180.0) diff -= 360.0;
    while (diff < -180.0) diff += 360.0;

    return diff;
}
