
class safezone {
	int min_x;
	int max_x;
	int min_y;
	int max_y;

	safezone(int minx, int maxx, int miny, int maxy) {
		this.min_x = minx;
		this.max_x = maxx;
		this.min_y = miny;
		this.max_y = maxy;
	}
}

safezone@[] safezones;

bool get_safezone_at() {
	string outval;
	for(uint i=0; i<safezones.length(); i++){
		int minx = safezones[i].min_x;
		int maxx = safezones[i].max_x;
		int miny = safezones[i].min_y;
		int maxy = safezones[i].max_y;
		if(minx > me.x) continue;
		if(minx <= me.x && maxx >= me.x && miny <= me.y && maxy >= me.y) return true;
	}
	return false;
}
