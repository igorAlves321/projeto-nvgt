
class GameClient {
	private string encryption_key;
	private string _last_error;

	GameClient(string key = "evm_server_key_2024") {
		encryption_key = key;
		_last_error = "";
	}

	string get_last_error() {
		return _last_error;
	}

	bool check_connected() {
		return is_connected && net_peer_id != 0;
	}

	bool send_reliable(string message, int channel = 0) {
		if(@con == null) {
			_last_error = "Objeto network não inicializado";
			return false;
		}

		if(!is_connected || net_peer_id == 0) {
			_last_error = "Não conectado ao servidor";
			return false;
		}

		string encrypted = string_aes_encrypt(message, encryption_key);
		return con.send(net_peer_id, encrypted, channel, true);
	}

	bool send_unreliable(string message, int channel = 0) {
		if(@con == null || !is_connected || net_peer_id == 0) {
			return false;
		}

		string encrypted = string_aes_encrypt(message, encryption_key);
		return con.send(net_peer_id, encrypted, channel, false);
	}

	bool send_chat(string message, string chat_type = "local") {
		string json = "{\"t\":\"chat\",\"type\":\"" + chat_type + "\",\"text\":\"" + escape_json(message) + "\"}";
		return send_reliable(json, CH_CHAT);
	}

	bool send_action(string action_id, string args = "") {
		string json = "{\"t\":\"act\",\"id\":\"" + action_id + "\",\"args\":\"" + escape_json(args) + "\"}";
		return send_reliable(json, CH_ACTION);
	}

	bool send_system(string cmd, string data = "") {
		string json = "{\"t\":\"sys\",\"cmd\":\"" + cmd + "\",\"data\":\"" + escape_json(data) + "\"}";
		return send_reliable(json, CH_SYSTEM);
	}

	bool send_json(string json_str, int channel, bool reliable = true) {
		if(reliable) {
			return send_reliable(json_str, channel);
		} else {
			return send_unreliable(json_str, channel);
		}
	}

	private string escape_json(string input) {
		string result = input;
		result = string_replace(result, "\\", "\\\\", true);
		result = string_replace(result, "\"", "\\\"", true);
		result = string_replace(result, "\n", "\\n", true);
		result = string_replace(result, "\r", "\\r", true);
		result = string_replace(result, "\t", "\\t", true);
		return result;
	}

	string decrypt_message(string encrypted_message) {
		return string_aes_decrypt(encrypted_message, encryption_key);
	}

	string get_stats() {
		return "Conectado: " + (is_connected ? "Sim" : "Não") +
		       ", Peer ID: " + net_peer_id;
	}

	void set_encryption_key(string new_key) {
		encryption_key = new_key;
	}
}

GameClient game_client("evm_server_key_2024");
