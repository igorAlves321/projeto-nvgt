void safeloop() {
	bool v = check_safezone();
	if(v == false && inansz == true && nolhar == "") {
		inansz = false;
		game_net.send(server_peer_id, "sn", 0, true);
	}
	if(v == true && inansz == false) {
		inansz = true;
		game_net.send(server_peer_id, "s", 0, true);
	}
}

// Função para limpar plataformas/tiles para debugging
void clear_all_platforms() {
	platforms.resize(0);
	map.resize(0);
}

void playstep() {
	if(jumping == false) {
		string step = get_tile_at(me.x, me.y) + "step" + string(random(1, 5)) + ".ogg";
		p2.play_stationary(step, false);
		// NVGT nativo: envia movimento para servidor
		game_net.send(net_peer_id, "move " + step + " " + me.x + " " + me.y, 0, false); // unreliable
	}
}