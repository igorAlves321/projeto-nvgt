// Sistema de mapas convertido para NVGT - COMPLETO baseado em map.bgt
#include "platforms.nvgt"
#include "zones.nvgt"
#include "safezones.nvgt"

// Variáveis globais de mapa
dictionary fail;
string[] map2;
string[] map;
bool amisafe = false;
bool comurl = false;
string somchuva = "rain4.ogg";

// Sistema de áudio para streams (música de fundo/ambiente)
sound audio_stream;
sound audio_stream2;
bool stream_loaded = false;
bool stream2_loaded = false;

// Variáveis de coordenadas e configurações
class coordinate_limits {
	int x, y;
}
coordinate_limits max;

// Função para tocar som de passo
void playstep() {
	if(jumping == 0) {
		string step = get_tile_at(me.x, me.y) + "step" + random(1, 5) + ".ogg";
		p.play_stationary(step, false);
		game_net.send(net_peer_id, "move " + step + " " + me.x + " " + me.y, 0, false); // unreliable
	}
}

// Get material type
string gmt() {
	return get_tile_at(me.x, me.y);
}

string gct() {
	// TODO: implementar camera quando converter camera.bgt
	return get_tile_at(0, 0); // camera.x, camera.y
}

string linear(string[] a, string char_separator = "\r\n") {
	string final;
	for(uint i=0; i<a.length(); i++) {
		final += (a[i] + char_separator);
	}
	return final;
}

string[] delinear(string a, string char_separator = "\r\n") {
	// NVGT nativo: implementar split manualmente
	string[] result;
	if(a.length() == 0) return result;
	
	int start = 0;
	int pos = a.find(char_separator, start);
	
	while(pos != -1) {
		if(pos > start) {
			result.push_back(a.substr(start, pos - start));
		}
		start = pos + char_separator.length();
		pos = a.find(char_separator, start);
	}
	
	// Adicionar última parte se existir
	if(start < int(a.length())) {
		result.push_back(a.substr(start));
	}
	
	return result;
}

void mapreset(bool complete = true) {
	// Parar streams de áudio
	if(comurl && complete) {
		if(stream_loaded) {
			audio_stream.stop();
			stream_loaded = false;
		}
		if(stream2_loaded) {
			audio_stream2.stop();
			stream2_loaded = false;
		}
		comurl = false;
	}
	
	fail.delete_all();
	
	// Destruir todos os elementos do mapa
	destroy_all_doors();
	destroy_all_elevadors();
	destroy_all_txts();
	destroy_all_dialogs();
	destroy_stores();
	
	if(complete) p.destroy_all();
	
	// Limpar disableds
	disableds.resize(0);
	
	if(complete) {
		currentloc = "";
		destroy_all_ambientes();
		destroy_all_sources();
		destroy_all_source2s();
		destroy_all_msounds();
		steps.destroy_all();
		shoot.destroy_all();
		bodys.destroy_all();
		walls.destroy_all();
		doors_sound.destroy_all();
		npcs.destroy_all();
		pl.destroy_all();
	}
	
	destroy_all_staircases();
	map2.resize(0);
	zones.resize(0);
	safezones.resize(0);
	platforms.resize(0);
	
	// Resetar flags
	outras = true;
	bazuca = true;
	dcamera = 0;
	dcoordenadas = 0;
	dinventario = 0;
	dauto = 0;
	dhelicoptero = 0;
	davion = 0;
	dtanque = 0;
	dmoto = 0;
	darmas = 0;
	dbaculo = 0;
	dbazuca = 0;
	bicicletaativa = 1;
	camionativo = 1;
	somchuva = "rain4.ogg";
	
	destruir_areias_movedissas();
}

void init_data(string data_line, bool complete = true) {
	// Função para processar uma linha de dados do mapa
	string[] parsed = data_line.split(":");
	
	if(parsed[0] == "map") {
		mapname = data_line.substr(4); // string_trim_left equivalente
		debug_log("🗺️ Nome do mapa: " + mapname);
		if(mapname == "túnel") {
			centado = false;
			if(game_lan.nalancha == 1) game_lan.saindo = 1;
		}
	}
	else if(parsed[0] == "url" && parsed.length() > 1 && complete) {
		comurl = true;
		string url = data_line.substr(4);
		// NVGT: usar classe sound para streaming
		if(stream_loaded) audio_stream.stop();
		if(audio_stream.load(url)) {
			audio_stream.play_looped(); // Música de fundo em loop
			stream_loaded = true;
			debug_log("🎵 Stream URL carregado e tocando: " + url);
		} else {
			debug_log("❌ Erro ao carregar stream: " + url);
		}
	}
	else if(parsed[0] == "teto") {
		somchuva = parsed[1];
	}
	else if(parsed[0] == "platform" && parsed.length() >= 5) {
		string minx, maxx, y, tile;
		minx = parsed[1];
		maxx = parsed[2];
		y = parsed[3];
		tile = parsed[4];
		map.push_back(minx + ":" + maxx + ":" + y + ":" + y + ":" + tile);
	}
	else if((parsed[0] == "wall" || parsed[0] == "pwall") && parsed.length() >= 5) {
		string x, miny, maxy, tile;
		x = parsed[1];
		miny = parsed[2];
		maxy = parsed[3];
		tile = parsed[4];
		map.push_back(x + ":" + x + ":" + miny + ":" + maxy + ":" + tile);
	}
	else if(parsed[0] == "zone") {
		zones.push_back(data_line.substr(5));
	}
	else if(parsed[0] == "desc" && parsed.length() > 4) {
		colocar_desc(string_to_number(parsed[1]), string_to_number(parsed[2]), 
					 string_to_number(parsed[3]), string_to_number(parsed[4]), parsed[5]);
	}
	else if(parsed[0] == "maxx") {
		max.x = string_to_number(parsed[1]);
	}
	else if(parsed[0] == "maxy") {
		max.y = string_to_number(parsed[1]);
	}
	else if(parsed[0] == "x") {
		me.x = string_to_number(parsed[1]);
	}
	else if(parsed[0] == "y") {
		me.y = string_to_number(parsed[1]);
	}
	else if((parsed[0] == "sound_source" || parsed[0] == "som") && parsed.length() >= 6) {
		int lx = string_to_number(parsed[1]);
		int rx = string_to_number(parsed[2]);
		int miny = string_to_number(parsed[3]);
		int maxy = string_to_number(parsed[4]);
		string sound_file = parsed[5].replace(".wav", ".ogg");
		string id = "123";
		spawn_source(lx, rx, miny, maxy, sound_file, id);
	}
	else if((parsed[0] == "door" || parsed[0] == "porta") && parsed.length() >= 9) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		int fx = string_to_number(parsed[3]);
		int fy = string_to_number(parsed[4]);
		int speed = string_to_number(parsed[5]);
		string snd1 = parsed[6];
		string snd2 = parsed[7];
		string snd3 = parsed[8];
		string snd4 = parsed[9];
		spawn_door(x, y, fx, fy, speed, snd1, snd2, snd3, snd4);
	}
	else if(parsed[0] == "elevador" && parsed.length() > 4) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		int fx = string_to_number(parsed[3]);
		int fy = string_to_number(parsed[4]);
		spawn_elevador(x, y, fx, fy);
	}
	else if(parsed[0] == "staircase" && parsed.length() >= 6) {
		int lx = string_to_number(parsed[1]);
		int rx = string_to_number(parsed[2]);
		int miny = string_to_number(parsed[3]);
		int maxy = string_to_number(parsed[4]);
		string tile = parsed[5];
		string id = "1234";
		spawn_staircase(lx, rx, miny, maxy, tile, id);
	}
	else if(parsed[0] == "texto" && parsed.length() >= 4) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		string txt = parsed[3];
		spawn_txt(x, y, txt);
	}
	else if(parsed[0] == "areia_movedissa") {
		colocar_areia_movedissa(string_to_number(parsed[1]), string_to_number(parsed[2]), mapname);
	}
	else if(parsed[0] == "travelpoint" || parsed[0] == "portamapa" || parsed[0] == "reverb" || parsed[0] == "congelar") {
		// Ignorar estes elementos por enquanto
	}
	else if(parsed[0] == "desativar") {
		if(parsed[1] == "coordenadas") dcoordenadas = 1;
		if(parsed[1] == "varinha") dvarinha = 1;
		if(parsed[1] == "camera") dcamera = 1;
		if(parsed[1] == "bicicleta") bicicletaativa = 0;
		if(parsed[1] == "armas_pretas") outras = false;
	}
	else if(parsed[0] == "safemap") {
		if(amisafe == false) {
			amisafe = true;
			game_net.send(net_peer_id, "iamsafe", 0, true); // reliable
		}
	}
	else if(parsed[0] == "safezone" && parsed.length() == 5) {
		safezones.set(parsed[1] + ":" + parsed[2] + ":" + parsed[3] + ":" + parsed[4], "safe");
	}
	else if((parsed[0].length() > 1 && parsed[0][0] == "/" && parsed[0][1] == "/") || parsed[0] == "comment") {
		// Comentário - ignorar
	}
	else {
		// Erro de sintaxe no mapa
		add_add_item("misc", "map error. An error has occured. Line: " + data_line + ". Error: Invalid syntax.");
	}
}

void load_map(string mdata, bool complete = true) {
	debug_log("📍 Iniciando carregamento de mapa...");
	mapreset(complete);
	bool isitsafe = false;
	string[] ldata = delinear(mdata);
	debug_log("📍 Mapa tem " + ldata.length() + " linhas de dados");
	string[] parsed = ldata[0].split(" ");
	string filename;
	
	// Verificar se é um mapa local encriptado
	if(parsed.length() == 5 && parsed[1] == "local") {
		pack_file map_pack;
		file@ map_file;
		filename = parsed[2] + ".map";
		ldata.resize(0);
		
		if(map_pack.open(MAPS_STORAGE)) {
			@map_file = map_pack.get_file(filename);
			if(@map_file != null) {
				string encrypted_content = map_file.read();
				string decrypted = string_decrypt(encrypted_content, MAPS_ENCRYPTION_KEY);
				ldata = delinear(decrypted);
				map_file.close();
			}
			map_pack.close();
			ldata.push_back("x:" + parsed[3]);
			ldata.push_back("y:" + parsed[4]);
			map2 = ldata;
		}
	}
	else {
		// Mapa normal (não local)
		ldata[0] = ldata[0].replace("changemap ", "");
		ldata[0] = ldata[0].replace("changemap2 ", "");
		map2 = ldata;
	}
	
	// Processar todas as linhas do mapa
	for(uint i = 0; i < ldata.length(); i++) {
		if(ldata[i] == "safemap") isitsafe = true;
		init_data(ldata[i], complete);
	}
	
	// Verificar mudança de status de safezone
	if(isitsafe == false && amisafe == true) {
		amisafe = false;
		game_net.send(net_peer_id, "iamnotsafe", 0, true);
	}
	
	chuva();
	debug_log("✅ Mapa carregado com sucesso!");
}

void spawn_platform(int leftx, int rightx, int miny, int maxy, string plattype) {
	map.push_back(leftx + ":" + rightx + ":" + miny + ":" + maxy + ":" + plattype);
}

void spawn_tiles(int leftx, int rightx, int miny, int maxy, string plattype) {
	map.push_back(leftx + ":" + rightx + ":" + miny + ":" + maxy + ":" + plattype);
}

void spawn_zone(int leftx, int rightx, int miny, int maxy, string zonetype) {
	zone z(leftx, rightx, miny, maxy, zonetype);
	zones.push_back(z);
}

// load_map2 - versão simplificada para reload de mapas sem reset completo
void load_map2(string mdata) {
	// Limpar apenas elementos específicos
	objs.resize(0);
	destroy_all_txts();
	maquinatempos.resize(0);
	computadors.resize(0);
	pcomputador.destroy_all();
	
	// Resetar flags
	outras = true;
	dcamera = 0;
	dcoordenadas = 0;
	dvarinha = 0;
	bicicletaativa = 1;
	somchuva = "rain4.ogg";
	
	// Limpar mapas
	map.resize(0);
	map2.resize(0);
	
	string[] ldata = delinear(mdata);
	map2 = ldata;
	bool isitsafe = false;
	
	// Processar linhas do mapa
	for(uint i = 0; i < ldata.length(); i++) {
		if(ldata[i] == "safemap") isitsafe = true;
		init_data(ldata[i], false); // complete = false para load_map2
	}
	
	// Verificar mudança de status de safezone
	if(isitsafe == false && amisafe == true) {
		amisafe = false;
		game_net.send(net_peer_id, "iamnotsafe", 0, true);
	}
	
	chuva();
}

bool inansz = false;

bool safezone() {
	string[] safekeys = safezones.get_keys();
	bool ret = false;
	for(uint i = 0; i < safekeys.length(); i++) {
		string[] atest = safekeys[i].split(":");
		int smnx = string_to_number(atest[0]);
		int smxx = string_to_number(atest[1]);
		int smny = string_to_number(atest[2]);
		int smxy = string_to_number(atest[3]);
		if(me.x >= smnx && me.x <= smxx && me.y >= smny && me.y <= smxy) {
			ret = true;
			break;
		}
	}
	return ret;
}

void safeloop() {
	bool v = safezone();
	if(v == false && inansz == true && nolhar == "") {
		inansz = false;
		game_net.send(net_peer_id, "sn", 0, true);
	}
	if(v == true && inansz == false) {
		inansz = true;
		game_net.send(net_peer_id, "s", 0, true);
	}
}

// Função para limpar plataformas/tiles para debugging
void clear_all_platforms() {
	platforms.resize(0);
	map.resize(0);
}