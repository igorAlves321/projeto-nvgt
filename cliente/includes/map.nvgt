#include "platforms.nvgt"
#include "zones.nvgt"
#include "safezones.nvgt"
#include "extract.nvgt"

dictionary fail;
dictionary desactivados;
string[] map2;
string[] map;
bool amisafe = false;

sound audio_stream;
sound audio_stream2;
bool stream_loaded = false;
bool stream2_loaded = false;
int active_ss2_zone_index = -1;

class map_stream_zone {
	int min_x = 0;
	int max_x = 0;
	int min_y = 0;
	int max_y = 0;
	string sound_file = "";
	int volume = 0;
}
map_stream_zone@[] map_stream_zones;

class disabled_game_zone {
	int min_x = 0;
	int max_x = 0;
	int min_y = 0;
	int max_y = 0;
}
disabled_game_zone@[] disabled_game_zones;

class coordinate_limits {
	int x, y;
}
coordinate_limits max;

void playstep() {
	if(!jumping) {
		string step = get_tile_at(me.x, me.y) + "step" + random(1, 5) + ".ogg";
		p.play_stationary(step, false);
		game_net.send(net_peer_id, "move " + step + " " + me.x + " " + me.y, 0, false);
	}
}

string gmt() {
	return get_tile_at(me.x, me.y);
}

string gct() {
	return get_tile_at(camera.x, camera.y);
}

string linear(string[] a, string char_separator = "\r\n") {
	string final;
	for(uint i=0; i<a.length(); i++) {
		final += (a[i] + char_separator);
	}
	return final;
}

string[] delinear(string a, string char_separator = "\r\n") {
	return a.split(char_separator);
}

void mapreset(bool complete = true) {
	if(comurl && complete) {
		if(stream_loaded) {
			audio_stream.stop();
			stream_loaded = false;
		}
		if(stream2_loaded) {
			audio_stream2.stop();
			stream2_loaded = false;
		}
		comurl = false;
	}
	if(stream2_loaded) {
		audio_stream2.stop();
		stream2_loaded = false;
	}
	active_ss2_zone_index = -1;
	map_stream_zones.resize(0);
	disabled_game_zones.resize(0);

	fail.delete_all();

	destroy_all_doors();
	destroy_all_elevadors();
	destroy_all_txts();
	destroy_all_dialogs();
	destroy_stores();
	destroy_all_npcs();

	if(complete) p.destroy_all();

	disableds.resize(0);

	if(complete) {
		currentloc = -1;
		destroy_all_ambientes();
		destroy_all_sources();
		destroy_all_source2s();
		destroy_all_msounds();
		steps.destroy_all();
		shoot.destroy_all();
		bodys.destroy_all();
		walls.destroy_all();
		doors_sound.destroy_all();
		npcs.destroy_all();
		pl.destroy_all();
	}

	destroy_all_staircases();
	map2.resize(0);
	zones.resize(0);
	safezones.resize(0);
	platforms.resize(0);

	outras = true;
	bazuca = true;
	dcamera = 0;
	dcoordenadas = 0;
	dinventario = 0;
	dauto = 0;
	dhelicoptero = 0;
	davion = 0;
	dtanque = 0;
	dmoto = 0;
	darmas = 0;
	dbaculo = 0;
	dbazuca = 0;
	bicicletaativa = 1;
	camionativo = 1;
	somchuva = "rain4.ogg";

	destruir_areias_movedissas();
}

void init_data(string data_line, bool complete = true) {
	string trimmed = data_line.trim_whitespace();
	if(trimmed == "" || trimmed.length() == 0) return;

	string[] parsed = data_line.split(":");

	if(parsed[0] == "map") {
		mapname = data_line.substr(4);
		debug_log("🗺️ Nome do mapa: " + mapname);
		if(mapname == "túnel") {
			centado = false;
			if(game_lan.nalancha == 1) game_lan.saindo = 1;
		}
	}
	else if(parsed[0] == "url" && parsed.length() > 1 && complete) {
		comurl = true;
		string url = data_line.substr(4);
		if(stream_loaded) audio_stream.stop();
		if(audio_stream.load(url)) {
			audio_stream.play_looped();
			stream_loaded = true;
			debug_log("🎵 Stream URL carregado e tocando: " + url);
		} else {
			debug_log("❌ Erro ao carregar stream: " + url);
		}
	}
	else if(parsed[0] == "teto") {
		somchuva = parsed[1];
	}
	else if((parsed[0] == "platform" || parsed[0] == "p") && parsed.length() >= 5) {
		int min_x = string_to_number(parsed[1]);
		int max_x = string_to_number(parsed[2]);
		int min_y = string_to_number(parsed[3]);
		int max_y = min_y;
		string tiles = parsed[4];

		platforms.insert_at(platforms.length(), platform("p", min_x, max_x, min_y, max_y, tiles));
		debug_log("🏗️ Plataforma criada: x(" + min_x + "-" + max_x + ") y=" + min_y + " tiles=" + tiles);
	}
	else if((parsed[0] == "wall" || parsed[0] == "pwall" || parsed[0] == "w") && parsed.length() >= 5) {
		int x = string_to_number(parsed[1]);
		int min_y = string_to_number(parsed[2]);
		int max_y = string_to_number(parsed[3]);
		string tiles = parsed[4];

		platforms.insert_at(platforms.length(), platform("w", x, x, min_y, max_y, "wall" + tiles));
		debug_log("🧱 Parede criada: x=" + x + " y(" + min_y + "-" + max_y + ") tipo=" + tiles);
	}
	else if((parsed[0] == "zone" || parsed[0] == "z") && parsed.length() >= 6) {
		zone z(string_to_number(parsed[1]), string_to_number(parsed[2]),
		       string_to_number(parsed[3]), string_to_number(parsed[4]),
		       parsed[5]);
		zones.push_back(z);
	}
	else if((parsed[0] == "door" || parsed[0] == "porta" || parsed[0] == "dr") && parsed.length() >= 10) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		int fx = string_to_number(parsed[3]);
		int fy = string_to_number(parsed[4]);
		int speed = string_to_number(parsed[5]);
		string snd1 = parsed[6];
		string snd2 = parsed[7];
		string snd3 = parsed[8];
		string snd4 = parsed[9];
		spawn_door(x, y, fx, fy, speed, snd1, snd2, snd3, snd4);
	}
	else if((parsed[0] == "desc" || parsed[0] == "dv") && parsed.length() >= 2) {
		if(parsed.length() == 2) {
			if(parsed[1] == "coordenadas") dcoordenadas = 1;
			else if(parsed[1] == "camera") dcamera = 1;
			else if(parsed[1] == "varinha") dvarinha = 1;
			else if(parsed[1] == "baculo") dvarinha = 1;
		}
		else if(parsed.length() >= 6) {
			colocar_desc(string_to_number(parsed[1]), string_to_number(parsed[2]),
						 string_to_number(parsed[3]), string_to_number(parsed[4]), parsed[5]);
		}
	}
	else if(parsed[0] == "maxx") {
		max.x = string_to_number(parsed[1]);
	}
	else if(parsed[0] == "maxy") {
		max.y = string_to_number(parsed[1]);
	}
	else if(parsed[0] == "x") {
		me.x = string_to_number(parsed[1]);
	}
	else if(parsed[0] == "y") {
		me.y = string_to_number(parsed[1]);
	}
	else if((parsed[0] == "sound_source" || parsed[0] == "som" || parsed[0] == "ss") && parsed.length() >= 6) {
		int lx = string_to_number(parsed[1]);
		int rx = string_to_number(parsed[2]);
		int miny = string_to_number(parsed[3]);
		int maxy = string_to_number(parsed[4]);
		string sound_file = parsed[5].replace(".wav", ".ogg");
		string id = "123";
		spawn_source(lx, rx, miny, maxy, sound_file, id);
	}
	else if((parsed[0] == "staircase" || parsed[0] == "sc") && parsed.length() >= 6) {
		int lx = string_to_number(parsed[1]);
		int rx = string_to_number(parsed[2]);
		int miny = string_to_number(parsed[3]);
		int maxy = string_to_number(parsed[4]);
		string tile = parsed[5];
		string id = "1234";
		spawn_staircase(lx, rx, miny, maxy, tile, id);
	}
	else if(parsed[0] == "arbol" && parsed.length() >= 6) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		int miny = string_to_number(parsed[3]);
		int maxy = string_to_number(parsed[4]);
		string drops = (parsed.length() > 6) ? parsed[6] : "nada";
		string description = (parsed.length() > 7) ? parsed[7] : "uma árvore";

		string id = "arbol_" + x;
		spawn_staircase(x, x, miny, maxy, "arbol", id);

		debug_log("🌳 Árvore criada em (" + x + "," + y + "): " + description);
	}
	else if((parsed[0] == "texto" || parsed[0] == "txt") && parsed.length() >= 4) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		string txt = parsed[3];
		spawn_txt(x, y, txt);
	}
	else if(parsed[0] == "areia_movedissa" || parsed[0] == "am") {
		colocar_areia_movedissa(string_to_number(parsed[1]), string_to_number(parsed[2]), mapname);
	}
	else if(parsed[0] == "dlg" && parsed.length() >= 4) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		string message = parsed[3];
		spawn_dialog(message, x, y);
	}
	else if(parsed[0] == "ss2" && parsed.length() >= 6) {
		if(parsed.length() >= 6) {
			map_stream_zone@ sz = map_stream_zone();
			sz.min_x = string_to_number(parsed[1]);
			sz.max_x = string_to_number(parsed[2]);
			sz.min_y = string_to_number(parsed[3]);
			sz.max_y = string_to_number(parsed[4]);
			sz.sound_file = parsed[5].replace(".wav", ".ogg");
			sz.volume = (parsed.length() >= 7) ? string_to_number(parsed[6]) : 0;
			map_stream_zones.insert_last(sz);
		}
	}
	else if((parsed[0] == "tp" || parsed[0] == "travelpoint") && parsed.length() >= 8) {
		int zone_x1 = string_to_number(parsed[1]);
		int zone_y1 = string_to_number(parsed[2]);
		int zone_x2 = string_to_number(parsed[3]);
		int zone_y2 = string_to_number(parsed[4]);
		int dest_x = string_to_number(parsed[5]);
		int dest_y = string_to_number(parsed[6]);
		string dest_map = parsed[7];
		string message = (parsed.length() > 8) ? parsed[8] : "Você foi teleportado.";

		travel_point_class tp;
		tp.zone_x1 = zone_x1;
		tp.zone_y1 = zone_y1;
		tp.zone_x2 = zone_x2;
		tp.zone_y2 = zone_y2;
		tp.dest_x = dest_x;
		tp.dest_y = dest_y;
		tp.dest_map = dest_map;
		tp.message = message;
		tp.activated = false;
		travel_points.insert_last(tp);

		debug_log("📍 Travel Point criado: " + dest_map + " (" + dest_x + "," + dest_y + ")");
	}
	else if(parsed[0] == "ptm" && parsed.length() >= 9) {
		int zone_x1 = string_to_number(parsed[1]);
		int zone_y1 = string_to_number(parsed[2]);
		int zone_x2 = string_to_number(parsed[3]);
		int zone_y2 = string_to_number(parsed[4]);
		int dest_x = string_to_number(parsed[5]);
		int dest_y = string_to_number(parsed[6]);
		string dest_map = parsed[7];
		string message = (parsed.length() > 8) ? parsed[8] : "Portal activado.";
		string som_portal = (parsed.length() > 9) ? parsed[9] : "door17open";

		travel_point_class tp;
		tp.zone_x1 = zone_x1;
		tp.zone_y1 = zone_y1;
		tp.zone_x2 = zone_x2;
		tp.zone_y2 = zone_y2;
		tp.dest_x = dest_x;
		tp.dest_y = dest_y;
		tp.dest_map = dest_map;
		tp.message = message;
		tp.activated = false;
		travel_points.insert_last(tp);

		debug_log("🌀 Portal PTM criado em " + dest_map + " com som: " + som_portal);
	}
	else if(parsed[0] == "death" && parsed.length() >= 8) {
		int zone_x1 = string_to_number(parsed[1]);
		int zone_y1 = string_to_number(parsed[2]);
		int zone_x2 = string_to_number(parsed[3]);
		int zone_y2 = string_to_number(parsed[4]);
		int dest_x = string_to_number(parsed[5]);
		int dest_y = string_to_number(parsed[6]);
		string message = (parsed.length() > 8) ? parsed[8] : "Você morreu!";

		travel_point_class tp;
		tp.zone_x1 = zone_x1;
		tp.zone_y1 = zone_y1;
		tp.zone_x2 = zone_x2;
		tp.zone_y2 = zone_y2;
		tp.dest_x = dest_x;
		tp.dest_y = dest_y;
		tp.dest_map = mapname;
		tp.message = message;
		tp.activated = false;
		travel_points.insert_last(tp);

		debug_log("💀 Zona de morte criada em (" + zone_x1 + "," + zone_y1 + ")");
	}
	else if(parsed[0] == "pm" && parsed.length() >= 10) {
		int zone_x1 = string_to_number(parsed[1]);
		int zone_y1 = string_to_number(parsed[2]);
		int zone_x2 = string_to_number(parsed[3]);
		int zone_y2 = string_to_number(parsed[4]);
		int dest_x = string_to_number(parsed[5]);
		int dest_y = string_to_number(parsed[6]);
		string dest_map = parsed[7];
		string message = (parsed.length() > 8) ? parsed[8] : "Item coletado.";
		string som_item = (parsed.length() > 9) ? parsed[9] : "door17open";
		string item_type = (parsed.length() > 10) ? parsed[10] : "item";

		travel_point_class tp;
		tp.zone_x1 = zone_x1;
		tp.zone_y1 = zone_y1;
		tp.zone_x2 = zone_x2;
		tp.zone_y2 = zone_y2;
		tp.dest_x = dest_x;
		tp.dest_y = dest_y;
		tp.dest_map = dest_map;
		tp.message = message;
		tp.activated = false;
		travel_points.insert_last(tp);

		debug_log("🎁 Ponto PM criado com item: " + item_type);
	}
	else if(parsed[0] == "where" && parsed.length() >= 2) {
		string location = data_line.substr(6);
		current_location = location;
		debug_log("📍 Localização: " + location);
	}
	else if(parsed[0] == "item" && parsed.length() >= 9) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		int quantity = string_to_number(parsed[5]);
		string item_type = parsed[6];

		spawn_obj(x, y, item_type, quantity);
		debug_log("📍 Item criado: " + item_type + " em (" + x + "," + y + ") qtd: " + quantity);
	}
	else if(parsed[0] == "cpm" && parsed.length() >= 13) {
		int zone_x1 = string_to_number(parsed[1]);
		int zone_y1 = string_to_number(parsed[2]);
		int zone_x2 = string_to_number(parsed[3]);
		int zone_y2 = string_to_number(parsed[4]);
		int dest_x = string_to_number(parsed[5]);
		int dest_y = string_to_number(parsed[6]);
		string dest_map = parsed[7];
		string travel_msg = (parsed.length() > 8) ? parsed[8] : "viajando...";
		string color = (parsed.length() > 9) ? parsed[9] : "ffffff";
		int travel_time = (parsed.length() > 10) ? string_to_number(parsed[10]) : 5000;
		string arrival_msg = (parsed.length() > 11) ? parsed[11] : "Chegou ao destino";
		string effect = (parsed.length() > 12) ? parsed[12] : "appear";

		travel_point_class tp;
		tp.zone_x1 = zone_x1;
		tp.zone_y1 = zone_y1;
		tp.zone_x2 = zone_x2;
		tp.zone_y2 = zone_y2;
		tp.dest_x = dest_x;
		tp.dest_y = dest_y;
		tp.dest_map = dest_map;
		tp.message = travel_msg;
		tp.activated = false;
		travel_points.insert_last(tp);

		debug_log("⏱️ Portal CPM criado com tempo: " + travel_time + "ms");
	}
	else if(parsed[0] == "disable_game" && parsed.length() >= 5) {
		disabled_game_zone@ dz = disabled_game_zone();
		dz.min_x = string_to_number(parsed[1]);
		dz.max_x = string_to_number(parsed[2]);
		dz.min_y = string_to_number(parsed[3]);
		dz.max_y = string_to_number(parsed[4]);
		disabled_game_zones.insert_last(dz);
		debug_log(" Disable_game zone criada: (" + dz.min_x + "," + dz.max_x + ") x (" + dz.min_y + "," + dz.max_y + ")");
	}
	else if(parsed[0] == "congelar" && parsed.length() >= 4) {
		int x1 = string_to_number(parsed[1]);
		int x2 = string_to_number(parsed[2]);
		int y1 = string_to_number(parsed[3]);
		int y2 = string_to_number(parsed[4]);

		safezone freeze_zone(x1, x2, y1, y2);
		safezones.push_back(freeze_zone);

		debug_log("❄️ Zona de congelamento criada");
	}
	else if(parsed[0] == "darmas" && parsed.length() >= 2) {
		string weapon = parsed[1];
		if(weapon == "armas") {
			darmas = 1;
		}
		else if(weapon != "") {
			fail.set(weapon, weapon);
		}
		debug_log(" Arma bloqueada: " + weapon);
	}
	else if(parsed[0] == "npc" && parsed.length() >= 18) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		double vida = string_to_number(parsed[3]);
		double xp = string_to_number(parsed[4]);
		double dist_ataque = string_to_number(parsed[5]);
		double dano_recib = string_to_number(parsed[6]);
		double dano_causa = string_to_number(parsed[7]);
		double dano_espejo = string_to_number(parsed[8]);
		int tiempo_ataque = string_to_number(parsed[9]);
		int tiempo_caminar = string_to_number(parsed[10]);
		int tiempo_sonido = string_to_number(parsed[11]);
		string items = parsed[12];
		string som_ataque = parsed[13];
		string som_calmo = parsed[14];
		string som_muerte = parsed[15];
		string nombre = parsed[16];
		string msg_muerte = parsed[17];
		int tiempo_apariencia = (parsed.length() > 18) ? string_to_number(parsed[18]) : 0;
		int respawn = (parsed.length() > 19) ? string_to_number(parsed[19]) : 0;
		int bomba = (parsed.length() > 20) ? string_to_number(parsed[20]) : 0;

		npc_client_class novo_npc;
		novo_npc.x = x;
		novo_npc.y = y;
		novo_npc.x_inicial = x;
		novo_npc.y_inicial = y;
		novo_npc.hp = int(vida);
		novo_npc.max_hp = int(vida);
		novo_npc.name = nombre;
		novo_npc.id = random(1000, 9999);
		novo_npc.map = mapname;
		novo_npc.last_seen.restart();

		if(parsed.length() > 22) {
			novo_npc.left_range = string_to_number(parsed[21]);
			novo_npc.right_range = string_to_number(parsed[22]);
		}

		npc_objects.insert_last(novo_npc);

		debug_log("👹 NPC criado: " + nombre + " em (" + x + "," + y + ") HP:" + vida + " XP:" + xp);
	}
	else if(parsed[0] == "z" && parsed.length() >= 6) {
		int min_x = string_to_number(parsed[1]);
		int max_x = string_to_number(parsed[2]);
		int min_y = string_to_number(parsed[3]);
		int max_y = string_to_number(parsed[4]);
		string text = parsed[5];

		if(parsed.length() > 6) {
			for(int i = 6; i < parsed.length(); i++) {
				text += ":" + parsed[i];
			}
		}

		zones.insert_at(zones.length(), zone(min_x, max_x, min_y, max_y, text));

		debug_log("📍 Zone criada: (" + min_x + "," + max_x + ") x (" + min_y + "," + max_y + ")");
	}
	else if(parsed[0] == "ex" && parsed.length() >= 11) {
		int min_x = string_to_number(parsed[1]);
		int max_x = string_to_number(parsed[2]);
		int min_y = string_to_number(parsed[3]);
		int max_y = string_to_number(parsed[4]);
		int items = string_to_number(parsed[5]);
		int attempts = string_to_number(parsed[6]);
		int time = string_to_number(parsed[7]);
		string item = parsed[8];
		string snd_ext = parsed[9];
		string snd_extracted = parsed[10];

		extracts.insert_at(extracts.length(), extract(min_x, max_x, min_y, max_y,
		                                               items, attempts, time,
		                                               item, snd_ext, snd_extracted));

		debug_log("⛏️ Extract zone criada: (" + min_x + "," + max_x + ") - Item: " + item);
	}
	else if(parsed[0] == "dv" && parsed.length() >= 2) {
		string id = parsed[1];
		disableds.insert_at(disableds.length(), id);
		debug_log("❌ Elemento desativado: " + id);
	}
	else if(parsed[0] == "ss" && parsed.length() >= 6) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		string arquivo = parsed[5];
		debug_log("🔊 Sound spawn em (" + x + "," + y + "): " + arquivo);
	}
	else if(parsed[0] == "pnpc" && parsed.length() >= 4) {
		int x = string_to_number(parsed[1]);
		int y = string_to_number(parsed[2]);
		string nome = parsed[3];
		int npc_id = (parsed.length() > 4) ? string_to_number(parsed[4]) : (900000 + random(1, 99999));
		spawn_npc(x, y, 100, nome, npc_id);
		debug_log("👤 PNPC criado: " + nome + " em (" + x + "," + y + ")");
	}
	else if(parsed[0] == "travelpoint" || parsed[0] == "portamapa" || parsed[0] == "reverb"
	        || parsed[0] == "pm2" || parsed[0] == "w2") {
	}
	else if(parsed[0] == "store" && parsed.length() >= 6) {
		int min_x = string_to_number(parsed[1]);
		int max_x = string_to_number(parsed[2]);
		int min_y = string_to_number(parsed[3]);
		int max_y = string_to_number(parsed[4]);
		string store_name = parsed[5];

		zones.insert_at(zones.length(), zone(min_x, max_x, min_y, max_y, "Loja: " + store_name));

		debug_log("🏪 Loja criada: " + store_name + " em (" + min_x + "," + max_x + ")");
	}
	else if(parsed[0] == "desativar") {
		if(parsed[1] == "coordenadas") dcoordenadas = 1;
		if(parsed[1] == "varinha") dvarinha = 1;
		if(parsed[1] == "camera") dcamera = 1;
		if(parsed[1] == "bicicleta") bicicletaativa = 0;
		if(parsed[1] == "armas_pretas") outras = false;
	}
	else if(parsed[0] == "safemap") {
		if(amisafe == false) {
			amisafe = true;
			game_net.send(net_peer_id, "iamsafe", 0, true);
		}
	}
	else if((parsed[0] == "safezone" || parsed[0] == "safez") && parsed.length() == 5) {
		safezone sz(string_to_number(parsed[1]), string_to_number(parsed[2]),
		            string_to_number(parsed[3]), string_to_number(parsed[4]));
		safezones.push_back(sz);
	}
	else if((parsed[0].length() > 1 && parsed[0][0] == "/" && parsed[0][1] == "/") || parsed[0] == "comment") {
	}
	else {
		add_add_item("misc", "map error. An error has occured. Line: " + data_line + ". Error: Invalid syntax.");
	}
}

void spawn_npc(int x, int y, int hp, string nome, int id) {
	for(uint i = 0; i < npc_objects.length(); i++) {
		if(npc_objects[i].id == id) {
			npc_objects[i].x = x;
			npc_objects[i].y = y;
			npc_objects[i].hp = hp;
			npc_objects[i].last_seen.restart();
			debug_log("🔄 NPC atualizado: " + nome);
			return;
		}
	}

	npc_client_class novo;
	novo.x = x;
	novo.y = y;
	novo.hp = hp;
	novo.max_hp = hp;
	novo.name = nome;
	novo.id = id;
	novo.map = mapname;
	novo.last_seen.restart();

	npc_objects.insert_last(novo);
	debug_log("👹 Novo NPC spawn: " + nome);
}

void remove_npc(int id) {
	for(uint i = 0; i < npc_objects.length(); i++) {
		if(npc_objects[i].id == id) {
			debug_log("💀 NPC removido: " + npc_objects[i].name);
			npc_objects.remove_at(i);
			return;
		}
	}
}

void clear_npcs() {
	debug_log("🧹 Limpando todos os NPCs (" + npc_objects.length() + " removidos)");
	npc_objects.resize(0);
}

void npc_loop() {

	if(npc_objects.length() > 0) {
	}

	for(uint i = 0; i < npc_objects.length(); i++) {
		if(npc_objects[i].last_seen.elapsed >= 60000) {
			debug_log("💀 NPC " + npc_objects[i].name + " desapareceu (timeout)");
			npc_objects.remove_at(i);
			i--;
			continue;
		}
	}

	display_npcs_hud();
}

void load_map(string mdata, bool complete = true) {
	debug_log("📍 Iniciando carregamento de mapa...");
	debug_log("📍 Dados recebidos: " + mdata.substr(0, 100) + "...");
	mapreset(complete);
	bool isitsafe = false;
	mdata = mdata.replace("\r\n", "\n");
	mdata = mdata.replace("\r", "\n");
	string[] ldata = mdata.split("\n");
	while(ldata.length() > 0 && ldata[0].trim_whitespace() == "") ldata.remove_at(0);
	while(ldata.length() > 0 && ldata[ldata.length() - 1].trim_whitespace() == "") ldata.remove_at(ldata.length() - 1);
	if(ldata.length() == 0) {
		debug_log("ERRO: payload de mapa vazio apos normalizacao.");
		return;
	}
	debug_log("📍 Mapa tem " + ldata.length() + " linhas de dados");

	if(ldata.length() > 0) {
		debug_log("📍 Primeira linha: " + ldata[0]);
	}

	string[] parsed = ldata[0].split(" ");
	debug_log("📍 Linha parseada: " + parsed.length() + " partes");
	string filename;

	if(parsed.length() == 5 && parsed[1] == "local") {
		pack_file map_pack;
		filename = parsed[2] + ".map";
		ldata.resize(0);

		if(map_pack.open(MAPS_STORAGE, SOUND_ENCRYPTION_KEY)) {
			if(map_pack.file_exists(filename)) {
				datastream@ map_stream = map_pack.get_file(filename);
				string map_content = @map_stream != null ? map_stream.read() : "";

				ldata = map_content.split("\n");

				for(uint i = 0; i < ldata.length(); i++) {
					ldata[i] = ldata[i].replace("\r", "");
				}
			} else {
				ldata.push_back("x:" + parsed[3]);
				ldata.push_back("y:" + parsed[4]);
			}
			map_pack.close();
			map2 = ldata;
		}
	}
	else {
		ldata[0] = ldata[0].replace("changemap ", "");
		ldata[0] = ldata[0].replace("changemap2 ", "");
		map2 = ldata;
	}

	for(uint i = 0; i < ldata.length(); i++) {
		if(ldata[i] == "safemap") isitsafe = true;
		init_data(ldata[i], complete);
	}

	if(isitsafe == false && amisafe == true) {
		amisafe = false;
		game_net.send(net_peer_id, "iamnotsafe", 0, true);
	}

	chuva();
	debug_log(" Mapa carregado com sucesso!");
	debug_log("📊 Estatísticas do mapa:");
	debug_log("   - mapname = '" + mapname + "'");
	debug_log("   - map.length() = " + map.length());
	debug_log("   - zones.length() = " + zones.length());
	debug_log("   - safemap = " + isitsafe);
}

void spawn_platform(int leftx, int rightx, int miny, int maxy, string plattype) {
	map.push_back(leftx + ":" + rightx + ":" + miny + ":" + maxy + ":" + plattype);
}

void spawn_tiles(int leftx, int rightx, int miny, int maxy, string plattype) {
	map.push_back(leftx + ":" + rightx + ":" + miny + ":" + maxy + ":" + plattype);
}

void spawn_zone(int leftx, int rightx, int miny, int maxy, string zonetype) {
	zone z(leftx, rightx, miny, maxy, zonetype);
	zones.push_back(z);
}

bool inansz = false;

void safeloop() {
	bool v = get_safezone_at();
	if(v == false && inansz == true && nolhar == "") {
		inansz = false;
		game_net.send(net_peer_id, "sn", 0, true);
	}
	if(v == true && inansz == false) {
		inansz = true;
		game_net.send(net_peer_id, "s", 0, true);
	}
}

void travel_point_loop() {
	for(uint i = 0; i < travel_points.length(); i++) {
		if(me.x >= travel_points[i].zone_x1 && me.x <= travel_points[i].zone_x2 &&
		   me.y >= travel_points[i].zone_y1 && me.y <= travel_points[i].zone_y2) {

			if(!travel_points[i].activated) {
				travel_points[i].activated = true;
				travel_points[i].activation_timer.restart();

				if(travel_points[i].message != "") {
					speak(travel_points[i].message);
				}

				game_net.send(net_peer_id, "tp:" + travel_points[i].dest_map + ":" + travel_points[i].dest_x + ":" + travel_points[i].dest_y, 0, true);

				debug_log("🌀 Teleportando para: " + travel_points[i].dest_map);
			}
		} else {
			if(travel_points[i].activated && travel_points[i].activation_timer.elapsed > 5000) {
				travel_points[i].activated = false;
			}
		}
	}
}

void clear_all_platforms() {
	platforms.resize(0);
	map.resize(0);
}

void display_npcs_hud() {
	if(npc_objects.length() == 0) return;

	const int VISIBILITY_RANGE = 10;

	int nearby_npcs = 0;
	string npc_list = "👹 NPCs Próximos:\r\n";

	for(uint i = 0; i < npc_objects.length(); i++) {
		int dx = me.x - npc_objects[i].x;
		int dy = me.y - npc_objects[i].y;
		int distance = sqrt(dx * dx + dy * dy);

		if(distance <= VISIBILITY_RANGE) {
			nearby_npcs++;

			string direction = "";
			if(dx < -2) direction += "→ ";
			else if(dx > 2) direction += "← ";

			if(dy < -2) direction += "↑ ";
			else if(dy > 2) direction += "↓ ";

			npc_list += direction + npc_objects[i].name + " (HP: " + npc_objects[i].hp + "/" + npc_objects[i].max_hp + ")\r\n";
		}
	}

	if(nearby_npcs > 0) {
		add_add_item("hud_npcs", npc_list);
	}
}

void update_hud_npcs() {
	display_npcs_hud();
}

void destroy_all_npcs() {
	for(uint i = 0; i < npc_objects.length(); i++) {
		@npc_objects[i] = null;
	}
	npc_objects.resize(0);
	debug_log("✓ Todos os NPCs foram destruídos");
}

void remove_npc_by_id(int npc_id) {
	for(uint i = 0; i < npc_objects.length(); i++) {
		if(npc_objects[i].id == npc_id) {
			@npc_objects[i] = null;
			npc_objects.remove_at(i);
			debug_log("🗑️ NPC ID " + npc_id + " removido");
			break;
		}
	}
}

npc_client_class@ get_npc_by_id(int npc_id) {
	for(uint i = 0; i < npc_objects.length(); i++) {
		if(npc_objects[i].id == npc_id) {
			return @npc_objects[i];
		}
	}
	return null;
}

npc_client_class@ get_nearest_npc(int max_distance = 10) {
	npc_client_class@ nearest = null;
	int min_distance = max_distance;

	for(uint i = 0; i < npc_objects.length(); i++) {
		int dx = me.x - npc_objects[i].x;
		int dy = me.y - npc_objects[i].y;
		int distance = sqrt(dx * dx + dy * dy);

		if(distance < min_distance) {
			min_distance = distance;
			@nearest = @npc_objects[i];
		}
	}

	return @nearest;
}

bool is_in_disable_game_zone(int x, int y) {
	for(uint i = 0; i < disabled_game_zones.length(); i++) {
		if(disabled_game_zones[i] is null) continue;
		if(x < disabled_game_zones[i].min_x) continue;
		if(x > disabled_game_zones[i].max_x) continue;
		if(y < disabled_game_zones[i].min_y) continue;
		if(y > disabled_game_zones[i].max_y) continue;
		return true;
	}
	return false;
}

void update_ss2_stream_loop() {
	if(map_stream_zones.length() == 0) {
		if(stream2_loaded) {
			audio_stream2.stop();
			stream2_loaded = false;
		}
		active_ss2_zone_index = -1;
		return;
	}

	int target_zone = -1;
	for(uint i = 0; i < map_stream_zones.length(); i++) {
		if(map_stream_zones[i] is null) continue;
		if(me.x < map_stream_zones[i].min_x || me.x > map_stream_zones[i].max_x) continue;
		if(me.y < map_stream_zones[i].min_y || me.y > map_stream_zones[i].max_y) continue;
		target_zone = int(i);
		break;
	}

	if(target_zone == -1) {
		if(stream2_loaded) {
			audio_stream2.stop();
			stream2_loaded = false;
		}
		active_ss2_zone_index = -1;
		return;
	}

	if(target_zone == active_ss2_zone_index && stream2_loaded) return;

	if(stream2_loaded) {
		audio_stream2.stop();
		stream2_loaded = false;
	}

	map_stream_zone@ z = map_stream_zones[target_zone];
	if(z is null || z.sound_file == "") {
		active_ss2_zone_index = -1;
		return;
	}

	if(audio_stream2.load(z.sound_file)) {
		audio_stream2.volume = z.volume;
		audio_stream2.play_looped();
		stream2_loaded = true;
		active_ss2_zone_index = target_zone;
	}
}
