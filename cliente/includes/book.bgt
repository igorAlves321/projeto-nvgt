book books;

class book {
	string title;
	string description;
	string bookmusic;
		int slot_bookmusic =-1;
	page@[] pages;
	string sound_open="misc193.ogg", sound_close="misc192.ogg", sound_page_left="misc190.ogg", sound_page_right="misc191.ogg", sound_desc="misc194.ogg";
	void initbook(string content) {
		string[] lines;
		if(content!="") {
			lines =string_split(content, "\r\n", false);
		}
		else {
			speak("No es posible abrir éste libro.");
			return;
		}
		if(lines.length()>0) {
			for(int i=0; i<lines.length(); i++) {
				string[] data=string_split(lines[i], "=", true);
				if(data[0] =="title") {
					title =data[1];
				}
				if(data[0] =="description") {
					description =data[1];
				}
				if(data[0]=="music") {
					bookmusic =data[1];
					break;
				}
			}
		}
		lines.resize(0);
		string[] pages_data =string_split(content, "page", true);
		for(int i=1; i<pages_data.length(); i++) {
			page pg(pages_data[i]);
			pages.insert_last(pg);
		}
		read_book();
	}

	void resetbook() {
		title ="";
		description ="";
		bookmusic ="";
		pages.resize(0);
		if(slot_bookmusic>-1) {
			p.destroy_sound(slot_bookmusic);
			resume_sources2();
		}
	}

	void read_book() {
		int selected_page=-1;
		string[] lines;
		int selected_line =-1;
		int page_number=0;
		p.play_stationary(sound_open, false);
		speak(title);
		send_reliable(peer_id, "draw "+sound_open, 0);
		if(bookmusic!="") {
		pause_sources2();
			slot_bookmusic =p.play_stationary(bookmusic, true);
		}
		while(true) {
			wait(5);
			mainloop();
			if(key_pressed(KEY_ESCAPE)) {
				p.play_stationary(sound_close, false);
				resetbook();
				send_reliable(peer_id, "draw "+sound_close, 0);
				return;
			}
			if(key_pressed(KEY_RIGHT) && selected_page<pages.length()-1) {
				selected_page++;
				page_number =selected_page+1;
				selected_line =-1;
				lines.resize(0);
				lines =pages[selected_page].get_page();
				speak(pu.get_value("Página")+" "+page_number);
				p.play_stationary(sound_page_right, false);
				send_reliable(peer_id, "draw "+sound_page_right, 0);
			}
			if(key_pressed(KEY_LEFT) && selected_page>0) {
				selected_page--;
				page_number =selected_page+1;
				selected_line =-1;
				lines.resize(0);
				lines =pages[selected_page].get_page();
				speak(pu.get_value("página")+" "+page_number);
				p.play_stationary(sound_page_left, false);
				send_reliable(peer_id, "draw "+sound_page_left, 0);
			}
			if(key_pressed(KEY_DOWN) && selected_line<lines.length()-1) {
				selected_line++;
				speak(lines[selected_line]);
			}
			if(key_pressed(KEY_UP) && selected_line>0) {
				selected_line--;
				speak(lines[selected_line]);
			}
			if(key_pressed(KEY_D)) {
				speak(description);
				p.play_stationary(sound_desc, false);
				send_reliable(peer_id, "draw "+sound_desc, 0);
			}
			if(key_pressed(KEY_P) && selected_page>=0) {
				speak(pu.get_value("página")+" "+page_number);
			}
			if(key_pressed(KEY_T)) {
				speak(title);
			}
		} // end while
	} // end method read_book
} // end class book

class page {
	string content;
	page(string content) {
		this.content =content;
	}
	string[] get_page() {
		string[] final;
		if(content.length()>0) {
			final =delinear(this.content);
		}
		if(final.length()>0) {
			return final;
		}
		return final;
	}
} // end class
