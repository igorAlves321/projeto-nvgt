string zoeiras() {
	string[]@ soundfiles = glob("upsounds/*.ogg");

	if(soundfiles.length() <= 0) {
		speak(pu.get_value("Nenhum arquivo encontrado na pasta uploads"));
		return "-1";
	}

	setupmenu();
	for(uint i = 0; i < soundfiles.length(); i++) {
		string filename = string_split(soundfiles[i], "/")[-1];
		game_menu.add_item(filename.replace(".ogg", ""), soundfiles[i]);
	}

	game_menu.intro_text = pu.get_value("Escolha o arquivo de som para enviar.");
	int mres = game_menu.run();

	if(mres < 0) {
		return "-1";
	}
	else return game_menu.get_item_id(mres);
}

string soundsmenu() {
	if(!directory_exists("upsounds")) {
		directory_create("upsounds");
		speak(pu.get_value("A pasta de sons não foi encontrada. Já foi criada, e você pode colocar seus arquivos nela."));
		return "";
	}

	string[]@ soundfiles = glob("upsounds/*.ogg");
	if(soundfiles.length() <= 0) {
		speak(pu.get_value("Não há arquivos de som na pasta upsounds"));
		return "";
	}

	setupmenu();
	for(uint i = 0; i < soundfiles.length(); i++) {
		string filename = string_split(soundfiles[i], "/")[-1];
		game_menu.add_item(filename.replace(".ogg", ""), soundfiles[i]);
	}

	game_menu.intro_text = pu.get_value("Selecione o áudio a enviar. Atualmente existem ") + soundfiles.length() + pu.get_value(" arquivos na pasta de sons.");
	int mres = game_menu.run();

	if(mres < 0) {
		return "";
	}
	else return game_menu.get_item_id(mres);
}

string idiomas() {
	string[]@ soundfiles = glob("lang/*.lang");

	if(soundfiles.length() <= 0) {
		speak(pu.get_value("Nenhum arquivo de idioma encontrado."));
		return "";
	}

	setupmenu();
	for(uint i = 0; i < soundfiles.length(); i++) {
		string normalized_path = soundfiles[i].replace("\\", "/");
		string filename = string_split(normalized_path, "/")[-1];
		filename = filename.replace(".lang", "");

		string display_name = filename;
		string lower_name = filename.lower();

		if(lower_name == "portuguese" || lower_name == "portugues") display_name = "Português";
		else if(lower_name == "english") display_name = "English";
		else if(lower_name == "spanish" || lower_name == "espanol") display_name = "Español";
		else if(lower_name == "french" || lower_name == "francais") display_name = "Français";
		else if(lower_name == "turkish" || lower_name == "turco") display_name = "Türkçe";
		else {
			if(display_name.length() > 0) {
				display_name = display_name.substr(0, 1).upper() + display_name.substr(1);
			}
		}

		game_menu.add_item(display_name, soundfiles[i]);
	}
	game_menu.add_item(pu.get_value("Voltar"), "back");

	game_menu.intro_text = pu.get_value("Escolha o arquivo de idioma que deseja usar.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);

	if(selected_id == "back") {
		return "";
	}
	else return selected_id;
}

string audiosmenu() {
	string[]@ audiofiles = glob("audios/*.{mp3,wav,ogg}");

	if(audiofiles.length() <= 0) {
		speak(pu.get_value("Nenhum arquivo de áudio encontrado na pasta audios"));
		return "";
	}

	setupmenu();
	for(uint i = 0; i < audiofiles.length(); i++) {
		string filename = string_split(audiofiles[i], "/")[-1];
		string displayname = filename;
		if(displayname.find_last(".") != -1) {
			displayname = displayname.substr(0, displayname.find_last("."));
		}
		game_menu.add_item(displayname, audiofiles[i]);
	}

	game_menu.intro_text = pu.get_value("Selecione o áudio. Total de arquivos: ") + audiofiles.length();
	int mres = game_menu.run();

	if(mres < 0) {
		return "";
	}
	else return game_menu.get_item_id(mres);
}

