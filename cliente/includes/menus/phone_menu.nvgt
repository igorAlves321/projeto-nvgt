// Menu de celular
void celularmenu() {
	setupmenu();
	if(ausente || !player_moveable) return;
	
	game_menu.add_item(pu.get_value("Ver jogadores."), "players");
	game_menu.add_item(pu.get_value("Ver suas estatísticas."), "stats");
	game_menu.add_item(pu.get_value("Ver estado de sanidade."), "sanity");
	game_menu.add_item(pu.get_value("Ver estatísticas atuais do monstro lendário."), "monster");
	game_menu.add_item(pu.get_value("Serviços."), "services");
	
	if(desenvolvedordm == 0) game_menu.add_item(pu.get_value("transferências."), "transferencias");
	game_menu.add_item(pu.get_value("Reportar um erro do jogo."), "bug");
	
	if(inv_item_exists("reproductor_mp3")) game_menu.add_item(pu.get_value("Reproduzir um link."), "enlace");
	if(married != 0) game_menu.add_item(pu.get_value("Enviar uma mensagem para seu parceiro."), "send_couple");
	if(parabatyed != 0) game_menu.add_item(pu.get_value("enviar uma mensagem para seu parabatai."), "send_parabatai");
	
	game_menu.intro_text = pu.get_value("Escolha a opção que desejar.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "players") {
		game_net.send(net_peer_id, encrypt_packet("getplayers"), 0, true);
	}
	else if(selected_id == "stats") {
		statsmenu();
	}
	else if(selected_id == "sanity") {
		game_net.send(net_peer_id, encrypt_packet("sanity"), 0, false);
	}
	else if(selected_id == "monster") {
		game_net.send(net_peer_id, encrypt_packet("monster"), 0, false);
	}
	else if(selected_id == "services") {
		servicesmenu();
	}
	else if(selected_id == "transferencias") {
		transferenciasmenu();
	}
	else if(selected_id == "enlace") {
		input_form form(pu.get_value("Reproduzir link"));
		form.description = pu.get_value("escreva ou cole o link que quer ouvir. se quiser parar a reprodução, escreva a letra s e pressione enter.");
		form.add_text_field("url", pu.get_value("URL"), "", true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string url = "";
			result.get("url", url);
			url = url.replace("\r\n", "");
			
			if(url == "s") {
				stream2.close();  // NVGT: fechar stream
			}
			else if(url != "") {
				stream2.close();  // NVGT: fechar stream anterior
				if(stream2.load(url)) {  // Carregar nova URL
					stream2.play();  // Play sem parâmetros
				}
			}
		}
	}
	else if(selected_id == "bug") {
		input_form form(pu.get_value("Reportar erro"));
		form.description = pu.get_value("Preencha os campos para reportar um erro.");
		form.add_text_field("subject", pu.get_value("Escreva o título do problema:"), "", true);
		form.add_text_field("message", pu.get_value("Escreva o texto do seu relatório, com um mínimo de 120 caracteres:"), "", true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string subject = "";
			string message = "";
			result.get("subject", subject);
			result.get("message", message);
			if(subject != "" && message != "") {
				game_net.send(net_peer_id, encrypt_packet("bug " + subject + "\r\n" + message), 0, true);
			}
			else {
				speak(pu.get_value("Cancelado."));
			}
		}
	}
	else if(selected_id == "send_couple") {
		input_form form(pu.get_value("Mensagem para parceiro"));
		form.add_text_field("msg", pu.get_value("Digite a mensagem"), "", true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string msg = "";
			result.get("msg", msg);
			if(msg != "") {
				game_net.send(net_peer_id, encrypt_packet("couplemsg " + msg), 0, true);
			}
		}
	}
	else if(selected_id == "send_parabatai") {
		input_form form(pu.get_value("Mensagem para parabatai"));
		form.add_text_field("msg", pu.get_value("Digite a mensagem"), "", true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string msg = "";
			result.get("msg", msg);
			if(msg != "") {
				game_net.send(net_peer_id, encrypt_packet("parabataimsg " + msg), 0, true);
			}
		}
	}
}

// Menu de transferências
void transferenciasmenu() {
	setupmenu();
	game_menu.add_item(pu.get_value("transferir reais para um jogador"), "reais");
	game_menu.add_item(pu.get_value("transferir euro para um jogador"), "euro");
	game_menu.add_item(pu.get_value("transferir Stryx para um jogador"), "stryx");
	game_menu.add_item(pu.get_value("botão voltar"), "back");
	
	game_menu.intro_text = pu.get_value("menu de transferências. selecione a opção que desejar e pressione enter.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "back" || mres == -1) {
		celularmenu();
		return;
	}
	
	if(selected_id == "reais") {
		input_form form(pu.get_value("Transferir reais"));
		form.add_text_field("player", pu.get_value("para qual jogador deseja transferir reais?"), "", true);
		form.add_number_field("amount", pu.get_value("quantos?"), 0, true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string jugador = "";
			double reais = 0;
			result.get("player", jugador);
			result.get("amount", reais);
			if(reais > 0 && jugador != "") {
				game_net.send(net_peer_id, encrypt_packet("transferencia reais " + int(reais) + " " + jugador), 0, false);
			}
		}
	}
	else if(selected_id == "euro") {
		input_form form(pu.get_value("Transferir euro"));
		form.add_text_field("player", pu.get_value("para qual jogador deseja transferir euro?"), "", true);
		form.add_number_field("amount", pu.get_value("quantos?"), 0, true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string jugador = "";
			double euro = 0;
			result.get("player", jugador);
			result.get("amount", euro);
			if(euro > 0 && jugador != "") {
				game_net.send(net_peer_id, encrypt_packet("transferencia euro " + int(euro) + " " + jugador), 0, false);
			}
		}
	}
	else if(selected_id == "stryx") {
		input_form form(pu.get_value("Transferir Stryx"));
		form.add_text_field("player", pu.get_value("para qual jogador deseja transferir Stryx?"), "", true);
		form.add_number_field("amount", pu.get_value("quantos?"), 0, true);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string jugador = "";
			double stryx = 0;
			result.get("player", jugador);
			result.get("amount", stryx);
			if(stryx > 0 && jugador != "") {
				game_net.send(net_peer_id, encrypt_packet("transferencia stryx " + int(stryx) + " " + jugador), 0, false);
			}
		}
	}
}

// Menu de estatísticas
void statsmenu() {
	setupmenu();
	if(ausente || !player_moveable) return;
	
	game_menu.add_item(pu.get_value("Geral."), "geral");
	game_menu.add_item(pu.get_value("Ver saldo atual de Stryx."), "stryx");
	game_menu.add_item(pu.get_value("Ver saldo atual de créditos."), "creditos");
	game_menu.add_item(pu.get_value("Ver o desgaste total de suas armas."), "list_degrade");
	game_menu.add_item(pu.get_value("Legado do Combatente."), "kill_stats");
	game_menu.add_item(pu.get_value("botão voltar."), "back");
	
	game_menu.intro_text = pu.get_value("selecione a estatística que queira revisar.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "back") {
		celularmenu();
	}
	else if(selected_id == "geral") {
		statsmenu_geral();
	}
	else if(selected_id == "stryx") {
		game_net.send(net_peer_id, encrypt_packet("stryx"), 0, false);
	}
	else if(selected_id == "creditos") {
		game_net.send(net_peer_id, encrypt_packet("creditos"), 0, false);
	}
	else if(selected_id == "list_degrade") {
		game_net.send(net_peer_id, encrypt_packet("list_degrades"), 13, true);
	}
	else if(selected_id == "kill_stats") {
		game_net.send(net_peer_id, encrypt_packet("kill_stats"), 13, true);
	}
}

