	game_menu.add_item(pu.get_value("míssil_teleguiado") + " - 200 " + pu.get_value("euro"), "míssil_teleguiado");
	game_menu.add_item(pu.get_value("max_bomba") + " - 250 " + pu.get_value("euro"), "max_bomba");
	game_menu.add_item(pu.get_value("bomba_de_fogo") + " - 250 " + pu.get_value("euro"), "bomba_de_fogo");
	game_menu.add_item(pu.get_value("bomba_atômica") + " - 300 " + pu.get_value("euro"), "bomba_atômica");
	game_menu.add_item(pu.get_value("mega_laser") + " 5000 " + pu.get_value("euro"), "mega_laser");
	game_menu.add_item(pu.get_value("sub_laser") + " 100000 " + pu.get_value("euro"), "sub_laser");
	game_menu.add_item(pu.get_value("cuernitoarmani") + " 1000000 " + pu.get_value("euro"), "cuernitoarmani");
	game_menu.add_item(pu.get_value("galil") + " 100000 " + pu.get_value("euro"), "galil");
	game_menu.add_item(pu.get_value("míssil") + " 15 " + pu.get_value("euro"), "míssil");
	game_menu.add_item(pu.get_value("laser") + " 5 " + pu.get_value("euro"), "laser");
	game_menu.add_item(pu.get_value("7.62mm") + " 3 " + pu.get_value("euro"), "7.62mm");
	game_menu.add_item(pu.get_value("5.56mm") + " 2 " + pu.get_value("euro"), "5.56mm");
	game_menu.add_item(pu.get_value("9mm") + " - 2 " + pu.get_value("euro"), "9mm");
	game_menu.add_item(pu.get_value("Voltar"), "0");
	
	game_menu.intro_text = pu.get_value("Escolha um item");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id != "0" && mres > 0) {
		string valor = prompt_numeric_input(pu.get_value("Quantidade"), pu.get_value("Quanto você quer de") + " " + pu.get_value(selected_id) + "?");
		if(valor != "") {
			game_net.send(net_peer_id, encrypt_packet("/buy2123321123 " + valor + " " + selected_id), 1, false);
		}
	}
}

// Menu de estufa (cozinhar carnes)
void estufa() {
	setupmenu();
	if(ausente || !player_moveable) return;
	
	if(inv_item_exists("carne_cruda_de_conejo")) {
		game_menu.add_item(pu.get_value("carne_cruda_de_conejo"), "conejo");
	}
	if(inv_item_exists("carne_cruda_de_tiburon")) {
		game_menu.add_item(pu.get_value("carne_cruda_de_tiburon"), "tiburon");
	}
	if(inv_item_exists("carne_cruda_de_lobo")) {
		game_menu.add_item(pu.get_value("carne_cruda_de_lobo"), "lobo");
	}
	if(inv_item_exists("carne_cruda_de_megadragonsaurio")) {
		game_menu.add_item(pu.get_value("carne_cruda_de_megadragonsaurio"), "megadragonsaurio");
	}
	game_menu.add_item(pu.get_value("Voltar"), "0");
	
	game_menu.intro_text = pu.get_value("Escolha o que quer cozinhar.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id != "0" && mres > 0) {
		string amount = prompt_numeric_input(pu.get_value("Cozinhar"), pu.get_value("Quantas carnes quer cozinhar?"));
		if(amount != "") {
			game_net.send(net_peer_id, encrypt_packet("/cocinar " + amount + " " + selected_id), 1, false);
		}
	}
}

