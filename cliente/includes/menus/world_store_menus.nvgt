// Menu de feitiços/magias
void spellmenu(string data) {
	if(dbaculo == 1) return;
	if(ausente || !player_moveable) return;
	
	string[] spells = data.split("\r\n");
	setupmenu();
	
	for(uint i = 0; i < spells.length(); i++) {
		string[] parsed = spells[i].split(":");
		if(parsed.length() > 0) {
			game_menu.add_item(pu.get_value(spells[i]), parsed[0]);
		}
	}
	
	game_menu.intro_text = pu.get_value("Escolha uma magia para lançar.");
	int mres = game_menu.run();
	
	if(mres > 0) {
		string spell = game_menu.get_item_id(mres);
		game_net.send(net_peer_id, encrypt_packet("spellcast " + spell + " " + facing), 0, false);
	}
}

