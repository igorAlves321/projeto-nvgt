// Menu de imobiliária (compra de cabanas)
void inmobiliariamenu() {
	setupmenu();
	if(ausente || !player_moveable) return;
	
	game_menu.add_item(pu.get_value("Ver a cabana."), "ver");
	game_menu.add_item(pu.get_value("Comprar cabana."), "comprar");
	game_menu.add_item(pu.get_value("Voltar"), "back");
	
	game_menu.intro_text = pu.get_value("Escolha a opção que desejar.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	
	if(selected_id == "ver") {
		game_net.send(net_peer_id, encrypt_packet("vercabana"), 2, false);
	}
	else if(selected_id == "comprar") {
		game_net.send(net_peer_id, encrypt_packet("comprarcasa2"), 2, false);
	}
}

