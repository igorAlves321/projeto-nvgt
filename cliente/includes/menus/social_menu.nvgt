// Menus sociais: amigos, equipe e guilda.

int social_count_selectable_players() {
	int count = 0;
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].charname != "" && players[i].charname != un) count++;
	}
	return count;
}

void social_send_multi_invites(const string&in tipo, const string[]&in selected_names) {
	for(uint i = 0; i < selected_names.length(); i++) {
		string target = selected_names[i];
		if(target == "") continue;
		if(tipo == "amigo") send_reliable(peer_id, CLIENT_PROTO_FRIEND_ADD + target, 0);
		else if(tipo == "equipe") send_reliable(peer_id, "/invite " + target, 0);
		else if(tipo == "guilda") send_reliable(peer_id, "/inviteguild " + target, 0);
	}
}

void menu_adicionar_multiplos(string tipo) {
	if(ausente || !moveable) return;

	if(social_count_selectable_players() <= 0) {
		speak(pu.get_value("Não há ninguém conectado."));
		return;
	}

	dictionary selected;

	while(true) {
		setupmenu();
		game_menu.intro_text = pu.get_value("Selecione jogadores. Enter marca/desmarca. Confirmar envia.");

		for(uint i = 0; i < players.length(); i++) {
			string pname = players[i].charname;
			if(pname == "" || pname == un) continue;
			bool is_selected = selected.exists(pname);
			string label = (is_selected ? "[x] " : "[ ] ") + pname;
			game_menu.add_item(label, "p|" + pname);
		}

		game_menu.add_item(pu.get_value("Confirmar"), "confirm");
		game_menu.add_item(pu.get_value("Selecionar todos"), "all");
		game_menu.add_item(pu.get_value("Limpar selecao"), "clear");
		game_menu.add_item(pu.get_value("Cancelar"), "cancel");

		int res = game_menu.run();
		if(res < 0) return;

		string op = game_menu.get_item_id(res);
		if(op == "cancel") return;
		if(op == "all") {
			selected.delete_all();
			for(uint i = 0; i < players.length(); i++) {
				string pname = players[i].charname;
				if(pname == "" || pname == un) continue;
				selected.set(pname, 1);
			}
			continue;
		}
		if(op == "clear") {
			selected.delete_all();
			continue;
		}
		if(op == "confirm") {
			string[] keys = selected.get_keys();
			if(keys.length() == 0) {
				speak(pu.get_value("Nenhum jogador selecionado."));
				continue;
			}
			social_send_multi_invites(tipo, keys);
			speak(pu.get_value("Solicitacoes enviadas."));
			return;
		}
		if(op.find("p|") == 0) {
			string target = op.substr(2);
			if(selected.exists(target)) selected.delete(target);
			else selected.set(target, 1);
			continue;
		}
	}
}

void menu_equipe_social() {
	setupmenu();
	game_menu.intro_text = pu.get_value("Gerenciar equipe");
	game_menu.add_item(pu.get_value("Aceitar convite"), "aceitar");
	game_menu.add_item(pu.get_value("Convidar jogadores"), "convidar");
	game_menu.add_item(pu.get_value("Informacoes da equipe"), "info");
	game_menu.add_item(pu.get_value("Sair da equipe"), "sair");
	game_menu.add_item(pu.get_value("Voltar"), "voltar");

	int res = game_menu.run();
	if(res < 0) return;
	string op = game_menu.get_item_id(res);
	if(op == "aceitar") send_reliable(peer_id, "/joinparty", 0);
	else if(op == "convidar") menu_adicionar_multiplos("equipe");
	else if(op == "info") send_reliable(peer_id, "/partyinfo", 0);
	else if(op == "sair") send_reliable(peer_id, "/leaveparty", 0);
	else if(op == "voltar") menu_social_principal();
}

void menu_amigos_social() {
	while(true) {
		setupmenu();
		game_menu.intro_text = pu.get_value("Gerenciar amigos");
		game_menu.add_item(pu.get_value("Adicionar amigos"), "adicionar");
		game_menu.add_item(pu.get_value("Listar amigos"), "listar");
		game_menu.add_item(pu.get_value("Voltar"), "voltar");

		int res = game_menu.run();
		if(res < 0) return;
		string op = game_menu.get_item_id(res);
		if(op == "adicionar") {
			menu_adicionar_multiplos("amigo");
			continue;
		}
		else if(op == "listar") {
			send_reliable(peer_id, CLIENT_PROTO_FRIEND_LIST, 0);
			continue;
		}
		else if(op == "voltar") {
			menu_social_principal();
			return;
		}
	}
}

void menu_guilda_social() {
	setupmenu();
	game_menu.intro_text = pu.get_value("Gerenciar guilda");
	game_menu.add_item(pu.get_value("Aceitar convite"), "aceitar");
	game_menu.add_item(pu.get_value("Convidar jogadores"), "convidar");
	game_menu.add_item(pu.get_value("Informacoes da guilda"), "info");
	game_menu.add_item(pu.get_value("Criar guilda"), "criar");
	game_menu.add_item(pu.get_value("Sair da guilda"), "sair");
	game_menu.add_item(pu.get_value("Voltar"), "voltar");

	int res = game_menu.run();
	if(res < 0) return;
	string op = game_menu.get_item_id(res);

	if(op == "aceitar") send_reliable(peer_id, "/joinguild", 0);
	else if(op == "convidar") menu_adicionar_multiplos("guilda");
	else if(op == "info") send_reliable(peer_id, "/guildinfo", 0);
	else if(op == "sair") send_reliable(peer_id, "/leaveguild", 0);
	else if(op == "criar") {
		input_form form(pu.get_value("Criar guilda"));
		form.add_text_field("nome", pu.get_value("Nome da guilda"), "", true);
		form.add_text_field("tag", pu.get_value("Tag da guilda (ate 5)"), "", false);
		dictionary@ result = form.run();
		if(!form.user_canceled) {
			string nome = "";
			string tag = "";
			result.get("nome", nome);
			result.get("tag", tag);
			nome = nome.trim_whitespace();
			tag = tag.trim_whitespace();
			if(nome == "") {
				speak(pu.get_value("Nome da guilda inválido."));
				return;
			}
			send_reliable(peer_id, "/createguild " + nome + " " + tag, 0);
		}
	}
	else if(op == "voltar") menu_social_principal();
}

void menu_social_principal() {
	if(ausente || !moveable) return;

	setupmenu();
	game_menu.intro_text = pu.get_value("Menu social");
	game_menu.add_item(pu.get_value("Amigos"), "amigos");
	game_menu.add_item(pu.get_value("Equipe"), "equipe");
	game_menu.add_item(pu.get_value("Guilda"), "guilda");
	game_menu.add_item(pu.get_value("Fechar"), "fechar");

	int res = game_menu.run();
	if(res < 0) return;
	string op = game_menu.get_item_id(res);
	if(op == "amigos") menu_amigos_social();
	else if(op == "equipe") menu_equipe_social();
	else if(op == "guilda") menu_guilda_social();
}
