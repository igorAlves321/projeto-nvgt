
void optionsmenu() {
	setupmenu();
	game_menu.add_item(pu.get_value("OPT_GENERAL"), "general");
	game_menu.add_item(pu.get_value("OPT_PROFILE"), "profile");
	game_menu.add_item(pu.get_value("OPT_NOTIFICATIONS"), "notifications");
	game_menu.add_item(pu.get_value("OPT_BACK"), "back");

	game_menu.intro_text = pu.get_value("OPT_MAIN_TITLE");

	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);

	if(selected_id == "general") {
		gerais();
		optionsmenu();
	}
	else if(selected_id == "profile") {
		perfio();
		optionsmenu();
	}
	else if(selected_id == "notifications") {
		notificacoes_menu();
		optionsmenu();
	}
	else if(selected_id == "back") {
		menuprincipal();
	}
	else {
		menuprincipal();
	}
}

void gerais() {
	setupmenu();

	if(sidescrolling == 1) game_menu.add_item(pu.get_value("OPT_MOVE_SIDE"), "side");
	else game_menu.add_item(pu.get_value("OPT_MOVE_VERT"), "side");

	if(autosave == 1) game_menu.add_item(pu.get_value("OPT_AUTOSAVE_ON"), "autosave");
	else game_menu.add_item(pu.get_value("OPT_AUTOSAVE_OFF"), "autosave");

	if(asktoexit == 1) game_menu.add_item(pu.get_value("OPT_CONFIRM_EXIT_ON"), "asktoexit");
	else game_menu.add_item(pu.get_value("OPT_CONFIRM_EXIT_OFF"), "asktoexit");

	game_menu.add_item(pu.get_value("OPT_MENU_VOLUME") + " (" + int(musicamenu) + "%)", "musicvol");
	game_menu.add_item(pu.get_value("OPT_BACK"), "back");

	game_menu.intro_text = pu.get_value("OPT_GENERAL");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);

	if(mres < 0 || selected_id == "back") {
		return;
	}
	else if(selected_id == "side") {
		if(sidescrolling == 1) sidescrolling = 0;
		else sidescrolling = 1;
		writeprefs();
		gerais();
	}
	else if(selected_id == "autosave") {
		if(autosave == 1) autosave = 0;
		else autosave = 1;
		writeprefs();
		gerais();
	}
	else if(selected_id == "asktoexit") {
		if(asktoexit == 1) asktoexit = 0;
		else asktoexit = 1;
		writeprefs();
		gerais();
	}
	else if(selected_id == "musicvol") {
		float new_vol = volume_slider_menu(pu.get_value("OPT_MENU_VOLUME"), musicamenu);
		if(new_vol >= 0) {
			musicamenu = new_vol;
			ensure_menu_music_volume();
			writeprefs();
		}
		gerais();
	}
	else {
		gerais();
	}
}

void notificacoes_menu() {
	setupmenu();

	game_menu.add_item(checkbox_label(pu.get_value("Avisar desconexões"), avisadesconectou == 1), "disconn");
	game_menu.add_item(checkbox_label(pu.get_value("Avisar ao subir de nível"), avisanivel == 1), "level");
	game_menu.add_item(checkbox_label(pu.get_value("Ouvir sons de morte"), ouvirmortes == 1), "death");
	game_menu.add_item(pu.get_value("OPT_BACK"), "back");

	game_menu.intro_text = pu.get_value("OPT_NOTIFICATIONS");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);

	if(mres < 0 || selected_id == "back") {
		return;
	}
	else if(selected_id == "disconn") {
		if(avisadesconectou == 1) avisadesconectou = 0;
		else avisadesconectou = 1;
		writeprefs();
		notificacoes_menu();
	}
	else if(selected_id == "level") {
		if(avisanivel == 1) avisanivel = 0;
		else avisanivel = 1;
		writeprefs();
		notificacoes_menu();
	}
	else if(selected_id == "death") {
		if(ouvirmortes == 1) ouvirmortes = 0;
		else ouvirmortes = 1;
		writeprefs();
		notificacoes_menu();
	}
}

void perfio() {
	setupmenu();

	game_menu.add_item(pu.get_value("OPT_VOICE_SELECT"), "voice");
	game_menu.add_item(pu.get_value("OPT_LANG_SELECT"), "lang");
	game_menu.add_item(pu.get_value("OPT_BACK"), "back");

	game_menu.intro_text = pu.get_value("OPT_PROFILE");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);

	if(mres < 0 || selected_id == "back") {
		return;
	}
	else if(selected_id == "voice") {
		voicemenu();
		perfio();
	}
	else if(selected_id == "lang") {
		string new_lang = idiomas();
		if(new_lang != "") {
			cmfinal = new_lang;
			pu.set_arquivo(cmfinal);
			writeprefs();
			speak(pu.get_value("Idioma alterado."));
		}
		perfio();
	}
	else {
		perfio();
	}
}
