// Classe source2 - fontes de som secundÃ¡rias (ambientes, mÃºsica de fundo)
// Migrada de src2.bgt para NVGT
class source2 {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string sound_file;
	sound@ snd;
	bool active = false;
	int volume = 0;
	
	source2() {
		@snd = sound();
	}
	
	void stop() {
		if(snd.playing) {
			snd.stop();
		}
		active = false;
	}
	
	void destroy() {
		stop();
		@snd = null;
	}
}
source2@[] source2s;

void destroy_all_source2s(bool delete_sounds = true) {
	// Para e destrÃ³i todas as source2 (fontes de som secundÃ¡rias)
	for(uint i = 0; i < source2s.length(); i++) {
		if(source2s[i] !is null) {
			if(delete_sounds) {
				source2s[i].destroy();
			} else {
				source2s[i].stop();
			}
		}
	}
	source2s.resize(0);
}

