// ==================== FUNÇÕES DE DESTRUIÇÃO DE MAPA (Chamadas em mapreset) ====================
// Array global de lojas (stores não são usadas no cliente, gerenciadas via zones)
// Mantido para compatibilidade com código legado
class store_class {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string name;
}
store_class@[] stores;

void destroy_stores() {
	// Limpa o array de lojas
	// No código NVGT atual, lojas são armazenadas como zones
	// Esta função existe para compatibilidade com mapreset()
	stores.resize(0);
}

// Classe source2 - fontes de som secundárias (ambientes, música de fundo)
// Migrada de src2.bgt para NVGT
class source2 {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string sound_file;
	sound@ snd;
	bool active = false;
	int volume = 0;
	
	source2() {
		@snd = sound();
	}
	
	void stop() {
		if(snd.playing) {
			snd.stop();
		}
		active = false;
	}
	
	void destroy() {
		stop();
		@snd = null;
	}
}
source2@[] source2s;

void destroy_all_source2s(bool delete_sounds = true) {
	// Para e destrói todas as source2 (fontes de som secundárias)
	for(uint i = 0; i < source2s.length(); i++) {
		if(source2s[i] !is null) {
			if(delete_sounds) {
				source2s[i].destroy();
			} else {
				source2s[i].stop();
			}
		}
	}
	source2s.resize(0);
}

