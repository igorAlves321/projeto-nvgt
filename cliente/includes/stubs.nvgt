class downloader_class {
	void perform_download() {
		// Compatibilidade: fluxo novo usa dl_file diretamente.
		finished = true;
		progress = 100.0;
	}
	bool finished = false;
	double progress = 0.0;
};
downloader_class dl;

class download_class {
	private bool active = false;
	private int percent = 0;

	void initiate_download(string url, string filename) {
		active = true;
		percent = 0;
		string status = dl_file(url, filename, true);
		percent = (status == "finished") ? 100 : 0;
		active = false;
	}
	bool is_active() { return active; }
	void monitor() {
        // Download síncrono no NVGT atual: não há polling incremental.
	}
	void abort() { active = false; }
	int get_percentage() { return percent; }
}
download_class download;

string get_parent_directory_path(string filepath) {
	if(filepath == "") return "";

	int slash_pos = filepath.find_last("/");
	int backslash_pos = filepath.find_last("\\");
	int cut = slash_pos;
	if(backslash_pos > cut) cut = backslash_pos;
	if(cut <= 0) return "";
	return filepath.substr(0, cut);
}

string dl_file(string url, string filename, bool quiet = true) {
	string target_url = url.trim_whitespace();
	string target_file = filename.trim_whitespace();

	if(target_url == "" || target_file == "") {
		return "invalid";
	}

	string parent_dir = get_parent_directory_path(target_file);
	if(parent_dir != "" && !directory_exists(parent_dir)) {
		if(!directory_create(parent_dir)) {
			return "dir_error";
		}
	}

	string data = url_get(target_url);
	if(data == "") {
		return "failed";
	}

	file f;
	if(!f.open(target_file, "wb")) {
		return "file_error";
	}
	f.write(data);
	f.close();

	if(!quiet) speak("Download concluido.");
	return "finished";
}

// ==================== LOJAS ====================
void open_generic_store(string store_type) {
	if(ausente || !player_moveable) return;

	string normalized = store_type.trim_whitespace().lower();
	if(normalized == "") normalized = "mista";

	if(normalized == "armas" || normalized == "explosivos" || normalized == "armasbertalina") {
		explosivos();
		return;
	}

	if(normalized == "lanchonete" || normalized == "bar") {
		barlanchonete();
		return;
	}

	game_net.send(net_peer_id, encrypt_packet("/store"), 0, true);
	speak(pu.get_value("Solicitando itens da loja..."), true);
}

void roupas() {
	open_generic_store("roupas");
}

void armasbertalina() {
	open_generic_store("armas");
}

void pesca() {
	open_generic_store("pesca");
}

void farmacia() {
