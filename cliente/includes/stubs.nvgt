// ==================== FUNÇÕES DE ÁUDIO (Ainda não implementadas) ====================
void saveaudio(string voice_data) {
	if(voice_data == "") return;

	string base_dir = "logs";
	if(!directory_exists(base_dir)) {
		directory_create(base_dir);
	}
	string voices_dir = base_dir + "/voices";
	if(!directory_exists(voices_dir)) {
		directory_create(voices_dir);
	}

	datetime dt;
	string stamp = dt.format("%Y%m%d_%H%M%S");
	string path = voices_dir + "/voice_" + stamp + "_" + random(1000, 9999) + ".ogg";

	file f;
	if(!f.open(path, "wb")) return;
	f.write(voice_data);
	f.close();
}

void eagle_speak_current_message(string[]@ messages, int index) {
	if(@messages == null) return;
	if(index < 0 || index >= int(messages.length())) return;

	string[] fields = messages[index].split("=");
	if(fields.length() >= 5) {
        speak(fields[0] + ", " + pu.get_value("enviado por") + " " + fields[2] + " " + pu.get_value("às") + " " + fields[4] + " " + pu.get_value("na data") + " " + fields[3] + ".");
	} else {
		speak(pu.get_value(messages[index]));
	}
}

void show_eagle_messages(string[] messages) {
	if(messages.length() == 0) {
        speak(pu.get_value("Nenhuma mensagem disponível."));
		return;
	}

	key_hold left_hold(KEY_LEFT, 500, 50);
	key_hold right_hold(KEY_RIGHT, 500, 50);

	int counter = 0;
	string[] fields;

    speak(pu.get_value("Para se deslocar entre os pergaminhos atualmente disponíveis pressione setas direita e esquerda, para responder algum pressione ctrl+r e para ler sua mensagem pressione enter sobre ele. Tenha em conta que ao pressionar ctrl+r e enviar sua resposta esse pergaminho ficará marcado e será eliminado da lista."));
	eagle_speak_current_message(messages, counter);

	while(true) {
		wait(5);
		if(key_pressed(KEY_ESCAPE)) break;

		if(left_hold.pressing() && counter > 0) {
			counter--;
			eagle_speak_current_message(messages, counter);
		}
		if(right_hold.pressing() && counter < int(messages.length()) - 1) {
			counter++;
			eagle_speak_current_message(messages, counter);
		}
		if(key_pressed(KEY_HOME) && counter > 0) {
			counter = 0;
			eagle_speak_current_message(messages, counter);
		}
		if(key_pressed(KEY_END) && counter < int(messages.length()) - 1) {
			counter = int(messages.length()) - 1;
			eagle_speak_current_message(messages, counter);
		}

		if((key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER)) && counter >= 0 && counter < int(messages.length())) {
			fields = messages[counter].split("=");
			if(fields.length() > 1) speak(fields[1]);
			else speak(pu.get_value(messages[counter]));
		}

		bool ctrl_down = key_down(KEY_LCONTROL) || key_down(KEY_RCONTROL);
		if(ctrl_down && key_pressed(KEY_R) && counter >= 0 && counter < int(messages.length())) {
			fields = messages[counter].split("=");
			if(fields.length() < 3) {
                speak(pu.get_value("Mensagem inválida para resposta."));
				continue;
			}

			string answer = v.input(pu.get_value("Escreva sua resposta para o pergaminho selecionado."));
			if(answer != "") {
				send_reliable(peer_id, "answer_to::" + fields[0] + "::" + fields[2] + "::" + messages[counter] + "::" + answer, 13);
			}
		}
	}
}

