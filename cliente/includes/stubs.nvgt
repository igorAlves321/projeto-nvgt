void set_player_peaceful(string name, bool peaceful) {
	for(uint i = 0; i < players.length(); i++) {
		if(players[i].charname == name) {
			players[i].pacifico = peaceful ? 1 : 0;
			break;
		}
	}
}

// ==================== FUNÃ‡Ã•ES DE INVENTÃRIO (Ainda nÃ£o implementadas) ====================
void load_secondary_inventory(string data) {
	string content = data;
	if(content.find("invsec ") == 0) {
		content = content.substr(7);
	}

	string[] lines = delinear(content);
	itenssecundarios.resize(0);

	for(uint i = 0; i < lines.length(); i++) {
		string item = trim_string(lines[i]);
		if(item == "") continue;
		if(itenssecundarios.find(item) < 0) {
			itenssecundarios.insert_last(item);
		}
	}

	if(itenssecundarios.length() == 0) {
		invsecundario = 0;
		return;
	}

	if(invsecundario < 0) invsecundario = 0;
	if(invsecundario >= int(itenssecundarios.length())) {
		invsecundario = int(itenssecundarios.length()) - 1;
	}
}

// ==================== FUNÃ‡Ã•ES DE MENU (Ainda nÃ£o implementadas) ====================
int menu_jump_by_first_letter(string[]@ items, int current_index, const string&in letter) {
	if(@items == null || items.length() == 0) return current_index;
	if(letter == "" || letter == " " || letter.length() != 1) return current_index;
	string target = letter.lower();

	int start = current_index + 1;
	if(start < 0) start = 0;
	for(int i = start; i < int(items.length()); i++) {
		if(items[i].length() == 0) continue;
		if(items[i].substr(0, 1).lower() == target) return i;
	}
	for(int i = 0; i <= current_index && i < int(items.length()); i++) {
		if(items[i].length() == 0) continue;
		if(items[i].substr(0, 1).lower() == target) return i;
	}
	return current_index;
}

void textmenu(string[] items) {
	if(items.length() <= 0) return;

	reset_all_forced_keys();
	key_hold iup(KEY_UP, 500, 50);
	key_hold idown(KEY_DOWN, 500, 50);

	string[] parts = items[0].split("==");
	if(parts.length() < 3) {
		speak("[ERRO] menutext malformado.");
		return;
	}

	string packet = parts[0];
	int channel = string_to_number(parts[1]);
	string filename = parts[2];
	items.remove_at(0);

	int counter = items.length() > 0 ? 0 : -1;
	speak(pu.get_value("menÃº de ediciÃ³n."));
	if(counter >= 0) speak(pu.get_value(items[counter]));

	while(true) {
		wait(5);

		if(key_pressed(KEY_ESCAPE)) break;

		if(key_pressed(KEY_HOME) && counter > 0) {
			counter = 0;
			speak(pu.get_value(items[counter]));
		}
		if(key_pressed(KEY_END) && counter < int(items.length()) - 1) {
			counter = int(items.length()) - 1;
			speak(pu.get_value(items[counter]));
		}
		if(iup.pressing() && counter > 0) {
			counter--;
			speak(pu.get_value(items[counter]));
		}
		if(idown.pressing() && counter < int(items.length()) - 1) {
			counter++;
			speak(pu.get_value(items[counter]));
		}

		if(!shift_pressionado()) {
			if((key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER)) && counter >= 0 && counter < int(items.length())) {
				string before = items[counter];
				string edited = v.input(pu.get_value("escriba o modifique lo correspondiente."));
				if(edited == "") edited = before;
				if(edited != "") {
					items[counter] = edited;
					speak(pu.get_value("LÃ­nea actualizada. Para enviar el contenido al servidor pulse shift+enter."));
				}
			}
		}

		bool ctrl_down = key_down(KEY_LCONTROL) || key_down(KEY_RCONTROL);
		if(ctrl_down && key_pressed(KEY_A)) {
			string new_line = v.input(pu.get_value("Nueva lÃ­nea. Por favor escriba el texto de la lÃ­nea que desea agregar, y pulse enter:"));
			if(new_line != "") {
				items.insert_last(new_line);
				if(counter < 0) counter = 0;
			}
		}

		if(key_pressed(KEY_DELETE) && counter >= 0 && counter < int(items.length())) {
			bool confirm = simple_yes_no(pu.get_value("Â¿EstÃ¡ seguro que desea borrar la lÃ­nea actual? esta acciÃ³n no se puede deshacer."));
			if(confirm) {
				items.remove_at(counter);
				speak(pu.get_value("LÃ­nea eliminada."));
				if(counter >= int(items.length())) counter = int(items.length()) - 1;
			}
		}

		if(shift_pressionado() && key_pressed(KEY_RETURN)) {
			send_reliable(peer_id, packet + " " + filename + " " + linear(items), channel);
		}

		string cl = get_characters();
		if(cl != "" && cl != " " && cl.length() == 1 && items.length() > 0) {
			int new_index = menu_jump_by_first_letter(items, counter, cl);
			if(new_index != counter && new_index >= 0 && new_index < int(items.length())) {
				counter = new_index;
				string msg = pu.get_value(items[counter]);
				speak(msg);
				copiaragora = msg;
			}
		}

		if(ctrl_down && key_pressed(KEY_C)) {
			clipboard_copy_text(linear(items));
			speak(pu.get_value("copiado al portapapeles."));
		}
	}
}

void menul(string[] items) {
	if(items.length() <= 0) return;

	string[] div = items[0].split(bell);
	reset_all_forced_keys();
	key_hold iup(KEY_UP, 500, 50);
	key_hold idown(KEY_DOWN, 500, 50);

	items.remove_at(0);
	if(div.length() > 0) speak(translate_with_char(div[0], ";"));

	int counter = items.length() > 0 ? 0 : -1;
	while(true) {
		wait(5);
		if(key_pressed(KEY_ESCAPE)) break;

		if(key_pressed(KEY_HOME) && counter > 0) {
			counter = 0;
			speak(translate_with_char(items[counter], ";"));
		}
		if(key_pressed(KEY_END) && counter < int(items.length()) - 1) {
			counter = int(items.length()) - 1;
			speak(translate_with_char(items[counter], ";"));
		}
		if(iup.pressing() && counter > 0) {
			counter--;
			speak(translate_with_char(items[counter], ";"));
		}
		if(idown.pressing() && counter < int(items.length()) - 1) {
			counter++;
			speak(translate_with_char(items[counter], ";"));
		}

		string cl = get_characters();
		if(cl != "" && cl != " " && cl.length() == 1 && items.length() > 0) {
			int new_index = menu_jump_by_first_letter(items, counter, cl);
			if(new_index != counter && new_index >= 0 && new_index < int(items.length())) {
				counter = new_index;
				string msg = pu.get_value(items[counter]);
				speak(msg);
				copiaragora = msg;
			}
		}

		bool ctrl_down = key_down(KEY_LCONTROL) || key_down(KEY_RCONTROL);
		if(ctrl_down && key_pressed(KEY_C)) {
			clipboard_copy_text(linear(items));
			speak(pu.get_value("copiado al portapapeles."));
		}
	}
}

void menul2(string[] items) {
	if(items.length() <= 0) return;

	string[] div = items[0].split(bell);
	reset_all_forced_keys();
	key_hold iup(KEY_UP, 500, 50);
	key_hold idown(KEY_DOWN, 500, 50);
	key_hold ileft(KEY_LEFT, 500, 50);
	key_hold iright(KEY_RIGHT, 500, 50);
	key_hold inext(KEY_NEXT, 500, 50);
	key_hold iprior(KEY_PRIOR, 500, 50);

	items.remove_at(0);
	if(div.length() > 0) speak(pu.get_value(div[0]));

	int counter = -1;
	while(true) {
		wait(5);
		if(key_pressed(KEY_ESCAPE)) break;

		string cl = get_characters();
		if(cl != "" && cl != " " && cl.length() == 1 && items.length() > 0) {
			int new_index = menu_jump_by_first_letter(items, counter, cl);
			if(new_index != counter && new_index >= 0 && new_index < int(items.length())) {
				counter = new_index;
				string msg = items[counter];
				send_unreliable(peer_id, "playsocial door17open.ogg", 0);
				speak(pu.get_value(msg + ", " + items[counter]));
				copiaragora = pu.get_value(msg + ", " + items[counter]);
			}
		}

		if(key_pressed(KEY_HOME) && counter > 0) {
			counter = 0;
			speak(pu.get_value(items[counter]));
		}
		if(key_pressed(KEY_END) && counter < int(items.length()) - 1) {
			counter = int(items.length()) - 1;
			speak(pu.get_value(items[counter]));
		}
		if((key_pressed(KEY_PRIOR) || iprior.pressing()) && counter > 10) {
			counter -= 10;
			speak(pu.get_value(items[counter]));
		}
		if((key_pressed(KEY_NEXT) || inext.pressing()) && counter < int(items.length()) - 10) {
			counter += 10;
			speak(pu.get_value(items[counter]));
		}
		if(ileft.pressing() && counter > 50) {
			counter -= 50;
			speak(pu.get_value(items[counter]));
		}
		if(iright.pressing() && counter < int(items.length()) - 50) {
			counter += 50;
			speak(pu.get_value(items[counter]));
		}
		if(iup.pressing() && counter > 0) {
			counter--;
			speak(pu.get_value(items[counter]));
		}
		if(idown.pressing() && counter < int(items.length()) - 1) {
			counter++;
			speak(pu.get_value(items[counter]));
		}

		if((key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER)) && counter >= 0 && counter < int(items.length()) && div.length() > 1) {
			send_unreliable(peer_id, div[1] + " " + items[counter], 0);
		}
	}
}

