const int VOICE_CHANNEL = 7;
const int MAX_RECORD_TIME = 5000;
const float VOICE_RANGE = 50.0;
const string VOICE_TEMP_DIR = "temp/";
const string VOICE_TEST_FILE = "voice_test_last.wav";
const uint VOICE_TEST_SAMPLE_RATE = 16000;
const uint VOICE_TEST_CHANNELS = 1;
const bool VOICE_ENABLE_NETWORK_SEND = false;
string sanitize_voice_filename(const string&in raw) {
	string name = raw.trim_whitespace();
	if(name == "") return "unknown";
	name = name.replace("\\", "_");
	name = name.replace("/", "_");
	name = name.replace(":", "_");
	name = name.replace("*", "_");
	name = name.replace("?", "_");
	name = name.replace("\"", "_");
	name = name.replace("<", "_");
	name = name.replace(">", "_");
	name = name.replace("|", "_");
	return name;
}
class voice_message_recorder {
	bool is_recording = false;
	bool used_default_fallback = false;
	timer record_timer;
	int max_record_time = MAX_RECORD_TIME;
	string temp_file = VOICE_TEMP_DIR + VOICE_TEST_FILE;
	int selected_input_device = -1;
	library mci_lib;
	voice_message_recorder() {
		if(!directory_exists(VOICE_TEMP_DIR)) {
			directory_create(VOICE_TEMP_DIR);
		}
	}
	bool ensure_mci_loaded() {
		if(mci_lib.active) return true;
		return mci_lib.load("winmm.dll");
	}
	int mci_send(string command) {
		if(!ensure_mci_loaded()) return -1;
		string output;
		output.resize(255);
		var@ result = mci_lib.call("int mciSendStringA(char*, char*, int, int);", command, output, output.length(), 0);
		if(@result == null) return -1;
		return int(result);
	}
	void close_mci_alias() {
		mci_send("close igvoice wait");
	}
	bool begin_mci_recording() {
		close_mci_alias();
		if(mci_send("open new type waveaudio alias igvoice wait") != 0) return false;
		if(mci_send("set igvoice time format ms bitspersample 16 channels 1 samplespersec 16000 format tag pcm wait") != 0) {
			close_mci_alias();
			return false;
		}
		if(mci_send("record igvoice") != 0) {
			close_mci_alias();
			return false;
		}
		return true;
	}
	bool stop_mci_recording_and_save(const string &in filename) {
		if(mci_send("stop igvoice wait") != 0) {
			close_mci_alias();
			return false;
		}
		string safe_filename = filename.replace("\"", "");
		int save_ret = mci_send("save igvoice \"" + safe_filename + "\" wait");
		close_mci_alias();
		return save_ret == 0;
	}
	void update() {
		bool ctrl_down = key_down(KEY_LCONTROL) || key_down(KEY_RCONTROL);
		bool alt_down = key_down(KEY_LMENU) || key_down(KEY_RMENU);
		if(ctrl_down || alt_down) {
			if(is_recording) {
				stop_and_send();
			}
			return;
		}
		if(key_down(KEY_Z) && !is_recording) {
			start_recording();
		}
		if(!key_down(KEY_Z) && is_recording) {
			stop_and_send();
		}
		if(is_recording && record_timer.elapsed >= max_record_time) {
			stop_and_send();
		}
	}
	void start_recording() {
		if(is_recording) return;
		cleanup_recording_graph();
		selected_input_device = voice_input_device;
		used_default_fallback = selected_input_device >= 0;
		if(used_default_fallback) {
			screen_reader_speak("Microfone selecionado indisponível, usando o padrão do sistema", true);
		}
		if(!begin_mci_recording()) {
			screen_reader_speak("Não foi possível iniciar a gravação de voz nesta build", true);
			return;
		}
		is_recording = true;
		record_timer.restart();
		screen_reader_speak("Gravando mensagem de voz", true);
	}
	void set_input_device(int device_index) {
		selected_input_device = device_index;
	}
	void stop_and_send() {
		if(!is_recording) return;
		is_recording = false;
		uint64 duration = record_timer.elapsed;
		debug_log("Finalizando gravação (" + duration + "ms)");
		if(duration < 200) {
			cleanup_recording_graph();
			screen_reader_speak("Mensagem muito curta", true);
			return;
		}
		if(!stop_mci_recording_and_save(temp_file)) {
			screen_reader_speak("Falha ao finalizar a gravação de voz", true);
			return;
		}
		if(VOICE_ENABLE_NETWORK_SEND) {
			send_voice_message();
			screen_reader_speak("Mensagem enviada", true);
		}
		else {
			screen_reader_speak("Gravação salva em " + temp_file, true);
		}
	}
	void send_voice_message() {
		if(!VOICE_ENABLE_NETWORK_SEND) return;
		file f;
		string audio_data = "";
		audio_data = "[VOICE_PLACEHOLDER_" + record_timer.elapsed + "ms]";
		int pos_x = game_me.x;
		int pos_y = game_me.y;
		int pos_z = 0;
		string packet = "VOICE_MSG|" + un + "|" + pos_x + "|" + pos_y + "|" + pos_z + "|" + audio_data;
		if(@con != null && is_connected) {
			string encrypted = encrypt_packet(packet);
			uint64 target_peer = net_peer_id > 0 ? net_peer_id : uint64(peer_id);
			con.send(target_peer, encrypted, VOICE_CHANNEL, false);
			debug_log("📤 Enviado voice_msg: " + un + " em (" + pos_x + "," + pos_y + ")");
		}
	}
	void cleanup_recording_graph() {
		close_mci_alias();
	}
}
class voice_message_player {
	dictionary active_voices;
	dictionary cleanup_timers;
	voice_message_player() {
		set_sound_global_hrtf(true);
		debug_log("Voice message player inicializado (HRTF ativado)");
	}
	void update() {
		cleanup_finished_voices();
	}
	void handle_voice_message(string message) {
		string payload = message;
		if(payload.find("VOICE_PLAY|") == 0) {
			payload = payload.substr(11);
		}
		string[] parts = payload.split("|");
		if(parts.length() < 5) {
			debug_log(" Voice message inválida: " + parts.length() + " partes");
			return;
		}
		string sender_id = parts[0];
		int sender_x = parse_int(parts[1]);
		int sender_y = parse_int(parts[2]);
		int sender_z = parse_int(parts[3]);
		string audio_data = parts[4];
		for(uint i = 5; i < parts.length(); i++) {
			audio_data += "|" + parts[i];
		}
		debug_log("Recebido voice de " + sender_id + " em (" + sender_x + "," + sender_y + "," + sender_z + ")");
		play_voice_message(sender_id, sender_x, sender_y, sender_z, audio_data);
	}
	void play_voice_message(string sender_id, int sender_x, int sender_y, int sender_z, string audio_data) {
		stop_voice(sender_id);
		string safe_sender = sanitize_voice_filename(sender_id);
		string temp_voice_file = VOICE_TEMP_DIR + "voice_" + safe_sender + ".ogg";
		bool has_real_audio = (audio_data.find("[VOICE_PLACEHOLDER") != 0 && audio_data.trim_whitespace() != "");
		bool loaded = false;
		sound@ voice = sound();
		if(has_real_audio) {
			file f;
			if(f.open(temp_voice_file, "wb")) {
				f.write(audio_data);
				f.close();
				loaded = voice.load(temp_voice_file);
			}
		}
		if(!loaded) {
			loaded = voice.load(get_sound_path("message.ogg"));
		}
		if(loaded) {
			float relative_x = sender_x - game_me.x;
			float relative_y = sender_y - game_me.y;
			float relative_z = sender_z - 0;
			voice.set_position_3d(relative_x, relative_y, relative_z);
			voice.play();
			@active_voices[sender_id] = @voice;
			timer@ cleanup_timer = timer();
			@cleanup_timers[sender_id] = @cleanup_timer;
			debug_log("Reproduzindo voice de " + sender_id + " em posicao relativa (" + relative_x + "," + relative_y + "," + relative_z + ")");
			if(sender_id != un) {
				screen_reader_speak("Mensagem de " + sender_id, true);
			}
		}
		else {
			debug_log("Falha ao carregar som de notificacao para voice message");
		}
	}
	void stop_voice(string sender_id) {
		sound@ voice;
		if(active_voices.get(sender_id, @voice)) {
			if(@voice != null) {
				voice.close();
			}
			active_voices.delete(sender_id);
			cleanup_timers.delete(sender_id);
		}
	}
	void cleanup_finished_voices() {
		string[] keys = active_voices.get_keys();
		for(uint i = 0; i < keys.length(); i++) {
			string sender_id = keys[i];
			sound@ voice;
			timer@ cleanup_timer;
			if(active_voices.get(sender_id, @voice) &&
			   cleanup_timers.get(sender_id, @cleanup_timer)) {
				if(@cleanup_timer != null && cleanup_timer.elapsed >= 10000) {
					stop_voice(sender_id);
					debug_log("Limpeza de voice: " + sender_id);
				}
				else if(@voice != null && !voice.playing) {
					stop_voice(sender_id);
				}
			}
		}
	}
	void stop_all_voices() {
		string[] keys = active_voices.get_keys();
		for(uint i = 0; i < keys.length(); i++) {
			stop_voice(keys[i]);
		}
		debug_log("Todas as vozes paradas");
	}
}
voice_message_recorder voice_recorder;
voice_message_player voice_player;
void init_voice_chat() {
	set_sound_global_hrtf(true);
	if(!directory_exists(VOICE_TEMP_DIR)) {
		directory_create(VOICE_TEMP_DIR);
	}
	voice_recorder.set_input_device(voice_input_device);
	debug_log("Sistema de voice chat inicializado (HRTF: ON)");
}
string voice_input_device_label() {
	const string[]@ devices = get_sound_input_devices();
	if(@devices != null && voice_input_device >= 0 && voice_input_device < int(devices.length())) {
		string name = devices[voice_input_device];
		if(name != "") return name;
	}
	return pu.get_value("Padrão do sistema");
}
bool select_voice_input_device_menu() {
	const string[]@ devices = get_sound_input_devices();
	if(@devices == null || devices.length() == 0) {
		dlg(pu.get_value("Nenhum dispositivo de entrada de áudio foi encontrado."));
		return false;
	}
	setupmenu();
	game_menu.add_item(pu.get_value("Padrão do sistema"), "mic:-1");
	for(uint i = 0; i < devices.length(); i++) {
		if(i == 0) continue;
		string device_name = devices[i];
		if(device_name == "") continue;
		game_menu.add_item(device_name, "mic:" + i);
	}
	game_menu.add_item(pu.get_value("Voltar"), "back");
	game_menu.intro_text = pu.get_value("Selecione o microfone.");
	int mres = game_menu.run();
	string selected_id = game_menu.get_item_id(mres);
	if(mres <= 0 || selected_id == "back") {
		return false;
	}
	if(selected_id.find("mic:") != 0) {
		return false;
	}
	int new_device = parse_int(selected_id.substr(4));
	voice_input_device = new_device;
	voice_recorder.set_input_device(new_device);
	return true;
}
void update_voice_chat() {
	voice_recorder.update();
	voice_player.update();
}
void handle_voice_packet(string message) {
	if(message.find("VOICE_PLAY|") == 0) {
		voice_player.handle_voice_message(message);
	}
}
