// ===== FUNÇÕES DE AUTENTICAÇÃO COM HASH SHA-256 =====

// Função helper para hash de senhas usando SHA-256
string hash_password(string password) {
	if(password == "") return "";
	// Retorna hash SHA-256 em formato hexadecimal
	return string_hash(password, 1, false);
}

// ===== FUNÇÕES DE REDE NATIVAS NVGT =====

