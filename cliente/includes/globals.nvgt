void send_reliable(uint64 peer_id, string message, int channel = 0) {
	game_client.send_reliable(message, channel);
}

void send_unreliable(uint64 peer_id, string message, int channel = 0) {
	game_client.send_unreliable(message, channel);
}

void send_movement(uint64 peer_id, string message, int channel = 0) {
	movement_seq++;
	if(movement_seq > 65535) movement_seq = 1;

	string seq_message = "seq:" + movement_seq + " " + message;
	game_client.send_unreliable(seq_message, channel);
}

bool verify_password(string password, string hash) {
	if(password == "" || hash == "") return false;
	return (hash_password(password) == hash);
}

