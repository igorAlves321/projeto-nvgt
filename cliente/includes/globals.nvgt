	client_menu.reset(true);
	@client_menu.pack_file = @sound_default_pack;
	client_menu.click_sound = "menumove.ogg";
	client_menu.select_sound = "menuenter.ogg";
	client_menu.close_sound = "menuvolta.ogg";
	client_menu.wrap = false;
}

class m_helper {
	void add_item_tts(string text, string value) {
		client_menu.add_item(text, value);
	}
	int run(string title, bool flag) {
		// Configurar pack antes de rodar
		@client_menu.pack_file = @sound_default_pack;
		client_menu.intro_text = title;
		return client_menu.run();
	}
	string get_item_name(int index) {
		// Fallback: retorna o ID do item já que get_item_text não existe
		return client_menu.get_item_id(index);
	}
}
