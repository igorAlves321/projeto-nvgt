// Função para configurar todos os sound_pools com o pack (igual Batalha Constante)
// Deve ser chamada após sound_default_pack ser configurado
void configure_sound_pools() {
	// Os sound_pools usam sound_default_pack automaticamente quando pack_file é null
	// Mas para garantir, podemos configurar explicitamente:
	@p.pack_file = @sound_default_pack;
	@p2.pack_file = @sound_default_pack;
	@pobjs.pack_file = @sound_default_pack;
	@pcomputador.pack_file = @sound_default_pack;
	@spool.pack_file = @sound_default_pack;
	@steps.pack_file = @sound_default_pack;
	@shoot.pack_file = @sound_default_pack;
	@bodys.pack_file = @sound_default_pack;
	@walls.pack_file = @sound_default_pack;
	@doors_sound.pack_file = @sound_default_pack;
	@npcs.pack_file = @sound_default_pack;
	@pl.pack_file = @sound_default_pack;
	@game_p.pack_file = @sound_default_pack;
	@audio.pack_file = @sound_default_pack;        // Voice chat (sistema legado)
	// Nota: ambientepool é declarado em ambiente.nvgt, mas configuramos aqui também
	@ambientepool.pack_file = @sound_default_pack; // Ambiente (clima, etc)
}

