void writeprefs() {
	string path;
	if(portable) {
		path = PREFSFILE;
	}
	else {
		if(!directory_exists(prefsdir)) directory_create(prefsdir);
		path = prefsdir + "\\" + PREFSFILE;
	}

	// Evita concorrência deixando a instância global pronta para reuso
	pf.close();
	pf.open(path, "wb");

	string s =
"mlang=" + mainlang + "\r\n"
"tradutorativo=" + tradutorativo + "\r\n"
"idiomaorigem=" + idiomaorigem + "\r\n"
"idiomachat=" + idiomachat + "\r\n"
"atu=" + atu + "\r\n"
"ouvirmortes=" + ouvirmortes + "\r\n"
"rcontrol=" + rcontrol + "\r\n"
"nalancha=" + game_lan.nalancha + "\r\n"
"un=" + un + "\r\n"
"pw=" + pw + "\r\n"
"voice=" + voice + "\r\n"
"volumejogo=" + volumejogo + "\r\n"
"ttsrate=" + ttsrate + "\r\n"
"cmfinal=" + cmfinal + "\r\n"
"avisadesconectou=" + avisadesconectou + "\r\n"
"ouvirhits=" + ouvirhits + "\r\n"
"primeiravez=" + primeiravez + "\r\n"
"numero_dispositivo=" + numero_dispositivo + "\r\n"
"usalogo=" + usalogo + "\r\n"
"atualizar=" + atualizar + "\r\n"
"ouvirpassos=" + ouvirpassos + "\r\n"
"ouviremoutrasjanelas=" + ouviremoutrasjanelas + "\r\n"
"musicamenu=" + musicamenu + "\r\n"
"beaconing=" + beaconing + "\r\n"
"wineask=" + wineask + "\r\n"
"interrupt=" + interrupt + "\r\n"
"falarteclas=" + falarteclas + "\r\n"
"asktoexit=" + asktoexit + "\r\n"
"avisanivel=" + avisanivel + "\r\n"
"sidescrolling=" + sidescrolling + "\r\n"
"autosave=" + autosave + "\r\n"
"fps=" + fps + "\r\n"
"f1=" + f1 + "\r\n"
"f2=" + f2 + "\r\n"
"f3=" + f3 + "\r\n"
"f4=" + f4 + "\r\n"
"f5=" + f5 + "\r\n"
"f6=" + f6 + "\r\n"
"f7=" + f7 + "\r\n"
"f8=" + f8 + "\r\n"
"f9=" + f9 + "\r\n"
"f0=" + f0 + "\r\n"
"voice_input_device=" + voice_input_device + "\r\n";

	s = string_encrypt(s, PREFS_ENCRYPTION_KEY);
	pf.write(s);
	pf.close();
}

void dlgplay(string filename, bool flag = false, int volume = 0) {
	if(filename == "") return;
	string full_path = get_sound_path(filename);
	sound s;
	if(!s.load(full_path)) return;
	if(volume > 0) s.volume = volume;
	s.play();
	if(!flag) return;
	while(s.playing) {
		wait(5);
		if(key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER) || key_pressed(KEY_ESCAPE) || key_pressed(KEY_SPACE)) {
			s.stop();
			break;
		}
	}
}

bool msginvalida(string msg) {
	return (msg == "" || msg.find(" ") >= 0);
}

// Input helper - classe virtualizer para entrada de texto acessível
// NOTA: A virtualizer NÃO usa input_box nativo para evitar que leitores de tela
// falem "painel/edição" durante a digitação. Isso melhora a experiência para
// usuários de NVDA/JAWS. Migração para input_form requer testes de acessibilidade.
// @see eplano.txt Task 2.2 para plano de migração futura
virtualizer v;

// Sistema de menus usando classe menu nativa NVGT
menu client_menu;

// Função para configurar client_menu com pack de sons
void setup_client_menu() {
	client_menu.reset(true);
	@client_menu.pack_file = @sound_default_pack;
	client_menu.click_sound = "menumove.ogg";
	client_menu.select_sound = "menuenter.ogg";
	client_menu.close_sound = "menuvolta.ogg";
	client_menu.wrap = false;
}

class m_helper {
	void add_item_tts(string text, string value) {
		client_menu.add_item(text, value);
	}
	int run(string title, bool flag) {
		// Configurar pack antes de rodar
		@client_menu.pack_file = @sound_default_pack;
		client_menu.intro_text = title;
		return client_menu.run();
	}
	string get_item_name(int index) {
		// Fallback: retorna o ID do item já que get_item_text não existe
		return client_menu.get_item_id(index);
	}
}
m_helper m;

// Sistema TTS usando tts_voice nativo NVGT
