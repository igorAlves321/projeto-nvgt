void exitgame() {
	if(exiting) return;
	exiting = true;
	game_exiting = true;
	speak(pu.get_value("Saindo do servidor..."));
	writeprefs();
	if(connected) {
		game_net.send(net_peer_id, "close", 0, true);
	}
	exittimer.restart();
	connected = false;
	connect = false;
}

void sair() {
	exitgame();
	sound door;
	door.load("door1close.ogg");
	door.play_wait();
	exit();
}

