void writeprefs() {
	string path;
	if(portable) {
		path = PREFSFILE;
	}
	else {
		if(!directory_exists(prefsdir)) directory_create(prefsdir);
		path = prefsdir + "\\" + PREFSFILE;
	}

	// Evita concorrÃªncia deixando a instÃ¢ncia global pronta para reuso
	pf.close();
	pf.open(path, "wb");

	string s =
"mlang=" + mainlang + "\r\n"
"tradutorativo=" + tradutorativo + "\r\n"
"idiomaorigem=" + idiomaorigem + "\r\n"
"idiomachat=" + idiomachat + "\r\n"
