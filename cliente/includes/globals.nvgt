// Função para acessar código ASCII de caracteres (conversa de ascii_to_character)
int get_char_code(string text, int index) {
	if(index < 0 || index >= int(text.length())) return 0;
	// NVGT: usar substr para obter 1 char e converter para código ASCII
	string char_str = text.substr(index, 1);
	if(char_str.length() == 0) return 0;
	// Loop para encontrar o código ASCII correspondente (0-255)
	for(int i = 0; i < 256; i++) {
		if(ascii_to_character(i) == char_str) {
			return i;
		}
	}
	return 0; // fallback se não encontrar
}

// Função para aparar espaços em branco
string trim_string(const string &in text) {
	string result = text;
	while(result.length() > 0) {
		uint8 ch = get_char_code(result, 0);
		if(ch == 32 || ch == 9) {
			result = result.substr(1);
			continue;
		}
		break;
	}
	while(result.length() > 0) {
		uint8 ch = get_char_code(result, result.length() - 1);
		if(ch == 32 || ch == 9) {
			result = result.substr(0, result.length() - 1);
			continue;
		}
		break;
	}
	return result;
}

// Função para traduzir caracteres especiais em strings
// Substitui um caractere por outro (ex: ";" por "\n")
string translate_with_char(const string &in text, const string &in char_to_replace) {
	string result = text;
	if(char_to_replace != "") {
		// Substitui o separador informado por quebra de linha.
		result = result.replace(char_to_replace, "\n");
	}
	return result;
}

