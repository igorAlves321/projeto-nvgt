// Função para acessar código ASCII de caracteres (conversa de ascii_to_character)
int get_char_code(string text, int index) {
	if(index < 0 || index >= int(text.length())) return 0;
	// NVGT: usar substr para obter 1 char e converter para código ASCII
	string char_str = text.substr(index, 1);
	if(char_str.length() == 0) return 0;
	// Loop para encontrar o código ASCII correspondente (0-255)
	for(int i = 0; i < 256; i++) {
		if(ascii_to_character(i) == char_str) {
			return i;
		}
	}
	return 0; // fallback se não encontrar
}

// Função para aparar espaços em branco
string trim_string(const string &in text) {
	string result = text;
	while(result.length() > 0) {
		uint8 ch = get_char_code(result, 0);
		if(ch == 32 || ch == 9) {
			result = result.substr(1);
			continue;
		}
		break;
	}
	while(result.length() > 0) {
		uint8 ch = get_char_code(result, result.length() - 1);
		if(ch == 32 || ch == 9) {
			result = result.substr(0, result.length() - 1);
			continue;
		}
		break;
	}
	return result;
}

// Função para traduzir caracteres especiais em strings
// Substitui um caractere por outro (ex: ";" por "\n")
string translate_with_char(const string &in text, const string &in char_to_replace) {
	string result = text;
	if(char_to_replace != "") {
		// Substitui o separador informado por quebra de linha.
		result = result.replace(char_to_replace, "\n");
	}
	return result;
}

// Sistema de localização usando recursos NVGT nativos
class properties_util {
	dictionary data;
	string current_file = "";

	string get_value(const string &in key) {
		string result;
		if(data.get(key, result)) {
			return result;
		}
		return key; // Retorna a própria chave se não encontrar tradução
	}

	void set_value(const string &in key, const string &in value) {
		data.set(key, value);
	}

	void load(const string &in filename) {
		data.delete_all();
		current_file = filename;
		string path = filename;
		if(!file_exists(path)) {
			string alt = "client/" + filename;
			if(file_exists(alt)) {
				path = alt;
			}
			else {
				return;
			}
		}

		file lang_file;
		if(!lang_file.open(path, "rb")) {
			return;
		}
		string content = lang_file.read();
		lang_file.close();
		if(content == "") {
			return;
		}

		if(content.length() >= 3 && get_char_code(content, 0) == 0xEF && get_char_code(content, 1) == 0xBB && get_char_code(content, 2) == 0xBF) {
			content = content.substr(3);
		}
		content = content.replace("\r\n", "\n");
		content = content.replace("\r", "\n");
		string[] lines = content.split("\n");
		for(uint i = 0; i < lines.length(); i++) {
			string line = trim_string(lines[i]);
			if(line == "" || line.substr(0, 1) == "#" || line.substr(0, 2) == "//") continue;
			int eq = line.find("=");
			if(eq <= 0) continue;
			string key = trim_string(line.substr(0, eq));
			string value = trim_string(line.substr(eq + 1));
			if(key == "") continue;
			set_value(key, value);
		}
	}

	void set_arquivo(const string &in filename) {
		load(filename);
	}

	string get_arquivo() {
		return current_file;
	}
}
properties_util pu;

// Função para conversão de string para número (usando parse_int/parse_float nativos NVGT)
int string_to_number(string str) {
	return parse_int(str);
}

