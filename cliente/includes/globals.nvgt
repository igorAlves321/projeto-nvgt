void exitgame() {
	if(exiting) return;
	exiting = true;
	game_exiting = true;
	speak(pu.get_value("Saindo do jogo..."));
	writeprefs();
	if(connected) {
		game_net.send(net_peer_id, "close", 0, true);
	}
	exittimer.restart();
	connected = false;
	connect = false;
}

void sair() {
	exitgame();
	sound door;
	door.load(get_sound_path("door1close.ogg"));
	door.play_wait();
	exit();
}

// Função de log para debug do cliente
void debug_log(string message) {
	datetime dt;
	string time_str = "[" + dt.format("%Y-%m-%d %H:%M:%S") + "] ";
	
	// Garante que a pasta debug existe
	directory_create("debug");
	
	// Salva no arquivo de log
	file f;
	if (f.open("debug/client_log.txt", "a")) {
		f.write(time_str + message + "\n");
		f.close();
	}
}

// Classes LAN
class lancha_class {
	int nalancha = 0;
	int saindo = 0;  // Flag de saída da lancha
	void sair() {
		nalancha = 0;
		saindo = 0;
	}
	void loop() {
		// Loop enxuto de compatibilidade: evita estado preso em "nalancha=1"
		// e mantém os comandos básicos com o servidor.
		if(nalancha != 1) return;

		if(saindo == 1 || key_pressed(KEY_ESCAPE)) {
			if(is_connected) game_net.send(server_peer_id, "lancha d", 0, true);
			sair();
			return;
		}

		// Comandos básicos de controle da lancha.
		if(key_pressed(KEY_UP) && is_connected) game_net.send(server_peer_id, "lancha l", 0, true);
		if(key_pressed(KEY_DOWN) && is_connected) game_net.send(server_peer_id, "lancha d", 0, true);
		if(key_pressed(KEY_S) && is_connected) game_net.send(server_peer_id, "lancha s", 0, true);
	}
};
lancha_class game_lan;
lancha_class@ lan = @game_lan;

