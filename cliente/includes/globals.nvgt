// FUNÇÃO ANTIGA REMOVIDA - usamos o método do Batalha Constante agora
// (abrir pack diretamente no client.nvgt)

// Função helper para obter caminho completo do som
// Com pack: retorna apenas filename (sound_default_pack cuida do resto)
// Com pasta: retorna "sounds/filename"
string get_sound_path(string filename) {
	// Se SOUND_STORAGE é uma pasta (não termina em .dat), adiciona prefixo
	if(SOUND_STORAGE.find(".dat") < 0 && directory_exists(SOUND_STORAGE)) {
		return SOUND_STORAGE + "/" + filename;
	}
	// Se é pack, retorna apenas o filename (sound_default_pack já está configurado)
	return filename;
}

