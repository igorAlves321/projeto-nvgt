void writeprefs() {
	string path;
	if(portable) {
		path = PREFSFILE;
	}
	else {
		if(!directory_exists(prefsdir)) directory_create(prefsdir);
		path = prefsdir + "\\" + PREFSFILE;
	}

	// Evita concorrência deixando a instância global pronta para reuso
	pf.close();
	pf.open(path, "wb");

	string s =
"mlang=" + mainlang + "\r\n"
"tradutorativo=" + tradutorativo + "\r\n"
"idiomaorigem=" + idiomaorigem + "\r\n"
"idiomachat=" + idiomachat + "\r\n"
"atu=" + atu + "\r\n"
"ouvirmortes=" + ouvirmortes + "\r\n"
"rcontrol=" + rcontrol + "\r\n"
"nalancha=" + game_lan.nalancha + "\r\n"
"un=" + un + "\r\n"
"pw=" + pw + "\r\n"
"voice=" + voice + "\r\n"
"volumejogo=" + volumejogo + "\r\n"
"ttsrate=" + ttsrate + "\r\n"
"cmfinal=" + cmfinal + "\r\n"
"avisadesconectou=" + avisadesconectou + "\r\n"
"ouvirhits=" + ouvirhits + "\r\n"
"primeiravez=" + primeiravez + "\r\n"
"numero_dispositivo=" + numero_dispositivo + "\r\n"
"usalogo=" + usalogo + "\r\n"
"atualizar=" + atualizar + "\r\n"
"ouvirpassos=" + ouvirpassos + "\r\n"
"ouviremoutrasjanelas=" + ouviremoutrasjanelas + "\r\n"
"musicamenu=" + musicamenu + "\r\n"
"beaconing=" + beaconing + "\r\n"
"wineask=" + wineask + "\r\n"
"interrupt=" + interrupt + "\r\n"
"falarteclas=" + falarteclas + "\r\n"
"asktoexit=" + asktoexit + "\r\n"
"avisanivel=" + avisanivel + "\r\n"
"f1=" + f1 + "\r\n"
"f2=" + f2 + "\r\n"
"f3=" + f3 + "\r\n"
"f4=" + f4 + "\r\n"
"f5=" + f5 + "\r\n"
"f6=" + f6 + "\r\n"
"f7=" + f7 + "\r\n"
"f8=" + f8 + "\r\n"
"f9=" + f9 + "\r\n"
"f0=" + f0 + "\r\n";

	s = string_encrypt(s, PREFS_ENCRYPTION_KEY);
	pf.write(s);
	pf.close();
}

