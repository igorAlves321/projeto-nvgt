string global_sound_key = "";

// FUNÇÃO ANTIGA REMOVIDA - usamos o método do Batalha Constante agora
// FUNÇÃO ANTIGA REMOVIDA - usamos o método do Batalha Constante agora
// (abrir pack diretamente no client.nvgt)

// Função helper para obter caminho completo do som
// Com pack: retorna apenas filename (sound_default_pack cuida do resto)
// Com pasta: retorna "sounds/filename"
string get_sound_path(string filename) {
	// Se SOUND_STORAGE é uma pasta (não termina em .dat), adiciona prefixo
	if(SOUND_STORAGE.find(".dat") < 0 && directory_exists(SOUND_STORAGE)) {
		return SOUND_STORAGE + "/" + filename;
	}
	// Se é pack, retorna apenas o filename (sound_default_pack já está configurado)
	return filename;
}

void show_game_window(string title) {
	show_window(title);
}

// NOTA: generate_computer_id agora vem do bgt_compat.nvgt

// NOTA: string_encrypt e string_decrypt agora vêm do bgt_compat.nvgt

// ===== FUNÇÕES DE AUTENTICAÇÃO COM HASH SHA-256 =====

// Função helper para hash de senhas usando SHA-256
string hash_password(string password) {
	if(password == "") return "";
	// Retorna hash SHA-256 em formato hexadecimal
	return string_hash(password, 1, false);
}

// ===== FUNÇÕES DE REDE NATIVAS NVGT =====

// Forward declaration removida - causava conflito com função global
// encrypt_packet() definida em net.nvgt

string normalize_legacy_text(string text) {
	if(text == "") return text;
	// Corrige mojibake comum em mensagens recebidas do servidor.
	text = text.replace("Ã£", "ã");
	text = text.replace("Ã¡", "á");
	text = text.replace("Ã©", "é");
	text = text.replace("Ã­", "í");
	text = text.replace("Ã³", "ó");
	text = text.replace("Ãº", "ú");
	text = text.replace("Ã¢", "â");
	text = text.replace("Ãª", "ê");
	text = text.replace("Ã´", "ô");
	text = text.replace("Ã§", "ç");
	text = text.replace("Ã‰", "É");
	text = text.replace("Ã", "Í");
	text = text.replace("Ã“", "Ó");
	text = text.replace("Ãš", "Ú");
	text = text.replace("Ã‡", "Ç");
	text = text.replace("Ã€", "À");
	text = text.replace("ÃŠ", "Ê");
	text = text.replace("Ã”", "Ô");
	text = text.replace("Ã•", "Õ");
	text = text.replace("Ãœ", "Ü");
	text = text.replace("Ã±", "ñ");
	text = text.replace("Ã‘", "Ñ");
	text = text.replace("Â¿", "¿");
	text = text.replace("Â¡", "¡");
	text = text.replace("â€œ", "\"");
	text = text.replace("â€", "\"");
	text = text.replace("â€˜", "'");
	text = text.replace("â€™", "'");
	text = text.replace("â€“", "-");
	text = text.replace("â€”", "-");
	text = text.replace("â€¦", "...");
	text = text.replace("ï»¿", "");
	return text;
}

// ===== WRAPPERS DE COMPATIBILIDADE (usam GameClient internamente) =====
// Estas funções mantêm compatibilidade com código existente
// Internamente delegam para game_client (classe encapsulada)

// Função para enviar mensagem confiável (reliable) ao servidor
// Wrapper de compatibilidade - usa game_client internamente
void send_reliable(uint64 peer_id, string message, int channel = 0) {
	// Delega para game_client (classe encapsulada)
	game_client.send_reliable(message, channel);
}

// Função para enviar mensagem não-confiável (unreliable/UDP) ao servidor  
// Wrapper de compatibilidade - usa game_client internamente
void send_unreliable(uint64 peer_id, string message, int channel = 0) {
	// Delega para game_client (classe encapsulada)
	game_client.send_unreliable(message, channel);
}

// ===== ENVIO COM SEQUENCE NUMBER =====
// Usado para pacotes de movimento/rotação que precisam chegar em ordem
// Formato: "seq:NNNN comando args..."
void send_movement(uint64 peer_id, string message, int channel = 0) {
	// Incrementar sequência (wrap around em 65535)
	movement_seq++;
	if(movement_seq > 65535) movement_seq = 1;
	
	// Prefixar mensagem com seq number
	string seq_message = "seq:" + movement_seq + " " + message;
	game_client.send_unreliable(seq_message, channel);
}

// Função helper para verificar senha contra hash
bool verify_password(string password, string hash) {
	if(password == "" || hash == "") return false;
	return (hash_password(password) == hash);
}

