// Sistema de localização usando recursos NVGT nativos
class properties_util {
	dictionary data;
	string current_file = "";

	string get_value(const string &in key) {
		string result;
		if(data.get(key, result)) {
			return result;
		}
		return key; // Retorna a própria chave se não encontrar tradução
	}

	void set_value(const string &in key, const string &in value) {
		data.set(key, value);
	}

	void load(const string &in filename) {
		data.delete_all();
		current_file = filename;
		string path = filename;
		if(!file_exists(path)) {
			string alt = "client/" + filename;
			if(file_exists(alt)) {
				path = alt;
			}
			else {
				return;
			}
		}

		file lang_file;
		if(!lang_file.open(path, "rb")) {
			return;
		}
		string content = lang_file.read();
		lang_file.close();
		if(content == "") {
			return;
		}

		if(content.length() >= 3 && get_char_code(content, 0) == 0xEF && get_char_code(content, 1) == 0xBB && get_char_code(content, 2) == 0xBF) {
			content = content.substr(3);
		}
		content = content.replace("\r\n", "\n");
		content = content.replace("\r", "\n");
		string[] lines = content.split("\n");
		for(uint i = 0; i < lines.length(); i++) {
			string line = trim_string(lines[i]);
			if(line == "" || line.substr(0, 1) == "#" || line.substr(0, 2) == "//") continue;
			int eq = line.find("=");
			if(eq <= 0) continue;
			string key = trim_string(line.substr(0, eq));
			string value = trim_string(line.substr(eq + 1));
			if(key == "") continue;
			set_value(key, value);
		}
	}

	void set_arquivo(const string &in filename) {
		load(filename);
	}

	string get_arquivo() {
		return current_file;
	}
}
properties_util pu;

