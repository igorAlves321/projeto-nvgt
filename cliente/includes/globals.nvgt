string get_sound_path(string filename) {
	if(filename == "") return "";
	if(@sound_default_pack != null) {
		return filename;
	}
	if(filename.find("sounds/") == 0 || filename.find("sounds\\") == 0) {
		return filename;
	}
	if(file_exists(filename)) {
		return filename;
	}
	string prefixed = "sounds/" + filename;
	if(file_exists(prefixed)) {
		return prefixed;
	}
	if(SOUND_STORAGE != "" && SOUND_STORAGE.find(".dat") < 0 && directory_exists(SOUND_STORAGE)) {
		string storage_prefixed = SOUND_STORAGE + "/" + filename;
		if(file_exists(storage_prefixed)) return storage_prefixed;
	}
	return filename;
}

