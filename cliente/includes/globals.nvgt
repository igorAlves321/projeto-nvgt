"ttsrate=" + ttsrate + "\r\n"
"cmfinal=" + cmfinal + "\r\n"
"avisadesconectou=" + avisadesconectou + "\r\n"
"ouvirhits=" + ouvirhits + "\r\n"
"primeiravez=" + primeiravez + "\r\n"
"numero_dispositivo=" + numero_dispositivo + "\r\n"
"usalogo=" + usalogo + "\r\n"
"atualizar=" + atualizar + "\r\n"
"ouvirpassos=" + ouvirpassos + "\r\n"
"ouviremoutrasjanelas=" + ouviremoutrasjanelas + "\r\n"
"musicamenu=" + musicamenu + "\r\n"
"beaconing=" + beaconing + "\r\n"
"wineask=" + wineask + "\r\n"
"interrupt=" + interrupt + "\r\n"
"falarteclas=" + falarteclas + "\r\n"
"asktoexit=" + asktoexit + "\r\n"
"avisanivel=" + avisanivel + "\r\n"
"sidescrolling=" + sidescrolling + "\r\n"
"autosave=" + autosave + "\r\n"
"fps=" + fps + "\r\n"
"f1=" + f1 + "\r\n"
"f2=" + f2 + "\r\n"
"f3=" + f3 + "\r\n"
"f4=" + f4 + "\r\n"
"f5=" + f5 + "\r\n"
"f6=" + f6 + "\r\n"
"f7=" + f7 + "\r\n"
