// NOTA: string_encrypt e string_decrypt agora vÃªm do bgt_compat.nvgt

// ===== FUNÃ‡Ã•ES DE AUTENTICAÃ‡ÃƒO COM HASH SHA-256 =====

// FunÃ§Ã£o helper para hash de senhas usando SHA-256
string hash_password(string password) {
	if(password == "") return "";
	// Retorna hash SHA-256 em formato hexadecimal
	return string_hash(password, 1, false);
}

// ===== FUNÃ‡Ã•ES DE REDE NATIVAS NVGT =====

// Forward declaration removida - causava conflito com funÃ§Ã£o global
// encrypt_packet() definida em net.nvgt

// FunÃ§Ã£o para enviar mensagem confiÃ¡vel (reliable) ao servidor
// Usa a API nativa: network.send(peer_id, message, channel, reliable)
void send_reliable(uint64 peer_id, string message, int channel = 0) {
	if(@con == null) {
		speak("ERRO: ConexÃ£o nÃ£o inicializada", false);
		return;
	}
	
	if(!is_connected) {
		speak("ERRO: NÃ£o conectado ao servidor", false);
		return;
	}
	
	// Criptografar mensagem antes de enviar (funÃ§Ã£o definida em net.nvgt)
	string encrypted = string_aes_encrypt(message, "evm_server_key_2024");
	
	// Enviar usando API nativa NVGT: network.send(peer_id, message, channel, reliable)
	con.send(peer_id, encrypted, channel, true);
}

// FunÃ§Ã£o para enviar mensagem nÃ£o-confiÃ¡vel (unreliable/UDP) ao servidor
void send_unreliable(uint64 peer_id, string message, int channel = 0) {
	if(@con == null) return;
	if(!is_connected) return;
	
	string encrypted = string_aes_encrypt(message, "evm_server_key_2024");
	con.send(peer_id, encrypted, channel, false); // reliable=false
}

// FunÃ§Ã£o helper para verificar senha contra hash
bool verify_password(string password, string hash) {
	if(password == "" || hash == "") return false;
	return (hash_password(password) == hash);
}
