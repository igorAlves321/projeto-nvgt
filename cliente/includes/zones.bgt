class zone {
	int min_x;
	int max_x;
	int min_y;
	int max_y;
	string text;
	zone(int minx, int maxx, int miny, int maxy, string txt) {
		this.min_x =minx;
		this.max_x =maxx;
		this.min_y =miny;
		this.max_y =maxy;
		this.text =txt;
	}
} // end zones

string get_zone_at(int x, int y) {
	string outval;
	for(uint i=0; i<zones.length(); i++) {
		if(zones.length()>0) {
			int minx =zones[i].min_x;
			int maxx =zones[i].max_x;
			int miny =zones[i].min_y;
			int maxy =zones[i].max_y;
			if(minx>x)continue;
			if(minx<=x && maxx>=x && miny<=y && maxy>=y)outval =zones[i].text;
		}
	}
	if(string_contains(outval, "*g*", 1)>-1) outval=string_replace(outval, "*g*", gender, true);
	if(string_contains(outval, "*nick*", 1)>-1) outval=string_replace(outval, "*nick*", un, true);
	return outval;
}

// get_zone_at function. Receive x, y coordinates and return a zone index.
int get_zone_index(int x, int y) {
	int zoneindex=-1;
	if(zones.length()>0) {
		for(uint i=0; i<zones.length(); i++) {
			int minx =zones[i].min_x;
			int maxx =zones[i].max_x;
			int miny =zones[i].min_y;
			int maxy =zones[i].max_y;
			if(minx>x)continue;
			if(minx<=x && maxx>=x && miny<=y && maxy>=y) zoneindex=i;
		}
	}
	return zoneindex;
}
