// Sistema de items/objetos convertido para NVGT

// objs já declarado em globals.nvgt

void spawn_obj(int x = random(0, 200), int y = 0, string what = "knife", int amount = 1) {
	if (objs.length() <= 600) {
		obj_class obj1;
		obj1.x = x;
		obj1.y = y;
		obj1.item = what;
		obj1.amount = amount;
		obj1.loop_interval = random(1000, 2000);
		objs.insert_last(obj1);
	}
}

void objsloop() {
	for(uint i = 0; i < objs.length(); i++) {
		// Convertido string_contains para .find()
		if(get_tile_at(objs[i].x, objs[i].y) == "" || 
		   (get_tile_at(objs[i].x, objs[i].y).find("branch") != -1 && objs[i].y > 0)) {
			objs[i].y--;
		}
		
		if (objs[i].x >= me.x - 15 && objs[i].x <= me.x + 15 && objs[i].looptimer.elapsed >= objs[i].loop_interval) {
			objs[i].looptimer.restart();
			pobjs.play_extended_2d("item.ogg", me.x, me.y, objs[i].x, objs[i].y, 0, 0, 0, 0, false, 0, 0, 0, random(50, 80));
		}
	}
}

// Função para limpar todos os objetos
void destroy_all_objs() {
	objs.resize(0);
}

// Função para remover objeto específico
void remove_obj(uint index) {
	if(index < objs.length()) {
		objs.remove_at(index);
	}
}

// Função para encontrar objeto na posição
int get_obj_at(int x, int y) {
	for(uint i = 0; i < objs.length(); i++) {
		if(objs[i].x == x && objs[i].y == y) {
			return i;
		}
	}
	return -1;
}