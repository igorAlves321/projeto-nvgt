
#include "settings.nvgt"

const int FAVORITES_COUNT = 10;

weapon[] player_weapons;

string current_weapon = "";

dictionary favorite_weapons;

settings favorites_config;
bool favorites_initialized = false;

class weapon {
	double speed;
	double speed_burst;
	double speed_loading;
	double ammo_cantity;
	double ammo_cantity_descount;

	string sound_draw;
	string sound_reload;
	string sound_unload;
	string sound_mode1;
	string sound_mode2;
	string sound_shoot;
	string ammo;
	string name;

	int require_ammo;
	int enable_burst;
	int mode;
	int ammo_load;
	int loading;

	timer tshoot;
	timer tspeed_reloading;

	weapon() {
		this.speed = 0.0;
		this.speed_burst = 0.0;
		this.speed_loading = 0.0;
		this.ammo_cantity = 0.0;
		this.ammo_cantity_descount = 0.0;
		this.require_ammo = 0;
		this.enable_burst = 0;
		this.mode = 0;
		this.ammo_load = 0;
		this.loading = 0;
	}

	weapon(double speed2, double speed_burst2, double speedreload2, double ammo_cantity2,
	       double ammo_load2, int require_ammo2, int enable_burst2, string sound_draw2,
	       string sound_reload2, string ammo2, string name2, string sound_unload2,
	       string sound2_mode1, string sound2_mode2, double ammo_cantity_descount2,
	       string sound_shoot2) {
		this.speed = speed2;
		this.speed_burst = speed_burst2;
		this.speed_loading = speedreload2;
		this.ammo_cantity = ammo_cantity2;
		this.ammo_load = int(ammo_load2);
		this.require_ammo = require_ammo2;
		this.enable_burst = enable_burst2;
		this.sound_draw = sound_draw2;
		this.sound_reload = sound_reload2;
		this.ammo = ammo2;
		this.name = name2;
		this.sound_unload = sound_unload2;
		this.sound_mode1 = sound2_mode1;
		this.sound_mode2 = sound2_mode2;
		this.ammo_cantity_descount = ammo_cantity_descount2;
		this.sound_shoot = sound_shoot2;
		this.mode = 0;
		this.loading = 0;
	}

	void shoot() {
		if(this.tshoot.elapsed >= this.speed_burst && this.mode == 1) {
			this.tshoot.restart();

			if(this.require_ammo == 1 && this.ammo_load < this.ammo_cantity_descount) {
				p.play_stationary(this.sound_unload + ".ogg", false);
				send_reliable(peer_id, "draw " + this.sound_unload + ".ogg", 0);
				return;
			}

			p.play_stationary(this.sound_shoot + ".ogg", false);
			send_reliable(peer_id, "COMBAT:shoot|" + this.name + "|" + selected + "|" + facing, 4);

			if(this.require_ammo == 1) this.ammo_load -= int(this.ammo_cantity_descount);
		}
		else if(this.tshoot.elapsed >= this.speed && this.mode == 0) {
			this.tshoot.restart();

			if(this.require_ammo == 1 && this.ammo_load < this.ammo_cantity_descount) {
				p.play_stationary(this.sound_unload + ".ogg", false);
				send_reliable(peer_id, "draw " + this.sound_unload + ".ogg", 0);
				return;
			}

			p.play_stationary(this.sound_shoot + ".ogg", false);
			send_reliable(peer_id, "COMBAT:shoot|" + this.name + "|" + selected + "|" + facing, 4);

			if(this.require_ammo == 1) this.ammo_load -= int(this.ammo_cantity_descount);
		}
	}

	void reload() {
		if(this.require_ammo == 0) return;
		if(this.loading == 1) return;
		if(this.ammo_load >= int(this.ammo_cantity)) return;

		if(inv_item_number(this.ammo) <= 0) {
			p.play_stationary(this.sound_unload + ".ogg", false);
			speak(pu.get_value("Sem municao: ") + pu.get_value(this.ammo));
			return;
		}

		this.tspeed_reloading.restart();
		this.loading = 1;
		this.ammo_load = int(this.ammo_cantity);
		p.play_stationary(this.sound_reload + ".ogg", false);
		send_reliable(peer_id, "COMBAT:reload|" + this.name, 4);
	}

	bool change_mode() {
		switch(this.mode) {
			case 0:
				this.mode = 1;
				p.play_stationary(this.sound_mode1 + ".ogg", false);
				send_reliable(peer_id, "draw " + this.sound_mode1 + ".ogg", 0);
				return true;
			case 1:
				this.mode = 0;
				p.play_stationary(this.sound_mode2 + ".ogg", false);
				send_reliable(peer_id, "draw " + this.sound_mode2 + ".ogg", 0);
				return true;
		}
		return false;
	}

	string get_ammo() {
		return this.ammo_load + " " + pu.get_value("de") + " " + int(this.ammo_cantity) + " " +
		       pu.get_value(this.ammo) + " " + pu.get_value("en tu cargador.");
	}
}

bool init_weapon_favorites() {
	if(favorites_initialized) return true;

	if(!favorites_config.setup("EVM", "WeaponFavorites", false, "ini")) {
		favorites_initialized = false;
		return false;
	}

	load_weapon_favorites();
	favorites_initialized = true;
	return true;
}

void load_weapon_favorites() {
	if(!favorites_config.active) return;

	for(uint i = 0; i < FAVORITES_COUNT; i++) {
		string key = "F" + i;
		string stored_id = favorites_config.read_string(key, "");

		if(stored_id != "") {
			favorite_weapons.set("f" + i, stored_id);
		}
	}
}

bool save_weapon_favorites() {
	if(!favorites_config.active) return false;

	bool success = true;

	for(uint i = 0; i < FAVORITES_COUNT; i++) {
		string key = "F" + i;
		string fav_key = "f" + i;
		string weapon_name = "";

		if(favorite_weapons.exists(fav_key)) {
			favorite_weapons.get(fav_key, weapon_name);
		}

		if(!favorites_config.write_string(key, weapon_name)) {
			success = false;
		}
	}

	return success;
}

void set_favorite_weapon(int slot) {
	if(slot < 0 || slot >= FAVORITES_COUNT) return;
	if(selected < 0 || selected >= int(player_weapons.length())) return;

	string weapon_name = player_weapons[selected].name;
	string fav_key = "f" + slot;

	favorite_weapons.set(fav_key, weapon_name);

	if(favorites_config.active) {
		string key = "F" + slot;
		favorites_config.write_string(key, weapon_name);
	}

	speak(weapon_name + ", slot " + slot);
}

int get_weapon_index(string name) {
	for(int x = 0; x < int(player_weapons.length()); x++) {
		if(player_weapons[x].name == name) {
			return x;
		}
	}
	return -1;
}

void select_favorite_weapon(string favorite) {
	if(favorite_weapons.exists(favorite)) {
		favorite_weapons.get(favorite, current_weapon);
	}
	else {
		speak(pu.get_value("Nenhuma arma favoritada nesse número."));
		return;
	}

	if(inv_item_exists(current_weapon) && get_weapon_index(current_weapon) > -1) {
		int weapon_index = get_weapon_index(current_weapon);

		if(selected == weapon_index) {
			return;
		}

		selected = weapon_index;
		speak(player_weapons[selected].name);
		p.play_stationary(player_weapons[selected].sound_draw + ".ogg", false);
		send_reliable(peer_id, "select_weapon " + selected, 0);
		send_reliable(peer_id, "draw " + player_weapons[selected].sound_draw + ".ogg", 0);
	}
	else {
		speak("no es posible seleccionar el arma.");
	}
}

void create_weapon(double speed, double speed_burst, double speed_reload, double ammo_cantity,
                   double ammo_load, int require_ammo, int enable_burst, string sound_draw,
                   string sound_reload, string ammo, string name, string sound_unload,
                   string sound_mode1, string sound_mode2, double ammo_cantity_descount,
                   string sound_shoot) {
	weapon w(speed, speed_burst, speed_reload, ammo_cantity, ammo_load, require_ammo,
	         enable_burst, sound_draw, sound_reload, ammo, name, sound_unload,
	         sound_mode1, sound_mode2, ammo_cantity_descount, sound_shoot);
	player_weapons.insert_last(w);
}

void weaponloop() {
	if(selected > 0 && selected < int(player_weapons.length())) {
		if(!inv_item_exists(player_weapons[selected].name)) {
			selected = 0;
			current_weapon = player_weapons[selected].name;
			speak(player_weapons[selected].name);
			p.play_stationary(player_weapons[selected].sound_draw + ".ogg", false);
			send_reliable(peer_id, "draw " + player_weapons[selected].sound_draw + ".ogg", 0);
		}
	}

	if(selected > -1 && selected < int(player_weapons.length())) {
		if(player_weapons[selected].tspeed_reloading.elapsed >= player_weapons[selected].speed_loading) {
			player_weapons[selected].loading = 0;
			player_weapons[selected].tspeed_reloading.force(0);
			player_weapons[selected].tspeed_reloading.pause();
		}

		if(amisafe == false && inansz == false && star == false && moveable == true &&
		   player_weapons[selected].loading == 0 && novato == 0 && fail.exists(player_weapons[selected].name) == false &&
		   crouched == 0) {
			switch(player_weapons[selected].mode) {
				case 0:
					if(key_pressed(KEY_LCONTROL) || mouse_pressed(0) ||
					   (key_pressed(KEY_RCONTROL) && rcontrol == 1)) {
						player_weapons[selected].shoot();
					}
					break;
				case 1:
					if(key_down(KEY_LCONTROL) || mouse_down(0) ||
					   (key_down(KEY_RCONTROL) && rcontrol == 1)) {
						player_weapons[selected].shoot();
					}
					break;
			}
		}
	}

	if(darmas == 0 && moveable && !shift_pressionado() && player_weapons[selected].loading == 0 && novato == 0) {
		if(key_pressed(KEY_GRAVE)) {
			selected = 0;
			current_weapon = player_weapons[selected].name;
			speak(player_weapons[selected].name);
			p.play_stationary(player_weapons[selected].sound_draw + ".ogg", false);
			send_reliable(peer_id, "draw " + player_weapons[selected].sound_draw + ".ogg", 0);
		}

		if(key_pressed(KEY_0)) select_favorite_weapon("f0");
		if(key_pressed(KEY_1)) select_favorite_weapon("f1");
		if(key_pressed(KEY_2)) select_favorite_weapon("f2");
		if(key_pressed(KEY_3)) select_favorite_weapon("f3");
		if(key_pressed(KEY_4)) select_favorite_weapon("f4");
		if(key_pressed(KEY_5)) select_favorite_weapon("f5");
		if(key_pressed(KEY_6)) select_favorite_weapon("f6");
		if(key_pressed(KEY_7)) select_favorite_weapon("f7");
		if(key_pressed(KEY_8)) select_favorite_weapon("f8");
		if(key_pressed(KEY_9)) select_favorite_weapon("f9");
	}

	if(moveable && shift_pressionado() && player_weapons[selected].loading == 0 && selected > -1) {
		if(key_pressed(KEY_0)) set_favorite_weapon(0);
		if(key_pressed(KEY_1)) set_favorite_weapon(1);
		if(key_pressed(KEY_2)) set_favorite_weapon(2);
		if(key_pressed(KEY_3)) set_favorite_weapon(3);
		if(key_pressed(KEY_4)) set_favorite_weapon(4);
		if(key_pressed(KEY_5)) set_favorite_weapon(5);
		if(key_pressed(KEY_6)) set_favorite_weapon(6);
		if(key_pressed(KEY_7)) set_favorite_weapon(7);
		if(key_pressed(KEY_8)) set_favorite_weapon(8);
		if(key_pressed(KEY_9)) set_favorite_weapon(9);
	}

	if(key_down(KEY_LCONTROL) == false && key_pressed(KEY_T) && moveable && selected > -1 && novato == 0) {
		if(player_weapons[selected].enable_burst == 1) player_weapons[selected].change_mode();
	}

	if((key_pressed(KEY_R) && moveable && !ausente) || (mouse_pressed(1) && moveable && !ausente)) {
		if(player_weapons[selected].loading == 0 && player_weapons[selected].require_ammo == 1 && novato == 0) {
			if(selected > -1) player_weapons[selected].reload();
		}
	}
}

double get_distance(int x1, int x2, int y1, int y2) {
	int dx, dy;

	if(x1 <= x2) dx = x2 - x1;
	else dx = x1 - x2;

	if(y1 <= y2) dy = y2 - y1;
	else dy = y1 - y2;

	return dx + dy;
}
