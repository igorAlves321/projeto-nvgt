// Estado de rede do cliente.
network con;                    // Conexao ativa com o servidor
bool is_connected = false;      // Flag de conexao ativa

int reconnect_attempts = 0;     // Contador de tentativas de reconexao
int reconnect_delay = 1000;     // Delay atual em ms
timer reconnect_timer;          // Timer para controlar intervalo
bool waiting_to_reconnect = false;

timer heartbeat_timer;
uint16 movement_seq = 0;        // Sequencia para pacotes de movimento/rotacao

uint64 net_peer_id = 0;         // Para compatibilidade com sistema de rede
uint64 server_peer_id = 0;      // ID do peer do servidor
network_event game_event;
network game_net;
network game_network;

