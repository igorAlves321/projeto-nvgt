bool basscontroller_channelgetattribute(long handle, long attrib, float &out value)
{
string result;
result.resize(256);
dictionary s=bass.call("long basscontroller_channelgetattribute(long, long, char*);", handle, attrib, result);
long l;
s.get(0, l);
if(l==0)
{
return false;
}
s.get(3, result);
value=string_to_number(string_replace(result, "\0", "", true));
return true;
}

