string [] basscontroller_list_devices_input()
{
string [] devices;
BASS_DEVICEINFO info;
int x=0;
while(basscontroller_recordgetdeviceinfo(x, info))
{
wait(5);
devices.insert_last(info.name);
x++;
}
return devices;
}

