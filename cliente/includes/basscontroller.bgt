bool basscontroller_getdeviceinfo(uint device, BASS_DEVICEINFO@ info)
{
info.name.resize(256);
info.driver.resize(256);
dictionary s=bass.call("long basscontroller_getdeviceinfo(long, char*, char*, long*);", device, info.name, info.driver, info.flags);
long l;
s.get(0, l);
if(l==0)
{
return false;
}
s.get(2, info.name);
s.get(3, info.driver);
s.get(4, info.flags);
info.name=string_replace(info.name, "\0", "", true);
info.driver=string_replace(info.driver, "\0", "", true);
return true;
}
//interesante
string [] basscontroller_list_devices_output()
{
string [] devices;
BASS_DEVICEINFO info;
int x=0;
while(basscontroller_getdeviceinfo(x, info))
{
wait(5);
devices.insert_last(info.name);
x++;
}
return devices;
}

bool basscontroller_getinfo(BASSINFO@ info)
{
dictionary r1=bass.call("long basscontroller_getinfo_pt1(long*, long*, long*, long*, long*, long*, long*, long*, long*, long*);", info.flags, info.hwsize, info.hwfree, info.freesam, info.free3d, info.minrate, info.maxrate, info.eax, info.minbuf, info.dsver);
dictionary r2=bass.call("long basscontroller_getinfo_pt2(long*, long*, long*, long*);", info.latency, info.initflags, info.speakers, info.freq);
long l1, l2;
r1.get(0, l1);
r2.get(0, l2);
if((l1==0)||(l2==0))
{
return false;
}
r1.get(1, info.flags);
r1.get(2, info.hwsize);
r1.get(3, info.hwfree);
r1.get(4, info.freesam);
r1.get(5, info.free3d);
r1.get(6, info.minrate);
r1.get(7, info.maxrate);
r1.get(8, info.eax);
r1.get(9, info.minbuf);
r1.get(10, info.dsver);
r2.get(1, info.latency);
r2.get(2, info.initflags);
r2.get(3, info.speakers);
r2.get(4, info.freq);
return true;
}

