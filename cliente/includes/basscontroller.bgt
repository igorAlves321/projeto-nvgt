bool basscontroller_load()
{
if(@bass!=null)
{
return false;
}
library b;
if(!b.load("basscontroller.dll"))
{
alert("Info", "Basscontroller.dll não pode ser carregada.");
return false;
}
@bass=b;
return true;
}

bool basscontroller_isloaded()
{
return @bass!=null;
}

bool basscontroller_free()
{
dictionary s=bass.call("long basscontroller_free();");
long l;
s.get(0, l);
if(l==1)
{
bass.unload();
@bass=null;
}
return l>0;
}

bool basscontroller_init(int device, long freq, long flags)
{
dictionary s=bass.call("long basscontroller_init(int, long, long);", device, freq, flags);
int l;
s.get(0, l);
return l>0;
}

