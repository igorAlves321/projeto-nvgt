formats=0;
inputs=0;
singlein=false;
freq=0;
}
}

class BASS_3DVECTOR
{
float x;
float y;
float z;
BASS_3DVECTOR(float x=0, float y=0, float z=0)
{
this.x=x;
this.y=y;
this.z=z;
}
bool opEquals(BASS_3DVECTOR@ v)
{
return this.x==v.x&&this.y==v.y&&this.z==v.z;
}
}



class BASS_CHORUS
{
    float fWetDryMix;
    float fDepth;
    float fFeedback;
    float fFrequency;
    long lWaveform;
    float fDelay;
    long lPhase;
BASS_CHORUS()
{
reset();
}
void reset()
{
fWetDryMix=50;
fDepth=10;
fFeedback=25;
fFrequency=1.1;
lWaveform=1;
fDelay=16;
lPhase=3;
}
}

