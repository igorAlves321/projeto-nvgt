//inicio de las classes
library@ bass=null;





class BASS_DEVICEINFO
{
string name;
string driver;
uint flags;
BASS_DEVICEINFO()
{
name="";
driver="";
flags=0;
}
}

class BASSINFO
{
long flags;
long hwsize;
long hwfree;
long freesam;
long free3d;
long minrate;
long maxrate;
long eax;
long minbuf;
 long dsver;
long latency;
long initflags;
long speakers;
long freq;
BASSINFO()
{
flags=0;
hwsize=0;
hwfree=0;
freesam=0;
free3d=0;
minrate=0;
maxrate=0;
eax=0;
minbuf=0;
dsver=0;
latency=0;
initflags=0;
speakers=0;
freq=0;
}
}

