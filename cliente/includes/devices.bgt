int select_device(string &out device_name)
{
string [] audio_devices;
audio_devices=list_sound_devices();
if (audio_devices.length()==0)
{
alert (pu.get_value("Error"), pu.get_value("No se encontró ningún dispositivo de audio."));
exit();
}
else if (audio_devices.length()==1)
{
alert (pu.get_value("Info"), pu.get_value("Solo se encontró un dispositivo de audio activo. Para usar uno diferente, instale uno o más dispositivos de audio."));
optionsmenu();
}
else
{
setupmenu2();
for(uint i=0; i<audio_devices.length(); i++){
m.add_item_tts(audio_devices[i], i);
}
m.add_item_tts(pu.get_value("Volver"), "back");
int mres =m.run(pu.get_value("Elija un dispositivo de audio."), true);
if (mres==-1)
{
dlg(pu.get_value("Error al cargar este menú."));
optionsmenu();
}
else if (mres==0 || m.get_item_name(mres)=="back")
{
optionsmenu();
}
else
{
int device =string_to_number(m.get_item_name(mres));
device_name =audio_devices[device];
return device;
}
}
return -1;
}
