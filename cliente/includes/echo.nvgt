
#include "rotation.nvgt"

const double MAX_ECHO_DISTANCE = 50.0;
const double MIN_VOLUME = -100.0;
const double MAX_VOLUME = 0.0;
const double RAYCAST_STEP = 0.5;
const int BASE_DELAY_MS = 10;
const string ECHO_SOUND_FILE = "echo_pulse.ogg";

class RaycastHit {
    bool hit = false;
    double distance = 0.0;
    double x_hit = 0.0;
    double y_hit = 0.0;
    string tile_type = "";

    RaycastHit() {}
}

RaycastHit@ simulate_raycast(int player_x, int player_y, double player_yaw) {
    RaycastHit@ result = RaycastHit();

    double theta = calculate_theta(player_yaw);

    double dir_x = cos(theta);
    double dir_y = sin(theta);

    double current_distance = 0.0;
    double test_x = double(player_x);
    double test_y = double(player_y);

    while (current_distance < MAX_ECHO_DISTANCE) {
        current_distance += RAYCAST_STEP;
        test_x = double(player_x) + (current_distance * dir_x);
        test_y = double(player_y) + (current_distance * dir_y);

        int tile_index = have_tile_at(int(test_x), int(test_y));

        if (tile_index != -1) {
            result.hit = true;
            result.distance = current_distance;
            result.x_hit = test_x;
            result.y_hit = test_y;
            result.tile_type = get_tile_at(int(test_x), int(test_y));
            break;
        }
    }

    return @result;
}

RaycastHit@ simulate_raycast() {
    return simulate_raycast(me.x, me.y, me.yaw);
}

double calculate_echo_volume(double distance) {
    if (distance <= 0.0) return MAX_VOLUME;
    if (distance >= MAX_ECHO_DISTANCE) return MIN_VOLUME;

    double normalized_distance = distance / MAX_ECHO_DISTANCE;

    double volume_range = MAX_VOLUME - MIN_VOLUME;
    double calculated_volume = MIN_VOLUME + ((1.0 - normalized_distance) * volume_range);

    return calculated_volume;
}

int calculate_echo_delay(double distance) {
    if (distance <= 0.0) return 0;

    int delay_ms = int(distance * BASE_DELAY_MS);

    return delay_ms;
}

void calculate_echo_feedback() {
    RaycastHit@ hit = simulate_raycast();

    if (!hit.hit) {
        speak("Eco: Nenhuma parede detectada dentro do alcance.");
        return;
    }

    if (hit.distance > MAX_ECHO_DISTANCE) {
        speak("Eco: Nenhuma parede detectada dentro do alcance.");
        return;
    }

    double volume = calculate_echo_volume(hit.distance);
    int delay_ms = calculate_echo_delay(hit.distance);

    sound echo_pulse;

    if (!echo_pulse.load(get_sound_path(ECHO_SOUND_FILE))) {
        echo_pulse.load(get_sound_path("menu/beep.ogg"));
    }

    echo_pulse.volume = volume;

    if (delay_ms > 0) {
        wait(delay_ms);
    }

    echo_pulse.play();

    string distance_str = format_float(hit.distance, "", 0, 1);
    string volume_str = format_float(volume, "", 0, 1);
    string message = "Eco: Parede a " + distance_str + "m. Volume: " + volume_str + "dB.";

    speak(message);
}

void calculate_echo_feedback(int x, int y, double yaw) {
    RaycastHit@ hit = simulate_raycast(x, y, yaw);

    if (!hit.hit || hit.distance > MAX_ECHO_DISTANCE) {
        speak("Eco: Nenhuma parede detectada.");
        return;
    }

    double volume = calculate_echo_volume(hit.distance);
    int delay_ms = calculate_echo_delay(hit.distance);

    sound echo_pulse;
    if (!echo_pulse.load(get_sound_path(ECHO_SOUND_FILE))) {
        echo_pulse.load(get_sound_path("menu/beep.ogg"));
    }

    echo_pulse.volume = volume;

    if (delay_ms > 0) {
        wait(delay_ms);
    }

    echo_pulse.play();

    string distance_str = format_float(hit.distance, "", 0, 1);
    speak("Eco: Parede a " + distance_str + "m.");
}

string get_echo_info() {
    RaycastHit@ hit = simulate_raycast();

    if (!hit.hit) {
        return "Nenhum obstáculo detectado.";
    }

    string info = "Distância: " + format_float(hit.distance, "", 0, 2) + "m, ";
    info += "Posição: (" + format_float(hit.x_hit, "", 0, 1) + ", " + format_float(hit.y_hit, "", 0, 1) + ")";

    if (hit.tile_type != "") {
        info += ", Tipo: " + hit.tile_type;
    }

    return info;
}

void quick_echo() {
    RaycastHit@ hit = simulate_raycast();

    if (!hit.hit || hit.distance > MAX_ECHO_DISTANCE) {
        return;
    }

    double volume = calculate_echo_volume(hit.distance);

    sound echo_pulse;
    if (!echo_pulse.load(get_sound_path(ECHO_SOUND_FILE))) {
        echo_pulse.load(get_sound_path("menu/beep.ogg"));
    }

    echo_pulse.volume = volume;
    echo_pulse.play();
}

void directional_echo() {
    double original_yaw = me.yaw;

    double[] directions = {0.0, -90.0, 90.0, 180.0};
    string[] dir_names = {"Frente", "Esquerda", "Direita", "Trás"};

    string report = "Eco direcional:\n";

    for (uint i = 0; i < directions.length(); i++) {
        double test_yaw = normalize_angle(original_yaw + directions[i]);
        RaycastHit@ hit = simulate_raycast(me.x, me.y, test_yaw);

        if (hit.hit && hit.distance <= MAX_ECHO_DISTANCE) {
            report += dir_names[i] + ": " + format_float(hit.distance, "", 0, 1) + "m\n";
        } else {
            report += dir_names[i] + ": Livre\n";
        }
    }

    speak(report);
}
