network net;
network_event event;
bool encryption=true;
bool connect =false, connected =false, term =false, relogin =false;
double idversion=1.0;
uint peer_id;
int connecttime=5000;
timer connecttimer;

void netloop(){
	outrosloop();
	event=net.request();
	if(event.type==0) return;
	if(event.type==event_disconnect&&event.peer_id==peer_id){
		if(!exiting) {
			speak(pu.get_value("La conexión con este universo se ha perdido..."));
			writeprefs();
			reset();
			wait(1000);
			relogin =true;
		}
	}
	if(event.type==event_receive and event.channel==0 and event.peer_id==peer_id){
		string[] parsed=string_split(pegar_mensagem(), " ", false);
		if(parsed[0]=="pong"){
			if(!forcepinging) pingtimer.restart();
			if(forcepinging){
				forcepinging=false;
				add_add_item("avisos", pu.get_value("Tu ping es de")+" "+pingtimer.elapsed+" ms.");
				p.play_stationary("pingstop.ogg",false);
			}
		}
		else if(parsed[0]=="remplayer"){
			if(parsed[1]!=un)remplayer(parsed[1]);
		}
		else if(parsed[0]=="terminate" && parsed.length()==2) {
			if(parsed[1]=="ok") {
				if(exiting) {
					connected =false;
					term =true;
				}
			}
			if(parsed[1]=="relogin") {
				if(relogin) {
					wait(500);
				}
			}
		}
else if(parsed[0]=="upl"&&parsed.length()>3)update_player(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]));
else if(parsed[0]=="pp"&&parsed.length()>2){
for(uint i=0;i<players.length();i++){
if(players[i].charname==parsed[1])players[i].pacifico=string_to_number(parsed[2]);
}
}
else if(parsed[0]=="playerbeep"&&parsed.length>2){
for(uint i=0; i<players.length; i++){
if(players[i].charname==parsed[1]) players[i].beeping=string_to_number(parsed[2]);
}
}
else if (parsed[0]=="update_player2") update_player2(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]));
else if(parsed[0]=="s" && parsed.length()==5){
int x=string_to_number(parsed[3]), y=string_to_number(parsed[4]);
update_player(string_to_number(parsed[1]), x, y);
steps.play_2d(parsed[2], me.x, me.y, x, y, false);
}
else if(parsed[0]=="hablarbot"){
add_add_item("canal_local", pu.get_value(parsed[1])+" "+pu.get_value("te comenta:")+" "+pu.get_value(string_replace(pegar_mensagem(), parsed[0]+" "+parsed[1]+" ", "", false)));
			p.play_stationary("chatmap.ogg", false);
}
else if(parsed[0]=="local"&&parsed.length()>1){
string texto=string_replace(pegar_mensagem(), parsed[0]+" ", "", false);
send_unreliable(event.peer_id, "/falarnomapa "+texto, 0);
}
else if(parsed[0] =="listplayers" && parsed.length()>=1) {
string data =string_replace(pegar_mensagem(), parsed[0]+" ", "", true);
playersmenu(data);
}
else if(parsed[0]=="comida"&&parsed.length()>1){
