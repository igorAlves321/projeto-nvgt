string s5=string_replace(get_sound(pu.get_value("elija el sonido al desvestir la prenda."), "retirar"), ".ogg", "", true);
string s6;
int option=q_pro(pu.get_value("¿la prenda se mostrará a todos los jugadores cuando esté vestida?"));
if(option==1){
s6="1";
}
else{
s6="0";
}
if(s1!=""&&s2!=""&&s3!=""&&s4!=""&&s5!=""&&s6!=""){
send_reliable(peer_id, "new_clothe::"+s1+"::"+s2+"::"+s3+"::"+s4+"::"+s5+"::"+s6, 13);
}
}
else{
show_clothes(content);
}
}
else if(parsed[0]=="add_clothes_to_inv"&&parsed.length()>1){
clothes.resize(0);
