			npcs.play_2d(parsed[1],me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
		else if(parsed[0]=="play_step"&&parsed.length()>3){
			steps.play_2d(parsed[1],me.x, me.y, string_to_number(parsed[2]), string_to_number(parsed[3]), false);
		}
		else if(parsed[0]=="set_player_info"&&parsed.length()>1){
			string content=string_replace(pegar_mensagem(), parsed[0]+" ", "", false);
			string[] packets=string_split(content, "|", false);
			for(int x=0; x<packets.length(); x++){
				string[] data=string_split(packets[x], " ", false);
				if(data[0]=="set_team_members" and data.length()>=1){
					string content=string_replace(packets[x], data[0]+" ", "", false);
					team_members=delinear(content);
				}
				else if(data[0]=="set_items_for_translate"&&data.length()>1){
					string content=string_replace(packets[x], data[0]+" ", "", false);
					items_for_translate=delinear(content);
				}
				else if(data[0]=="invsec"&&data.length()>1){
					load_secondary_inventory(packets[x]);
				}
				else if(data[0]=="djogador") desenvolvedordm=1;
				else if(data[0]=="dmoderador") modera=1;
				else if(data[0]=="dconstructor") construye=1;
				else if(data[0]=="enabletranslate") enabletranslate=1;
				else if(data[0]=="set_married_variable"&&data.length()>1){
					married=true;
				}
				else if(data[0]=="set_parabatai_variable"&&data.length()>1){
					parabatyed=true;
				}
				else if(data[0]=="cm")createmsound(string_to_number(data[1]), data[2],string_to_number(data[3]),string_to_number(data[4]),data[5]);
			}
		}
	}
	if(event.type==event_receive and event.channel==6 and event.peer_id==peer_id){
		string[] parsed=string_split(pegar_mensagem(), " ", false);
		if(parsed[0]=="show_eagle_messages"&&parsed.length()>1){
			string content=string_replace(pegar_mensagem(), parsed[0]+" ", "", false);
			show_eagle_messages(delinear(content));
		}
		else if(parsed[0]=="gender"&&parsed.length()>1){
			gender=parsed[1];
		}
		else if(parsed[0]=="reset_all_weapons_ammo"){
			for(int x=0; x<weapons.length(); x++){
				weapons[x].ammo_load=0;
			}
		}
		else if(parsed[0]=="add_team_member"&&parsed.length()>1){
			if(team_members.find(parsed[1])<0) team_members.insert_last(parsed[1]);
		}
		else if(parsed[0]=="remove_team_member"&&parsed.length()>1){
			int find=team_members.find(parsed[1]);
			if(find>-1) team_members.remove_at(find);
		}
		else if(parsed[0]=="clear_team_members"){
			team_members.resize(0);
			team_members.insert_last(un);
		}
		else if(parsed[0]=="set_team_members" and parsed.length()>=1){
			string content=string_replace(pegar_mensagem(), parsed[0]+" ", "", false);
			team_members=delinear(content);
		}
		else if(parsed[0]=="set_map_players"&&parsed.length()>1){
			if(parsed[1]=="none") players.resize(0);
			else{
				string[] content=string_split(string_replace(pegar_mensagem(), parsed[0]+" ", "", false), "\r\n", false);
				for(int x=0; x<content.length(); x++){
					string[] data=string_split(content[x], " ", false);
					if(data.length()>4) newplayer(data[0], string_to_number(data[1]), string_to_number(data[2]), string_to_number(data[3]), string_to_number(data[4]), string_to_number(data[5]));
				}
			}
		}
		else if(parsed[0]=="add_player_to_map"&&parsed.length()>1){
			if(get_player(parsed[1])<0) newplayer(parsed[1], string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), string_to_number(parsed[5]), string_to_number(parsed[6])); 
		}
		else if(parsed[0]=="remove_player_from_map"&&parsed.length()>1){
			int find=get_player(parsed[1]);
			if(find>-1) players.remove_at(find);
		}
		else if(parsed[0]=="add_line_to_map"&&parsed.length()>1){
			string line=string_replace(pegar_mensagem(), parsed[0]+" ", "", false);
			map2.insert_at(map2.length()-2, line);
			init_data(line);
		}
		else if(parsed[0]=="remove_line_from_map"&&parsed.length()>1){
			string line=string_replace(pegar_mensagem(), parsed[0]+" ", "", false);
			int find=map2.find(line);
			if(find>-1) map2.remove_at(find);
		}
		else if(parsed[0]=="reset_items_selected"){
			items_selected.resize(0);
		}
		else if(parsed[0]=="select_items"&&parsed.length()>1){
			string content=string_replace(pegar_mensagem(), parsed[0]+" ", "", false);
			items_selected=delinear(content);
		}

	}
	if(event.type==event_receive and event.channel==7 and event.peer_id==peer_id){
		string[] parsed=string_split(pegar_mensagem(), " ", false);
		if(parsed[0]=="map_audio"&&voicechat==1){
			string vc =string_replace(pegar_mensagem(), parsed[0]+" "+parsed[1]+" "+parsed[2]+" ", "", false);
			int x=string_to_number(parsed[1]), y=string_to_number(parsed[2]);
			audio.play_2d(vc, me.x, me.y, x, y, false, true);
		}
		else if(parsed[0]=="private_audio"){
			vc=string_replace(pegar_mensagem(), parsed[0]+" "+parsed[1]+" ", "", false);
			if(voicechat==1){
				audio.play_stationary(vc,false,true);
				add_add_item("mensajes_de_voz", pu.get_value("mensaje de voz privado de")+" "+parsed[1]+".");
				if(logaudio==1){
					saveaudio(vc);
				}
			}
		}
		else if(parsed[0]=="team_audio"){
			vc=string_replace(pegar_mensagem(), parsed[0]+" ", "", false);
			if(voicechat==1){
				audio.play_stationary(vc,false,true);
				if(logaudio==1){
					saveaudio(vc);
				}
			}
		}
	}

}

void create(){
	string us=v.input(pu.get_value("Por favor digite o nome para seu novo personagem (Espaços não são aceitos)."));
	if(msginvalida(us)){
		creating=false;
		main_menu();
	}
	string e_mail=v.input(pu.get_value("Porfavor digite seu e-mail."));
	if(e_mail==""||msginvalida(e_mail)||string_contains(e_mail, "@", 1)<0){
		dlg(pu.get_value("E-mail em branco ou inválido."));
		creating=false;
		main_menu();
	}
	string seap=v.input(pu.get_value("Por favor digite a senha para este personagem, espaços não são aceitos.")+" "+pu.get_value("Ela tem que ter, no mínimo, oito caractéres entre letras e números."));
	if(msginvalida(seap)||seap.length()<8){
		creating=false;
		dlg(pu.get_value("Senha inválida. Isso pode ser porque ela contém menos de 8 caracteres, tenha símbolos especiais ou espaços."));
		main_menu();
	}
	seap =string_hash(seap, 2, false);
	clipboard_copy_text(seap);
	setupmenu2();
	m.add_item_tts(pu.get_value("Mulher"), "0");
	m.add_item_tts(pu.get_value("Homem"), "1");
	int mres=m.run(pu.get_value("Você é homem ou mulher?"), true);
	if(m.get_item_name(mres)>=0){
		speak(pu.get_value("Conectando..."));
		p.play_stationary("conectando.ogg", false);
		network net2;
		network_event event2;
		net2.setup_client(20, 1);
		net2.connect(serveraddress, serverport);
		connecttimer.restart();
		while(true){
			event2=net2.request();
			if (key_pressed(KEY_ESCAPE)){
				reset();
				main_menu();
			}
			if(event2.type==event_connect&&connected==false){
				peer_id=event2.peer_id;
				send_reliable(0,"iamoriginal1234567890",0);
				net2.send_reliable(peer_id, enviar("xt55 "+us+" "+seap+" "+e_mail+" "+m.get_item_name(mres)+" "+banned), 0);
			}
			else if(event2.type==event_receive&&receber(event2.message)=="created"){
				creating=false;
p.play_stationary("cuentacreada.ogg", false);
				dlg(pu.get_value("Conta criada com sucesso! Pressione  enter para logar-se."));
				un=us;
				pwh=seap;
				writeprefs();
				reset();
				login;
			}
			else if(event2.type==event_receive&&string_contains(receber(event2.message),"Erro",1)>-1){
dlg(receber(event2.message));
				reset();
				creating=false;
				main_menu();
			}
			if(connecttimer.elapsed>=connecttime){
				dlg(pu.get_value("Servidor indisponível"));
				reset();
				main_menu();
			}
		}
	}
}

bool login(bool localhost=false){
	if (un=="" or pwh==""){
		un=v.input(pu.get_value("Digite seu nome de usuário:"));
		pwh=v.input(pu.get_value("Digite a senha da sua conta:"));
		pwh =string_hash(pwh, 2, false);
		writeprefs();
	}
	connecttimer.restart();
	net.connect(serveraddress, serverport);
	while(true) {
		wait(5);
		event=net.request();
		if (key_pressed(KEY_ESCAPE)){
			term =true;
			relogin =false;
			return false;
		}		if(!connected && connecttimer.elapsed>=connecttime){
			connecttimer.pause();
			string reason = "Servidor indisponível. Tente novamente mais tarde ou entre em contato com a administração.";
			speak(pu.get_value(reason));
			reset();
			relogin =true;
			return false;
		}
		if(event.type==event_connect && !connected){
			peer_id=event.peer_id;
			send_reliable(peer_id, "h33j "+un+" "+pwh+" "+ver+" "+banned, 0);
			relogin =false;
			connected=true;
		}
		if(event.type==event_receive){
			string[] parsed=string_split(pegar_mensagem(), " ", false);
			if(parsed[0]=="block") {
				net.disconnect_peer_forcefully(peer_id);
				dlg(string_trim_left(pegar_mensagem(),6));
				reset();
				relogin =false;
				return false;
			}
			/*if(parsed[0]=="x") me.x=string_to_number(parsed[1]);
			if(parsed[0]=="y") me.y=string_to_number(parsed[1]);
			if(parsed[0]=="changemap"){
				load_map(string_replace(pegar_mensagem(), "changemap ", "", false));
			}*/
			if(parsed[0]=="updatenow"){
				net.disconnect_peer_forcefully(peer_id);
				dlg(pu.get_value("Erro: Você precisa da última versão para poder jogar. Por favor atualiza para a última versão em checar por atualizações, ou visite")+" "+SITE_GAME);
				reset();
				relogin =false;
				return false;
			}
			if(parsed[0] =="erro:"||parsed[0]=="Error:") {
				net.disconnect_peer_forcefully(peer_id);
				dlg(receber(event.message));
				reset();
				relogin =false;
				return false;
			}
			if(parsed[0] =="loggedin") {
				username=un;
				connecttimer.pause();
				connected =true;
				relogin =false;
				return connected;
			}
		}
	}
	return false;
}
