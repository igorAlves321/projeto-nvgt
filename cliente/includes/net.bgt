if(content==""){
string s1=v.input(pu.get_value("no se encontró ninguna ropa creada en el servidor, escriba del nombre de alguna prenda para proceder a fabricarla y que este menú funcione."));
string s2=v.input(pu.get_value("escriba la parte del cuerpo en la que irá. tenga cuidado, ya que si quiere crear más prendas que vayan en la misma parte tendrá que escribirlo exactamente igual."));
