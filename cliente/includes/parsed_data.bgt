class parsed_data{
	private string[] linhas;
	private string[] valores;
	private string arquivo;
	private string texto;
	bool set_arquivo(string arquivo){
		valores.resize(0);
		linhas.resize(0);
		this.arquivo=arquivo;
		file langfile;
		bool abrir=langfile.open(arquivo,"r");
		if(!abrir){
			return this.arquivo!="";
		}
		else{
			string d;
			d=langfile.read();
		langfile.close();
			string[] parseddata=string_split(d,"\r\n",false);
			for(int i=0; i<parseddata.length; i++){
				string[] parseddata2=string_split(parseddata[i],"=",false);
				if(parseddata2.length!=2)continue;
				else{
					linhas.insert_last(parseddata2[0]);
					valores.insert_last(parseddata2[1]);
				}
			}
		}
		return this.arquivo!="";
	}
	string get_value(string linha){
		for(uint i=0;i<linhas.length();i++){
			if(linhas[i]==linha){
				for(uint i2=0;i2<valores.length();i2++){
					if(i==i2){
						return valores[i2];
					}
				}
			}
		}
		return linha;
	}
}
string translate_with_char(string text, string char){
	string final;
	string[] b=string_split(text, char, true);
	for(uint i=0;i<b.length();i++){
		final+=pu.get_value(b[i]);
	}
	return final;
}