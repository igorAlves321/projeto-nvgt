
const int STANCE_STANDING = 0;
const int STANCE_CROUCHED = 1;
const int STANCE_SITTING = 2;

bool can_crouch() {
    if(centado) return false;
    if(jumping) return false;
    if(bicicleta != 0) return false;
    if(!moveable) return false;
    if(ausente) return false;
    return true;
}

void crouch_on() {
    if(!can_crouch()) return;
    if(crouched == 1) return;

    crouched = 1;
    me.stance = STANCE_CROUCHED;

    send_unreliable(peer_id, "crouched::on", 13);

    speak(pu.get_value("mantienes tu cuerpo agachado."));
}

void crouch_off() {
    if(crouched == 0) return;

    crouched = 0;
    me.stance = STANCE_STANDING;

    send_unreliable(peer_id, "crouched::off", 13);

}

void toggle_crouch() {
    if(crouched == 0) {
        crouch_on();
    } else {
        crouch_off();
    }
}

bool can_sit() {
    if(crouched != 0) return false;
    if(jumping) return false;
    if(bicicleta != 0) return false;
    if(!moveable) return false;
    if(ausente) return false;
    if(falling) return false;
    return true;
}

void sit_down() {
    if(!can_sit()) return;
    if(centado) return;

    centado = true;
    me.stance = STANCE_SITTING;

    p.play_stationary("centar.ogg", false);

    send_unreliable(peer_id, "sound centar.ogg " + me.x + " " + me.y, 0);

    speak(pu.get_value("te sientas."));
}

void stand_up() {
    if(!centado) return;

    centado = false;
    me.stance = STANCE_STANDING;

    p.play_stationary("levantar.ogg", false);

    send_unreliable(peer_id, "sound levantar.ogg " + me.x + " " + me.y, 0);

    speak(pu.get_value("te levantas."));
}

void toggle_sit() {
    if(centado) {
        stand_up();
    } else {
        sit_down();
    }
}

void stance_control_loop() {

    if((key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT)) && key_down(KEY_SPACE) && crouched == 0) {
        if(can_crouch()) {
            crouch_on();
        }
    }

    if(crouched == 1) {
        if(key_released(KEY_LSHIFT) || key_released(KEY_RSHIFT) || key_released(KEY_SPACE)) {
            crouch_off();
        }
    }

}

string get_stance_name() {
    if(crouched == 1) return pu.get_value("agachado");
    if(centado) return pu.get_value("sentado");
    return pu.get_value("em pé");
}

bool is_standing() {
    return crouched == 0 && !centado;
}

bool is_crouched() {
    return crouched == 1;
}

bool is_sitting() {
    return centado;
}

void force_stand() {
    if(crouched == 1) crouch_off();
    if(centado) stand_up();
    me.stance = STANCE_STANDING;
}
