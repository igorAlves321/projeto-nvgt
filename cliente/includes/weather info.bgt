/*class for retrieve the weather data of the especified city.
writed by @kaboerain
http://mxgproductions.net
this class retrieve the weather data using the open weather map api.
for more info, visit:
https://openweathermap.org/
*/
class weather_info{
private string city, description, current_temp, feel_like, temp_min, temp_max, wind_speed;
private string[] data;
weather_info(){ //constructor
reset();
}
void reset(){
//reset the variables to default.
city="";
description="";
current_temp="";
feel_like="";
temp_min="";
temp_max="";
wind_speed="";
data.resize(0);
}
bool set_city(string city_name, string&out error=""){
//set city name and get the data.
city=city_name;
string info=url_get("http://api.openweathermap.org/data/2.5/weather?q="+city+"&units=metric&APPID="+WEATHER_API_KEY);
if(string_contains(info, "{\"cod\":", 1)>-1){
info=string_replace(info, "\"", "", true);
info=string_replace(info, "{", "", true);
string[] error_data=string_split(info, ",", true);
string[] error_code_data=string_split(error_data[0], ":", true);
error=error_code_data[1];
return false;
}
info=string_replace(info, "\"", "", true);
info=string_replace(info, "{", "", true);
data=string_split(info, ",", true);
string[] description_data=string_split(data[4], ":", false);
description=description_data[1];
string[] current_temp_data=string_split(data[7], ":", false);
current_temp=current_temp_data[2];
string[] feel_like_data=string_split(data[8], ":", false);
feel_like=feel_like_data[1];
string[] temp_min_data=string_split(data[9], ":", false);
temp_min=temp_min_data[1];
string[] temp_max_data=string_split(data[10], ":", false);
temp_max=temp_max_data[1];
for(int x=0; x<data.length(); x++){
if(string_contains(data[x], "wind", 1)>-1){
string[] wind_speed_data=string_split(data[x], ":", false);
wind_speed=wind_speed_data[2];
}
}
return true;
}
string get_city(){
//get city name.
return city;
}
string get_description(){
//get the sky description.
return description;
}
string get_current_temp(){
//get the current temperature.
return current_temp;
}
string get_feel_like_temp(){
//get the feel like temperature.
return feel_like;
}
string get_temp_min(){
//get min temperature.
return temp_min;
}
string get_temp_max(){
//get max temperature.
return temp_max;
}
string get_wind_speed(){
//get the wind speed.
return wind_speed;
}
}//end class
