#include"bass.bgt"
#include "platforms.bgt"
#include "zones.bgt"
#include "safezones.bgt"

bass2 stream, stream2;
double volumestream=5000;
platform@[] platforms;
safezone@[] safezones;
zone@[] zones;
dictionary fail;
string somchuva;
string[] map2;
bool amisafe=false, comurl=false;
long streamurl, streamurl2;
void playstep(){
	if (jumping==0){
		string step =get_tile_at(me.x, me.y)+"step"+random(1, 5)+".ogg";
		p.play_stationary(step, false);
		send_unreliable(peer_id, "move "+step+" "+me.x+" "+me.y, 0);
	}
}

string gct(){
	return get_tile_at(camera.x,camera.y);
}

string linear(string[] a, string char_separator="\r\n"){
	string final;
	for(uint i=0; i<a.length(); i++){
		final+=(a[i]+char_separator);
	}
	return final;
}
string[] delinear(string a, string char_separator="\r\n"){
	return string_split(a, char_separator, false);
}

void load_map(string mdata, bool complete =true) {
	mapreset(complete);
	bool isitsafe=false;
	string[] ldata=delinear(mdata);
	string[] parsed =string_split(ldata[0], " ", true);
	string filename;
	if(parsed.length()==5&&parsed[1] =="local") {
		pack_file map_pack;
		file@ map_file;
		filename =parsed[2]+".map";
		ldata.resize(0);
		if(map_pack.open(MAPS_STORAGE)) {
			@map_file =map_pack.get_file(filename);
			ldata =delinear(string_decrypt(map_file.read(), MAPS_ENCRYPTION_KEY));
			map_file.close();
			map_pack.close();
			ldata.insert_last("x:"+parsed[3]);
			ldata.insert_last("y:"+parsed[4]);
			map2=ldata;
		}
	}
	else {
		ldata[0] =string_replace(ldata[0], "changemap ", "", false);
		ldata[0] =string_replace(ldata[0], "changemap2 ", "", false);
		map2=ldata;
	}
	for(uint i=0; i<ldata.length(); i++){
		init_data(ldata[i], complete);
	}
	chuva();
}

void init_data(string line, bool complete=true){
	string[] parsed=string_split(line, ":", true);
	if(parsed[0]=="map"){
		mapname=string_trim_left(line,4);
		if(mapname=="portal_espiritual"){
			centado=false;
		}
	}
	else if(parsed[0]=="url"&&parsed.length()>1&&complete){
		comurl=true;
		streamurl=stream.load(string_trim_left(line,4));
		stream.play(streamurl);
	}
	else if(parsed[0]=="disable_game"&&parsed.length()>4){
		game_disabled g(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]));
		disableds.insert_last(g);
	}
	else if(parsed[0]=="teto"){
		somchuva=parsed[1];
	}
	else if(parsed[0]=="p"&&parsed.length>=5){
		platform p1(parsed[0], string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[3]), parsed[4]);
		platforms.insert_last(p1);
	}
	else if(parsed[0]=="w"&&parsed.length>=5||parsed[0]=="pw"&&parsed.length>=5){
		platform p1(parsed[0], string_to_number(parsed[1]), string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), parsed[4]);
		platforms.insert_last(p1);
	}
	else if(parsed[0]=="w2" && parsed.length>=5) {
		platform p1(parsed[0], string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), parsed[5]);
		platforms.insert_last(p1);
	}
	else if(parsed[0]=="wall"&&parsed.length()>9){
		platform p1("w", string_to_number(parsed[1]), string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), parsed[9]);
		platforms.insert_last(p1);
	}
	else if(parsed[0]=="z"){
		zone z1(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), parsed[5]);
		zones.insert_last(z1);
	}
	else if(parsed[0]=="desc"&&parsed.length()>4)colocar_desc(string_to_number(parsed[1]),string_to_number(parsed[2]),string_to_number(parsed[3]),string_to_number(parsed[4]),parsed[5]);
	else if(parsed[0]=="maxx"){
		max.x=string_to_number(parsed[1]);
	}
	else if(parsed[0]=="maxy"){
		max.y=string_to_number(parsed[1]);
	}
	else if(parsed[0]=="x"){
		me.x=string_to_number(parsed[1]);
	}
	else if(parsed[0]=="y"){
		me.y=string_to_number(parsed[1]);
	}
	else if(parsed[0]=="ss" and parsed.length()>=6&&complete){
		int lx=string_to_number(parsed[1]);
		int rx=string_to_number(parsed[2]);
		int miny=string_to_number(parsed[3]);
		int maxy=string_to_number(parsed[4]);
		string id="123";
		spawn_source(lx, rx, miny, maxy, string_replace(parsed[5],".wav",".ogg",true), id);
	}
	else if(parsed[0]=="ss2" and parsed.length()>=6&&complete){
		int lx=string_to_number(parsed[1]);
		int rx=string_to_number(parsed[2]);
		int miny=string_to_number(parsed[3]);
		int maxy=string_to_number(parsed[4]);
		string id="123";
		spawn_source2(lx, rx, miny, maxy, string_replace(parsed[5], ".wav", ".ogg", true), id, volumesources);
	}
	else if(parsed[0]=="dr" and parsed.length()>=9||parsed[0]=="porta"&&parsed.length()>=9){
		int x=string_to_number(parsed[1]);
		int y=string_to_number(parsed[2]);
		int fx=string_to_number(parsed[3]);
		int fy=string_to_number(parsed[4]);
		int speed=string_to_number(parsed[5]);
		string snd1=parsed[6];
		string snd2=parsed[7];
		string snd3=parsed[8];
		string snd4=parsed[9];
		spawn_door(x, y, fx, fy,speed,snd1,snd2,snd3,snd4);
	}
	else if(parsed[0]=="elv"&&parsed.length()>4){
		int x=string_to_number(parsed[1]);
		int y=string_to_number(parsed[2]);
		int fx=string_to_number(parsed[3]);
		int fy=string_to_number(parsed[4]);
		spawn_elevador(x, y, fx, fy);
	}
	else if(parsed[0]=="sc" and parsed.length()>=6){
		int lx=string_to_number(parsed[1]);
		int rx=string_to_number(parsed[2]);
		int miny=string_to_number(parsed[3]);
		int maxy=string_to_number(parsed[4]);
		string tile=parsed[5];
		spawn_staircase(lx, rx, miny, maxy, tile);
		platform p1(parsed[0], string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), parsed[5]);
		platforms.insert_last(p1);
	}
	else if(parsed[0]=="arbol" and parsed.length()>=6){
		int lx=string_to_number(parsed[1]);
		int rx=string_to_number(parsed[1]);
		int miny=string_to_number(parsed[2]);
		int maxy=string_to_number(parsed[3]);
		spawn_staircase(lx, rx, miny, maxy, "branch");
		platform p1("sc", lx, rx, miny, maxy, "branch");
		platforms.insert_last(p1);
	}
	else if(parsed[0]=="txt" and parsed.length()>=4){
		int x=string_to_number(parsed[1]);
		int y=string_to_number(parsed[2]);
		string txt=parsed[3];
		spawn_txt(x, y, txt);
	}
	else if(parsed[0]=="store"&&parsed.length()>4){
		store s(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]), parsed[5]);
		stores.insert_last(s);
	}
	else if(parsed[0]=="dlg" and parsed.length()>=5){
		int x=string_to_number(parsed[1]);
		int y=string_to_number(parsed[2]);
		string txt=parsed[3];
		string soundfile=parsed[4];
		spawn_dialog(x, y, txt, soundfile);
	}
	else if(parsed[0]=="am")colocar_areia_movedissa(string_to_number(parsed[1]), string_to_number(parsed[2]), mapname);
	else if(parsed[0]=="darmas"){
		fail.set(parsed[1], parsed[1]);
	}
	else if(parsed[0]=="dv"){
		if(parsed[1]=="coordenadas")dcoordenadas=1;
		if(parsed[1]=="inventario")dinventario=1;
		if(parsed[1]=="auto")dauto=1;
		if(parsed[1]=="helicoptero")dhelicoptero=1;
		if(parsed[1]=="avion")davion=1;
		if(parsed[1]=="tanque")dtanque=1;
		if(parsed[1]=="moto")dmoto=0;
		if(parsed[1]=="armas")darmas=1;
		if(parsed[1]=="baculo")dbaculo=1;
		if(parsed[1]=="bazuca")dbazuca=1;
		if(parsed[1]=="camera")dcamera=1;
		if(parsed[1]=="bicicleta")bicicletaativa=0;
		if(parsed[1]=="camion")camionativo=0;
		if(parsed[1]=="armas_pretas")outras=false;
		if(parsed[1]=="bazuca")bazuca=false;
	}
	else if(parsed[0]=="sz"&&parsed.length==5) {
		safezone sz1(string_to_number(parsed[1]), string_to_number(parsed[2]), string_to_number(parsed[3]), string_to_number(parsed[4]));
		safezones.insert_last(sz1);
	}
}

void mapreset(bool complete =true) {
	if(comurl && complete) {
		stream.stop(streamurl);
		comurl=false;
	}
	fail.delete_all();
	destroy_all_doors();
	destroy_all_elevadors();
	destroy_all_txts();
	destroy_all_dialogs();
	destroy_stores();
	if(complete) p.destroy_all();
	disableds.resize(0);
	if(complete) {
		currentloc =-1;
		destroy_all_ambientes();
		destroy_all_sources();
		destroy_all_source2s();
		destroy_all_msounds();
		steps.destroy_all();
		shoot.destroy_all();
		bodys.destroy_all();
		walls.destroy_all();
		doors_sound.destroy_all();
		npcs.destroy_all();
		pl.destroy_all();
	}
	destroy_all_staircases();
	map2.resize(0);
	zones.resize(0);
	safezones.resize(0);
	platforms.resize(0);
	outras=true;
	bazuca=true;
	dcamera=0;
	dcoordenadas=0;
	dinventario=0;
	dauto=0;
	dhelicoptero=0;
	davion=0;
	dtanque=0;
	dmoto=0;
	darmas=0;
	dbaculo=0;
	dbazuca=0;
	bicicletaativa=1;
		camionativo=1;
		somchuva="rain4.ogg";
	destruir_areias_movedissas();
}

bool inansz=false;
void safeloop(){
	bool v=get_safezone_at();
	if(v==false&&inansz&&nolhar==""){
		inansz=false;
		send_unreliable(peer_id,"sn",0);
	}
	if(v&&inansz==false){
		inansz=true;
		send_unreliable(peer_id,"s",0);
	}
}
