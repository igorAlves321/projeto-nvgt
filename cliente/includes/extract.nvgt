// Sistema de extração/colheita de recursos convertido para NVGT

class extract {
	int min_x, max_x, min_y, max_y;
	int hmitems;              // how many items per extraction
	int attempts, initial_attempts;
	string item;              // item name to drop
	string extracting;        // sound while extracting
	string extracted;         // sound when finished
	int extracttime;          // time in ms
	timer extracttimer;       // timer for extraction progress
	
	extract(int minx, int maxx, int miny, int maxy, int items, 
	        int atts, int time, string itm, string snd_ext, string snd_extracted) {
		this.min_x = minx;
		this.max_x = maxx;
		this.min_y = miny;
		this.max_y = maxy;
		this.hmitems = items;
		this.attempts = atts;
		this.initial_attempts = atts;
		this.item = itm;
		this.extracting = snd_ext;
		this.extracted = snd_extracted;
		this.extracttime = time;
		// Timer é inicializado automaticamente
	}
}

extract@[] extracts;

// Função para verificar se há zona de extração em um ponto
int get_extract_at(int x, int y) {
	int extract_index = -1;
	if(extracts.length() > 0) {
		for(uint i = 0; i < extracts.length(); i++) {
			int minx = extracts[i].min_x;
			int maxx = extracts[i].max_x;
			int miny = extracts[i].min_y;
			int maxy = extracts[i].max_y;
			if(minx <= x && maxx >= x && miny <= y && maxy >= y) {
				extract_index = i;
				break;
			}
		}
	}
	return extract_index;
}
