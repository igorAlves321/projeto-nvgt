void gerais(){
	setupmenu3();
	if(rcontrol==0)m.add_item_tts(pu.get_value("Control derecho para disparar desactivado, pulsa enter para cambiar"), "direito");
	else if(rcontrol==1)m.add_item_tts(pu.get_value("Control derecho para disparar activado, pulsa enter para cambiar"), "direito");
	if (asktoexit==0)m.add_item_tts(pu.get_value("Confirmación para salir desactivada, pulsa enter para cambiar"), "ae");
	else if (asktoexit==1) m.add_item_tts(pu.get_value("Confirmación para salir activada, pulsa enter para cambiar"), "ad");
	if(avisadesconectou==1)m.add_item_tts(pu.get_value("Notificaciones de conexiones desactivadas, pulsa enter para cambiar"), "avisadesconectou");
	if(avisadesconectou==0)m.add_item_tts(pu.get_value("Notificaciones de conexiones activadas, pulsa enter para cambiar"), "avisadesconectou");
	if(usalogo==0) m.add_item_tts(pu.get_value("No reproduciendo el logo al iniciar el cliente, pulsa enter para cambiar"), "usandologo");
	if(usalogo==1) m.add_item_tts(pu.get_value("Reproduciendo el logo al iniciar el cliente, pulsa enter para cambiar"), "usandologo");

	m.add_item_tts(pu.get_value("Modo voz sapi"),"wine");
	if(logs==0){
		m.add_item_tts(pu.get_value("Registro de historiales desactivado, pulsa enter para cambiar"), "logs");
	}
	else if(logs==1){
		m.add_item_tts(pu.get_value("Registro de historiales activado, pulsa enter para cambiar"), "logs");
	}
	if(autologin==0){
		m.add_item_tts(pu.get_value("Inicio de sesión automático desactivado, pulsa enter para cambiar"), "autologin");
	}
	if(autologin==1){
		m.add_item_tts(pu.get_value("Inicio de sesión automático activado, pulsa enter para cambiar"), "autologin");
	}
	if (interrupt==0)m.add_item_tts(pu.get_value("Interrupción del lector desactivada, pulsa enter para cambiar"), "interrupt");
	if (interrupt==1)m.add_item_tts(pu.get_value("Interrupción del lector activada, pulsa enter para cambiar"), "interrupt");
	if(sidescrolling==1)m.add_item_tts(pu.get_value("Habilitar el desplazamiento vertical en el menú"), "side");
	if(sidescrolling==0)m.add_item_tts(pu.get_value("Habilitar el desplazamiento horizontal en el menú"), "side");
	m.add_item_tts(pu.get_value("Volver"), "back");
	int mres=m.run(pu.get_value("Configuraciones generales."), true);
	if(mres==0 || m.get_item_name(mres)=="back") {
		optionsmenu();
	}
	if(m.get_item_name(mres)=="wine"){
		togglewine();
		if (wine()) {
			speak(pu.get_value("Modo voz sape ativado"));
		}
		else {
			speak(pu.get_value(" Modo voz sape desativado"));
		}
	}
	if(m.get_item_name(mres)=="w"){
		if(file_exists(DIRECTORY_APPDATA+"/microsoft/Windows/Start Menu/Programs/Startup/reino Elemental.bat"))file_delete(DIRECTORY_APPDATA+"/microsoft/Windows/Start Menu/Programs/Startup/Reino Elemental.bat");
		else{
			file f;
			f.open(DIRECTORY_APPDATA+"/microsoft/Windows/Start Menu/Programs/Startup/Reino Elemental.bat", "w");
			f.write("@ECHO OFF\r\nstart \""+SCRIPT_EXECUTABLE+"\"\r\nexit");
			f.close();
		}
	}
	if(m.get_item_name(mres)=="side"){
		if(sidescrolling==0){
			sidescrolling=1;
		}
		else if(sidescrolling==1) {
			sidescrolling=0;
		}
	}
	if(m.get_item_name(mres)=="direito"){
		if(rcontrol==0) {
			rcontrol=1;
		}
		else { 
			rcontrol=0;
		}
	}
	if(m.get_item_name(mres)=="avisadesconectou"){
		if(avisadesconectou==0){
			avisadesconectou=1;
		}
		else if(avisadesconectou==1){
			avisadesconectou=0;
		}
	}
	if(m.get_item_name(mres)=="usandologo"){
		if(usalogo==0){
			usalogo=1;
		}
		else if(usalogo==1){
			usalogo=0;
		}
	}
	if(m.get_item_name(mres)=="atualizar"){
		if(atualizar==0){
			atualizar=1;
		}
		else if(atualizar==1){
			atualizar=0;
		}
	}
	if(m.get_item_name(mres)=="ad"){
		asktoexit=0;
	}
	if(m.get_item_name(mres)=="ae"){
		asktoexit=1;
	}
	if(m.get_item_name(mres)=="interrupt"){
		if (interrupt==1) {
			interrupt=0;
		}
		else {
			interrupt=1;
		}
	}
	if(m.get_item_name(mres)=="logs"){
		if (logs==1) {
			logs=0;
		}
		else {
			logs=1;
		}
	}
	if(m.get_item_name(mres)=="autologin"){
		if (autologin==1) {
			autologin=0;
		}
		else {
			autologin=1;
		}
	}
	writeprefs();
	gerais();
}

string menuplayer(string text,bool showall=true){
	setupmenu2();
	for (uint i=0; i<players.length(); i++){
		if (showall==true){
			if (players[i].charname!=un)
			m.add_item_tts(players[i].charname+"("+players[i].charname+")",players[i].charname);
		}
	}
	m.add_item_tts("Voltar", "back");
	int mres=m.run(text,true);
	return m.get_item_name(mres);
}

void chuva(){
	chuvatelhado.close();
	chuvatelhado.volume=-12;
	if(chuvaativa==1){
		chuvatelhado.load(somchuva);
		chuvatelhado.play_looped();
	}
}
