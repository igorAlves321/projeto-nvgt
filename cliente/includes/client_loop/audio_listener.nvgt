
void update_client_audio_listeners() {
	p.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	p2.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	game_p.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	pobjs.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	ambientepool.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	sourcepool.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	audio.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	steps.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	shoot.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	bodys.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	walls.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	doors_sound.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	npcs.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
	pl.update_listener_2d(me.x, me.y, calculate_theta(me.yaw));
}
