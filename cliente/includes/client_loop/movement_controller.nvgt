// Controladores pequenos de movimento do cliente.

void rotate_player_to(int direction, float yaw, const string&in log_message) {
	if(facing != direction) {
		p.play_stationary("turn.ogg", false);
	}
	facing = direction;
	me.yaw = yaw;
	send_unreliable(peer_id, "turn " + facing, 0);
	debug_log(log_message);
}

void handle_shift_rotation_input() {
	if(!(key_down(KEY_LSHIFT) || key_down(KEY_RSHIFT))) return;
	if(!moveable) return;

	if(key_pressed(KEY_UP)) {
		rotate_player_to(Forward, 0.0, "↑ Rotacionou para frente");
	}
	if(key_pressed(KEY_DOWN)) {
		rotate_player_to(Back, 180.0, "↓ Rotacionou para trás");
	}
	if(key_pressed(KEY_LEFT)) {
		rotate_player_to(Left, 270.0, "← Rotacionou para esquerda");
	}
	if(key_pressed(KEY_RIGHT)) {
		rotate_player_to(Right, 90.0, "→ Rotacionou para direita");
	}
}

