break;
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and lines.length()>0){
int f=0;
int oc=counter;
for(uint i=counter; i<lines.length(); i++){
if(i==counter){
continue;
}
string item=get_item_translation(lines[i]);
if(item=="") item=pu.get_value(lines[i]);
if(item[0]==cl){
counter=i;
speak(item);
cl="";
f=1;
break;
}
}
if(f==0){
counter=0;
for(uint i=counter; i<lines.length(); i++){
string item=get_item_translation(lines[i]);
if(item=="") item=pu.get_value(lines[i]);
if(item[0]==cl){
counter=i;
speak(item);
cl="";
f=1;
break;
}
}
}
}
if(left.pressing()&&counter>0){
counter--;
speak(lines[counter]);
}
if(right.pressing()&&counter<lines.length()-1){
counter++;
speak(lines[counter]);
}
if(key_pressed(KEY_HOME)&&counter>0){
counter=0;
speak(lines[counter]);
}
if(key_pressed(KEY_END)&&counter<lines.length()-1){
counter=lines.length()-1;
speak(lines[counter]);
}
if(key_pressed(KEY_RETURN)&&counter>-1||key_pressed(KEY_NUMPADENTER)&&counter>-1){
string key=lines[counter];
string new=v.input(pu.get_value("está modificando el término")+" "+lines[counter]+". "+pu.get_value("escriba con cuidado."), key);
if(new!=""){
lines[counter]=string_replace(lines[counter], key, new, true);
speak(pu.get_value("actualizado."));
}
}
if(key_pressed(KEY_DELETE)&&counter>-1){
int opt=q_pro(pu.get_value("esta línea está apunto de ser eliminada, ¿realmente quieres continuar?"));
if(opt==1){
send_reliable(peer_id, "remove_item_on_store "+store_name+" "+lines[counter], 14);
lines.remove_at(counter);
}
else{
speak(pu.get_value("cancelado."));
}
}
if(key_down(KEY_LCONTROL)||key_down(KEY_RCONTROL)){
if(key_pressed(KEY_R)&&counter>-1){
send_reliable(peer_id, "replace_item_on_store "+store_name+" "+lines[counter]+" "+counter, 14);
}
if(key_pressed(KEY_A)){
string item=v.input(pu.get_value("escriba el nombre del item que quiere añadir a esta tienda."));
if(item!=""){
send_reliable(peer_id, "add_item_to_store "+store_name+" "+item, 14);
}
}

}
}
}
void comidas2(string[] articles){
string[] div=string_split(articles[0], bell, false);
	reset_all_forced_keys();
	key_hold ileft(KEY_LEFT,500,50);
	key_hold iright(KEY_RIGHT,500,50);
emchat=true;
speak(pu.get_value("Esta es la comida que está disponible por el momento."));
int contador=-1;
get_characters();
string cl;
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE)){
emchat=false;
break;
}
if(key_pressed(KEY_RETURN)&&contador>-1||key_pressed(KEY_NUMPADENTER)&&contador>-1){
p.play_stationary("menuenter3.ogg", false);
string valor=v.input(pu.get_value("¿Cuántos de este objeto quieres?"));
emchat=true;
send_unreliable(peer_id,"comida comprar "+valor+" "+articles[contador]+" "+destinocomida,0);
}
		if(key_pressed(KEY_HOME)&&contador>0){
			contador=0;
speak(pu.get_value(articles[contador]));
p.play_stationary("menuopcion.ogg", false);
		}
		if(key_pressed(KEY_END)&&contador<articles.length()){
contador=articles.length()-1;
speak(pu.get_value(articles[contador]));
p.play_stationary("menuopcion.ogg", false);
		}
		if(ileft.pressing()&&contador>0){
				contador--;
speak(pu.get_value(articles[contador]));
p.play_stationary("menuopcion.ogg", false);
			}
		if(iright.pressing()&&contador<articles.length()-1){
				contador++;
speak(pu.get_value(articles[contador]));
p.play_stationary("menuopcion.ogg", false);
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and articles.length()>0){
int f=0;
int oc=contador;
for(uint i=contador; i<articles.length(); i++){
if(i==contador){
continue;
}
if(articles[i][0]==cl){
contador=i;
string msg=articles[contador];
speak(pu.get_value(msg));
p.play_stationary("menuopcion.ogg", false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
if(f==0){
contador=0;
for(uint i=contador; i<articles.length(); i++){
if(articles[i][0]==cl){
contador=i;
string msg=articles[contador];
speak(pu.get_value(msg));
p.play_stationary("menuopcion.ogg", false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
}
}
}
}
void open_store(string[] articles){
string[] div=string_split(articles[0], bell, false);
	reset_all_forced_keys();
	key_hold ileft(KEY_LEFT,500,50);
	key_hold iright(KEY_RIGHT,500,50);
emchat=true;
speak(pu.get_value("Menú de la tienda. Pulse f2 en cada producto para obtener información adicional."));
int contador=-1;
get_characters();
string cl;
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE)){
emchat=false;
break;
}
if(key_pressed(KEY_F1)&&contador>-1){
string[] data=string_split(articles[contador], "=", false);
if(data.length()>1) send_unreliable(peer_id, "check_price "+data[1], 14);
}
if(key_pressed(KEY_F2)&&contador>-1){
string[] data=string_split(articles[contador], "=", false);
if(data.length()>1) send_unreliable(peer_id, "check_desc "+data[1], 14);
}
if(key_pressed(KEY_RETURN)&&contador>-1||key_pressed(KEY_NUMPADENTER)&&contador>-1){
p.play_stationary("menuenter3.ogg", false);
string valor=v.input(pu.get_value("¿Cuántos de este objeto quieres?"));
emchat=true;
string[] data=string_split(articles[contador], "=", false);
if(data.length()>1) send_unreliable(peer_id,"buy "+valor+" "+data[1],14);
}
		if(key_pressed(KEY_HOME)&&contador>0){
			contador=0;
string[] data=string_split(articles[contador], "=", false);
speak(pu.get_value(data[0]));
p.play_stationary("menuopcion.ogg", false);
		}
		if(key_pressed(KEY_END)&&contador<articles.length()){
contador=articles.length()-1;
string[] data=string_split(articles[contador], "=", false);
speak(pu.get_value(data[0]));
p.play_stationary("menuopcion.ogg", false);
		}
		if(ileft.pressing()&&contador>0){
				contador--;
string[] data=string_split(articles[contador], "=", false);
speak(pu.get_value(data[0]));
p.play_stationary("menuopcion.ogg", false);
			}
		if(iright.pressing()&&contador<articles.length()-1){
				contador++;
string[] data=string_split(articles[contador], "=", false);
speak(pu.get_value(data[0]));
p.play_stationary("menuopcion.ogg", false);
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and articles.length()>0){
int f=0;
int oc=contador;
for(uint i=contador; i<articles.length(); i++){
if(i==contador){
continue;
}
if(articles[i][0]==cl){
contador=i;
string msg=articles[contador];
string[] data=string_split(msg, "=", false);
speak(pu.get_value(data[0]));
p.play_stationary("menuopcion.ogg", false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
if(f==0){
contador=0;
for(uint i=contador; i<articles.length(); i++){
if(articles[i][0]==cl){
contador=i;
string msg=articles[contador];
string[] data=string_split(msg, "=", false);
speak(pu.get_value(data[0]));
p.play_stationary("menuopcion.ogg", false);
copiaragora=pu.get_value(msg);
cl="";
f=1;
break;
}
}
}
}
}
