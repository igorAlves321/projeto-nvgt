store@[] stores;
class store{
int minx, maxx, miny, maxy;
string name;
store(int min_x, int max_x, int min_y, int max_y, string name2){
this.minx=min_x;
this.maxx=max_x;
this.miny=min_y;
this.maxy=max_y;
this.name=name2;
}
bool deploy(){
bool success=send_reliable(peer_id, "tiendasgeneral "+this.name, 14);
if(success){
return true;
}
return false;
}
}
int get_store_index(int x, int y){
for(int i=0; i<stores.length(); i++){
int minx=stores[i].minx;
int maxx=stores[i].maxx;
int miny=stores[i].miny;
int maxy=stores[i].maxy;
if(minx>x)continue;
if(minx<=x && maxx>=x && miny<=y && maxy>=y){
return i;
}
}
return -1;
}
void destroy_stores(){
stores.resize(0);
}
void stores_building_menu(){
setupmenu2();
m.add_item_tts(pu.get_value("crear tienda nueva."), "create");
m.add_item_tts(pu.get_value("gestionar tiendas actualmente activas."), "manage");
m.add_item_tts(pu.get_value("volver al menú del constructor."), "back");
int get=m.run(pu.get_value("menú de creación y administración de tiendas. elija una opción y presione enter en ella para activarla."), true);
if(m.get_item_name(get)=="back"||get==0){
buildermenu();
}
if(m.get_item_name(get)=="create"){
string minx=v.input(pu.get_value("escriba la coordenada x mínima de la tienda."));
string maxx=v.input(pu.get_value("escriba la coordenada x máxima de la tienda."));
string miny=v.input(pu.get_value("escriba la coordenada y mínima de la tienda."));
string maxy=v.input(pu.get_value("escriba la coordenada y máxima de la tienda."));
string store_name=v.input(pu.get_value("escriba el nombre de la tienda (sin espacios)."));
if(minx!=""&&maxx!=""&&miny!=""&&maxy!=""&&store_name!=""){
string[] data=map2;
data.remove_at(data.length()-1);
data.remove_at(data.length()-1);
data.insert_last("store:"+minx+":"+maxx+":"+miny+":"+maxy+":"+store_name);
send_reliable(peer_id, "/rawdata "+linear(data), 1);
send_reliable(peer_id, "create_store "+store_name, 14);
}
}
if(m.get_item_name(get)=="manage"){
send_reliable(peer_id, "manage_stores", 14);
}
}
void manage_store(string content){
string[] data=string_split(content, "|", true);
setupmenu2();
m.add_item_tts(pu.get_value("gestionar objetos a la venta."), "items_for_sale");
m.add_item_tts(pu.get_value("gestionar objetos colocados en tiendas."), "stores");
m.add_item_tts(pu.get_value("volver al menú de las tiendas."), "back");
int get=m.run(pu.get_value("menú de gestión de tiendas. seleccione la opción que desee con enter."), true);
if(m.get_item_name(get)=="back"||get==0){
stores_building_menu();
}
if(m.get_item_name(get)=="items_for_sale"){
manage_items_for_sale(data[0]);
}
if(m.get_item_name(get)=="stores"){
show_stores(data[1]);
}
}
void manage_items_for_sale(string content){
string[] lines=delinear(content);
string[] data;
string old_line;
int counter=-1, counter2=-1, old_counter=-1;
speak(pu.get_value("gestor de objetos puestos a la venta en el servidor."));
string cl;
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE)||lines.length()==0){
break;
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and lines.length()>0){
int f=0;
int oc=counter;
for(uint i=counter; i<lines.length(); i++){
if(i==counter){
continue;
}
data=string_split(lines[i], "=", false);
if(data[0][0]==cl){
counter=i;
data=string_split(lines[counter], "=", true);
speak(pu.get_value("item a la venta:")+" "+data[0]+". "+pu.get_value("moneda con la que se comprará:")+" "+data[1]+". "+pu.get_value("cantidad necesaria de la moneda anteriormente mencionada para poder adquirir el objeto:")+" "+data[2]+". "+pu.get_value("descripción:")+" "+data[3]);
cl="";
f=1;
break;
}
}
if(f==0){
counter=0;
for(uint i=counter; i<lines.length(); i++){
data=string_split(lines[i], "=", false);
if(data[0][0]==cl){
counter=i;
data=string_split(lines[counter], "=", true);
speak(pu.get_value("item a la venta:")+" "+data[0]+". "+pu.get_value("moneda con la que se comprará:")+" "+data[1]+". "+pu.get_value("cantidad necesaria de la moneda anteriormente mencionada para poder adquirir el objeto:")+" "+data[2]+". "+pu.get_value("descripción:")+" "+data[3]);
cl="";
f=1;
break;
}
}
}
}
if(left.pressing()&&counter>0&&counter2==-1){
counter--;
data=string_split(lines[counter], "=", true);
speak(pu.get_value("item a la venta:")+" "+data[0]+". "+pu.get_value("moneda con la que se comprará:")+" "+data[1]+". "+pu.get_value("cantidad necesaria de la moneda anteriormente mencionada para poder adquirir el objeto:")+" "+data[2]+". "+pu.get_value("descripción:")+" "+data[3]);
}
if(right.pressing()&&counter<lines.length()-1&&counter2==-1){
counter++;
data=string_split(lines[counter], "=", true);
speak(pu.get_value("item a la venta:")+" "+data[0]+". "+pu.get_value("moneda con la que se comprará:")+" "+data[1]+". "+pu.get_value("cantidad necesaria de la moneda anteriormente mencionada para poder adquirir el objeto:")+" "+data[2]+". "+pu.get_value("descripción:")+" "+data[3]);
}
if(key_pressed(KEY_HOME)&&counter>0&&counter2==-1){
counter=0;
data=string_split(lines[counter], "=", true);
speak(pu.get_value("item a la venta:")+" "+data[0]+". "+pu.get_value("moneda con la que se comprará:")+" "+data[1]+". "+pu.get_value("cantidad necesaria de la moneda anteriormente mencionada para poder adquirir el objeto:")+" "+data[2]+". "+pu.get_value("descripción:")+" "+data[3]);
}
if(key_pressed(KEY_END)&&counter<lines.length()-1&&counter2==-1){
counter=lines.length()-1;
data=string_split(lines[counter], "=", true);
speak(pu.get_value("item a la venta:")+" "+data[0]+". "+pu.get_value("moneda con la que se comprará:")+" "+data[1]+". "+pu.get_value("cantidad necesaria de la moneda anteriormente mencionada para poder adquirir el objeto:")+" "+data[2]+". "+pu.get_value("descripción:")+" "+data[3]);
}
if(up.pressing()&&counter>-1&&counter2<data.length()-1){
counter2++;
speak(data[counter2]);
}
if(down.pressing()&&counter>-1&&counter2>-1){
counter2--;
if(counter2>-1) speak(data[counter2]);
else speak(pu.get_value("item a la venta:")+" "+data[0]+". "+pu.get_value("moneda con la que se comprará:")+" "+data[1]+". "+pu.get_value("cantidad necesaria de la moneda anteriormente mencionada para poder adquirir el objeto:")+" "+data[2]+". "+pu.get_value("descripción:")+" "+data[3]);
}
if(key_pressed(KEY_RETURN)&&counter2>-1||key_pressed(KEY_NUMPADENTER)&&counter2>-1){
if(old_line.length()>0) return;
string key=data[counter2];
string new=v.input(pu.get_value("está modificando el término")+" "+data[counter2]+". "+pu.get_value("escriba con cuidado."), key);
if(new!=""){
old_line=lines[counter];
old_counter=counter;
data[counter2]=string_replace(data[counter2], key, new, true);
lines[counter]=string_replace(lines[counter], key, data[counter2], true);
speak(pu.get_value("actualizado."));
}
}
if(key_pressed(KEY_DELETE)&&counter>-1){
int opt=q_pro(pu.get_value("esta línea está apunto de ser eliminada, ¿realmente quieres continuar?"));
if(opt==1){
send_reliable(peer_id, "remove_item_for_sale "+data[0], 14);
lines.remove_at(counter);
}
else{
speak(pu.get_value("cancelado."));
}
}
if(key_down(KEY_LCONTROL)||key_down(KEY_RCONTROL)){
if(key_pressed(KEY_R)&&old_line.length()>0&&counter==old_counter){
send_reliable(peer_id, "replace_item_for_sale "+lines[counter]+"|"+old_line, 14);
old_line.resize(0);
old_counter=-1;
}
if(key_pressed(KEY_A)){
string item=v.input(pu.get_value("escriba el nombre del item a añadir."));
string money=v.input(pu.get_value("¿con qué moneda quiere que sea posible comprar este item?"));
string price=v.input(pu.get_value("¿cuál será el precio?"));
string description=v.input(pu.get_value("escriba la descripción del item."));
string id=v.input(pu.get_value("escriba un número entre 1000 y 9999 que sirva de identificador interno del objeto."));
if(item!=""&&money!=""&&price!=""&&description!=""&&id!=""){
send_reliable(peer_id, "add_item_for_sale "+item+" "+money+" "+price+" "+id+" "+description, 14);
return;
}
}
}

}
}
void show_stores(string content){
string[] lines=delinear(content);
int counter=-1;
string cl;
speak(pu.get_value("elija la tienda cuyo contenido quiere ver."));
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_ESCAPE)||lines.length()==0){
break;
}
cl=get_characters();
if(cl!="" and cl!=" " and cl.length()==1 and lines.length()>0){
int f=0;
int oc=counter;
for(uint i=counter; i<lines.length(); i++){
if(i==counter){
continue;
}
string item=get_item_translation(lines[i]);
if(item=="") item=pu.get_value(lines[i]);
if(item[0]==cl){
counter=i;
speak(item);
cl="";
f=1;
break;
}
}
if(f==0){
counter=0;
for(uint i=counter; i<lines.length(); i++){
string item=get_item_translation(lines[i]);
if(item=="") item=pu.get_value(lines[i]);
if(item[0]==cl){
counter=i;
speak(item);
cl="";
f=1;
break;
}
}
}
}
if(left.pressing()&&counter>0){
counter--;
speak(lines[counter]);
}
if(right.pressing()&&counter<lines.length()-1){
counter++;
speak(lines[counter]);
}
if(key_pressed(KEY_HOME)&&counter>0){
counter=0;
speak(lines[counter]);
}
if(key_pressed(KEY_END)&&counter<lines.length()-1){
counter=lines.length()-1;
speak(lines[counter]);
}
if(key_pressed(KEY_RETURN)&&counter>-1||key_pressed(KEY_NUMPADENTER)&&counter>-1){
send_reliable(peer_id, "show_store "+lines[counter], 14);
}
if(key_pressed(KEY_DELETE)&&counter>-1){
int opt=q_pro(pu.get_value("esta tienda está apunto de ser eliminada, ¿realmente quieres continuar?"));
if(opt==1){
send_reliable(peer_id, "delete_store "+lines[counter], 14);
lines.remove_at(counter);
}
else{
speak(pu.get_value("cancelado."));
}
}

}
}
