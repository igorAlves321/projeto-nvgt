int addpos;
add@[] adds;
class add{
	int active=1;
	int pos;
	string name, currently_buffer;
	string[] items;
	timer last_activity; // Para rastrear quando foi a última atividade
	
	add(string n){
		name=n;
		last_activity.restart(); // Inicializar o timer
	}
	add(string n, string[] items){
		this.name=n;
		this.items =items;
		last_activity.restart(); // Inicializar o timer
	}
}

void create_add(string bname){
	add b1(bname);
	adds.insert_last(b1);
}
void firstadd(){
	cleanup_empty_channels(); // Limpar canais vazios
	reorder_channels(); // Garantir ordem fixa
	addpos=0;
	speakfocusedadd();
}
void lastadd(){
	cleanup_empty_channels(); // Limpar canais vazios
	reorder_channels(); // Garantir ordem fixa
	if (adds.length() > 0) {
		addpos=adds.length()-1;
	} else {
		addpos=0;
	}
	speakfocusedadd();
}
void addleft(){
	cleanup_empty_channels(); // Limpar canais vazios antes de navegar
	reorder_channels(); // Garantir ordem fixa
	if (addpos<=0)addpos=0;
	else{
		addpos-=1;
		speakfocusedadd();
	}
}
void addright(){
	cleanup_empty_channels(); // Limpar canais vazios antes de navegar
	reorder_channels(); // Garantir ordem fixa
	if (addpos>=(adds.length()-1)){
		if (adds.length()>0)addpos=adds.length()-1;
	}
	else{
		addpos+=1;
		speakfocusedadd();
	}
}
void nextadditem(){
	if (adds[addpos].pos<(adds[addpos].items.length()-1)){
		adds[addpos].pos+=1;
		speak(pu.get_value(adds[addpos].items[adds[addpos].pos]));
	}
}
void prevadditem(){
	if (adds[addpos].pos>0){
		adds[addpos].pos-=1;
		speak(pu.get_value(adds[addpos].items[adds[addpos].pos]));
	}
}
void topadditem(){
	if (adds[addpos].items.length()>0){
		adds[addpos].pos=0;
		speak(pu.get_value(adds[addpos].items[adds[addpos].pos]));
	}
}
void bottomadditem(){
	if (adds[addpos].items.length()>0){
		adds[addpos].pos=(adds[addpos].items.length()-1);
		speak(pu.get_value(adds[addpos].items[adds[addpos].pos]));	}
}

// Função para verificar se um canal existe
bool channel_exists(string addname) {
	for (uint i=0; i<adds.length(); i++) {
		if (adds[i].name==addname) {
			return true;
		}
	}
	return false;
}

// Função para criar canal dinamicamente se não existir
void ensure_channel_exists(string addname) {
	if (!channel_exists(addname)) {
		create_add(addname);
		// Reorganizar para manter "general" sempre em primeiro
		reorder_channels();
	}
}

// Função para garantir ordem fixa dos canais
void reorder_channels() {
	add@[] reordered;
	
	// Ordem fixa dos canais (por prioridade)
	string[] fixed_order = {
		"general",                    // 1º - tudo
		"canal_principal",           // 2º - canal principal
		"canal_local",               // 3º - canal local
		"mensajes_del_equipo",       // 4º - chat de equipe
		"conversaciones_privadas",   // 5º - conversas privadas
		"mensajes_de_voz",          // 6º - mensagens de voz
		"avisos",                   // 7º - avisos
		"visiones_angelicales",     // 8º - administração
		"ventas",                   // 9º - vendas
		"avisos_de_muerte",         // 10º - avisos de morte
		"notificaciones_de_conexiónes", // 11º - notificações de conexão
		"conversaciones_con_la_pareja", // 12º - conversas com a pareja
		"conversaciones_celestiales"    // 13º - conversas celestiais
	};
	
	// Primeiro, adicionar canais na ordem fixa (apenas os que existem)
	for (uint p = 0; p < fixed_order.length(); p++) {
		for (uint i = 0; i < adds.length(); i++) {
			if (adds[i].name == fixed_order[p]) {
				reordered.insert_last(adds[i]);
				break;
			}
		}
	}
	
	// Depois, adicionar qualquer canal que não esteja na lista fixa (canais novos/desconhecidos)
	for (uint i = 0; i < adds.length(); i++) {
		bool found_in_fixed = false;
		for (uint p = 0; p < fixed_order.length(); p++) {
			if (adds[i].name == fixed_order[p]) {
				found_in_fixed = true;
				break;
			}
		}
		if (!found_in_fixed) {
			reordered.insert_last(adds[i]);
		}
	}
	
	// Ajustar posição atual
	string current_channel = "";
	if (addpos >= 0 && addpos < int(adds.length())) {
		current_channel = adds[addpos].name;
	}
	
	// Substituir array
	adds = reordered;
	
	// Encontrar nova posição do canal atual
	for (uint i = 0; i < adds.length(); i++) {
		if (adds[i].name == current_channel) {
			addpos = i;
			break;
		}
	}
	
	// Se não encontrou o canal atual, voltar para o primeiro
	if (addpos >= int(adds.length()) || addpos < 0) {
		addpos = 0;
	}
}

void add_add_item(string addname, string item,bool speakitem=true){
if(logs==1){
if(!directory_exists("logs"))directory_create("logs");
file logfile;
logfile.open("logs/log_"+DATE_YEAR+"_"+DATE_MONTH+"_"+DATE_DAY+".log", "a");
logfile.write(item+"\r\n");
logfile.close();
}
	// Garantir que o canal existe antes de adicionar a mensagem
	ensure_channel_exists(addname);
	
	for (uint i=0; i<adds.length(); i++) {
		if (adds[i].name==addname||adds[i].name=="general"){
			if (speakitem&&adds[i].name!="general")speak(item, 0);
			adds[i].items.insert_last(item);
			adds[i].last_activity.restart(); // Atualizar timestamp da atividade
		}
	}
}
void speakfocusedadd(){
adds[addpos].currently_buffer=adds[addpos].name;
	if (adds[addpos].items.length()>0)speak(pu.get_value(adds[addpos].name)+". "+(adds[addpos].pos+1)+" "+pu.get_value("de")+" "+adds[addpos].items.length()+".");
	else speak(pu.get_value(adds[addpos].name)+". "+adds[addpos].items.length()+" "+pu.get_value("elementos."));
}

int get_buffer_index(string buffername) {
	for(int i=0; i<adds.length(); i++) {
		if(adds[i].name==buffername) return i;
	}
	return -1;
}

void load_message_buffers() {
	if(file_exists("buffers.ini")) {
		file buf;
		buf.open("buffers.ini", "rb");
		string content =string_decrypt(buf.read(), PREFS_ENCRYPTION_KEY);
		string[] buffers=delinear(content);
		buf.close();
		for(int x=0; x<buffers.length(); x++) {
			create_add(buffers[x]);
		}
	}	else {
		// Criar apenas o canal "tudo" inicialmente - ele recebe todas as mensagens
		create_add("general"); // Canal "tudo" - sempre visível pois recebe todas as mensagens
		// Os outros canais (incluindo "avisos") serão criados dinamicamente quando receberem mensagens
	}
	return;
}

bool sort_buffer(string buffername, int range) {
	int buffer_index=get_buffer_index(buffername);
	int newposition;
	if(buffer_index>-1) {
		add buffer(adds[buffer_index].name, adds[buffer_index].items);
		newposition =buffer_index+range;
		if(newposition>=0 && newposition<adds.length()) {
			adds.remove_at(buffer_index);
			adds.insert_at(newposition, buffer);
			return true;
		}
	}
	return false;
}

void buffersmenu() {
	if(ausente) return;
	int counter =-1;
	p.play_stationary("notify37.ogg", false);
	speak(pu.get_value("Menú de gestión de búfers. Para mover los apartados, pulse alt+j o alt+k. Para guardarlos, pulse enter."));
	while(true) {
		wait(5);
		mainloop();
		if(key_pressed(KEY_ESCAPE)){
			break;
		}
		if(key_pressed(KEY_LEFT) && counter>0) {
			counter--;
			p.play_stationary("invmove6.ogg", false);
			speak(pu.get_value(adds[counter].name));
		}
		if(key_pressed(KEY_RIGHT) && counter<adds.length()-1) {
			counter++;
			p.play_stationary("invmove6.ogg", false);
			speak(pu.get_value(adds[counter].name));
		}
		if(key_pressed(KEY_HOME)&&counter>0){
			counter=0;
			p.play_stationary("invmove6.ogg", false);
			speak(pu.get_value(adds[counter].name));
		}
		if(key_pressed(KEY_END)&&counter<adds.length()-1){
			counter=adds.length()-1;
			p.play_stationary("invmove6.ogg", false);
			speak(pu.get_value(adds[counter].name));
		}
		if(key_down(KEY_LMENU) && key_pressed(KEY_J)) {
			if(counter>0) {
				p.play_stationary("-old-menubounds.ogg", false);
				speak(pu.get_value(adds[counter].name)+" "+pu.get_value("movido a la izquierda."));
				sort_buffer(adds[counter].name, -1);
				counter--;
			}
		}
		if(key_down(KEY_LMENU) && key_pressed(KEY_K)) {
			if(counter>=0 && counter<adds.length()-1) {
				p.play_stationary("-old-menubounds.ogg", false);
				speak(pu.get_value(adds[counter].name)+" "+pu.get_value("movido a la derecha."));
				sort_buffer(adds[counter].name, 1);
				counter++;
			}
		}
		if(key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER)) {
			if(counter>=0) {
				p.play_stationary("menuchecked.ogg", false);
				save_buffers();
				break;
			}
		}
	}
	optionsmenu2();
}

void save_buffers() {
	if(adds.length()>0) {
		string final;
		for(int i=0; i<adds.length(); i++) {
			final +=adds[i].name+"\r\n";
		}
		string content =string_encrypt(final, PREFS_ENCRYPTION_KEY);
		file buf;
		buf.open("buffers.ini", "wb");
		buf.write(content);
		buf.close();
		speak(pu.get_value("Configuración de búfers guardada."));
	}
	return;
}

void copy_buffer() {
	if(adds.length()>0) {
		if(adds[addpos].items.length()>0) {
			clipboard_copy_text(linear(adds[addpos].items));
			speak(pu.get_value("Búfer de mensagens copiado ao portapapeles."));
		}
		else {
			speak(pu.get_value("Búfer de mensagens vazio."));
		}
	}
}

// Função para remover canais vazios e inativos (exceto canais essenciais)
void cleanup_empty_channels() {
	string[] essential_channels = {"general"}; // Apenas o canal "tudo" sempre deve existir
	int inactive_timeout = 300000; // 5 minutos em milissegundos
	
	for (int i = adds.length()-1; i >= 0; i--) {
		bool is_essential = false;
		
		// Verificar se é um canal essencial
		for (uint j = 0; j < essential_channels.length(); j++) {
			if (adds[i].name == essential_channels[j]) {
				is_essential = true;
				break;
			}
		}
		
		// Condições para remover o canal:
		// 1. Não é essencial E (está vazio OU inativo há mais de 5 minutos)
		bool should_remove = !is_essential && 
			(adds[i].items.length() == 0 || adds[i].last_activity.elapsed > inactive_timeout);
		if (should_remove) {
			// Criar um novo array sem este elemento
			add@[] new_adds;
			for (uint k = 0; k < adds.length(); k++) {
				if (k != uint(i)) {
					new_adds.insert_last(adds[k]);
				}
			}
			adds = new_adds;
			// Ajustar a posição atual se necessário
			if (addpos >= i && addpos > 0) {
				addpos--;
			}
		}
	}
	
	// Garantir que addpos seja válido
	if (addpos >= int(adds.length())) {
		addpos = adds.length() - 1;
	}
	if (addpos < 0 && adds.length() > 0) {
		addpos = 0;
	}
}

