sound dlgaudio;
void dlgplay(string dlgsound, bool dlgfade=false, int fadespeed=30){
	dlgaudio.load(dlgsound);
	dlgaudio.play();
	while(dlgaudio.playing){
		emchat=true;
		wait(5);
		if(key_pressed(KEY_RETURN)){
			if (dlgfade==true)fade(dlgaudio, -80, fadespeed);
			dlgaudio.stop();
			dlgaudio.close();
			emchat=false;
			break;
		}
	}
}

void dlg(string message){
	speak(pu.get_value(message));
	emchat=true;
	while(true){
		wait(5);
		if (key_pressed(KEY_LEFT)||key_pressed(KEY_RIGHT)||key_pressed(KEY_UP)||key_pressed(KEY_DOWN))speak(pu.get_value(message)+"\r\n"+pu.get_value("Pressione enter para continuar."));
		if(key_pressed(KEY_C)) clipboard_copy_text(message);
		if (key_pressed(KEY_RETURN)||key_pressed(KEY_ESCAPE)||key_pressed(KEY_SPACE)){
			emchat=false;
			break;
		}
	}
}
void dialog2(string text, string filesound="door17open.ogg"){
if(string_contains(text, "*g*", 1)>-1){
text=string_replace(text, "*g*", gender, true);
}
if(string_contains(text, "*nick*", 1)>-1){
text=string_replace(text, "*nick*", un, true);
}
speak(pu.get_value(text));
p.play_2d(filesound, me.x, me.y, me.x, me.y, false);
emchat=true;
while(true){
wait(5);
mainloop();
if(key_pressed(KEY_Z)){
clipboard_copy_text(text);
speak(pu.get_value(text)+" "+pu.get_value("copiado al portapapeles."));
}
if(key_pressed(KEY_T)){
speak(pu.get_value(text));
}
if(key_pressed(KEY_RETURN)||key_pressed(KEY_NUMPADENTER)){
emchat=false;
break;
}
}
}
