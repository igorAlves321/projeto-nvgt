// Sistema de clima (chuva) convertido para NVGT
// Baseado em comandos grandes.bgt linha 247

void chuva() {
	// chuvatelhado e chuvaativa estão em client.nvgt
	// somchuva está em globals.nvgt
	chuvatelhado.close();
	chuvatelhado.volume = -12;
	if(chuvaativa == 1) {
		chuvatelhado.load(get_sound_path(somchuva));
		chuvatelhado.play_looped();
	}
}
