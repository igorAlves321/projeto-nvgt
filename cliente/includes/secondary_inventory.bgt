db secondary_inventory;
string[] secondary_items;
int selected_item;

void load_secondary_inventory(string data) {
	string content =string_replace(data, "invsec ", "", true);
	string[] lines =delinear(content);
	if(lines.length()==0) {
		return;
	}
	if(lines.length()>0) {
		for(int i=0; i<lines.length(); i++) {
			secondary_inventory.set(lines[i], inv_item_number(lines[i]));
		}
	}
}

void secundario(){
	secondary_items =secondary_inventory.get_keys();
	if(secondary_items.length()>0){
		if(key_pressed(KEY_BACK) && inv_item_number(secondary_items[selected_item])>0)interact(secondary_items[selected_item]);
		if(!key_down(KEY_LMENU)&&!key_down(KEY_RMENU)){
			if(key_down(KEY_RSHIFT)&&key_pressed(KEY_TAB)&&!ausente||key_down(KEY_LSHIFT)&&key_pressed(KEY_TAB)&&!ausente){
				selected_item--;
				if(selected_item<0)selected_item=secondary_items.length()-1;
				if(selected_item>secondary_items.length())selected_item=0;
				speak(pu.get_value(secondary_items[selected_item])+", "+inv_item_number(secondary_items[selected_item]));
			}
			if(key_pressed(KEY_TAB)&&!ausente){
				if(secondary_items.length()>0){
					selected_item++;
					if(selected_item>secondary_items.length()-1)selected_item=0;
					speak(pu.get_value(secondary_items[selected_item])+", "+inv_item_number(secondary_items[selected_item]));
				}
			}
		}
	}
}
