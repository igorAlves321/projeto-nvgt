// 💬 Sistema de Chat para NVGT - Conversão de BGT
// Baseado em add.bgt e net.bgt do projeto original

// ==========================================
// CONSTANTES DE TIPOS DE CHAT
// ==========================================

const string CHAT_GENERAL = "general";              // Tudo (histórico completo)
const string CHAT_LOCAL = "local";                  // Chat do mapa local
const string CHAT_PRIVATE = "private";              // Mensagens privadas
const string CHAT_TEAM = "team";                    // Chat de equipe
const string CHAT_GLOBAL = "global";                // Chat global/público
const string CHAT_SYSTEM = "system";                // Avisos do sistema

// ==========================================
// CLASSE DE CANAL DE CHAT
// ==========================================

class chat_channel {
    string name;
    string[] messages;
    uint current_position = 0;
    
    chat_channel(string channel_name = "") {
        name = channel_name;
        current_position = 0;
    }
    
    void add_message(string msg) {
        messages.insert_last(msg);
    }
    
    uint get_message_count() {
        return messages.length();
    }
    
    string get_current_message() {
        if(current_position >= messages.length()) {
            return "";
        }
        return messages[current_position];
    }
    
    bool next_message() {
        if(current_position < messages.length() - 1) {
            current_position++;
            return true;
        }
        return false;
    }
    
    bool prev_message() {
        if(current_position > 0) {
            current_position--;
            return true;
        }
        return false;
    }
};

// ==========================================
// VARIÁVEIS GLOBAIS
// ==========================================

chat_channel@[] chat_channels;
uint current_channel_index = 0;
int chat_logs_enabled = 0;
bool chat_initialized = false;

// ==========================================
// INICIALIZAÇÃO
// ==========================================

void chat_initialize() {
    if(chat_initialized) return;
    
    debug_log("💬 Inicializando sistema de chat");
    
    chat_channel general_channel(CHAT_GENERAL);
    chat_channels.insert_last(general_channel);
    
    if(un.length() > 0) {
        chat_channels[0].add_message("Bem-vindo de volta, " + un + "!");
    } else {
        chat_channels[0].add_message("Bem-vindo ao jogo!");
    }
    
    chat_initialized = true;
    debug_log("✅ Sistema de chat inicializado");
}

// ==========================================
// GERENCIAMENTO DE CANAIS
// ==========================================

void chat_create_channel(string channel_name) {
    for(uint i = 0; i < chat_channels.length(); i++) {
        if(chat_channels[i].name == channel_name) {
            return;
        }
    }
    
    chat_channel new_channel(channel_name);
    chat_channels.insert_last(new_channel);
    debug_log("✅ Canal criado: " + channel_name);
}

// ==========================================
// ADIÇÃO DE MENSAGENS
// ==========================================

void chat_add_message(string channel_name, string message, bool should_speak = true) {
    if(!chat_initialized) {
        chat_initialize();
    }
    
    // Log em arquivo se habilitado
    if(chat_logs_enabled == 1) {
        string log_filename = "logs/chat_" + string(DATE_YEAR) + "_" + 
                             string(DATE_MONTH) + "_" + 
                             string(DATE_DAY) + ".log";
        
        if(!directory_exists("logs")) {
            directory_create("logs");
        }
        
        file logfile;
        if(logfile.open(log_filename, "a")) {
            string time_str = "" + TIME_HOUR + ":" + TIME_MINUTE + ":" + TIME_SECOND;
            logfile.write("[" + time_str + "] " + channel_name + ": " + message + "\r\n");
            logfile.close();
        }
    }
    
    // Verificar se o canal existe
    bool channel_exists = false;
    for(uint i = 0; i < chat_channels.length(); i++) {
        if(chat_channels[i].name == channel_name) {
            channel_exists = true;
            break;
        }
    }
    
    // Se não existe, criar
    if(!channel_exists) {
        chat_create_channel(channel_name);
    }
    
    // Adicionar ao canal e ao general
    for(uint i = 0; i < chat_channels.length(); i++) {
        if(chat_channels[i].name == channel_name || 
           chat_channels[i].name == CHAT_GENERAL) {
            
            chat_channels[i].add_message(message);
            
            // Vocalizar se não for general
            if(should_speak && channel_name != CHAT_GENERAL) {
                if(ouviremoutrasjanelas == 1 || is_game_window_active()) {
                    speak(message);
                }
            }
        }
    }
    
    debug_log("💬 [" + channel_name + "] " + message);
}

// ==========================================
// NAVEGAÇÃO ENTRE CANAIS
// ==========================================

void chat_next_channel() {
    if(chat_channels.length() == 0) {
        speak("Nenhum canal disponível");
        return;
    }
    
    if(current_channel_index < chat_channels.length() - 1) {
        current_channel_index++;
    } else {
        current_channel_index = 0;
    }
    
    chat_speak_current_channel();
}

void chat_prev_channel() {
    if(chat_channels.length() == 0) {
        speak("Nenhum canal disponível");
        return;
    }
    
    if(current_channel_index > 0) {
        current_channel_index--;
    } else {
        current_channel_index = chat_channels.length() - 1;
    }
    
    chat_speak_current_channel();
}

void chat_speak_current_channel() {
    if(chat_channels.length() == 0) {
        speak("Nenhum canal disponível");
        return;
    }
    
    chat_channel@ current = chat_channels[current_channel_index];
    
    string status;
    
    if(current.get_message_count() > 0) {
        status = current.name + ". Canal " + (current_channel_index + 1) + 
                " de " + chat_channels.length() + ". " +
                current.get_message_count() + " mensagens";
    } else {
        status = current.name + ". Canal vazio";
    }
    
    speak(status);
}

// ==========================================
// LEITURA DE MENSAGENS
// ==========================================

void chat_read_current() {
    if(chat_channels.length() == 0) {
        speak("Nenhum canal disponível");
        return;
    }
    
    chat_channel@ current = chat_channels[current_channel_index];
    
    if(current.get_message_count() == 0) {
        speak(current.name + " vazio");
        return;
    }
    
    string msg = current.get_current_message();
    speak(msg);
}

void chat_next_message() {
    if(chat_channels.length() == 0) return;
    
    chat_channel@ current = chat_channels[current_channel_index];
    
    if(current.get_message_count() == 0) return;
    
    if(current.next_message()) {
        speak(current.get_current_message());
    } else {
        speak("Última mensagem");
    }
}

void chat_prev_message() {
    if(chat_channels.length() == 0) return;
    
    chat_channel@ current = chat_channels[current_channel_index];
    
    if(current.get_message_count() == 0) return;
    
    if(current.prev_message()) {
        speak(current.get_current_message());
    } else {
        speak("Primeira mensagem");
    }
}

// ==========================================
// UTILITÁRIOS
// ==========================================

uint chat_get_total_channels() {
    return chat_channels.length();
}

uint chat_get_current_message_count() {
    if(chat_channels.length() == 0) return 0;
    return chat_channels[current_channel_index].get_message_count();
}

string chat_get_current_channel_name() {
    if(chat_channels.length() == 0) return "";
    return chat_channels[current_channel_index].name;
}

void chat_debug_status() {
    debug_log("=== CHAT DEBUG STATUS ===");
    debug_log("Total de canais: " + chat_channels.length());
    debug_log("Canal ativo: " + chat_get_current_channel_name());
    debug_log("Mensagens: " + chat_get_current_message_count());
    
    for(uint i = 0; i < chat_channels.length(); i++) {
        debug_log("  [" + i + "] " + chat_channels[i].name + 
                 " (" + chat_channels[i].get_message_count() + " msgs)");
    }
}
