// sound_path_wrapper.nvgt
// Wrapper para automaticamente adicionar prefixo "sounds/" quando necessário

// Esta é a variável global do sound_pool
extern pack@ sound_default_pack;

// Função global para preparar caminhos de som
funcdef string sound_path_processor(string);
sound_path_processor@ global_sound_path_processor;

// Implementação padrão do processador
string default_sound_path_processor(string filename) {
	// Se usar pack, retornar como está
	if(@sound_default_pack != null) {
		return filename;
	}
	
	// Se já tem "sounds/" no início, retornar como está
	if(filename.find("sounds/") == 0) {
		return filename;
	}
	
	// Se o arquivo existe na raiz, usar direto
	if(file_exists(filename)) {
		return filename;
	}
	
	// Adicionar prefixo "sounds/"
	string prefixed = "sounds/" + filename;
	if(file_exists(prefixed)) {
		return prefixed;
	}
	
	// Fallback: retornar original
	return filename;
}

// Inicializar o processador
void init_sound_path_processor() {
	@global_sound_path_processor = @default_sound_path_processor;
}
