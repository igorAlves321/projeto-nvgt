}

bool alt_pressionado(){
	if(key_down(KEY_LMENU)||key_down(KEY_RMENU))return true;
	return false;
}

//  Chat Administrativo - Abre input e envia para o servidor
void chat_administrativo() {
	string msg = v.input(pu.get_value("Digite sua mensagem para o chat admin."));
	if(msg != "") {
		send_reliable(peer_id, "adm " + msg, 0);
	}
}

