// Função de verificação de movimento por direção (do BGT original)
bool abletomove_direction(int direction){
	string locate = get_zone_at(me.x, me.y);
	if(locate == "Elevador." || dmoving || !moveable || paraquedas == 1) {
		debug_log("🚫 [abletomove_direction] Bloqueado: zone=" + locate + " dmoving=" + dmoving + " moveable=" + moveable + " paraquedas=" + paraquedas);
		return false;
	}
	
	if(direction == Left){
		if(string_contains(get_tile_at((me.x-1), me.y), "wall", 1) > -1){
			if(cloaked == false){
				string walltype;
				string tile = get_tile_at((me.x-1), me.y);
				walltype = string_replace(tile, "wall", "", true);
				if(onwall == false){
					p.play_stationary("wall" + walltype + ".ogg", false);
					send_unreliable(peer_id, "draw wall" + walltype + ".ogg", 0);
					onwall = true;
					return false;
				}
			}
			else{
				p.play_stationary("spell_cloak_throughwall.ogg", false);
				send_unreliable(peer_id, "draw spell_cloak_throughwall.ogg", 0);
				return true;
			}
		}
		else{
			onwall = false;
			return true;
		}
	}
	else if(direction == Right){
		if(string_contains(get_tile_at((me.x+1), me.y), "wall", 1) > -1){
			if(cloaked == false){
				string walltype;
				string tile = get_tile_at((me.x+1), me.y);
				walltype = string_replace(tile, "wall", "", true);
				if(onwall == false){
					p.play_stationary("wall" + walltype + ".ogg", false);
					send_unreliable(peer_id, "draw wall" + walltype + ".ogg", 0);
					onwall = true;
					return false;
				}
			}
			else{
				p.play_stationary("spell_cloak_throughwall.ogg", false);
				send_unreliable(peer_id, "draw spell_cloak_throughwall.ogg", 0);
				return true;
			}
		}
		else{
			onwall = false;
			return true;
		}
	}
	return onwall ? false : true;
}

// Função abletomove() - verifica se pode se mover (do BGT original)
bool abletomove(){
	string locate = get_zone_at(me.x, me.y);
	if(locate == "Elevador." || dmoving || !moveable || paraquedas == 1) return false;
	
	if(facing == Left){
		if(string_contains(get_tile_at((me.x-1), me.y), "wall", 1) > -1){
			if(cloaked == false){
				string walltype;
				string tile = get_tile_at((me.x-1), me.y);
				walltype = string_replace(tile, "wall", "", true);
				if(onwall == false){
					p.play_stationary("wall" + walltype + ".ogg", false);
					send_unreliable(peer_id, "draw wall" + walltype + ".ogg", 0);
					onwall = true;
					return false;
				}
			}
			else{
				p.play_stationary("spell_cloak_throughwall.ogg", false);
				send_unreliable(peer_id, "draw spell_cloak_throughwall.ogg", 0);
				return true;
			}
		}
		else{
			onwall = false;
			return true;
		}
	}
	else if(facing == Right){
		if(string_contains(get_tile_at((me.x+1), me.y), "wall", 1) > -1){
			if(cloaked == false){
				string walltype;
				string tile = get_tile_at((me.x+1), me.y);
				walltype = string_replace(tile, "wall", "", true);
				if(onwall == false){
					p.play_stationary("wall" + walltype + ".ogg", false);
					send_unreliable(peer_id, "draw wall" + walltype + ".ogg", 0);
					onwall = true;
					return false;
				}
			}
			else{
				p.play_stationary("spell_cloak_throughwall.ogg", false);
				send_unreliable(peer_id, "draw spell_cloak_throughwall.ogg", 0);
				return true;
			}
		}
		else{
			onwall = false;
			return true;
		}
	}
	return onwall ? false : true;
}

