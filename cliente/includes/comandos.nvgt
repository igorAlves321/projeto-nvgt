}

// ============================================================================
// MENU DE JOGADORES ONLINE (F5) - Lista global de todos jogadores conectados
// ============================================================================
// Recebe dados do servidor no formato: nome|titulo|status||nome2|titulo2|status2||...
// MIGRADO PARA SISTEMA NATIVO: Redução de 166 → 70 linhas (-58%)
void playersmenu(string data) {
	debug_log("📋 playersmenu chamado (versão nativa)");
	
	if(ausente) return;
	
	// Validar dados
	if(data == "" || data.length() < 3) {
		speak(pu.get_value("Nenhum jogador online."));
		return;
	}
	
	// Parse data (mantém lógica original)
	string[] lines = data.split("||");
	dictionary player_info;  // nome -> "titulo|status"
	
	for(uint i = 0; i < lines.length(); i++) {
		if(lines[i] == "" || lines[i].length() < 1) continue;
		
		string[] parsed = lines[i].split("|");
		if(parsed.length() >= 1 && parsed[0] != "") {
			string name = parsed[0];
			string title = parsed.length() >= 2 ? parsed[1] : "";
			string status = parsed.length() >= 3 ? parsed[2] : "";
			
			// Armazenar info
			player_info.set(name, title + "|" + status);
		}
	}
	
	if(player_info.size() == 0) {
		speak(pu.get_value("Nenhum jogador online."));
		return;
	}
	
	// Configurar menu nativo
	menu pm;
	@pm.pack_file = @sound_default_pack;
	pm.click_sound = "invmove6.ogg";
	pm.select_sound = "-old-menuchecked.ogg";
	pm.open_sound = "notify37.ogg";
	pm.wrap = false;
	pm.focus_first_item = false;
	
	// Adicionar jogadores ao menu
	string[] player_names = player_info.get_keys();
	player_names.sort_ascending();
	
	for(uint i = 0; i < player_names.length(); i++) {
		string name = player_names[i];
		string info = "";
		player_info.get(name, info);
		string[] parts = info.split("|");
		string title = parts.length() > 0 ? parts[0] : "";
		string status = parts.length() > 1 ? parts[1] : "";
		
		// Display: "Nome (Título): Status"
		string display = name;
		if(title != "") display += " (" + pu.get_value(title) + ")";
		if(status != "") display += ": " + status;
		
		pm.add_item(display, name);
	}
	
	pm.intro_text = pu.get_value("Mostrando lista de jogadores.") + " " + player_names.length() + " " + pu.get_value("online.");
	
	// Callback para atalhos (ALT+I, F1-F4, etc)
	@pm.background_callback = menu::menu_callback(playersmenu_shortcuts);
	pm.background_callback_data = "";
	
	emchat = true;
	
	// Run menu
	int selected_index = pm.run();
	emchat = false;
	
	if(selected_index < 0) return;  // ESC pressionado
	
	// Obter jogador selecionado
	string selected_name = pm.get_item_id(selected_index);
	
	// Pedir mensagem PM
	string msg = v.input(pu.get_value("Digite sua mensagem para") + " " + selected_name);
	if(msg != "") {
		send_reliable(peer_id, "/pm " + selected_name + " " + msg, 1);
		emchat = true;
	}
}

// Callback para atalhos do playersmenu
void playersmenu_shortcuts(menu@ m, string data) {
	if(m.focused_item < 0) return;
	string selected_name = m.get_item_id(m.focused_item);
	
	// ALT + teclas
	if(key_down(KEY_LMENU)) {
		if(key_pressed(KEY_I)) send_reliable(peer_id, "/ign " + selected_name, 1);
		if(key_pressed(KEY_U)) send_reliable(peer_id, "/deign " + selected_name, 1);
		if(key_pressed(KEY_E)) send_reliable(peer_id, "/eqr " + selected_name, 1);
		if(key_pressed(KEY_D)) send_reliable(peer_id, "/dqr " + selected_name, 1);
		if(key_pressed(KEY_S)) send_reliable(peer_id, "/eqs " + selected_name, 1);
	}
	
	// F1-F4: Info do jogador
	if(key_pressed(KEY_F1)) send_reliable(peer_id, "j1 " + selected_name, 0);
	if(key_pressed(KEY_F2)) send_reliable(peer_id, "j2 " + selected_name, 0);
	if(key_pressed(KEY_F3)) send_reliable(peer_id, "j3 " + selected_name, 0);
	if(key_pressed(KEY_F4)) send_reliable(peer_id, "j4 " + selected_name, 0);
	
	// Processar rede
	netloop();
}

// ============================================================================
// MENU DE JOGADORES NO MAPA (usado internamente)
// ============================================================================
// ============================================================================
// MENU DE JOGADORES NO MAPA - Lista jogadores no mesmo mapa que você
// ============================================================================
// MIGRADO PARA SISTEMA NATIVO: Redução de 120 → 45 linhas (-62%)
void jogadoresmenu(){
	if(players.length()==0||ausente)return;
	
	// Configurar menu nativo
	menu jm;
	@jm.pack_file = @sound_default_pack;
	jm.click_sound = "";
	jm.select_sound = "";
	jm.wrap = false;
	jm.focus_first_item = true;
	
	// Adiciona jogadores (filtra por beeping ou DM)
	for(uint i=0; i<players.length(); i++){
		if(players[i].beeping==1||desenvolvedordm==1){
			jm.add_item(players[i].charname, players[i].charname);
		}
	}
	
	if(jm.item_count == 0) return;
	
	jm.intro_text = "";
	
	// Callback para atalhos
	@jm.background_callback = menu::menu_callback(jogadoresmenu_shortcuts);
	
	emchat=true;
	int selected_index = jm.run();
	emchat=false;
	
	if(selected_index < 0) return;  // ESC
	
	string selected_player = jm.get_item_id(selected_index);
	
	// Enviar PM
	string msg=v.input(pu.get_value("Digite sua mensagem para")+" "+selected_player);
	if(msg!="") send_reliable(peer_id, "/pm "+selected_player+" "+msg, 1);
}

// Callback para atalhos do jogadoresmenu
void jogadoresmenu_shortcuts(menu@ m, string data) {
	if(m.focused_item < 0) return;
	string selected_player = m.get_item_id(m.focused_item);
	
	// F1-F4: Info do jogador
	if(key_pressed(KEY_F1)) send_reliable(peer_id, "j1 "+selected_player, 0);
	if(key_pressed(KEY_F2)) send_reliable(peer_id, "j2 "+selected_player, 0);
	if(key_pressed(KEY_F3)) send_reliable(peer_id, "j3 "+selected_player, 0);
	if(key_pressed(KEY_F4)) send_reliable(peer_id, "j4 "+selected_player, 0);
	
	// CTRL + teclas
	if(key_down(KEY_LCTRL)||key_down(KEY_RCTRL)){
		if(key_pressed(KEY_C)){
			clipboard_copy_text(selected_player);
			speak(selected_player+" "+pu.get_value("copiado."));
		}
		if(desenvolvedordm==1){
			if(key_pressed(KEY_M)) send_reliable(peer_id, "/killplayer "+selected_player, 1);
			if(key_pressed(KEY_E)) send_reliable(peer_id, "/expulsar "+selected_player, 1);
			if(key_pressed(KEY_B)) send_reliable(peer_id, "/ban "+selected_player, 1);
			if(key_pressed(KEY_Z)){
				nolhar=selected_player;
				int n=get_player(nolhar);
				if(n>-1){
					speak(pu.get_value("Pronto."));
					olhar_x=players[n].x;
					olhar_y=players[n].y;
					send_reliable(peer_id, "olhar "+nolhar, 0);
					moveable=false;
					inansz=true;
				}
			}
		}
	}
}


void computadormenu(){
	if(ausente)return;
	int counter=0;
	string[] peramitors = opcoespc.split("\r\n"); // NVGT nativo
	string[] peramitors2;
	for(uint i=0; i<peramitors.length(); i++){
		string[] parts = peramitors[i].split("="); // NVGT nativo
		if(parts.length() > 0) {
			peramitors[i] = parts[0]; // Convertido para NVGT
		}
	}
	speak(pu.get_value(peramitors[0]));
	while(true){
		wait(5);
		// mainloop() removido - não existe em NVGT
		if(ausente||mapname=="túnel")break;
		peramitors.resize(0);
		peramitors2.resize(0);
		peramitors2 = opcoespc.split("\r\n"); // NVGT nativo
		for(uint i=0; i<peramitors2.length(); i++){
			string[] split_result = peramitors2[i].split("="); // NVGT nativo
			peramitors2[i] = split_result.length() > 0 ? split_result[0] : ""; // Usando split() nativo do NVGT
			int pwn=0;
			peramitors.insert_last(peramitors2[i]);
		}
		if(counter > peramitors.length()){
			counter=peramitors.length()-1;
		}
		if(key_pressed(KEY_RETURN)){
			copiaragora="";
			send_reliable(peer_id, "pc "+peramitors[counter], 0); // Convertido para NVGT
		}
		if(key_pressed(KEY_HOME) and peramitors.length()>0&&cavando==0){
			counter=0;
			speak(pu.get_value(peramitors[counter]));
			copiaragora=pu.get_value(peramitors[counter]);
		}
		if(key_pressed(KEY_END) and peramitors.length()>0&&cavando==0){
			counter=peramitors.length()-1;
			speak(pu.get_value(peramitors[counter]));
			copiaragora=pu.get_value(peramitors[counter]);
		}
		if(key_pressed(KEY_UP)){
			if(peramitors.length()==1){
				counter=0;
				speak(pu.get_value(peramitors[counter]));
				copiaragora=pu.get_value(peramitors[counter]);
			}
			else if(counter > 0){
				counter--;
				speak(pu.get_value(peramitors[counter]));
				copiaragora=pu.get_value(peramitors[counter]);
			}
		}
		if(key_pressed(KEY_DOWN)){
			if(peramitors.length()==1){
				counter=0;
				speak(pu.get_value(peramitors[counter]));
				copiaragora=pu.get_value(peramitors[counter]);
			}
			else if(counter < peramitors.length()-1){
				counter++;
				speak(pu.get_value(peramitors[counter]));
				copiaragora=pu.get_value(peramitors[counter]);
			}
		}
		if(key_pressed(KEY_ESCAPE)){
			copiaragora="";
			return;
		}
	}
}

void apartamentomenu(){
	if(ausente)return;
	get_characters();
	string cl;
	int counter=0;
	string content=apartamentoinv;
	string[] peramitors=content.split("\r\n"); // Convertido para NVGT
	string[] peramitors2;
	for(uint i=0; i<peramitors.length(); i++){
		peramitors[i]=peramitors[i].split("=")[0]; // Convertido para NVGT
	}
	if(fbau==1)fbau=0;
	while(true){
		wait(5);
		// mainloop() removido - não existe em NVGT
		if(ausente||mapname=="túnel")break;
		peramitors.resize(0);
		peramitors2.resize(0);
		content=apartamentoinv;
		peramitors2=content.split("\r\n"); // Convertido para NVGT
		for(uint i=0; i<peramitors2.length(); i++){
			peramitors2[i]=peramitors2[i].split("=")[0]; // Convertido para NVGT
			int pwn=0;
			peramitors.insert_last(peramitors2[i]);
		}
		if(counter > peramitors.length())counter=peramitors.length()-1;
		if(fbau==1){
			fbau=0;
			break;
		}
		if(key_pressed(KEY_RETURN)){
			int n=string_to_number(v.input(pu.get_value("Quantos você quer pegar?")));
			if(n>apartamentoinv_item_number(peramitors[counter])||n<=0)p.play_stationary("erro.ogg", false);
			else send_reliable(peer_id, "papartamento "+peramitors[counter]+" "+n, 0); // Convertido para NVGT
		}
		if(key_pressed(KEY_HOME) and peramitors.length()>0&&cavando==0){
			counter=0;
			p.play_stationary("invclick.ogg",false);
			speak(pu.get_value(peramitors[counter])+", "+apartamentoinv_item_number(peramitors[counter]));
		}
		if(key_pressed(KEY_END) and peramitors.length()>0&&cavando==0){
			counter=peramitors.length()-1;
			p.play_stationary("invclick.ogg",false);
			speak(pu.get_value(peramitors[counter])+", "+apartamentoinv_item_number(peramitors[counter]));
		}
		if(key_pressed(KEY_UP)){
			if(peramitors.length()==1){
				counter=0;
				p.play_stationary("invclick.ogg",false);
				speak(pu.get_value(peramitors[counter])+", "+apartamentoinv_item_number(peramitors[counter]));
			}
			else if(counter > 0){
				counter--;
				p.play_stationary("invclick.ogg",false);
				speak(pu.get_value(peramitors[counter])+", "+apartamentoinv_item_number(peramitors[counter]));
			}
		}
		if(key_pressed(KEY_DOWN)){
			if(peramitors.length()==1){
				counter=0;
				p.play_stationary("invclick.ogg",false);
				speak(pu.get_value(peramitors[counter])+", "+apartamentoinv_item_number(peramitors[counter]));
			}
			else if(counter < peramitors.length()-1){
				counter++;
				p.play_stationary("invclick.ogg",false);
				speak(pu.get_value(peramitors[counter])+", "+apartamentoinv_item_number(peramitors[counter]));
			}
		}
		if(key_pressed(KEY_ESCAPE)){
			p.play_stationary("fbaú.ogg", false);
			send_reliable(peer_id, "draw fbaú.ogg", 0); // Convertido para NVGT
			send_reliable(peer_id, "fbaú", 0); // Convertido para NVGT
			return;
		}
	}
}

void readprefs(){
	string path;
	if(portable) path = PREFSFILE;
	else {
		if(!directory_exists(prefsdir)) directory_create(prefsdir);
		path = prefsdir + "\\" + PREFSFILE;
	}

	if(!file_exists(path)) {
		return;
	}

	file pref_file;
	if(!pref_file.open(path, "rb")) {
		return;
	}
	string raw = pref_file.read();
	pref_file.close();
	if(raw == "") {
		return;
	}

	string content = string_decrypt(raw, PREFS_ENCRYPTION_KEY);
	content = content.replace("\r\n", "\n");
	content = content.replace("\r", "\n");
	string[] lines = content.split("\n");
	dictionary values;
	for(uint i = 0; i < lines.length(); i++) {
		string line = trim_string(lines[i]);
		if(line == "" || line.substr(0, 1) == "#" || line.substr(0, 2) == "//") continue;
		int eq = line.find("=");
		if(eq <= 0) continue;
		string key = trim_string(line.substr(0, eq));
		string value = trim_string(line.substr(eq + 1));
		if(key == "") continue;
		values.set(key, value);
	}

	string svalue;
	if(values.get("mlang", svalue)) mainlang = svalue;
	if(values.get("ouvirhits", svalue)) ouvirhits = parse_int(svalue);
	if(values.get("ouvirpassos", svalue)) ouvirpassos = parse_int(svalue);
	if(values.get("ouviremoutrasjanelas", svalue)) ouviremoutrasjanelas = parse_int(svalue);
	if(values.get("musicamenu", svalue)) musicamenu = parse_float(svalue);
	if(values.get("idiomaorigem", svalue)) idiomaorigem = svalue;
	if(values.get("tradutorativo", svalue)) tradutorativo = parse_int(svalue);
	if(values.get("primeiravez", svalue)) primeiravez = parse_int(svalue);
	if(values.get("cmfinal", svalue)) cmfinal = svalue;
	if(values.get("idiomachat", svalue)) idiomachat = svalue;
	if(values.get("atu", svalue)) atu = parse_int(svalue);
	if(values.get("rcontrol", svalue)) rcontrol = parse_int(svalue);
	if(values.get("ouvirmortes", svalue)) ouvirmortes = parse_int(svalue);
	if(values.get("nalancha", svalue)) game_lan.nalancha = parse_int(svalue);
	if(values.get("un", svalue)) {
		un = svalue;
		net_un = svalue;
	}
	if(values.get("pw", svalue)) {
		pw = svalue;
		net_pw = svalue;
	}
	if(values.get("ttsrate", svalue)) {
		ttsrate = parse_int(svalue);
		if(game_tts.rate != ttsrate) game_tts.set_rate(ttsrate);
		if(tts.rate != ttsrate) tts.set_rate(ttsrate);
	}
	if(values.get("voice", svalue)) {
		voice = parse_int(svalue);
		if(voice >= 0) {
			if(game_tts.voice != voice) game_tts.set_voice(voice);
			if(tts.voice != voice) tts.set_voice(voice);
		}
	}
	if(values.get("wineask", svalue)) wineask = parse_int(svalue);
	if(values.get("beaconing", svalue)) beaconing = parse_int(svalue);
	if(values.get("interrupt", svalue)) interrupt = parse_int(svalue);
	if(values.get("avisadesconectou", svalue)) avisadesconectou = parse_int(svalue);
	if(values.get("usalogo", svalue)) usalogo = parse_int(svalue);
	if(values.get("numero_dispositivo", svalue)) numero_dispositivo = parse_int(svalue);
	if(values.get("atualizar", svalue)) atualizar = parse_int(svalue);
	if(values.get("volumejogo", svalue)) volumejogo = parse_float(svalue);
	if(values.get("asktoexit", svalue)) asktoexit = parse_int(svalue);
	if(values.get("avisanivel", svalue)) avisanivel = parse_int(svalue);
	if(values.get("f1", svalue)) f1 = parse_int(svalue);
	if(values.get("f2", svalue)) f2 = parse_int(svalue);
	if(values.get("f3", svalue)) f3 = parse_int(svalue);
	if(values.get("f4", svalue)) f4 = parse_int(svalue);
	if(values.get("f5", svalue)) f5 = parse_int(svalue);
	if(values.get("f6", svalue)) f6 = parse_int(svalue);
	if(values.get("f7", svalue)) f7 = parse_int(svalue);
	if(values.get("f8", svalue)) f8 = parse_int(svalue);
	if(values.get("f9", svalue)) f9 = parse_int(svalue);
	if(values.get("f0", svalue)) f0 = parse_int(svalue);
	if(values.get("voice_input_device", svalue)) voice_input_device = parse_int(svalue);
	if(values.get("sidescrolling", svalue)) sidescrolling = parse_int(svalue);
	if(values.get("autosave", svalue)) autosave = parse_int(svalue);
	if(values.get("fps", svalue)) fps = parse_int(svalue);

	if(cmfinal != "") {
		pu.set_arquivo(cmfinal);
	}
}


