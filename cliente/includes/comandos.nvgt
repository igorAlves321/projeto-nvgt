// setupmenu removida - implementação principal está em menu.nvgt


void tprincipais(){
	safeloop();
	update_ss2_stream_loop();
	travel_point_loop(); // Detectar travel points
	npc_loop(); // Gerenciar NPCs no mapa


	// Debug removido - estava consumindo os eventos key_pressed()!
	
	//  CORREÇÃO: Usar IFs independentes também no bloco COM Shift
	if(shift_pressionado()){
		// Debug foi removido - estava consumindo os eventos key_pressed()!

		// NOTA: Shift+F1 (AFK) e Shift+F2 (Pacífico) são tratados no loop principal
		// do client.nvgt para funcionar mesmo em modo ausente
		
		if(key_pressed(KEY_F3)){
			if(ouviremoutrasjanelas==1){
				speak(pu.get_value("Não anunciando mensagens quando estiver em outras janelas."));
				ouviremoutrasjanelas=0;
			}
			else if(ouviremoutrasjanelas==0){
				speak(pu.get_value("Ouvindo mensagens em outras janelas."));
				ouviremoutrasjanelas=1;
			}
			writeprefs();
		}
		if(key_pressed(KEY_SLASH)&&mapname!="quadro") send_reliable(peer_id, "whoonline", 0);
		if (key_pressed(KEY_RIGHTBRACKET))lastadd();
		if (key_pressed(KEY_LEFTBRACKET))firstadd();
		if (key_pressed(KEY_COMMA))topadditem();
		if (key_pressed(KEY_PERIOD))bottomadditem();
		if(key_pressed(KEY_EQUALS)){
			string colocar=v.input("Entre com um comando.");
			if(colocar!="") send_reliable(peer_id, "/"+colocar, 1);
		}
	}  // Fecha bloco COM Shift - controles de volume REMOVIDOS daqui

	//  CORREÇÃO: Remover else-if e usar IFs independentes
	// Isso permite que múltiplas teclas sejam detectadas no mesmo frame
	// Bloco SEM Shift - comandos de jogador (agora com IFs independentes)
	if(!shift_pressionado()) {
		if(key_pressed(KEY_F1)) {
			debug_log(" [V6-FIXED] F1 SEM SHIFT - enviando 'uptime'");
			send_reliable(peer_id, "uptime", 0);
		}
		if(key_pressed(KEY_F2)) {
			debug_log(" [V6-FIXED] F2 SEM SHIFT - enviando 'getmotd'");
			send_reliable(peer_id, "getmotd", 0);
		}
		if(key_pressed(KEY_F3)&&forcepinging==false){
			debug_log(" [V6-FIXED] F3 SEM SHIFT - ping");
			forcepinging=true;
			p.play_stationary("pingstart.ogg",false);
			ping=true;
			send_reliable(peer_id,"ping",pingchannel);
			pingtimer.restart();
		}
		if(key_pressed(KEY_F4)){
			debug_log(" [V6-FIXED] F4 SEM SHIFT - track");
			if(playertrack==""){
				// Verificar se há jogadores no mapa antes de abrir o menu
				int players_in_map = 0;
				for(uint i = 0; i < players.length(); i++) {
					if(players[i].charname == un) continue; // Pular o próprio jogador
					if(players[i].map == mapname && players[i].beeping == 1) {
						players_in_map++;
					}
				}

				if(players_in_map == 0) {
					speak(pu.get_value("Ninguém no mapa."), true);
					debug_log(" F4 Track: Nenhum jogador disponível no mapa");
				}
				else {
					playertrack=select_player(pu.get_value("Rastrear quem?"));
					if(playertrack!="") {
						speak(pu.get_value("Rastreando")+" "+playertrack);
						looping = true;  //  Ativar rastreamento contínuo
						looptimer.restart();
						debug_log("🎯 Rastreando: " + playertrack);
					}
				}
			}
			else{
				playertrack="";
				looping = false;  //  Desativar rastreamento
				speak(pu.get_value("Não rastreando."));
				debug_log("🎯 Rastreamento desativado");
			}
		}
		// F4: Rastrear jogadores no mesmo mapa (usa array local players)
		if(key_pressed(KEY_F4) && mapname != "portal_espiritual" && !ausente) {
			if(playertrack == "") {
				// Verificar se há jogadores disponíveis para rastrear
				int available_players = 0;
				for(uint i = 0; i < players.length(); i++) {
					if(players[i].charname != un && players[i].beeping == 1) {
						available_players++;
					}
				}
				
				if(available_players == 0) {
					speak(pu.get_value("Ninguém no mapa"));
				} else {
					playertrack = select_player(pu.get_value("Rastrear quem?"));
					if(playertrack != "") {
						looping = true;
						speak(pu.get_value("Rastreando") + " " + playertrack);
					}
				}
			} else {
				playertrack = "";
				looping = false;
				speak(pu.get_value("Não rastreando."));
			}
			debug_log("🎯 F4 - Rastreamento: " + playertrack);
		}
		// F5: Lista de todos os jogadores online (pede ao servidor)
		if(key_pressed(KEY_F5) && !ausente) {
			debug_log("📋 F5 - Solicitando lista de jogadores online");
			send_reliable(peer_id, "getplayers", 0);
		}
		if(key_pressed(KEY_F6)) {
			debug_log("⌨️ F6 pressionado - funcionalidade desativada");
			speak(pu.get_value("Funcionalidade desativada no momento."));
		}
		// =====  TASK 2.6: Tecla O - Ver posição do jogador rastreado =====
		if(key_pressed(KEY_O) && !ausente) {
			if(playertrack == "") {
				speak(pu.get_value("Ninguém selecionado."));
			}
			else {
				int index = get_player(playertrack);
				if(index > -1) {
					if(players[index].beeping == 0) {
						speak(pu.get_value("Este jogador não foi encontrado."));
					}
					else {
						// Falar coordenadas do jogador rastreado
						string pos_msg = playertrack + ": " + players[index].x + ", " + players[index].y;
						speak(pos_msg);
						debug_log("🎯 Posição de " + playertrack + ": " + players[index].x + ", " + players[index].y);
					}
				}
				else {
					speak(pu.get_value("Este jogador não foi encontrado."));
				}
			}
		}
		if(key_pressed(KEY_H)&&!ausente) {
			debug_log("⌨️ H pressionado - verificando relógio/hora");
			send_unreliable(peer_id, "uitem r2", 0);  // Igual ao BGT - verifica relógio
		}
		if(key_pressed(KEY_L) && moveable && !ausente) {
			checarlo();
		}
		if(key_pressed(KEY_I)&&!ausente){
			debug_log("📦 Tecla I pressionada - abrindo inventário");
			if(get_inventory_real_count() == 0) {
				speak(pu.get_value("Inventário vazio."));
			} else {
				// Evita depender de cindex/categoria corrompida e abre direto no inventário geral.
				invmenu("all");
			}
		}
		if (key_pressed(KEY_F8)){
			if (beaconing==1){
				speak(pu.get_value("Bipes desligados."));
				beaconing=0;
			}
			else if (beaconing==0){
				speak(pu.get_value("Bipes ligados."));
				beaconing=1;
			}
			writeprefs();
		}
		if (key_pressed(KEY_LEFTBRACKET))addleft();
		if(key_pressed(KEY_RIGHTBRACKET))addright();
		if(key_pressed(KEY_COMMA))prevadditem();
		if(key_pressed(KEY_PERIOD))nextadditem();
		// KEY_V, KEY_M, KEY_P, KEY_S movidos para client.nvgt (loop principal)
		if (key_pressed(KEY_BACKSLASH)){
			string colocar=v.input("Digite sua mensagem.");
			if(colocar!="") send_reliable(peer_id,"/falarnomapa "+colocar, 0); // Convertido para NVGT
		}
		if(key_pressed(KEY_SLASH)){
			string colocar=v.input("Digite sua mensagem.");
			if(colocar!=""){
				if(colocar.find("::")>-1&&desenvolvedordm==1){ // Convertido para NVGT
					string[] z=colocar.split("::"); // Convertido para NVGT
					for(uint i=0;i<z.length();i++){
						send_reliable(peer_id, z[i], 1); // Convertido para NVGT
					}
					return;
				}
				string enviar=colocar;
				if(tradutorativo==1){
					enviar=colocar;
				}
				if(enviar!="") send_reliable(peer_id, enviar, 1); // Convertido para NVGT
			}
		}
		if((key_pressed(KEY_SPACE)) && key_up(KEY_G) && moveable) {
			send_reliable(peer_id, "enter2", 0);
		}
		if((key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER)) && moveable) {
			dcheck = true;
			echeck = true;
			send_unreliable(peer_id, "enter", 0);
			send_reliable(peer_id, "INTERACT:", 0);
			if(tenter.elapsed >= 5000) {
				tenter.restart();
				send_unreliable(peer_id, "zsa " + get_zone_at(me.x, me.y), 0);
			}
			checarenter();
		}
	}
	if(dcheck) doorcheck();
	if(echeck) elevadorcheck();
	if(tempweap!=tempweap2){
		if (tempweap==0||tempweap==27){
			tempweap2=tempweap;
			current_weapon_name=tempweap+1;
			speak(pu.get_value(weapons[tempweap]));
			p.play_stationary(weapons[tempweap]+"draw.ogg",false);
			send_reliable(peer_id,"draw "+weapons[tempweap]+"draw.ogg",0); // Convertido para NVGT
		}
		else if(inv_item_exists(weapons[tempweap])&&branca(tempweap)==true&&outras==false||inv_item_exists(weapons[tempweap])&&outras==true){
			tempweap2=tempweap;
			current_weapon_name=tempweap+1;
			speak(pu.get_value(weapons[tempweap]));
			p.play_stationary(weapons[tempweap]+"draw.ogg",false);
			send_reliable(peer_id,"draw "+weapons[tempweap]+"draw.ogg",0); // Convertido para NVGT
		}
	}
}

