}

void outrosloop(){
	if(!outras&&branca(tempweap)==false||tempweap!=0&&tempweap!=27&&!inv_item_exists(weapons[tempweap])){
		tempweap=0;
	}
	if(olharx.elapsed>=3000){
		if(me.x<=0){
			me.x=1;
			send_reliable(peer_id,"move "+me.x+" "+me.y,0); // Convertido para NVGT
		}
		else if(me.x>=max.x){
			me.x=max.x-1;
			send_reliable(peer_id,"move "+me.x+" "+me.y,0); // Convertido para NVGT
		}
		else if(me.y<0){
			me.y=1;
			send_reliable(peer_id,"move "+me.x+" "+me.y,0); // Convertido para NVGT
		}
		else if(me.y>=max.y){
			me.y=max.y-2;
			send_reliable(peer_id,"move "+me.x+" "+me.y,0); // Convertido para NVGT
		}
	}
	if(echotimer.elapsed>=echotime&&echo==true){
		echocheck(facing);
	}
}


