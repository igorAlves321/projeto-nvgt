double get_number(string data){
	string numbers ="0123456789-+";
	for(uint i=0; i<data.length(); i++){
		if(string_contains(numbers, data[i], 1)<0){
			return 0;
		}
	}
	return string_to_number(data);
}

double get_number2(string data){
	string numbers ="0123456789";
	for(uint i=0; i<data.length(); i++){
		if(string_contains(numbers, data[i], 1)<0){
			return 0;
		}
	}
	return string_to_number(data);
}

void game(){
	if(!connected) {
		speak(pu.get_value("Conectando..."));
		load_map("changemap "+mapainicial);
		bool loggedin=login();
		if(loggedin) {
			set_player_info();
		}
		if(!connected && !relogin) {
			main_menu();
		}
	}
	while(true){
		wait(5);
		mainloop();
		if(!connected && relogin) {
			load_map("changemap "+mapainicial);
			bool loggedin =login();
			if(loggedin) {
				set_player_info();
				continue;
			}
		}
		if(!connected && !relogin) term =true;
		if(weapons.length()>0) weaponloop();
		if(ambientes.length()>0)ambientecheckloop();
		if(staircases.length()>0)staircasecheckloop();
		if(doors.length()>0)doorcheckloop();
		if(elevadors.length()>0)elevadorloop();
		localloop();
		if(areia_movedissas.length()>0)areia_movedissaloop();
		secundario();
		positions();
		if(have_tile_at(me.x, me.y)>-1 && jumping==0&&pulou==1&&falling==false) pulou=0;
		if(key_down(KEY_LSHIFT)&&key_down(KEY_SPACE)&&crouched==0||key_down(KEY_RSHIFT)&&key_down(KEY_SPACE)&&crouched==0){
			send_unreliable(peer_id, "crouched::on", 13);
			speak(pu.get_value("mantienes tu cuerpo agachado."));
			crouched=1;
		}
		if(key_released(KEY_LSHIFT)&&crouched==1||key_released(KEY_RSHIFT)&&crouched==1||key_released(KEY_SPACE)&&crouched==1){
			send_unreliable(peer_id, "crouched::off", 13);
			speak(pu.get_value("te levantas y mantienes una posiciï¿½n erguida otra vez."));
			crouched=0;
		}
		if(key_pressed(KEY_K) && construye==1){
			buildermenu();
		}
		if(key_down(KEY_RSHIFT)&&key_pressed(KEY_W)&&!key_down(KEY_F)||key_down(KEY_LSHIFT)&&key_pressed(KEY_W)&&!key_down(KEY_F))send_unreliable(peer_id, "nv", 0);
		if(!shift_pressionado()&&key_pressed(KEY_M))send_unreliable(peer_id, "r", 0);
		if(shift_pressionado()&&key_pressed(KEY_M))send_unreliable(peer_id, "check_items", 0);
		if(key_pressed(KEY_Z)&&desenvolvedordm==1){
			send_unreliable(peer_id, "volhar", 0);
		}
// adjust stream volume
		if(key_down(KEY_PRIOR)){
			if(tvolume.elapsed>=300 && streamvolume<10000){
				tvolume.restart();
				streamvolume+=500;
				stream.volume(streamvolume);
			}
		}
	if(key_down(KEY_NEXT)){
		if(tvolume.elapsed>=300 && streamvolume>0){
		tvolume.restart();
		streamvolume-=500;
		stream.volume(streamvolume);
		}
	}
	if(key_down(KEY_HOME)){
		if(tvolume2.elapsed>=100){
		tvolume2.restart();
		for(int x=0; x<source2s.length(); x++){
			source2s[x].change_volume(1);
		}
		}
	}
	if(key_down(KEY_END)){
		if(tvolume2.elapsed>=100){
		tvolume2.restart();
		for(int x=0; x<source2s.length(); x++){
			source2s[x].change_volume(0);
		}
		}
	}
		if(key_pressed(KEY_D)&&!ausente){
			if(desenvolvedordm==1)chat_administrativo();
			else if(modera==1)chat_administrativo();
			else if(enablechatadm==1) chat_administrativo();
		}
		if(key_pressed(KEY_E)&&key_down(KEY_G)==false&&!key_down(KEY_F)){
			if(tenter.elapsed>=90) {
				tenter.restart();
				send_unreliable(peer_id, "imenu", 0);
			}
		}
		if(alt_presionado()) {
			if(key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPADENTER)) {
				send_reliable(peer_id, "enterportal", 0);
			}
		}
		if(key_down(KEY_F)&&moveable&&tvoice.elapsed>=1000){
			if(key_pressed(KEY_1)){
tvoice.restart();
				p.play_stationary("v"+voice+"ayuda1.ogg", false);
				send_unreliable(peer_id, "frasesbarra 1 v"+voice+"ayuda1.ogg", 0);
			}
			if(key_pressed(KEY_2)){
tvoice.restart();
				send_unreliable(peer_id, "frasesbarra 2 v"+voice+"favor1.ogg", 0);
				p.play_stationary("v"+voice+"favor1.ogg", false);
			}
			if(key_pressed(KEY_UP)){
tvoice.restart();
				p.play_stationary("v"+voice+"amenaza1.ogg", false);
				send_unreliable(peer_id, "frasesbarra 3 v"+voice+"amenaza1.ogg", 0);
			}
			if(key_pressed(KEY_DOWN)){
tvoice.restart();
