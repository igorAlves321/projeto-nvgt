void uploadfile()
{
string sf=soundsmenu();
if(sf!="")
{
file fr;
fr.open("upsounds/"+sf,"rb");
send_unreliable(0,"tk_sound "+fr.read(),6);
fr.close();
}
}
void chat_administrativo(){
	string msg=v.input(pu.get_value("Digite sua mensagem."));
	if(msg!="")send_reliable(peer_id, "adm "+msg, 0);
}

void reset(){
	if(m.running) {
		m.running=false;
		m.reset(true);
	}
	ausente=false;
	dveloz=0;
	desenvolvedordm=0;
	modera=0;
	construye=0;
	nolhar="";
	falhou=0;
	pulou=0;
	bolhadear=false;
	connected =false;
	connect=false;
	term=false;
	exiting=false;
	emchat=false;
	players.resize(0);
	star=false;
	moveable=true;
	floating=false;
	floating2=false;
	jumpheight=5;
	novato=0;
	mapreset();
	audio.destroy_all();
	forcepinging=false;
	//peer_id=0;
	inv.delete_all();
	secondary_inventory.delete_all();
	reset_all_forced_keys();
	floating=false;
	floating2=false;
	cloaked=false;
	mapname="";
	items_selected.resize(0);
	v.resize();
	garbage_collect();
}

// checkloc function. Talk in real time the area when it changes when walking
void checkloc() {
	int zoneindex =get_zone_index(me.x,me.y);
	if (zoneindex>-1) {
		string locate=zones[zoneindex].text;
		if (zoneindex!=currentloc) {
			if(string_contains(locate, "*g*", 1)>-1) {
				locate =string_replace(locate, "*g*", gender, true);
			}
			if(string_contains(locate, "*nick*", 1)>-1) {
				locate =string_replace(locate, "*nick*", un, true);
			}
			if(string_contains(locate, "|", 1)>-1) speak(translate_with_char(locate, "|"));
			else speak(pu.get_value(locate));
			currentloc=zoneindex;
		}
	}
	else {
		if(zoneindex<0 && currentloc>-1) {
				speak(pu.get_value("zona desconocida."));
				currentloc=-1;
		}
	}
}

// speak_zone function. Speaks the player's current zone based on their zone indice. See get_zone_index for more details
void speak_zone() {
	string locate;
	if(currentloc>-1) {
		locate=zones[currentloc].text;
		if(string_contains(locate, "*g*", 1)>-1) {
			locate =string_replace(locate, "*g*", gender, true);
		}
		if(string_contains(locate, "*nick*", 1)>-1) {
			locate =string_replace(locate, "*nick*", un, true);
		}
		if(string_contains(locate, "|", 1)>-1) speak(translate_with_char(locate, "|"));
		else speak(pu.get_value(locate));
	}
	else {
		speak(pu.get_value("ubicaciï¿½n actual:")+" "+pu.get_value("zona desconocida")+" "+pu.get_value("de")+" "+pu.get_value(mapname));
	}
}

void track_thing(int x, int y){
	tracker.x=x;
	tracker.y=y;
}
void tell_where(int x, int y){
	if (me.x<=x){
		godir="direita";
		go=x-me.x;
	}
	else if (me.x>=x){
		godir="esquerda";
		go=me.x-x;
	}
	if (me.y<=y){
		godir2="acima";
		go2=y-me.y;
	}
	else if (me.y>=y){
		godir2="abaixo";
		go2=me.y-y;
	}
	speak(pu.get_value(godir)+" "+go+" "+pu.get_value("e")+" "+pu.get_value(godir2)+" "+go2);
}
bool stepcheck(double val){
	return true;
}
bool movecheck(double val){
	string v=val;
	v+="=";
	if (string_contains(v,".5=",1)>-1){
		return true;
	}
	else{
		return false;
	}
}
bool abletomove(){
	string locate=get_zone_at(me.x,me.y);
	if(locate=="Elevador."||dmoving||!moveable||paraquedas==1)return false;
	else if (facing==Left){
		if (string_contains(get_tile_at((me.x-1),me.y),"wall",1)>-1){
			if(cloaked==false){
				string walltype;
				string tile=get_tile_at((me.x-1),me.y);
				walltype=string_replace(tile,"wall","",true);
				if (onwall==false){
					p.play_stationary("wall"+walltype+".ogg",false);
					send_unreliable(peer_id,"draw wall"+walltype+".ogg",0);
					onwall=true;
					return false;
				}
			}
			else{
				p.play_stationary("spell_cloak_throughwall.ogg",false);
				send_unreliable(peer_id,"draw spell_cloak_throughwall.ogg",0);
				return true;
			}
		}
		else{
			onwall=false;
			return true;
		}
	}
	else if (facing==Right){
		if (string_contains(get_tile_at((me.x+1),me.y),"wall",1)>-1){
			if(cloaked==false){
				string walltype;
				string tile=get_tile_at((me.x+1),me.y);
				walltype=string_replace(tile,"wall","",true);
				if (onwall==false){
					p.play_stationary("wall"+walltype+".ogg",false);
					send_unreliable(peer_id,"draw wall"+walltype+".ogg",0);
					onwall=true;
					return false;
				}
			}
			else{
				p.play_stationary("spell_cloak_throughwall.ogg",false);
				send_unreliable(peer_id,"draw spell_cloak_throughwall.ogg",0);
				return true;
			}
		}
		else{
			onwall=false;
			return true;
		}
	}
	else if (facing==Forward){
		if (string_contains(get_tile_at(me.x,(me.y+1)),"wall",1)>-1){
			string walltype;
			string tile=get_tile_at(me.x,(me.y+1));
			walltype=string_replace(tile,"wall","",true);
			if (onwall==false){
				p.play_stationary("wall"+walltype+".ogg",false);
				send_unreliable(peer_id,"draw wall"+walltype+".ogg",0);
				onwall=true;
				return false;
			}
		}
		else{
			onwall=false;
			return true;
		}
	}
	else if (facing==Back){
		if (string_contains(get_tile_at(me.x,(me.y-1)),"wall",1)>-1){
			string walltype;
			string tile=get_tile_at(me.x,(me.y-1));
			walltype=string_replace(tile,"wall","",true);
			if (onwall==false){
				p.play_stationary("wall"+walltype+".ogg",false);
				send_unreliable(peer_id,"draw wall"+walltype+".ogg",0);
				onwall=true;
				return false;
			}
		}
		else{
			onwall=false;
			return true;
		}
	}
	return onwall ? false : true;
}

bool abletomove_direction(int direction){
	string locate=get_zone_at(me.x,me.y);
	if(locate=="Elevador."||dmoving||!moveable||paraquedas==1)return false;
	
	if (direction==Left){
		if (string_contains(get_tile_at((me.x-1),me.y),"wall",1)>-1){
			if(cloaked==false){
				string walltype;
				string tile=get_tile_at((me.x-1),me.y);
				walltype=string_replace(tile,"wall","",true);
				if (onwall==false){
					p.play_stationary("wall"+walltype+".ogg",false);
					send_unreliable(peer_id,"draw wall"+walltype+".ogg",0);
					onwall=true;
					return false;
				}
			}
			else{
				p.play_stationary("spell_cloak_throughwall.ogg",false);
				send_unreliable(peer_id,"draw spell_cloak_throughwall.ogg",0);
				return true;
			}
		}
		else{
			onwall=false;
			return true;
		}
	}
	else if (direction==Right){
		if (string_contains(get_tile_at((me.x+1),me.y),"wall",1)>-1){
			if(cloaked==false){
				string walltype;
				string tile=get_tile_at((me.x+1),me.y);
				walltype=string_replace(tile,"wall","",true);
				if (onwall==false){
					p.play_stationary("wall"+walltype+".ogg",false);
					send_unreliable(peer_id,"draw wall"+walltype+".ogg",0);
					onwall=true;
					return false;
				}
			}
			else{
				p.play_stationary("spell_cloak_throughwall.ogg",false);
				send_unreliable(peer_id,"draw spell_cloak_throughwall.ogg",0);
				return true;
			}
		}
		else{
			onwall=false;
			return true;
		}
	}
	return onwall ? false : true;
}

void checkforplatforms(){
	if (have_tile_at(me.x, me.y)>-1){
		string step;
		if(fallheight<20) {
			step =get_tile_at(me.x, me.y)+"land.ogg";
			p.play_stationary(step, false);
		}
		if(fallheight>=20) {
			step =get_tile_at(me.x, me.y)+"hardland.ogg";
			p.play_stationary(step, false);
		}
		jumping=0;
		falling=false;
		fallvelocidade=deffallvelocidade;
		send_unreliable(peer_id, "move "+step+" "+me.x+" "+me.y, 0);
		send_unreliable(peer_id, "land "+fallheight, 0);
		fallheight=0;
		canijumptimer.restart();
	}
	send_unreliable(peer_id, "move2 "+me.x+" "+me.y, 0);
}

void checkforwalls(){
	int tileindex =have_tile_at(me.x, me.y);
	if(tileindex>-1 && string_contains(platforms[tileindex].tiles, "wall", 1)>-1) {
		p.play_stationary(platforms[tileindex].tiles+".ogg", false);
		ascending=false;
		jumptimer.restart();
		atapex=true;
	}
}

void fallloop(){
	if (falltimer.elapsed>=fallvelocidade){
		falltimer.restart();
		me.y-=1;
		if (fallvelocidade>12)
		fallvelocidade-=1;
		fallheight+=1;
		checkforplatforms();
	}
}

void playcamera(){
	for (uint i=0; i<players.length(); i++){
		if (players[i].x==camera.x and players[i].y==camera.y &&players[i].beeping==1){
			p.play_extended_2d("beacon.ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
		}
	}
	if (gct()==""){
		p.play_2d("cameraair.ogg",me.x,me.y,camera.x,camera.y,false);
	}
	else if (gct()=="hazard"){
		p.play_2d("camerahazard.ogg",me.x,me.y,camera.x,camera.y,false);
	}
	else if (string_contains(gct(),"wall",1)>-1){
		p.play_extended_2d(gct()+".ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
	}
	else{
		p.play_extended_2d(gct()+"step"+random(1, 5)+".ogg", me.x, me.y, camera.x, camera.y, 0, 0, 0, 0, false, 0.0, 0.0, 0.0, 200.0);
	}
}
void playcameracustom(int x, int y){
	string gt=get_tile_at(x,y);
	if (gt==""){
		p.play_2d("cameraair.ogg",me.x,me.y,x,y,false);
	}
	else if (gt=="hazard"){
		p.play_2d("camerahazard.ogg",me.x,me.y,x,y,false);
	}
	else if (gt=="wall"){
		p.play_2d("camerawall.ogg",me.x,me.y,x,y,false);
	}
	else{
		p.play_2d("cameratile.ogg",me.x,me.y,x,y,false);
	}
}

void mainloop(){
	if(!emchat) tprincipais();
	verificando();
	if(connected)netloop();
		if(nolhar.length()>0){
			int n=get_player(nolhar);
			if(n<0) nolhar.resize(0);
		}
		olhar_x=me.x;
		olhar_y=me.y;
	checkloc();
	if (playertrack.length()>0){
		if(get_player(playertrack)<0) playertrack="";
	}
	if(get_tile_at(me.x,me.y)==""&&!falling&&!dmoving&&jumping==0&&connected&&moveable&&!floating&&!floating2)falling=true;
	if(falling&&connected)fallloop();
	if (jumping==1){
		string step;
		if (atapex and jumptimer.elapsed>=apextime){
			jumptimer.restart();
			atapex=false;
		}
		if (ascending==false and jumptimer.elapsed>=jumptime2 and atapex==false){
			jumptimer.restart();
			me.y-=1;
			if (me.y<=ty1){
				me.y=ty1;
				step =get_tile_at(me.x, me.y)+"land.ogg";
				p.play_stationary(step, false);
				send_unreliable(peer_id, "move "+step+" "+me.x+" "+me.y, 0);
				send_unreliable(peer_id,"land",0);
				jumping=0;
				canijumptimer.restart();
			}
			if (jumping!=0)
			checkforplatforms();
		}
		if (ascending and jumptimer.elapsed>=jumptime){
			jumptimer.restart();
			me.y+=1;
			send_unreliable(peer_id, "move2 "+me.x+" "+me.y, 0);
			checkforwalls();
			if (me.y>=ty2){
				ascending=false;
				jumptimer.restart();
				atapex=true;
			}
		}
	}
	if(key_down(KEY_A)&&key_pressed(KEY_UP)&&wine()){
		if (wsindex<2) speak(pu.get_value("Nenhuma voz."));
		else if (wsv<wsindex) {
			wsv++;
			if (ws.set_current_voice(wsv))
			speak(wslist[wsv]);
		}
	}
	if(key_down(KEY_A)&&key_down(KEY_RIGHT)&&wine()){
		if(ttsrate<10) {
			ttsrate++;
			ws.rate=ttsrate;
			speak(pu.get_value("Velocidade SAP:")+" "+ttsrate);
			writeprefs();
		}
	}
	if (key_down(KEY_A)&&key_pressed(KEY_DOWN)&&wine()){
		if (wsindex<2) speak(pu.get_value("Nenhuma voz."));
		else if (wsv>0) {
			wsv--;
			if (ws.set_current_voice(wsv))
			speak(wslist[wsv]);
		}
	}
	if(key_down(KEY_A)&&key_down(KEY_LEFT)&&wine()){
		if (ttsrate>-10) {
			ttsrate-=1;
			ws.rate=ttsrate;
			speak(pu.get_value("Velocidade SAP:")+" "+ttsrate);
			writeprefs();
		}
	}
	if (beaconing==1){
		looping=false;
		if(is_disabled(me.x, me.y)==false) beaconloop();
	}
	if (gpi(playertrack)==-1 and looping){
		speak("Loop off");
		looping=false;
	}
	if (looping and looptimer.elapsed>=looptime){
		looptimer.restart();
		if(is_disabled(me.x, me.y)==false) p.play_2d("beacon.ogg",me.x,me.y,players[gpi(playertrack)].x,players[gpi(playertrack)].y,false);
	}
}

void positions(){
	p.update_listener_2d(me.x, me.y);
	audio.update_listener_2d(me.x, me.y);
	sourcepool.update_listener_2d(me.x, me.y);
	source2pool.update_listener_2d(me.x, me.y);
	steps.update_listener_2d(me.x, me.y);
	shoot.update_listener_2d(me.x, me.y);
	bodys.update_listener_2d(me.x, me.y);
	walls.update_listener_2d(me.x, me.y);
	doors_sound.update_listener_2d(me.x, me.y);
	npcs.update_listener_2d(me.x, me.y);
	pl.update_listener_2d(me.x, me.y);
	if(sources.length()>0) sourcecheckloop();
	if(source2s.length()>0) source2checkloop();
}

int inter(){
	return interrupt;
}
void echocheck(int dir){
	string ptyle=get_tile_at(me.x, me.y);
	if(ptyle=="" && jumping==0 && pulou==0 && !dcheck && !echeck && moveable) {
		echotimer.restart();
		pulou=1;
		echo=false;
		send_unreliable(peer_id, "draw fall.ogg", 0);
		p.play_stationary("fall.ogg", false);
		return;
	}
}

void reiniciar(){
	writeprefs();
	if(SCRIPT_COMPILED){
		run(SCRIPT_EXECUTABLE, "reiniciar "+COMMAND_LINE, false, false);
	}
	else{
		run(SCRIPT_EXECUTABLE, SCRIPT_CURRENT_FILE, false, false);
	}
}
string ndicionario(string message){
	string[] filter;
	file f;
	f.open("palavras.txt", "r");
	filter=string_split(f.read(), "\r\n", false);
	for(int counter=0; counter<filter.length(); counter++){
		string banned=filter[counter];
		if(string_contains(string_to_lower_case(message), filter[counter], 1)>-1){
			string a;
			for( uint ii=0;ii<filter[counter].length();ii++){a+="...";}
			message=string_replace(message, filter[counter], a, true);
			return message;
		}
	}
	return message;
}
