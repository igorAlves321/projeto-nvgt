// Teste simples de carregamento de som
#include "../config.nvgt"

void main() {
    alert("Teste", "Testando carregamento de sons");
    
    sound s;
    
    // Teste 1: Carregar sem prefixo
    bool test1 = s.load("turn.ogg");
    if(test1) {
        alert("Sucesso", "turn.ogg carregado sem prefixo!");
    } else {
        alert("Erro", "turn.ogg NÃO encontrado sem prefixo");
    }
    
    s.close();
    
    // Teste 2: Carregar com prefixo
    bool test2 = s.load("sounds/turn.ogg");
    if(test2) {
        alert("Sucesso", "sounds/turn.ogg carregado COM prefixo!");
    } else {
        alert("Erro", "sounds/turn.ogg NÃO encontrado com prefixo");
    }
    
    alert("Fim", "Testes concluídos");
}
