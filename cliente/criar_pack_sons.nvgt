
#include "bgt_compat.nvgt"

void main() {
	pack pfile;
	string filename = "sounds_novo.dat";
	string foldername = "sounds";

	show_game_window("Criando pack de sons...");

	if(!directory_exists(foldername)) {
		alert("Erro", "A pasta 'sounds' não existe!");
		return;
	}

	if(!pfile.open(filename, PACK_OPEN_MODE_CREATE)) {
		alert("Erro", "Falha ao criar o arquivo " + filename + "!");
		return;
	}

	string[] arquivos_para_adicionar;
	buscar_arquivos_recursivo(foldername, arquivos_para_adicionar);

	alert("Pack Creator", "Encontrados " + arquivos_para_adicionar.length() + " arquivos para adicionar. Pressione OK para começar.");

	for(uint i = 0; i < arquivos_para_adicionar.length(); i++) {
		if(i % 100 == 0) {
			show_game_window("Adicionando arquivo " + i + " de " + arquivos_para_adicionar.length() + "...");
			wait(1);
		}

		string nome_interno = string_replace(arquivos_para_adicionar[i], foldername + "/", "", true);
		pfile.add_file(arquivos_para_adicionar[i], nome_interno);
	}

	pfile.close();

	alert("Sucesso!", "Pack criado com " + arquivos_para_adicionar.length() + " arquivos!\n\n" +
	      "Arquivo: " + filename + "\n" +
	      "Agora renomeie 'sounds_novo.dat' para 'sounds.dat' (apague o antigo primeiro)");
}

void buscar_arquivos_recursivo(string pasta, string[]@ resultado) {
	string[] subpastas = find_directories(pasta + "/*");

	string[] arquivos = find_files(pasta + "/*.*");
	for(uint i = 0; i < arquivos.length(); i++) {
		resultado.insert_last(pasta + "/" + arquivos[i]);
	}

	for(uint i = 0; i < subpastas.length(); i++) {
		buscar_arquivos_recursivo(pasta + "/" + subpastas[i], resultado);
	}
}
