pack_file sounds;
file log;
string package;
const string title ="Package read";
void main(){
	string data;
	int counter =0;
	string[] list;
	show_game_window(title);
	while(true){
		wait(5);
		if(key_down(KEY_LMENU) && key_pressed(KEY_F4)){
			exit();
		}
		if(key_pressed(KEY_RETURN)){
			package =input_box("Package", "Enter the package to read:", "");

				if(package ==""){
				alert("Info", "Pleace specify the file package.");
				continue;
			}
			if(file_exists(package)){
				sounds.open(package);
				list =sounds.list_files();
				sounds.close();
			}
			else{
				alert("Info", "The package file does not exist.");
			}
		}
		if(list.length()>0){
			for(int x=0; x<list.length(); x++){
				data +=list[x]+"\r\n";
				counter++;
			}
		}
		if(counter>0){
			log.open("sounds.log", "w");
			log.write(data);
			log.close();
			alert("Info", "The package was read and stored correctly.");
			main();
		}
	}
	alert("Info", "Teh package file does not content files.");
	}
