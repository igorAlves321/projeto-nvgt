dictionary@ db;
file configs;
void main(){
string[]f=find_directories("players/*");
for(uint i=0; i<f.length(); i++){
configs.open("players/"+f[i]+"/configs.ini", "rb");
@db=deserialize(configs.read());
configs.close();
if(db.exists("dalison2")){
db.set("dalison2", "");
}
if(db.exists("dueno")){
db.set("dueno", "");
}
if(db.exists("dueno2")){
db.set("dueno2", "");
}
configs.open("players/"+f[i]+"/configs.ini", "wb");
configs.write(serialize(db));
configs.close();
}
}