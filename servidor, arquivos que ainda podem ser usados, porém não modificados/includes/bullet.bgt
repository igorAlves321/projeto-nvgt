class bullet{

	int distance;

	string owner, somarma, mapname, loopsound;

	int sx, sy, weapon, x, y, facing, range, damage, speed;

timer speedtimer;

	bullet(int d, int r, int s1, int s2, int fa, string own, int weap, string map, int spee=3, string sarm="", string lsound=""){

		this.speed=spee;

		mapname=map;

		facing=fa;

		sx=s1;

		sy=s2;

		x=s1;

		y=s2;
		damage=d;

		range=r;

		owner=own;

		weapon=weap;

		somarma=sarm;

	}

}


void spawn_bullet(int p1, int p2, int p3, int p4, int p5, string p6, int p7, string p8, int p9=20, string p11="", string p10=""){

	int mapindex =get_map_index_from(p8);

	if(mapindex>-1) {

		bullet b1(p1,p2,p3,p4,p5,p6,p7,p8,p9,p11, p10);

		server_maps[mapindex].bullets.insert_last(b1);

	}

}

