void create(string un, string pw, string eml, int sexo, string idd, int index, int id=event.peer_id){
	bool cont=true;
	string charfolder="players/"+un;
	if(tempbancheck(un, idd)){
		send_reliable(id,"block Este usuario o dispositivo ha sido baneado.", 0);
		cont=false;
		return;
	}
	if(is_incorrect(un) or un.length()<3 or un.length()>20){
		send_reliable(id,"Error: Intente escribir otro nombre de usuario.",0);
		cont=false;
		return;
	}
	if(get_accounts(un)>0) {
		send_reliable(id,"Error: Esta cuenta ya existe en la base de datos.",0);
		cont=false;
		return;
	}
	if (pw.length()<8 or !contains_num(pw) or !contains_let(pw)) {
		send_reliable(id,"Error: La contraseña no es válida, pruebe a escribir una diferente con un mínimo de 8 caracteres, entre letras y números.", 0);
		cont=false;
		return;
	}
	if(have_acount(idd)){
		send_reliable(id, "Error: no puedes tener más de 2 cuentas registradas en este servidor.", 0);
		cont=false;
		return;
	}
	else {
		if(cont==true){
			directory_create(charfolder);
			file f;
			f.open(charfolder+"/email.usr","w");
			f.write(eml);
			f.close();
			f.open(charfolder+"/status.usr","w");
			f.write("hola!");
			f.close();
			f.open(charfolder+"/compid.usr", "w");
			f.write(idd);
			f.close();
			f.open(charfolder+"/senha.usr","w");
			f.write(pw);
			f.close();
			file inv;
			inv.open("inv.inv","r");
			string[] d_inv=string_split(inv.read(), "\r\n", false);
			inv.close();
			f.open(charfolder+"/inv.md","w");
			f.write(linear(d_inv));
			f.close();
			dictionary sd;
			int x=1, y=0, health=5000;
			sd.set("x", x);
			sd.set("y", y);
			sd.set("sexo", sexo);
			sd.set("map", "el_inicio");
			sd.set("health", health);
			file pf;
			pf.open(charfolder+"/configs.ini", "wb");
			pf.write(serialize(sd));
			pf.close();
			send_reliable(id,"created",0);
			eadm("La cuenta"+" "+un+" "+"ha sido creada desde la dirección IP:"+" "+net.get_peer_address(id));
		}
	}
}
