class earthquake {
	int range_x, range_y, earthquake_sound;
	string owner;
	timer duration, damagetimer;
	bool active;
	string map, locate;
	earthquake(string owner, int range_x, int range_y, string map) {
		this.range_x =range_x;
		this.range_y =range_y;
		this.owner =owner;
		this.active =true;
		this.map =map;
		this.earthquake_sound =spawn_moving_sound("rumble.ogg", this.range_x, this.range_y, this.map);
		this.locate =get_locate_at(this.map);
		if(locate=="") locate ="en"+" "+this.map;
		send_reliable(0, "msg2 ;un terremoto devastador está haciendo estragos; "+locate, 0);
	}
} // end class earthquake

void create_earthquake(string owner, int range_x, int range_y, string map) {
	int mapindex =get_map_index_from(map);
	int index =get_player_index_from(owner);
	if(mapindex>-1) {
		earthquake earthquake1(players[index].charname, range_x, range_y, map);
		server_maps[mapindex].earthquakes.insert_last(earthquake1);
	}
}
