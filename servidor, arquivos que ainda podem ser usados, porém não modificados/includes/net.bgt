void netloop(){
	event=net.request();
	if(event.type==0) return;
	if(event.type==event_disconnect){
		int index=get_player_index(event.peer_id);
		if(index>-1){
			if(ar.is_open==1){
				ar.remove_player_from(index);
			}
			if(players[index].invs==0 && !players[index].is_admin()) {
				send_reliable(0, "msgconexoes "+players[index].charname+" ;ha perdido la conexi?n con esta dimensi?n.", 0);
			}
				colocar_tempocair(players[index].charname);
			terminar(index, 0, 1, true);
		}
	}
else if(event.type==event_receive&&event.channel==16){
int index=get_player_index(event.peer_id);
string[]parsed=string_split(get_event_message(), " ", false);
if(index>-1){
if(parsed[0]=="update_lang_file"&&parsed.length()>1){
string langfile=string_replace(parsed[1], ".lang", "", true);
double new_ver=manage_langs_version(langfile);
for(int x=0; x<players.length(); x++){
if(players[x].idiomajogo==langfile&&players[x].peer_id!=players[index].peer_id){
send_reliable(players[x].peer_id, "set_lang_file lang/"+parsed[1], 0);
send_reliable(players[x].peer_id, "msg2 ;La informaci?n de idioma fue actualizada.;", 0);
players[x].manage_my_langs_version(langfile, new_ver);
}
}
send_reliable(players[index].peer_id, "msg2 ;?Archivo de idioma actualizado correctamente! Ser? enviado a todos los jugadores conectados.;", 0);
eadm(players[index].charname+" lanz? una nueva actualizaci?n del idioma "+langfile+".", "notify5.ogg", 150);
writeprefs();
}
}
}

if(event.type==event_receive&&event.channel==14){
string[] parsed=string_split(get_event_message(), " ", true);
int index=get_player_index(event.peer_id);
if(index>-1){
if(parsed[0]=="tiendasgeneral"){
file f;
f.open("tiendas/"+parsed[1]+".txt", "r");
string content=f.read();
f.close();
send_reliable(players[index].peer_id, "open_store "+content, 0);
}
else if(parsed[0]=="manage_stores"){
string content, final;
string[] lines, files;
file f;
f.open("items_for_sale.db", "r");
content=f.read();
f.close();
lines=delinear(content);
for(int x=0; x<lines.length(); x++){
final+=lines[x]+"\r\n";
}
files=find_files("tiendas/*.txt");
final+="|\r\n";
for(int x=0; x<files.length(); x++){
final+=string_replace(files[x], ".txt", "", true)+"\r\n";
}
send_reliable(players[index].peer_id, "manage_stores "+final, 0);
}
else if(parsed[0]=="replace_item_for_sale"&&parsed.length()>1){
file f;
string content=string_replace(get_event_message(), parsed[0]+" ", "", true);
string[] lines, data=string_split(content, "|", true);
f.open("items_for_sale.db", "r");
lines=delinear(f.read());
f.close();
int find=lines.find(data[1]);
if(find>-1&&lines[find]!=data[0]){
lines[find]=data[0];
f.open("items_for_sale.db", "w");
f.write(linear(lines));
f.close();
load_items_for_sale(true);
string[] name=string_split(lines[find], "=", false);
eadm(players[index].charname+" ;reemplaz? los valores del item llamado; "+name[0]+". ;Favor de revisar para comprobar que est? bien.;", "notify5.ogg", 150);
}
}
else if(parsed[0]=="remove_item_for_sale"&&parsed.length()>1){
file f;
int sindex=item_exists_for_sale(parsed[1]);
if(sindex>-1&&players[index].is_admin()){
items_sale.remove_at(sindex);
save_items_for_sale();
load_items_for_sale(true);
eadm(players[index].charname+" ;elimin? de los objetos a la venta el siguiente item:; "+parsed[1]+".", "notify5.ogg", 150);
}
if(items_sale.length()==0){
items_sale.resize(0);
f.open("items_for_sale.db", "w");
f.write("");
f.close();
}
}
else if(parsed[0]=="show_store"&&parsed.length()>1){
if(!file_exists("tiendas/"+parsed[1]+".txt")){
send_reliable(players[index].peer_id, "msg2 ;tienda inexistente.;", 0);
return;
}
else{
file f;
f.open("tiendas/"+parsed[1]+".txt", "r");
string content=f.read();
f.close();
send_reliable(players[index].peer_id, "show_store "+parsed[1]+" "+content, 0);
}
}
else if(parsed[0]=="delete_store"&&parsed.length()>1){
if(!file_exists("tiendas/"+parsed[1]+".txt")){
send_reliable(players[index].peer_id, "msg2 ;tienda inexistente.;", 0);
return;
}
else{
file_delete("tiendas/"+parsed[1]+".txt");
eadm(players[index].charname+" ;elimin? del servidor la tienda llamada; "+parsed[1]+".", "notify5.ogg", 150);
}
}
else if(parsed[0]=="remove_item_on_store"&&parsed.length()>2){
if(!file_exists("tiendas/"+parsed[1]+".txt")){
send_reliable(players[index].peer_id, "msg2 ;tienda inexistente.;", 0);
return;
}
else{
file f;
f.open("tiendas/"+parsed[1]+".txt", "r");
string content=f.read();
f.close();
string[] lines=delinear(content);
int find=lines.find(parsed[2]);
if(find>-1){
lines.remove_at(find);
f.open("tiendas/"+parsed[1]+".txt", "w");
f.write(linear(lines));
f.close();
eadm(players[index].charname+" ;elimin? el item; "+parsed[2]+" ;de la tienda llamada; "+parsed[1]+".", "notify5.ogg", 150);
}
else{
send_reliable(players[index].peer_id, "msg2 ;item inexistente en esta tienda.;", 0);
return;
}
}
}
else if(parsed[0]=="replace_item_on_store"&&parsed.length()>2){
int sindex=string_to_number(parsed[3]);
if(!file_exists("tiendas/"+parsed[1]+".txt")){
send_reliable(players[index].peer_id, "msg2 ;tienda inexistente.;", 0);
return;
}
else{
file f;
f.open("tiendas/"+parsed[1]+".txt", "r");
string content=f.read();
f.close();
string[] lines=delinear(content);
if(lines[sindex]==parsed[2]){
send_reliable(players[index].peer_id, "msg2 ;este item ya existe.;", 0);
return;
}
else{
string previous_item=lines[sindex];
lines.remove_at(sindex);
lines.insert_at(sindex, parsed[2]);
f.open("tiendas/"+parsed[1]+".txt", "w");
f.write(linear(lines));
f.close();
eadm(players[index].charname+" ;reemplaz? el item; "+previous_item+" ;por el item llamado; "+parsed[2]+", ;en la tienda llamada; "+parsed[1]+".", "notify5.ogg", 150);
}
}
}
else if(parsed[0]=="add_item_to_store"&&parsed.length()>2){
if(!file_exists("tiendas/"+parsed[1]+".txt")){
send_reliable(players[index].peer_id, "msg2 ;tienda inexistente.;", 0);
return;
}
else{
file f;
f.open("tiendas/"+parsed[1]+".txt", "r");
string content=f.read();
f.close();
string[] lines=delinear(content);
int find=lines.find(parsed[2]);
if(find>-1){
send_reliable(players[index].peer_id, "msg2 ;este item ya existe en esta tienda.;", 0);
return;
}
else{
lines.insert_last(parsed[2]);
f.open("tiendas/"+parsed[1]+".txt", "w");
f.write(linear(lines));
f.close();
eadm(players[index].charname+" ;a?adi? el item; "+parsed[2]+" ;a la tienda llamada; "+parsed[1]+".", "notify5.ogg", 150);
}
}
}
else if(parsed[0]=="add_item_for_sale"&&parsed.length()>4){
bool exists;
string itemname=parsed[1], money=parsed[2], description=string_replace(get_event_message(), parsed[0]+" "+parsed[1]+" "+parsed[2]+" "+parsed[3]+" "+parsed[4]+" ", "", true);
double price=string_to_number(parsed[3]);
int id=string_to_number(parsed[4]);
if(id<1000||id>9999) return;
file f;
f.open("items_for_sale.db", "r");
string content=f.read();
f.close();
string[] lines=delinear(content);
for(int x=0; x<lines.length(); x++){
string[] data=string_split(lines[x], "=", true);
if(data.length()>4&&id==data[4]){
send_reliable(players[index].peer_id, "msg2 ;este item ya existe.;", 0);
exists=true;
return;
}
else{
exists=false;
}
}
if(exists==false){
lines.insert_last(itemname+"="+money+"="+price+"="+description+"="+id);
f.open("items_for_sale.db", "w");
f.write(linear(lines));
f.close();
load_items_for_sale(true);
eadm(players[index].charname+" ;a?adi? a los objetos a la venta el item llamado; "+itemname+". para m?s informaci?n, consultar el men? de gesti?n de objetos a la venta en el servidor.", "notify5.ogg", 150);
}
}
else if(parsed[0]=="create_store"&&parsed.length()>1){
if(file_exists("tiendas/"+parsed[1]+".txt")){
send_reliable(players[index].peer_id, "msg2 ;esta tienda ya existe.;", 0);
return;
}
else{
file f;
f.open("tiendas/"+parsed[1]+".txt", "w");
f.write("");
f.close();
eadm(players[index].charname+" ;cre? la tienda llamada; "+parsed[1]+". ;actualmente est? sin contenido, para a?adir items vaya al men? de gesti?n de tiendas.;", "notify5.ogg", 150);
}
}
else if(parsed[0]=="buy"&&parsed.length()>2){
double value=string_to_number(parsed[1]);
int id=string_to_number(parsed[2]);
int sindex=item_exists_for_sale(id);
if(value<=0){
return;
}
if(sindex>-1){
bool success=items_sale[sindex].buy(index, value);
if(!success){
send_reliable(players[index].peer_id, "msg2 ;no tienes dinero suficiente.;", 0);
}
else{
send_packet(0, "play buy.ogg", players[index].x, players[index].y, players[index].mapindex);
}
}
}
else if(parsed[0]=="check_price"&&parsed.length()>1){
int sindex=item_exists_for_sale(string_to_number(parsed[1]));
if(sindex>-1){
send_reliable(players[index].peer_id, "msg2 ;el precio de este art?culo es de; "+items_sale[sindex].price+" ;"+items_sale[sindex].money+".;", 0);
}
}
else if(parsed[0]=="check_desc"&&parsed.length()>1){
int sindex=item_exists_for_sale(string_to_number(parsed[1]));
if(sindex>-1){
send_reliable(players[index].peer_id, "msg2 ;"+items_sale[sindex].description+";", 0);
}
}

}
}

	else if(event.type==event_receive and event.channel==0){
		int index=get_player_index(event.peer_id);
		string[] parsed=string_split(get_event_message()," ",true);
		if(parsed[0]=="xt55"&&parsed.length()>5)create(parsed[1],parsed[2],parsed[3], string_to_number(parsed[4]), parsed[5], event.peer_id);
		else if(parsed[0]=="h33j"&&parsed.length()>4)login(event.peer_id, parsed[1],parsed[2], parsed[3],parsed[4]);
		if(index>-1&&index<players.length){
if(parsed[0]=="setgender"){
send_reliable(players[index].peer_id, "gender "+players[index].sexo2, 6);
}
		else if(parsed[0]=="close" && parsed.length()==2){
			if(parsed[1]=="terminate") {
				send_reliable(players[index].peer_id, "terminate ok", 0);
			}
			if(parsed[1]=="relogin") {
				send_reliable(players[index].peer_id, "terminate relogin", 0);
			}
			players[index].matou=0;
			if(players[index].healthfixed>=1){
				players[index].maxhealth=players[index].saludfangelical;
				players[index].health=players[index].saludfangelical;
				players[index].nbaculo=players[index].baculofangelical;
			}
			else{
				players[index].maxhealth=10000;
				players[index].health=10000;
				players[index].nbaculo=0;
			} 
			if(players[index].invs==1 && players[index].is_admin()) {
				terminar(index, 0, 1);
			}
			else {
				terminar(index, 1, 1);
			}
		}
			else if(parsed[0]=="get_player_info")get_player_info(index);
			else if(parsed[0]=="/changepassword"&&parsed.length>2) change_password(players[index].charname,parsed[1],parsed[2],event.peer_id);
			else if(parsed[0]=="ping")send_reliable(event.peer_id,"pong",0);
			else if(parsed[0]=="uitem"&&parsed.length()>1&&players[index].afk==false&&players[index].paralisado==false&&players[index].paralisado2==false&&gamestopped==false&&players[index].map!="t?nel")usar(index, parsed[1]);
			else if(parsed[0]=="retirar"&&parsed.length()>1)retirar(index, parsed[1]);
			else if(parsed[0]=="/vestindo"){
				if(players[index].w_name.length()>0){
					int index2=get_player_index_from(players[index].w_name);
					if(index2>-1) vestindo(index2, index);
				}
				else vestindo(index);
			}
	else if(parsed[0] =="sortinv" && parsed.length()==3) {
		players[index].sort_inv(parsed[1], string_to_number(parsed[2]));
	}
else if(parsed[0]=="is_married"){
if(players[index].whomarried==""){
send_reliable(players[index].peer_id, "is_married soltero", 0);
}
else if(players[index].whomarried!=""){
send_reliable(players[index].peer_id, "is_married casado "+players[index].whomarried, 0);
}
}
else if(parsed[0]=="parabatai"&&parsed.length()>1){
string[] soundsmenu={"ma208.ogg", "ma205.ogg", "ma147.ogg"};
if(parsed[1]=="check"&&players[index].whoparabatai.length()==0){
if(parabataying){
send_reliable(players[index].peer_id, "msg2 ;no puedes hacer esto.;", 0);
return;
}
else{
if(server_maps[players[index].mapindex].mapplayers.length()==1){
send_reliable(players[index].peer_id, "msg2 ;L?stima que este ritual no funcione de manera solitaria...;", 0);
return;
}
string[] final;
for(int x=0; x<server_maps[players[index].mapindex].mapplayers.length(); x++){
if(players[server_maps[players[index].mapindex].mapplayers[x]].charname!=players[index].charname&&players[server_maps[players[index].mapindex].mapplayers[x]].whoparabatai.length()==0&&!players[server_maps[players[index].mapindex].mapplayers[x]].parabataying&&players[server_maps[players[index].mapindex].mapplayers[x]].charname!=players[index].whomarried){
final.insert_last(players[server_maps[players[index].mapindex].mapplayers[x]].charname+"="+players[server_maps[players[index].mapindex].mapplayers[x]].charname);
}
}
server_maps[players[index].mapindex].send_packet(0, "play ma169.ogg", players[index].x, players[index].y);
server_maps[players[index].mapindex].send_packet(0, "msg2 ;La luz que estaba en el altar, ahora se intensifica con gran fuerza iluminando a todos los que se encuentran a tu lado.;", true);
send_menu(index, "La luz invade tus retinas, grabando algunos nombres en ellas...", "parabatai send_to", 0, final, soundsmenu);
}
}
if(parsed[1]=="send_to"&&parsed.length()>2){
int index2=get_player_index_from(parsed[2]);
if(index2>-1){
string[] optionitems={"S?.=si::"+players[index].charname, "No.=no"};
send_menu(index2, ";La luz que se encuentra en el altar cambia de un color amarillo a un p?rpura intenso rode?ndote por completo. En tu mente se graba el nombre de; "+players[index].charname+" ;mientras solo piensas una cosa: Aceptar o rechazar.;", "parabatai confirm", 0, optionitems, soundsmenu);
}
}
if(parsed[1]=="confirm"&&parsed.length()>2){
if(parsed[2]=="no"){
server_maps[players[index].mapindex].send_packet(0, "ps ma171.ogg", true);
server_maps[players[index].mapindex].send_packet(0, "msg2 ;Una gran presencia expresa su desaprobaci?n por la negativa...;", true);
}
else{
string[] data=string_split(parsed[2], "::", true);
if(data[0]=="si"&&data.length()>1){
int index2=get_player_index_from(data[1]);
if(index2>-1){
tparabatai.restart();
send_reliable(0, "msg2 ;?Dentro de unos momentos el pacto por los 4 elementos entre; "+players[index].charname+" ;y; "+players[index2].charname+" ;est? a punto de realizarse!;", 0);
players[index].parabataying=true;
players[index2].parabataying=true;
w2=players[index].charname;
h2=players[index2].charname;
parabataying=true;
}
}
}
}
}
		else if(parsed[0] =="parabatai_remove" && parsed.length()==2) {
			if(parsed[1] =="send_question") {
				parabatai_confirm_remove(players[index].charname, players[index].whoparabatai);
			}
			if(parsed[1] =="confirm_parabatai_remove") {
				parabatai_remove(players[index].whoparabatai, players[index].charname);
			}
			if(parsed[1] =="decline_parabatai_remove") {
				server_maps[players[index].mapindex].send_packet(0, "msg2 "+players[index].charname+" "+";no acepta la disoluci?n de la sagrada uni?n con;"+" "+players[index].whoparabatai, true);
			}
		}
else if(parsed[0]=="confirmmarried"&&parsed.length()>=2){
int index2=get_player_index_from(parsed[1]);
int index3=get_player_index_from(parsed[2]);
if(index2>-1&&index3>-1){
if(players[index2].marring==true||players[index3].marring==true){
return;
}
else{
send_reliable(players[index2].peer_id, "confirm "+players[index3].charname, 0);
}
}
}
else if(parsed[0]=="marry"&&parsed.length()>=2){
int index2=get_player_index_from(parsed[1]);
int index3=get_player_index_from(parsed[2]);
if(index2>-1&&index3>-1){
if(players[index2].marring==true||players[index3].marring==true||players[index2].whomarried!=""||players[index3].whomarried!=""){
return;
}
else{
tmarried.restart();
send_reliable(0, "msg2 Dentro de un momento la boda de "+players[index2].charname+" y "+players[index3].charname+" se llevar? a cabo.", 0);
players[index2].marring=true;
players[index3].marring=true;
w=players[index2].charname;
h=players[index3].charname;
wedding=true;
}
}
}
else if(parsed[0]=="divorc"&&parsed.length()>=1){
int index2=get_player_index_from(parsed[1]);
if(index2>-1){
send_reliable(players[index2].peer_id, "confirmdivorc "+players[index2].whomarried, 0);
}
}else if(parsed[0]=="divorce"&&parsed.length()>2){
int index2=get_player_index_from(parsed[1]);
int index3=get_player_index_from(parsed[2]);
if(index2>-1&&index3>-1){
players[index2].whomarried="";
players[index3].whomarried="";
players[index2].saludfangelical-=3000;
players[index3].saludfangelical-=3000;
players[index2].inv_add_item("runa_dorada", -1);
players[index3].inv_add_item("runa_dorada", -1);
sconfigs(index2);
sconfigs(index3);
send_reliable(players[index2].peer_id, "amarried", 0);
send_reliable(players[index3].peer_id, "amarried", 0);
for(uint i=0; i<players.length(); i++){
if(players[i].map==players[index2].map||players[i].map==players[index3].map){
send_reliable(players[i].peer_id, "msg2 desde ahora han dejado la gracia del matrimonio para convertirse en personas solteras de nuevo. pueden ir en paz.", 0);
}
}
}
}
				else if(parsed[0]=="change_name"&&parsed.length()>1){
					string name=parsed[1];
					if(players[index].validated_name!=""){
						send_reliable(players[index].peer_id, "msg2 ;Paciencia, ya tienes un nombre en proceso de ser validado.;", 0);
						return;
					}
					validate_nick(index, name);
				}
				else if(parsed[0]=="dejarmensaje" and parsed.length > 2){
					if(file_exists("players/"+players[index].charname+"/silencio.usr") || players[index].map=="pris?o2"){
						return;
				}
					int index2=get_player_index_from(parsed[1]);
					if(index2>-1){
						if(players[index2].has_muted(players[index].charname)==false){
							if(players[index2].map=="tribunal"||players[index2].map=="pris?o2"){send_reliable(players[index].peer_id, "msgdepois "+players[index2].charname+" n?o pode te ouvir.", 0);return;}
	if(file_exists("players/"+players[index2].charname+"/silencio.usr")){send_reliable(players[index2].peer_id, "msgnormal Hmm. alguien te est? intentando mandar un mensaje. por qu? no le respondes?", 0);return;}
							send_reliable(players[index2].peer_id, "mensaje de "+players[index].charname+": "+string_replace(get_event_message(), "dejarmensaje "+parsed[1]+" ", "", false), 0);
							send_reliable(event.peer_id, "mensaje para "+players[index2].charname+": "+string_replace(get_event_message(), "dejarmensaje "+parsed[1]+" ", "", false), 0);
						}
						else return;
					}
					else{
						send_reliable(event.peer_id, "msgjogadorn?oencontrado", 0);
					}
			}
else if(parsed[0]=="craft"&&parsed.length()>2){
if(parsed[1]=="pergamino_de_fuego"&&parsed[2]=="pluma_de_diamante"||parsed[1]=="pluma_de_diamante"&&parsed[2]=="pergamino_de_fuego"&&(players[index].inv_item_number("pluma_de_diamante")>0&&players[index].inv_item_number("pergamino_de_fuego")>0)){
send_reliable(players[index].peer_id, "mtext ;Escribe un t?tulo con el que los adms puedan identificar tu mensaje.;|invocation title| |0", 0);
}
else if(players[index].c.craft_exists(parsed[1], parsed[2])){
players[index].c.craft(parsed[1], parsed[2], index);
}
}
	else if(parsed[0] =="getplayers") {
		getplayers(index);
	}
else if(parsed[0]=="invocation"&&parsed.length()>1){
if(parsed[1]=="title"&&parsed.length()>2){
