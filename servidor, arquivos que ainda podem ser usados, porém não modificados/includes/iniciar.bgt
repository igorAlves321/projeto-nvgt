// función de inicio de servidor
void iniciar() {
	dictionary@ configs;
//	set_error_output("errors.log");
	//start_profiling();
	if(directory_exists("players")==false)directory_create("players");
	if(directory_exists("players2")==false)directory_create("players2");
	if(directory_exists("lanchas")==false)directory_create("lanchas");
	if(!directory_exists("logs"))directory_create("logs");
	if(directory_exists("carros")==false)directory_create("carros");
	if(directory_exists("tanques")==false)directory_create("tanques");
	if(directory_exists("motos")==false)directory_create("motos");
	tvaviao.force(0);
	tvaviao.pause();
desc.reserve(10000);
picos.reserve(1);
	cachorromascotas.reserve(1000);
	server_maps.reserve(4096);
	players.reserve(1000);
	load_items_for_sale();
	load_items();
	load_weapons();
	load_gifts();
load_clothes();
load_all_tempbans();
load_secondary_inventory();
cargarjaulas();
cargarcachorromascotas();
	file pr;
	if(file_exists("servidor.descs")){
		pr.open("servidor.descs","r");
		desc=delinear(pr.read());
		pr.close();
	}
	pr.open("servidor.msgadm", "r");
	msgadm=string_split(pr.read(), bell, false);
	pr.close();
	mapainicial="portal_espiritual";
	if(file_exists("excluded_items.txt")) {
		pr.open("excluded_items.txt", "r");
		excluded_items =delinear(pr.read());
		pr.close();
	}
	if(file_exists("channels.txt")) {
		string[] lines;
		pr.open("channels.txt", "r");
		lines =delinear(pr.read());
		pr.close();
		for(int i=0; i<lines.length(); i++) {
			string[] parsed=string_split(lines[i], "=", true);
			if(parsed.length()==2) channels.set(parsed[1], parsed[0]);
		}
	}
	pr.open("servidor.configs", "rb");
	@configs =deserialize(pr.read());
	pr.close();
	if(configs.exists("minuto")) {
		configs.get("minuto", minuto);
	}
	if(configs.exists("hora")) {
		configs.get("hora", hora);
	}
	if(configs.exists("day")) {
		configs.get("day", day);
	}
	if(configs.exists("month")) {
		configs.get("month", month);
	}
	if(configs.exists("year")) {
		configs.get("year", year);
	}
	if(configs.exists("timetime")) {
		configs.get("timetime", timetime);
	}
	if(configs.exists("objtime")) {
		configs.get("objtime", objtime);
	}
	if(configs.exists("peak")) {
		configs.get("peak", peak);
	}
	if(configs.exists("msalvar")) {
		configs.get("msalvar", msalvar);
	}
	if(configs.exists("islands")) {
		configs.get("islands", islands);
	}
	if(configs.exists("lang_es_v")) {
		configs.get("lang_es_v", lang_es_v);
	}
	if(configs.exists("lang_en_v")) {
		configs.get("lang_en_v", lang_en_v);
	}
	if(configs.exists("lang_fr_v")) {
		configs.get("lang_fr_v", lang_fr_v);
	}
	if(configs.exists("lang_pt_v")) {
		configs.get("lang_pt_v", lang_pt_v);
	}
	if(configs.exists("enable_auto_xp")) {
		configs.get("enable_auto_xp", enable_auto_xp);
	}
	if(configs.exists("enable_double_emeralds")) {
		configs.get("enable_double_emeralds", enable_double_emeralds);
	}
	if(configs.exists("gold")) {
		configs.get("gold", gold);
	}
	if(configs.exists("enable_auto_raffle")) {
		configs.get("enable_auto_raffle", enable_auto_raffle);
		if(enable_auto_raffle ==0) {
			timer_raffle.force(0);
			timer_raffle.pause();
		}
	}
	if(file_exists("mensagemaes.txt")){
		pr.open("mensagemaes.txt","r");
		msgaes=pr.read();
		pr.close();
	}
	net.setup_server(port, 20, 500);
	net.set_bandwidth_limits(0, 0);
	if(!directory_exists("maps")){
		directory_create("maps");
	}
	spawn_maps();
	load_npcs();
	if(beta) wintext="Servidor funcional de "+GAME_NAME+" "+version+" test activo";
	else wintext="Servidor funcional de "+GAME_NAME+" "+version;
	show_game_window(wintext);
}
