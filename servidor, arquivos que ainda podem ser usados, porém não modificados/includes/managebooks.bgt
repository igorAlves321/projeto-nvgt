// manage books: create, update, delete, rename, and read
void createbook(int index, string bookname, string book_data, string language) {
	file book;
	string location ="books/"+language;
	if(!directory_exists(location)) directory_create(location);
	bool openbook =book.open(location+"/"+bookname+".txt", "w");
	if(openbook) {
		book.write(book_data);
		book.close();
		eadm(players[index].charname+" creó el libro "+bookname);
		send_reliable(players[index].peer_id, "msg2 ;libro creado.", 0);
	}
}

void getbook(int index, string bookname) {
	string locate ="books/"+players[index].idiomajogo+"/"+bookname+".txt";
	string content;
	if(file_exists(locate)) {
		file book;
		book.open(locate, "r");
		content =book.read();
		book.close();
	}
	else {
		send_reliable(players[index].peer_id, "msg2 ;Libro inexistente o ilegible.", 0);
	}
	if(content.length()>0) {
		send_reliable(players[index].peer_id, "databook "+bookname+" "+content, 0);
	}
}

void updatebook(int index, string bookname, string book_data, string language) {
	file book;
	string location ="books/"+language;
	if(!directory_exists(location)) {
		send_reliable(players[index].peer_id, "msg2 ;este idioma no existe.", 0);
		return;
	}
	if(!file_exists(location+"/"+bookname+".txt")) {
		send_reliable(players[index].peer_id, "msg2 ;este libro no existe.", 0);
		return;
	}
	bool openbook =book.open(location+"/"+bookname+".txt", "w");
	if(openbook) {
		string content =book_data;
		book.write(content);
		book.close();
		eadm(players[index].charname+" editó el libro "+bookname);
		send_reliable(players[index].peer_id, "msg2 ;libro actualizado.", 0);
	}
}

void deletebook(int index, string bookname, string language) {
	bool delete;
	string location ="books/"+language;
	if(directory_exists(location) && file_exists(location+"/"+bookname+".txt")) delete =true;
	if(delete) {
		file_delete(location+"/"+bookname+".txt");
		eadm(players[index].charname+" eliminó el libro "+bookname);
		send_reliable(players[index].peer_id, "msg2 ;libro eliminado.", 0);
	}
	else {
		send_reliable(players[index].peer_id, "msg2 este libro no existe.", 0);
	}
}

void renamebook(int index, string bookname, string newname, string language) {
	bool rename;
	string location ="books/"+language;
	if(directory_exists(location) && file_exists(location+"/"+bookname+".txt")) rename =true;
	if(rename) {
		file_copy(location+"/"+bookname+".txt", location+"/"+newname+".txt", true);
		file_delete(location+"/"+bookname+".txt");
		eadm(players[index].charname+" renombró el libro "+bookname+" a "+newname);
		send_reliable(players[index].peer_id, "msg2 ;libro renombrado.", 0);
	}
	else {
		send_reliable(players[index].peer_id, "msg2 este libro no existe.", 0);
	}
}

void readbook(int index, string bookname) {
	string location ="books/"+players[index].idiomajogo+"/"+bookname+".txt";
	string content;
	if(file_exists(location)) {
		file book;
		book.open(location, "r");
		content =book.read();
		book.close();
	}
	else {
		if(string_contains(bookname, "libro", 1)>-1) send_reliable(players[index].peer_id, "msg2 ;Libro inexistente o ilegible.", 0);
		else send_reliable(players[index].peer_id, "msg2 ;Folleto inexistente o ilegible.", 0);
	}
	if(content.length()>0) {
		send_reliable(players[index].peer_id, "readbook "+content, 0);
	}
}
