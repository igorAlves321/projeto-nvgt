#include "bots/npc.bgt"
#include "bots/pico.bgt"
#include "bots/misilavion.bgt"
#include "bots/cachorromascota.bgt"
#include "bots/monstruo.bgt"
	double get_distance(int x1, int x2, int y1, int y2){
	int dx,dy;
	if(x1<=x2) dx=x2-x1;
	else dx=x1-x2;
	if(y1<=y2) dy=y2-y1;
	else dy=y1-y2;
	return dx+dy;
}

double get_misilavion_distance(misilavion@ m1, player@ p2){
	if(m1.map!=p2.map) return -1;
	int dx,dy;
	if(m1.x<=p2.x) dx=p2.x-m1.x;
	else dx=m1.x-p2.x;
	if(m1.y<=p2.y) dy=p2.y-m1.y;
	else dy=m1.y-p2.y;
	return dx+dy;
}
double get_npc_distance(npc@ m1, player@ p2){
	if(m1.map!=p2.map) return -1;
	int dx,dy;
	if(m1.x<=p2.x) dx=p2.x-m1.x;
	else dx=m1.x-p2.x;
	if(m1.y<=p2.y) dy=p2.y-m1.y;
	else dy=m1.y-p2.y;
	return dx+dy;
}
