/* Arena module. Written by Angel Reyes, angeldelosreyesfaz@gmail.com.
this module provides the necessary functions to add, remove, or manage players in a battle arena. */

class arena {
	int fighting, fight, is_open;
	string[] fighters;
	timer tchanging_to_helicopter, helicopter_moves, warns, fighttimer;
	int changing=0, arena_helicopter=0, counter_arena_coors=-1, counter_deaths=0;
	string[] arena_coors;
	void init() {
		load_arena_coors();
		send_reliable(0, "ps arenaopen.ogg", 0);
		send_reliable(0, "msg2 ;Los grandes ejecutivos de todo el mundo solicitan integrantes humanos en una enorme arena de supervivencia de vida a muerte, con una debida recompensa. Para conseguir el acceso a ella, llame al siguiente número desde su celular: 3812742.;", 0);
		is_open=1;
		fight=1;
		fighters.resize(0);
		fighting=0;
		fighttimer.restart();
	}

	void load_arena_coors() {
		file f;
		f.open("arena_coors.db", "r");
		arena_coors=delinear(f.read());
		f.close();
	}

	void start() {
		for(uint i=0; i<fighters.length(); i++) {
			int fightindex=get_player_index_from(fighters[i]);
			if(fightindex>-1) {
				send_reliable(players[fightindex].peer_id, "startmoving", 0);
				send_reliable(players[fightindex].peer_id, "ps h_l.ogg", 0);
			}
		}
		warn(2);
		tchanging_to_helicopter.restart();
		changing=1;
		fight=0;
		fighting=1;
		fighttimer.force(0);
		fighttimer.pause();
	}

	void stop() {
		send_reliable(0, "msg2 ;Las peleas no se pueden consumar si no hay luchadores suficientes.;", 0);
		fight=0;
		is_open=0;
		counter_arena_coors=-1;
		arena_helicopter=0;
		helicopter_moves.force(0);
		helicopter_moves.pause();
		int index;
		for(uint i=0; i<fighters.length(); i++) {
			index=get_player_index_from(fighters[i]);
			if(index>-1) {
				remove_player_from(index);
			}
		}
		fighters.resize(0);
	}

	void finish() {
		fighting=0;
		counter_arena_coors=-1;
		is_open=0;
		counter_deaths=0;
		warns.force(0);
		warns.pause();
		arena_helicopter=0;
		helicopter_moves.force(0);
		helicopter_moves.pause();
		int index=get_player_index_from(fighters[0]);
		if(index>-1) {
			string winner=players[index].charname;
			if(players[index].sexo==0) {
				send_reliable(0, "msg2 ¡"+winner+" ;es la gloriosa ganadora de las batallas!;", 0);
			}
			else if(players[index].sexo==1) {
				send_reliable(0, "msg2 ¡"+winner+" ;es el glorioso ganador de las batallas!;", 0);
			}
			send_reliable(0, "ps arenafinished.ogg", 0);
			remove_player_from(index);
			gc(players[index].charname, 500);
		}
		fighters.resize(0);
	}

	void move(int coor) {
		if(counter_arena_coors>arena_coors.length()-1) {
			counter_arena_coors=-10;
			send_packet(0, "msg2 ;mensaje del piloto: rodeando el campo de batalla por una ruta alternativa para comenzar el recorrido de nuevo. repito, rodeando el campo de batalla por una ruta alternativa para comenzar el recorrido de nuevo.", "helicóptero_de_guerra");
			send_packet(0, "ps radiosend.ogg", "helicóptero_de_guerra");
			for(int x=0; x<fighters.length(); x++) {
				int index=get_player_index_from(fighters[x]);
				if(index>-1) {
					if(players[index].map=="helicóptero_de_guerra") changemap("arena", index, random(1820, 2000), 100);
				}
			}
		}
		if(counter_arena_coors>-1) {
			string[] content=string_split(arena_coors[counter_arena_coors], "=", false);
			send_packet(0, "msg2 ;"+content[0], "helicóptero_de_guerra");
			send_packet(0, "ps radiosend.ogg", "helicóptero_de_guerra");
		}
	}

	void warn(int type) {
		if(type==1) {
			if(counter_deaths>0) {
				send_reliable(0, "ps arenadeat.ogg", 0);
				send_reliable(0, "msg2 ;Se han suscitado un aproximado de; "+counter_deaths+" ;decesos en los alrededores del campo de batalla. la situación es trágica, pero no hay nada que frene a las ráfagas de balas disparadas por los combatientes.;", 0);
			}
		}
		else if(type==2) {
			string final;
			for(int i=0; i<fighters.length(); i++) {
				if(i<fighters.length()-1)final+=fighters[i]+", ";
				else if(i==fighters.length()-1)final+="y "+fighters[i]+".";
			}
			final=string_replace(final, ", y ", " y ", false);
			send_reliable(0, "ps arenastart.ogg", 0);
			send_reliable(0, "msg2 ;Las grandes batallas han dado inicio. los combatientes son:; "+final, 0);
		}
	}

	void loop() {
		if(warns.elapsed>=120000&&fighting==1) {
			warns.restart();
			warn(1);
		}
		if(helicopter_moves.elapsed>=10000&&arena_helicopter==1) {
			helicopter_moves.restart();
			counter_arena_coors++;
			move(counter_arena_coors);
		}
		if(fighters.length()>0) {
			for(uint i=0; i<fighters.length(); i++) {
				int index=get_player_index_from(fighters[i]);
				if(index>-1) {
					if(players[index].in_arena==0) {
						players[index].in_arena=1;
						players[index].health=400000;
					}
				}
			}
		}
		if(fighttimer.elapsed>=60000&&fight==1) {
			if(fighters.length()==1||fighters.is_empty()) stop();
			else start();
		}
		if(tchanging_to_helicopter.elapsed>=13640&&changing==1) {
			for(int x=0; x<fighters.length(); x++) {
				int index=get_player_index_from(fighters[x]);
				if(index>-1) {
					changemap("helicóptero_de_guerra", index, random(3, 15), random(0, 40));
				}
			}
			changing=0;
			tchanging_to_helicopter.force(0);
			tchanging_to_helicopter.pause();
			arena_helicopter=1;
			helicopter_moves.restart();
		}
		if(fighters.length()==1&&fighting==1) finish();
	}

	//player functions:
	void add_player(int index) {
		int find=fighters.find(players[index].charname);
		if(find>-1) {
			return;
		}
		else{
			save_config_player(index);
			players[index].nomesequipe.resize(0);
			string[] clothing=players[index].clothing;
			for(int i=0; i<clothing.length(); i++) {
				retirar(index, clothing[i], false);
			}
			send_reliable(players[index].peer_id, "clear_team_members", 6);
			send_reliable(players[index].peer_id, "reset_all_weapons_ammo", 6);
			send_reliable(players[index].peer_id, "msg2 ;tu llamada es atendida, y funcionarios militares con un dispositivo de tecnología superior a la que hayas visto nunca te teletransportan a un lugar desconocido.;", 0);
			send_reliable(0, "msg2 "+players[index].charname+" ;encomendó su vida a las deidades, y aceptó ser un"+players[index].sexo2+" de los valientes combatientes que arriesgarán su vida en la gran batalla.;", 0);
			send_reliable(players[index].peer_id, "stopmoving", 0);
			changemap("helicóptero_de_guerra", index, 1, 150);
			fighters.insert_last(players[index].charname);
			file_copy("players/"+players[index].charname+"/inv.md", "players/"+players[index].charname+"/inv_battle.md", true);
			players[index].setinv("daga_impura=50\r\nparacaídas=1");
			players[index].load_inv();
			send_reliable(players[index].peer_id,"setinv "+players[index].getinv(), 0);
			sconfigs(index);
		}
	}

	void save_config_player(int index) {
		file configs;
		dictionary data;
		data.set("x", players[index].x);
		data.set("y", players[index].y);
		data.set("map", players[index].mapavoltar);
		data.set("nomesequipe", linear(players[index].nomesequipe));
		data.set("clothing", linear(players[index].clothing));
		data.set("body_parts", linear(players[index].body_parts));
		data.set("health", players[index].health);
		data.set("maxhealth", players[index].maxhealth);
		data.set("amethyst", players[index].amethyst);
		players[index].amethyst=0;
		data.set("tamethyst", players[index].tamethyst.elapsed);
		players[index].tamethyst.pause();
		data.set("amethyst_time", players[index].amethyst_time);
		players[index].amethyst_time=0;
		data.set("bebida", players[index].caverna);
		players[index].caverna=0;
		data.set("tbebida", players[index].tcaverna.elapsed);
		players[index].tcaverna.pause();
		data.set("trueno", players[index].trueno);
		players[index].trueno=0;
		data.set("ttrueno", players[index].tmveloz2.elapsed);
		players[index].tmveloz2.pause();
		send_reliable(players[index].peer_id, "dveloz", 0);
		configs.open("players/"+players[index].charname+"/configs_backup.ini", "wb");
		configs.write(serialize(data));
		configs.close();
	}

	void restore_config_player(int index) {
		file configs;
		dictionary@ data;
		if(file_exists("players/"+players[index].charname+"/configs_backup.ini")) {
			configs.open("players/"+players[index].charname+"/configs_backup.ini", "rb");
			@data =deserialize(configs.read());
			configs.close();
			file_delete("players/"+players[index].charname+"/configs_backup.ini");
		}
		else {
			eadm("No se pudo restaurar la configuración de arena del jugador "+players[index].charname);
			return;
		}
		data.get("x", players[index].x);
		data.get("y", players[index].y);
		data.get("map", players[index].mapavoltar);
		string nomesequipe;
		data.get("nomesequipe", nomesequipe);
		players[index].nomesequipe =delinear(nomesequipe);
			string clothing;
		data.get("clothing", clothing);
		players[index].clothing =delinear(clothing);
		string body_parts;
		data.get("body_parts", body_parts);
		players[index].body_parts =delinear(body_parts);
		data.get("health", players[index].health);
		data.get("maxhealth", players[index].maxhealth);
		double amethyst, tamethyst, amethyst_time, bebida, tbebida, ttrueno;
		if(data.exists("amethyst")) data.get("amethyst", players[index].amethyst);
		if(data.exists("tamethyst")){
			data.get("tamethyst", tamethyst);
			players[index].tamethyst.force(tamethyst);
		}
		if(data.exists("amethyst_time")) data.get("amethyst_time", players[index].amethyst_time);
		if(data.exists("bebida")) data.get("bebida", players[index].caverna);
		if(data.exists("tbebida")){
			data.get("tbebida", tbebida);
			players[index].tcaverna.force(tbebida);
		}
		if(data.exists("trueno")) data.get("trueno", players[index].trueno);
		if(data.exists("ttrueno")) data.get("ttrueno", ttrueno);
			players[index].tmveloz2.force(ttrueno);
		if(players[index].trueno==1) send_reliable(players[index].peer_id,"aveloz",0);
	}

	void restore_inventory(int index) {
		if(file_exists("players/"+players[index].charname+"/inv_battle.md")) {
			file_copy("players/"+players[index].charname+"/inv_battle.md", "players/"+players[index].charname+"/inv.md", true);
			players[index].load_inv();
			send_reliable(players[index].peer_id, "setinv "+players[index].getinv(), 0);
		}
	}

	void remove_player_from(int index) {
		int find=fighters.find(players[index].charname);
		if(find>-1) {
			restore_inventory(index);
			restore_config_player(index);
			players[index].in_arena=0;
			changemap(players[index].mapavoltar, index, players[index].x, players[index].y);
			send_reliable(players[index].peer_id, "startmoving", 0);
			if(file_exists("players/"+players[index].charname+"/inv_battle.md")) file_delete("players/"+players[index].charname+"/inv_battle.md");
			fighters.remove_at(find);
		}
	}
} // end class arena
