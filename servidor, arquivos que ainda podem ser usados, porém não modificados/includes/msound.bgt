class msound{
	string soundloop,map;
	int x,y, id;
	msound(int i, string l, int c1, int c2,string cm)
	{
		id=i;
		soundloop=l;
		x=c1;
		y=c2;
		map=cm;
	}
	void updateme(int c1, int c2)
	{
		x=c1;
		y=c2;
	}
}
int spawn_moving_sound(string loop, int x, int y,string map){
	int mapindex=get_map_index_from(map);
	int id=random(1000, 9999);
	if(mapindex>-1){
		for(int i=0; i<server_maps[mapindex].msounds.length; i++){
			if(server_maps[mapindex].msounds[i].id==id) return -1;
		}
		msound m1(id,loop,x,y,map);
		server_maps[mapindex].msounds.insert_last(m1);
		for(int i=0; i<server_maps[mapindex].mapplayers.length(); i++){
			send_reliable(players[server_maps[mapindex].mapplayers[i]].peer_id, "cm "+id+" "+loop+" "+x+" "+y+" "+map, 0);
		}
		return id;
	}
	return -1;
}
