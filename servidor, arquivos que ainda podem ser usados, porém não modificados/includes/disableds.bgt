class game_disabled {
	int minx, maxx, miny, maxy;
	game_disabled(int min_x, int max_x, int min_y, int max_y) {
		this.minx=min_x;
		this.maxx=max_x;
		this.miny=min_y;
		this.maxy=max_y;
	}
}
bool is_game_disabled(int x, int y, string map) {
	int mapindex=get_map_index_from(map);
	if(mapindex>-1) {
		for(int i=0; i<server_maps[mapindex].disableds.length(); i++) {
			int minx=server_maps[mapindex].disableds[i].minx;
			int maxx=server_maps[mapindex].disableds[i].maxx;
			int miny=server_maps[mapindex].disableds[i].miny;
			int maxy=server_maps[mapindex].disableds[i].maxy;
			if(minx>x) continue;
			if(minx<=x && maxx>=x && miny<=y && maxy>=y) {
				return true;
			}
		}
	}
	return false;
}

bool is_game_disabled(int x, int y, int mapindex) {
	if(mapindex>-1) {
		for(int i=0; i<server_maps[mapindex].disableds.length(); i++) {
			int minx=server_maps[mapindex].disableds[i].minx;
			int maxx=server_maps[mapindex].disableds[i].maxx;
			int miny=server_maps[mapindex].disableds[i].miny;
			int maxy=server_maps[mapindex].disableds[i].maxy;
			if(minx>x) continue;
			if(minx<=x && maxx>=x && miny<=y && maxy>=y) {
				return true;
			}
		}
	}
	return false;
}
